# Take a health snapshot the moment the Bluetooth topology changes, instead of
# waiting up to 15 minutes for the timer. A stall unfolds in ~30 seconds; at
# timer resolution the interesting transition falls between two samples.
#
# --no-block so udev is never held up by the snapshot's journalctl queries.

SUBSYSTEM=="bluetooth", ACTION=="add", \
  RUN+="/usr/bin/systemctl start --no-block bt-health-snapshot-event.service"
SUBSYSTEM=="bluetooth", ACTION=="remove", \
  RUN+="/usr/bin/systemctl start --no-block bt-health-snapshot-event.service"
SUBSYSTEM=="usb", ACTION=="add", ATTR{idVendor}=="13d3", ATTR{idProduct}=="3503", \
  RUN+="/usr/bin/systemctl start --no-block bt-health-snapshot-event.service"
# REVIEWED-KEEP 2026-08-15T1752Z 2.4: the PRODUCT-format note below is why a
# non-default device's remove-event rule works at all; install.sh substitutes
# the stripped form deliberately.
# PRODUCT is kernel-formatted %x/%x/%x — lowercase, no leading zeros
# (usb_uevent in drivers/usb/core/driver.c). install.sh substitutes the
# stripped form for non-default devices; 13d3/3503 happens to be identical
# in both forms.
SUBSYSTEM=="usb", ACTION=="remove", ENV{PRODUCT}=="13d3/3503*", \
  RUN+="/usr/bin/systemctl start --no-block bt-health-snapshot-event.service"
