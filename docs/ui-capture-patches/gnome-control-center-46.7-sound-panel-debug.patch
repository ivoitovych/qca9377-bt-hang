+           device != NULL ? gvc_mixer_ui_device_get_id (device) : 0,
+           device != NULL ? gvc_mixer_ui_device_get_description (device) : "none",
+           stream != NULL ? gvc_mixer_stream_get_id (stream) : 0);
+
   set_output_stream (self, stream);
 
   if (device != NULL)
@@ -161,6 +166,11 @@
 
