# KCSAN instead of KASAN, plus fault injection (as frag-kcsan.config), and
# CONFIG_AUDIT: without it the 7.3-rc2 tree fails to link with KCSAN
# ("ld: vmlinux.o: in function `do_syscall_64': undefined reference to
# `syscall_enter_audit'", logs/phase5/kernel-build-v3-series-leakfix-kcsan.log).
# CONFIG_KASAN is not set
CONFIG_KCSAN=y
CONFIG_KCSAN_EARLY_ENABLE=y
CONFIG_KCSAN_REPORT_ONCE_IN_MS=3000
CONFIG_KCSAN_INTERRUPT_WATCHER=y
CONFIG_KCSAN_REPORT_RACE_UNKNOWN_ORIGIN=y
CONFIG_FAULT_INJECTION=y
CONFIG_FAILSLAB=y
CONFIG_FAULT_INJECTION_DEBUG_FS=y
CONFIG_AUDIT=y
