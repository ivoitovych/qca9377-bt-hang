#!/bin/bash
# run-tests — assert the analysis invariants, rather than trusting the comments.
#
# WHY THIS EXISTS. An external review of this repository found that its prose
# had run ahead of its code: `bt-phase`'s header stated it used only exogenous
# timer-driven probes while the implementation kept probes 600 seconds apart and
# called that provenance. Every commit message described the intended behaviour
# correctly. Only reading the implementation found the gap.
#
# Comments cannot be executed. These can. Each test below encodes an invariant
# that was violated by a real, shipped version of a tool here, and each fixture
# is built so the OLD behaviour fails it:
#
#   sampling unit   a burst of timeout lines is one cluster, not many
#   boot locality   no interval may span a reboot
#   date arithmetic a gap across a month boundary must be positive and correct
#   provenance      a contaminated probe set must be REFUSED, not reported
#
# Usage: tests/run-tests

set -uo pipefail

cd "$(dirname "$0")/.." || exit 1

# ── REFUSE TO RUN WHILE A REAL TRIAL IS OPEN ──────────────────────────────
#
# The suite's job includes driving tools that ACT — the watchdog decides to
# reset, bt-trial opens and closes trials, bt-incident collects. The PATH guard
# below stops those reaching the installed copies, but no guard makes a suite
# whose purpose is exercising actuators into a read-only observer, and pretending
# otherwise is how the last escape was rationalised.
#
# So the standing rule is mechanical rather than remembered: if a trial is open
# on this machine, the suite does not run. That is the single check which would
# have prevented the 2026-08-14 incident outright — a 2-hour clean trial was
# closed mid-experiment by a coverage measurement — independently of whether the
# escape had been found.
#
# Reads the REAL state directory, not a sandbox: $BT_STATE is what the tests
# themselves override per-invocation, and this runs before any of them.
BT_REAL_TRIAL_STATE="${BT_TRIAL_STATE_DIR:-/run/bt-trial}"
if [[ -e "$BT_REAL_TRIAL_STATE/current" && "${BT_ALLOW_OPEN_TRIAL:-0}" != 1 ]]; then
    echo "run-tests: a trial is OPEN on this machine — refusing to run." >&2
    awk '{ print "           " $0 }' "$BT_REAL_TRIAL_STATE/current" >&2 2>/dev/null
    echo "           This suite drives tools that act. Close the trial, or wait" >&2
    echo "           for it to close, and run again." >&2
    echo "           BT_ALLOW_OPEN_TRIAL=1 overrides — only when the state file" >&2
    echo "           is stale, e.g. after a crash." >&2
    exit 2
fi

# ── THE PATH GUARD, BEFORE ANYTHING ELSE RUNS ─────────────────────────────
#
# THE ESCAPE THIS CLOSES, WHICH HAPPENED.
#
# On 2026-08-14 this suite was run on the investigation machine to measure its
# coverage. It closed a live 2-hour trial, wrote a results row whose treatment
# fingerprint was fabricated by test stubs (`wd=late/thr?` from a stubbed
# systemctl, `power=?` from a fake sysfs tree), and ran a real bt-incident
# collection into evidence/sessions/.
#
# The mechanism was not a missing environment override. bin/bt-hang-watchdog
# closes the boot's auto-trial on the device-absent path with:
#
#     if command -v bt-trial >/dev/null 2>&1; then bt-trial hang; fi
#
# — a BARE NAME, resolved from PATH, which finds the INSTALLED copy. The
# watchdog scenarios below put a stub directory on PATH for systemctl, sleep
# and hciconfig, and inherit BT_SYSFS_USB; they never redirected bt-trial,
# because bt-trial is not called by the test, it is called by the tool under
# test. So the real bt-trial ran against the real /run/bt-trial and the real
# evidence tree, with the stubs supplying its treatment fingerprint.
#
# The existing invariant could not see it. It scans THIS FILE for
# `tools/bt-trial <verb>` — and the call is not in this file at all.
#
# WHY A GUARD AND NOT ANOTHER STUB. Adding bt-trial to one stub directory
# fixes one scenario. The shipped tools invoke five project tools by bare name
# (bt-trial, bt-incident, bt-mark, bt-state, bt-timeline), any of which a
# future test could reach the same way. Every legitimate invocation in this
# file uses an explicit path — tools/bt-trial, bin/bt-hang-watchdog — so a
# bare name resolving during a test run is an escape BY CONSTRUCTION, and can
# be intercepted rather than reasoned about case by case.
#
# THE LIST COMES FROM install.sh, NOT FROM CALL SITES.
#
# The first version derived it by grepping `command -v bt-*` in tools/ and
# bin/. The maintainer found the hole within the hour: tools/bt-status wraps
# the probe —
#
#     have() { command -v "$1" >/dev/null 2>&1; }
#     have bt-boots && bt-boots 8 | sed 's/^/  /'
#
# — so the tool name is an ARGUMENT and never appears after `command -v`.
# bt-boots was invoked by bare name and was not guarded; bt-state was guarded
# only by accident, because another file happens to spell that one literally.
# A derivation that sees one spelling is a hand-written list wearing a grep,
# and it fails the same way: silently, for the entry nobody thought of.
#
# install_file destinations under /usr/local/bin and /usr/local/sbin are the
# complete set of names this project puts on PATH. That is complete regardless
# of HOW a tool is invoked — through a wrapper, a variable, an eval — because
# the question it answers is not "who calls this?" but "what could a bare name
# resolve to?". It is the derivation bt-verify-install adopted after the same
# class of bug, from the source of truth uninstall.sh is already checked
# against.
#
# Joined across backslash continuations first: install.sh wraps its longer
# calls, and a line-by-line parse yields "\" as the destination — the phantom
# that cost bt-verify-install seven false "not installed" reports.
#
# The basename step is `awk -F/`, not `sed 's|.*/||'`, for a reason that is not
# style: a reviewer re-deriving this list independently — which is exactly what
# should happen to a safety control — has to paste the pipeline, and a static
# analyser cannot tell a pure `s///` substitution from a rewrite, so the paste
# costs an interactive approval. The --section block below carries the same note
# for the same reason. A control nobody can cheaply reproduce gets checked once.
guard_names() {
    awk '{ while (/\\$/ && (getline nxt) > 0) { sub(/\\$/, "", $0); $0 = $0 nxt } print }' install.sh \
    | grep -oE 'install_file[[:space:]]+"\$SRC/[^"]+"[[:space:]]+[^[:space:]]+' \
    | awk '{print $3}' \
    | grep -E '^/usr/local/(bin|sbin)/[^/]+$' \
    | awk -F/ '{print $NF}' | sort -u
}

# An empty list is not an empty risk. With guard_names undefined the loops
# below read nothing, every stub went unwritten, and the invariant that checks
# the guard reported success over a list of zero tools — the empty-trace
# failure mode, in the one file whose job is to notice it.
GUARD_N=$(guard_names | grep -c .)
if (( ${GUARD_N:-0} < 20 )); then
    echo "run-tests: derived only ${GUARD_N:-0} guarded tool name(s) from install.sh" >&2
    echo "           refusing to run with an unguarded PATH" >&2
    exit 2
fi

GUARD=$(mktemp -d)
mkdir -p "$GUARD/bin"
GUARD_LOG="$GUARD/calls.log"; : > "$GUARD_LOG"
while IFS= read -r tool; do
    [[ -n "$tool" ]] || continue
    cat > "$GUARD/bin/$tool" <<GUARDSTUB
#!/bin/sh
# Installed by tests/run-tests. Records the call and does nothing.
echo "$tool \$*" >> "$GUARD_LOG"
exit 0
GUARDSTUB
    chmod +x "$GUARD/bin/$tool"
done < <(guard_names)

# A DECOY, standing in for the installed copies.
#
# Without this the guard cannot be tested anywhere it matters. On a development
# checkout nothing is installed, so a bare name resolves to nothing, the
# watchdog's `&&` short-circuits, and the escape cannot happen — which is why
# it was invisible here and fired on the investigation machine. Reversing the
# guard's PATH order changed no result at all until this existed.
#
# So the hazardous condition is CONSTRUCTED: poisoned tools sitting BEHIND the
# guard on PATH, each touching a marker if it ever runs. Any machine now
# reproduces the investigation machine's arrangement, and the assertion in the
# watchdog section goes red if the guard stops winning — on a bare checkout as
# readily as on an installed host.
mkdir -p "$GUARD/decoy"
DECOY_HIT="$GUARD/decoy-was-reached"
while IFS= read -r tool; do
    [[ -n "$tool" ]] || continue
    cat > "$GUARD/decoy/$tool" <<DECOYSTUB
#!/bin/sh
echo "$tool \$*" >> "$DECOY_HIT"
exit 0
DECOYSTUB
    chmod +x "$GUARD/decoy/$tool"
done < <(guard_names)

export PATH="$GUARD/bin:$PATH:$GUARD/decoy"
trap 'rm -rf "$GUARD"' EXIT

# ── --section: print one block instead of all of them ─────────────────────
#
# Reading a single section out of the full output was being done with
# `sed -n '/heading/,/next heading/p'`, which is read-only but indistinguishable
# from a rewrite to a static analyser, so it cost an interactive approval every
# time. The suite knows where its own sections begin and end; asking it is both
# cheaper and more accurate than pattern-matching its output from outside.
#
# The exit status is the SUITE's, not the filter's — a section that happens to
# contain no failures must not report success for a run that failed elsewhere.
if [[ "${1:-}" == --section ]]; then
    [[ -n "${2:-}" ]] || { echo "usage: run-tests --section <text from a heading>" >&2; exit 2; }
    out=$("$0"); rc=$?
    awk -v want="$2" '
        index($0, want) && !started { started = 1 }
        started && printed && /^$/  { started = 0 }
        started                     { print; if ($0 !~ /^$/) printed = 1 }
        /^all [0-9]+ invariants hold$/ || /^FAILED: /  { tail = $0 }
        END { if (tail != "") { print ""; print tail } }
    ' <<<"$out"
    exit $rc
fi

pass=0; fail=0

# Baseline for the last check in this file: running the tests must not add
# anything to the real evidence tree. Taken before anything else runs.
SESSIONS_BEFORE=$(ls -1 evidence/sessions 2>/dev/null | wc -l)

# And the same for the trial state, because the refusal at the top of this file
# is a WINDOW CHECK, not an isolation guarantee — it reads /run/bt-trial once,
# before anything runs, and nothing re-reads it afterwards. The maintainer named
# that gap while verifying the refusal, and it is real: a trial opening mid-run
# is invisible to a check that has already happened.
#
# This does not prevent that. It DETECTS it — which is the difference between an
# incident found by a red test at 15:08 and one found by a person noticing a
# missing trial days later, which is how the last one was found.
#
# Fingerprints the two things the 2026-08-14 escape actually mutated: the open
# marker (removed when the live trial was closed) and the results file (a row
# appended whose treatment fingerprint came from test stubs). evidence/sessions
# above is the third. Repo-relative, like SESSIONS_BEFORE, because the checkout
# on the investigation machine IS the evidence repository.
real_trial_footprint() {
    if [[ -e "$BT_REAL_TRIAL_STATE/current" ]]; then
        echo "open=yes:$(cksum < "$BT_REAL_TRIAL_STATE/current" 2>/dev/null)"
    else
        echo "open=no"
    fi
    echo "rows=$(wc -l < evidence/trials/results.tsv 2>/dev/null || echo 0)"
}
TRIAL_FOOTPRINT_BEFORE=$(real_trial_footprint)

ok()   { echo "  ✓ $*"; pass=$((pass + 1)); }
bad()  { echo "  ✗ $*"; fail=$((fail + 1)); }

# ── THE SHELL SCRIPTS THIS REPOSITORY SHIPS ───────────────────────────────
#
# Every repo-wide check below scans this set. It is DERIVED, because the
# hand-written alternative has now failed here four times, most recently as
# `tools bin devtools` — which omitted install.sh, where the guard protecting
# stage-1 observations from a btusb reload held the exact defect the check was
# hunting. A list that must be remembered will eventually not be.
#
# Built with bash pattern matching and no pipeline: using `head | grep -q` here
# would make the detector vulnerable to the very defect it detects.
SHFILES=()
while IFS= read -r f; do
    [[ -f "$f" ]] || continue
    IFS= read -r shebang < "$f" || continue
    case "$shebang" in
        '#!'*bash*|'#!'*/sh|'#!'*' sh') SHFILES+=("$f") ;;
    esac
done < <(git ls-files 2>/dev/null)

# AN EMPTY DERIVATION IS A REFUSAL, NOT A PASS.
#
# SHFILES is the work-list for four repo-wide invariants: the timeout-pattern
# scan, the awk `-f` trap, the seam check and the executable-bit check. If it
# ever came back empty — a broken `git ls-files`, a shebang match that stopped
# matching, this file running outside a checkout — all four would iterate
# nothing and print four green ticks. One silent derivation failure, four
# invariants disabled, no output that looks wrong.
#
# THIS IS THE FIFTH INSTANCE OF ONE SHAPE in this codebase, and the maintainer
# named it: an empty input set reported as success. devtools/coverage did it
# with an empty trace (every file at 0%, which reads as a finding);
# bt-verify-install did it with a hand-list missing six tools ("running system
# matches the checkout"); the timeout grep did it with 0 matches of 173 events;
# the SCO cross-tab did it with an awk parse error and a silently omitted
# section; and the PATH guard did it three commits ago with a list of zero
# tools.
#
# devtools/repo-validate already encodes the correct distinction, with a
# comment on why conflating the two nothings is its own bug: ENUMERATED == 0 is
# a refusal, CHECKED == 0 is fine. That rule belongs wherever a check derives
# its own work-list — because a derivation IS the new hand-written list the
# moment it can come back empty.
#
# So: refuse here, and below, every derived check reports the SIZE of what it
# checked rather than only the absence of hits. A zero then reads as a zero.
if (( ${#SHFILES[@]} < 20 )); then
    echo "run-tests: derived only ${#SHFILES[@]} shell file(s) from git ls-files" >&2
    echo "           four repo-wide invariants scan this set; refusing to run" >&2
    echo "           and report them green over nothing" >&2
    exit 2
fi

# THE ANALYSIS IS NOW A FILE, AND THIS RUNS THE FILE.
#
# It used to be extracted: a Python regex pulled the awk program out of
# tools/bt-phase's SOURCE and the tests drove the reconstructed copy. That is
# the `-f` trap wearing a different hat. An extracted copy of bt-capdiff's
# matcher once passed every test while the shipped invocation silently loaded
# nothing, and bt-capdiff reported perfect agreement between paths differing by
# 278 records. The same shape here could not detect a bt-phase that had stopped
# loading its analysis at all.
#
# tools/lib/phase.awk is now loaded by bt-phase with -f and by these tests with
# -f, from the same path, so a test can no longer pass against a program the
# tool does not run. The extraction produced byte-identical output on both the
# reporting and the refusal path at the commit that moved it.
PHASEAWK=(-f tools/lib/timestamp.awk -f tools/lib/phase.awk)

echo "bt-phase invariants"
echo "──────────────────────────────────────────────────────────────"

OUT=$(awk -v igap=600 -v period=900 "${PHASEAWK[@]}" tests/phase-invariants.data 2>&1)

# --- sampling unit ---------------------------------------------------------
# The fixture has five timeout lines: a burst of four inside 60 s in one boot,
# and one in another. A version counting lines reports 5 "failures", inflating n
# and destroying the independence the statistical caveat assumes.
lines=$(grep -oP 'timeout LINES\s+\K[0-9]+' <<<"$OUT")
inc=$(grep -oP 'timeout CLUSTERS\s+\K[0-9]+' <<<"$OUT")
[[ "$lines" == "5" ]] && ok "counts 5 timeout lines" || bad "expected 5 lines, got ${lines:-none}"
[[ "$inc"  == "2" ]] && ok "collapses them to 2 timeout clusters" || bad "expected 2 clusters, got ${inc:-none}"

# --- date arithmetic -------------------------------------------------------
# Boot -1's incident falls between probes at 23:15 on 31 July and 00:30 on
# 1 August: 4500 s. Day-of-month arithmetic makes that negative.
grep -q '4500.0s gap' <<<"$OUT" \
    && ok "computes a 4500s gap across a month boundary" \
    || bad "month-boundary gap wrong; got: $(grep -o '[0-9.]*s gap' <<<"$OUT" | tr '\n' ' ')"

# --- boot locality ---------------------------------------------------------
# Boot 0's probes are 900 s apart. If intervals could span boots, its incident
# would be placed in some other, larger gap.
grep -q 'boot 0 .*900.0s gap' <<<"$OUT" \
    && ok "keeps intervals within a single boot" \
    || bad "boot-0 interval not boot-local"

# --- both boundaries exogenous --------------------------------------------
# Only EXO records appear in the fixture, so any interval built from an ENDO
# record would be a construction error. Two incidents, two placements.
placed=$(grep -oP 'placed\s+\K[0-9]+' <<<"$OUT")
[[ "$placed" == "2" ]] && ok "places both clusters in exogenous gaps" \
    || bad "expected 2 placed, got ${placed:-none}"

# --- provenance refusal ----------------------------------------------------
# With the timer period claimed as 100000 s, the fixture's 900 s gaps are far
# too short to be timer-driven. The tool must refuse rather than report.
REF=$(awk -v igap=600 -v period=100000 "${PHASEAWK[@]}" tests/phase-invariants.data 2>&1)
grep -q 'SKIPPED — provenance check failed' <<<"$REF" \
    && ok "refuses to report when claimed provenance is impossible" \
    || bad "did not refuse on a contaminated probe set"

# --- the SCRIPT, not just the analysis it loads ----------------------------
#
# Everything above drives phase.awk directly. These drive tools/bt-phase, over a
# journal fixture, through bt_journal. They are what the extraction approach
# could never do: assert that the shipped script collects the right records,
# hands them to the right program, and reaches the same numbers.
PJ=tests/journal/phase
PH=$(BT_JOURNAL_FIXTURE="$PJ" BT_BOOT_LIST="$PJ/boot-list" tools/bt-phase 2>&1); ph_rc=$?

if (( ph_rc == 0 )) && [[ "$PH" == *"timeout CLUSTERS   2"* ]]; then
    ok "bt-phase collects and clusters through the full script path"
else
    bad "bt-phase end-to-end wrong (rc=$ph_rc):"
    tail -4 <<<"$PH" | sed 's/^/      /'
fi

# The same month-boundary gap the analysis section asserts, but arrived at by
# the script reading a journal rather than by awk reading a record file. A
# collect() that lost the date, or paired probes across boots, breaks here.
if [[ "$PH" == *"4500.0s gap"* ]]; then
    ok "bt-phase preserves the month-boundary gap end to end"
else
    bad "bt-phase lost the 4500s month-boundary gap through the script path"
fi

# -b selects one boot. With boot 0 alone the -1 records must not appear, which
# is the invariant that a probe interval cannot span a reboot, enforced at the
# collection layer rather than in the arithmetic.
PH0=$(BT_JOURNAL_FIXTURE="$PJ" tools/bt-phase -b 0 2>&1)
if [[ "$PH0" == *"boot 0 "* && "$PH0" != *"boot -1"* ]]; then
    ok "bt-phase -b restricts collection to one boot"
else
    bad "bt-phase -b 0 did not restrict to boot 0"
fi

# An empty journal is a legitimate state, not a crash: the tool must say so and
# exit 0 rather than reporting on nothing.
EMPTYJ=$(mktemp -d)
PHE=$(BT_JOURNAL_FIXTURE="$EMPTYJ" tools/bt-phase -b 0 2>&1); phe_rc=$?
if (( phe_rc == 0 )) && [[ "$PHE" == *"no probe or timeout records"* ]]; then
    ok "bt-phase reports an empty journal instead of analysing nothing"
else
    bad "bt-phase on an empty journal: rc=$phe_rc out=$PHE"
fi
rmdir "$EMPTYJ"

tools/bt-phase --bogus >/dev/null 2>&1
(( $? != 0 )) && ok "bt-phase rejects an unknown argument" \
              || bad "bt-phase accepted an unknown argument"

PHL=$(BT_LIBDIR=/nonexistent BT_JOURNAL_FIXTURE="$PJ" tools/bt-phase -b 0 2>&1)
[[ "$PHL" == *"missing"* ]] \
    && ok "bt-phase refuses when its libraries are absent" \
    || bad "bt-phase ran without its libraries: $PHL"

if grep -q 'constant-hazard independent null' <<<"$OUT" \
   && ! grep -q 'expected under independence' tools/bt-phase tools/lib/phase.awk; then
    ok "states the constant-hazard null instead of equating it with independence"
else
    bad "bt-phase still overstates independence as sufficient for a uniform phase"
fi

echo
echo "bt-diagnose — phenotype is not a causal verdict"
echo "──────────────────────────────────────────────────────────────"

DOUT=$(bash -c 'source tools/bt-diagnose; diagnose_verdict 12 3 0 4' 2>&1)
DRC=$?
if (( DRC == 1 )) && grep -q 'phenotype observed' <<<"$DOUT"; then
    ok "timeouts remain reportable even when aggregate reset messages exist"
else
    bad "reset messages suppressed the timeout phenotype (rc=$DRC)"
fi
if grep -q 'aggregate, unpaired, system-wide counts' <<<"$DOUT" \
   && ! grep -qE 'callback is installed|kernel logged the failures and did nothing|driver_info = 0' <<<"$DOUT"; then
    ok "aggregate history carries no callback, reset-origin or firmware-table verdict"
else
    bad "bt-diagnose still converts aggregate counts into a causal verdict"
fi

DZERO=$(bash -c 'source tools/bt-diagnose; diagnose_verdict 0 0 0 4' 2>&1)
DZRC=$?
if (( DZRC == 0 )) && grep -q 'no observation' <<<"$DZERO" \
   && ! grep -qi 'controller is healthy' <<<"$DZERO"; then
    ok "zero retained timeouts is absence of observation, not proof of health"
else
    bad "zero-timeout verdict overclaims health (rc=$DZRC)"
fi

echo
echo "BT-1 current formulation — one mechanically checked statement"
echo "──────────────────────────────────────────────────────────────"

bt1_block() {
    awk '/BT1-CURRENT-BEGIN/{inside=1; next}
         /BT1-CURRENT-END/{inside=0}
         inside' "$1"
}
BT1_CANON=$(bt1_block docs/issues.md)
same=yes
for f in README.md docs/bug-report.md docs/fix-proposal.md; do
    [[ "$(bt1_block "$f")" == "$BT1_CANON" ]] || same=no
done
if [[ -n "$BT1_CANON" && "$same" == yes ]]; then
    ok "README, bug report and fix proposal reproduce issues.md's canonical BT-1 paragraph"
else
    bad "current BT-1 paragraph drifted between authoritative user-facing documents"
fi

BT1_CURRENT_FILES=(README.md docs/bug-report.md docs/fix-proposal.md
                   bin/bt-usbmon bin/bt-hang-watchdog tools/bt-status
                   tools/bt-postmortem tools/bt-health-report.sh)
retired=$(rg -n -i 'failure has two stages|controller fails in two stages|recoverable window closes|window closes sharply|exact operation usb_queue_reset_device|autosuspend was the trigger|stage 1 lasted ~6 hours|reached stage 2 before|cheap and safe' "${BT1_CURRENT_FILES[@]}" || true)
if [[ -z "$retired" ]]; then
    ok "current-facing docs and tools contain no retired BT-1/reset assertions"
else
    bad "retired BT-1/reset assertion remains: $retired"
fi

echo
echo "bt-capdiff matching"
echo "──────────────────────────────────────────────────────────────"

# The false-agreement case. Two records on one side, one on the other, all
# within tolerance. A matcher that asks "is there ANY counterpart within
# tolerance?" without consuming it reports zero unmatched in both directions and
# announces that the paths agree — while the multiplicity is 2 against 1.
FA=$(mktemp); FB=$(mktemp); OA=$(mktemp); OB=$(mktemp)
trap 'rm -f "$FA" "$FB" "$OA" "$OB"' EXIT

# The matcher lives in tools/lib/capdiff-match.awk and is used here exactly as
# bt-capdiff uses it. Testing the real file rather than a copy extracted from
# the caller means the test cannot pass against a matcher the tool no longer
# runs — which is precisely how the -f trap slipped through: an extracted copy
# worked in the test while the shipped invocation silently loaded nothing.
MATCH=tools/lib/capdiff-match.awk
[[ -r "$MATCH" ]] || bad "missing $MATCH"

printf '2026-08-12T12:00:00.100 > HCI Event: EVENT X\n2026-08-12T12:00:00.110 > HCI Event: EVENT X\n' > "$FA"
printf '2026-08-12T12:00:00.105 > HCI Event: EVENT X\n' > "$FB"
: > "$OA"; : > "$OB"

awk -f tools/lib/timestamp.awk -f "$MATCH" -v tol=0.5 -v outA="$OA" -v outB="$OB" "$FA" "$FB"

ua=$(wc -l < "$OA"); ub=$(wc -l < "$OB")
if [[ "$ua" == "1" && "$ub" == "0" ]]; then
    ok "2-against-1 leaves exactly one record unmatched (no false agreement)"
else
    bad "expected 1 unmatched in A and 0 in B; got $ua and $ub"
fi

# And the genuine-agreement case must still report zero, or the matcher would be
# useless in the direction that matters.
printf '2026-08-12T12:00:00.100 > HCI Event: EVENT X\n' > "$FA"
printf '2026-08-12T12:00:00.105 > HCI Event: EVENT X\n' > "$FB"
: > "$OA"; : > "$OB"
awk -f tools/lib/timestamp.awk -f "$MATCH" -v tol=0.5 -v outA="$OA" -v outB="$OB" "$FA" "$FB"
if [[ "$(wc -l < "$OA")" == "0" && "$(wc -l < "$OB")" == "0" ]]; then
    ok "1-against-1 within tolerance matches cleanly"
else
    bad "genuine agreement reported as a difference"
fi

# Shared timestamp arithmetic must survive a month boundary, which is the bug
# that survived in bt-trial after bt-phase was fixed in isolation.
printf '2026-08-31T23:59:59.000 > HCI Event: EVENT Y\n' > "$FA"
printf '2026-09-01T00:00:02.000 > HCI Event: EVENT Y\n' > "$FB"
: > "$OA"; : > "$OB"
awk -f tools/lib/timestamp.awk -f "$MATCH" -v tol=5 -v outA="$OA" -v outB="$OB" "$FA" "$FB"
if [[ "$(wc -l < "$OA")" == "0" && "$(wc -l < "$OB")" == "0" ]]; then
    ok "3s apart across a month boundary is within a 5s tolerance"
else
    bad "month-boundary arithmetic wrong: records 3s apart treated as unmatched"
fi

echo
echo "bt-trial report — schema invariants"
echo "──────────────────────────────────────────────────────────────"

# THE RULE: no consumer of results.tsv may address a column by position.
#
# Inserting trial_type has now caused two real defects in a file whose own
# comments state that rule: next_trial_no kept using $2 for build, and the SCO
# cross-tab kept using $5 for outcome — so every hang was counted as survived
# while the denominator table above it stayed correct.
#
# Grepping for "$5" would only test today's spelling of the bug. Permuting the
# header and asserting the report is byte-identical tests the invariant, and
# makes positional assumptions mechanically impossible instead of merely
# discouraged.
FIX=tests/trial-results.tsv
[[ -r "$FIX" ]] || bad "missing $FIX"

RD=$(mktemp -d); trap 'rm -rf "$FA" "$FB" "$OA" "$OB" "$RD"' EXIT
mkdir -p "$RD/evidence/trials" && touch "$RD/install.sh" && git -C "$RD" init -q 2>/dev/null
cp "$FIX" "$RD/evidence/trials/results.tsv"
R1=$(BT_REPO="$RD" tools/bt-trial report 2>&1)

# The fixture holds 2 hangs: one observational, one controlled. If outcome is
# read positionally both are missed and the SCO table shows zero hung.
# The fixture holds 5 rows: 2 hangs and 1 RECOVERED (all three with SCO), 1
# survived-with-SCO, 1 survived-without. `recovered` must count as a BT-1
# occurrence, not a survival — otherwise the incidence of the bug is understated
# by exactly the watchdog success rate, which is the quantity the mitigation
# exists to maximise. Reading outcome positionally puts every row in the
# survived column; a crashed cross-tab prints nothing at all.
# bt1_status confirmed on T1, T4, T6 — all with SCO -> 3 "hung", meaning the
# DEFECT occurred, regardless of whether the controller was later rescued.
# T5 not_observed with SCO -> 1 survived. T2 not_observed without SCO.
# T3 (censored_pre_failure) and T7 (CHANGED treatment) are EXCLUDED entirely;
# were either counted it would land in a cell and change a number.
if grep -qE 'SCO setup requested +3 +1' <<<"$R1" \
   && grep -qE 'no SCO setup +0 +1' <<<"$R1" \
   && grep -q 'censored by early watchdog intervention' <<<"$R1"; then
    ok "SCO 2x2 counts recovered as BT-1 and excludes censored (3/1, 0/1)"
else
    bad "SCO 2x2 wrong or missing — outcome read by position, recovered miscounted, or awk failed:"
    grep -A4 'hung' <<<"$R1" | head -6
fi

# The environment is part of the treatment. Two distinct environments in one
# results file must be flagged, never silently pooled under one build name.
if grep -q 'DISTINCT ENVIRONMENTS' <<<"$R1"; then
    ok "report warns when trials span more than one environment"
else
    bad "report pooled trials from different environments without warning"
fi

# And incidence must be reported separately from unrecovered failure.
if grep -q 'BT-1 INC' <<<"$R1"; then
    ok "report separates BT-1 incidence from unrecovered failure"
else
    bad "report shows only unrecovered failures — incidence is hidden"
fi

# CENSORED observations must be visible AND excluded from the rate. An early
# watchdog intervention before any observed timeout destroys the counterfactual:
# counting it as an occurrence lets the mitigation manufacture the incidence it
# is measuring; counting it as a survival is the mirror error.
if grep -qE 'observational_boot +stock +1/2 +1/2 .*1/3' <<<"$R1"; then
    ok "censored row is shown but excluded from the denominator (1/2 of 3 seen)"
else
    bad "censored handling wrong — expected rate over 2 with 1/3 censored:"
    grep -E 'observational_boot' <<<"$R1" | head -2
fi
grep -q 'CENSORED trial(s), excluded from every rate' <<<"$R1" \
    && ok "report explains why censored trials are excluded" \
    || bad "censored trials excluded silently"

# Measurement revision must NOT split the denominator. T1 and T2 share a
# treatment but differ in measurement_rev; a tooling fix must not fragment a
# series into singletons.
if grep -qE 'observational_boot +stock +1/2' <<<"$R1"; then
    ok "differing measurement revisions pool into one denominator"
else
    bad "measurement revision fragmented the denominator"
fi

grep -q 'observational_boot' <<<"$R1" && grep -q 'controlled_v2' <<<"$R1" \
    && ok "observational and controlled rows reported separately" \
    || bad "trial types not separated in the report"

# Permute the columns. Same data, different order, identical report required.
python3 - "$FIX" "$RD/evidence/trials/results.tsv" <<'PY'
import sys, random
rows = [l.rstrip("\n").split("\t") for l in open(sys.argv[1]) if l.strip()]
hdr = rows[0]
order = list(range(len(hdr)))
random.Random(20260813).shuffle(order)
with open(sys.argv[2], "w") as f:
    for r in rows:
        f.write("\t".join(r[i] for i in order) + "\n")
PY
R2=$(BT_REPO="$RD" tools/bt-trial report 2>&1)

if [[ "$R1" == "$R2" ]]; then
    ok "report is identical under an arbitrary column permutation"
else
    bad "report changed when columns were reordered — a consumer reads by position"
    diff <(echo "$R1") <(echo "$R2") | head -12 | sed 's/^/      /'
fi

echo
echo "awk program-loading (the -f trap)"
echo "──────────────────────────────────────────────────────────────"

# `awk -f lib.awk 'program' input` does NOT run 'program'. With -f present, awk
# takes the program only from the -f files and treats the positional string as
# an INPUT FILENAME. Sharing the date arithmetic via -f therefore silently
# disabled bt-capdiff's matcher and both of bt-trial's interval computations:
# no error, no output, and bt-capdiff reported perfect agreement between paths
# differing by 278 records.
#
# Nothing about that is visible in a syntax check or a code reading that does
# not know the rule. So: assert that no tool passes an inline program alongside
# -f, and that the interval helper actually returns a number.
offenders=$(grep -rnE "awk[^|]*-f [^ ]+\.awk[^|]*'" tools/ bin/ 2>/dev/null \
            | grep -vE "^tools/lib/|-f \"\\\$LIBDIR/[a-z-]+\.awk\" -f " || true)
if [[ -z "$offenders" ]]; then
    ok "no tool passes an inline program alongside awk -f (${#SHFILES[@]} files)"
else
    bad "inline program alongside -f (it will be read as a filename):"
    sed 's/^/      /' <<<"$offenders"
fi

iv=$(awk -f tools/lib/timestamp.awk -f tools/lib/interval.awk \
        -v a="2026-08-31T23:59:59.000000+02:00" -v b="2026-09-01T00:00:02.000000+02:00" </dev/null)
[[ "$iv" == "3.000" ]] && ok "interval.awk spans a month boundary (3.000s)" \
    || bad "expected 3.000 across month boundary, got '${iv:-empty}'"

iv2=$(awk -f tools/lib/timestamp.awk -f tools/lib/interval.awk \
        -v a="not-a-timestamp" -v b="2026-09-01T00:00:02.000000+02:00" </dev/null)
[[ -z "$iv2" ]] && ok "interval.awk prints nothing on an unparseable timestamp" \
    || bad "expected empty output on bad input, got '$iv2'"

echo
echo "analysis commands fail loudly"
echo "──────────────────────────────────────────────────────────────"

# THE INVARIANT: if an evidence-producing calculation fails, the enclosing
# command must exit non-zero.
#
# bt-trial runs under `set -uo pipefail` and deliberately NOT `set -e` — it
# probes things that are allowed to fail (hci_alive, optional commands), and
# errexit's semantics are treacherous. The consequence, before this fix, was
# that an awk syntax error printed to stderr, the script carried on through
# later echoes, and `bt-trial report` returned 0 while silently omitting an
# entire analytical section.
#
# Schema-position independence and successful execution are SEPARATE
# invariants. The permutation test happens to catch this one for this table,
# because missing output fails the expected-count assertion — but that is a
# coincidence of that fixture, not a general guarantee. This tests the general
# property by making the analysis program unreachable.
BROKEN=$(mktemp -d)
mkdir -p "$BROKEN/lib"
cp tools/lib/timestamp.awk "$BROKEN/lib/"
cp tools/bt-trial "$BROKEN/"
# Every lib file present except the report programs: the tool must fail rather
# than print a report with a section missing.
rc=0
BT_REPO="$RD" BT_LIBDIR="$BROKEN/lib" "$BROKEN/bt-trial" report >/dev/null 2>&1 || rc=$?
if (( rc != 0 )); then
    ok "report exits non-zero when an analysis program is missing (rc=$rc)"
else
    bad "report returned 0 with its analysis program missing — a partial report passed as success"
fi
rm -rf "$BROKEN"

# And a syntactically broken program must be fatal too, not merely noisy.
BROKEN2=$(mktemp -d)
mkdir -p "$BROKEN2/lib"
cp tools/lib/*.awk "$BROKEN2/lib/"
cp tools/bt-trial "$BROKEN2/"
printf 'BEGIN { if (1)\n  print "a"\n  print "b"\nelse print "c" }\n' > "$BROKEN2/lib/trial-sco-table.awk"
rc=0
BT_REPO="$RD" BT_LIBDIR="$BROKEN2/lib" "$BROKEN2/bt-trial" report >/dev/null 2>&1 || rc=$?
if (( rc != 0 )); then
    ok "report exits non-zero when an analysis program has a syntax error (rc=$rc)"
else
    bad "report returned 0 despite an awk parse error — exactly the original defect"
fi
rm -rf "$BROKEN2"

echo
echo "trial lifecycle — the PRODUCER, not just the report"
echo "──────────────────────────────────────────────────────────────"

# WHY THIS EXISTS. Every other bt-trial test drives `report` against a prebuilt
# results.tsv. That validates the consumer. It cannot notice that the producer
# is broken — and it was: the classifier read $tmo before it was collected and
# dereferenced $since before assignment, so under `set -u` trial closure aborted
# and no row was ever written. The outcome ontology was correct in the fixture
# and unreachable in production.
#
# So this drives the real path: open a trial, close it, and require a row.
LC=$(mktemp -d)
mkdir -p "$LC/evidence/trials" "$LC/state" "$LC/bin"; touch "$LC/install.sh"
git -C "$LC" init -q 2>/dev/null

# ── THE SANDBOX, BUILT BEFORE THE FIRST INVOCATION ────────────────────────
#
# These tests drive the REAL bt-trial, which on a failed trial runs the REAL
# bt-incident — a tool that copies journals, captures and state into
# evidence/sessions/. It resolves its own destination from BT_EVIDENCE_REPO,
# not BT_REPO, so redirecting the trial did not redirect the collector.
#
# For one run that is invisible. It became visible when the machine's own
# controller died: `ok` closures started reclassifying to `failed`, the failure
# branch fired, and every `tests/run-tests` deposited a fabricated incident
# directory into the real evidence tree. Ten accumulated, indistinguishable at
# a glance from the one genuine collection beside them.
#
# The stubs and the fake device therefore exist BEFORE the first bt-trial call,
# and every call goes through trial() below. An invocation that forgets one
# variable is no longer possible, because there is nowhere to forget it.
printf '#!/bin/sh\ntouch "%s/incident-was-called"\n' "$LC" > "$LC/bin/bt-incident"
chmod +x "$LC/bin/bt-incident"

# A fabricated controller, so the classifier is under test and not the radio.
# hci_alive() reads the live device tree; before this, every `ok` closure
# asserted against whatever the machine's real controller happened to be doing,
# and with the radio dead — the state this project exists to study — four
# invariants failed for reasons unrelated to the code.
mkdir -p "$LC/sysfs/3-3/3-3:1.0/bluetooth/hci0" "$LC/sysfs/3-3/power"
echo 13d3 > "$LC/sysfs/3-3/idVendor"
echo 3503 > "$LC/sysfs/3-3/idProduct"
echo on   > "$LC/sysfs/3-3/power/control"
# Answers unless a test stages a dead controller on purpose.
cat > "$LC/bin/hciconfig" <<STUB
#!/bin/sh
[ -e "$LC/controller-dead" ] && exit 1
exit 0
STUB
chmod +x "$LC/bin/hciconfig"

# The ONLY way these tests may invoke bt-trial.
trial() {
    PATH="$LC/bin:$PATH" \
    BT_REPO="$LC" BT_EVIDENCE_REPO="$LC" \
    BT_STATE="$LC/state" BT_SYSFS_USB="$LC/sysfs" \
    tools/bt-trial "$@"
}

rc=0
trial autostart stock >/dev/null 2>&1 || rc=$?
if (( rc == 0 )) && [[ -e "$LC/state/current" ]]; then
    ok "autostart opens a trial"
else
    bad "autostart failed (rc=$rc) or wrote no state file"
fi

rc=0
out=$(trial ok 2>&1) || rc=$?
if (( rc == 0 )); then
    ok "closing a trial completes without error"
else
    bad "closing a trial FAILED (rc=$rc):"
    tail -3 <<<"$out" | sed 's/^/      /'
fi

if [[ -s "$LC/evidence/trials/results.tsv" ]]; then
    ok "closing a trial writes a results row"
else
    bad "no results row written — the producer path is broken"
fi

# The row must carry both axes, populated with values from their domains. A
# blank or missing field here would make every later report refuse.
if [[ -s "$LC/evidence/trials/results.tsv" ]]; then
    bs=$(awk -F'\t' 'NR==1{for(i=1;i<=NF;i++)c[$i]=i;next} NR==2{print $c["bt1_status"]}' \
         "$LC/evidence/trials/results.tsv")
    tr=$(awk -F'\t' 'NR==1{for(i=1;i<=NF;i++)c[$i]=i;next} NR==2{print $c["trial_result"]}' \
         "$LC/evidence/trials/results.tsv")
    # `unknown` is a legitimate value — but not here. This host has a readable
    # journal, so `unknown` means evidence collection failed, and that is
    # exactly how the ordering bug manifested: $tmo was consulted before it was
    # assigned, every trial classified `unknown`, and every trial was excluded
    # from every rate. The denominator would have been permanently zero while
    # the report printed cleanly.
    #
    # Domain-membership alone would have passed that, since `unknown` is in the
    # domain. The assertion has to be that collection SUCCEEDED.
    case "$bs" in
        not_observed|confirmed|censored_pre_failure)
            ok "bt1_status populated from evidence ($bs)" ;;
        unknown)
            bad "bt1_status is 'unknown' on a host with a readable journal — evidence collection failed (classifier ordered before collection?)" ;;
        *)  bad "bt1_status is '${bs:-empty}' — outside its domain" ;;
    esac
    case "$tr" in
        survived|failed|alive_after_intervention|aborted)
            ok "trial_result populated from its domain ($tr)" ;;
        *)  bad "trial_result is '${tr:-empty}' — outside its domain" ;;
    esac

    # And the report must accept what the producer just wrote. Producer and
    # consumer agreeing separately with a fixture is not the same as agreeing
    # with each other.
    rc=0
    trial report >/dev/null 2>&1 || rc=$?
    (( rc == 0 )) && ok "report accepts a row the producer wrote" \
        || bad "report rejected the producer's own row (rc=$rc)"
fi

# THE HANG PATH, which no test reached until now — and which was broken.
# Classification assigns trial_result, then `outcome` was reused for control
# flow and still tested for the value `hang`, which the new ontology can never
# produce. A real failure therefore skipped bt-incident and printed the
# survival branch. The successful-close test could not see it.
# A stub bt-incident, ahead of the real one on PATH. It makes the test fast and
# turns "did the failure branch fire?" into a file that either exists or does
# not, rather than a string match on prose that could be reworded.

trial autostart stock >/dev/null 2>&1
rc=0
out=$(trial hang 2>&1) || rc=$?
if (( rc == 0 )); then
    ok "closing a trial as hang completes without error"
else
    bad "closing as hang FAILED (rc=$rc):"; tail -3 <<<"$out" | sed 's/^/      /'
fi

hr=$(awk -F'\t' 'NR==1{for(i=1;i<=NF;i++)c[$i]=i;next} END{print $c["trial_result"]}' \
     "$LC/evidence/trials/results.tsv")
[[ "$hr" == "failed" ]] && ok "an explicit hang records trial_result=failed" \
    || bad "hang recorded trial_result='${hr:-empty}', expected failed"

# The failure branch must actually invoke the incident collector. This is the
# defect that hid here: control flow tested `$outcome == hang`, a value the new
# ontology can never produce, so a real failure silently collected nothing.
if [[ -e "$LC/incident-was-called" ]]; then
    ok "a hang invokes the incident collector"
else
    bad "hang did NOT invoke bt-incident — control flow keyed on a dead value"
fi
# ── THE ONTOLOGY ITSELF, through the production producer ──────────────────
#
# Individual paths were tested; the combinations were not. These four are the
# meaningful ones, and each is driven by faking exactly the evidence the
# classifier reads — kernel timeouts and watchdog interventions — via a stub
# journalctl ahead of the real one on PATH.
#
#   no timeout, no intervention          -> not_observed + survived
#   timeout, controller dead             -> confirmed + failed
#   timeout, intervention, alive         -> confirmed + alive_after_intervention
#   early intervention, no timeout       -> censored_pre_failure + alive_after_intervention
#
# The last row is the one the whole ontology exists for: the intervention
# destroyed the counterfactual, so the evidence axis says censored while the
# controller axis says it is alive. Recording that as a survival or as a
# recovery would each state something untrue.

# A FABRICATED CONTROLLER, so the classifier is tested and not the radio.
#
# hci_alive() reads the live device tree, so before this existed every `ok`
# closure below asserted against whatever the machine's real controller was
# doing. With the radio dead — the state this project studies — all four `ok`
# rows reclassified to `failed` and the suite reported invariant failures that
# said nothing about the code. The tests now supply their own device via
# BT_SYSFS_USB and their own `hciconfig`, so the verdict is an input, not an
# accident of when the suite is run.
FAKEUSB="$LC/sysfs"
mkdir -p "$FAKEUSB/3-3/3-3:1.0/bluetooth/hci0" "$FAKEUSB/3-3/power"
echo 13d3 > "$FAKEUSB/3-3/idVendor"
echo 3503 > "$FAKEUSB/3-3/idProduct"
echo on   > "$FAKEUSB/3-3/power/control"
# Answers unless the caller asks it not to, so a test can stage a DEAD
# controller as deliberately as a live one.
cat > "$LC/bin/hciconfig" <<STUB
#!/bin/sh
[ -e "$LC/controller-dead" ] && exit 1
exit 0
STUB
chmod +x "$LC/bin/hciconfig"

combo() {
    local name="$1" ktext="$2" wtext="$3" close="$4" want_bs="$5" want_tr="$6"
    # A stub journalctl returning the requested evidence. -k selects the kernel
    # stream, -u bt-hang-watchdog the watchdog stream; anything else is empty.
    cat > "$LC/bin/journalctl" <<STUB
#!/bin/sh
for a in "\$@"; do
  case "\$a" in
    -k) printf '%s' "$ktext"; exit 0 ;;
    bt-hang-watchdog) printf '%s' "$wtext"; exit 0 ;;
  esac
done
exit 0
STUB
    chmod +x "$LC/bin/journalctl"
    rm -f "$LC/evidence/trials/results.tsv" "$LC/state/current"
    trial autostart stock >/dev/null 2>&1
    trial "$close" >/dev/null 2>&1
    local bs tr
    bs=$(awk -F"\t" 'NR==1{for(i=1;i<=NF;i++)c[$i]=i;next} END{print $c["bt1_status"]}' "$LC/evidence/trials/results.tsv" 2>/dev/null)
    tr=$(awk -F"\t" 'NR==1{for(i=1;i<=NF;i++)c[$i]=i;next} END{print $c["trial_result"]}' "$LC/evidence/trials/results.tsv" 2>/dev/null)
    if [[ "$bs" == "$want_bs" && "$tr" == "$want_tr" ]]; then
        ok "$name -> $bs + $tr"
    else
        bad "$name expected $want_bs + $want_tr, got '${bs:-empty}' + '${tr:-empty}'"
    fi
}

TMO_LINE='2026-08-13T01:00:00.000000+02:00 n kernel: Bluetooth: hci0: command tx timeout
'
# THE FORM THE KERNEL ACTUALLY EMITS. hci_cmd_timeout() names the opcode
# whenever it has one, so `command 0x0406 tx timeout` is the common case and the
# bare form above is the rare one. The stub used only the bare form, so the
# lifecycle tests passed against a pattern that matched NOTHING in the real
# journal: the first uncensored baseline trial recorded bt1_status=not_observed
# and timeouts=0 for a controller that had died with five of these.
#
# A fixture must be drawn from the log it claims to model, not from the shape
# the code happens to expect.
TMO_OPCODE_LINE='2026-08-13T01:00:00.000000+02:00 n kernel: Bluetooth: hci0: command 0x0406 tx timeout
'
# NOT a command timeout: ACL link supervision, a different event on a different
# layer. Widening the pattern to a bare "tx timeout" would silently fold these
# into the BT-1 count.
LINK_TMO_LINE='2026-08-13T01:00:00.000000+02:00 n kernel: Bluetooth: hci0: link tx timeout
'
EARLY_LINE='EARLY intervention: 1 audio-teardown failure(s) in 90s
'
LATE_LINE='Detected 6 controller timeouts within 60s - intervening.
'

combo "no timeout, no intervention" ""          ""                        ok   not_observed          survived
combo "timeout, closed as hang"      "$TMO_LINE" ""                        hang confirmed             failed
combo "timeout + intervention"       "$TMO_LINE" "$LATE_LINE"              ok   confirmed             alive_after_intervention
combo "early intervention only"      ""          "$EARLY_LINE"             ok   censored_pre_failure  alive_after_intervention
combo "opcode-form timeout, hang"    "$TMO_OPCODE_LINE" ""                 hang confirmed             failed
combo "link timeout is not BT-1"     "$LINK_TMO_LINE"   ""                 ok   not_observed          survived

# UNREADABLE WATCHDOG EVIDENCE MUST NOT BECOME NEGATIVE EVIDENCE.
#
# With a watchdog RUNNING, failing to read its journal means we cannot tell
# not_observed from censored_pre_failure. Before the fix, the failed read
# produced 0 via `grep -c ... || true` and the trial recorded a clean
# not_observed + survived — an intervention that may have happened, erased.
cat > "$LC/bin/systemctl" <<'STUB'
#!/bin/sh
# Report the watchdog as running; everything else inactive/empty.
case "$*" in
  *"is-active --quiet bt-hang-watchdog"*) exit 0 ;;
  *"show bt-hang-watchdog"*)              echo "BT_EARLY=1 BT_THRESHOLD=3"; exit 0 ;;
  *is-active*)                            exit 3 ;;
esac
exit 0
STUB
chmod +x "$LC/bin/systemctl"
cat > "$LC/bin/journalctl" <<'STUB'
#!/bin/sh
# Kernel stream readable and empty; watchdog stream UNREADABLE.
for a in "$@"; do
  case "$a" in
    -k)               exit 0 ;;
    bt-hang-watchdog) exit 1 ;;
  esac
done
exit 0
STUB
chmod +x "$LC/bin/journalctl"
rm -f "$LC/evidence/trials/results.tsv" "$LC/state/current"
trial autostart stock >/dev/null 2>&1
trial ok >/dev/null 2>&1
ubs=$(awk -F"\t" 'NR==1{for(i=1;i<=NF;i++)c[$i]=i;next} END{print $c["bt1_status"]}' \
      "$LC/evidence/trials/results.tsv" 2>/dev/null)
if [[ "$ubs" == "unknown" ]]; then
    ok "unreadable watchdog journal with watchdog running -> unknown"
else
    bad "unreadable watchdog journal gave '${ubs:-empty}', expected unknown"
fi

rm -f "$LC/bin/journalctl" "$LC/bin/systemctl"
rm -rf "$LC"

echo
echo "analysis refuses data that cannot justify it"
echo "──────────────────────────────────────────────────────────────"

# THE INVARIANT: an evidence-producing program must fail non-zero not only when
# its code cannot execute, but when its INPUT SCHEMA cannot justify the
# calculation.
#
# Resolving columns by name is only half the guarantee. If a required name is
# absent, awk turns the lookup into field 0 or an empty string and the program
# computes plausible nonsense while exiting successfully — the same wrong answer
# as reading the wrong field, reached by a different route. In the SCO table
# specifically, a missing `bt1_status` makes every row not-hung: a cross-tab
# asserting the stimulus never coincided with a failure.
SCHEMA=$(mktemp -d)
mkdir -p "$SCHEMA/evidence/trials"; touch "$SCHEMA/install.sh"; git -C "$SCHEMA" init -q 2>/dev/null

# 1. Required column removed entirely.
python3 - tests/trial-results.tsv "$SCHEMA/evidence/trials/results.tsv" <<'PY'
import sys
rows = [l.rstrip("\n").split("\t") for l in open(sys.argv[1]) if l.strip()]
i = rows[0].index("bt1_status")
with open(sys.argv[2], "w") as f:
    for r in rows:
        f.write("\t".join(v for j, v in enumerate(r) if j != i) + "\n")
PY
rc=0
BT_REPO="$SCHEMA" tools/bt-trial report >/dev/null 2>&1 || rc=$?
if (( rc != 0 )); then
    ok "report refuses a schema with no bt1_status column (rc=$rc)"
else
    bad "report accepted a schema with no bt1_status column"
fi

# And it must not print the table it is refusing to stand behind. awk runs END
# even after `exit`, so a naive refusal emits a plausible report alongside the
# non-zero status — and the report is what a human reads.
out=$(BT_REPO="$SCHEMA" tools/bt-trial report 2>/dev/null)
if grep -qE 'SCO setup requested|TRIAL TYPE .*HANGS' <<<"$out"; then
    bad "a refused report still printed its table"
else
    ok "a refused report prints no table"
fi

# 2. Required column present, value outside the known domain.
python3 - tests/trial-results.tsv "$SCHEMA/evidence/trials/results.tsv" <<'PY'
import sys
rows = [l.rstrip("\n").split("\t") for l in open(sys.argv[1]) if l.strip()]
i = rows[0].index("bt1_status")
rows[1][i] = "potato"
with open(sys.argv[2], "w") as f:
    for r in rows:
        f.write("\t".join(r) + "\n")
PY
rc=0
BT_REPO="$SCHEMA" tools/bt-trial report >/dev/null 2>&1 || rc=$?
if (( rc != 0 )); then
    ok "report refuses an unrecognised bt1_status value (rc=$rc)"
else
    bad "an unrecognised bt1_status was silently counted"
fi
rm -rf "$SCHEMA"

echo
echo "documentation-drift detector"
echo "──────────────────────────────────────────────────────────────"

# The detector previously counted install.sh and uninstall.sh as code but
# excluded them from the timestamp comparison, so a change to either was
# described as a code change in the warning text while being unable to raise
# it. Two path lists that must agree, maintained separately, is the same
# species of defect as two timestamp parsers that must agree.
#
# Assert there is ONE list, used for both. Testing the git-history behaviour
# directly would depend on this repository's own commit times, which change
# every commit.
V=devtools/repo-validate
uses=$(grep -c 'KNOWLEDGE_PATHS\[@\]' "$V" || true)
if [[ "$uses" == "2" ]]; then
    ok "one path set used for both the count and the timestamp"
else
    bad "expected KNOWLEDGE_PATHS used exactly twice, found $uses"
fi

if grep -qE 'log (-1 |-20 )?--pretty=%ct -- (tools|bin|systemd)( |$)' "$V"; then
    bad "a git path list is still spelled inline instead of using the array"
else
    ok "no inline path list bypasses the shared array"
fi

# The paths that can change what the project knows must all be watched. etc/
# carries the udev rules whose provenance EX-012 turned on; tests/ and devtools/
# change what the repository claims to validate.
missing=""
for pth in tools bin systemd etc tests devtools install.sh uninstall.sh; do
    grep -q "KNOWLEDGE_PATHS=(.*\b${pth}\b" "$V" || missing="$missing $pth"
done
if [[ -z "$missing" ]]; then
    ok "every knowledge-changing path is watched"
else
    bad "unwatched implementation paths:$missing"
fi

echo
echo "pipefail inverts grep -q"
echo "──────────────────────────────────────────────────────────────"

# THE INVARIANT: no tool here decides a yes/no question with
# `<producer> | grep -q PATTERN` under `set -o pipefail`.
#
# grep -q exits at the first match. The producer then dies of SIGPIPE, pipefail
# propagates its non-zero status, and the pipeline reports FAILURE precisely
# when the pattern was found. bt-boot-provenance printed `no` for every boot on
# its first run, including boots whose journal plainly contains the device —
# the answer was inverted, not missing, which reads as a result rather than as
# an error.
#
# Every script here sets `set -uo pipefail`, so this is a property of the
# repository, not of one tool. Counted output compared against zero is immune.
#
# THE FILE SET IS DERIVED, NOT LISTED. The first version of this check scanned
# `tools bin devtools` — a hand-written list, which is the defect this
# repository has now shipped four times. It missed install.sh and uninstall.sh,
# both of which set pipefail, and install.sh held TWO instances including the
# `failed_this_boot` guard whose sole purpose is to stop a btusb reload from
# destroying a stage-1 observation. That guard would have reported "safe to
# reload" in exactly the state it exists to protect, against a journal of
# millions of lines — the size at which the producer is certain to still be
# writing when grep exits.
#
# So the set is every file in the repository carrying a shell shebang. A script
# added anywhere is covered the moment it exists.
if (( ${#SHFILES[@]} == 0 )); then
    bad "could not enumerate shell scripts — refusing to report this check as passed"
else
    # PIPEFAIL-DEMO marks the single deliberate instance below, which exists to
    # demonstrate the inversion. An exemption has to be visible in the source it
    # exempts, not hidden in the checker.
    QGREP=$(grep -n -- '| *grep -q' "${SHFILES[@]}" 2>/dev/null \
            | grep -v "^[^:]*:[0-9]*:[[:space:]]*#" \
            | grep -v 'PIPEFAIL-DEMO')
    if [[ -z "$QGREP" ]]; then
        ok "no grep -q pipeline in any of the ${#SHFILES[@]} shell scripts tracked here"
    else
        bad "grep -q at the end of a pipeline — inverted under pipefail:"
        while IFS= read -r l; do echo "        $l"; done <<<"$QGREP"
    fi
    # And the derivation must actually reach the files a hand-written list
    # missed, or it is the same check wearing a better comment.
    for must in install.sh uninstall.sh; do
        if [[ " ${SHFILES[*]} " == *" $must "* ]]; then
            ok "the derived set includes $must"
        else
            bad "$must is not in the derived shell-script set"
        fi
    done
fi

# The behaviour itself, so the rule above is anchored to something demonstrable
# rather than to a claim in a comment.
( set -o pipefail
  yes x | grep -q x ) 2>/dev/null   # PIPEFAIL-DEMO: the one deliberate instance
if (( $? != 0 )); then
    ok "confirmed: a matching grep -q pipeline exits non-zero under pipefail"
else
    ok "grep -q pipeline is not inverted on this shell — rule kept regardless"
fi

echo
echo "results.tsv — header and rows must stay the same width"
echo "──────────────────────────────────────────────────────────────"

# THE INVARIANT: every data row has exactly as many fields as the header.
#
# Columns are resolved by NAME everywhere, which is the right rule and is
# separately enforced above. But name resolution silently degrades when the
# widths disagree: awk maps the header names onto positions once, and a row
# with two extra fields shifts nothing while a row with two missing fields
# hands back empty strings for real columns. Adding prev_shutdown and
# enum_at_boot to the producer without migrating the existing file would have
# produced exactly that — a 20-field header over a 22-field row, every value
# after `kernel` unreachable and every value before it still looking correct.
#
# The live file is checked, not a fixture: the migration is the thing at risk.
WIDTH=$(awk -F'\t' 'NR==1{n=NF; next} NF && NF!=n {print NR": "NF" vs "n}' \
        evidence/trials/results.tsv 2>/dev/null)
if [[ -z "$WIDTH" ]]; then

# UNREADABLE IS NOT CHANGED — and the difference decides a denominator.
#
# env_fingerprint reads power/control out of the device's sysfs directory. When
# the controller has left the USB bus that directory is gone and the field reads
# `?`. The endpoint comparison treated `power=auto` -> `power=?` as a treatment
# change, prefixed the row CHANGED:, and CHANGED: rows are excluded from every
# rate — so a trial was dropped from the failure statistics BECAUSE it reached
# stage 2. Observed on trial stock #2, 2026-08-14.
#
# The helper is sourced from the tool itself rather than copied, so this cannot
# pass against a version bt-trial no longer runs.
eval "$(awk '/^treatment_only_became_unreadable\(\)/,/^}/' tools/bt-trial)"
TS_A="autosusp=Y,power=auto,wd=off,probes=off"
if treatment_only_became_unreadable "$TS_A" "autosusp=Y,power=?,wd=off,probes=off"; then
    ok "a field becoming unreadable at close is not a treatment change"
else
    bad "device-absent power=? still counts as CHANGED — stage-2 trials excluded from rates"
fi
if treatment_only_became_unreadable "$TS_A" "autosusp=N,power=auto,wd=off,probes=off"; then
    bad "a REAL treatment change was accepted as merely unreadable"
else
    ok "a real treatment change is still CHANGED"
fi
# And a field going the other way — unreadable at open, real at close — is a
# change, not a recovery of the same treatment.
if treatment_only_became_unreadable "autosusp=Y,power=?,wd=off,probes=off" "$TS_A"; then
    bad "unreadable-at-open to readable-at-close was accepted as unchanged"
else
    ok "unreadable at open, readable at close is still CHANGED"
fi

    ok "every row in results.tsv matches the header width"
else
    bad "results.tsv row/header width mismatch:"
    while IFS= read -r l; do echo "        line $l fields"; done <<<"$WIDTH"
fi

# And the producer's header must carry the columns the producer writes. A row
# printf and a header printf that drift apart is the same defect arriving by a
# different route.
for col in prev_shutdown enum_at_boot perturbed bt1_status trial_result; do
    # Counted: `head | grep -q` is the inverted-pipeline pattern, and a header
    # check that reports "column missing" when the column is present would fail
    # this suite for the opposite of the real reason.
    n_col=$(head -1 evidence/trials/results.tsv 2>/dev/null | grep -c "$col" || true)
    if (( ${n_col:-0} > 0 )); then
        ok "results.tsv header declares $col"
    else
        bad "results.tsv header is missing $col"
    fi
done

# A trial perturbed mid-run must be excluded from every denominator, exactly as
# a treatment-changed one is. The endpoint comparison cannot see an intervention
# that restores what it changed — a btusb reload leaves both fingerprints
# identical — so this is the only thing standing between a reset controller and
# a clean-looking row in a rate table.
PERT=$(mktemp)
{ head -1 evidence/trials/results.tsv
  printf 'x\tcontrolled_v2\tstock\tPERTURBED:btusb_reload:a=1\tr\t9\tv2\tconfirmed\tfailed\t10\t1\t1\t1\tno\tyes\t0\t0\t?\t0\tk\treboot\tyes\tbtusb_reload\n'
} > "$PERT"
PO=$(awk -f tools/lib/trial-summary.awk "$PERT" 2>&1)
if grep -q 'CHANGED or PERTURBED' <<<"$PO" && ! grep -q 'PERTURBED:btusb_reload:a=1' <<<"$PO"; then
    ok "a perturbed trial is excluded and reported, not given its own rate"
else
    bad "perturbed trial was not excluded from the rate table"
fi
rm -f "$PERT"

echo
echo "bt-stage2 — censoring is not a measurement"
echo "──────────────────────────────────────────────────────────────"

# THE INVARIANT: a stage-1 window that WE ended may never be counted as an
# observation of how long the controller survives.
#
# This is the mistake the tool exists to prevent, and the project made it for
# months: "45-66 s from HCI silence to USB collapse" was computed over boots in
# which the watchdog reset the controller in between. The watchdog fired on
# precisely the boots that progressed, and it fired first.
#
# The fixture has ten boots — natural disconnect, disconnect after our btusb
# unload, no terminator at all, a clean reset of UNKNOWN origin, a
# `link tx timeout` that is not a BT-1 event, a natural progression with a
# pre-terminator bus error, a clean reset in the boot AFTER that error, a
# window in which only a FOREIGN device (usb 1-2) disconnects, a boot with no
# failure, and an automatic kernel-treatment reset.
#
# NOT covered here, and deliberately said out loud: the `dev_error` cross-boot
# leak. That boot now carries a positive watchdog marker, which sets term_kind
# first, so the reset line is skipped by the first-terminator-wins guard and
# the leak is never exercised. Mutating away either `dev_error = 0` reset
# leaves this section green — verified. The guard against that regression is
# the boot-separator reset itself, which no assertion here can fail on; a
# fixture boot with a bus error followed, in the NEXT boot, by an unmarked
# clean reset and a disconnect would be needed to close it.
S2=$(awk -f tools/lib/timestamp.awk -f tools/lib/stage2.awk \
     tests/stage2-invariants.data 2>&1)

nat=$(grep -oP 'ended naturally\s+\K[0-9]+' <<<"$S2")
inv=$(grep -oP 'ended by positive intervention\s+\K[0-9]+' <<<"$S2")
krs=$(grep -oP 'ended by kernel treatment reset\s+\K[0-9]+' <<<"$S2")
urs=$(grep -oP 'ended by unknown-origin reset\s+\K[0-9]+' <<<"$S2")
shd=$(grep -oP 'ended by shutdown\s+\K[0-9]+' <<<"$S2")
[[ "$nat" == "2" ]] && ok "counts exactly the two naturally-ended windows" \
    || bad "expected 2 natural, got ${nat:-none} — dev_error leaking across boots?"
[[ "$inv" == "2" ]] && ok "counts only positively established interventions as intervened" \
    || bad "expected 2 positive interventions, got ${inv:-none}"
[[ "$krs" == "1" ]] && ok "separates an automatic kernel-treatment reset" \
    || bad "expected 1 kernel-treatment reset, got ${krs:-none}"
[[ "$urs" == "1" ]] && ok "a clean USB reset without provenance remains unknown" \
    || bad "expected 1 unknown-origin reset, got ${urs:-none}"
[[ "$shd" == "2" ]] && ok "a boot that simply ended is censored, not natural" \
    || bad "expected 2 shutdown, got ${shd:-none} — a foreign device's disconnect must not terminate a window"

# The headline figure must come from the natural window (50 s) and NOT from the
# longest one (4331.99 s, ended by shutdown). Reporting the larger number as the
# survival time is the exact error, with the sign reversed.
grep -q 'longest uncensored HCI-to-USB-loss window   50.00s' <<<"$S2" \
    && ok "headline survival time is taken from the uncensored window" \
    || bad "natural maximum wrong: $(grep -o 'longest uncensored[^\n]*' <<<"$S2")"

# Every censored row must say so where it is read, not only in the summary.
[[ "$(grep -c 'RIGHT-CENSORED' <<<"$S2")" == "6" ]] \
    && ok "each censored window is labelled at the point of use" \
    || bad "expected 6 RIGHT-CENSORED labels, got $(grep -c 'RIGHT-CENSORED' <<<"$S2")"

# A `link tx timeout` boot must not open a window at all — it is an ACL
# supervision timeout, and counting it would invent a stage-1 event.
grep -q 'boots with HCI non-response   8' <<<"$S2" \
    && ok "link tx timeout does not open an HCI-nonresponse window" \
    || bad "wrong boot count: $(grep -o 'boots with HCI non-response[^\n]*' <<<"$S2")"

# Boots with no enumeration line for the device run unfiltered, and the summary
# must SAY so rather than present their classification as anchored.
grep -q 'had no enumeration line naming 13d3:3503' <<<"$S2" \
    && ok "unanchored boots are disclosed in the summary" \
    || bad "unfiltered classification not disclosed for boots lacking an enumeration line"

echo
echo "one spelling of the BT-1 timeout"
echo "──────────────────────────────────────────────────────────────"

# THE INVARIANT: every tool that counts BT-1 timeouts must use the same pattern,
# and that pattern must be `command( 0x[0-9a-f]+)? tx timeout`.
#
# Ten call sites across nine files each carried their own literal, and they
# disagreed in both directions against the same journal:
#
#   "command tx timeout"    matched 8 of 173 real command timeouts — the
#                           kernel names the opcode whenever it has one, so the
#                           first uncensored baseline trial recorded timeouts=0
#                           for a controller that had died with five
#   "tx timeout"            matched 180, folding in 7 `link tx timeout` lines —
#                           ACL supervision, a different layer entirely
#
# A shared file would be the usual fix, but these ship to three different
# directories and two are invoked by udev before /usr/local is interesting. So
# the literal is repeated and the repetition is policed here instead: no
# grep-family call anywhere may spell it any other way.
# Scans the derived set, not `tools bin devtools`. install.sh matches this
# pattern too, and was outside the old list.
#
# THE SCAN MUST SEE EVERY QUOTING AND CALLING FORM. The first version matched
# only `-c`/`-cE` immediately before a DOUBLE-quoted pattern — so six live call
# sites passed under its green tick: single-quoted patterns ('tx timeout'),
# bare `grep "tx timeout"` with no flag, and the count()/cnt() helper wrappers
# whose grep lives elsewhere. A check that cannot fail is not a check; this one
# was proven blind by feeding it each of those forms. It now matches any
# grep/count/cnt invocation with a quoted string containing the phrase, in
# either quoting style, and excludes only the canonical spelling and comments.
# ${TT} is assembled so this file's own scanner lines cannot self-match.
TT='tx timeout'
STRAY=$(grep -nE "(grep|count|cnt)[^|#]*['\"][^'\"]*${TT}" "${SHFILES[@]}" 2>/dev/null \
        | grep -vF "command( 0x[0-9a-f]+)? ${TT}" \
        | grep -v '^[^:]*:[0-9]*:[[:space:]]*#')
if [[ -z "$STRAY" ]]; then
    ok "every BT-1 timeout count uses the opcode-aware pattern (${#SHFILES[@]} files)"
else
    bad "call sites spelling the timeout pattern differently:"
    while IFS= read -r l; do echo "        $l"; done <<<"$STRAY"
fi

# And the pattern itself must do what the comment claims, against lines taken
# verbatim from this machine's journal.
PATFIX=$(mktemp)
cat > "$PATFIX" <<'FIX'
Bluetooth: hci0: command 0x0406 tx timeout
Bluetooth: hci0: command tx timeout
Bluetooth: hci0: link tx timeout
FIX
n=$(grep -cE 'command( 0x[0-9a-f]+)? tx timeout' "$PATFIX")
if [[ "$n" == "2" ]]; then
    ok "pattern accepts both command forms and rejects link tx timeout"
else
    bad "pattern matched $n of 3 fixture lines, expected 2"
fi
rm -f "$PATFIX"

echo
echo "uninstall.sh removes everything install.sh installs"
echo "──────────────────────────────────────────────────────────────"

# THE INVARIANT: every install_file destination appears in uninstall.sh's
# FILES list. The two lists are maintained in different files by different
# edits, which is the hand-written-list class this repository has now shipped
# five times — most recently as four artifacts (bt-interval, bt-stage2,
# bt-boot-provenance, lib/stage2.awk) that install.sh shipped and uninstall.sh
# left behind while printing "Uninstall is a complete restoration".
#
# One-directional on purpose: uninstall may legitimately list MORE (generated
# udev rules, drop-ins written outside install_file, mode stamps).
INSTALLED=$(awk '{ while (/\\$/ && (getline nxt) > 0) { sub(/\\$/, "", $0); $0 = $0 nxt } print }' \
                install.sh 2>/dev/null \
            | grep -oE 'install_file[[:space:]]+"\$SRC/[^"]+"[[:space:]]+[^[:space:]]+' \
            | awk '{print $3}' | sort -u)
UNFILES=$(sed -n '/^FILES=(/,/^)/p' uninstall.sh | grep -oE '/[a-zA-Z0-9._/-]+' | sort -u)
if [[ -z "$INSTALLED" || -z "$UNFILES" ]]; then
    bad "could not parse install/uninstall file lists — refusing to report this check as passed"
else
    ORPHANS=$(comm -23 <(printf '%s\n' "$INSTALLED") <(printf '%s\n' "$UNFILES"))
    if [[ -z "$ORPHANS" ]]; then
        ok "every install_file destination is in uninstall.sh's FILES list ($(wc -l <<<"$INSTALLED") checked)"
    else
        bad "installed but never uninstalled:"
        while IFS= read -r l; do echo "        $l"; done <<<"$ORPHANS"
    fi
fi

# EXECUTABLE IN THE REPOSITORY, not only after installation.
#
# bin/bt-usbmon was tracked mode 100644 — the only script in the tree that was
# not executable. install.sh gives it 0755 at its destination, so an installed
# system was fine and nothing noticed; but `bin/bt-usbmon` from a checkout
# exits 126, and the README tells a reader to clone and run these directly.
# Found by writing the first test that ever tried to run it.
#
# Derived from the shebang, so a script added tomorrow is covered without
# anyone maintaining a list — the failure mode every hand-written list in this
# repository has already hit.
NOTEXEC=""; NEXEC=0
while IFS= read -r f; do
    [[ -f "$f" ]] || continue
    [[ "$(head -c2 "$f" 2>/dev/null)" == "#!" ]] || continue
    NEXEC=$((NEXEC + 1))
    [[ -x "$f" ]] || NOTEXEC="$NOTEXEC $f"
done < <(git ls-files 2>/dev/null | grep -vE '\.(md|awk|conf|service|timer|rules|json|ya?ml|log|tsv|txt|in|expected|rc)$')
[[ -z "$NOTEXEC" ]] && (( NEXEC >= 20 )) \
    && ok "all $NEXEC tracked scripts with a shebang are executable" \
    || bad "checked $NEXEC script(s); not executable:$NOTEXEC"

echo
echo "exhibit extraction commands are re-runnable, not session-local"
echo "──────────────────────────────────────────────────────────────"

# THE INVARIANT: an exhibit's "Re-runnable as-is" command may not reference a
# session-temporary path. EX-018 shipped reading its journal dump from an
# editor-tooling scratchpad under /tmp — a path that leaked tooling metadata,
# carried a session UUID the publication scan flags, and exists on no machine.
# Stable machine-local paths stay legal: /var/tmp/ survives reboots and is the
# documented cache location, and /root/exp/... backups are the provenance of
# real captures. What is banned is the class that cannot outlive the session
# that wrote it: /tmp/ (but not /var/tmp/), mktemp, and scratchpad paths.
EXBAD=""
for ex in evidence/exhibits/[0-9][0-9][0-9]-*.md; do
    [[ -r "$ex" ]] || continue
    # Only the fenced command block is scanned. Prose in the same section may
    # legitimately NAME a banned path while explaining its removal — EX-018's
    # edit note does exactly that, and the first version of this check flagged
    # the explanation of the defect as the defect.
    hit=$(sed -n '/^## Extraction method/,/^## Output/p' "$ex" \
          | sed -n '/^```console/,/^```$/p' \
          | grep -nE '(^|[^a-z])/tmp/|mktemp|scratchpad' || true)
    [[ -n "$hit" ]] && EXBAD="$EXBAD$ex: $hit"$'\n'
done
if [[ -z "$EXBAD" ]]; then
    ok "no exhibit extraction command references a session-temporary path"
else
    bad "session-temporary paths in extraction commands:"
    while IFS= read -r l; do [[ -n "$l" ]] && echo "        $l"; done <<<"$EXBAD"
fi

echo
echo "awk libraries, case by case"
echo "──────────────────────────────────────────────────────────────"
#
# TABLE-DRIVEN, because the alternative is what the rest of this file does:
# hand-written assertions, one per behaviour, which is fine for an invariant
# that needs a paragraph of explanation and wasteful for a library that simply
# has to produce the right bytes for a given input.
#
# `devtools/coverage` showed why this section exists. All six awk libraries were
# loaded by the suite, but the three LARGEST were the three least exercised —
# trial-sco-table.awk is 114 lines entered exactly once, trial-summary.awk is
# 177 lines entered twice. Load count is not line coverage, and a 177-line
# program with domain checks and three exclusion paths entered twice is not
# covered by any definition.
#
# Layout, per library directory under tests/fixtures/:
#   <case>.in        the input file the library is given
#   <case>.expected  stdout AND stderr, combined, byte for byte
#   <case>.rc        the exit status
#
# stderr is captured because the refusals ARE the behaviour here: a report that
# cannot justify its arithmetic must not print it, and "printed nothing, exited
# 1" is the assertion.
#
# ONE GROUP KEY PER FIXTURE. trial-summary iterates `for (k in tot)`, and awk's
# hash order is not specified, so a fixture with two group keys could emit its
# rows in either order and fail intermittently. Split such a case into two
# fixtures rather than sorting the output, which would destroy the row/treatment
# pairing the report prints.
for libdir in tests/fixtures/*/; do
    lib="tools/lib/$(basename "$libdir").awk"
    if [[ ! -r "$lib" ]]; then
        bad "fixture directory $libdir has no library $lib"
        continue
    fi
    # Optional DEPS file: extra libraries to load with -f BEFORE the one under
    # test, one basename per line. stage2.awk needs iso_secs() from
    # timestamp.awk — exactly as bt-stage2 loads it — and running it alone
    # fails at the first timestamp. The dependency list lives with the
    # fixtures, not here, so adding a library never means editing the harness.
    depargs=()
    if [[ -r "$libdir/DEPS" ]]; then
        while IFS= read -r dep; do
            [[ -n "$dep" ]] || continue
            if [[ ! -r "tools/lib/$dep" ]]; then
                bad "$(basename "$libdir")/DEPS names a missing library: $dep"
                continue 2
            fi
            depargs+=(-f "tools/lib/$dep")
        done < "$libdir/DEPS"
    fi
    ncase=0
    for in in "$libdir"*.in; do
        [[ -e "$in" ]] || continue
        case_name=$(basename "${in%.in}")
        exp="${in%.in}.expected"; rcf="${in%.in}.rc"
        if [[ ! -r "$exp" || ! -r "$rcf" ]]; then
            bad "$(basename "$libdir")/$case_name: missing .expected or .rc"
            continue
        fi
        got=$(awk "${depargs[@]}" -f "$lib" "$in" 2>&1); got_rc=$?
        want=$(cat "$exp"); want_rc=$(cat "$rcf")
        if [[ "$got" == "$want" && "$got_rc" == "$want_rc" ]]; then
            ok "$(basename "$libdir")/$case_name"
            ncase=$((ncase + 1))
        else
            bad "$(basename "$libdir")/$case_name (rc $got_rc, want $want_rc)"
            diff <(echo "$want") <(echo "$got") | head -8 | sed 's/^/        /'
        fi
    done
    (( ncase == 0 )) && bad "$(basename "$libdir"): no cases ran"
done

echo
echo "whole tools, not just the awk they call"
echo "──────────────────────────────────────────────────────────────"
#
# WHY THIS SECTION EXISTS.
#
# `devtools/coverage` measured what this suite actually executes: 41 of 43
# tracked shell scripts never ran a single line, and the total was 13.1%. The
# awk was well covered; the shell around it was not covered at all. bt-phase
# was the clearest case — the suite pulled its awk body out with a regex and
# tested that, so the file that ships had 0.0% of 117 lines executed.
#
# The two tools below need no seam to be driven from a fixture: bt-interval
# takes its inputs as arguments, and bt-stage2 already accepts `--from FILE`.
# They were untested anyway. Everything here exercises the SHELL — argument
# parsing, the library-presence guards, and the refusal paths — because that is
# the part no awk fixture can reach.

# ── bt-interval ───────────────────────────────────────────────────────────
# The arithmetic is already asserted above through interval.awk directly. What
# is asserted here is the wrapper's contract: that it forwards, validates, and
# REFUSES rather than printing a number the caller would quote into evidence.
iv_out=$(tools/bt-interval 2026-08-13T05:14:16.715095+02:00 2026-08-13T05:14:30.461003+02:00 2>&1); iv_rc=$?
if (( iv_rc == 0 )) && [[ "$iv_out" == "13.746" ]]; then
    ok "bt-interval prints the interval and exits 0"
else
    bad "bt-interval: expected 13.746 rc=0, got '$iv_out' rc=$iv_rc"
fi

# A reversed pair is the caller's most likely mistake and the most damaging:
# a negative interval quoted as a duration. It must not reach stdout.
iv_out=$(tools/bt-interval 2026-08-13T05:14:30.461003+02:00 2026-08-13T05:14:16.715095+02:00 2>&1); iv_rc=$?
if (( iv_rc != 0 )) && [[ "$iv_out" == *"negative interval"* ]]; then
    ok "bt-interval refuses a reversed pair instead of printing a negative"
else
    bad "bt-interval accepted reversed arguments (rc=$iv_rc): $iv_out"
fi

iv_out=$(tools/bt-interval not-a-timestamp 2026-08-13T05:14:16.715095+02:00 2>&1); iv_rc=$?
if (( iv_rc != 0 )) && [[ "$iv_out" == *"could not parse"* ]]; then
    ok "bt-interval refuses an unparseable timestamp"
else
    bad "bt-interval accepted an unparseable timestamp (rc=$iv_rc): $iv_out"
fi

tools/bt-interval 2026-08-13T05:14:16.715095+02:00 >/dev/null 2>&1
(( $? == 2 )) && ok "bt-interval exits 2 on wrong argument count" \
              || bad "bt-interval did not exit 2 on a single argument"

# The library guard. A tool that silently computes nothing when its shipped awk
# is missing is exactly the `-f` trap this repository was bitten by: no error,
# no output, and a caller that reads the empty result as a valid answer.
EMPTYLIB=$(mktemp -d)
iv_out=$(BT_LIBDIR="$EMPTYLIB" tools/bt-interval \
         2026-08-13T05:14:16.715095+02:00 2026-08-13T05:14:30.461003+02:00 2>&1); iv_rc=$?
if (( iv_rc != 0 )) && [[ "$iv_out" == *"missing"* ]]; then
    ok "bt-interval refuses when its awk library is absent"
else
    bad "bt-interval ran without its library (rc=$iv_rc): $iv_out"
fi

# ── bt-stage2 ─────────────────────────────────────────────────────────────
# Driven through the SCRIPT with --from, over the same fixture the awk section
# above drives directly. The awk assertions prove the analysis; these prove the
# script that ships actually reaches it and hands it the right file.
S2W=$(tools/bt-stage2 --from tests/stage2-invariants.data 2>&1); s2_rc=$?
if (( s2_rc == 0 )); then
    ok "bt-stage2 --from analyses a fixture without touching the journal"
else
    bad "bt-stage2 --from failed (rc=$s2_rc):"
    tail -3 <<<"$S2W" | sed 's/^/      /'
fi

# The headline number must survive the trip through the script, not just the
# awk. If the wrapper ever hands the analysis the wrong file — a cache, a
# partial dump — this is what notices.
if [[ "$S2W" == *"longest uncensored HCI-to-USB-loss window   50.00s"* ]]; then
    ok "bt-stage2 reports the natural window through the full script path"
else
    bad "bt-stage2 lost the natural maximum through the script path"
fi

# An empty dump must refuse. The cache branch would otherwise reuse a journal
# read that a reboot truncated to nothing and report on it as if complete —
# the failure the tool's own header calls out.
EMPTYDUMP=$(mktemp)
tools/bt-stage2 --from "$EMPTYDUMP" >/dev/null 2>&1
(( $? != 0 )) && ok "bt-stage2 refuses an empty journal dump" \
              || bad "bt-stage2 reported on an empty dump"

tools/bt-stage2 --from /nonexistent/dump >/dev/null 2>&1
(( $? != 0 )) && ok "bt-stage2 refuses an unreadable --from" \
              || bad "bt-stage2 accepted an unreadable --from"

tools/bt-stage2 --bogus >/dev/null 2>&1
(( $? == 2 )) && ok "bt-stage2 exits 2 on an unknown argument" \
              || bad "bt-stage2 did not exit 2 on an unknown argument"

s2_out=$(BT_LIBDIR="$EMPTYLIB" tools/bt-stage2 --from tests/stage2-invariants.data 2>&1)
if [[ "$s2_out" == *"missing"* ]]; then
    ok "bt-stage2 refuses when its awk libraries are absent"
else
    bad "bt-stage2 ran without its libraries: $s2_out"
fi

# ── bt-boot-provenance ────────────────────────────────────────────────────
#
# THE INVARIANT THIS TOOL EXISTS TO GET RIGHT, AND SHIPPED WRONG.
#
# It printed `hci=no` for all six boots, including boots whose journal plainly
# contains the device, for its entire life. `journalctl ... | grep -q` exits
# non-zero exactly when the pattern IS found — grep leaves at the first match,
# journalctl dies of SIGPIPE, pipefail propagates it — so the answer was
# inverted rather than missing, which is the kind of wrong that reads as a
# result. The fixture below puts the device in boot 0 and not in boot -1, so a
# re-inversion cannot pass.
BP=tests/journal/provenance
PROV=$(BT_JOURNAL_FIXTURE="$BP" tools/bt-boot-provenance 2>&1); prov_rc=$?

if (( prov_rc == 0 )); then
    ok "bt-boot-provenance runs to completion over a fixture"
else
    bad "bt-boot-provenance failed (rc=$prov_rc):"
    tail -3 <<<"$PROV" | sed 's/^/      /'
fi

# Read the hci column per row rather than grepping the whole output, so a tool
# that prints `yes` somewhere unrelated cannot satisfy this.
#
# Field 9, not 7: `started` and `ended` are each a date AND a time, so they take
# two fields apiece — boot, date, time, date, time, gap, prev end, firmware,
# hci. Counting the COLUMNS in the header rather than the fields in the row is
# how the first version of this check read `prev end` and announced that the
# inversion was back when it was not.
hci0=$(awk '$1 == "0"  { print $9 }' <<<"$PROV" | head -1)
hcim1=$(awk '$1 == "-1" { print $9 }' <<<"$PROV" | head -1)
if [[ "$hci0" == "yes" ]]; then
    ok "bt-boot-provenance reports hci=yes for a boot that HAS the device"
else
    bad "the grep -q inversion is back: boot 0 has the device but reported '${hci0:-none}'"
fi
if [[ "$hcim1" == "no" ]]; then
    ok "bt-boot-provenance reports hci=no for a boot without the device"
else
    bad "boot -1 has no device but reported '${hcim1:-none}'"
fi

# The gap is the arithmetic EX-017 turned on: 11:30:00 to 11:31:38 is 98 s.
# Computed with date(1) across two rows, so an off-by-one row would show it.
if [[ "$PROV" == *"98s"* ]]; then
    ok "bt-boot-provenance computes the inter-boot gap"
else
    bad "inter-boot gap wrong; expected 98s"
fi

# `journalctl --list-boots` PRINTS A HEADER ROW, and the fixture now carries
# one. Without a numeric filter the header is taken for a boot: `IDX` reaches
# `$((off - 1))`, and the consequence is not the unbound-variable message on
# stderr — it is that the header becomes a ROW, and the next real boot's gap is
# computed against its garbage timestamp. Boot -1 printed `-226800s`.
#
# A NEGATIVE INTER-BOOT GAP IS THE FAILURE THAT MATTERS. This column is what
# EX-017 argues from. The first version of these tests asserted only that "98s"
# appeared somewhere and that the two known boots had the right hci values —
# all still true with a junk row above them and a negative gap beside them. The
# fixture had no header, so nothing modelled it; the check came from the other
# side of a merge, and the fixture was extended to meet it.
# THE TABLE REGION, not "lines whose first field is numeric". The first
# version of this check counted numeric-first-field rows and asserted there
# were two — which is true WITH the header-row bug present, because `IDX` is
# not numeric and so was never counted. It passed while claiming "header
# excluded", the exact shape of check this suite exists to eliminate: one that
# cannot fail for the reason its name gives. Caught by an outside reviewer of
# the rebase, not by this suite. Now it reads every row the table actually
# prints and requires each one to be a boot.
tbl=$(awk '/^──/ { inb = 1; next } inb && NF == 0 { inb = 0 } inb { print }' <<<"$PROV")
rows=$(grep -c . <<<"$tbl")
nonnum=$(awk '$1 !~ /^-?[0-9]+$/ { n++ } END { print n + 0 }' <<<"$tbl")
[[ "$rows" == "2" && "$nonnum" == "0" ]] \
    && ok "bt-boot-provenance emits one row per boot, header excluded" \
    || bad "table has $rows row(s), $nonnum non-numeric — a header row became a boot?"

neg=$(grep -cE '(^|[[:space:]])-[0-9]+s([[:space:]]|$)' <<<"$PROV")
(( ${neg:-0} == 0 )) && ok "no negative inter-boot gap reaches the table" \
                     || bad "a NEGATIVE gap was printed — the column EX-017 argues from"

PROVERR=$(BT_JOURNAL_FIXTURE="$BP" tools/bt-boot-provenance 2>&1 >/dev/null)
[[ -z "$PROVERR" ]] && ok "bt-boot-provenance runs without shell errors on stderr" \
                    || bad "stderr not clean: $(head -1 <<<"$PROVERR")"

# prev end is the PREVIOUS boot's shutdown target, not this one's. Reading the
# current boot would put reboot on the wrong row and invert the recovery mark.
if [[ "$PROV" == *"reboot"* && "$PROV" == *"poweroff"* ]]; then
    ok "bt-boot-provenance attributes each shutdown target to the previous boot"
else
    bad "shutdown-target attribution wrong"
fi

tools/bt-boot-provenance not-a-number >/dev/null 2>&1
(( $? == 2 )) && ok "bt-boot-provenance exits 2 on a non-numeric count" \
              || bad "bt-boot-provenance accepted a non-numeric count"

BPL=$(BT_LIBDIR=/nonexistent BT_JOURNAL_FIXTURE="$BP" tools/bt-boot-provenance 2>&1)
[[ "$BPL" == *"missing"* ]] \
    && ok "bt-boot-provenance refuses without its journal library" \
    || bad "bt-boot-provenance ran without journal.sh"

# ── bt-actions ────────────────────────────────────────────────────────────
# The classifier bank and the collapse/cadence renderer, over a fixture that
# exercises one rule from each class plus a repeat burst. Classifiers rot
# silently as log formats drift; a pinned fixture is what notices.
BA=tests/journal/actions
AOUT=$(BT_JOURNAL_FIXTURE="$BA" tools/bt-actions 2>&1); arc=$?
(( arc == 0 )) && ok "bt-actions renders a timeline from a fixture" \
               || bad "bt-actions failed (rc=$arc)"

for want in "turned Bluetooth OFF" "a2dp-sink: connecting -> connected" \
            "HCI COMMAND TIMEOUT 0x0406" "EARLY intervention" \
            "DEVICE LEFT THE USB BUS"; do
    if [[ "$AOUT" == *"$want"* ]]; then
        ok "bt-actions classifies: $want"
    else
        bad "bt-actions no longer classifies: $want"
    fi
done

# The collapse is the tool's whole reason to exist — thousands of repeats of
# one line are unreadable — and the cadence divides microseconds by 1e6, which
# an earlier version got wrong by a factor of 1000.
[[ "$AOUT" == *"x3 until"* && "$AOUT" == *"every ~10.0s"* ]] \
    && ok "bt-actions collapses a repeat burst and computes its cadence" \
    || bad "collapse/cadence wrong: $(grep 'x3' <<<"$AOUT" || echo none)"

ARAW=$(BT_JOURNAL_FIXTURE="$BA" tools/bt-actions --raw 2>&1)
n=$(grep -c 'HCI COMMAND TIMEOUT 0x0406' <<<"$ARAW")
(( ${n:-0} == 3 )) && ok "bt-actions --raw shows all three repeats uncollapsed" \
                   || bad "--raw showed $n of 3 repeats"

AEMPTY=$(BT_JOURNAL_FIXTURE="$BA" tools/bt-actions -b 7 2>&1); aerc=$?
(( aerc == 0 )) && [[ "$AEMPTY" == *"no recognised events"* ]] \
    && ok "bt-actions reports an empty boot instead of an empty table" \
    || bad "empty-boot path wrong (rc=$aerc): $AEMPTY"

tools/bt-actions --bogus >/dev/null 2>&1
(( $? != 0 )) && ok "bt-actions rejects an unknown argument" \
              || bad "bt-actions accepted an unknown argument"

# ── every classifier rule, against a line it must match ──────────────────
#
# WHY THIS FIXTURE IS EXHAUSTIVE RATHER THAN REPRESENTATIVE.
#
# devtools/awk-coverage — which measures the awk this project computes in,
# something devtools/coverage structurally cannot — reported this classifier at
# 39% of 172 statements, and named the branches that had never executed:
#
#   "USB descriptor read FAILED — device not answering USB core"
#   "USB device NOT ACCEPTING ADDRESS"
#   "xHCI setup device command TIMEOUT"
#   the AVDTP Abort/Start timeouts, the HFP and A2DP connect refusals
#
# Those are STAGE 2 — the controller leaving the USB bus, which is the part of
# this bug the kernel log barely records and the part the report turns on. The
# rules for it existed and nothing had ever run them. A pattern that does not
# match is not a wrong answer; it is silence, and the timeline simply would not
# contain the most important event in the capture.
#
# So: one fixture line per rule, in source order, and the invariant is that
# EVERY line classifies. A rule added later without a line makes the counts
# disagree, and awk-coverage names it.
ACTALL=tests/journal/actions-all
AAOUT=$(BT_JOURNAL_FIXTURE="$ACTALL" tools/bt-actions -b 0 --raw 2>&1); aarc=$?
# The table starts after the three header lines.
aarows=$(sed -n '4,$p' <<<"$AAOUT" | grep -c .)
aalines=$(grep -c . "$ACTALL/default.b0.log")
(( aarc == 0 && aarows == aalines )) \
    && ok "every line of the exhaustive fixture is classified ($aarows rules)" \
    || bad "classified $aarows of $aalines fixture lines (rc=$aarc) — a rule matched nothing"

# THE STAGE-2 SIGNATURES, by name. These are the four the coverage report found
# unexercised, and they are the ones a maintainer reads the timeline for.
aamissing=""
while IFS= read -r want; do
    [[ "$AAOUT" == *"$want"* ]] || aamissing="$aamissing; $want"
done <<'WANTS'
USB descriptor read FAILED — device not answering USB core
USB device NOT ACCEPTING ADDRESS
xHCI setup device command TIMEOUT
*** DEVICE LEFT THE USB BUS ***
WANTS
[[ -z "$aamissing" ]] \
    && ok "the stage-2 USB signatures classify from real kernel log text" \
    || bad "stage 2 went unclassified:$aamissing"

# 0x0428 is the SCO setup implicated in the hang; naming it is what makes the
# timeline readable without a spec to hand, and mis-naming it would point a
# maintainer at the wrong command.
[[ "$AAOUT" == *"HCI cmd 0x0428  Setup Synchronous Connection (SCO/HFP)"* \
   && "$AAOUT" == *"HCI cmd 0x0406  Disconnect"* ]] \
    && ok "bt-actions names the opcodes it claims to name" \
    || bad "the opcode naming table did not fire"

# A COMMAND TIMEOUT AND A COMMAND SUBMISSION ARE DIFFERENT EVENTS, and the
# submission rule matches `hci0 opcode 0x... plen` while the timeout rule
# matches `command 0x... tx timeout`. Confusing them would report every
# submitted command as a timeout — the count this whole repository turns on.
aa_to=$(grep -c 'HCI COMMAND TIMEOUT' <<<"$AAOUT")
aa_cmd=$(grep -c 'HCI cmd 0x' <<<"$AAOUT")
(( ${aa_to:-0} == 2 && ${aa_cmd:-0} == 5 )) \
    && ok "command submissions and command timeouts stay distinct (5 and 2)" \
    || bad "submission/timeout confusion: timeouts=$aa_to submissions=$aa_cmd"

# An unrecognised line must produce NO row. A classifier that emits a row for
# everything turns a timeline into the log it was meant to reduce.
AANOISE=$(mktemp -d)
printf '2026-08-13T09:00:00.000000+02:00 host kernel: something entirely unrelated\n' \
    > "$AANOISE/default.b0.log"
AANOUT=$(BT_JOURNAL_FIXTURE="$AANOISE" tools/bt-actions -b 0 --raw 2>&1)
[[ "$AANOUT" != *"entirely unrelated"* ]] \
    && ok "an unrecognised line produces no timeline row" \
    || bad "the classifier emitted a row for a line no rule matches"
rm -rf "$AANOISE"

echo
echo "bt-hang-watchdog — the decisions, never the actuation"
echo "──────────────────────────────────────────────────────────────"
#
# A PRINTED heading, not only a comment: --section addresses printed output,
# and a mutation run earlier grepped a comment-only heading, matched nothing,
# and reported two live mutations as caught-nothing. The filter can only find
# what the suite says out loud.
# The watchdog decides whether to reset a live controller. The DECISIONS —
# threshold, window, cooldown, escalation order, give-up — are what these
# tests reach; the actuation is exactly what they must never perform. So the
# journal is a fixture, the sysfs tree is fake, and the action tools are PATH
# stubs that RECORD their invocation to a spy log instead of doing anything.
# The spy log is the assertion surface: "systemctl stop bluetooth" appearing
# in it is the test that the watchdog decided to act.
#
# The stubbed `sleep` returns instantly (recover() alone carries ~19 s of real
# sleeps) EXCEPT for the give-up idle loop's 3600 s, which stays real so the
# loop parks instead of busy-spinning; that scenario is bounded by timeout(1).
WD=$(mktemp -d)
mkdir -p "$WD/stub" "$WD/sysfs/3-3/3-3:1.0/bluetooth/hci0" "$WD/drv"
echo 13d3 > "$WD/sysfs/3-3/idVendor";  echo 3503 > "$WD/sysfs/3-3/idProduct"
echo 3    > "$WD/sysfs/3-3/busnum";    echo 99   > "$WD/sysfs/3-3/devnum"

cat > "$WD/stub/systemctl" <<STUB
#!/bin/sh
echo "systemctl \$*" >> "$WD/spy.log"; exit 0
STUB
cat > "$WD/stub/sleep" <<STUB
#!/bin/sh
echo "sleep \$1" >> "$WD/spy.log"
[ "\${1:-0}" -ge 3600 ] 2>/dev/null && exec /bin/sleep "\$1"
exit 0
STUB
# Liveness is scripted per scenario: `dead` = always dead, `dead-once` = dead
# for one probe then alive (drives the escalation path exactly once).
cat > "$WD/stub/hciconfig" <<STUB
#!/bin/sh
echo "hciconfig \$*" >> "$WD/spy.log"
[ -e "$WD/dead" ] && exit 1
if [ -e "$WD/dead-once" ]; then rm -f "$WD/dead-once"; exit 1; fi
exit 0
STUB
printf '#!/bin/sh\nexit 0\n' > "$WD/stub/loginctl"
chmod +x "$WD/stub"/*

wd_run() {   # <timeout-s> [env overrides...] — runs the watchdog over the fixture
    local t="$1"; shift
    timeout "$t" env PATH="$WD/stub:$PATH" \
        BT_JOURNAL_FIXTURE=tests/journal/watchdog \
        BT_SYSFS_USB="$WD/sysfs" BT_SYSFS_DRIVERS="$WD/drv" \
        BT_COOLDOWN=99999 "$@" bin/bt-hang-watchdog 2>&1
}

# Scenario 1: threshold -> intervene -> escalate once -> recover; then the
# remaining fixture signals re-reach the threshold and hit the cooldown.
: > "$WD/spy.log"; touch "$WD/dead-once"
WOUT=$(wd_run 10); wrc=$?
[[ "$WOUT" == *"Detected 3 controller timeouts within 60s — intervening."* ]] \
    && ok "watchdog intervenes at the threshold" \
    || bad "watchdog did not intervene at 3/60s"
[[ "$WOUT" == *"USBDEVFS_RESET failed"* ]] \
    && ok "watchdog logs the failed USB reset (no device node here, by design)" \
    || bad "USB reset outcome not logged"
[[ "$WOUT" == *"escalating to USB unbind/bind"* ]] \
    && ok "watchdog escalates when the controller stays dead after reset" \
    || bad "escalation path not taken"
[[ "$WOUT" == *"RECOVERED — confirmed stalled controller is responding again"* ]] \
    && ok "watchdog confirms recovery of a CONFIRMED stall through the probe" \
    || bad "recovery not confirmed"
[[ "$WOUT" == *"suppressed by cooldown"* ]] \
    && ok "watchdog suppresses a re-trigger inside the cooldown, loudly" \
    || bad "cooldown suppression missing or silent"
# The spy log is the proof no decision was skipped and nothing real was run.
grep -c 'systemctl stop bluetooth' "$WD/spy.log" >/dev/null \
    && grep -c 'systemctl start bluetooth' "$WD/spy.log" >/dev/null \
    && ok "spy log shows the bluetooth service stop/start pair" \
    || bad "spy log missing the systemctl pair"
u=$(cat "$WD/drv/unbind" 2>/dev/null); bnd=$(cat "$WD/drv/bind" 2>/dev/null)
[[ "$u" == "3-3" && "$bnd" == "3-3" ]] \
    && ok "escalation unbinds and rebinds the right device (3-3)" \
    || bad "unbind/bind wrote '$u'/'$bnd', expected 3-3"
# The fixture ends; the reader terminating must be loud, never a silent respawn.
(( wrc == 1 )) && [[ "$WOUT" == *"journal reader terminated unexpectedly"* ]] \
    && ok "watchdog exits loudly when the journal stream ends" \
    || bad "stream-end exit wrong (rc=$wrc)"

# Scenario 2: every recovery fails -> give up after MAX_FAILS, then idle.
: > "$WD/spy.log"; touch "$WD/dead"; rm -f "$WD/drv/unbind" "$WD/drv/bind"
GOUT=$(wd_run 3 BT_COOLDOWN=0 BT_MAX_FAILS=1); grc=$?
[[ "$GOUT" == *"RECOVERY FAILED"* && "$GOUT" == *"Giving up: 1 consecutive recovery attempts failed."* ]] \
    && ok "watchdog gives up after MAX_FAILS confirmed failures" \
    || bad "give-up path not reached"
[[ "$GOUT" == *"idling — cold power-off required"* ]] && (( grc == 124 )) \
    && ok "given up, the watchdog idles instead of respawning (killed by test timeout)" \
    || bad "idle path wrong (rc=$grc)"
rm -f "$WD/dead"

# Scenario 3: EARLY mode acts on one audio-teardown signal, before any timeout.
# The early stream is the merged kernel+bluetoothd query, which the seam
# resolves to default.log — carrying exactly one cancel_request() Abort.
: > "$WD/spy.log"
EOUT=$(wd_run 10 BT_EARLY=1)
[[ "$EOUT" == *"EARLY intervention: 1 audio-teardown failure(s)"* \
   && "$EOUT" == *"resetting BEFORE any HCI timeout"* ]] \
    && ok "EARLY mode intervenes on a single teardown signal" \
    || bad "EARLY intervention not taken"
# An early intervention fires BEFORE any HCI timeout, so a controller that
# answers afterwards cannot show that BT-1 was imminent — the counterfactual is
# censored by the act of intervening. The message used to call that outcome a
# success; it now records what was actually observed and says what it cannot
# tell you. The assertion follows, and requires the qualification: without it
# the log would again read as evidence that early intervention prevents BT-1.
[[ "$EOUT" == *"CONTROLLER RESPONDS AFTER EARLY INTERVENTION"* \
   && "$EOUT" == *"counterfactual censored"* ]] \
    && ok "an early intervention records a response, not a prevented failure" \
    || bad "EARLY recovery outcome wrong"

# ── the capability probe, which decides whether recovery can be CONFIRMED ─
#
# Without a probe the watchdog can still reset the controller; it just cannot
# tell whether that worked. The dangerous outcome is not "unconfirmed" — it is
# counting every unconfirmable attempt as a FAILURE, because MAX_FAILS then
# disables the watchdog on a perfectly healthy machine. So the unverifiable
# case is a third answer, not a lost coin toss.
WDNOP="$WD/noprobe"; mkdir -p "$WDNOP"
cp "$WD/stub/systemctl" "$WD/stub/sleep" "$WDNOP/" 2>/dev/null
NOPOUT=$(: > "$WD/spy.log"; touch "$WD/dead"
    timeout 10 env PATH="$WDNOP:/usr/bin:/bin" \
        BT_JOURNAL_FIXTURE=tests/journal/watchdog \
        BT_SYSFS_USB="$WD/sysfs" BT_SYSFS_DRIVERS="$WD/drv" \
        BT_COOLDOWN=99999 bin/bt-hang-watchdog 2>&1)
[[ "$NOPOUT" == *"neither hciconfig nor btmgmt found"* \
   && "$NOPOUT" == *"cannot be confirmed"* ]] \
    && ok "with no probe tool the watchdog warns that recovery is unconfirmable" \
    || bad "the no-probe warning did not appear"
[[ "$NOPOUT" != *"consecutive failed recoveries"* ]] \
    && ok "an unverifiable recovery is not counted as a failure" \
    || bad "unconfirmable recoveries were counted as failures — MAX_FAILS would disable the watchdog"

# btmgmt is the fallback probe. It is selected only when hciconfig is absent,
# so a stub directory holding one and not the other is the whole test.
WDBM="$WD/btmgmt-only"; mkdir -p "$WDBM"
cp "$WD/stub/systemctl" "$WD/stub/sleep" "$WDBM/" 2>/dev/null
printf '#!/bin/sh\necho "btmgmt $*" >> "%s/spy.log"\nexit 0\n' "$WD" > "$WDBM/btmgmt"
printf '#!/bin/sh\nexec /usr/bin/timeout "$@"\n' > "$WDBM/timeout" 2>/dev/null
chmod +x "$WDBM"/* 2>/dev/null
: > "$WD/spy.log"; rm -f "$WD/dead"
BMOUT=$(timeout 10 env PATH="$WDBM:/usr/bin:/bin" \
        BT_JOURNAL_FIXTURE=tests/journal/watchdog \
        BT_SYSFS_USB="$WD/sysfs" BT_SYSFS_DRIVERS="$WD/drv" \
        BT_COOLDOWN=99999 bin/bt-hang-watchdog 2>&1)
[[ "$BMOUT" != *"neither hciconfig nor btmgmt"* ]] && grep -q '^btmgmt ' "$WD/spy.log" \
    && ok "btmgmt is used as the probe when hciconfig is absent" \
    || bad "the btmgmt fallback probe was not selected or not called"

# ── verbose mode, which is what an operator turns on to see the window ────
: > "$WD/spy.log"; rm -f "$WD/dead"
VBOUT=$(wd_run 10 BT_VERBOSE=1)
[[ "$VBOUT" == *"verbose mode ON"* ]] \
    && ok "verbose mode announces itself rather than changing behaviour silently" \
    || bad "BT_VERBOSE=1 did not announce itself"

# ── the give-up path ─────────────────────────────────────────────────────
#
# After MAX_FAILS CONFIRMED failures the watchdog stops trying. That is
# correct — repeatedly resetting a controller that will not come back adds
# perturbation to an investigation without adding information — but it must
# SAY so, because a silent give-up is indistinguishable from a watchdog that
# is working.
: > "$WD/spy.log"; touch "$WD/dead"
GUOUT=$(wd_run 15 BT_MAX_FAILS=1 BT_COOLDOWN=0)
[[ "$GUOUT" == *"Giving up:"* && "$GUOUT" == *"consecutive recovery attempts failed"* ]] \
    && ok "the watchdog says when it gives up, rather than falling silent" \
    || bad "MAX_FAILS was reached without a give-up message"
rm -f "$WD/dead"

# Scenario 4: the device is off the bus when the threshold trips — stage 2.
# The watchdog must say so in the terms the operator needs (power-off, not
# reboot), not attempt a recovery against nothing.
EMPTYSYS=$(mktemp -d)
FOUT=$(timeout 10 env PATH="$WD/stub:$PATH" \
        BT_JOURNAL_FIXTURE=tests/journal/watchdog \
        BT_SYSFS_USB="$EMPTYSYS" BT_SYSFS_DRIVERS="$WD/drv" \
        BT_COOLDOWN=99999 bin/bt-hang-watchdog 2>&1)
[[ "$FOUT" == *"FATAL"* && "$FOUT" == *"full power-off"* ]] \
    && ok "watchdog reports the hard hang instead of resetting a ghost" \
    || bad "hard-hang path wrong"

# THE ESCAPE, NOW A TESTED DECISION.
#
# This is the scenario that ran the real bt-trial on the investigation machine
# and closed a live trial. The watchdog closes the boot's auto-trial here on
# purpose — leaving it to the shutdown hook would record a meaningless
# duration after the machine has sat dead for hours — and it does so through a
# BARE NAME resolved from PATH.
#
# So the decision is worth asserting, and the actuation must not happen. The
# PATH guard at the top of this file supplies a recording bt-trial; the spy
# log is what proves the watchdog took the decision, and the guard is what
# proves it did not reach the installed copy.
[[ "$FOUT" == *"auto-trial closed as HANG"* ]] \
    && ok "watchdog closes the boot's auto-trial on the hard-hang path" \
    || bad "the auto-trial was not closed — the decision was not taken"

grep -q '^bt-trial hang$' "$GUARD_LOG" \
    && ok "that closure went to the guard, not to the installed bt-trial" \
    || bad "bt-trial hang was not intercepted — it may have reached the real tool"

# AND THE GUARD ITSELF, asserted where it cannot depend on the machine.
#
# THIS IS WHY THE ESCAPE WAS INVISIBLE HERE. On a development checkout nothing
# is installed, so `command -v bt-trial` finds nothing, the watchdog's `&&`
# short-circuits, and the escape cannot happen — the suite is green and the
# defect is real. It only fires where the tools ARE installed, which is the
# investigation machine, which is the one place it must never fire.
#
# So the guard is asserted directly rather than through its effect: every name
# the shipped code invokes bare must resolve INSIDE the guard. That check gives
# the same answer on a bare checkout and on the installed machine, which is the
# property the original invariant lacked.
guard_leaks=""
while IFS= read -r tool; do
    [[ -n "$tool" ]] || continue
    where=$(command -v "$tool" 2>/dev/null || true)
    [[ "$where" == "$GUARD/bin/$tool" ]] || guard_leaks="$guard_leaks $tool->${where:-none}"
done < <(guard_names)
guard_checked=$(guard_names | grep -c .)
[[ -z "$guard_leaks" ]] && (( ${guard_checked:-0} >= 20 )) \
    && ok "all $guard_checked PATH-installed tools resolve inside the suite's guard" \
    || bad "guard covers $guard_checked tool(s); leaks:$guard_leaks"

# And the decoy — standing in for the installed copies — was never reached.
# This is the assertion that would have gone red on the investigation machine
# before the guard existed, and unlike the two above it goes red on a bare
# checkout too, because the hazard is constructed rather than inherited.
[[ ! -e "$DECOY_HIT" ]] \
    && ok "no bare-name call reached a tool behind the guard" \
    || bad "the guard was bypassed: $(tr '\n' ' ' < "$DECOY_HIT")"
rm -rf "$WD" "$EMPTYSYS"

# ── the six journal-only tools (CS-06 / CS-07) ────────────────────────────
#
# Small tools, converted together because they share one shape: read the
# journal, count or tabulate, print. Each assertion below is a NUMBER the
# fixture determines, not merely "it ran" — a tool that reads the journal and
# prints an empty table exits 0 too.
BJ=tests/journal/boots

# bt-boots: one row per boot, kernel version and timeout count per row. The
# counts differ per boot (1 and 2) so a tool that reads the wrong boot's log,
# or the same log twice, cannot pass.
BOUT=$(BT_JOURNAL_FIXTURE="$BJ" tools/bt-boots 2>&1); brc=$?
(( brc == 0 )) && ok "bt-boots tabulates over a fixture" || bad "bt-boots failed (rc=$brc)"
r1=$(awk '$1 == "-1" {print $2, $3}' <<<"$BOUT")
r0=$(awk '$1 == "0"  {print $2, $3}' <<<"$BOUT")
[[ "$r1" == "7.0.0-28-generic 1" ]] \
    && ok "bt-boots reads boot -1's own kernel and timeout count" \
    || bad "boot -1 row wrong: '$r1'"
[[ "$r0" == "7.0.0-29-generic 2" ]] \
    && ok "bt-boots reads boot 0's own kernel and timeout count" \
    || bad "boot 0 row wrong: '$r0'"

# bt-boot-list: numeric offsets only, header row excluded — the same header
# that crashed bt-boot-provenance. The fixture carries one.
BLOUT=$(BT_JOURNAL_FIXTURE="$BJ" tools/bt-boot-list 2>&1)
[[ "$(tr '\n' ' ' <<<"$BLOUT" | tr -s ' ')" == "-1 0 " ]] \
    && ok "bt-boot-list emits exactly the numeric offsets, header excluded" \
    || bad "bt-boot-list emitted: $(tr '\n' ' ' <<<"$BLOUT")"

# The rest of bt-boot-list's surface. Boot enumeration is subtle enough that
# every other tool defers to this one rather than reimplementing it (its own
# header says so), which makes each of these paths load-bearing for tools that
# never touch a journal themselves.
BLC=$(BT_JOURNAL_FIXTURE="$BJ" tools/bt-boot-list --count 2>&1)
[[ "$BLC" == "2" ]] \
    && ok "bt-boot-list --count reports how many boots it found" \
    || bad "--count said '$BLC', not 2"

BLN=$(BT_JOURNAL_FIXTURE="$BJ" tools/bt-boot-list -n 1 2>&1)
[[ "$BLN" == "0" ]] \
    && ok "bt-boot-list -n takes the most recent boots, not the oldest" \
    || bad "-n 1 returned '$BLN' — expected the newest boot, 0"

BLH=$(tools/bt-boot-list --help 2>&1); blhrc=$?
(( blhrc == 0 )) && [[ -n "$BLH" ]] \
    && ok "bt-boot-list --help prints usage and exits 0" \
    || bad "--help failed (rc=$blhrc)"

tools/bt-boot-list --bogus >/dev/null 2>&1
(( $? == 2 )) && ok "bt-boot-list exits 2 on an unknown option" \
              || bad "bt-boot-list did not refuse an unknown option with 2"

# THE FALLBACK CHAIN'"'"'S LAST RUNG. An empty fixture directory answers
# --list-boots with nothing, so JSON, the table reader and the plain reader all
# come up empty. The tool must then say it is assuming the current boot only —
# a caller that silently assumed more history than exists draws conclusions
# from boots that were never examined, which is the failure this warning
# exists to prevent.
BLEMPTY=$(mktemp -d)
BLW=$(BT_JOURNAL_FIXTURE="$BLEMPTY" tools/bt-boot-list 2>&1); blwrc=$?
(( blwrc == 0 )) && [[ "$BLW" == *"could not enumerate boots"* && "$BLW" == *"0"* ]] \
    && ok "bt-boot-list warns out loud when it can enumerate nothing" \
    || bad "empty enumeration was silent (rc=$blwrc): $BLW"
rm -rf "$BLEMPTY"

# bt-boot-stats: per-boot timeout counts again, through a different reader.
BSOUT=$(BT_JOURNAL_FIXTURE="$BJ" BT_BOOT_LIST=tests/journal/boots/boot-list tools/bt-boot-stats 2>&1)
[[ "$(awk '$1 == "-1" {print $5}' <<<"$BSOUT")" == "1" \
   && "$(awk '$1 == "0" {print $5}' <<<"$BSOUT")" == "2" ]] \
    && ok "bt-boot-stats counts timeouts per boot from the fixture" \
    || bad "bt-boot-stats timeout column wrong"

# bt-timeline.sh: the current boot only, and it must classify the kernel
# timeout lines rather than dumping the log.
TLOUT=$(BT_JOURNAL_FIXTURE="$BJ" tools/bt-timeline.sh 2>&1)
# The opcode-aware spelling, like every other counting site in this
# repository — the repo-wide invariant flagged this line when it was written
# with a bare opcode, which is the check working on the tests themselves.
n=$(grep -cE 'command( 0x[0-9a-f]+)? tx timeout' <<<"$TLOUT")
(( ${n:-0} == 2 )) && ok "bt-timeline.sh renders this boot's kernel events" \
                   || bad "bt-timeline.sh showed $n of 2 timeout lines"

# bt-logvolume: a rate computed from a line count. The count is what the
# fixture fixes; the rate depends on uptime and is not asserted.
LVOUT=$(BT_JOURNAL_FIXTURE="$BJ" tools/bt-logvolume 2>&1)
[[ "$(awk '/total lines/ {print $3}' <<<"$LVOUT")" == "3" ]] \
    && ok "bt-logvolume counts the fixture's lines" \
    || bad "bt-logvolume total wrong: $(grep 'total lines' <<<"$LVOUT")"

# bt-env-history: reads per-boot watchdog and probe state. Asserted only to
# run and produce a row per boot — its columns come from units this fixture
# deliberately does not carry, and asserting "-" everywhere would pin
# absence rather than behaviour.
EHOUT=$(BT_JOURNAL_FIXTURE="$BJ" tools/bt-env-history 2>&1); ehrc=$?
(( ehrc == 0 )) && ok "bt-env-history runs over a fixture without a journal" \
                || bad "bt-env-history failed (rc=$ehrc)"

# ── bt-health-report: the judgement on whether the mitigation works ───────
#
# This is the tool whose output would be quoted to answer "did the fix help?",
# computed from per-boot counts. A miscount here is a wrong claim about the
# mitigation — the conclusion this project most needs to be right — and none of
# its 116 lines had ever executed under test.
#
# The fixture makes the boots DIFFER: boot -1 carries four timeouts, boot 0
# carries none. A tool that read the wrong boot, or summed them, cannot produce
# both numbers.
HR=tests/journal/health
HRSYS=$(mktemp -d); mkdir -p "$HRSYS/usb/3-3" "$HRSYS/mod"
echo 13d3 > "$HRSYS/usb/3-3/idVendor"; echo 3503 > "$HRSYS/usb/3-3/idProduct"
echo N > "$HRSYS/mod/enable_autosuspend"
HROUT=$(BT_JOURNAL_FIXTURE="$HR" BT_SYSFS_USB="$HRSYS/usb" BT_SYSFS_MODULE="$HRSYS/mod" \
        BT_METRICS=/nonexistent tools/bt-health-report.sh 2>&1); hrrc=$?
(( hrrc == 0 )) && ok "bt-health-report runs over a fixture" \
                || bad "bt-health-report failed (rc=$hrrc)"

# Per-boot counts, read from the table by boot id — not grepped from anywhere
# in the output, so a number appearing on the wrong row cannot satisfy this.
tm1=$(awk '$1 == "-1" { print $3 }' <<<"$HROUT" | head -1)
t0=$(awk  '$1 == "0"  { print $3 }' <<<"$HROUT" | head -1)
[[ "$tm1" == "4" && "$t0" == "0" ]] \
    && ok "bt-health-report counts timeouts per boot, not pooled" \
    || bad "per-boot timeout counts wrong: boot-1=$tm1 boot0=$t0 (want 4 and 0)"

[[ "$HROUT" == *"7.0.0-28-generic"* ]] \
    && ok "bt-health-report reads each boot's kernel version" \
    || bad "kernel version column empty"

# The report must not tell the operator to run an internal shell function. A
# blanket seam conversion rewrote this advice line to `bt_journal -u ... -f`,
# which no user can execute — caught by reading the output, and pinned here.
[[ "$HROUT" == *"journalctl -u bt-hang-watchdog -f"* ]] \
    && ok "bt-health-report's operator advice names a real command" \
    || bad "advice line names something the operator cannot run"

# column(1) is absent from minimal images; its error must not land in the
# middle of a report someone is reading for a verdict.
[[ "$HROUT" != *"column: command not found"* ]] \
    && ok "bt-health-report degrades cleanly without column(1)" \
    || bad "column(1) error leaked into the report body"

# ── the four verdicts, which ARE the answer to "did the fix help?" ───────
#
# A live adapter, so the report gets past the down-right-now check and reaches
# the counters. Each fixture differs only in what the watchdog log contains,
# because that is the only thing separating the four sentences.
mkdir -p "$HRSYS/bt/hci0"
hrv() { BT_JOURNAL_FIXTURE="tests/journal/$1" BT_SYSFS_USB="$HRSYS/usb"         BT_SYSFS_MODULE="$HRSYS/mod" BT_SYSFS_BT="$HRSYS/bt"         BT_METRICS="${2:-/nonexistent}" tools/bt-health-report.sh 2>&1; }

HRV1=$(hrv hr-none)
[[ "$HRV1" == *"no watchdog intervention is recorded"* \
   && "$HRV1" == *"does not imply that no timeout occurred"* ]] \
    && ok "bt-health-report will not read an absent intervention as an absent fault" \
    || bad "zero interventions was reported without its alternative explanation"

# That qualification is the assertion. "No timeouts" reads as the mitigation
# working, and the tool says in the same breath that it also reads as nobody
# having used Bluetooth — which is the difference between evidence and an
# absence of evidence.

HRV2=$(hrv hr-working)
# Upstream retired the "WORKING" verdict: a recovery event is a recorded
# observation, not a demonstration that the mitigation works, and the two
# readings differ by exactly the counterfactual nobody has.
[[ "$HRV2" == *"1 confirmed post-timeout HCI recovery event(s) recorded"* \
   && "$HRV2" != *"VERDICT: WORKING"* ]] \
    && ok "a confirmed recovery is counted as an observation, not as proof the fix works" \
    || bad "the WORKING verdict did not fire or lost its count"

# The legacy marker is the same log line the old watchdog wrote for BOTH an
# early-action response and a post-timeout recovery. Its context cannot be
# recovered from aggregate logs, and saying so is the point — treating it as a
# confirmed recovery is what the split exists to stop.
HRV2L=$(hrv hr-legacy)
# Anchored to the VERDICT line, not the whole report: the counter block prints
# "confirmed post-timeout recovery: 0" on every run, so a whole-output check
# for that phrase fails on a report where the verdict is already correct.
hr_verdict=$(grep -m1 'VERDICT:' <<<"$HRV2L")
[[ "$hr_verdict" == *"legacy RECOVERED marker(s) have mixed context"* \
   && "$hr_verdict" != *"confirmed post-timeout"* ]] \
    && ok "a legacy RECOVERED marker is reported as ambiguous, not as a recovery" \
    || bad "a legacy marker was counted as a confirmed recovery"

# INTERVENED BUT NEVER RECOVERED splits two ways, and the split matters: a
# controller that was already hard-hung before the last cold boot is not a
# failure of the mitigation, and reading it as one would retire a fix that
# works. The two fixtures differ ONLY in whether the interventions appear in
# boot 0.
HRV3=$(hrv hr-stale)
[[ "$HRV3" == *"all predate the current boot"* && "$HRV3" == *"Keep measuring"* ]]     && ok "interventions from before the last cold boot are not counted against the fix"     || bad "stale interventions were read as a live failure"

HRV4=$(hrv hr-thisboot)
# Upstream also removed the advice to lower BT_THRESHOLD here. Reset may itself
# alter the trajectory, so "intervene sooner" is not a safe conclusion from
# "intervention did not restore HCI" — the verdict says so instead of naming a
# knob.
[[ "$HRV4" == *"THIS BOOT and never"* && "$HRV4" == *"reset may itself alter the trajectory"* \
   && "$HRV4" != *"BT_THRESHOLD"* ]] \
    && ok "a failed intervention does not become an argument for intervening sooner" \
    || bad "the live-failure verdict did not fire or gave no next step"

# The metrics table and the row count, from a real file rather than the
# absent-file branch every other case here takes.
HRM=$(mktemp)
printf 'timestamp	tx_timeouts
2026-08-10T09:00:00	0
2026-08-10T09:05:00	2
' > "$HRM"
HRV5=$(hrv hr-working "$HRM")
[[ "$HRV5" == *"rows collected: 2"* ]]     && ok "bt-health-report reports how many metric rows it read"     || bad "the metrics row count is wrong or absent"
rm -f "$HRM"

# BT_CHANGE_TIME decides which boots are labelled before/after the mitigation,
# and mislabelling drags a pre-install boot's timeout counts into the after
# column — contaminating the one comparison the report exists to make.
# The hr-phase fixture is EPOCH-formatted, because this tool asks for the same
# records twice — `-k -b N` for the kernel version and `-k -b N -o short-unix`
# for the boot start — and one fixture file has to answer both. The seam
# answers formatting flags by being the text it is, so the text has to be the
# form the arithmetic needs.
hrp() { BT_JOURNAL_FIXTURE=tests/journal/hr-phase BT_SYSFS_USB="$HRSYS/usb" \
        BT_SYSFS_MODULE="$HRSYS/mod" BT_SYSFS_BT="$HRSYS/bt" BT_METRICS=/nonexistent \
        BT_CHANGE_TIME="$1" tools/bt-health-report.sh 2>&1; }
# Boot -1 starts at epoch 1786690800. A change time before that makes the boot
# AFTER the mitigation; one after it makes the boot BEFORE. Both directions,
# because a column that always says the same thing is not a comparison — and
# mislabelling drags a pre-install boot's timeout counts into the after column.
HRV6=$(hrp "@1786600000")
HRV6B=$(hrp "@1786699999")
hr_a=$(awk '$1 == "-1" { print $6 }' <<<"$HRV6"  | head -1)
hr_b=$(awk '$1 == "-1" { print $6 }' <<<"$HRV6B" | head -1)
[[ "$hr_a" == "AFTER" && "$hr_b" == "before" ]] \
    && ok "BT_CHANGE_TIME moves boots across the before/after boundary, both ways" \
    || bad "phase labelling did not follow the change time (got '$hr_a' then '$hr_b')"

HRV7=$(BT_JOURNAL_FIXTURE=tests/journal/health BT_SYSFS_USB="$HRSYS/usb" \
       BT_SYSFS_MODULE="$HRSYS/mod" BT_SYSFS_BT="$HRSYS/bt" BT_METRICS=/nonexistent \
       BT_BASELINE=/nonexistent/baseline.tsv \
       BT_SYNTHETIC_NOTE="3 of these are injected test lines" tools/bt-health-report.sh 2>&1)
[[ "$HRV7" == *"note: 3 of these are injected test lines"* ]] \
    && ok "bt-health-report carries a synthetic-data note into the report" \
    || bad "BT_SYNTHETIC_NOTE did not appear — injected lines would read as real"

# THE BASELINE IS SEARCHED FOR IN FIVE PLACES, and BT_BASELINE is only the
# first — the tool is installed to /usr/local/bin and has to find the file
# without assuming a checkout. So the not-found branch cannot be reached by
# pointing the variable at nothing; it needs the script running somewhere with
# no evidence tree beside it, which is exactly the installed case it exists
# for. Copied rather than symlinked, because $DIR resolves through the copy.
# The lib is copied ALONGSIDE the script rather than pointed at with
# BT_LIBDIR, so this case depends on nothing outside its own temp tree — which
# is also exactly the shape of a real installation: bt-health-report at
# /usr/local/bin with lib/ beside it and no checkout anywhere.
HRNB=$(mktemp -d); mkdir -p "$HRNB/bin"
cp tools/bt-health-report.sh "$HRNB/bin/"
cp -r tools/lib "$HRNB/bin/lib"
mkdir -p "$HRNB/sys/usb" "$HRNB/sys/mod" "$HRNB/sys/bt/hci0"
# The two SYSTEM candidates are pointed at the empty temp tree as well. Without
# that this assertion passed here and FAILED on the investigation machine, which
# has /usr/local/share/qca9377-bt-hang/baseline.tsv installed: the branch was
# never taken, so the message never appeared. A missing-baseline test that only
# works where the baseline was never installed tests the wrong machine.
HRV8=$(BT_JOURNAL_FIXTURE=tests/journal/health BT_SYSFS_USB="$HRNB/sys/usb" \
       BT_SYSFS_MODULE="$HRNB/sys/mod" BT_SYSFS_BT="$HRNB/sys/bt" BT_METRICS=/nonexistent \
       BT_BASELINE=/nonexistent/baseline.tsv \
       BT_SHARE_DIR="$HRNB/none" BT_HEALTH_DIR="$HRNB/none" \
       "$HRNB/bin/bt-health-report.sh" 2>&1)
[[ "$HRV8" == *"baseline not found"* && "$HRV8" == *"BT_BASELINE"* ]] \
    && ok "bt-health-report names the override when no baseline is anywhere" \
    || bad "the missing-baseline branch did not name BT_BASELINE"
rm -rf "$HRNB"

rm -rf "$HRSYS"

# ── bt-postmortem: the conclusion drawn about a hang that already happened ─
#
# Reconstructs an incident from the journal and states what it means. The
# interesting property is that its verdicts are MUTUALLY EXCLUSIVE and chosen
# by counting: recovered-early, never-intervened, recovered, not-recovered.
# Picking the wrong branch would put a false account of an intervention into
# the record — the class of error this repository exists to avoid. Each branch
# is driven from its own fixture rather than asserted from one.
PM=tests/journal/postmortem
PMSYS=$(mktemp -d); mkdir -p "$PMSYS/usb/3-3" "$PMSYS/bt/hci0"
echo 13d3 > "$PMSYS/usb/3-3/idVendor"; echo 3503 > "$PMSYS/usb/3-3/idProduct"
pm() { BT_JOURNAL_FIXTURE="$1" BT_SYSFS_USB="$PMSYS/usb" BT_SYSFS_BT="$PMSYS/bt" \
       tools/bt-postmortem 2>&1; }

PMOUT=$(pm "$PM"); pmrc=$?
(( pmrc == 0 )) && ok "bt-postmortem reconstructs an incident from a fixture" \
                || bad "bt-postmortem failed (rc=$pmrc)"

# The counts drive every verdict below, so they are asserted first.
[[ "$PMOUT" == *"timeouts 3"* && "$PMOUT" == *"interventions 1"* && "$PMOUT" == *"recovered 1"* ]] \
    && ok "bt-postmortem counts timeouts, interventions and recoveries" \
    || bad "incident counts wrong: $(grep -o 'timeouts .*' <<<"$PMOUT" | head -1)"

# The elapsed figure is the one a reader quotes. 08:00:00 first timeout,
# 08:00:45 recovery — the arithmetic must survive the whole pipeline.
[[ "$PMOUT" == *"Recovered"* && "$PMOUT" == *"+45s after the first timeout"* ]] \
    && ok "bt-postmortem times the recovery from the first timeout" \
    || bad "recovery verdict or elapsed time wrong"

# A watchdog that never acted is a DIFFERENT diagnosis from one that acted and
# failed, and the operator's next step differs: check threshold/cooldown,
# rather than conclude that reset does not work.
PMQ=$(mktemp -d); cp "$PM"/kernel.b0.log "$PMQ/"
PMOUT2=$(pm "$PMQ")
[[ "$PMOUT2" == *"watchdog never intervened"* ]] \
    && ok "bt-postmortem distinguishes 'never intervened' from 'intervened and failed'" \
    || bad "silent-watchdog verdict missing"
rm -rf "$PMQ"

# Stage 2 reached: no adapter and off the bus. The remedy must be named.
PMSYS2=$(mktemp -d); mkdir -p "$PMSYS2/usb" "$PMSYS2/bt"
PMOUT3=$(BT_JOURNAL_FIXTURE="$PM" BT_SYSFS_USB="$PMSYS2/usb" BT_SYSFS_BT="$PMSYS2/bt" \
         tools/bt-postmortem 2>&1)
[[ "$PMOUT3" == *"CONTROLLER IS DOWN RIGHT NOW"* && "$PMOUT3" == *"left the bus"* \
   && "$PMOUT3" == *"POWER-OFF"* ]] \
    && ok "bt-postmortem reports stage 2 and its remedy when the device is gone" \
    || bad "stage-2 verdict wrong"

# Enumerated but no adapter is a DIFFERENT state from off-the-bus, and it has a
# different remedy — btusb never bound, so a power cycle is not the answer.
# Same empty /sys/class/bluetooth, device still present on the USB tree.
mkdir -p "$PMSYS2/usb/3-3"
echo 13d3 > "$PMSYS2/usb/3-3/idVendor"; echo 3503 > "$PMSYS2/usb/3-3/idProduct"
PMENUM=$(BT_JOURNAL_FIXTURE="$PM" BT_SYSFS_USB="$PMSYS2/usb" BT_SYSFS_BT="$PMSYS2/bt" \
         tools/bt-postmortem 2>&1)
[[ "$PMENUM" == *"btusb has not created an adapter"* && "$PMENUM" != *"stage 2"* ]] \
    && ok "bt-postmortem distinguishes enumerated-without-adapter from stage 2" \
    || bad "an enumerated controller was reported as having left the bus"
rm -rf "$PMSYS2"

# ── the remaining incident verdicts ──────────────────────────────────────
#
# Four mutually exclusive outcomes and two early-signal readings, each its own
# fixture. The early-signal pair is the load-bearing one: "cmd_timeout is too
# late" rests on there being a warning BEFORE the first timeout, and this tool
# is what says whether there was. It is not always true, and a tool that
# assumed it would confirm the hypothesis it was built to test.
pmf() { BT_JOURNAL_FIXTURE="tests/journal/$1" BT_SYSFS_USB="$PMSYS/usb" \
        BT_SYSFS_BT="$PMSYS/bt" tools/bt-postmortem "${@:2}" 2>&1; }

PMEARLY=$(pmf pm-early)
[[ "$PMEARLY" == *"answered after EARLY intervention"* \
   && "$PMEARLY" == *"Early signal preceded the first timeout by 10s"* ]] \
    && ok "bt-postmortem reports early recovery and the window that allowed it" \
    || bad "the early-intervention incident was misread"

# Stage 1 duration is the window any reset has to fit inside — the number the
# fix proposal is argued from. 60s here: first timeout to first USB failure.
[[ "$PMEARLY" == *"HCI-to-first-USB-event interval"*"60s"* ]] \
    && ok "bt-postmortem measures stage 1 from first timeout to first USB failure" \
    || bad "stage-1 duration wrong or absent"

PMNR=$(pmf pm-notrec)
[[ "$PMNR" == *"NOT recovered."* && "$PMNR" == *"The USB reset itself failed."* ]] \
    && ok "bt-postmortem reports a failed recovery and a failed reset separately" \
    || bad "the unrecovered incident lost one of its two facts"

# THE READING THAT REFUTES THE HYPOTHESIS, and therefore the one that must
# work. The signal arrives 30s AFTER the first timeout: no early-warning
# window existed, so BT_EARLY could not have helped in this incident.
[[ "$PMNR" == *"AFTER the first timeout"* \
   && "$PMNR" == *"could not have helped"* \
   && "$PMNR" != *"early-warning window existed"* ]] \
    && ok "bt-postmortem says when the early signal came too late to help" \
    || bad "a late early-signal was reported as an early-warning window"

# Two clusters an hour apart are two incidents, not one 60-minute incident:
# GAP is what separates them, and merging them would stretch every Δ measured
# from t_first across an hour of healthy operation.
PMTWO=$(pmf pm-two --all)
[[ "$PMTWO" == *"Incidents found: 2"* && "$PMTWO" == *"2 separate incidents"* ]] \
    && ok "bt-postmortem clusters distant timeouts into separate incidents" \
    || bad "two clusters an hour apart were not separated"

PMNONE=$(pmf pm-none); pmnrc=$?
(( pmnrc == 0 )) && [[ "$PMNONE" == *"nothing to analyse"* ]] \
    && ok "bt-postmortem exits 0 with nothing to analyse rather than an empty report" \
    || bad "a range with no timeouts did not report cleanly (rc=$pmnrc)"

# The fixture's lone `link tx timeout` is ACL supervision — a healthy
# controller losing a device that walked out of range. A burst of those would
# fabricate an incident, and one adjacent to a real incident shifts t_first,
# the anchor every delta above is measured from.
[[ "$PMNONE" != *"Incidents found"* ]] \
    && ok "an ACL link timeout does not fabricate an incident" \
    || bad "a link tx timeout was clustered as a controller incident"

tools/bt-postmortem --bogus >/dev/null 2>&1
(( $? == 2 )) && ok "bt-postmortem exits 2 on an unknown option" \
              || bad "bt-postmortem did not refuse an unknown option with 2"

PMHELP=$(tools/bt-postmortem --help 2>&1); pmhrc=$?
(( pmhrc == 0 )) && [[ -n "$PMHELP" ]] \
    && ok "bt-postmortem --help prints usage and exits 0" \
    || bad "--help did not print usage (rc=$pmhrc)"

# -b names the boot explicitly. Worth its own case rather than relying on the
# default: the default and the explicit form take different branches, and the
# fixture answers both selector shapes the way a real journal does.
PMBOOT=$(pmf pm-early -b 0)
[[ "$PMBOOT" == *"answered after EARLY intervention"* ]] \
    && ok "bt-postmortem accepts an explicit -b boot index" \
    || bad "-b 0 changed or suppressed the analysis"

PMSINCE=$(pmf pm-early --since "2026-08-13 00:00:00")
[[ "$PMSINCE" == *"answered after EARLY intervention"* ]] \
    && ok "bt-postmortem accepts --since and still analyses the incident" \
    || bad "--since changed or suppressed the analysis"
rm -rf "$PMSYS"

# ── bt-status: the verdict an operator acts on ────────────────────────────
#
# Its whole output is a judgement about RIGHT NOW, and the failure that matters
# is the one its own comments record: a summary computed from a boot's history
# masking a controller that is dead at this moment. The two verdicts are driven
# from a fake device tree, because the difference between them — "power the
# machine fully off" versus "it is fine" — is what a person does next.
ST=tests/journal/status
STSYS=$(mktemp -d); mkdir -p "$STSYS/usb" "$STSYS/bt"

# Stage 2: nothing on the bus, no adapter.
SOUT=$(BT_JOURNAL_FIXTURE="$ST" BT_SYSFS_USB="$STSYS/usb" BT_SYSFS_BT="$STSYS/bt" \
       tools/bt-status 2>&1); src=$?
(( src == 0 )) && ok "bt-status runs over a fixture and a fake device tree" \
               || bad "bt-status failed (rc=$src)"

# THE SAME VERDICT MUST NOT PRODUCE TWO EXIT CODES. Before this was asserted,
# a down controller exited 1 in full mode and 0 under --brief, because the full
# path had no explicit exit and inherited whatever ran last. A caller writing
# `bt-status && ...` got different behaviour from a DISPLAY flag.
BRC=$(BT_JOURNAL_FIXTURE="$ST" BT_SYSFS_USB="$STSYS/usb" BT_SYSFS_BT="$STSYS/bt" \
      tools/bt-status --brief >/dev/null 2>&1; echo $?)
[[ "$src" == "$BRC" ]] \
    && ok "bt-status exit status is the same in full and --brief mode" \
    || bad "exit differs by display flag: full=$src brief=$BRC"
[[ "$SOUT" == *"CONTROLLER IS DOWN RIGHT NOW"* ]] \
    && ok "bt-status reports a dead controller from present state, not history" \
    || bad "bt-status missed a controller that is down right now"
# Main's rewrite removed the causal "stage 2" claim and split the remedy over
# two lines: the demonstrated recovery is a power-off, and whether a warm
# reboot works is deliberately unresolved rather than known-negative. The
# assertion keeps both halves, because dropping the second would let the tool
# go back to asserting more than has been observed.
[[ "$SOUT" == *"Off the USB bus"* && "$SOUT" == *"full power-off is the demonstrated recovery"* \
   && "$SOUT" == *"warm reboot is unresolved"* ]] \
    && ok "bt-status names the demonstrated remedy and leaves warm reboot unresolved" \
    || bad "bt-status did not name the power-off remedy for an off-bus device"

# Enumerated but no adapter: a DIFFERENT diagnosis, and the operator's next
# step differs with it — btusb never bound, rather than the chip being gone.
mkdir -p "$STSYS/usb/3-3"; echo 13d3 > "$STSYS/usb/3-3/idVendor"; echo 3503 > "$STSYS/usb/3-3/idProduct"
SENUM=$(BT_JOURNAL_FIXTURE="$ST" BT_SYSFS_USB="$STSYS/usb" BT_SYSFS_BT="$STSYS/bt" \
        tools/bt-status 2>&1)
[[ "$SENUM" == *"btusb has created no adapter"* && "$SENUM" != *"full POWER-OFF is required"* ]] \
    && ok "bt-status distinguishes 'enumerated, no adapter' from stage 2" \
    || bad "bt-status gave the stage-2 diagnosis for a device still on the bus"

# Healthy: an adapter exists, so no down-right-now verdict at all.
mkdir -p "$STSYS/bt/hci0"
SOK=$(BT_JOURNAL_FIXTURE="$ST" BT_SYSFS_USB="$STSYS/usb" BT_SYSFS_BT="$STSYS/bt" \
      tools/bt-status 2>&1)
[[ "$SOK" != *"CONTROLLER IS DOWN RIGHT NOW"* ]] \
    && ok "bt-status does not cry down when an adapter is present" \
    || bad "bt-status reported a dead controller while an adapter exists"

# The journal-derived counts must still come from the fixture, not the host.
# Anchored to the LABEL: the first version of this asserted that "2" appeared
# anywhere in the output, which any timestamp, count or version string
# satisfies. It could not have failed if the count had come from the host.
[[ "$SOK" == *"HCI command timeouts"*"2"* || "$SOK" == *"timeouts"*": 2"* ]] \
    && ok "bt-status counts this boot's timeouts from the fixture" \
    || bad "bt-status lost the fixture-derived timeout count"

# ── the five remaining verdicts ──────────────────────────────────────────
#
# With an adapter present, bt-status chooses between five sentences, and they
# are the whole product: a person reads one and decides whether to power the
# machine off, keep testing, or stop trusting the run. Four had never executed.
#
# Each pair (kernel + watchdog + bluetoothd) is a fixture directory, because
# the verdicts differ by which of those three logs carries what — not by a flag.
sv() { BT_JOURNAL_FIXTURE="tests/journal/$1" BT_SYSFS_USB="$STSYS/usb" \
       BT_SYSFS_BT="$STSYS/bt" tools/bt-status --brief 2>&1; }

SVEOK=$(sv status-early-ok)
[[ "$SVEOK" == *"CONTROLLER ANSWERED AFTER EARLY INTERVENTION"* \
   && "$SVEOK" == *"no experiment has occupied"* ]] \
    && ok "bt-status reports early recovery WITH the claim it does not support" \
    || bad "the early-recovery verdict lost its 'NOT implied' qualification"

# That qualification is the assertion, not decoration. "Early recovery works"
# invites the reading that the kernel patch is unnecessary; the tool says in
# the same breath that hci_cmd_timeout() calls hdev->reset at +0 s, a point no
# experiment has occupied. Dropping those four lines would leave a true
# sentence that supports a false conclusion.

SVEF=$(sv status-early-fail)
[[ "$SVEF" == *"did not recover"* && "$SVEF" != *"CONTROLLER ANSWERED AFTER EARLY"* ]] \
    && ok "bt-status separates an early intervention that fired from one that worked" \
    || bad "an intervention that failed was reported as recovery"

SVNI=$(sv status-no-intervention)
[[ "$SVNI" == *"never intervened"* ]] \
    && ok "bt-status reports timeouts the watchdog did not answer" \
    || bad "timeouts with no intervention produced the wrong verdict"

# THE DISTINCTION THIS TOOL EXISTS TO DRAW, and the easiest one to get wrong:
# a boot with no failures means nothing unless the trigger was attempted. Both
# fixtures are failure-free; only one exercised audio.
SVCA=$(sv status-clean-audio)
[[ "$SVCA" == *"real clean run"* ]] \
    && ok "a failure-free boot WITH audio is called a real clean run" \
    || bad "a genuinely clean run was not credited as one"

SVCQ=$(sv status-clean-quiet)
[[ "$SVCQ" == *"proves nothing if the trigger was never attempted"* \
   && "$SVCQ" != *"real clean run"* ]] \
    && ok "a failure-free boot WITHOUT audio is refused as evidence" \
    || bad "an untriggered boot was reported as a clean run — the strongest wrong answer"

# Capture health, both ways. "Is the capture running?" is half of what an
# operator opens this tool to answer, and the directory was hardcoded.
STTR=$(mktemp -d); : > "$STTR/a.btsnoop"; : > "$STTR/b.btsnoop"
printf 'gap 1\ngap 2\ngap 3\n' > "$STTR/gaps.log"
SVTR=$(BT_JOURNAL_FIXTURE="$ST" BT_SYSFS_USB="$STSYS/usb" BT_SYSFS_BT="$STSYS/bt" \
       BT_TRACE_DIR="$STTR" tools/bt-status 2>&1)
[[ "$SVTR" == *"btsnoop files:"*"2"* && "$SVTR" == *"capture gaps logged:"*"3"* ]] \
    && ok "bt-status counts the captures and the logged capture gaps" \
    || bad "capture health did not report 2 files and 3 gaps"
rm -rf "$STTR"

SVNOTR=$(BT_JOURNAL_FIXTURE="$ST" BT_SYSFS_USB="$STSYS/usb" BT_SYSFS_BT="$STSYS/bt" \
         BT_TRACE_DIR=/nonexistent tools/bt-status 2>&1)
[[ "$SVNOTR" == *"no trace directory"* ]] \
    && ok "bt-status says so when there is no capture directory at all" \
    || bad "a missing trace directory produced no statement either way"

# No checkout: the tool must say which variable to set rather than printing an
# empty section, because it is run from anywhere and often from /.
SVNOREPO=$(BT_JOURNAL_FIXTURE="$ST" BT_SYSFS_USB="$STSYS/usb" BT_SYSFS_BT="$STSYS/bt" \
           BT_REPO=/nonexistent/checkout tools/bt-status 2>&1)
[[ "$SVNOREPO" == *"no checkout found"* && "$SVNOREPO" == *"BT_REPO="* ]] \
    && ok "bt-status names the override when it cannot find a checkout" \
    || bad "the no-checkout branch did not name BT_REPO"
rm -rf "$STSYS"

# ── bt-context: the tool that reports what nobody thought to look for ─────
#
# Its whole value is inverted filtering — anchor on a demonstrated failure,
# then SUBTRACT everything already classified, and report the remainder. Two
# ways that goes silently wrong: the subtraction removes too much (the tool
# reports nothing and looks like a clean bill of health), or it removes too
# little (the operator is handed the whole log back). The fixture pins both
# directions: two lines that must survive, one anchor that must be found.
CX=tests/journal/context
CXOUT=$(BT_JOURNAL_FIXTURE="$CX" tools/bt-context 2>&1); cxrc=$?
(( cxrc == 0 )) && ok "bt-context runs over a fixture" || bad "bt-context failed (rc=$cxrc)"

[[ "$CXOUT" == *"first HCI command timeout"* ]] \
    && ok "bt-context anchors on the demonstrated failure" \
    || bad "bt-context found no anchor in a fixture that contains one"

for want in 'qca9377 firmware quirk observed on rail' 'an unexplained neighbour line'; do
    if [[ "$CXOUT" == *"$want"* ]]; then
        ok "bt-context surfaces the unclassified neighbour: ${want:0:32}…"
    else
        bad "bt-context subtracted a line it should have surfaced: $want"
    fi
done

# The complement: a line the project HAS classified must not be handed back as
# unexplained, or the report is just the log again.
[[ "$CXOUT" != *"command 0x0406 tx timeout"* ]] \
    && ok "bt-context subtracts the already-classified timeout line" \
    || bad "bt-context reported a known signal as unexplained"

# ── bt-incident: the sandbox override must actually sandbox ───────────────
#
# THE DEFECT THIS ENCODES. bt-incident resolved its destination as:
#
#     REPO="${BT_EVIDENCE_REPO:-...}"
#     [[ -d "$REPO/evidence" ]] || REPO=/root/exp/qca9377-bt-hang
#
# so an EXPLICIT override pointing at a fresh scratch directory — the only
# kind a test would ever use — was silently discarded, and the collection
# landed in a hardcoded absolute path instead. BT_EVIDENCE_REPO is the exact
# mechanism this file's fourth house rule relies on to keep fabricated
# incidents out of the real evidence tree, the rule written after ten of them
# accumulated there. The override was the sandbox, and it did not hold.
#
# The suite never caught it because it stubs bt-incident away entirely (which
# is correct — a failed trial must not collect during a test run). Stubbing a
# tool protects the suite from it; it does not test it. This runs the real
# one, pointed at a temp directory, and asserts the write landed inside.
INC=$(mktemp -d)
mkdir -p "$INC/repo"
BT_EVIDENCE_REPO="$INC/repo" tools/bt-incident suite-sandbox-check >/dev/null 2>&1
inside=$(find "$INC/repo" -type d -name '*suite-sandbox-check*' 2>/dev/null | wc -l)
(( ${inside:-0} == 1 )) \
    && ok "bt-incident writes inside an explicit BT_EVIDENCE_REPO" \
    || bad "bt-incident did NOT write into its sandbox — the override is being ignored"

# THE SECOND CLAIM — "wrote nowhere else" — restated so it can actually fail.
#
# This asserted `[[ ! -e /root/exp/qca9377-bt-hang ]]`: that a particular
# absolute path does not exist. It is wrong in both directions. On a checkout
# living anywhere else it passes without testing anything, which is how it read
# green here for its whole life. On the machine where the repository IS
# /root/exp/qca9377-bt-hang it can never pass, because the path is the
# repository — so it reported a failure that looked like an escape and was not,
# and its real message was drowned by a check that cannot be satisfied.
#
# The defect it was written for is precise: an explicit BT_EVIDENCE_REPO was
# discarded by `[[ -d "$REPO/evidence" ]] || REPO=<hardcoded>`, so a sandbox
# with no evidence/ subdirectory silently became the hardcoded path. That is
# the property to assert — the override must survive a target that does not
# look like a checkout — and it is checkable on any machine.
INC2=$(mktemp -d)              # deliberately WITHOUT an evidence/ subdirectory
BT_EVIDENCE_REPO="$INC2" tools/bt-incident suite-override-survives >/dev/null 2>&1
inc2=$(find "$INC2" -type d -name '*suite-override-survives*' 2>/dev/null | wc -l)
(( ${inc2:-0} == 1 )) \
    && ok "an explicit BT_EVIDENCE_REPO survives a target with no evidence/ tree" \
    || bad "the override was discarded for a hardcoded fallback — the escape is back"
rm -rf "$INC2"

# And the source-level half, which no single run can show: a fallback must not
# be able to overwrite an override. Matched on the shape that caused it.
FALLBACK=$(grep -rnE '\|\|[[:space:]]*REPO=/' tools bin 2>/dev/null \
           | grep -v 'BT_EVIDENCE_REPO' | grep -vE ':[0-9]+:[[:space:]]*#' || true)
[[ -z "$FALLBACK" ]] \
    && ok "no tool overwrites its repo override with an unconditional fallback" \
    || bad "an override can be discarded by a hardcoded fallback:$FALLBACK"
rm -rf "$INC"

# ── bt-exhibit: the thing that actually gets published ────────────────────
#
# Every other tool here produces output somebody reads. bt-exhibit produces
# FILES THAT SHIP — the exhibits are the factual material of a public kernel
# bug report, and the repository's whole argument is that a maintainer can
# re-run the command shown and get the output shown. 134 lines, 0% executed.
#
# It needs no seam: BT_REPO already parameterises the destination, so the real
# tool runs against a scratch checkout. That is the whole cost of testability
# here — the parameter was already there and nobody had used it.
EXR=$(mktemp -d)
mkdir -p "$EXR/evidence/exhibits" "$EXR/tools"
cp tools/sanitize-logs.sh "$EXR/tools/sanitize-logs.sh"

# Same probe the sanitiser's own gate uses, positive AND negative: mawk 1.3.4
# answers the positive form correctly by accident. An engine that cannot
# express the redaction patterns makes the sanitiser refuse, which makes
# bt-exhibit refuse — correctly — so the expectations below split on it.
ex_awk_ok=1
echo "00:11:22:33:44:55:66:77" | awk '{exit !(match($0, /[0-9a-fA-F]{2}([:_-][0-9a-fA-F]{2}){5,}/) && RLENGTH == 23)}' 2>/dev/null || ex_awk_ok=0
echo "11:22" | awk '{exit (match($0, /[0-9a-fA-F]{2}([:_-][0-9a-fA-F]{2}){5,}/) != 0)}' 2>/dev/null || ex_awk_ok=0

exhibit() { BT_REPO="$EXR" tools/bt-exhibit "$@"; }

if (( ex_awk_ok )); then
    # THE CENTRAL CLAIM, and the reason the tool exists rather than a template:
    # the command shown and the output shown came from one pass. Assert both
    # halves in the same file — a tool that recorded the command but not the
    # output, or the reverse, is the hand-written exhibit this replaced.
    exp=$(exhibit new probe-one --claim "The probe emits its marker." \
                  --why "Because the marker is unique to this run." \
                  --cmd 'echo marker-9d3f-emitted' 2>/dev/null)
    exrc=$?
    (( exrc == 0 )) && [[ -f "$EXR/evidence/exhibits/001-probe-one.md" ]] \
        && ok "bt-exhibit new writes a numbered exhibit" \
        || bad "bt-exhibit new failed (rc=$exrc, path='$exp')"

    exbody=$(cat "$EXR/evidence/exhibits/001-probe-one.md" 2>/dev/null)
    [[ "$exbody" == *'$ echo marker-9d3f-emitted'* && "$exbody" == *'marker-9d3f-emitted'* ]] \
        && ok "bt-exhibit records the command AND its output in one pass" \
        || bad "exhibit is missing the command or the output it produced"

    [[ "$exbody" == *"exit status | \`0\`"* ]] \
        && ok "bt-exhibit records the command's exit status" \
        || bad "exhibit did not record an exit status"

    # THE PUBLISH-SAFETY PROPERTY. A Wi-Fi BSSID in a published exhibit is
    # indexed by geolocation databases and discloses where this machine is.
    # The addresses used below sit in the prefix space repo-scan documents for
    # fixtures, so committing this file does not itself leak.
    #
    # The address is produced by a shell loop rather than written into the
    # command, because the command is published verbatim and an address there
    # is now refused outright — see the assertion after this group.
    exhibit new probe-mac --claim "Association names a BSSID." \
            --cmd 'printf "wlan0: authenticate with de:ad:be:ef:00:%02d\n" 17' >/dev/null 2>&1
    macbody=$(cat "$EXR/evidence/exhibits/002-probe-mac.md" 2>/dev/null)
    # AA:BB:CC:00:00:01 and not AA:BB:CC:00:00:NN — the boilerplate redaction
    # notice contains the NN form, so matching the prefix alone would pass on
    # an exhibit where nothing was actually substituted.
    [[ "$macbody" != *"de:ad:be:ef:00:17"* && "$macbody" == *"AA:BB:CC:00:00:01"* ]] \
        && ok "bt-exhibit sanitises the captured output before writing it" \
        || bad "a MAC/BSSID reached an exhibit unredacted"

    # THE SECOND LEAK CHANNEL, found by the assertion above failing for the
    # wrong reason: the ORIGINAL address survived, in the extraction method.
    # Only the output was ever sanitised, and grepping for a device's D-Bus
    # path is the ordinary way to extract evidence about that device.
    exhibit new probe-cmd-mac --claim "c" \
            --cmd 'journalctl -u bluetooth | grep dev_de_ad_be_ef_00_11' >/dev/null 2>&1
    cmdmacrc=$?
    cmdmac=$(ls "$EXR/evidence/exhibits/"*probe-cmd-mac* 2>/dev/null | wc -l)
    (( cmdmacrc != 0 && ${cmdmac:-0} == 0 )) \
        && ok "bt-exhibit refuses an address in the extraction method" \
        || bad "an address in the command reached an exhibit verbatim (rc=$cmdmacrc)"

    exhibit new probe-claim-mac --claim "The device de:ad:be:ef:00:11 disconnects." \
            --cmd 'echo x' >/dev/null 2>&1
    (( $? != 0 )) && ok "bt-exhibit refuses an address in the claim" \
                  || bad "an address in the claim reached an exhibit verbatim"

    # A redaction the reader is not told about is a doctored exhibit: the
    # command shown no longer reproduces the output shown, which is the one
    # guarantee the format makes.
    [[ "$macbody" == *"Redaction notice"* ]] \
        && ok "bt-exhibit discloses that it redacted" \
        || bad "output was altered with no redaction notice"

    # Numbering must advance, because the bug report cites exhibits by number.
    [[ -f "$EXR/evidence/exhibits/002-probe-mac.md" ]] \
        && ok "bt-exhibit numbers exhibits in sequence" \
        || bad "second exhibit was not numbered 002"

    # A non-zero exit that is not 126/127 is legitimate evidence: grep exits 1
    # when it counts zero matches, and zero matches can be the finding.
    exhibit new probe-empty --claim "No such line exists." \
            --cmd 'echo haystack | grep needle' >/dev/null 2>&1
    emptyrc=$?
    (( emptyrc == 0 )) && [[ -f "$EXR/evidence/exhibits/003-probe-empty.md" ]] \
        && ok "bt-exhibit accepts a command that exits 1 — zero matches is evidence" \
        || bad "bt-exhibit refused a legitimate non-zero exit (rc=$emptyrc)"

    # THE EX-019 DEFECT, pinned. 127/126 mean the command never ran, so it
    # produced no evidence at all. EX-019 shipped with "command not found" as
    # its output and a table transcribed from somewhere else.
    exhibit new probe-absent --claim "This must not become an exhibit." \
            --cmd 'definitely-not-a-real-command-9d3f' >/dev/null 2>&1
    absrc=$?
    absent=$(ls "$EXR/evidence/exhibits/"*probe-absent* 2>/dev/null | wc -l)
    (( absrc != 0 && ${absent:-0} == 0 )) \
        && ok "bt-exhibit refuses a command that did not run, and writes nothing" \
        || bad "a never-ran command became an exhibit (rc=$absrc, files=$absent)"

    # list and index read the exhibits back. index is what the bug report
    # links to, so an exhibit missing from it is an exhibit nobody finds.
    exlist=$(exhibit list 2>/dev/null)
    [[ "$exlist" == *"EX-001"* && "$exlist" == *"The probe emits its marker."* ]] \
        && ok "bt-exhibit list reports each exhibit with its claim" \
        || bad "bt-exhibit list lost an exhibit or its claim"

    exhibit index >/dev/null 2>&1
    exidx=$(cat "$EXR/evidence/exhibits/README.md" 2>/dev/null)
    rows=$(grep -c '^| EX-' <<<"$exidx")
    (( ${rows:-0} == 3 )) \
        && ok "bt-exhibit index lists every exhibit (3 rows)" \
        || bad "index has $rows row(s), expected 3"
else
    # Not a skip. On an engine that cannot express the redaction patterns the
    # correct behaviour is to produce nothing, and that is worth asserting.
    exhibit new probe-one --claim "c" --cmd 'echo hi' >/dev/null 2>&1
    exrc=$?
    (( exrc != 0 )) && [[ ! -f "$EXR/evidence/exhibits/001-probe-one.md" ]] \
        && ok "bt-exhibit writes no exhibit when the sanitiser cannot run" \
        || bad "an unsanitised exhibit was written on an incapable awk"
fi

# THE DEFECT THIS BLOCK FOUND. A missing sanitiser and a failing sanitiser
# both mean "this output was not redacted", but only the failing case refused.
# The missing case printed a warning on stderr and wrote the raw output as a
# published exhibit — and bt-exhibit prints the path on stdout precisely so it
# can be used in a pipeline, where nobody reads stderr. The safest-looking
# failure was the only unsafe one.
EXN=$(mktemp -d); mkdir -p "$EXN/evidence"
BT_REPO="$EXN" tools/bt-exhibit new probe-nosan --claim "c" \
        --cmd 'echo "wlan0: authenticate with de:ad:be:ef:00:11"' >/dev/null 2>&1
nosanrc=$?
nosan=$(ls "$EXN/evidence/exhibits/" 2>/dev/null | wc -l)
(( nosanrc != 0 && ${nosan:-0} == 0 )) \
    && ok "bt-exhibit refuses when the sanitiser is absent, as when it fails" \
    || bad "an unsanitised exhibit was written with no sanitiser present (rc=$nosanrc)"
rm -rf "$EXN"

# Argument handling. A slug is a filename and a citation key; anything outside
# kebab-case makes one or the other unstable.
exhibit new Bad_Slug --claim "c" --cmd 'echo x' >/dev/null 2>&1
(( $? != 0 )) && ok "bt-exhibit rejects a non-kebab-case slug" \
              || bad "bt-exhibit accepted a slug that is not kebab-case"

exhibit new no-claim-here --cmd 'echo x' >/dev/null 2>&1
(( $? != 0 )) && ok "bt-exhibit requires --claim" \
              || bad "bt-exhibit wrote an exhibit with no claim"

exhibit new no-cmd-here --claim "c" >/dev/null 2>&1
(( $? != 0 )) && ok "bt-exhibit requires --cmd" \
              || bad "bt-exhibit wrote an exhibit with no extraction method"

exhibit frobnicate >/dev/null 2>&1
(( $? != 0 )) && ok "bt-exhibit rejects an unknown subcommand" \
              || bad "bt-exhibit accepted an unknown subcommand"

# The real evidence tree must be untouched by any of the above — the same
# rule that bt-incident's sandbox test enforces, asserted for the tool whose
# output is literally the published material.
[[ ! -e evidence/exhibits/001-probe-one.md ]] \
    && ok "bt-exhibit wrote nothing into the real evidence tree" \
    || bad "a test exhibit landed in evidence/exhibits/"
rm -rf "$EXR"

# ── bt-verify-install: the tool whose only failure mode is a false all-clear ─
#
# It answers "is what is RUNNING the same as what is COMMITTED?", and it has
# been wrong twice in exactly the way that matters: a hand-written artefact
# list omitted six tools installed on 2026-08-12, so it printed "running
# system matches the checkout" while not checking a quarter of what was
# installed; and parsing install.sh line-by-line yielded "\" as a destination
# for every backslash-continued call, reporting seven phantom missing files.
# Both were fixed by DERIVING the list from install.sh. Neither fix was tested.
#
# The source side was already parameterised — bt-verify-install takes the
# checkout as an argument, and the destinations come out of that checkout's
# install.sh, so a scratch install.sh puts them under a temp tree. Only the
# udev directory and the mode stamp were hardcoded; both are now BT_* overrides
# (real paths by default), which is what makes the SUCCESS path reachable.
VI=$(mktemp -d)
mkdir -p "$VI/repo/tools" "$VI/dest" "$VI/udev" "$VI/stopped"

for t in alpha beta gamma; do printf '#!/bin/sh\necho %s\n' "$t" > "$VI/repo/tools/$t"; done
# gamma's install_file call is BACKSLASH-CONTINUED, which is the shape that
# produced the phantom-destination bug. install.sh really does wrap its longer
# calls, so a fixture without one tests the easy half.
cat > "$VI/repo/install.sh" <<VIEOF
install_file "\$SRC/tools/alpha" $VI/dest/alpha
install_file "\$SRC/tools/beta" $VI/dest/beta
install_file "\$SRC/tools/gamma" \\
             $VI/dest/gamma
systemctl enable --now bt-hang-watchdog
systemctl enable --now bt-health-snapshot.timer
VIEOF
cp "$VI/repo/tools"/* "$VI/dest/"
for r in 50-bluetooth-no-autosuspend 51-bluetooth-health-snapshot; do
    printf 'ATTR{idVendor}=="13d3", ATTR{idProduct}=="3503"\n' > "$VI/udev/$r.rules"
done
# systemctl is scripted by presence of a file per unit, so each scenario is a
# touch rather than a rewritten stub.
mkdir -p "$VI/stub"
cat > "$VI/stub/systemctl" <<VISTUB
#!/bin/sh
case "\$1" in
  is-active)  if [ -e "$VI/stopped/\$2" ]; then echo inactive; exit 3; fi; echo active ;;
  is-enabled) if [ -e "$VI/stopped/\$2" ]; then echo disabled; exit 1; fi; echo enabled ;;
esac
exit 0
VISTUB
chmod +x "$VI/stub/systemctl"

vi_run() { env PATH="$VI/stub:$PATH" BT_UDEV_DIR="$VI/udev" \
               BT_MODE_STAMP="${1:-/nonexistent}" tools/bt-verify-install "$VI/repo" 2>&1; }

VIOUT=$(vi_run); virc=$?
(( virc == 0 )) && [[ "$VIOUT" == *"running system matches the checkout"* ]] \
    && ok "bt-verify-install reports in sync when everything is" \
    || bad "clean tree did not verify (rc=$virc)"

# THE CONTINUATION BUG, pinned by consequence rather than by output shape: a
# destination parsed as "\" is dropped for not being absolute, so the file is
# never compared and its drift is invisible. Make gamma — the continued one —
# differ, and require that it is reported.
echo 'edited on the machine' >> "$VI/dest/gamma"
VIDRIFT=$(vi_run); vidrc=$?
(( vidrc != 0 )) && [[ "$VIDRIFT" == *"DRIFT: $VI/dest/gamma"* ]] \
    && ok "bt-verify-install compares backslash-continued install_file entries" \
    || bad "drift in a continued entry went unreported (rc=$vidrc) — destinations parsed as '\\'"
cp "$VI/repo/tools/gamma" "$VI/dest/gamma"

rm -f "$VI/dest/beta"
VIMISS=$(vi_run); vimrc=$?
(( vimrc != 0 )) && [[ "$VIMISS" == *"NOT INSTALLED: $VI/dest/beta"* ]] \
    && ok "bt-verify-install reports an artifact that was never installed" \
    || bad "a missing artifact was not reported (rc=$vimrc)"

# A file moved aside by `bt-mode experiment` is deliberately absent, not
# missing. Reporting it as drift tells the reader to run install.sh --apply,
# which reverts the controlled baseline — the two tools would then push the
# machine back and forth, each "fixing" the other.
touch "$VI/dest/beta.disabled"
VIDIS=$(vi_run); vidisrc=$?
(( vidisrc == 0 )) && [[ "$VIDIS" == *"disabled by bt-mode: $VI/dest/beta"* ]] \
    && ok "bt-verify-install distinguishes bt-mode-disabled from not-installed" \
    || bad "a bt-mode-disabled file counted as drift (rc=$vidisrc)"
rm -f "$VI/dest/beta.disabled"; cp "$VI/repo/tools/beta" "$VI/dest/beta"

# Same argument one layer up: in experiment mode the INTERVENING units are
# stopped on purpose. Everything else is passive acquisition and must still be
# running in both modes.
touch "$VI/stopped/bt-hang-watchdog" "$VI/stopped/bt-health-snapshot.timer"
VIEXPOFF=$(vi_run); viexpoffrc=$?
(( viexpoffrc != 0 )) \
    && ok "stopped intervening units are drift when NOT in experiment mode" \
    || bad "stopped units passed with no mode stamp — the exemption is unconditional"

echo experiment > "$VI/mode"
VIEXP=$(vi_run "$VI/mode"); viexprc=$?
(( viexprc == 0 )) && [[ "$VIEXP" == *"stopped by bt-mode experiment"* ]] \
    && ok "bt-verify-install exempts intervening units in experiment mode" \
    || bad "experiment mode still reported drift (rc=$viexprc)"

# And the exemption must not cover everything: bluetooth itself is not an
# intervention, so it stays required in both modes. Without this the previous
# assertion is satisfied by an exemption that swallows the whole Services block.
touch "$VI/stopped/bluetooth"
VIEXP2=$(vi_run "$VI/mode"); viexp2rc=$?
(( viexp2rc != 0 )) \
    && ok "experiment mode does not exempt bluetooth.service" \
    || bad "experiment mode exempted a unit that is not an intervention"
rm -f "$VI/stopped"/*

# THE FALSE ALL-CLEAR, refused. An install.sh it cannot parse means it knows
# nothing about what is installed, and "nothing to check" must never render as
# "everything is fine" — the failure that motivated deriving the list at all.
: > "$VI/repo/install.sh"
VIEMPTY=$(vi_run); viempc=$?
(( viempc != 0 )) && [[ "$VIEMPTY" == *"refusing to report success on an empty artefact list"* ]] \
    && ok "bt-verify-install refuses an unparseable install.sh" \
    || bad "an empty artefact list reported success (rc=$viempc)"

tools/bt-verify-install "$VI/no-such-checkout" >/dev/null 2>&1
(( $? != 0 )) && ok "bt-verify-install rejects a checkout that is not there" \
              || bad "bt-verify-install accepted a nonexistent checkout"
rm -rf "$VI"

# ── verify-restored.sh: the claim nobody re-checks by hand ────────────────
#
# "Yes, the machine is back to normal." Nobody verifies that verdict
# independently, because verifying it by hand is the work this script replaced.
# It had also never been run under test, because it could only run on a machine
# mid-investigation — the definition of the code this effort exists to reach.
#
# Its predecessor list was frozen at the original 11-file install and reported
# "matches its pre-investigation state" while roughly 30 later artifacts — the
# capture stack, dyndbg, the awk libs, the trial machinery — were still on the
# machine. The list is now derived from install.sh; that fix is what these
# assertions hold in place.
VR=$(mktemp -d)
mkdir -p "$VR/repo" "$VR/dest" "$VR/stub" "$VR/mod" "$VR/usb/3-3/power" "$VR/jrn"
{ for i in $(seq 1 12); do
      printf 'install_file "$SRC/tools/t%02d" %s/dest/t%02d\n' "$i" "$VR" "$i"
  done
  echo 'systemctl enable --now bt-hang-watchdog'
} > "$VR/repo/install.sh"

echo Y > "$VR/mod/enable_autosuspend"
echo 13d3 > "$VR/usb/3-3/idVendor"; echo 3503 > "$VR/usb/3-3/idProduct"
echo auto > "$VR/usb/3-3/power/control"
cat > "$VR/stub/systemctl" <<VRSTUB
#!/bin/sh
[ "\$2" = bluetooth ] || { echo inactive; exit 3; }
case "\$1" in is-active) echo active ;; is-enabled) echo enabled ;; esac
exit 0
VRSTUB
printf '#!/bin/sh\nexit 0\n' > "$VR/stub/dpkg"
chmod +x "$VR/stub"/*

vr_run() { env PATH="$VR/stub:$PATH" BT_INSTALL_SH="$VR/repo/install.sh" \
               BT_SYSFS_MODULE="$VR/mod" BT_SYSFS_USB="$VR/usb" \
               BT_HEALTH_DIR="$VR/no-health" BT_JOURNAL_FIXTURE="$VR/jrn" \
               tools/verify-restored.sh 2>&1; }

# The six artifacts the script names literally — the udev rules, the drop-ins
# and the stamps install.sh writes outside install_file — are NOT overridable,
# deliberately: they are the revert contract, and a test that redirects them
# tests nothing. That makes the fully-restored assertion depend on host state,
# so it is gated rather than faked. On the investigation machine itself, with
# the project installed, "restored" is legitimately false.
vr_host_clean=1
for f in /etc/udev/rules.d/50-bluetooth-no-autosuspend.rules \
         /etc/udev/rules.d/51-bluetooth-health-snapshot.rules \
         /etc/systemd/system/bt-hang-watchdog.service.d/10-device.conf \
         /etc/systemd/system/bt-health-snapshot.service.d/10-device.conf \
         /usr/local/share/qca9377-bt-hang/installed-at \
         /usr/local/share/qca9377-bt-hang/mode; do
    [[ -e "$f" || -e "$f.disabled" ]] && vr_host_clean=0
done

if (( vr_host_clean )); then
    VROUT=$(vr_run); vrrc=$?
    (( vrrc == 0 )) && [[ "$VROUT" == *"matches its pre-investigation state"* ]] \
        && ok "verify-restored reports a clean machine restored" \
        || bad "a fully restored tree did not verify (rc=$vrrc)"
else
    ok "verify-restored: clean-machine case skipped (project is installed here)"
fi

# THE FROZEN-LIST DEFECT, in the form the fix takes: the artifacts come out of
# install.sh, so a tool added there is checked without anyone remembering to
# add it here. t07 exists only in the scratch install.sh.
touch "$VR/dest/t07"
VRLEFT=$(vr_run); vrlrc=$?
(( vrlrc != 0 )) && [[ "$VRLEFT" == *"still present: $VR/dest/t07"* ]] \
    && ok "verify-restored derives its artifact list from install.sh" \
    || bad "a leftover named only in install.sh was not reported (rc=$vrlrc)"
rm -f "$VR/dest/t07"

# THE GAP BETWEEN THE TWO TOOLS. `bt-mode experiment` moves files aside to
# <name>.disabled; uninstall.sh removes only the active names. So an
# experiment -> uninstall sequence leaves every disabled file on disk, and a
# restoration check that only tested -e would call that a clean revert.
touch "$VR/dest/t03.disabled"
VRDIS=$(vr_run); vrdisrc=$?
(( vrdisrc != 0 )) && [[ "$VRDIS" == *"moved aside by bt-mode"* ]] \
    && ok "verify-restored catches files uninstall.sh cannot see (.disabled)" \
    || bad "an experiment->uninstall leftover passed as restored (rc=$vrdisrc)"
rm -f "$VR/dest/t03.disabled"

# The mitigation value itself. N is what this project sets; Y is the original.
echo N > "$VR/mod/enable_autosuspend"
VRAS=$(vr_run); vrasrc=$?
(( vrasrc != 0 )) && [[ "$VRAS" == *"still the mitigation value"* ]] \
    && ok "verify-restored reports btusb autosuspend still disabled" \
    || bad "the mitigation value passed as restored (rc=$vrasrc)"
echo Y > "$VR/mod/enable_autosuspend"

# A module that is not loaded is neither restored nor not — it is unknown, and
# the defaults apply at next load. Informational, not a failure, or every
# check on a machine with bluetooth off would read as outstanding work.
rm -f "$VR/mod/enable_autosuspend"
VRNOMOD=$(vr_run)
[[ "$VRNOMOD" == *"btusb not loaded"* ]] \
    && ok "verify-restored treats an unloaded btusb as informational" \
    || bad "unloaded btusb was scored rather than noted"
echo Y > "$VR/mod/enable_autosuspend"

# THE FALSE ALL-CLEAR, refused — the same refusal bt-verify-install makes, for
# the same reason. An install.sh it cannot parse means it does not know what
# was installed, and it must not answer "restored" from an empty list.
: > "$VR/repo/install.sh"
VREMPTY=$(vr_run); vremprc=$?
(( vremprc != 0 )) && [[ "$VREMPTY" == *"refusing a false all-clear"* ]] \
    && ok "verify-restored refuses to report success from a short artifact list" \
    || bad "an underived list reported restoration (rc=$vremprc)"
rm -rf "$VR"

# ── bt-diagnose: the tool a stranger runs before trusting any of this ─────
#
# The standalone entry point. Someone with an unreliable Bluetooth controller
# clones the repo and runs this, and its answer decides whether they go on
# reading. It has three documented exit codes — 0 not present, 1 present,
# 2 cannot determine — and none of the three had ever been executed.
#
# The distinction it draws is the substance of this project's claim: timeouts
# WITHOUT resets is the bug (hdev->reset is NULL because the device is missing
# from btusb's quirks table); timeouts WITH resets is a different problem that
# this repository does not document. Telling a stranger they have this bug when
# they do not is the worst thing this tool can do, so both sides are asserted,
# and each fixture also carries the near-miss the counting must reject.
DG=$(mktemp -d)
mkdir -p "$DG/usb/3-3/3-3:1.0/bluetooth/hci0" "$DG/empty"
echo 13d3 > "$DG/usb/3-3/idVendor"; echo 3503 > "$DG/usb/3-3/idProduct"

dg_run() { BT_JOURNAL_FIXTURE="tests/journal/$1" BT_SYSFS_USB="$DG/usb" \
           tools/bt-diagnose 2>&1; }

DGSIG=$(dg_run diagnose-signature); dgsigrc=$?
(( dgsigrc == 1 )) && [[ "$DGSIG" == *"phenotype observed"* ]] \
    && ok "bt-diagnose reports the timeout phenotype and exits 1" \
    || bad "signature fixture gave rc=$dgsigrc, not the documented 1"

# `link tx timeout` is ACL supervision — a different layer. This machine has
# logged 7 of them against 173 real command timeouts, and counting them would
# inflate the headline number in the direction that flatters the claim. The
# fixture splits 2 timeouts into boot -1 and 1 into boot 0, so a total of 3
# also proves the per-boot totals are summed rather than one boot reported.
[[ "$DGSIG" == *"HCI command timeouts      : 3"* ]] \
    && ok "bt-diagnose sums command timeouts across boots, excluding ACL supervision" \
    || bad "the headline total is wrong — an ACL supervision line was included, or a boot was dropped"

# THE INFERENCE THIS TOOL NO LONGER MAKES, asserted as an absence.
#
# Two assertions here previously required the opposite of what follows: that a
# controller with reset messages in its history be CLEARED ("the kernel IS
# resetting the controller", exit 0), and that zero firmware messages be read
# as driver_info = 0. Upstream removed both as unsound — the kernel lines are
# aggregate, unpaired and not VID:PID-scoped across boots, so they cannot say
# which timeout a reset answered or whether a callback is installed for the
# controller in front of you.
#
# Those two assertions were written in this branch and they encoded the defect.
# Had upstream landed after them, they would have reported a correctness fix as
# a regression. They are replaced by their negation, which is the property
# worth holding: reset messages must NOT suppress the phenotype, and the report
# must not draw a mechanism conclusion from counts that cannot support one.
DGRES=$(dg_run diagnose-reset); dgresrc=$?
(( dgresrc == 1 )) && [[ "$DGRES" == *"phenotype observed"* ]] \
    && ok "reset messages in the history do not suppress the timeout phenotype" \
    || bad "a controller with resets in its history was cleared (rc=$dgresrc)"

[[ "$DGRES" == *"aggregate, unpaired, system-wide counts"* \
   && "$DGRES" != *"driver_info = 0"* && "$DGRES" != *"did nothing about them"* ]] \
    && ok "bt-diagnose draws no callback or firmware-table conclusion from aggregate counts" \
    || bad "aggregate counts were converted into a mechanism verdict"

DGCLEAN=$(dg_run diagnose-clean); dgcleanrc=$?
(( dgcleanrc == 0 )) && [[ "$DGCLEAN" == *"phenotype NOT observed"* ]] \
    && ok "bt-diagnose exits 0 when no command timeout was ever logged" \
    || bad "a clean journal did not exit 0 (rc=$dgcleanrc)"

# ...and zero is an absence of observation, not a clean bill of health. The
# retained journal may simply not go back far enough.
[[ "$DGCLEAN" == *"does not prove"* ]] \
    && ok "a zero count is reported as absence of observation, not health" \
    || bad "the zero-timeout verdict overclaimed health"

# No controller at all. This is the ONE case where "cannot determine" is the
# honest answer, and its exit code must not be confused with health.
DGNONE=$(BT_JOURNAL_FIXTURE=tests/journal/diagnose-signature BT_SYSFS_USB="$DG/empty" \
         tools/bt-diagnose 2>&1); dgnonerc=$?
(( dgnonerc == 2 )) && [[ "$DGNONE" == *"power-off"* ]] \
    && ok "bt-diagnose exits 2 with no controller on the bus, and says power-off" \
    || bad "absent controller gave rc=$dgnonerc, not the documented 2"

# The three codes must be distinct, asserted as ONE claim: a caller branching
# on them is why they are documented, and two verdicts collapsing onto one code
# is invisible in any single-scenario check.
[[ "$dgsigrc$dgcleanrc$dgnonerc" == "102" ]] \
    && ok "bt-diagnose's three exit codes are distinct (1/0/2)" \
    || bad "exit codes collapsed: present=$dgsigrc absent=$dgcleanrc unknown=$dgnonerc"
rm -rf "$DG"

# ── bt-mode: the switch that turns the safety net off ─────────────────────
#
# `bt-mode experiment` stops the recovery watchdog on a machine where a hang
# then needs a physical power-off, moves the power-policy overrides aside, and
# records the mode. `bt-mode mitigation` is supposed to put all of it back. If
# the restore is incomplete, the machine stays in experiment mode while
# everything reports normal — the watchdog is off, nobody is told, and the next
# hang is a cold boot.
#
# It had never been executed under test for the obvious reason: executing it
# means doing that. Now every path is a seam, so the round trip runs inside a
# temp tree — and the last assertion here is that the real ones were untouched,
# because this suite runs as root on the investigation machine.
#
# THE STATE OF THE REAL OVERRIDES, SNAPSHOT BEFORE ANY OF IT RUNS. The check at
# the end of this section compares against this rather than against an absolute
# expectation. The first version asserted the three `.disabled` files did not
# exist, which is FALSE on a machine legitimately in experiment mode — moving
# exactly those files aside is what `bt-mode experiment` is for. It failed on
# the investigation machine for the machine's correct configuration.
#
# Same defect class as the `/root/exp` assertion: coupled to the environment
# rather than to the code, and therefore wrong precisely where it matters. What
# a leak looks like is a CHANGE across this section, in either direction.
real_override_state() {
    local f live dis
    for f in /etc/udev/rules.d/50-bluetooth-no-autosuspend.rules \
             /etc/udev/rules.d/51-bluetooth-health-snapshot.rules \
             /etc/modprobe.d/btusb-qca9377.conf; do
        live=no; dis=no
        [[ -e "$f" ]] && live=yes
        [[ -e "$f.disabled" ]] && dis=yes
        echo "${f##*/} live=$live disabled=$dis"
    done
}
BM_OVERRIDES_BEFORE=$(real_override_state)

BM=$(mktemp -d)
mkdir -p "$BM/udev" "$BM/mod" "$BM/stub" "$BM/usb/3-3/power" "$BM/share"
echo 13d3 > "$BM/usb/3-3/idVendor"; echo 3503 > "$BM/usb/3-3/idProduct"
echo on > "$BM/usb/3-3/power/control"; echo N > "$BM/mod/enable_autosuspend"
printf 'options btusb enable_autosuspend=0\n' > "$BM/modprobe.conf"
printf 'ATTR{idVendor}=="13d3"\n' > "$BM/udev/50-bluetooth-no-autosuspend.rules"
printf 'ATTR{idVendor}=="13d3"\n' > "$BM/udev/51-bluetooth-health-snapshot.rules"
cat > "$BM/stub/systemctl" <<BMSTUB
#!/bin/sh
echo "systemctl \$*" >> "$BM/spy.log"; exit 0
BMSTUB
printf '#!/bin/sh\necho "udevadm $*" >> "%s/spy.log"\nexit 0\n' "$BM" > "$BM/stub/udevadm"
chmod +x "$BM/stub"/*

bm_run() { env PATH="$BM/stub:$PATH" \
    BT_MODPROBE_CONF="$BM/modprobe.conf" BT_UDEV_DIR="$BM/udev" \
    BT_MODE_STAMP="$BM/share/mode" BT_SYSFS_USB="$BM/usb" \
    BT_SYSFS_MODULE="$BM/mod" tools/bt-mode "$@" 2>&1; }

# The dry run first, and specifically that it changes NOTHING — the same
# contract install.sh and uninstall.sh are held to. A dry run that acts is
# worse than no dry run, because it is asked for by someone being careful.
BMDRY=$(bm_run experiment --dry-run); bmdryrc=$?
(( bmdryrc == 0 )) && [[ "$BMDRY" == *"would run: systemctl disable --now bt-hang-watchdog"* ]] \
    && ok "bt-mode --dry-run prints the plan" \
    || bad "bt-mode --dry-run did not describe stopping the watchdog (rc=$bmdryrc)"

[[ -e "$BM/udev/50-bluetooth-no-autosuspend.rules" && ! -e "$BM/share/mode" \
   && ! -s "$BM/spy.log" ]] \
    && ok "bt-mode --dry-run changes nothing and runs nothing" \
    || bad "the dry run moved a file, wrote the stamp, or invoked a tool"

# Now the real switch, inside the sandbox.
BMEXP=$(bm_run experiment); bmexprc=$?
(( bmexprc == 0 )) && ok "bt-mode experiment completes" \
                  || bad "bt-mode experiment failed (rc=$bmexprc)"

# Moved aside, not deleted: the header's promise is that everything is
# reversible, and a deleted udev rule is not.
[[ -e "$BM/udev/50-bluetooth-no-autosuspend.rules.disabled" \
   && -e "$BM/udev/51-bluetooth-health-snapshot.rules.disabled" \
   && -e "$BM/modprobe.conf.disabled" ]] \
    && ok "bt-mode experiment moves the overrides aside rather than deleting them" \
    || bad "an override was deleted or left in place instead of being disabled"

[[ ! -e "$BM/udev/50-bluetooth-no-autosuspend.rules" && ! -e "$BM/modprobe.conf" ]] \
    && ok "bt-mode experiment leaves no active override behind" \
    || bad "an override survived under its active name"

# The watchdog must actually be stopped AND disabled — a stop alone comes back
# at the next boot, in the middle of an experiment nobody would re-check.
[[ "$(cat "$BM/spy.log")" == *"systemctl disable --now bt-hang-watchdog"* ]] \
    && ok "bt-mode experiment disables the watchdog, not only stops it" \
    || bad "the watchdog was not disabled — it returns at the next boot"

[[ "$(cat "$BM/mod/enable_autosuspend")" == "Y" \
   && "$(cat "$BM/usb/3-3/power/control")" == "auto" ]] \
    && ok "bt-mode experiment restores the stock power policy at runtime" \
    || bad "runtime power policy still holds the mitigation values"

[[ "$(cat "$BM/share/mode" 2>/dev/null)" == experiment* ]] \
    && ok "bt-mode records that experiment mode is active" \
    || bad "the mode stamp does not say experiment"

# THE ROUND TRIP, which is the whole reversibility claim. Every file must come
# back under its active name, with nothing left disabled — the .disabled
# leftovers are exactly what verify-restored.sh has to hunt for afterwards
# because uninstall.sh cannot see them.
BMMIT=$(bm_run mitigation); bmmitrc=$?
left=$(ls "$BM/udev"/*.disabled "$BM"/*.disabled 2>/dev/null | wc -l)
(( bmmitrc == 0 && ${left:-0} == 0 )) \
   && [[ -e "$BM/udev/50-bluetooth-no-autosuspend.rules" \
      && -e "$BM/udev/51-bluetooth-health-snapshot.rules" \
      && -e "$BM/modprobe.conf" ]] \
    && ok "bt-mode mitigation restores every file experiment moved aside" \
    || bad "the round trip left $left file(s) disabled (rc=$bmmitrc)"

[[ "$(cat "$BM/mod/enable_autosuspend")" == "N" \
   && "$(cat "$BM/usb/3-3/power/control")" == "on" ]] \
    && ok "bt-mode mitigation re-applies the runtime power policy" \
    || bad "runtime power policy was not returned to the mitigation values"

[[ "$(cat "$BM/spy.log")" == *"systemctl enable --now bt-hang-watchdog"* ]] \
    && ok "bt-mode mitigation brings the watchdog back enabled" \
    || bad "the watchdog was not re-enabled — the machine stays unprotected"

# status is read-only and must survive a machine where nothing is set up: it is
# the command someone runs to find out what state they are in, and it answering
# with an error is the same as not answering.
BMSTAT=$(bm_run status); bmstatrc=$?
(( bmstatrc == 0 )) && [[ "$BMSTAT" == *"recorded mode"*"mitigation"* ]] \
    && ok "bt-mode status reports the recorded mode" \
    || bad "bt-mode status did not report the mode (rc=$bmstatrc)"

bm_run frobnicate >/dev/null 2>&1
(( $? != 0 )) && ok "bt-mode rejects an unknown mode" \
              || bad "bt-mode accepted an unknown mode"

# THE SANDBOX ITSELF. This suite runs as root on the machine under
# investigation, and every assertion above ran bt-mode in APPLY mode. If a seam
# leaked, the watchdog on this host was just disabled and its udev rules moved
# aside — which is the one failure that must never be discovered later.
BM_OVERRIDES_AFTER=$(real_override_state)
BM_OVN=$(grep -c . <<<"$BM_OVERRIDES_AFTER")
if [[ "$BM_OVERRIDES_AFTER" == "$BM_OVERRIDES_BEFORE" ]] && (( ${BM_OVN:-0} == 3 )); then
    ok "bt-mode's seams held — all $BM_OVN real overrides in the state they started in"
elif (( ${BM_OVN:-0} != 3 )); then
    bad "the override state function reported $BM_OVN path(s), not 3 — check is blind"
else
    bad "A SEAM LEAKED: bt-mode changed a real override on this machine:"
    bad "  before: $(tr '\n' ' ' <<<"$BM_OVERRIDES_BEFORE")"
    bad "  after:  $(tr '\n' ' ' <<<"$BM_OVERRIDES_AFTER")"
fi
rm -rf "$BM"

# ── bt-verify-kernel-mechanism: the fact every experiment is read against ─
#
# Whether btusb defines btusb_qca_reset (hci_cmd_timeout() invokes it on the
# FIRST timeout) or btusb_qca_cmd_timeout (the older 5-timeout counter) decides
# how to interpret every recovery experiment here: a userspace reset issued
# +20 s later is a fair proxy for the second and not for the first. The tool
# that settles it against the shipped binary had never been run against a
# binary whose contents a test controls.
#
# BT_MODULES_DIR is the only seam needed — the kernel release is already an
# argument — so a fabricated btusb.ko drives every verdict.
KM=$(mktemp -d)
mkdir -p "$KM/mods/7.0.0-test/kernel/drivers/bluetooth" \
         "$KM/mods/5.0.0-old/kernel/drivers/bluetooth"

# A fake module: the symbol strings the tool greps, plus usb_device_id entries
# in the little-endian byte order it documents (13d3:3491 -> d3 13 91 34).
# 3491/3496/3501 present, 3503 absent — the repository's central claim.
km_id() { printf '\xd3\x13'; printf "\\x${1:2:2}\\x${1:0:2}"; }
{ printf 'btusb_qca_reset\0Resetting usb device\0rampatch\0nvm_usb\0using rampatch file\0'
  km_id 3491; km_id 3496; km_id 3501; km_id 3563
} > "$KM/mods/7.0.0-test/kernel/drivers/bluetooth/btusb.ko"
printf 'btusb_qca_cmd_timeout\0nothing else here\0' \
    > "$KM/mods/5.0.0-old/kernel/drivers/bluetooth/btusb.ko"

km_run() { BT_MODULES_DIR="$KM/mods" tools/bt-verify-kernel-mechanism "$1" 2>&1; }

KMNEW=$(km_run 7.0.0-test); kmrc=$?
(( kmrc == 0 )) && [[ "$KMNEW" == *"=> hdev->reset mechanism."* ]] \
    && ok "bt-verify-kernel-mechanism identifies the hdev->reset path" \
    || bad "reset-callback module was not identified (rc=$kmrc)"

# The sentence that stops a wrong experiment being believed.
[[ "$KMNEW" == *"NOT an equivalent test"* ]] \
    && ok "it says a delayed userspace reset is not an equivalent test" \
    || bad "the hdev->reset verdict omitted the proxy warning"

KMOLD=$(km_run 5.0.0-old)
[[ "$KMOLD" == *"hdev->cmd_timeout mechanism"* && "$KMOLD" != *"hdev->reset mechanism."* ]] \
    && ok "bt-verify-kernel-mechanism identifies the older 5-timeout counter" \
    || bad "cmd_timeout module was misread"

# THE CLAIM ITSELF: the comparators are in the ID table and this device is not.
# Asserted as one pair, because "3503 absent" is only evidence of a gap if the
# neighbours are present — a tool that found nothing at all would satisfy half
# of it and mean the opposite.
[[ "$KMNEW" == *"13d3:3491  present"* && "$KMNEW" == *"13d3:3501  present"* \
   && "$KMNEW" == *"13d3:3503  ABSENT"* ]] \
    && ok "device IDs are read from the binary: comparators present, 3503 absent" \
    || bad "the ID table read is wrong — the isolated-gap argument does not hold"

# THE DEFECT THIS FOUND. hexdump(1) is in bsdextrautils, absent from minimal
# images — the same package as the column(1) gap in bt-health-report, with a
# worse consequence. The redirect was silenced, so with no hexdump the hex file
# never appeared, every grep missed, and ALL SEVEN IDs printed ABSENT,
# including the three that are genuinely there. That reads as "the comparators
# are missing too", the exact opposite of what the section argues.
KMNOHEX=$(mktemp -d); mkdir -p "$KMNOHEX/bin"
for t in od hexdump; do printf '#!/bin/sh\nexit 127\n' > "$KMNOHEX/bin/$t"; done
chmod +x "$KMNOHEX/bin"/*
KMBLIND=$(env PATH="$KMNOHEX/bin:$PATH" BT_MODULES_DIR="$KM/mods" \
              tools/bt-verify-kernel-mechanism 7.0.0-test 2>&1)
[[ "$KMBLIND" == *"13d3:3491  UNKNOWN"* && "$KMBLIND" != *"13d3:3491  ABSENT"* ]] \
    && ok "an unreadable binary reports UNKNOWN, never ABSENT" \
    || bad "a failed hex dump was reported as the device IDs being absent"
rm -rf "$KMNOHEX"

tools/bt-verify-kernel-mechanism 9.9.9-nonexistent >/dev/null 2>&1
(( $? == 2 )) && ok "bt-verify-kernel-mechanism exits 2 when the module is not there" \
              || bad "a missing btusb module did not exit 2"
rm -rf "$KM"

# ── bt-state: the row every later comparison is computed from ─────────────
#
# `bt-state --tsv` is what bt-health-snapshot appends to metrics.tsv, so these
# nine fields ARE the measurement series — the before/after tables, the
# baseline comparison, the trial treatments all read them back. A field in the
# wrong column silently reassigns every value after it, and nothing downstream
# can notice: the file has no header per row and every field is a bare string.
BS=$(mktemp -d)
mkdir -p "$BS/usb/3-3/power" "$BS/usb/3-3/3-3:1.0/bluetooth/hci0" "$BS/mod" "$BS/stub" "$BS/jrn"
echo 13d3 > "$BS/usb/3-3/idVendor"; echo 3503 > "$BS/usb/3-3/idProduct"
echo on > "$BS/usb/3-3/power/control"; echo N > "$BS/mod/enable_autosuspend"
cat > "$BS/jrn/kernel.b0.log" <<'BSJ'
2026-08-10T09:10:00.000000+02:00 host kernel: Bluetooth: hci0: command 0x0406 tx timeout
2026-08-10T09:10:10.000000+02:00 host kernel: Bluetooth: hci0: command 0x0428 tx timeout
2026-08-10T09:11:00.000000+02:00 host kernel: Bluetooth: hci0: link tx timeout
BSJ
printf 'Aug 10 09:12:00 host bt-hang-watchdog: intervening now\n' \
    > "$BS/jrn/unit-bt-hang-watchdog.b0.log"
# hciconfig is an INTERVENTION, not an observation — a raw HCI exchange that
# has aborted a live btmon capture (EX-011). Stubbing it is not only for speed.
printf '#!/bin/sh\nexit 0\n' > "$BS/stub/hciconfig"
printf '#!/bin/sh\necho "Device AA:BB:CC:00:00:01 Phone"\n' > "$BS/stub/bluetoothctl"
chmod +x "$BS/stub"/*

bs_run() { env PATH="$BS/stub:$PATH" BT_SYSFS_USB="$BS/usb" BT_SYSFS_MODULE="$BS/mod" \
               BT_JOURNAL_FIXTURE="$BS/jrn" tools/bt-state "$@" 2>&1; }

BSTSV=$(bs_run --tsv); bstsvrc=$?
# Field by field, by POSITION. Grepping for the values would pass on a row
# whose columns had been reordered, which is the failure that cannot be seen
# downstream: metrics.tsv rows carry no per-row header.
IFS=$'\t' read -r f_ts f_dev f_ctrl f_hci f_alive f_as f_tx f_wd f_conn <<<"$BSTSV"
(( bstsvrc == 0 )) && [[ "$f_dev" == "3-3" && "$f_ctrl" == "on" && "$f_hci" == "hci0" \
                      && "$f_alive" == "yes" && "$f_as" == "N" ]] \
    && ok "bt-state --tsv puts device/power/hci/liveness in their documented columns" \
    || bad "TSV columns wrong: dev=$f_dev ctrl=$f_ctrl hci=$f_hci alive=$f_alive as=$f_as"

# 2, not 3: the fixture's `link tx timeout` is ACL supervision, a different
# layer. Inflating this column inflates every before/after table built on it.
[[ "$f_tx" == "2" && "$f_wd" == "1" && "$f_conn" == "1" ]] \
    && ok "bt-state --tsv counts timeouts, interventions and connections correctly" \
    || bad "counts wrong: tx=$f_tx wd=$f_wd conn=$f_conn (want 2 1 1)"

n_fields=$(awk -F'\t' '{print NF}' <<<"$BSTSV")
(( ${n_fields:-0} == 9 )) \
    && ok "bt-state --tsv emits exactly 9 fields on one line" \
    || bad "TSV row has $n_fields field(s), not 9 — every column after the gap shifts"

# A controller that has dropped off the bus is the advanced form of the hang,
# and it is a row metrics.tsv must still be able to carry: absent, not crashed.
BSGONE=$(env PATH="$BS/stub:$PATH" BT_SYSFS_USB="$BS/empty" BT_SYSFS_MODULE="$BS/mod" \
             BT_JOURNAL_FIXTURE="$BS/jrn" tools/bt-state --tsv 2>&1); bsgrc=$?
(( bsgrc == 0 )) && [[ "$(awk -F'\t' '{print $2}' <<<"$BSGONE")" == "absent" ]] \
    && ok "bt-state records an absent controller as a row, not a failure" \
    || bad "a vanished controller broke the sampler (rc=$bsgrc)"

BSHUM=$(bs_run)
[[ "$BSHUM" == *"device 13d3:3503"* && "$BSHUM" == *"responds"* && "$BSHUM" == *"services"* ]] \
    && ok "bt-state's human form reports the device, liveness and services" \
    || bad "the human-readable form is missing a section"
# btmgmt is the fallback when hciconfig is absent, and it is the one that runs
# on a modern bluez where hciconfig has been removed. A liveness column that
# silently reads "?" on those machines makes every row of metrics.tsv useless
# for the question the column exists to answer.
BSMG=$(mktemp -d); mkdir -p "$BSMG/bin"
printf '#!/bin/sh\nexit 0\n'   > "$BSMG/bin/btmgmt"
printf '#!/bin/sh\nexit 0\n'   > "$BSMG/bin/bluetoothctl"
chmod +x "$BSMG/bin"/*
# btmgmt and bluetoothctl only — no hciconfig anywhere on PATH. A stub that
# EXISTS is still found by `command -v`, so the directory holding the stubs
# must simply not contain one; the branch under test is the one taken when
# hciconfig is not there at all.
mkdir -p "$BSMG/bin2"; cp "$BSMG/bin/btmgmt" "$BSMG/bin/bluetoothctl" "$BSMG/bin2/"
# /usr/bin MUST NOT be on the PATH here, and leaving it there is not a detail.
#
# hciconfig lives in /usr/bin on any machine with bluez installed — which is
# every machine this project runs on. With /usr/bin on the PATH the branch under
# test was never reached: bt-state found the REAL hciconfig and probed the REAL
# controller, so the assertion reported whatever that controller happened to be
# doing. On the investigation machine, mid-failure, that is `no`.
#
# A symlink farm of /usr/bin minus hciconfig keeps every other tool bt-state
# needs while making the one under test genuinely absent. Found by running this
# suite on a host where bluez is installed; it passes on a bare checkout.
#
# AND /bin MUST GO TOO. On Ubuntu /bin is a symlink to usr/bin, so /bin/hciconfig
# is the same file by another name — removing /usr/bin from the PATH while
# leaving /bin closes one door and leaves the other open. The farm carries
# everything /bin would have supplied, because it IS /usr/bin.
ln -s /usr/bin/* "$BSMG/bin2/" 2>/dev/null || true
rm -f "$BSMG/bin2/hciconfig"
BSMGOUT=$(env PATH="$BSMG/bin2" \
              BT_SYSFS_USB="$BS/usb" BT_SYSFS_MODULE="$BS/mod" \
              BT_JOURNAL_FIXTURE="$BS/jrn" tools/bt-state --tsv 2>&1)
[[ "$(awk -F'\t' '{print $5}' <<<"$BSMGOUT")" == "yes" ]] \
    && ok "bt-state falls back to btmgmt where hciconfig has been removed" \
    || bad "liveness was not probed without hciconfig: $(awk -F'\t' '{print $5}' <<<"$BSMGOUT")"
rm -rf "$BSMG"
rm -rf "$BS"

# ── the help and refusal paths, together ─────────────────────────────────
#
# Every tool here has a --help and an unknown-argument refusal, and almost none
# of them had ever been executed. They are worth a block rather than a shrug:
# --help is the only documentation a tool carries onto an installed machine,
# where the repository is not present, and a `sed -n '2,26p' "$0"` range that
# has drifted past the header prints the wrong thing silently.
help_ok() {   # <tool> [expected-substring]
    local out rc
    out=$("$1" --help 2>&1); rc=$?
    if (( rc == 0 )) && [[ -n "$out" ]] && { [[ -z "${2:-}" ]] || [[ "$out" == *"$2"* ]]; }; then
        ok "$(basename "$1") --help prints its own usage"
    else
        bad "$(basename "$1") --help failed (rc=$rc) or lost '${2:-}'"
    fi
}
help_ok tools/bt-phase   "bt-phase"
help_ok tools/bt-sco     "bt-sco"
help_ok tools/bt-actions "bt-actions"
help_ok tools/bt-mode    "bt-mode"

# bt-actions' time selectors are passed through to the journal, so they must at
# minimum not break the run — and the fixture answers whatever is asked.
AASINCE=$(BT_JOURNAL_FIXTURE=tests/journal/actions tools/bt-actions -b 0 \
          --since "2026-08-13 00:00:00" --until "2026-08-14 00:00:00" 2>&1); aasrc=$?
(( aasrc == 0 )) && [[ "$AASINCE" == *"USER"* ]] \
    && ok "bt-actions accepts --since and --until and still classifies" \
    || bad "the time selectors broke the run (rc=$aasrc)"

# bt-phase's incident gap is the parameter that decides what counts as ONE
# incident — the same clustering question bt-postmortem answers with GAP — so
# it is a number worth being able to set.
PHGAP=$(BT_JOURNAL_FIXTURE=tests/journal/phase tools/bt-phase --incident-gap 300 2>&1); phgrc=$?
(( phgrc == 0 )) && ok "bt-phase accepts --incident-gap" \
                 || bad "--incident-gap broke bt-phase (rc=$phgrc)"

# THE REFUSAL bt-interval keeps as distinct from an unparseable timestamp: awk
# succeeded but returned something that is not a number, which would mean the
# library changed shape under it. Driven with a stub library, because that is
# the only way the branch can be reached without breaking the real one.
IVLIB=$(mktemp -d)
cp tools/lib/timestamp.awk "$IVLIB/"
printf 'BEGIN { print "not-a-number"; exit 0 }\n' > "$IVLIB/interval.awk"
IVOUT=$(BT_LIBDIR="$IVLIB" tools/bt-interval "2026-08-13T10:00:00+02:00" \
                                             "2026-08-13T10:01:00+02:00" 2>&1); ivrc=$?
(( ivrc != 0 )) && [[ "$IVOUT" == *"non-numeric result"* && "$IVOUT" == *"a="* ]] \
    && ok "bt-interval refuses a non-numeric result and names both arguments" \
    || bad "the non-numeric branch did not fire (rc=$ivrc): $IVOUT"
rm -rf "$IVLIB"

# bt-verify-kernel-mechanism's two remaining verdicts. Both are real states of
# a shipped module — a kernel carrying both symbols, and one stripped of
# both — and each demands a different next step from the reader.
KMB=$(mktemp -d); mkdir -p "$KMB/mods/both/kernel/drivers/bluetooth" \
                           "$KMB/mods/none/kernel/drivers/bluetooth"
printf 'btusb_qca_reset\0btusb_qca_cmd_timeout\0' \
    > "$KMB/mods/both/kernel/drivers/bluetooth/btusb.ko"
printf 'nothing useful here\0' > "$KMB/mods/none/kernel/drivers/bluetooth/btusb.ko"
: > "$KMB/mods/both/kernel/drivers/bluetooth/btqca.ko"
KMBOTH=$(BT_MODULES_DIR="$KMB/mods" tools/bt-verify-kernel-mechanism both 2>&1)
[[ "$KMBOTH" == *"both symbols present"* && "$KMBOTH" == *"btqca.ko present"* ]] \
    && ok "bt-verify-kernel-mechanism reports a module carrying both symbols" \
    || bad "the both-symbols verdict did not fire"
KMNONE=$(BT_MODULES_DIR="$KMB/mods" tools/bt-verify-kernel-mechanism none 2>&1)
[[ "$KMNONE" == *"neither symbol found"* && "$KMNONE" == *"stripped"* ]] \
    && ok "bt-verify-kernel-mechanism says a stripped module proves nothing" \
    || bad "the neither-symbol verdict did not fire"
rm -rf "$KMB"

# bt-boot-provenance must refuse rather than tabulate nothing: an empty boot
# table reads as "no boots to worry about", which is the opposite of "I could
# not find out".
BPEMPTY=$(mktemp -d)
BT_JOURNAL_FIXTURE="$BPEMPTY" BT_BOOT_LIST=/nonexistent tools/bt-boot-provenance >/dev/null 2>&1
(( $? != 0 )) && ok "bt-boot-provenance refuses when it cannot list boots" \
              || bad "an unlistable journal produced a boot table anyway"
rm -rf "$BPEMPTY"

# ── bt-health-snapshot: the writer of the series, against its own header ──
#
# metrics.tsv survives reboots and is the record bt-health-report reads back to
# answer whether the mitigation works. The header is written ONCE, on the first
# run, and rows are appended forever after — so a row that stops matching the
# header corrupts every reading from that point on, and the file itself cannot
# show it: fields are bare strings and only the first line names them.
HS=$(mktemp -d)
mkdir -p "$HS/usb/3-3/power" "$HS/usb/3-3/3-3:1.0/bluetooth/hci0" \
         "$HS/usb/2-1/2-1:1.0/bluetooth/hci1" "$HS/mod" "$HS/stub" "$HS/jrn"
echo 13d3 > "$HS/usb/3-3/idVendor"; echo 3503 > "$HS/usb/3-3/idProduct"
echo on   > "$HS/usb/3-3/power/control"; echo N > "$HS/mod/enable_autosuspend"
# A spare dongle: different device, its own hci node, ahead of ours in sort
# order. The column it exists to falsify is hci_alive.
echo 0a12 > "$HS/usb/2-1/idVendor"; echo 0001 > "$HS/usb/2-1/idProduct"
cat > "$HS/jrn/kernel.b0.log" <<'HSJ'
2026-08-10T09:10:00.000000+02:00 host kernel: Bluetooth: hci0: command 0x0406 tx timeout
2026-08-10T09:10:10.000000+02:00 host kernel: Bluetooth: hci0: command 0x0428 tx timeout
2026-08-10T09:10:11.000000+02:00 host kernel: Bluetooth: hci0: unexpected event for opcode 0x0c1a
2026-08-10T09:11:00.000000+02:00 host kernel: Bluetooth: hci0: link tx timeout
HSJ
cat > "$HS/jrn/unit-bt-hang-watchdog.b0.log" <<'HSW'
Aug 10 09:12:00 host bt-hang-watchdog: 3 timeouts in 60s — intervening.
Aug 10 09:12:30 host bt-hang-watchdog: EARLY intervention: desync signature
Aug 10 09:12:40 host bt-hang-watchdog: RECOVERED after usb reset
HSW
printf '#!/bin/sh\nexit 0\n' > "$HS/stub/hciconfig"
printf '#!/bin/sh\necho "Device AA:BB:CC:00:00:01 Phone"\n' > "$HS/stub/bluetoothctl"
chmod +x "$HS/stub"/*

hs_run() { env PATH="$HS/stub:$PATH" BT_METRICS="$HS/metrics.tsv" \
    BT_SYSFS_USB="${1:-$HS/usb}" BT_SYSFS_MODULE="$HS/mod" \
    BT_JOURNAL_FIXTURE="$HS/jrn" bin/bt-health-snapshot 2>&1; }

hs_run >/dev/null; hsrc=$?
(( hsrc == 0 )) && [[ -s "$HS/metrics.tsv" ]] \
    && ok "bt-health-snapshot writes a metrics file" \
    || bad "bt-health-snapshot produced nothing (rc=$hsrc)"

# THE INVARIANT THE FILE FORMAT RESTS ON. The header is written once and never
# again; the row is written every run. If the two ever disagree on width, every
# reader silently reassigns columns from that row onward, and re-reading the
# file cannot reveal it — only the first line carries names.
hs_hdr=$(awk -F'\t' 'NR==1 {print NF}' "$HS/metrics.tsv")
hs_row=$(awk -F'\t' 'NR==2 {print NF}' "$HS/metrics.tsv")
[[ "$hs_hdr" == "14" && "$hs_row" == "14" ]] \
    && ok "bt-health-snapshot's row width matches its header (14 columns)" \
    || bad "header has $hs_hdr columns, the row has $hs_row — the series is misaligned"

# AND no field may be empty, which the width check alone cannot see. Dropping
# an ARGUMENT from the printf while leaving its %s in the format string still
# produces 14 fields — the last one empty — so the width assertion passed a
# mutation that silently blanked a column. It was proven blind by feeding it
# exactly that, which is the failure mode this suite keeps rediscovering: a
# check that cannot fail for the reason its name gives. Unknown values are
# written as "-" or 0 by design, so an empty field is always a defect.
hs_blank=$(awk -F'\t' 'NR==2 { for (i=1;i<=NF;i++) if ($i == "") { print i; exit } }' \
           "$HS/metrics.tsv")
[[ -z "$hs_blank" ]] \
    && ok "no column in the row is blank (unknowns are '-' or 0, never empty)" \
    || bad "column $hs_blank is empty — a printf argument is missing, not its %s"

# Second run appends only. A re-written header mid-file would be read back as a
# data row of literal column names.
hs_run >/dev/null
lines=$(wc -l < "$HS/metrics.tsv"); heads=$(grep -c '^timestamp' "$HS/metrics.tsv")
(( ${lines:-0} == 3 && ${heads:-0} == 1 )) \
    && ok "bt-health-snapshot appends rows and writes the header only once" \
    || bad "metrics.tsv has $lines line(s) and $heads header(s) after two runs"

# Columns by NAME, resolved from the header rather than hardcoded, so this
# assertion survives a deliberate column addition and fails a reordering.
hs_col() { awk -F'\t' -v want="$1" \
    'NR==1 { for (i=1;i<=NF;i++) if ($i==want) c=i } NR==2 && c { print $c }' "$HS/metrics.tsv"; }
[[ "$(hs_col tx_timeouts)" == "2" && "$(hs_col unexpected_evt)" == "1" ]] \
    && ok "bt-health-snapshot counts command timeouts, excluding ACL supervision" \
    || bad "tx=$(hs_col tx_timeouts) unexpected=$(hs_col unexpected_evt), want 2 and 1"

# THE DOCUMENTED UNDERCOUNT. The watchdog logs a threshold intervention as
# "— intervening." and an early one as "EARLY intervention:". Matching only the
# first missed every early one, in the column whose entire purpose is to say
# how often the watchdog acted. The fixture carries one of each; 2 is the only
# answer that means the fix is still there.
[[ "$(hs_col wd_interventions)" == "2" && "$(hs_col wd_recovered)" == "1" ]] \
    && ok "bt-health-snapshot counts both intervention forms" \
    || bad "wd_interventions=$(hs_col wd_interventions), want 2 — EARLY was missed again"

[[ "$(hs_col dev_present)" == "1" && "$(hs_col hci_alive)" == "1" \
   && "$(hs_col usb_power_ctrl)" == "on" && "$(hs_col btusb_autosusp)" == "N" ]] \
    && ok "bt-health-snapshot records presence, liveness and power state" \
    || bad "device columns wrong: present=$(hs_col dev_present) alive=$(hs_col hci_alive)"

# THE SPARE-DONGLE FALSIFICATION, by name. The hci node must be resolved from
# OUR device's USB path. Taking the first adapter in the tree would report the
# spare dongle's hci1 as alive in exactly the situation this column exists to
# measure: our controller gone, something else still answering.
rm -rf "$HS/usb/3-3"
: > "$HS/metrics.tsv"; hs_run >/dev/null
[[ "$(hs_col dev_present)" == "0" && "$(hs_col hci_alive)" == "0" ]] \
    && ok "a spare dongle's adapter is not reported as our controller's liveness" \
    || bad "hci_alive=$(hs_col hci_alive) with our device absent — it read another adapter"
rm -rf "$HS"

# ── bt-mark and bt-evidence: producing the transcript, end to end ─────────
#
# A reproduction session is what a kernel maintainer reads instead of taking a
# claim on trust: what was run, what the machine did, in what order. Every
# stage of producing one — the before/after snapshots, the command recorder,
# the log filtering, the manifest counters, the sanitiser pass — had never
# executed. 135 lines across the two, at 0%.
EV=$(mktemp -d)
mkdir -p "$EV/repo/evidence/sessions" "$EV/repo/tools" "$EV/state" "$EV/usb/3-3/power" \
         "$EV/usb/3-3/3-3:1.0/bluetooth/hci0" "$EV/mod" "$EV/stub" "$EV/jrn" "$EV/trace"
cp tools/sanitize-logs.sh "$EV/repo/tools/sanitize-logs.sh"
echo 13d3 > "$EV/usb/3-3/idVendor"; echo 3503 > "$EV/usb/3-3/idProduct"
echo on > "$EV/usb/3-3/power/control"; echo N > "$EV/mod/enable_autosuspend"
cat > "$EV/jrn/kernel.log" <<'EVJ'
Aug 10 09:10:00 host kernel: Bluetooth: hci0: command 0x0406 tx timeout
Aug 10 09:10:10 host kernel: Bluetooth: hci0: command 0x0428 tx timeout
Aug 10 09:11:00 host kernel: Bluetooth: hci0: link tx timeout
EVJ
cp "$EV/jrn/kernel.log" "$EV/jrn/kernel.b0.log"
cat > "$EV/jrn/unit-bt-hang-watchdog.log" <<'EVW'
Aug 10 09:12:00 host bt-hang-watchdog: 3 timeouts in 60s — intervening.
Aug 10 09:12:30 host bt-hang-watchdog: EARLY intervention: desync signature
EVW
cp "$EV/jrn/unit-bt-hang-watchdog.log" "$EV/jrn/unit-bt-hang-watchdog.b0.log"
printf '#!/bin/sh\nexit 0\n' > "$EV/stub/hciconfig"
printf '#!/bin/sh\nexit 0\n' > "$EV/stub/bluetoothctl"
printf '#!/bin/sh\nexit 0\n' > "$EV/stub/logger"
printf '#!/bin/sh\nexit 0\n' > "$EV/stub/systemctl"
printf '#!/bin/sh\necho "up 1 hour"\n' > "$EV/stub/uptime"
chmod +x "$EV/stub"/*

ev_env=(PATH="$EV/stub:$PATH" BT_EVIDENCE_REPO="$EV/repo" BT_EVIDENCE_STATE="$EV/state"
        BT_SYSFS_USB="$EV/usb" BT_SYSFS_MODULE="$EV/mod" BT_JOURNAL_FIXTURE="$EV/jrn"
        BT_TRACE_DIR="$EV/trace")
ev() { env "${ev_env[@]}" bin/bt-evidence "$@" 2>&1; }

# bt-mark first: it is what stamps a manual step into the journal so the step
# and the machine's reaction share one timeline.
MK=$(env PATH="$EV/stub:$PATH" BT_SYSFS_USB="$EV/usb" bin/bt-mark "connecting headset" 2>&1); mkrc=$?
(( mkrc == 0 )) && [[ "$MK" == *"marked: connecting headset"* && "$MK" == *"usb=3-3"* \
                   && "$MK" == *"hci=hci0"* ]] \
    && ok "bt-mark stamps the step together with the state at that moment" \
    || bad "bt-mark did not report the mark with its context (rc=$mkrc)"

bin/bt-mark >/dev/null 2>&1
(( $? != 0 )) && ok "bt-mark refuses an empty message" \
              || bad "bt-mark accepted a mark with no text"

# Refusals before anything is open. Recording into no session would write to a
# path derived from an absent state file.
ev note "orphan" >/dev/null 2>&1
(( $? != 0 )) && ok "bt-evidence note refuses with no session open" \
              || bad "a note was recorded outside a session"
ev stop >/dev/null 2>&1
(( $? != 0 )) && ok "bt-evidence stop refuses with no session open" \
              || bad "stop succeeded with nothing open"

EVSTART=$(ev start probe-session); evsrc=$?
evdir=$(sed -n 's/^dir=//p' "$EV/state/current" 2>/dev/null)
(( evsrc == 0 )) && [[ -n "$evdir" && -s "$evdir/state-before.txt" && -f "$evdir/NOTES.md" ]] \
    && ok "bt-evidence start opens a session with a before-snapshot and notes stub" \
    || bad "session did not open properly (rc=$evsrc, dir='$evdir')"

# A second start must not silently begin a session that overwrites the first
# one's state pointer — the transcript of the open session would be orphaned.
ev start second-session >/dev/null 2>&1
(( $? != 0 )) && ok "bt-evidence refuses to open a second session over an open one" \
              || bad "a second session was opened, orphaning the first"

# THE RECORDER'S CENTRAL PROPERTY, the same one bt-exhibit makes: the command
# and its output are written in one pass, so they cannot drift. And the exit
# status recorded must be the COMMAND's, not the sed(1) it is piped through —
# PIPESTATUS[0] is doing real work here, and "$?" would record 0 for every
# failure the session was opened to capture.
ev cmd sh -c 'echo hello-from-evidence; exit 3' >/dev/null 2>&1
evlog=$(cat "$evdir/commands.log")
[[ "$evlog" == *'$ sh -c echo hello-from-evidence; exit 3'* && "$evlog" == *"hello-from-evidence"* ]] \
    && ok "bt-evidence cmd records the command and its output in one pass" \
    || bad "commands.log is missing the command or its output"
[[ "$evlog" == *"[exit 3]"* ]] \
    && ok "bt-evidence records a failing command's exit status" \
    || bad "a failing command was recorded with the wrong exit status"

# AND that the status is the COMMAND's rather than the pipeline's. The
# recorder is `"$@" 2>&1 | sed …`, so PIPESTATUS[0] is doing real work — but
# under `set -o pipefail` a plain "$?" gives the same answer for a failing
# command, so replacing it passes the assertion above unchanged. It was proven
# indistinguishable by making exactly that substitution.
#
# The two diverge only when the SED fails and the command did not, which is
# what this drives: a sed that copies its input and exits 1. "$?" would then
# record a failure for a command that succeeded, in a transcript whose purpose
# is to show what the machine actually did.
mkdir -p "$EV/sedstub"
printf '#!/bin/sh\ncat\nexit 1\n' > "$EV/sedstub/sed"; chmod +x "$EV/sedstub/sed"
env "${ev_env[@]}" PATH="$EV/sedstub:$EV/stub:$PATH" \
    bin/bt-evidence cmd sh -c 'echo fine' >/dev/null 2>&1
[[ "$(cat "$evdir/commands.log")" == *"[exit 0]"* ]] \
    && ok "the recorded status is the command's, not a failing pipeline stage's" \
    || bad "a successful command was recorded as failed because sed did"

ev note "headset powered off" >/dev/null 2>&1
[[ "$(cat "$evdir/commands.log")" == *"NOTE: headset powered off"* ]] \
    && ok "bt-evidence note lands in the transcript" \
    || bad "the note was not written to commands.log"

# A MAC in recorded output must not survive into a session that gets committed.
# This is the same geolocation exposure as everywhere else, on the path that
# produces the largest volume of published text.
ev cmd sh -c 'printf "assoc de:ad:be:ef:00:%02d\n" 23' >/dev/null 2>&1

EVSTOP=$(ev stop); evstoprc=$?
(( evstoprc == 0 )) && [[ ! -e "$EV/state/current" && -s "$evdir/MANIFEST.txt" \
                       && -s "$evdir/state-after.txt" ]] \
    && ok "bt-evidence stop closes the session and writes a manifest" \
    || bad "stop left the session open or wrote no manifest (rc=$evstoprc)"

evman=$(cat "$evdir/MANIFEST.txt")
# 2, not 3: the fixture's `link tx timeout` is ACL supervision. And 2 for the
# watchdog, because the Phase-22 defect — matching only "intervening" and so
# missing every EARLY intervention — survived into this manifest path too.
[[ "$evman" == *"tx_timeouts_in_window=2"* && "$evman" == *"wd_interventions=2"* ]] \
    && ok "the manifest counts timeouts and both intervention forms correctly" \
    || bad "manifest counters wrong: $(grep -E 'tx_timeouts|wd_interv' <<<"$evman" | tr '\n' ' ')"

[[ "$evman" == *"sanitised=yes"* ]] \
    && ok "the manifest declares whether the session was sanitised" \
    || bad "the manifest does not record the sanitiser state"

# Only assert the redaction where the sanitiser can actually run; on an engine
# that cannot express the patterns it refuses, and the manifest says NO.
if (( ex_awk_ok )); then
    [[ "$(cat "$evdir/commands.log")" != *"de:ad:be:ef:00:23"* ]] \
        && ok "bt-evidence sanitises the transcript before the session is closed" \
        || bad "a MAC survived into a committed session transcript"
fi

# THE HOUSE RULE, asserted rather than assumed: nothing above may reach the
# real evidence tree. Ten fabricated collections accumulated there once, which
# is why the rule exists.
#
# Counted with find, NOT `[[ ! -e evidence/sessions/*probe-session* ]]`, which
# is what this check said first. `[[ -e ]]` does not expand globs — it tests a
# path containing literal asterisks, which never exists, so the assertion
# passed unconditionally and could not have failed had a session escaped. It
# was caught by asking what would make it go red, which is the question every
# check in this file has to survive.
evstray=$(find evidence/sessions -maxdepth 1 -name '*probe-session*' 2>/dev/null | wc -l)
(( ${evstray:-0} == 0 )) \
    && ok "no test session landed in the real evidence tree" \
    || bad "$evstray test session(s) were written into evidence/sessions/"
rm -rf "$EV"

# ── bt-dyndbg: which debug sites are on IS a measurement decision ─────────
#
# The failure under investigation is timing-sensitive — the controller stops
# answering within tens of seconds — so logging that adds work to the receive
# path moves the window being measured, and every measurement taken with it on
# becomes incomparable to the baseline taken without.
#
# The selection has been wrong twice. First at file granularity: excluding
# hci_event.c and l2cap_core.c was not enough, because hci_core.c also holds
# the transmit scheduler and btusb.c the URB completion handlers — 1,561,719
# kernel lines in 16 minutes, which would have exhausted the 16 GB journal cap
# in under three hours and rotated away the evidence the logging exists to
# preserve. Then again for four functions that do not look per-packet from
# their names (hci_rx_work, hci_send_frame, hci_conn_enter_active_mode,
# hci_conn_idle) and produced 98% of one boot's output.
#
# Both fixes are lists in the script, and nothing checked either of them.
DD=$(mktemp -d)
# A control file shaped like debugfs: source:line, function, flags.
cat > "$DD/control" <<'DDC'
drivers/bluetooth/btusb.c:1042 [btusb]btusb_setup_qca =_ "setup\012"
drivers/bluetooth/btusb.c:2210 [btusb]btusb_bulk_complete =p "complete\012"
net/bluetooth/hci_core.c:0812 [bluetooth]hci_cmd_timeout =p "timeout\012"
net/bluetooth/hci_core.c:1533 [bluetooth]hci_tx_work =_ "tx\012"
net/bluetooth/hci_sync.c:0300 [bluetooth]hci_cmd_sync =_ "sync\012"
net/bluetooth/hci_event.c:4001 [bluetooth]hci_event_packet =_ "evt\012"
DDC
dd_run() { BT_DYNDBG_CTL="$DD/control" bin/bt-dyndbg "$@" 2>&1; }

DDON=$(dd_run on); ddrc=$?
(( ddrc == 0 )) && [[ "$DDON" == *"enabled debug in 4 file(s)"* ]] \
    && ok "bt-dyndbg on enables exactly the four command-level files" \
    || bad "default set was not four files (rc=$ddrc)"

# The per-packet files must NOT be in the default set — that is the whole
# argument of the header, and enabling them changes what is measured.
ddcmds=$(grep -E '^(file|func) ' "$DD/control")
[[ "$ddcmds" != *"file hci_event.c +p"* && "$ddcmds" != *"file l2cap_core.c +p"* ]] \
    && ok "bt-dyndbg on leaves the per-packet files off by default" \
    || bad "hci_event.c or l2cap_core.c was enabled without --packets"

# THE SECOND FIX, by name. These four produced 189,274 of 193,506 lines in one
# boot and none of them reads as per-packet from the function name, which is
# exactly why the list has to be asserted rather than reviewed.
ddmissing=""
for fn in hci_rx_work hci_send_frame hci_conn_enter_active_mode hci_conn_idle \
          hci_tx_work btusb_bulk_complete btusb_intr_complete; do
    [[ "$ddcmds" == *"func $fn -p"* ]] || ddmissing="$ddmissing $fn"
done
[[ -z "$ddmissing" ]] \
    && ok "bt-dyndbg suppresses every measured-hot function by name" \
    || bad "these hot sites were left enabled:$ddmissing"

# ORDER MATTERS, and it is stated as a comment in the source: files are enabled
# first, then the per-packet functions inside them are switched back off. The
# reverse order re-enables every one of them, which is a silent return to the
# 5.8 GB/h flood. Compared by line number in the command stream.
dd_first_func=$(grep -n '^func ' "$DD/control" | head -1 | cut -d: -f1)
dd_last_file=$(grep -n '^file .* +p$' "$DD/control" | tail -1 | cut -d: -f1)
(( ${dd_first_func:-0} > ${dd_last_file:-0} )) \
    && ok "file enables precede function suppressions — the order that holds" \
    || bad "a function was suppressed before a file enable re-enabled it"

# --packets is the opt-in, and it must say what it costs.
: > "$DD/control"; cat >> "$DD/control" <<'DDC2'
net/bluetooth/hci_event.c:4001 [bluetooth]hci_event_packet =_ "evt\012"
DDC2
DDPKT=$(dd_run on --packets)
[[ "$DDPKT" == *"enabled debug in 6 file(s)"* && "$DDPKT" == *"perturb the timing"* ]] \
    && ok "bt-dyndbg on --packets adds the per-packet files and warns why" \
    || bad "--packets did not enable six files or omitted the timing warning"

[[ "$(grep -c '^func ' "$DD/control")" == "0" ]] \
    && ok "--packets does not then suppress the functions it was asked for" \
    || bad "--packets enabled the per-packet files and immediately muted them"

: > "$DD/control"
DDOFF=$(dd_run off)
[[ "$DDOFF" == *"disabled debug in 12 file(s)"* \
   && "$(grep -c ' -p$' "$DD/control")" == "12" ]] \
    && ok "bt-dyndbg off disables all twelve files, not only the four it enables" \
    || bad "off did not cover every file that on could have touched"

# count_enabled matches on the SOURCE PATH, not a file-name alternation: an
# alternation like (btusb|hci_)\.c matches only the branches that are complete
# file names and undercounts the rest. The seeded control file has 2 sites with
# a flag other than "=_".
cat > "$DD/control" <<'DDC3'
drivers/bluetooth/btusb.c:2210 [btusb]btusb_bulk_complete =p "complete\012"
net/bluetooth/hci_core.c:0812 [bluetooth]hci_cmd_timeout =pfl "timeout\012"
net/bluetooth/hci_sync.c:0300 [bluetooth]hci_cmd_sync =_ "sync\012"
DDC3
DDSTAT=$(dd_run status)
[[ "$DDSTAT" == *"enabled sites: 2"* ]] \
    && ok "bt-dyndbg status counts enabled sites by source path" \
    || bad "site count wrong: $(head -1 <<<"$DDSTAT")"
rm -rf "$DD"

# ── bt-sco: the parameters of the links that killed the controller ───────
#
# Both instrumented hangs happened during SCO link transitions, and SCO setup
# is NOT sufficient to cause one — a later session issued three and survived.
# So the question became "what was different about the ones that killed it?",
# and this is the tool that answers it. The kernel log shows `opcode 0x0428
# plen 17` and none of the payload; btmon decodes the payload.
#
# THE SEAM IS btmon ITSELF, on PATH. btmon reads btsnoop, which is binary, and
# binary captures are not committed — they carry addresses, names, pairing
# exchanges and payload, and sanitize-logs.sh cannot parse binary, so repo-scan
# refuses them. What is under test is the PARSING, and the parsing consumes
# text. See tests/btmon/README.md for what that does and does not pin.
SC=$(mktemp -d); mkdir -p "$SC/stub" "$SC/trace"
: > "$SC/trace/session.btsnoop"
# The stub ignores its arguments and prints the file named by BTMON_FIXTURE.
# btmon's real invocation here is `btmon -T -r <file>`; a stub that parsed the
# arguments would be asserting the call shape, which is not what these tests
# are about, and would break silently when a flag is added.
cat > "$SC/stub/btmon" <<'SCSTUB'
#!/bin/sh
cat "$BTMON_FIXTURE"
SCSTUB
chmod +x "$SC/stub/btmon"
sco_run() { env PATH="$SC/stub:$PATH" BTMON_FIXTURE="tests/btmon/$1.txt" \
                tools/bt-sco --dir "$SC/trace" "${@:2}" 2>&1; }

SCOUT=$(sco_run sco-paired); scorc=$?
(( scorc == 0 )) && [[ "$SCOUT" == *"setup requests      2"* \
                    && "$SCOUT" == *"completion events   2"* ]] \
    && ok "bt-sco counts synchronous setups and their completions" \
    || bad "paired capture miscounted (rc=$scorc)"

# The parameters are the entire point — a controller that wedges on one
# parameterisation and not another looks random from the kernel log alone.
[[ "$SCOUT" == *"REQUEST"* && "$SCOUT" == *"Voice setting: 0x0060"* \
   && "$SCOUT" == *"COMPLETION"* && "$SCOUT" == *"Link type: eSCO"* ]] \
    && ok "bt-sco prints each request's parameters and its completion block" \
    || bad "a request or completion block lost its indented parameters"

# THE SIGNATURE OF THE HANG: a setup with no completion. This is the one
# reading the tool exists to surface, and the count has to be exact — the
# warning is phrased as "N request(s) received no completion event".
SCGONE=$(sco_run sco-unanswered)
[[ "$SCGONE" == *"setup requests      2"* && "$SCGONE" == *"completion events   1"* \
   && "$SCGONE" == *"1 request(s) received no completion event"* ]] \
    && ok "bt-sco reports an unanswered setup — the hang signature" \
    || bad "the unanswered synchronous setup was not surfaced"

# ...and it must not claim one when the counts match, or every ordinary
# capture grows a warning that means nothing.
[[ "$SCOUT" != *"received no completion event"* ]] \
    && ok "bt-sco does not warn when every setup was answered" \
    || bad "a fully paired capture produced the missing-completion warning"

# THE STARTUP BITMAP. A bare grep for "Setup Synchronous Connection" also
# matches the supported-commands bitmap the controller reports at startup,
# which names the command once per adapter and has nothing to do with any
# request. Counting it manufactures setups on a capture containing none.
SCBIT=$(sco_run sco-bitmap-only)
[[ "$SCBIT" == *"setup requests      0"* ]] \
    && ok "bt-sco does not count the startup supported-commands bitmap" \
    || bad "the commands bitmap was counted as a synchronous setup"

# --window is the mode the header says to use, because a parameter almost never
# varies alone and comparing fields finds a difference whether or not one
# matters. It selects by TIME, so the assertion is that a record 3.7 minutes
# from the nearest setup is excluded at +/-2s and included at a wide window.
# The excluded record has to be one that is NOT itself a setup — a setup always
# sits inside its own window. The fixture carries a Number of Completed Packets
# event at 09:20:00, 5.6 minutes from the nearer of the two marks.
SCW=$(sco_run sco-unanswered --window 2)
[[ "$SCW" == *"09:14:22.101234"* && "$SCW" == *"09:31:44.002000"* \
   && "$SCW" != *"Number of Completed Packets"* ]] \
    && ok "bt-sco --window keeps both setups and drops what is far from either" \
    || bad "the +/-2s window did not bound what it printed"
SCW2=$(sco_run sco-unanswered --window 3600)
[[ "$SCW2" == *"Number of Completed Packets"* ]] \
    && ok "a wider window admits the record a narrow one excluded" \
    || bad "widening the window changed nothing — the bound is not time-based"

SCRAW=$(sco_run sco-paired --raw)
[[ "$SCRAW" == *"Setup Synchronous Connection"* && "$SCRAW" == *"Max latency"* ]] \
    && ok "bt-sco --raw passes btmon's blocks through unfiltered" \
    || bad "--raw dropped the block content it exists to preserve"

env PATH="$SC/stub:$PATH" BTMON_FIXTURE=/dev/null tools/bt-sco --dir "$SC/nope" >/dev/null 2>&1
(( $? != 0 )) && ok "bt-sco refuses a capture directory that is not there" \
              || bad "bt-sco accepted a missing capture directory"

SCEMPTY=$(env PATH="$SC/stub:$PATH" BTMON_FIXTURE=/dev/null \
              tools/bt-sco --dir "$SC/stub" 2>&1); scemprc=$?
(( scemprc == 0 )) && [[ "$SCEMPTY" == *"no .btsnoop files"* ]] \
    && ok "bt-sco reports an empty capture directory instead of an empty table" \
    || bad "a directory with no captures was not reported (rc=$scemprc)"

tools/bt-sco --bogus >/dev/null 2>&1
(( $? != 0 )) && ok "bt-sco rejects an unknown argument" \
              || bad "bt-sco accepted an unknown argument"
rm -rf "$SC"

# ── bt-capdiff: the tool that says whether either capture path lost traffic ─
#
# Two acquisition paths record the same kernel monitor socket. This compares
# them, and its verdict — "the paths agree across the overlap" — is what makes
# a chronology drawn from either one corroborated rather than merely recorded.
# The awk matcher has fixtures; the shell around it (extraction, the overlap
# bound, the verdict) had none, and both defects below live there.
CD=$(mktemp -d); mkdir -p "$CD/stub" "$CD/trace" "$CD/cap"
cat > "$CD/stub/btmon" <<'CDSTUB'
#!/bin/sh
while [ $# -gt 0 ]; do case "$1" in -r) f="$2"; shift 2 ;; *) shift ;; esac; done
cat "$f.txt" 2>/dev/null
CDSTUB
chmod +x "$CD/stub/btmon"
: > "$CD/trace/x.btsnoop"; : > "$CD/cap/x.btsnoop"
cd_run() { cp "tests/btmon/$1.txt" "$CD/trace/x.btsnoop.txt"
           cp "tests/btmon/$2.txt" "$CD/cap/x.btsnoop.txt"
           env PATH="$CD/stub:$PATH" BT_TRACE_DIR="$CD/trace" BT_CAPTURE_DIR="$CD/cap" \
               tools/bt-capdiff "${@:3}" 2>&1; }

# FINDING 1 — the overlap bound manufactured its own disagreement. lo and hi
# came from RAW first/last timestamps on two clocks that differ by a variable
# scheduling delay, which is the delay the matcher exists to absorb. A pair
# straddling a boundary had one member inside the window and one outside, and
# the one inside was reported unmatched. That happened at BOTH edges of every
# comparison, so two perfectly agreeing captures could not report agreement
# unless their boundary records aligned exactly.
#
# The fixtures are that shape on purpose: every A record has a B counterpart
# within tolerance, and the first and last pairs straddle the raw bound.
CDOK=$(cd_run capdiff-a capdiff-b); cdrc=$?
(( cdrc == 0 )) && [[ "$CDOK" == *"The paths agree across the overlap"* ]] \
    && ok "bt-capdiff reports agreement when every record has a counterpart" \
    || bad "agreeing captures did not report agreement (rc=$cdrc)"

[[ "$CDOK" == *"only in btmon        0"* && "$CDOK" == *"only in decode-free  0"* ]] \
    && ok "no record is stranded by the overlap bound at either edge" \
    || bad "boundary records were reported unmatched — the bound is not widened by the tolerance"

# THE FALSE-AGREEMENT SHAPE the matcher's one-to-one pairing exists to catch:
# A holds the same descriptor twice, B holds it once. Asking "is there ANY
# record within tolerance on the other side?" answers yes both ways and prints
# "the paths agree" while the real multiplicity is 2 against 1.
CDDUP=$(cd_run capdiff-dup-a capdiff-dup-b)
[[ "$CDDUP" == *"only in btmon        1"* && "$CDDUP" != *"The paths agree"* ]] \
    && ok "bt-capdiff pairs one-to-one — 2 against 1 is not agreement" \
    || bad "a 2-against-1 multiplicity was reported as agreement"

# FINDING 2 — "Unmatched records in both directions" was printed
# unconditionally, including when every unmatched record was on one side. That
# is the reading that matters: one-sided means a path missed traffic the other
# caught, where two-sided is usually the clock or the decoding.
[[ "$CDDUP" == *"in btmon only"* && "$CDDUP" != *"in both directions"* ]] \
    && ok "bt-capdiff names which path is missing records" \
    || bad "one-sided loss was described as a disagreement in both directions"

# Monitor bookkeeping is delivered to each reader AS IT ATTACHES, so a path
# that attached 74 times legitimately holds 74 copies while one that attached
# once holds one. Comparing them measures how often btmon crashed. The two
# fixtures carry deliberately different bookkeeping; it must not show up.
[[ "$CDOK" != *"New Index"* && "$CDOK" != *"Index Info"* ]] \
    && ok "per-attach bookkeeping is excluded from the comparison" \
    || bad "monitor session records were compared as controller traffic"

# One path empty is a coverage question, not a disagreement — and saying so is
# the difference between "we did not look" and "we looked and they differ".
: > "$CD/cap/x.btsnoop.txt"
CDNONE=$(env PATH="$CD/stub:$PATH" BT_TRACE_DIR="$CD/trace" BT_CAPTURE_DIR="$CD/cap" \
             tools/bt-capdiff 2>&1); cdnrc=$?
(( cdnrc == 0 )) && [[ "$CDNONE" == *"coverage"* && "$CDNONE" != *"paths agree"* ]] \
    && ok "bt-capdiff calls an empty path a coverage question, not agreement" \
    || bad "an empty capture path was folded into the verdict (rc=$cdnrc)"

tools/bt-capdiff --bogus >/dev/null 2>&1
(( $? != 0 )) && ok "bt-capdiff rejects an unknown argument" \
              || bad "bt-capdiff accepted an unknown argument"
rm -rf "$CD"

# ── bt-trace / bt-usbmon: the two capture daemons, via --check ────────────
#
# Both run in the foreground under systemd and never return, so nothing here
# could ever run them. Both were given `--check`: verify the prerequisites,
# report the resolved configuration, run the retention pass once, exit.
#
# That is an operator command before it is a test seam. "The capture is not
# running and I do not know why" is answered by btmon's absence, a missing
# debugfs mount, or a filesystem already under the floor — and each of those is
# a silent exit or an IDLE LOOP inside a unit whose journal says only
# "starting". install.sh, uninstall.sh and now bt-mode all have a dry run and
# the suite calls it their contract; these two had none.
#
# What it reaches is the retention logic, and that is where both scripts carry
# recorded defects: bt-trace's retention count once "pruned away the pairing
# sequence of a session that was being actively investigated", and bt-usbmon's
# free-space loop had to learn not to delete the file being written, because
# tcpdump holds the unlinked inode open and the space is never reclaimed — so
# the loop would eat every OTHER file while freeing nothing.
CP=$(mktemp -d); mkdir -p "$CP/trace" "$CP/usb" "$CP/stub" "$CP/dbg" "$CP/dev/3-3"
printf '#!/bin/sh\nexit 0\n' > "$CP/stub/btmon"
printf '#!/bin/sh\nexit 0\n' > "$CP/stub/tcpdump"
printf '#!/bin/sh\nexit 0\n' > "$CP/stub/modprobe"
chmod +x "$CP/stub"/*
echo 13d3 > "$CP/dev/3-3/idVendor"; echo 3503 > "$CP/dev/3-3/idProduct"
echo 3 > "$CP/dev/3-3/busnum"
: > "$CP/dbg/3u"
for i in 1 2 3 4 5; do
    : > "$CP/trace/bt-2026081$i-000000.btsnoop"
    : > "$CP/usb/usbmon-2026081$i-000000.pcap"
done

TRCHK=$(env PATH="$CP/stub:$PATH" BT_TRACE_DIR="$CP/trace" BT_TRACE_KEEP=3 \
            bin/bt-trace --check 2>&1); trrc=$?
trleft=$(ls -1 "$CP/trace"/bt-*.btsnoop 2>/dev/null | wc -l)
(( trrc == 0 && ${trleft:-0} == 3 )) && [[ "$TRCHK" == *"captures held  5"* ]] \
    && ok "bt-trace --check reports its configuration and prunes to KEEP" \
    || bad "bt-trace --check left $trleft file(s) of 5 with KEEP=3 (rc=$trrc)"

# It must not capture. A --check that starts btmon is not a check, and on the
# investigation machine it would add a second reader to the monitor socket.
[[ "$TRCHK" != *"capturing to"* && "$(ls -1 "$CP/trace"/bt-*.btsnoop | wc -l)" == "3" ]] \
    && ok "bt-trace --check starts no capture and creates no file" \
    || bad "--check began a capture"

# btmon absent is the most common reason the unit is silently dead, and it is
# the one thing --check exists to say out loud.
TRNOBT=$(env PATH="$CP/dbg:/nonexistent" BT_TRACE_DIR="$CP/trace" \
             bin/bt-trace --check 2>&1); trnrc=$?
(( trnrc != 0 )) && [[ "$TRNOBT" == *"btmon not found"* ]] \
    && ok "bt-trace --check names btmon's absence instead of exiting silently" \
    || bad "a missing btmon did not produce a stated failure (rc=$trnrc)"

bin/bt-trace --bogus >/dev/null 2>&1
(( $? != 0 )) && ok "bt-trace rejects an unknown argument" \
              || bad "bt-trace accepted an unknown argument"

USCHK=$(env PATH="$CP/stub:$PATH" BT_USBMON_DIR="$CP/usb" BT_USBMON_KEEP=2 \
            BT_SYSFS_USB="$CP/dev" BT_USBMON_DEBUGFS="$CP/dbg" \
            bin/bt-usbmon --check 2>&1); usrc=$?
usleft=$(ls -1 "$CP/usb"/usbmon-*.pcap 2>/dev/null | wc -l)
(( usrc == 0 && ${usleft:-0} == 2 )) && [[ "$USCHK" == *"interface      usbmon3"* ]] \
    && ok "bt-usbmon --check resolves the controller's bus and prunes to KEEP" \
    || bad "bt-usbmon --check left $usleft file(s) of 5 with KEEP=2 (rc=$usrc)"

# usbmon instances are per-bus, so resolving the WRONG bus captures a bus the
# controller is not on — a capture that looks healthy and contains nothing.
[[ "$USCHK" == *"bus 3"* ]] \
    && ok "bt-usbmon --check names the bus it resolved" \
    || bad "the resolved bus is not reported — a wrong one would look identical"

# Device absent with no configured bus is the state this investigation cares
# about, and in service mode it deliberately IDLES rather than exiting, so
# --check must answer instead of hanging. Bounded by timeout: if the guard is
# ever removed, this hangs the suite, and a hang is the failure to catch.
USGONE=$(timeout 20 env PATH="$CP/stub:$PATH" BT_USBMON_DIR="$CP/usb" \
             BT_SYSFS_USB="$CP/empty" BT_USBMON_DEBUGFS="$CP/dbg" \
             bin/bt-usbmon --check 2>&1); usgrc=$?
(( usgrc == 0 )) && [[ "$USGONE" == *"not present"* ]] \
    && ok "bt-usbmon --check returns when the controller is absent, not idles" \
    || bad "--check hung or failed on an absent controller (rc=$usgrc)"

bin/bt-usbmon --bogus >/dev/null 2>&1
(( $? != 0 )) && ok "bt-usbmon rejects an unknown argument" \
              || bad "bt-usbmon accepted an unknown argument"
rm -rf "$CP"

# ── the seam itself ───────────────────────────────────────────────────────
#
# A converted tool must not quietly regain a direct journalctl call: the seam is
# only worth anything if it is the ONLY way in. Derived from the tools that
# source journal.sh, so the list cannot drift out of date — the failure mode
# this repository has hit four times with hand-written lists.
#
# SCOPED TO tools/ AND bin/, which is where the shipped diagnostics live and the
# only place the seam is a rule. The first version scanned every shell file and
# immediately flagged reviews/verify.sh — a script that GREPS FOR the seam in
# order to report on its adoption. It matched `source "$LIBDIR/journal.sh"`
# inside a grep pattern, was classified as converted, and was then failed for
# containing the word journalctl in the counting greps beside it.
#
# That is the detector being fooled by its own subject matter, which is the
# hazard this file already names elsewhere: "using `head | grep -q` here would
# make the detector vulnerable to the very defect it detects." A tool that
# measures the seam is not a tool that must use it.
CONVERTED=()
for f in "${SHFILES[@]}"; do
    case "$f" in tools/*|bin/*) ;; *) continue ;; esac
    n=$(grep -c 'source "\$LIBDIR/journal.sh"' "$f" 2>/dev/null)
    (( ${n:-0} > 0 )) && CONVERTED+=("$f")
done
if (( ${#CONVERTED[@]} > 0 )); then
    ok "the journal seam is in use by ${#CONVERTED[@]} tool(s)"
    # SEAM-ADVICE marks a line that PRINTS the word for an operator and never
    # runs it. Deliberately a visible marker rather than a clever pattern: a
    # rule that tried to recognise "inside a quoted echo" would be a hole a
    # real call could hide in. Same convention as PIPEFAIL-DEMO above.
    RAW=$(grep -nE '(^|[^_[:alnum:]])journalctl ' "${CONVERTED[@]}" 2>/dev/null \
          | grep -v 'SEAM-ADVICE' \
          | grep -v '^[^:]*:[0-9]*:[[:space:]]*#' \
          | grep -v 'journalctl "\$@"')
    if [[ -z "$RAW" ]]; then
        ok "no converted tool calls journalctl directly"
    else
        bad "a converted tool bypassed bt_journal — it is untestable again:"
        while IFS= read -r l; do echo "        $l"; done <<<"$RAW"
    fi
else
    bad "no tool sources journal.sh — the seam is not wired up"
fi

rm -rf "$EMPTYLIB" "$EMPTYDUMP"

echo
echo "install.sh and uninstall.sh — the dry run is the contract"
echo "──────────────────────────────────────────────────────────────"
#
# The two largest untested files in the repository (255 + 144 lines), and the
# cheapest to test: both default to a dry run in which run() echoes instead of
# executing and the root check sits inside the APPLY branch. A dry run that
# writes anything, or exits non-zero on a healthy tree, is a broken contract —
# and it is the contract the README tells every new user to rely on first.
#
# The write check is a stamp-file comparison over every tree the installer
# touches, not a reading of run()'s code. run() being correct today does not
# bind the next edit; a stray `mkdir -p` outside run() would pass any reading
# of the run() wrapper and fail this.
INSTALL_STAMP=$(mktemp)

# EVERY dry run below goes through this, and the reason is a real failure.
#
# install.sh refuses with rc=3 when the machine is in experiment mode — the
# guard that stops a controlled baseline being silently reverted. It reads the
# REAL /usr/local/share/qca9377-bt-hang/mode unless BT_MODE_STAMP redirects it.
#
# Four dry runs here called ./install.sh bare. On a development checkout that
# is harmless, because no mode stamp is installed and the guard never fires.
# On the investigation machine — which is in experiment mode, which is the
# whole point of experiment mode — all four exited 3 and the suite reported
# four failures that say nothing about install.sh. The seam already existed and
# was used correctly by the experiment-mode test twenty lines below.
#
# Pointing it at a nonexistent path is not a workaround: a dry run's contract
# is "print what would happen and change nothing", and it must hold whatever
# mode the machine happens to be in. The mode guard has its own test.
install_dry() { BT_MODE_STAMP=/nonexistent/mode ./install.sh "$@" 2>&1; }

IOUT=$(install_dry); irc=$?
if (( irc == 0 )); then
    ok "install.sh dry run exits 0 as an ordinary user"
else
    bad "install.sh dry run failed (rc=$irc):"
    tail -3 <<<"$IOUT" | sed 's/^/      /'
fi
[[ "$IOUT" == *"DRY RUN"* && "$IOUT" == *"would run:"* ]] \
    && ok "install.sh announces the dry run and echoes rather than executes" \
    || bad "install.sh dry-run output lacks the DRY RUN banner or 'would run:' lines"

# `install -D`, `systemctl`, `tee` appearing OUTSIDE a 'would run:' line would
# mean the dry run executed something.
n=$(grep -cE '^\s*\+ ' <<<"$IOUT")
(( ${n:-0} == 0 )) && ok "install.sh dry run executes no command (no '+' lines)" \
                   || bad "install.sh dry run EXECUTED $n command(s)"

WROTE=$(find /usr/local /etc/systemd/system /etc/modprobe.d /etc/udev/rules.d \
             -newer "$INSTALL_STAMP" -type f 2>/dev/null | head -5)
[[ -z "$WROTE" ]] && ok "install.sh dry run wrote nothing under the install trees" \
                  || bad "install.sh dry run WROTE: $WROTE"

install_dry --bogus >/dev/null 2>&1
(( $? != 0 )) && ok "install.sh rejects an unknown option" \
              || bad "install.sh accepted an unknown option"

# A non-default device must produce the per-unit device drop-ins, and the
# default device must NOT — a drop-in for the defaults would shadow future
# script-default changes for no reason, which is why install.sh avoids it.
IDEV=$(BT_VID=0cf3 BT_PID=e300 install_dry)
[[ "$IDEV" == *"0cf3:e300"* && "$IDEV" == *"non-default device"* \
   && "$IDEV" == *"10-device.conf (BT_VID=0cf3 BT_PID=e300)"* ]] \
    && ok "install.sh honours BT_VID/BT_PID and plans the device drop-ins" \
    || bad "install.sh ignored the device override"
IDEF=$(install_dry)
[[ "$IDEF" == *"no drop-in needed"* ]] \
    && ok "install.sh plans no drop-in for the default device" \
    || bad "install.sh planned a drop-in for the defaults"

# The experiment-mode refusal, via the BT_MODE_STAMP seam. This is the guard
# that protects a controlled baseline from being silently reverted; it must
# refuse BEFORE anything else — even a dry run prints install plans a reader
# may follow by hand.
MODEF=$(mktemp); echo "experiment since=2026-08-13" > "$MODEF"
MOUT=$(BT_MODE_STAMP="$MODEF" ./install.sh 2>&1); mrc=$?
if (( mrc == 3 )) && [[ "$MOUT" == *"EXPERIMENT"* ]]; then
    ok "install.sh refuses (rc=3) when the machine is in experiment mode"
else
    bad "experiment-mode guard did not refuse (rc=$mrc)"
fi
rm -f "$MODEF" "$INSTALL_STAMP"

UOUT=$(./uninstall.sh 2>&1); urc=$?
if (( urc == 0 )) && [[ "$UOUT" == *"DRY RUN COMPLETE"* ]]; then
    ok "uninstall.sh dry run exits 0 and completes"
else
    bad "uninstall.sh dry run failed (rc=$urc)"
fi
./uninstall.sh --bogus >/dev/null 2>&1
(( $? != 0 )) && ok "uninstall.sh rejects an unknown option" \
              || bad "uninstall.sh accepted an unknown option"




echo
echo "bt-usbmon — the supervision loop, run rather than reasoned about"
echo "────────────────────────────────────────────────────────────────"
#
# WHY THIS LOOP DESERVES A REAL TEST RATHER THAN A --check.
#
# The first version rotated with `tcpdump -C $MAX_MB -W 1` and relied on
# tcpdump EXITING at the size limit. That is not what -C with -W does: it is a
# RING. tcpdump overwrote its single file from the beginning and never exited,
# so the loop body never advanced — prune() and the free-space floor never ran
# again, retention silently collapsed from KEEP files to one 64 MB ring, and
# the older USB history needed to interpret the post-HCI trajectory was
# destroyed at every wrap.
#
# Nothing about that is visible in a static read, and --check does not enter
# the loop. It is visible in about four seconds of actually running it. So this
# runs the daemon, with a stub tcpdump standing in for the capture, and asserts
# on the files and the gap log it leaves behind.
UM=$(mktemp -d); mkdir -p "$UM/bin" "$UM/cap" "$UM/dbg"
mkdir -p "$UM/sysfs/3-3"
echo 13d3 > "$UM/sysfs/3-3/idVendor"; echo 3503 > "$UM/sysfs/3-3/idProduct"
echo 3    > "$UM/sysfs/3-3/busnum"
: > "$UM/dbg/3u"                      # the usbmon debugfs node for bus 3
printf '#!/bin/sh\nexit 0\n' > "$UM/bin/modprobe"
# df reports whatever a test asks for, so the free-space floor is reachable
# without filling a real disk.
cat > "$UM/bin/df" <<UMDF
#!/bin/sh
echo "Avail"
echo "\$(cat "$UM/freegb" 2>/dev/null || echo 999)G"
UMDF
# A tcpdump that behaves like tcpdump: creates its -w file, grows it, and stays
# alive until killed. Size and lifetime are controlled by files, so one stub
# covers the rotation case and the crash case.
cat > "$UM/bin/tcpdump" <<UMTD
#!/bin/sh
out=""
while [ \$# -gt 0 ]; do case "\$1" in -w) out="\$2"; shift ;; esac; shift; done
[ -e "$UM/tcpdump-dies" ] && exit 3
[ -n "\$out" ] && dd if=/dev/zero of="\$out" bs=1024 count="\$(cat "$UM/capkb" 2>/dev/null || echo 4)" 2>/dev/null
while :; do sleep 1; done
UMTD
chmod +x "$UM/bin"/*

# Every seam defaults here but yields to whatever the caller set, so a test
# overrides ONE of them — `BT_SYSFS_USB="$UM/empty" um --check` — without
# restating the other four. The first version took the overrides as positional
# arguments and handed `--check` to the shell as a command name.
um() {
    PATH="$UM/bin:$PATH" \
    BT_SYSFS_USB="${BT_SYSFS_USB:-$UM/sysfs}" \
    BT_USBMON_DIR="${BT_USBMON_DIR:-$UM/cap}" \
    BT_USBMON_DEBUGFS="${BT_USBMON_DEBUGFS:-$UM/dbg}" \
    BT_USBMON_GAPLOG="${BT_USBMON_GAPLOG:-$UM/cap/gaps.log}" \
    bin/bt-usbmon "$@" 2>&1
}
um_wait() {   # <file> <pattern> <tenths> — poll instead of guessing a sleep
    local i=0
    while (( i < $3 )); do grep -q "$2" "$1" 2>/dev/null && return 0; sleep 0.1; i=$((i+1)); done
    return 1
}

# ── the resolution paths, before anything is captured ────────────────────
UMA=$(BT_SYSFS_USB="$UM/empty" um --check); umarc=$?
(( umarc == 0 )) && [[ "$UMA" == *"not present and no BT_USBMON_BUS set"* ]] \
    && ok "bt-usbmon --check reports an absent controller instead of idling" \
    || bad "absent-controller path wrong under --check (rc=$umarc)"

UMB=$(BT_SYSFS_USB="$UM/empty" BT_USBMON_BUS=3 um --check)
[[ "$UMB" == *"controller absent; using configured bus 3"* && "$UMB" == *"usbmon3"* ]] \
    && ok "an absent controller falls back to the bus recorded at install time" \
    || bad "the configured-bus fallback did not resolve usbmon3"
# That fallback is the difference between capturing the moment the device comes
# back after a cold boot and capturing nothing at all.

UMC=$(BT_USBMON_DEBUGFS="$UM/nodbg" um --check); umcrc=$?
(( umcrc == 1 )) && [[ "$UMC" == *"is debugfs mounted and usbmon loaded"* ]] \
    && ok "a missing usbmon interface is an error, not a silent no-capture" \
    || bad "the debugfs check did not refuse (rc=$umcrc)"

um --bogus >/dev/null 2>&1
(( $? != 0 )) && ok "bt-usbmon rejects an unknown argument" \
              || bad "bt-usbmon accepted an unknown argument"

# ── retention by count ───────────────────────────────────────────────────
for i in 1 2 3 4 5; do
    : > "$UM/cap/usbmon-2026080$i-000000.pcap"
    touch -d "2026-08-0$i 00:00:00" "$UM/cap/usbmon-2026080$i-000000.pcap"
done
UMK=$(BT_USBMON_KEEP=2 um --check)
UMKN=$(ls -1 "$UM/cap"/usbmon-*.pcap 2>/dev/null | wc -l)
(( UMKN == 2 )) && [[ "$UMK" == *"pruning usbmon-20260801"* ]] \
   && [[ -e "$UM/cap/usbmon-20260805-000000.pcap" ]] \
    && ok "retention keeps the newest KEEP captures and names what it prunes" \
    || bad "retention left $UMKN file(s), or pruned the wrong end"

# ── the free-space floor, which overrides the count ──────────────────────
#
# A retention COUNT is a guess about file size; the floor is the check that
# cannot be wrong. It has two refusal branches, and both matter: one when
# there is nothing left to delete, and one when the only file left is the
# capture currently being written — where deleting it would free nothing,
# because tcpdump holds the inode open, and the loop would then eat every
# other file forever while the floor stayed breached.
echo 1 > "$UM/freegb"
UMF=$(BT_USBMON_KEEP=99 BT_USBMON_MIN_FREE_GB=15 um --check)
UMFN=$(ls -1 "$UM/cap"/usbmon-*.pcap 2>/dev/null | wc -l)
(( UMFN == 0 )) && [[ "$UMF" == *"low disk (1GB free): pruning"* ]] \
   && [[ "$UMF" == *"nothing left to prune"* ]] \
    && ok "the free-space floor prunes past KEEP and says when it runs out" \
    || bad "the floor left $UMFN file(s) or did not report exhaustion"
echo 999 > "$UM/freegb"

# ── THE LOOP ITSELF ──────────────────────────────────────────────────────
# Rotation happens HERE, not in tcpdump. Run it, and check the files.
echo 2048 > "$UM/capkb"                 # each capture is 2 MB
: > "$UM/cap/gaps.log"
PATH="$UM/bin:$PATH" BT_SYSFS_USB="$UM/sysfs" BT_USBMON_DIR="$UM/cap" \
    BT_USBMON_DEBUGFS="$UM/dbg" BT_USBMON_GAPLOG="$UM/cap/gaps.log" \
    BT_USBMON_MAX_MB=1 BT_USBMON_CHECK_SEC=1 BT_USBMON_KEEP=99 \
    bin/bt-usbmon > "$UM/daemon.log" 2>&1 &
UMPID=$!
um_wait "$UM/daemon.log" "rotating at" 60
sleep 1.2                                # let the rotation complete a new file
UMROT=$(ls -1 "$UM/cap"/usbmon-*.pcap 2>/dev/null | wc -l)
kill -TERM "$UMPID" 2>/dev/null; wait "$UMPID" 2>/dev/null
UMLOG=$(cat "$UM/daemon.log")

(( UMROT >= 2 )) && [[ "$UMLOG" == *"rotating at"* ]] \
    && ok "the loop rotates by restarting tcpdump, leaving $UMROT distinct captures" \
    || bad "rotation produced $UMROT capture file(s) — the ring bug would leave 1"
# The ring bug leaves exactly one file forever. Two is the whole difference.

grep -q 'rotate' "$UM/cap/gaps.log" \
    && ok "every rotation records its gap, so the record is never silently partial" \
    || bad "a rotation left no entry in the gap log"

[[ "$UMLOG" == *"stopped"* ]] \
    && ok "SIGTERM stops the capture cleanly rather than orphaning tcpdump" \
    || bad "the daemon did not run its cleanup on TERM"

# ── and when the capture process dies under it ───────────────────────────
# 67 btmon aborts in one boot lost the SCO parameters this investigation now
# needs. A supervisor that does not notice its child died is the same failure
# with a different process name.
touch "$UM/tcpdump-dies"
: > "$UM/cap/gaps.log"
PATH="$UM/bin:$PATH" BT_SYSFS_USB="$UM/sysfs" BT_USBMON_DIR="$UM/cap" \
    BT_USBMON_DEBUGFS="$UM/dbg" BT_USBMON_GAPLOG="$UM/cap/gaps.log" \
    BT_USBMON_CHECK_SEC=1 BT_USBMON_KEEP=99 \
    bin/bt-usbmon > "$UM/dead.log" 2>&1 &
UMPID2=$!
um_wait "$UM/dead.log" "tcpdump exited" 60
kill -TERM "$UMPID2" 2>/dev/null; wait "$UMPID2" 2>/dev/null
UMDEAD=$(cat "$UM/dead.log")
[[ "$UMDEAD" == *"tcpdump exited (rc=3) — restarting"* ]] \
    && ok "a capture process that dies is noticed, with its exit status" \
    || bad "the supervisor did not report a dead tcpdump"
grep -q 'tcpdump-exit' "$UM/cap/gaps.log" \
    && ok "the gap left by a dead capture is recorded, not inferred later" \
    || bad "a capture crash left no gap-log entry"
rm -f "$UM/tcpdump-dies"

rm -rf "$UM"

echo
echo "bt-trace — the other supervision loop, and the floor that stops it"
echo "──────────────────────────────────────────────────────────────────"
#
# Same shape as bt-usbmon and a different failure history: 67 btmon aborts in
# one boot lost the SCO parameters this investigation now needs, which is why
# the loop counts crashes and blind time rather than merely restarting. And it
# has one branch bt-usbmon does not — when the filesystem is under the floor
# with nothing left to prune, it STOPS CAPTURING and idles, because a service
# writing continuously must not be able to fill the root filesystem of a
# working machine.
TR=$(mktemp -d); mkdir -p "$TR/bin" "$TR/cap"
cat > "$TR/bin/df" <<TRDF
#!/bin/sh
echo "Avail"
echo "\$(cat "$TR/freegb" 2>/dev/null || echo 999)G"
TRDF
cat > "$TR/bin/btmon" <<TRBM
#!/bin/sh
out=""
while [ \$# -gt 0 ]; do case "\$1" in -w) out="\$2"; shift ;; esac; shift; done
[ -e "$TR/btmon-dies" ] && exit 5
[ -n "\$out" ] && dd if=/dev/zero of="\$out" bs=1024 count="\$(cat "$TR/capkb" 2>/dev/null || echo 4)" 2>/dev/null
while :; do sleep 1; done
TRBM
chmod +x "$TR/bin"/*
echo 999 > "$TR/freegb"

tr_daemon() {   # <marker> <tenths> [env...] — run the loop until the marker, then TERM
    local marker="$1" tenths="$2"; shift 2
    : > "$TR/cap/gaps.log"; : > "$TR/daemon.log"
    # env(1), not a bare assignment prefix: `VAR=1 cmd` is recognised
    # SYNTACTICALLY, so words arriving through "$@" are not assignments — the
    # first one becomes the command name and the daemon never runs. env also
    # execs, so $! stays the daemon's pid and the TERM below reaches its trap.
    env PATH="$TR/bin:$PATH" BT_TRACE_DIR="$TR/cap" BT_TRACE_GAPLOG="$TR/cap/gaps.log" \
        BT_TRACE_POLL_SEC=1 "$@" bin/bt-trace > "$TR/daemon.log" 2>&1 &
    local pid=$! i=0
    while (( i < tenths )); do grep -q "$marker" "$TR/daemon.log" 2>/dev/null && break; sleep 0.1; i=$((i+1)); done
    sleep 0.3
    kill -TERM "$pid" 2>/dev/null; wait "$pid" 2>/dev/null
    cat "$TR/daemon.log"
}

echo 2048 > "$TR/capkb"
TRR=$(tr_daemon "rotating at" 80 BT_TRACE_MAX_MB=1 BT_TRACE_CHECK_SEC=1)
TRN=$(ls -1 "$TR/cap"/bt-*.btsnoop 2>/dev/null | wc -l)
(( TRN >= 2 )) && [[ "$TRR" == *"rotating at"* && "$TRR" == *"stopped"* ]] \
    && ok "bt-trace rotates by restarting btmon, leaving $TRN distinct captures" \
    || bad "bt-trace rotation produced $TRN capture file(s)"

# THE CAPTURES ARE 0600. They contain the contents of Bluetooth traffic, and
# this repository publishes from the same tree it captures into.
TRMODE=$(stat -c '%a' "$(ls -1t "$TR/cap"/bt-*.btsnoop | head -1)" 2>/dev/null)
[[ "$TRMODE" == "600" ]] \
    && ok "captures are written unreadable to other users (0600)" \
    || bad "a capture was written mode $TRMODE"

grep -q 'rotate' "$TR/cap/gaps.log" \
    && ok "bt-trace records the gap at every rotation, with the running blind total" \
    || bad "a bt-trace rotation left no gap-log entry"

# ── the crash counter, which is the point of this supervisor ─────────────
touch "$TR/btmon-dies"
TRC=$(tr_daemon "btmon exited" 80 BT_TRACE_CHECK_SEC=30)
[[ "$TRC" == *"btmon exited (#1)"* && "$TRC" == *"of capture lost"* ]] \
    && ok "a btmon crash is counted and the lost capture time is stated" \
    || bad "bt-trace did not report a btmon crash"
grep -q 'total_blind=' "$TR/cap/gaps.log" \
    && ok "the gap log carries a running blind total, not just isolated events" \
    || bad "the crash gap entry has no cumulative blind time"
rm -f "$TR/btmon-dies"

# ── the floor, and what it does when pruning cannot help ─────────────────
#
# Stopping the capture is the correct answer here and it is a severe one, so it
# has to be the tested one: the alternative is a service that fills the root
# filesystem of a machine someone is working on.
# AND IT MUST STILL STOP. The idle loop that follows runs AFTER `trap cleanup
# TERM INT`, and bash defers a trapped signal until the running foreground
# command returns — so `while :; do sleep 3600; done` there would swallow
# SIGTERM for up to an hour. `systemctl stop bt-trace` would hang until
# TimeoutStopSec expired and systemd would SIGKILL the unit, leaving btmon
# orphaned and still holding the capture file. Found by this test hanging.
echo 1 > "$TR/freegb"
: > "$TR/cap/gaps.log"; : > "$TR/daemon.log"
env PATH="$TR/bin:$PATH" BT_TRACE_DIR="$TR/cap" BT_TRACE_GAPLOG="$TR/cap/gaps.log" \
    BT_TRACE_POLL_SEC=1 BT_TRACE_MIN_FREE_GB=15 BT_TRACE_CHECK_SEC=1 \
    bin/bt-trace > "$TR/daemon.log" 2>&1 &
TRPID=$!
tri=0
while (( tri < 80 )); do grep -q "nothing left to prune" "$TR/daemon.log" 2>/dev/null && break
                         sleep 0.1; tri=$((tri + 1)); done
kill -TERM "$TRPID" 2>/dev/null
trj=0
while (( trj < 30 )) && kill -0 "$TRPID" 2>/dev/null; do sleep 0.1; trj=$((trj + 1)); done
if kill -0 "$TRPID" 2>/dev/null; then
    kill -9 "$TRPID" 2>/dev/null
    bad "a floor-stopped bt-trace ignored SIGTERM — systemctl stop would time out"
else
    ok "a bt-trace idling after the disk floor still stops on SIGTERM"
fi
wait "$TRPID" 2>/dev/null
TRF=$(cat "$TR/daemon.log")
[[ "$TRF" == *"only 1GB free"* && "$TRF" == *"pruning captures"* ]] \
   && [[ "$TRF" == *"Stopping capture rather than filling the filesystem"* ]] \
   && [[ "$TRF" == *"systemctl restart bt-trace"* ]] \
    && ok "under the floor with nothing to prune, bt-trace stops and says how to resume" \
    || bad "the disk floor did not stop the capture"
echo 999 > "$TR/freegb"

rm -rf "$TR"

echo
echo "bt-trial — the whole lifecycle, not just the two ends of it"
echo "───────────────────────────────────────────────────────────"
#
# WHAT WAS COVERED AND WHAT WAS NOT. The sandbox above drives `autostart` and
# `ok`/`hang`, which is the path bt-trial-auto takes. The verbs an OPERATOR
# uses — start, step, abort — and the shutdown path `autostop` had never run,
# and neither had the two classifications that decide whether a trial may be
# POOLED with the others: a treatment that changed while the trial was open,
# and a perturbation inside the window.
#
# Those two matter more than the verbs. A trial whose treatment string is wrong
# does not fail; it joins a denominator it does not belong in, and every
# comparison computed from that denominator is quietly wrong afterwards. There
# is no error message for that anywhere in this project.
TL=$(mktemp -d)
mkdir -p "$TL/bin" "$TL/state" "$TL/evidence/trials" "$TL/tools"
touch "$TL/install.sh"; git -C "$TL" init -q 2>/dev/null
# hci_alive() walks $dev/*/bluetooth/hci* — without the node it reports a
# dead controller, and every close reclassifies to `failed`.
mkdir -p "$TL/sysfs/3-3/power" "$TL/sysfs/3-3/3-3:1.0/bluetooth/hci0"
echo 13d3 > "$TL/sysfs/3-3/idVendor"; echo 3503 > "$TL/sysfs/3-3/idProduct"
echo on   > "$TL/sysfs/3-3/power/control"

# A controller that answers unless a test kills it on purpose, so the
# classification under test is bt-trial's and not the machine's radio.
cat > "$TL/bin/hciconfig" <<TLSTUB
#!/bin/sh
[ -e "$TL/dead" ] && exit 1
exit 0
TLSTUB
# THE TREATMENT FINGERPRINT IS DRIVEN FROM HERE. Both watchdog branches and
# both probe branches are selected by files, because on a real machine they are
# selected by whether services are running — and a test may not start the
# recovery watchdog on the host it is running on.
cat > "$TL/bin/systemctl" <<TLSTUB
#!/bin/sh
case "\$*" in
  *"is-active --quiet bt-hang-watchdog"*)      [ -e "$TL/wd-on" ]    && exit 0; exit 3 ;;
  *"is-active --quiet bt-health-snapshot"*)    [ -e "$TL/probes-on" ] && exit 0; exit 3 ;;
  *"show bt-hang-watchdog -p Environment"*)    echo "BT_EARLY=1 BT_THRESHOLD=5"; exit 0 ;;
esac
exit 0
TLSTUB
printf '#!/bin/sh\necho "up 1 hour"\n' > "$TL/bin/uptime"
printf '#!/bin/sh\nexit 0\n' > "$TL/bin/bt-incident"
# bt-trial reads the kernel journal through journalctl DIRECTLY, not through
# tools/lib/journal.sh — it is one of the ten tools UT-10 has not converted.
# So the window's contents are a stub reading a file this section writes.
: > "$TL/kjournal"
cat > "$TL/bin/journalctl" <<TLJC
#!/bin/sh
case "\$*" in
  *"-b -1"*) cat "$TL/prevboot" 2>/dev/null; exit 0 ;;
esac
[ -e "$TL/journal-unreadable" ] && exit 1
cat "$TL/kjournal"
exit 0
TLJC
: > "$TL/prevboot"
chmod +x "$TL/bin"/*

# The ONLY way this section may invoke bt-trial. Same rule as the sandbox
# above, and the same reason: an invocation that forgets BT_EVIDENCE_REPO
# writes a fabricated incident into the real evidence tree.
tl() {
    PATH="$TL/bin:$PATH" \
    BT_REPO="$TL" BT_EVIDENCE_REPO="$TL" \
    BT_STATE="$TL/state" BT_SYSFS_USB="$TL/sysfs" \
    tools/bt-trial "$@" 2>&1
}
tl_row() { tail -1 "$TL/evidence/trials/results.tsv" 2>/dev/null; }
tl_field() { tl_row | cut -f"$1"; }

TLP=$(tl protocol); tlprc=$?
(( tlprc == 0 )) && [[ "$TLP" == *"bt-trial start"* ]] \
    && ok "bt-trial protocol prints the procedure without opening anything" \
    || bad "protocol did not print the procedure (rc=$tlprc)"
[[ ! -e "$TL/state/current" ]] \
    && ok "printing the protocol opens no trial" \
    || bad "protocol left a trial open"

# ── start: the verb an operator uses ─────────────────────────────────────
touch "$TL/wd-on" "$TL/probes-on"
TLS=$(tl start stock); tlsrc=$?
TLDIR=$(grep '^dir=' "$TL/state/current" 2>/dev/null | cut -d= -f2-)
(( tlsrc == 0 )) && [[ -e "$TL/state/current" && -d "$TLDIR" && -e "$TLDIR/steps.log" ]] \
    && [[ "$TLS" == *"Trial stock #1 started"* ]] \
    || bad "start did not open a trial (rc=$tlsrc, dir=$TLDIR)"
(( tlsrc == 0 )) && [[ -e "$TLDIR/steps.log" ]] \
    && ok "bt-trial start opens a numbered trial with its own directory"

# THE FINGERPRINT IS TAKEN AT START. An auto-trial spans a whole boot and this
# project reconfigures instrumentation while one is open, so a fingerprint read
# at close would describe a three-hour boot by the configuration of its last
# minute.
TLTS=$(grep '^treat_start=' "$TL/state/current" | cut -d= -f2-)
[[ "$TLTS" == *"wd=early+late/thr5"* && "$TLTS" == *"probes=on"* ]] \
    && ok "the treatment fingerprint reads the watchdog's actual configuration" \
    || bad "fingerprint did not describe a running watchdog: '$TLTS'"

TLS2=$(tl start stock); tls2rc=$?
(( tls2rc == 1 )) && [[ "$TLS2" == *"already open"* ]] \
    && ok "a second start refuses rather than overwriting the open trial" \
    || bad "start did not refuse with a trial already open (rc=$tls2rc)"

# ── step: the operator's record of what they did ─────────────────────────
TLST=$(tl step "plugged in the headset"); tlstrc=$?
(( tlstrc == 0 )) && grep -qE '^\[\+[0-9]+s\] plugged in the headset$' "$TLDIR/steps.log" \
    && ok "bt-trial step records what was done, stamped from the trial's start" \
    || bad "step did not append a stamped line (rc=$tlstrc)"

tl step >/dev/null 2>&1
(( $? != 0 )) && ok "step without a description refuses instead of recording nothing" \
              || bad "step accepted an empty description"

# ── abort: the trial that must not become a row ──────────────────────────
TLA=$(tl abort); tlarc=$?
(( tlarc == 0 )) && [[ ! -e "$TL/state/current" && ! -d "$TLDIR" ]] \
    && [[ "$TLA" == *"discarded"* ]] \
    && ok "abort discards the trial directory and writes no results row" \
    || bad "abort left state behind (rc=$tlarc)"

TLA2=$(tl abort); tla2rc=$?
(( tla2rc == 0 )) && [[ "$TLA2" == *"no trial open"* ]] \
    && ok "abort with nothing open is a no-op, not an error" \
    || bad "abort without a trial was not a clean no-op (rc=$tla2rc)"

TLSTEP=$(tl step "nothing is open"); tlsteprc=$?
(( tlsteprc == 1 )) && [[ "$TLSTEP" == *"no trial open"* ]] \
    && ok "step with nothing open refuses rather than creating a stray log" \
    || bad "step without a trial did not refuse (rc=$tlsteprc)"

# ── a dead controller must not start a trial ─────────────────────────────
touch "$TL/dead"
TLD=$(tl start stock); tldrc=$?
(( tldrc == 1 )) && [[ "$TLD" == *"not responding"* && "$TLD" == *"measures nothing"* ]] \
    && [[ ! -e "$TL/state/current" ]] \
    && ok "start on a dead controller refuses — a trial from there measures nothing" \
    || bad "start proceeded on a dead controller (rc=$tldrc)"

# ── autostop: what shutdown does, classified by the controller ───────────
TLAS=$(tl autostop); tlasrc=$?
(( tlasrc == 0 )) && [[ -z "$TLAS" ]] \
    && ok "autostop with no trial open exits quietly" \
    || bad "autostop without a trial was not silent (rc=$tlasrc): $TLAS"

rm -f "$TL/dead"
tl autostart stock >/dev/null 2>&1
tl autostop >/dev/null 2>&1
[[ "$(tl_field 9)" == "survived" ]] \
    && ok "autostop on a responding controller closes the trial as survived" \
    || bad "autostop misclassified a live controller as '$(tl_field 9)'"

tl autostart stock >/dev/null 2>&1
touch "$TL/dead"
tl autostop >/dev/null 2>&1
# `failed` is the tool's word for it — the three trial_result values are
# survived / failed / alive_after_intervention, and `hang` is the VERB that
# produces the second. Asserting "hang" here tested the vocabulary this check
# expected rather than the one the results file uses.
[[ "$(tl_field 9)" == "failed" ]] \
    && ok "autostop on a dead controller closes the trial through the hang path" \
    || bad "autostop misclassified a dead controller as '$(tl_field 9)'"
rm -f "$TL/dead"

# ── the two classifications that decide whether a row may be POOLED ──────
#
# A trial whose treatment changed mid-window, or which was perturbed inside it,
# must not join a denominator with the others. Neither is an error and neither
# prints a warning; the only defence is that the treatment string is made
# deliberately unmatchable. If that stops working, the rows still look ordinary
# and every comparison built on them is silently wrong.
tl autostart stock >/dev/null 2>&1
rm -f "$TL/probes-on"                      # the treatment changes mid-trial
tl ok >/dev/null 2>&1
TLTR=$(tl_field 4)
[[ "$TLTR" == CHANGED:* && "$TLTR" == *"probes=on"* && "$TLTR" == *"probes=off"* ]] \
    && ok "a treatment that changed mid-trial is recorded as CHANGED, with both ends" \
    || bad "a mid-trial treatment change was recorded as an ordinary row: '$TLTR'"

# THE INTERIOR, WHICH TWO ENDPOINTS CANNOT DESCRIBE. A btusb reload unbinds the
# device, resets it and rebinds it, leaving both fingerprints identical. On
# 2026-08-13 install.sh --apply did exactly that inside trial stock #2, and the
# row would otherwise have read as clean, ordinary and comparable.
cat > "$TL/kjournal" <<'TLJRN'
2026-08-13T09:00:00.000000+0200 host kernel: usb 3-3: new full-speed USB device number 2 using xhci_hcd
2026-08-13T09:00:10.000000+0200 host kernel: usbcore: deregistering interface driver btusb
2026-08-13T09:00:20.000000+0200 host kernel: Bluetooth: MGMT ver 1.22
TLJRN
tl autostart stock >/dev/null 2>&1
tl ok >/dev/null 2>&1
TLPR=$(tl_field 4)
[[ "$TLPR" == *"PERTURBED:btusb_reload"* ]] \
    && ok "a btusb reload inside the window makes the treatment unpoolable" \
    || bad "an interior perturbation left the row comparable: '$TLPR'"
# Column 23 is `perturbed`, resolved from the header rather than counted by
# eye — the first draft of this check read column 17, which is `probes`, and
# asserted a true thing about the wrong field.
TLPCOL=$(head -1 "$TL/evidence/trials/results.tsv" | tr '\t' '\n' | grep -n '^perturbed$' | cut -d: -f1)
[[ -n "$TLPCOL" ]] && [[ "$(tl_row | cut -f"$TLPCOL")" == "btusb_reload" ]] \
    && ok "the perturbation is named in the perturbed column (field $TLPCOL)" \
    || bad "perturbed column $TLPCOL read '$(tl_row | cut -f"${TLPCOL:-1}")'"

# ── status: the view that decides whether to abort a trial in progress ───
#
# The one command an operator runs WHILE a trial is open, and the only place
# the project warns that a trial has already been spoiled. Untested until now,
# including the warning itself.
TLNS=$(tl status); tlnsrc=$?
(( tlnsrc == 0 )) && [[ "$TLNS" == *"no trial open"* ]] \
    && ok "bt-trial status with nothing open says so and exits 0" \
    || bad "status without a trial was not a clean report (rc=$tlnsrc)"

cat > "$TL/kjournal" <<'TLCLEAN'
2026-08-13T09:00:00.000000+0200 host kernel: Bluetooth: hci0: command 0x0c1a tx timeout
2026-08-13T09:00:05.000000+0200 host kernel: Bluetooth: hci0 opcode 0x0428 plen 17
TLCLEAN
tl start stock >/dev/null 2>&1
TLSC=$(tl status); tlscrc=$?
(( tlscrc == 0 )) && [[ "$TLSC" == *"trial OPEN"* && "$TLSC" == *"elapsed="* ]] \
   && [[ "$TLSC" == *"HCI command timeouts  1"* && "$TLSC" == *"SCO setups requested  1"* ]] \
    && ok "status counts what has happened inside the window so far" \
    || bad "status did not report the window's counts (rc=$tlscrc)"
[[ "$TLSC" == *"clean"* && "$TLSC" != *"PERTURBED"* ]] \
    && ok "status calls an unperturbed window clean" \
    || bad "status warned of a perturbation that was not there"

# The warning that saves a trial: something reset the controller inside the
# window, so the row is already destined for a PERTURBED treatment and every
# denominator will exclude it. Telling the operator NOW is the difference
# between an aborted trial and a wasted boot.
cat >> "$TL/kjournal" <<'TLPERT'
2026-08-13T09:00:10.000000+0200 host kernel: usbcore: deregistering interface driver btusb
TLPERT
TLSP=$(tl status)
[[ "$TLSP" == *"PERTURBED"* && "$TLSP" == *"btusb reloads=1"* \
   && "$TLSP" == *"bt-trial abort"* ]] \
    && ok "status warns mid-trial that the window is already spoiled, and what to do" \
    || bad "status did not warn about a btusb reload inside the window"

touch "$TL/journal-unreadable"
TLSU=$(tl status)
[[ "$TLSU" == *"cannot certify this trial's interior"* ]] \
    && ok "an unreadable journal is reported as uncertifiable, not as clean" \
    || bad "status treated an unreadable journal as an absence of perturbation"
rm -f "$TL/journal-unreadable"
tl abort >/dev/null 2>&1

# ── the previous shutdown, which decides whether a boot is comparable ────
: > "$TL/kjournal"
# systemd's own wording: the classifier matches `Reached target <kind>`, and a
# fixture saying `systemd-shutdown: poweroff` exercises only the unknown
# branch — a real answer, just not the one under test.
printf 'systemd[1]: Reached target poweroff.target - System Power Off.\n' > "$TL/prevboot"
tl autostart stock >/dev/null 2>&1; tl ok >/dev/null 2>&1
TLPSCOL=$(head -1 "$TL/evidence/trials/results.tsv" | tr '\t' '\n' | grep -n '^prev_shutdown$' | cut -d: -f1)
[[ -n "$TLPSCOL" ]] && [[ "$(tl_row | cut -f"$TLPSCOL")" == "poweroff" ]] \
    && ok "the previous boot's shutdown kind is classified from its own journal" \
    || bad "prev_shutdown read '$(tl_row | cut -f"${TLPSCOL:-1}")', not poweroff"

printf 'systemd[1]: Reached target reboot.target - System Reboot.\n' > "$TL/prevboot"
tl autostart stock >/dev/null 2>&1; tl ok >/dev/null 2>&1
[[ "$(tl_row | cut -f"$TLPSCOL")" == "reboot" ]] \
    && ok "a reboot and a power-off are distinguished, not merged" \
    || bad "a reboot was recorded as '$(tl_row | cut -f"$TLPSCOL")'"

# enum_at_boot: whether the controller appeared on the bus at all this boot.
printf 'kernel: usb 3-3: New USB device found, idVendor=13d3, idProduct=3503, bcdDevice= 0.01\n' >> "$TL/kjournal"
tl autostart stock >/dev/null 2>&1; tl ok >/dev/null 2>&1
TLECOL=$(head -1 "$TL/evidence/trials/results.tsv" | tr '\t' '\n' | grep -n '^enum_at_boot$' | cut -d: -f1)
[[ -n "$TLECOL" ]] && [[ "$(tl_row | cut -f"$TLECOL")" == "yes" ]] \
    && ok "a controller that enumerated this boot is recorded as having done so" \
    || bad "enum_at_boot read '$(tl_row | cut -f"${TLECOL:-1}")' with the device in the journal"

tl xyzzy >/dev/null 2>&1
(( $? != 0 )) && ok "bt-trial rejects an unknown verb rather than doing nothing quietly" \
              || bad "bt-trial accepted an unknown verb"

rm -rf "$TL"

echo
echo "install.sh / uninstall.sh — the APPLY path, for real, into a staging root"
echo "─────────────────────────────────────────────────────────────────────────"
#
# WHAT WAS UNTESTED, AND WHY IT STAYED THAT WAY.
#
# Roughly 40% of install.sh and 70% of uninstall.sh is the --apply branch, and
# it is the half a user's first command runs. Nothing had ever executed it.
# tests/system-roundtrip reaches it, but installs to the real /usr/local and
# /etc, so it is gated on a live systemd, on nothing being installed already,
# and on no experiment being in progress. Those gates hold on the investigation
# machine and in every container — so the branch was, in practice, tested
# nowhere, and the number said so at 0%.
#
# BT_DESTDIR is a staging prefix. --apply then performs the SAME operations —
# real `install -D`, real modes, real generated drop-ins, real udev
# substitution — under a throwaway root, on any machine, with no privilege.
#
# THE CLAIM UNDER TEST is the one on the front page of the README:
#
#     "Every file installed is NEW. Nothing pre-existing is modified, so
#      uninstalling is a complete restoration."
#
# That is a property of the PAIR. Neither script can be read to establish it,
# and this repository has already shipped the two out of step — four artifacts
# installed and never removed, while the summary printed "complete
# restoration".
#
# ── WHY THIS IS SAFE TO RUN ANYWHERE, INCLUDING ON THE MACHINE ───────────
#
# It runs a real installer. Two things make that safe, and both are mechanical
# rather than remembered:
#
#   1. BT_DESTDIR is non-empty by construction — a mktemp -d — and
#      stage_install() REFUSES if it is not. Every write goes under it.
#   2. The activation commands are not writes to a prefix; `systemctl
#      daemon-reload` and `systemctl restart systemd-journald` would act on
#      the real machine. So stage_install() verifies the stub actually WINS on
#      PATH before running anything, and returns without invoking the
#      installer if it does not. A pre-flight check, not a post-mortem: by the
#      time a spy log could tell you the stub lost, journald has restarted.
SR=$(mktemp -d)                        # the staging root
SS=$(mktemp -d); mkdir -p "$SS/bin"    # stubs for everything an install activates
for c in systemctl udevadm modprobe sleep journalctl btmon tcpdump; do
    printf '#!/bin/sh\necho "%s $*" >> "%s/spy.log"\nexit 0\n' "$c" "$SS" > "$SS/bin/$c"
    chmod +x "$SS/bin/$c"
done
: > "$SS/spy.log"

# btmon and tcpdump are present as stubs on purpose: their absence is what
# skips bt-trace, bt-sco, bt-capdiff and bt-usbmon, and the MAXIMAL install is
# the one where install.sh and uninstall.sh can be out of step.
stage_guard() {   # refuse unless the staging root and the stubs are both real
    [[ -n "${SR:-}" && -d "$SR" ]] || { echo "stage: no staging root" >&2; return 99; }
    # `command` is a shell builtin, so this needs a shell, not env(1).
    local got; got=$(PATH="$SS/bin:$PATH" bash -c 'command -v systemctl')
    [[ "$got" == "$SS/bin/systemctl" ]] || {
        echo "stage: systemctl resolves to $got, not the stub — refusing to --apply" >&2
        return 99; }
}
stage_install()   { stage_guard || return 99
                    env PATH="$SS/bin:$PATH" BT_MODE_STAMP=/nonexistent/mode \
                        BT_STATE="$SR/no-such-trial" BT_DESTDIR="$SR" \
                        "$@" ./install.sh --apply 2>&1; }
stage_uninstall() { stage_guard || return 99
                    env PATH="$SS/bin:$PATH" BT_DESTDIR="$SR" \
                        "$@" ./uninstall.sh --apply 2>&1; }

# The real system's fingerprint, taken BEFORE the first staged install and
# compared after the last. Snapshot rather than absolute state: on the
# investigation machine these paths EXIST, and a check that demanded their
# absence would fail there for the machine's correct configuration — which is
# the defect class this suite has now produced seven times.
real_install_state() {
    local p
    for p in /usr/local/bin/bt-trial /usr/local/sbin/bt-hang-watchdog \
             /usr/local/share/qca9377-bt-hang/installed-at \
             /etc/udev/rules.d/50-bluetooth-no-autosuspend.rules \
             /etc/systemd/system/bt-hang-watchdog.service; do
        if [[ -e "$p" ]]; then echo "$p $(stat -c '%Y %s' "$p" 2>/dev/null)"
        else echo "$p absent"; fi
    done
}
REAL_BEFORE=$(real_install_state)

SIOUT=$(stage_install BT_VID=0cf3 BT_PID=e300); sirc=$?
SIERR=$(grep -c 'ERROR' <<<"$SIOUT")
SIN=$(find "$SR" -type f 2>/dev/null | wc -l)
if (( sirc == 0 && ${SIERR:-1} == 0 && SIN >= 50 )); then
    ok "install.sh --apply completes into a staging root ($SIN files, 0 errors)"
else
    bad "staged install failed (rc=$sirc, $SIERR error line(s), $SIN file(s)):"
    bad "  $(grep -m1 ERROR <<<"$SIOUT")"
fi

# THE MODES ARE DERIVED FROM install.sh, not listed here. A hand-written table
# of expected modes is a second copy of the installer that rots against it; the
# question is whether the file on disk carries the mode the installer DECLARED.
IMODES=$(awk '{ while (/\\$/ && (getline nxt) > 0) { sub(/\\$/, "", $0); $0 = $0 nxt } print }' install.sh \
    | grep -oE 'install_file[[:space:]]+"\$SRC/[^"]+"[[:space:]]+[^[:space:]]+[[:space:]]+0[0-7]{3}' \
    | awk '{print $3, $4}')
badmode=""; nmode=0
while read -r dst mode; do
    [[ -n "$dst" && -e "$SR$dst" ]] || continue
    nmode=$((nmode + 1))
    got=$(stat -c '%a' "$SR$dst" 2>/dev/null)
    [[ "$got" == "${mode#0}" ]] || badmode="$badmode; $dst want ${mode#0} got $got"
done <<<"$IMODES"
# Counted, so a derivation that stops matching reads as 0 rather than as a tick.
[[ -z "$badmode" ]] && (( nmode >= 40 )) \
    && ok "all $nmode staged files carry the mode install.sh declares" \
    || bad "checked $nmode file mode(s):$badmode"

# AND THE DECLARATION ITSELF HAS TO BE RIGHT, which the comparison above cannot
# tell you: it reads disk against install.sh, so changing install.sh moves both
# sides and the check stays green. Mutating a declared 0755 to 0644 passed it.
#
# The policy is derived from where the file LANDS, which is independent of what
# install.sh says about it:
#
#   /usr/local/{bin,sbin}/<name>   invoked by bare name  -> must be 0755
#   anything else (lib/*.awk, lib/*.sh, units, rules, conf, baseline) -> 0644
#
# That set is the same one guard_names derives, for the same reason: what a
# bare name can resolve to is exactly what has to be executable. This
# repository has already shipped bin/bt-usbmon tracked 100644, which exits 126
# the moment anything runs it; the installed side deserves the same check.
badpol=""; npol=0
while read -r dst mode; do
    [[ -n "$dst" ]] || continue
    npol=$((npol + 1))
    if [[ "$dst" =~ ^/usr/local/(bin|sbin)/[^/]+$ ]]; then want=0755; else want=0644; fi
    [[ "$mode" == "$want" ]] || badpol="$badpol; $dst declared $mode, must be $want"
done <<<"$IMODES"
[[ -z "$badpol" ]] && (( npol >= 40 )) \
    && ok "all $npol install_file declarations follow the executable-bit policy" \
    || bad "checked $npol declaration(s):$badpol"

# EVERYTHING INSTALLED MUST BE REMOVABLE. This is the direction that matters:
# a file install.sh creates and uninstall.sh does not know about survives a
# "complete restoration" forever. The reverse direction is fine — uninstall.sh
# lists conditional artifacts (btmon-dependent tools, drop-ins for a
# non-default device) that a given install may not have produced.
mapfile -t SUNF < <(sed -n '/^FILES=(/,/^)/p' uninstall.sh | grep -oE '/[a-zA-Z0-9._/-]+')
orph=""; nstaged=0
while IFS= read -r f; do
    rel="${f#"$SR"}"; nstaged=$((nstaged + 1)); hit=0
    for u in "${SUNF[@]}"; do [[ "$rel" == "$u" ]] && { hit=1; break; }; done
    (( hit )) || orph="$orph; $rel"
done < <(find "$SR" -type f 2>/dev/null)
[[ -z "$orph" ]] && (( nstaged >= 50 )) && (( ${#SUNF[@]} >= 40 )) \
    && ok "all $nstaged installed files are removable by uninstall.sh (${#SUNF[@]} listed)" \
    || bad "installed but not removable (of $nstaged, ${#SUNF[@]} listed):$orph"

# ── the device the install was generated FOR ─────────────────────────────
SUDEV="$SR/etc/udev/rules.d/50-bluetooth-no-autosuspend.rules"
[[ -s "$SUDEV" ]] && grep -q 'idVendor}=="0cf3"' "$SUDEV" && grep -q 'idProduct}=="e300"' "$SUDEV" \
    && ok "the udev power rule is generated for the target device, not copied" \
    || bad "udev rule was not substituted for 0cf3:e300"

# THE STRIPPED-HEX TRAP, asserted because it fails SILENTLY. The kernel formats
# PRODUCT as %x/%x/%x with no leading zeros (usb_uevent), so 0cf3:e300 appears
# as PRODUCT=cf3/e300/... A rule written "0cf3/e300*" never fires and every
# remove-event snapshot is lost with nothing in any log to say so. The default
# device 13d3:3503 has no leading zeros, which is exactly why the default could
# never expose this.
SSNAP="$SR/etc/udev/rules.d/51-bluetooth-health-snapshot.rules"
grep -q 'ENV{PRODUCT}=="cf3/e300\*"' "$SSNAP" 2>/dev/null \
    && ok "the remove-rule PRODUCT match uses the kernel's stripped hex (cf3/e300)" \
    || bad "PRODUCT match kept the zero-padded form — remove-event snapshots would be lost"

SDROP="$SR/etc/systemd/system/bt-hang-watchdog.service.d/10-device.conf"
SSDROP="$SR/etc/systemd/system/bt-health-snapshot.service.d/10-device.conf"
[[ -s "$SDROP" ]] && grep -q 'BT_VID=0cf3' "$SDROP" && grep -q 'BT_PID=e300' "$SDROP" \
   && [[ -s "$SSDROP" ]] && grep -q 'BT_PID=e300' "$SSDROP" \
    && ok "both systemd drop-ins carry the non-default device" \
    || bad "a drop-in is missing or does not name 0cf3:e300"

# ── "nothing pre-existing is modified" ───────────────────────────────────
# A file this project does not own, in a directory it writes into. It must come
# through both the second install and the uninstall untouched.
printf 'not ours\n' > "$SR/etc/systemd/system/unrelated.service"
SSTAMP1=$(cat "$SR/usr/local/share/qca9377-bt-hang/installed-at" 2>/dev/null)
SIOUT2=$(stage_install BT_VID=0cf3 BT_PID=e300); sirc2=$?
SSTAMP2=$(cat "$SR/usr/local/share/qca9377-bt-hang/installed-at" 2>/dev/null)

(( sirc2 == 0 )) && [[ -n "$SSTAMP1" && "$SSTAMP1" == "$SSTAMP2" ]] \
    && ok "the first-install stamp survives a re-install ($SSTAMP1)" \
    || bad "re-install moved the first-install stamp: '$SSTAMP1' -> '$SSTAMP2'"
# Deriving the change time from a unit file's mtime is the bug this stamp
# exists to avoid: every reinstall would move it forward and relabel
# already-mitigated boots as "before", contaminating the comparison.

[[ "$SIOUT2" == *"already exists — will be OVERWRITTEN"* ]] \
    && ok "a re-install names the files it is about to overwrite" \
    || bad "the overwrite warning did not fire on a second install"

# ── the round trip closes ────────────────────────────────────────────────
SDIR_MADE=$(while read -r d; do [[ -n "$d" && -d "$SR$d" ]] && echo "$d"; done \
            < <(sed -n '/^DIRS=(/,/^)/p' uninstall.sh | grep -oE '/[a-zA-Z0-9._/-]+') | grep -c .)
SUOUT=$(stage_uninstall); surc=$?
SLEFT=$(find "$SR" -type f ! -name unrelated.service 2>/dev/null | wc -l)
(( surc == 0 && ${SLEFT:-1} == 0 )) \
    && ok "uninstall.sh --apply removes every file install.sh created" \
    || bad "uninstall left $SLEFT file(s) behind (rc=$surc)"

[[ "$(cat "$SR/etc/systemd/system/unrelated.service" 2>/dev/null)" == "not ours" ]] \
    && ok "a file this project did not install is neither modified nor removed" \
    || bad "uninstall.sh touched a file it did not install — not a restoration"

sdleft=""; ndir=0
while read -r d; do
    [[ -n "$d" ]] || continue
    ndir=$((ndir + 1))
    [[ -d "$SR$d" ]] && sdleft="$sdleft; $d"
done < <(sed -n '/^DIRS=(/,/^)/p' uninstall.sh | grep -oE '/[a-zA-Z0-9._/-]+')
# SDIR_MADE is counted BEFORE the uninstall. Without it this check passes over
# an empty staging root — "all the directories are gone" is trivially true of
# directories that were never created, which is how it read when the install
# above was failing.
[[ -z "$sdleft" ]] && (( ndir >= 5 )) && (( ${SDIR_MADE:-0} >= 5 )) \
    && ok "all $SDIR_MADE of $ndir directories the install created are gone too" \
    || bad "install created $SDIR_MADE of $ndir dir(s); left after uninstall:$sdleft"

SUOUT2=$(stage_uninstall); surc2=$?
(( surc2 == 0 )) && [[ "$SUOUT2" == *"absent, nothing to do"* ]] \
    && ok "uninstall.sh on an already-clean root is idempotent" \
    || bad "a second uninstall was not a clean no-op (rc=$surc2)"

# ── the branches a plain round trip never reaches ────────────────────────
#
# A LEFTOVER IN A DIRECTORY THIS PROJECT CREATED. `rmdir
# --ignore-fail-on-non-empty` is SILENT when it declines, which is how a
# systemctl-edit override.conf survives an uninstall that reports success.
# The warning is the only thing standing between that and a false "complete
# restoration".
SRL=$(mktemp -d)
stage_at() { env PATH="$SS/bin:$PATH" BT_DESTDIR="$1" "${@:2}" ./uninstall.sh --apply 2>&1; }
mkdir -p "$SRL/usr/local/bin/lib"
printf 'hand-written\n' > "$SRL/usr/local/bin/lib/override.conf"
SRLOUT=$(stage_at "$SRL")
[[ "$SRLOUT" == *"still contains files not installed by this project"* \
   && "$SRLOUT" == *"override.conf"* ]] \
    && ok "uninstall.sh names a directory it could not remove, and what is in it" \
    || bad "a non-empty project directory was left without a word being said"

# --purge-metrics, which deletes collected DATA rather than configuration and
# is therefore the one destructive option either script has.
SRM=$(mktemp -d); mkdir -p "$SRM/var/log/bt-health"
printf 'ts\tvalue\n' > "$SRM/var/log/bt-health/metrics.tsv"
SRMK=$(stage_at "$SRM")
[[ -e "$SRM/var/log/bt-health/metrics.tsv" ]] && [[ "$SRMK" == *"KEEPING /var/log/bt-health"* ]] \
    && ok "uninstall.sh keeps collected metrics by default" \
    || bad "metrics were removed without --purge-metrics"
SRMP=$(env PATH="$SS/bin:$PATH" BT_DESTDIR="$SRM" ./uninstall.sh --apply --purge-metrics 2>&1)
[[ ! -e "$SRM/var/log/bt-health" ]] && [[ "$SRMP" == *"--purge-metrics"* ]] \
    && ok "--purge-metrics deletes the collected metrics it warns about" \
    || bad "--purge-metrics did not remove /var/log/bt-health"

# THE btusb RESTORE, both branches. They differ by the module's USECOUNT, and
# forcing a real usecount means holding the controller open — the one thing
# these tests may never do to the device under investigation. So /proc/modules
# is a seam and lsmod is a stub, and both branches are driven from text.
SPM=$(mktemp -d); mkdir -p "$SPM/bin"; cp "$SS/bin"/* "$SPM/bin/"
printf '#!/bin/sh\necho "btusb                  73728  0"\nexit 0\n' > "$SPM/bin/lsmod"
printf '#!/bin/sh\necho "modprobe $*" >> "%s/spy.log"\nexit 0\n' "$SPM" > "$SPM/bin/modprobe"
chmod +x "$SPM/bin"/*
SFREE=$(mktemp); printf 'btusb 73728 0 - Live 0x0000000000000000\n' > "$SFREE"
SBUSY=$(mktemp); printf 'btusb 73728 3 - Live 0x0000000000000000\n' > "$SBUSY"
SRB=$(mktemp -d)
SPMF=$(env PATH="$SPM/bin:$PATH" BT_DESTDIR="$SRB" BT_PROC_MODULES="$SFREE" \
           ./uninstall.sh --apply 2>&1)
[[ "$SPMF" == *"modprobe -r btusb"* && "$SPMF" == *"+ modprobe btusb"* ]] \
    && ok "an idle btusb is reloaded, restoring the kernel default in place" \
    || bad "uninstall.sh did not reload an idle btusb"
SPMB=$(env PATH="$SPM/bin:$PATH" BT_DESTDIR="$SRB" BT_PROC_MODULES="$SBUSY" \
           ./uninstall.sh --apply 2>&1)
[[ "$SPMB" == *"btusb is in use (usecount=3)"* && "$SPMB" != *"modprobe -r"* ]] \
    && ok "a btusb in use is left alone rather than force-unloaded" \
    || bad "uninstall.sh tried to unload a module that was in use"

rm -rf "$SRL" "$SRM" "$SPM" "$SRB" "$SFREE" "$SBUSY"

# ── the guards on --apply, which only --apply can reach ──────────────────
#
# Each of these protects a measurement in progress, and none of them had ever
# been executed: the experiment-mode refusal was covered only in its dry-run
# form, and the two warnings below exist solely on the apply path.
SRG=$(mktemp -d); SMS=$(mktemp); echo "experiment since=2026-08-13T12:22:10" > "$SMS"
GEX=$(env PATH="$SS/bin:$PATH" BT_MODE_STAMP="$SMS" BT_DESTDIR="$SRG" \
          BT_STATE="$SRG/none" ./install.sh --apply 2>&1); gexrc=$?
GEXN=$(find "$SRG" -type f 2>/dev/null | wc -l)
(( gexrc == 3 && ${GEXN:-1} == 0 )) && [[ "$GEX" == *"EXPERIMENT"* ]] \
    && ok "install.sh --apply refuses in experiment mode and stages nothing" \
    || bad "the experiment guard did not stop --apply (rc=$gexrc, $GEXN file(s) written)"

GFO=$(env PATH="$SS/bin:$PATH" BT_MODE_STAMP="$SMS" BT_DESTDIR="$SRG" \
          BT_FORCE_INSTALL=1 BT_STATE="$SRG/none" ./install.sh --apply 2>&1); gforc=$?
(( gforc == 0 )) && [[ "$GFO" == *"BT_FORCE_INSTALL=1 — continuing"* ]] \
    && ok "BT_FORCE_INSTALL=1 continues past the experiment guard and says so" \
    || bad "the forced install did not proceed (rc=$gforc)"

# The warning that a forced install ENDS a stage-1 observation. It fires only
# when this boot has already logged an HCI timeout, so the journal has to say
# so — a stub that prints one line, which is the only way this branch can be
# reached at all on a healthy machine.
SS2=$(mktemp -d); mkdir -p "$SS2/bin"; cp "$SS/bin"/* "$SS2/bin/"
printf '#!/bin/sh\necho "kernel: Bluetooth: hci0: command 0x0c1a tx timeout"\nexit 0\n' \
    > "$SS2/bin/journalctl"; chmod +x "$SS2/bin/journalctl"
SRT=$(mktemp -d)
GTO=$(env PATH="$SS2/bin:$PATH" BT_MODE_STAMP="$SMS" BT_DESTDIR="$SRT" \
          BT_FORCE_INSTALL=1 BT_STATE="$SRT/none" ./install.sh --apply 2>&1)
[[ "$GTO" == *"ALREADY LOGGED AN HCI COMMAND TIMEOUT"* && "$GTO" == *"right-censored"* ]] \
    && ok "a forced install warns that it ends a stage-1 observation in progress" \
    || bad "the right-censoring warning did not fire with a timeout in the journal"

# The open-trial guard, which deliberately lives OUTSIDE the experiment branch:
# in mitigation mode — the default, and the mode in which bt-trial-auto opens a
# trial every boot — the first version of this guard warned about nothing.
SRT2=$(mktemp -d); mkdir -p "$SRT2/state"
printf 'start=1786700000\nbuild=stock\nn=2\n' > "$SRT2/state/current"
GTR=$(env PATH="$SS/bin:$PATH" BT_MODE_STAMP=/nonexistent/mode BT_DESTDIR="$SRT2" \
          BT_STATE="$SRT2/state" ./install.sh --apply 2>&1)
[[ "$GTR" == *"A TRIAL IS OPEN"* && "$GTR" == *"build=stock"* ]] \
    && ok "install.sh --apply warns that it perturbs an open trial, in any mode" \
    || bad "the open-trial guard did not fire on --apply"

# ── and the whole section touched nothing real ───────────────────────────
[[ "$(real_install_state)" == "$REAL_BEFORE" ]] \
    && ok "no staged install changed anything under the real /usr/local or /etc" \
    || bad "SEAM LEAKED: a staged install wrote outside its BT_DESTDIR"

# THE INVARIANT: this file runs install.sh --apply only through the helpers.
# Enumerating call sites is what failed twice before, so the check is that
# there are none to enumerate — matched positively on `--apply`, and counted so
# that a pattern which stops matching reads as a zero rather than as a tick.
# Joined across continuations first: every invocation here sets BT_DESTDIR on
# a line above the one naming the script, and a line-by-line scan sees the two
# halves separately — reporting each correctly-staged call as a leak.
SLOOSE=$(awk '{ while (/\\$/ && (getline nxt) > 0) { sub(/\\$/, "", $0); $0 = $0 nxt } print }' "$0" \
         | grep -nE '^[^#]*\./(install|uninstall)\.sh --apply' \
         | grep -v 'BT_DESTDIR')
SAPPLY=$(grep -cE '\./(install|uninstall)\.sh --apply' "$0")
if [[ -z "$SLOOSE" ]] && (( ${SAPPLY:-0} >= 4 )); then
    ok "all $SAPPLY install --apply invocations set BT_DESTDIR to a staging root"
else
    bad "install.sh --apply invoked without a staging root:"
    bad "  $(head -1 <<<"$SLOOSE")"
fi

rm -rf "$SR" "$SS" "$SS2" "$SRG" "$SRT" "$SRT2" "$SMS"

echo
echo "bt-context — what sits next to a failure that nothing here explains"
echo "──────────────────────────────────────────────────────────────────────"
#
# The tool exists to surface what is NOT understood near a controller failure —
# so its value is the unclassified set, and an empty unclassified set is
# indistinguishable from a tool that classified nothing. Both ends are asserted.
BCX=tests/journal/context-anchors
BCOUT=$(BT_JOURNAL_FIXTURE="$BCX" tools/bt-context -b 0 2>&1)

# The normaliser collapses PIDs, numbers and addresses so that repetitions of
# one shape count as one candidate rather than as many.
[[ "$BCOUT" == *"<MAC>"* && "$BCOUT" != *"AA:BB:CC:00:00:01"* ]] \
    && ok "an address in an unclassified line is redacted before it is shown" \
    || bad "bt-context printed a raw address in its summary"
BCF=$(BT_JOURNAL_FIXTURE="$BCX" tools/bt-context -b 0 --full -C 2 2>&1)
[[ "$BCF" == *"══ first HCI command timeout"* ]] \
   && [[ "$BCF" != *"AA:BB:CC:00:00:01"* ]] \
    && ok "--full prints the raw window per anchor, with addresses redacted" \
    || bad "--full did not print a redacted window"

BCC=$(BT_JOURNAL_FIXTURE=tests/journal/context-clean tools/bt-context -b 0 2>&1); bccrc=$?
(( bccrc == 0 )) && [[ "$BCC" == *"records no controller failure"* ]] \
    && ok "a boot with no failure is reported as such, and exits 0" \
    || bad "a clean boot was not distinguished from a failure (rc=$bccrc)"

BCN=$(BT_JOURNAL_FIXTURE=tests/journal/nonexistent tools/bt-context -b 0 2>&1); bcnrc=$?
(( bcnrc == 1 )) && [[ "$BCN" == *"no journal for boot"* ]] \
    && ok "an empty journal is an error, not a boot with nothing wrong" \
    || bad "a missing journal was not refused (rc=$bcnrc)"

BT_JOURNAL_FIXTURE="$BCX" tools/bt-context --bogus >/dev/null 2>&1
(( $? != 0 )) && ok "bt-context rejects an unknown argument" \
              || bad "bt-context accepted an unknown argument"
BCH=$(tools/bt-context --help 2>&1); bchrc=$?
(( bchrc == 0 )) && [[ -n "$BCH" ]] \
    && ok "bt-context --help prints its own usage" \
    || bad "bt-context --help failed (rc=$bchrc)"

# bt-dyndbg has its own section above, which covers the three verbs and the
# per-packet warning. The one path it does not reach is an unknown verb, which
# must print the usage rather than silently doing nothing to a measurement
# decision.
BDD=$(mktemp -d); BDCTL="$BDD/control"
printf 'drivers/bluetooth/btusb.c:100 [btusb]foo =_ "x"\n' > "$BDCTL"
BDU=$(BT_DYNDBG_CTL="$BDCTL" bin/bt-dyndbg frobnicate 2>&1)
[[ "$BDU" == *"bt-dyndbg"* ]] \
    && ok "bt-dyndbg prints its usage for an unknown verb instead of acting" \
    || bad "bt-dyndbg said nothing for an unknown verb"
rm -rf "$BDD"

echo
echo "sanitize-logs — the gate between a kernel log and a public repo"
echo "──────────────────────────────────────────────────────────────"
#
# WHY THIS IS TESTED AT ALL, AND WHY IT IS FIRST AMONG THE UNTESTED.
#
# It is a pure file-to-file text transform — the single most unit-testable
# thing in this repository — and it had ZERO coverage. It is also the highest
# consequence: a Wi-Fi BSSID in a published kernel log is indexed by public
# geolocation databases, so a miss reveals where the machine physically is.
# The repository already has one instance on record — 20 unsanitised addresses
# reached a public commit on 2026-08-12, because the underscore form was
# unknown to both the substituter AND the verification that was supposed to
# catch it.
#
# Simply trying to write these tests found that the tool DOES NOT RUN on the
# default awk of most Linux distributions.

SAN=tests/sanitize-invariants.log
SANOUT=$(mktemp)

# Does this awk implement ERE intervals on groups? Ask the same way the tool
# does, including the negative probe — a positive-only check is answered
# correctly by accident on mawk, which is the trap the tool's gate documents.
awk_intervals_ok=1
echo "00:11:22:33:44:55:66:77" | awk '{exit !(match($0, /[0-9a-fA-F]{2}([:_-][0-9a-fA-F]{2}){5,}/) && RLENGTH == 23)}' 2>/dev/null || awk_intervals_ok=0
echo "11:22" | awk '{exit (match($0, /[0-9a-fA-F]{2}([:_-][0-9a-fA-F]{2}){5,}/) != 0)}' 2>/dev/null || awk_intervals_ok=0

if (( awk_intervals_ok )); then
    # The engine can express the patterns, so assert the redaction itself.
    san_ran=0
    if tools/sanitize-logs.sh "$SAN" "$SANOUT" >/dev/null 2>&1 && [[ -s "$SANOUT" ]]; then
        ok "sanitize-logs runs and self-verifies on a capable awk"
        san_ran=1
    else
        bad "sanitize-logs failed on an awk that passes its own gate"
        bad "  (its own verification refused — a redaction pattern is incomplete)"
    fi
fi

# The property assertions run only if there IS an output file. Asserting
# "the wlan address does not appear" against an EMPTY file passes trivially,
# and asserting "127.0.0.1 is preserved" against it fails for a reason that has
# nothing to do with the loopback address. Both were observed while
# mutation-testing this section: re-introducing the 2026-08-12 underscore
# defect produced three cascading failures that named the wrong things, and
# buried the one line that named the right one.
if (( awk_intervals_ok )) && (( san_ran )); then
    # PROPERTIES, not a golden file. Placeholder numbering is an implementation
    # detail that may legitimately change; "no real address survives" may not.
    # Every value below is drawn from the placeholder space devtools/repo-scan
    # already allows (11:11:11, de:ad:be, 00:11:22, the nil UUID, the broadcast
    # address). A fixture for a redaction tool must LOOK like the data it
    # redacts, and the first draft of this file used realistic-but-arbitrary
    # addresses — which repo-scan then refused to publish, correctly. Choosing
    # the documented placeholders keeps the fixture both realistic in form and
    # publishable, instead of widening the gate to admit the test.
    for form in '11:11:11:22:33:44' 'de_ad_be_ef_00_11' '00-11-22-33-44-55' \
                '00000000-0000-0000-0000-000000000000' '255.255.255.255'; do
        n=$(grep -c -- "$form" "$SANOUT" 2>/dev/null)
        (( ${n:-0} == 0 )) && ok "redacted: $form" \
                           || bad "SURVIVED sanitisation: $form"
    done

    # Kept deliberately: they identify no one and removing them destroys the
    # meaning of the line.
    for keep in '127.0.0.1' '0.0.0.0'; do
        n=$(grep -c -- "$keep" "$SANOUT" 2>/dev/null)
        (( ${n:-0} > 0 )) && ok "preserved: $keep" || bad "wrongly redacted: $keep"
    done

    # Determinism: the same address must map to the same placeholder, or
    # cross-references inside the log stop being followable.
    first=$(grep -m1 -oE 'AA:BB:CC:00:00:[0-9]{2}' "$SANOUT")
    n=$(grep -c -- "$first" "$SANOUT" 2>/dev/null)
    (( ${n:-0} >= 2 )) && ok "the same address maps to the same placeholder" \
                       || bad "placeholder not stable across occurrences"

    # `11:22` is two hex pairs, not an address. Replacing it would corrupt
    # ordinary log text — the over-matching failure mode of a degraded engine.
    n=$(grep -c 'version 11:22 is not an address' "$SANOUT" 2>/dev/null)
    (( ${n:-0} == 1 )) && ok "a short hex run is left alone" \
                       || bad "a non-address hex run was replaced"
else
    # THE ENGINE CANNOT EXPRESS THE PATTERNS. The only thing that matters then
    # is that the tool REFUSES. Silently producing a half-redacted file is the
    # outcome with real-world consequences, so that is what is asserted.
    tools/sanitize-logs.sh "$SAN" "$SANOUT" >/dev/null 2>&1
    rc=$?
    if (( rc != 0 )); then
        ok "sanitize-logs refuses on an awk that cannot express its patterns"
    else
        bad "sanitize-logs RAN on an incapable awk — output may be half-redacted"
    fi
    if [[ ! -s "$SANOUT" ]]; then
        ok "a refused run writes no output file"
    else
        bad "a refused run left a partially sanitised file behind"
    fi
    echo "  · redaction assertions SKIPPED: this awk lacks ERE intervals on groups"
    echo "    (install gawk to run them; mawk 1.3.4 is not sufficient)"
fi

tools/sanitize-logs.sh /nonexistent/input.log >/dev/null 2>&1
(( $? != 0 )) && ok "sanitize-logs refuses an unreadable input" \
              || bad "sanitize-logs accepted an unreadable input"

tools/sanitize-logs.sh -i >/dev/null 2>&1
(( $? != 0 )) && ok "sanitize-logs -i with no files is a usage error" \
              || bad "sanitize-logs -i accepted an empty file list"

rm -f "$SANOUT"

echo

echo
echo "the publish gates, driven over scratch repositories"
echo "──────────────────────────────────────────────────────────────"
#
# repo-scan and repo-validate guard every commit, and until now the suite had
# only ever seen them PASS — on this repository, which is kept clean precisely
# because they run. A gate that has never been observed to go red is the
# "printed a tick" failure this file's own header warns about, applied to the
# gate itself. So: scratch repositories, one clean and several deserving
# refusal, each planted with a specific class of leak the scanner claims to
# catch.
#
# The planted MAC uses a prefix OUTSIDE the placeholder allowlist
# (aa:bb:cc, 11:11:11, 00:11:22, de:ad:be, …). It is assembled from fragments
# so this test file itself stays clean under the very scan it is testing —
# the same trick repo-scan uses for its own AI-attribution patterns.
SCRATCH=$(mktemp -d)
scratch_repo() {   # <dir> ; creates an empty repo with an identity
    git -C "$1" init -q 2>/dev/null
    git -C "$1" config user.email test@example.com
    git -C "$1" config user.name test
}

# ── the three refusals that stand between a kernel log and a public repo ─
#
# The substituter is tested above against every representation. These test what
# happens when it is WRONG, which is the case that matters: a Wi-Fi BSSID in a
# published kernel log is indexed by public geolocation databases, so an
# under-redaction reveals where this machine physically is. The verifier is the
# only thing that notices, and until now it had never run.
#
# An under-redacting substituter cannot be produced by feeding odd input — the
# real one handles every form. So awk itself is replaced by a PASS-THROUGH that
# still answers the capability probe correctly. That is exactly the failure the
# verifier exists for: a substituter that runs, exits 0, and quietly changes
# nothing.
SANW=$(mktemp -d); mkdir -p "$SANW/bin"
cat > "$SANW/bin/awk" <<'SANAWK'
#!/bin/sh
# Discriminated by whether awk was given a FILE. The capability probes read one
# line from a PIPE and communicate only through their exit status, so they are
# deferred to the real awk — a probe this stub failed would exercise the
# capability refusal instead of the verifier. The substituter is the only
# invocation with a file operand, and for that one the stub copies the input
# through untouched.
#
# Matching on the program text was the first attempt and it did not work: the
# substituter contains the word `match` too, so the stub deferred everything to
# the real awk and the run came out perfectly sanitised.
last=""
for a in "$@"; do last="$a"; done
[ -f "$last" ] && exec cat "$last"
exec /usr/bin/awk "$@"
SANAWK
chmod +x "$SANW/bin/awk"
SANPASS="$SANW/out.log"
printf 'kernel: wlan0: authenticate with 00:11:22:33:44:55\n' > "$SANW/in.log"
SANPOUT=$(PATH="$SANW/bin:$PATH" tools/sanitize-logs.sh "$SANW/in.log" "$SANPASS" 2>&1); sanprc=$?
(( sanprc == 1 )) && [[ "$SANPOUT" == *"unsanitised MAC-like strings remain"* ]] \
    && ok "a substituter that silently changes nothing is caught by the verifier" \
    || bad "an under-redacting substituter was not refused (rc=$sanprc)"
[[ ! -e "$SANPASS" ]] && [[ "$SANPOUT" == *"left untouched"* ]] \
    && ok "a failed verification writes no output at all, and says so" \
    || bad "a half-sanitised file was written despite verification failing"

printf 'dev 0000180a-0000-1000-8000-00805f9b34fb\n' > "$SANW/in.log"
SANU=$(PATH="$SANW/bin:$PATH" tools/sanitize-logs.sh "$SANW/in.log" "$SANW/u.log" 2>&1)
[[ "$SANU" == *"raw UUIDs remain"* ]] \
    && ok "the verifier catches a UUID the substituter missed" \
    || bad "a raw UUID survived verification"

# RFC 5737 TEST-NET-1, which repo-scan allowlists as documentation space. A
# routable-looking address here would be committed to a repository that
# publishes its logs, and repo-scan refused exactly that when this fixture
# first used a 192.168 address. The scanner is the last line of defence and
# gets to win; the fixture changes, not the allowlist.
printf 'connected to 192.0.2.31 port 22\n' > "$SANW/in.log"
SANI=$(PATH="$SANW/bin:$PATH" tools/sanitize-logs.sh "$SANW/in.log" "$SANW/i.log" 2>&1)
[[ "$SANI" == *"raw IPv4 addresses remain"* ]] \
    && ok "the verifier catches an IPv4 address the substituter missed" \
    || bad "a raw IPv4 address survived verification"

# THE CAPABILITY REFUSAL. mawk 1.3.4 mishandles ERE intervals on groups, which
# would redact wrongly in BOTH directions — short hex runs replaced as if they
# were addresses, real addresses only partly replaced — and neither is visible
# in the output. Refusing is the only safe answer, so it has to be tested.
cat > "$SANW/bin/awk" <<'SANBAD'
#!/bin/sh
exit 1
SANBAD
chmod +x "$SANW/bin/awk"
SANC=$(PATH="$SANW/bin:$PATH" tools/sanitize-logs.sh "$SANW/in.log" "$SANW/c.log" 2>&1); sancrc=$?
(( sancrc == 1 )) && [[ "$SANC" == *"mishandles ERE intervals on groups"* \
                     && "$SANC" == *"Install gawk"* ]] \
    && ok "an awk that fails the interval probe is refused, not used" \
    || bad "sanitize-logs ran on an awk it could not trust (rc=$sancrc)"

# ── -i, the batch mode that exists to keep the call statically analysable ─
SANB=$(mktemp -d)
printf 'a 00:11:22:33:44:55\n' > "$SANB/one.log"
printf 'b AA:BB:CC:DD:EE:FF\n' > "$SANB/two.log"
tools/sanitize-logs.sh -i "$SANB/one.log" "$SANB/two.log" >/dev/null 2>&1; sanbrc=$?
# Asserted on the ORIGINAL addresses, not on MAC SHAPE: the substituter
# replaces with documented placeholders in the reserved AA:BB:CC space, which
# are themselves MAC-shaped. A shape check calls a correct sanitisation a
# failure — it did, on the first run of this assertion.
(( sanbrc == 0 )) \
   && ! grep -q '00:11:22:33:44:55' "$SANB/one.log" \
   && ! grep -qi 'AA:BB:CC:DD:EE:FF' "$SANB/two.log" \
   && [[ -s "$SANB/one.log" && -s "$SANB/two.log" ]] \
    && ok "-i sanitises every file it is given, in place" \
    || bad "batch mode left an original address behind (rc=$sanbrc)"

tools/sanitize-logs.sh -i "$SANB/nonexistent.log" >/dev/null 2>&1
(( $? != 0 )) && ok "-i reports a file it cannot read instead of skipping it silently" \
              || bad "batch mode returned 0 for an unreadable file"
tools/sanitize-logs.sh -i >/dev/null 2>&1
(( $? != 0 )) && ok "-i with no files is a usage error, not a no-op success" \
              || bad "batch mode accepted an empty file list"
rm -rf "$SANW" "$SANB"

_m1='fe:ed'; _m2='fa:ce'; _m3='ca:fe'
LEAK_MAC="$_m1:$_m2:$_m3"

mkdir -p "$SCRATCH/leak"; scratch_repo "$SCRATCH/leak"
printf 'kernel: wlan0: authenticate with %s\n' "$LEAK_MAC" > "$SCRATCH/leak/boot.log"
git -C "$SCRATCH/leak" add -A
devtools/repo-scan "$SCRATCH/leak" >/dev/null 2>&1
(( $? != 0 )) && ok "repo-scan refuses a staged real MAC" \
              || bad "repo-scan PASSED a repo with a real MAC staged"

mkdir -p "$SCRATCH/ip"; scratch_repo "$SCRATCH/ip"
# Assembled from fragments, like the MAC above: a private-range address the
# scanner must flag (internal topology is disclosure too). The first version
# planted a TEST-NET address literally — and the full-tree gate caught this
# very file, which settled the question of whether RFC 5737 space should be
# allowlisted (it now is, in repo-scan, for the example.com reason) and what a
# refusal fixture must therefore use instead.
_i1='10.99'; _i2='88.77'
printf 'dhcp: bound %s\n' "$_i1.$_i2" > "$SCRATCH/ip/net.log"
git -C "$SCRATCH/ip" add -A
devtools/repo-scan "$SCRATCH/ip" >/dev/null 2>&1
(( $? != 0 )) && ok "repo-scan refuses a staged IPv4 address" \
              || bad "repo-scan PASSED a repo with an IPv4 address staged"

mkdir -p "$SCRATCH/clean"; scratch_repo "$SCRATCH/clean"
printf 'placeholder device 11:11:11:22:33:44 and loopback 127.0.0.1\n' > "$SCRATCH/clean/ok.log"
git -C "$SCRATCH/clean" add -A
devtools/repo-scan "$SCRATCH/clean" >/dev/null 2>&1
(( $? == 0 )) && ok "repo-scan passes documented placeholders" \
              || bad "repo-scan refused the placeholder forms it documents"

# The REMOVAL of a leak must be commit-able: default mode scans added lines
# only, because blocking the remediating commit is the one thing this gate
# must never do. Commit the leak, then stage its deletion.
git -C "$SCRATCH/leak" -c commit.gpgsign=false commit -qm x
git -C "$SCRATCH/leak" rm -q boot.log
devtools/repo-scan "$SCRATCH/leak" >/dev/null 2>&1
(( $? == 0 )) && ok "repo-scan does not block the commit that REMOVES a leak" \
              || bad "repo-scan blocked a remediation — the failure it exists to avoid"

# repo-validate: a planted bash syntax error must fail the whole validation.
mkdir -p "$SCRATCH/badsh"; scratch_repo "$SCRATCH/badsh"
printf '#!/bin/bash\nif true; then echo unclosed\n' > "$SCRATCH/badsh/broken.sh"
git -C "$SCRATCH/badsh" add -A
devtools/repo-validate "$SCRATCH/badsh" >/dev/null 2>&1
(( $? != 0 )) && ok "repo-validate fails on a planted bash syntax error" \
              || bad "repo-validate PASSED a repo with unparseable shell"

# ── EVERY VALIDATOR, AGAINST A FILE OF ITS OWN KIND ──────────────────────
#
# repo-validate dispatches by extension: units to systemd-analyze, rules to
# udevadm, .json to jq, .py to python3, .awk to awk -f. Only the shell branch
# had ever run, because the scratch repos only ever contained shell — so five
# validators were shipped untested, and a validator that silently matches
# nothing is the empty-input failure this project has now met six times.
#
# Each is driven twice: a good file must be reported checked, a broken one must
# FAIL the whole run. Each also skips cleanly when its tool is absent, which is
# the normal state of a minimal container and must not read as a pass.
mkdir -p "$SCRATCH/kinds"; scratch_repo "$SCRATCH/kinds"
printf '[Unit]\nDescription=x\n\n[Service]\nExecStart=/bin/true\n' > "$SCRATCH/kinds/a.service"
printf 'ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="13d3"\n' > "$SCRATCH/kinds/a.rules"
printf '{"a": 1}\n' > "$SCRATCH/kinds/a.json"
printf 'import sys\nprint(sys.argv)\n' > "$SCRATCH/kinds/a.py"
printf '{ print $1 }\n' > "$SCRATCH/kinds/a.awk"
printf '#!/bin/bash\necho ok\n' > "$SCRATCH/kinds/a.sh"
git -C "$SCRATCH/kinds" add -A
KOUT=$(devtools/repo-validate "$SCRATCH/kinds" 2>&1); krc=$?
# Each validator either CHECKED its file or SKIPPED for a named missing tool.
# Both are acceptable answers; silence about the file is not, because that is
# what a validator matching nothing looks like from outside.
kmiss=""
for kf in a.service a.rules a.json a.py a.awk a.sh; do
    grep -qE "(✓|•).*$kf" <<<"$KOUT" || kmiss="$kmiss; $kf"
done
(( krc == 0 )) && [[ -z "$kmiss" ]] \
    && ok "repo-validate reaches all 6 file kinds — checked or explicitly skipped" \
    || bad "repo-validate said nothing about (rc=$krc):$kmiss"

# And the failure direction, per kind, for the validators whose tools exist
# here. A validator that cannot fail is the same as no validator.
kbad=0; kran=0
kcheck() {   # <name> <content> <tool>
    command -v "$3" >/dev/null 2>&1 || return 0
    kran=$((kran + 1))
    local d="$SCRATCH/bad-$1"; mkdir -p "$d"; scratch_repo "$d"
    printf '%s' "$2" > "$d/broken.$1"
    git -C "$d" add -A
    devtools/repo-validate "$d" >/dev/null 2>&1 && kbad=$((kbad + 1))
}
kcheck json '{"a": ' jq
kcheck py   'def (' python3
kcheck awk  'BEGIN { print "unterminated' awk
(( kbad == 0 )) && (( kran >= 2 )) \
    && ok "each of $kran validators present here FAILS its own broken file" \
    || bad "$kbad of $kran validator(s) passed a file that does not parse"

# ── an empty enumeration is INCONCLUSIVE, not a pass ─────────────────────
#
# This is the distinction the rest of this suite was rebuilt around, and it
# lives here first: ENUMERATED == 0 means the question was never asked, and a
# tool that answers "all checks passed" to a question it never asked is worse
# than one that crashes.
mkdir -p "$SCRATCH/empty"; scratch_repo "$SCRATCH/empty"
EOUT=$(devtools/repo-validate "$SCRATCH/empty" 2>&1); erc=$?
(( erc == 1 )) && [[ "$EOUT" == *"VALIDATION INCONCLUSIVE"* && "$EOUT" == *"enumerated no files"* ]] \
    && ok "an empty repository is INCONCLUSIVE (exit 1), never 'all checks passed'" \
    || bad "empty-repo validation returned rc=$erc: $(head -1 <<<"$EOUT")"

# CHECKED == 0 with files enumerated is a different answer, and it is fine.
mkdir -p "$SCRATCH/nocheck"; scratch_repo "$SCRATCH/nocheck"
printf 'just prose\n' > "$SCRATCH/nocheck/NOTES.md"
git -C "$SCRATCH/nocheck" add -A
NOUT=$(devtools/repo-validate "$SCRATCH/nocheck" 2>&1); nrc=$?
(( nrc == 0 )) && [[ "$NOUT" == *"no checkable files"* ]] \
    && ok "files enumerated but none checkable is a pass, and says which it is" \
    || bad "a prose-only repo was not distinguished from an empty one (rc=$nrc)"

# ── devtools/status: COMMITTED is not DEPLOYED ───────────────────────────
#
# The tool exists to keep one distinction visible, and states one contract:
# deployment drift is REPORTED but does NOT set the exit status, because it is
# a fact about the machine and not a defect in the commit. That contract cannot
# be checked against the real host — it needs an installation that has drifted,
# and manufacturing one on the investigation machine is the opposite of a
# read-only check. So: a scratch repository with a real local remote, and
# stubbed tools inside it.
#
# The pushed-ness question is asked of the REMOTE via ls-remote rather than of
# a tracking ref, which is what once produced a false all-clear from a ref that
# had since been pruned. A file:// remote answers it offline, so no network
# round trip enters the suite.
ST=$(mktemp -d)
git init -q --bare "$ST/remote.git"
mkdir -p "$ST/repo/tools"; scratch_repo "$ST/repo"
git -C "$ST/repo" remote add origin "$ST/remote.git"
printf 'seed\n' > "$ST/repo/README.md"
# A checkout that is AHEAD of what is installed — the state the tool was built
# to stop hiding behind "everything is pushed". Committed BEFORE the seed push,
# because an untracked tools/ is itself an uncommitted change and would make
# every case below report a dirty tree.
printf '#!/bin/sh\necho "  3 in sync, 1 drifted, 0 not installed"\n' > "$ST/repo/tools/bt-verify-install"
printf '#!/bin/sh\necho "  recorded mode        mitigation since 2026-08-10"\n' > "$ST/repo/tools/bt-mode"
printf '#!/bin/sh\necho "no trial open"\n' > "$ST/repo/tools/bt-trial"
chmod +x "$ST/repo/tools"/*
git -C "$ST/repo" add -A
git -C "$ST/repo" -c commit.gpgsign=false commit -qm seed
git -C "$ST/repo" push -q origin HEAD:refs/heads/"$(git -C "$ST/repo" rev-parse --abbrev-ref HEAD)"
mkdir -p "$ST/stub"; printf '#!/bin/sh\nexit 1\n' > "$ST/stub/lsusb"; chmod +x "$ST/stub/lsusb"

st_run() { env PATH="$ST/stub:$PATH" BT_STATUS_REPO="$ST/repo" devtools/status 2>&1; }

STOUT=$(st_run); strc=$?
# THE CONTRACT. Clean, pushed, and the installed tooling has drifted — exit 0.
(( strc == 0 )) && [[ "$STOUT" == *"everything committed and pushed"* ]] \
    && ok "devtools/status exits 0 on a clean, pushed tree" \
    || bad "a clean pushed tree did not exit 0 (rc=$strc)"

[[ "$STOUT" == *"drifted"* && "$STOUT" == *"checkout is AHEAD of what is running"* ]] \
    && ok "deployment drift is reported alongside a clean repository verdict" \
    || bad "drift was not reported next to the committed/pushed answer"

# ...and reported WITHOUT changing the verdict. This is the assertion the tool
# was written for: for most of 2026-08-13 the checkout ran several fixes ahead
# of the installed tooling — including a bt-usbmon whose retention was known
# broken — while every report said "everything is pushed", which was true and
# not what anyone meant. Folding drift into the exit status would make the
# opposite error, failing a commit for the state of a machine.
[[ "$STOUT" == *"Deployment is reported above, separately"* ]] \
    && ok "drift does not set the exit status, and the report says so" \
    || bad "deployment drift changed the repository verdict"

# A dirty tree is a defect in the commit, and does set it.
printf 'uncommitted\n' > "$ST/repo/scratch.txt"
STDIRTY=$(st_run); stdrc=$?
(( stdrc == 1 )) && [[ "$STDIRTY" == *"uncommitted change(s)"* \
                    && "$STDIRTY" == *"NOT everything is committed and pushed"* ]] \
    && ok "devtools/status exits 1 on an uncommitted change" \
    || bad "a dirty tree did not exit 1 (rc=$stdrc)"
rm -f "$ST/repo/scratch.txt"

# Committed but not pushed is the other half, and the count matters: "ahead by
# N" is what tells someone whether they forgot one commit or a day's work.
printf 'more\n' >> "$ST/repo/README.md"
git -C "$ST/repo" add -A
git -C "$ST/repo" -c commit.gpgsign=false commit -qm second
STAHEAD=$(st_run); stahrc=$?
(( stahrc == 1 )) && [[ "$STAHEAD" == *"local is 1 commit(s) ahead"* ]] \
    && ok "devtools/status counts how far ahead of the remote the branch is" \
    || bad "an unpushed commit was not reported with its count (rc=$stahrc)"

# AND THE FALSE ALL-CLEAR IT WAS WRITTEN AGAINST. With the remote gone, the
# tool must say it could not confirm — not fall back to a tracking ref and
# report success. The tracking ref still exists here and still points at the
# old head, which is exactly the stale state that once answered "all pushed".
git -C "$ST/repo" remote set-url origin "$ST/no-such-remote.git"
STNOREM=$(st_run)
[[ "$STNOREM" == *"could not reach origin — cannot confirm"* \
   && "$STNOREM" != *"pushed"*"=="* ]] \
    && ok "an unreachable remote is reported as unconfirmed, never as pushed" \
    || bad "an unreachable remote produced a pushed verdict from a stale ref"
git -C "$ST/repo" remote set-url origin "$ST/remote.git"
git -C "$ST/repo" push -q origin HEAD 2>/dev/null

# The all-clear side of the machine section: nothing drifted, and the
# controller is on the bus. Asserted because the drift row above is only
# meaningful if the tool is capable of NOT printing it.
printf '#!/bin/sh\necho "  4 artifacts in sync; running system matches the checkout"\n' \
    > "$ST/repo/tools/bt-verify-install"
printf '#!/bin/sh\necho "Bus 003 Device 002: ID 13d3:3503 IMC Networks Bluetooth"\n' \
    > "$ST/stub/lsusb"
chmod +x "$ST/repo/tools/bt-verify-install" "$ST/stub/lsusb"
git -C "$ST/repo" add -A
git -C "$ST/repo" -c commit.gpgsign=false commit -qm insync
git -C "$ST/repo" push -q origin HEAD 2>/dev/null
STSYNC=$(st_run); stsrc=$?
(( stsrc == 0 )) && [[ "$STSYNC" == *"running system matches the checkout"* \
                    && "$STSYNC" != *"checkout is AHEAD"* \
                    && "$STSYNC" == *"controller"*"enumerated"* ]] \
    && ok "devtools/status reports an in-sync installation and a present controller" \
    || bad "the no-drift path did not report cleanly (rc=$stsrc)"

# A remote branch carrying work that is not on HEAD. Worth surfacing: this
# repository has run several parallel branches at once, and a rebase attempt
# that nobody merged is exactly the thing a status check should mention rather
# than leave to memory.
git -C "$ST/repo" checkout -q -b sidebranch
printf 'side work\n' > "$ST/repo/side.txt"
git -C "$ST/repo" add -A
git -C "$ST/repo" -c commit.gpgsign=false commit -qm side
git -C "$ST/repo" push -q origin sidebranch 2>/dev/null
git -C "$ST/repo" checkout -q -
git -C "$ST/repo" fetch -q origin 2>/dev/null
STUNMERGED=$(st_run)
[[ "$STUNMERGED" == *"carrying unmerged work"* && "$STUNMERGED" == *"sidebranch"* ]] \
    && ok "devtools/status names remote branches carrying unmerged work" \
    || bad "an unmerged remote branch was not surfaced"
rm -rf "$ST"

# ── repo-save, the gate that actually commits ────────────────────────────
#
# It stages, validates, scans, scans the MESSAGE, commits, and verifies the
# remote. Everything below runs with --no-push against a scratch repo, so
# nothing here can reach a remote — the assertion after the group checks that.
#
# Its message scan exists because repo-scan reads files and diffs, and a
# commit-message trailer lives in neither: the single most likely vector for
# the thing being screened for sat outside the screen entirely.
mkdir -p "$SCRATCH/save"; scratch_repo "$SCRATCH/save"
printf 'placeholder 11:11:11:22:33:44\n' > "$SCRATCH/save/notes.log"

save() { devtools/repo-save "$SCRATCH/save" "$@" --no-push 2>&1; }

# THE RULE THIS REPOSITORY IS HELD TO, asserted rather than assumed. Assembled
# from fragments for the same reason repo-scan and repo-save assemble theirs:
# so this file stays clean under the scan it is testing.
_ai='cla'; _ai+='ude'
SVAI=$(save "fix the thing

Co-Authored-By: $_ai <noreply@example.com>"); svairc=$?
(( svairc != 0 )) && [[ "$SVAI" == *"AI attribution"* ]] \
    && ok "repo-save refuses a commit message carrying an attribution trailer" \
    || bad "an attribution trailer was committed (rc=$svairc)"

svn=$(git -C "$SCRATCH/save" rev-list --count HEAD 2>/dev/null || echo 0)
(( ${svn:-0} == 0 )) \
    && ok "the refused message left no commit behind" \
    || bad "repo-save reported a refusal and committed anyway"

# A real address in a message would once have taken the "clean" branch: the
# check was `| grep -qv`, and under pipefail that pipeline exits non-zero
# exactly when it MATCHES, because grep leaves at the first hit and tr dies of
# SIGPIPE. Twenty addresses reached public commits once already by a different
# mechanism; this would have been the same outcome.
_s1='fe:ed'; _s2='fa:ce'; _s3='ca:fe'
SVMAC=$(save "seen on $_s1:$_s2:$_s3 during the trial"); svmacrc=$?
(( svmacrc != 0 )) && [[ "$SVMAC" == *"real MAC"* ]] \
    && ok "repo-save refuses a real MAC in the commit message" \
    || bad "a real address in a commit message was committed (rc=$svmacrc)"

# Unknown flags used to BECOME the commit message: `repo-save . --amend 'fix'`
# silently dropped --amend and created a new commit instead of amending.
devtools/repo-save "$SCRATCH/save" --amend "fix" --no-push >/dev/null 2>&1
(( $? != 0 )) && ok "repo-save rejects an unknown flag instead of committing it" \
              || bad "an unknown flag was accepted — it becomes the message"

devtools/repo-save "$SCRATCH/save" "one" "two" --no-push >/dev/null 2>&1
(( $? != 0 )) && ok "repo-save rejects a second message argument" \
              || bad "two message arguments were accepted"

# -F from a STREAM. Reading the source twice — once to scan, once for
# `git commit -F` — produced an empty commit message when the source was a pipe
# or /dev/stdin, because the first read consumed it. It is snapshotted now.
SVPIPE=$(printf 'message from a stream\n\nbody line\n' \
         | devtools/repo-save "$SCRATCH/save" -F /dev/stdin --no-push 2>&1); svprc=$?
svsubj=$(git -C "$SCRATCH/save" log -1 --format=%s 2>/dev/null)
(( svprc == 0 )) && [[ "$svsubj" == "message from a stream" ]] \
    && ok "repo-save -F reads a streamed message once and commits it intact" \
    || bad "streamed message came through as '$svsubj' (rc=$svprc)"

# Staging happens FIRST, so a brand-new file is inside the validation and the
# scan. Staging afterwards meant a commit's new files were never syntax
# checked — including the commit that added these very scripts.
printf 'kernel: wlan0: authenticate with %s\n' "$LEAK_MAC" > "$SCRATCH/save/new-leak.log"
SVNEW=$(save "add a file that has never been staged"); svnewrc=$?
(( svnewrc != 0 )) && [[ "$SVNEW" == *"scan failed"* ]] \
    && ok "repo-save stages before scanning, so a brand-new file is screened" \
    || bad "an unstaged new file bypassed the scan (rc=$svnewrc)"
rm -f "$SCRATCH/save/new-leak.log"

SVNONE=$(save "nothing changed since the last commit"); svnrc=$?
(( svnrc == 0 )) && [[ "$SVNONE" == *"nothing to commit"* ]] \
    && ok "repo-save exits 0 with nothing staged rather than making an empty commit" \
    || bad "an empty tree did not report 'nothing to commit' (rc=$svnrc)"

devtools/repo-save "$SCRATCH/not-a-repo" "msg" --no-push >/dev/null 2>&1
(( $? != 0 )) && ok "repo-save refuses a directory that is not a git repo" \
              || bad "repo-save accepted a non-repository"

# Nothing above may have configured or contacted a remote. --no-push is the
# only thing standing between this block and a push from a test run.
[[ -z "$(git -C "$SCRATCH/save" remote 2>/dev/null)" ]] \
    && ok "the repo-save scratch repo has no remote — nothing could be pushed" \
    || bad "a remote exists on the scratch repo used to test repo-save"

rm -rf "$SCRATCH"

echo
echo "the tests may not write to the real evidence tree"
echo "──────────────────────────────────────────────────────────────"

# THE INVARIANT: this file invokes bt-trial only through trial().
#
# bt-trial runs the real bt-incident on a failed trial, and bt-incident resolves
# its destination from BT_EVIDENCE_REPO — a different variable from the BT_REPO
# the tests were redirecting. One invocation here was missing the PATH stub, so
# once the machine's own controller died and `ok` closures began reclassifying
# to `failed`, every run of this suite deposited a fabricated incident directory
# into evidence/sessions/. Ten accumulated beside one genuine collection and
# were indistinguishable from it without reading timestamps.
#
# Enumerating the variables at each call site is what failed. The check is that
# there are no call sites to enumerate.
# Matched POSITIVELY on the lifecycle verbs, not by subtracting exceptions. The
# subtractive version needed a new exclusion for `report`, for `cp`, and for its
# own grep line, and each exclusion is a hole someone can park a real call in.
# `report` is genuinely safe — read-only, never reaches the failure branch — so
# it is simply not in the list.
LOOSE=$(grep -nE 'tools/bt-trial +(autostart|start|ok|hang|abort|step)\b' "$0" \
        | grep -v "^[0-9]*:[[:space:]]*#")
# Counted, so a pattern that stops matching reads as 0 rather than as a tick.
TRIALCALLS=$(grep -cE 'tools/bt-trial +(autostart|start|ok|hang|abort|step|report)\b' "$0")
if [[ -z "$LOOSE" ]] && (( ${TRIALCALLS:-0} > 0 )); then
    ok "all $TRIALCALLS bt-trial invocations go through the sandboxed trial() helper"
else
    bad "bt-trial invoked outside trial() — may write to the real evidence tree:"
    while IFS= read -r l; do echo "        $l"; done <<<"$LOOSE"
fi

# And the structural check is only worth what the observation behind it is
# worth, so observe it directly: the real evidence tree must hold exactly what
# it held before this suite started. Counted at the top of the file, compared
# here, after every trial in it has opened and closed.
SESSIONS_AFTER=$(ls -1 evidence/sessions 2>/dev/null | wc -l)
if [[ "$SESSIONS_AFTER" == "$SESSIONS_BEFORE" ]]; then
    ok "evidence/sessions/ unchanged by the test run ($SESSIONS_AFTER entries)"
else
    bad "the test run changed evidence/sessions/: $SESSIONS_BEFORE -> $SESSIONS_AFTER"
    bad "  a test wrote into the real evidence tree; the newest entries are fabricated"
fi

# The same observation for the trial state, closing the window the startup
# refusal leaves open. Reports what it compared, so a footprint function that
# stops seeing anything reads as `open=no rows=0` rather than as a tick.
TRIAL_FOOTPRINT_AFTER=$(real_trial_footprint)
if [[ "$TRIAL_FOOTPRINT_AFTER" == "$TRIAL_FOOTPRINT_BEFORE" ]]; then
    ok "real trial state unchanged by the test run ($(tr '\n' ' ' <<<"$TRIAL_FOOTPRINT_AFTER"))"
else
    bad "the test run changed the REAL trial state:"
    bad "  before: $(tr '\n' ' ' <<<"$TRIAL_FOOTPRINT_BEFORE")"
    bad "  after:  $(tr '\n' ' ' <<<"$TRIAL_FOOTPRINT_AFTER")"
    bad "  a live trial was opened, closed or recorded by this suite —"
    bad "  the affected results row is fabricated by test stubs, not measured"
fi

echo
if (( fail )); then
    echo "FAILED: $fail of $((pass + fail)) invariants"
    exit 1
fi
echo "all $pass invariants hold"
