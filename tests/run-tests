#!/bin/bash
# run-tests — assert the analysis invariants, rather than trusting the comments.
#
# WHY THIS EXISTS. An external review of this repository found that its prose
# had run ahead of its code: `bt-phase`'s header stated it used only exogenous
# timer-driven probes while the implementation kept probes 600 seconds apart and
# called that provenance. Every commit message described the intended behaviour
# correctly. Only reading the implementation found the gap.
#
# Comments cannot be executed. These can. Each test below encodes an invariant
# that was violated by a real, shipped version of a tool here, and each fixture
# is built so the OLD behaviour fails it:
#
#   sampling unit   a burst of timeout lines is one cluster, not many
#   boot locality   no interval may span a reboot
#   date arithmetic a gap across a month boundary must be positive and correct
#   provenance      a contaminated probe set must be REFUSED, not reported
#
# Usage: tests/run-tests

set -uo pipefail

cd "$(dirname "$0")/.." || exit 1
pass=0; fail=0

ok()   { echo "  ✓ $*"; pass=$((pass + 1)); }
bad()  { echo "  ✗ $*"; fail=$((fail + 1)); }

# Extract bt-phase's analysis body so it can be driven with a fixture instead of
# the live journal. Testing through journalctl would make these tests depend on
# the machine's history, which is the thing under investigation.
AWK=$(mktemp); trap 'rm -f "$AWK"' EXIT
python3 - "$AWK" <<'PY'
import re, sys, pathlib
s = pathlib.Path('tools/bt-phase').read_text()
m = re.search(r"awk -v igap=\"\$INCIDENT_GAP\" -v period=\"\$TIMER_PERIOD\" '(.*)' \"\$DATA\"\s*$", s, re.S)
if not m:
    sys.exit("could not extract analysis body from tools/bt-phase")
pathlib.Path(sys.argv[1]).write_text(m.group(1).replace("'\"'\"'", "'"))
PY
[[ -s "$AWK" ]] || { echo "FAILED to extract bt-phase analysis body"; exit 1; }

echo "bt-phase invariants"
echo "──────────────────────────────────────────────────────────────"

OUT=$(awk -v igap=600 -v period=900 -f "$AWK" tests/phase-invariants.data 2>&1)

# --- sampling unit ---------------------------------------------------------
# The fixture has five timeout lines: a burst of four inside 60 s in one boot,
# and one in another. A version counting lines reports 5 "failures", inflating n
# and destroying the independence the statistical caveat assumes.
lines=$(grep -oP 'timeout LINES\s+\K[0-9]+' <<<"$OUT")
inc=$(grep -oP 'timeout CLUSTERS\s+\K[0-9]+' <<<"$OUT")
[[ "$lines" == "5" ]] && ok "counts 5 timeout lines" || bad "expected 5 lines, got ${lines:-none}"
[[ "$inc"  == "2" ]] && ok "collapses them to 2 timeout clusters" || bad "expected 2 clusters, got ${inc:-none}"

# --- date arithmetic -------------------------------------------------------
# Boot -1's incident falls between probes at 23:15 on 31 July and 00:30 on
# 1 August: 4500 s. Day-of-month arithmetic makes that negative.
grep -q '4500.0s gap' <<<"$OUT" \
    && ok "computes a 4500s gap across a month boundary" \
    || bad "month-boundary gap wrong; got: $(grep -o '[0-9.]*s gap' <<<"$OUT" | tr '\n' ' ')"

# --- boot locality ---------------------------------------------------------
# Boot 0's probes are 900 s apart. If intervals could span boots, its incident
# would be placed in some other, larger gap.
grep -q 'boot 0 .*900.0s gap' <<<"$OUT" \
    && ok "keeps intervals within a single boot" \
    || bad "boot-0 interval not boot-local"

# --- both boundaries exogenous --------------------------------------------
# Only EXO records appear in the fixture, so any interval built from an ENDO
# record would be a construction error. Two incidents, two placements.
placed=$(grep -oP 'placed\s+\K[0-9]+' <<<"$OUT")
[[ "$placed" == "2" ]] && ok "places both clusters in exogenous gaps" \
    || bad "expected 2 placed, got ${placed:-none}"

# --- provenance refusal ----------------------------------------------------
# With the timer period claimed as 100000 s, the fixture's 900 s gaps are far
# too short to be timer-driven. The tool must refuse rather than report.
REF=$(awk -v igap=600 -v period=100000 -f "$AWK" tests/phase-invariants.data 2>&1)
grep -q 'SKIPPED — provenance check failed' <<<"$REF" \
    && ok "refuses to report when claimed provenance is impossible" \
    || bad "did not refuse on a contaminated probe set"

echo
echo "bt-capdiff matching"
echo "──────────────────────────────────────────────────────────────"

# The false-agreement case. Two records on one side, one on the other, all
# within tolerance. A matcher that asks "is there ANY counterpart within
# tolerance?" without consuming it reports zero unmatched in both directions and
# announces that the paths agree — while the multiplicity is 2 against 1.
FA=$(mktemp); FB=$(mktemp); OA=$(mktemp); OB=$(mktemp)
trap 'rm -f "$AWK" "$FA" "$FB" "$OA" "$OB"' EXIT

# The matcher lives in tools/lib/capdiff-match.awk and is used here exactly as
# bt-capdiff uses it. Testing the real file rather than a copy extracted from
# the caller means the test cannot pass against a matcher the tool no longer
# runs — which is precisely how the -f trap slipped through: an extracted copy
# worked in the test while the shipped invocation silently loaded nothing.
MATCH=tools/lib/capdiff-match.awk
[[ -r "$MATCH" ]] || bad "missing $MATCH"

printf '2026-08-12T12:00:00.100 > HCI Event: EVENT X\n2026-08-12T12:00:00.110 > HCI Event: EVENT X\n' > "$FA"
printf '2026-08-12T12:00:00.105 > HCI Event: EVENT X\n' > "$FB"
: > "$OA"; : > "$OB"

awk -f tools/lib/timestamp.awk -f "$MATCH" -v tol=0.5 -v outA="$OA" -v outB="$OB" "$FA" "$FB"

ua=$(wc -l < "$OA"); ub=$(wc -l < "$OB")
if [[ "$ua" == "1" && "$ub" == "0" ]]; then
    ok "2-against-1 leaves exactly one record unmatched (no false agreement)"
else
    bad "expected 1 unmatched in A and 0 in B; got $ua and $ub"
fi

# And the genuine-agreement case must still report zero, or the matcher would be
# useless in the direction that matters.
printf '2026-08-12T12:00:00.100 > HCI Event: EVENT X\n' > "$FA"
printf '2026-08-12T12:00:00.105 > HCI Event: EVENT X\n' > "$FB"
: > "$OA"; : > "$OB"
awk -f tools/lib/timestamp.awk -f "$MATCH" -v tol=0.5 -v outA="$OA" -v outB="$OB" "$FA" "$FB"
if [[ "$(wc -l < "$OA")" == "0" && "$(wc -l < "$OB")" == "0" ]]; then
    ok "1-against-1 within tolerance matches cleanly"
else
    bad "genuine agreement reported as a difference"
fi

# Shared timestamp arithmetic must survive a month boundary, which is the bug
# that survived in bt-trial after bt-phase was fixed in isolation.
printf '2026-08-31T23:59:59.000 > HCI Event: EVENT Y\n' > "$FA"
printf '2026-09-01T00:00:02.000 > HCI Event: EVENT Y\n' > "$FB"
: > "$OA"; : > "$OB"
awk -f tools/lib/timestamp.awk -f "$MATCH" -v tol=5 -v outA="$OA" -v outB="$OB" "$FA" "$FB"
if [[ "$(wc -l < "$OA")" == "0" && "$(wc -l < "$OB")" == "0" ]]; then
    ok "3s apart across a month boundary is within a 5s tolerance"
else
    bad "month-boundary arithmetic wrong: records 3s apart treated as unmatched"
fi

echo
echo "bt-trial report — schema invariants"
echo "──────────────────────────────────────────────────────────────"

# THE RULE: no consumer of results.tsv may address a column by position.
#
# Inserting trial_type has now caused two real defects in a file whose own
# comments state that rule: next_trial_no kept using $2 for build, and the SCO
# cross-tab kept using $5 for outcome — so every hang was counted as survived
# while the denominator table above it stayed correct.
#
# Grepping for "$5" would only test today's spelling of the bug. Permuting the
# header and asserting the report is byte-identical tests the invariant, and
# makes positional assumptions mechanically impossible instead of merely
# discouraged.
FIX=tests/trial-results.tsv
[[ -r "$FIX" ]] || bad "missing $FIX"

RD=$(mktemp -d); trap 'rm -rf "$AWK" "$FA" "$FB" "$OA" "$OB" "$RD"' EXIT
mkdir -p "$RD/evidence/trials" && touch "$RD/install.sh" && git -C "$RD" init -q 2>/dev/null
cp "$FIX" "$RD/evidence/trials/results.tsv"
R1=$(BT_REPO="$RD" tools/bt-trial report 2>&1)

# The fixture holds 2 hangs: one observational, one controlled. If outcome is
# read positionally both are missed and the SCO table shows zero hung.
# The fixture holds 5 rows: 2 hangs and 1 RECOVERED (all three with SCO), 1
# survived-with-SCO, 1 survived-without. `recovered` must count as a BT-1
# occurrence, not a survival — otherwise the incidence of the bug is understated
# by exactly the watchdog success rate, which is the quantity the mitigation
# exists to maximise. Reading outcome positionally puts every row in the
# survived column; a crashed cross-tab prints nothing at all.
# bt1_status confirmed on T1, T4, T6 — all with SCO -> 3 "hung", meaning the
# DEFECT occurred, regardless of whether the controller was later rescued.
# T5 not_observed with SCO -> 1 survived. T2 not_observed without SCO.
# T3 (censored_pre_failure) and T7 (CHANGED treatment) are EXCLUDED entirely;
# were either counted it would land in a cell and change a number.
if grep -qE 'SCO setup requested +3 +1' <<<"$R1" \
   && grep -qE 'no SCO setup +0 +1' <<<"$R1" \
   && grep -q 'censored by early watchdog intervention' <<<"$R1"; then
    ok "SCO 2x2 counts recovered as BT-1 and excludes censored (3/1, 0/1)"
else
    bad "SCO 2x2 wrong or missing — outcome read by position, recovered miscounted, or awk failed:"
    grep -A4 'hung' <<<"$R1" | head -6
fi

# The environment is part of the treatment. Two distinct environments in one
# results file must be flagged, never silently pooled under one build name.
if grep -q 'DISTINCT ENVIRONMENTS' <<<"$R1"; then
    ok "report warns when trials span more than one environment"
else
    bad "report pooled trials from different environments without warning"
fi

# And incidence must be reported separately from unrecovered failure.
if grep -q 'BT-1 INC' <<<"$R1"; then
    ok "report separates BT-1 incidence from unrecovered failure"
else
    bad "report shows only unrecovered failures — incidence is hidden"
fi

# CENSORED observations must be visible AND excluded from the rate. An early
# watchdog intervention before any observed timeout destroys the counterfactual:
# counting it as an occurrence lets the mitigation manufacture the incidence it
# is measuring; counting it as a survival is the mirror error.
if grep -qE 'observational_boot +stock +1/2 +1/2 .*1/3' <<<"$R1"; then
    ok "censored row is shown but excluded from the denominator (1/2 of 3 seen)"
else
    bad "censored handling wrong — expected rate over 2 with 1/3 censored:"
    grep -E 'observational_boot' <<<"$R1" | head -2
fi
grep -q 'CENSORED trial(s), excluded from every rate' <<<"$R1" \
    && ok "report explains why censored trials are excluded" \
    || bad "censored trials excluded silently"

# Measurement revision must NOT split the denominator. T1 and T2 share a
# treatment but differ in measurement_rev; a tooling fix must not fragment a
# series into singletons.
if grep -qE 'observational_boot +stock +1/2' <<<"$R1"; then
    ok "differing measurement revisions pool into one denominator"
else
    bad "measurement revision fragmented the denominator"
fi

grep -q 'observational_boot' <<<"$R1" && grep -q 'controlled_v2' <<<"$R1" \
    && ok "observational and controlled rows reported separately" \
    || bad "trial types not separated in the report"

# Permute the columns. Same data, different order, identical report required.
python3 - "$FIX" "$RD/evidence/trials/results.tsv" <<'PY'
import sys, random
rows = [l.rstrip("\n").split("\t") for l in open(sys.argv[1]) if l.strip()]
hdr = rows[0]
order = list(range(len(hdr)))
random.Random(20260813).shuffle(order)
with open(sys.argv[2], "w") as f:
    for r in rows:
        f.write("\t".join(r[i] for i in order) + "\n")
PY
R2=$(BT_REPO="$RD" tools/bt-trial report 2>&1)

if [[ "$R1" == "$R2" ]]; then
    ok "report is identical under an arbitrary column permutation"
else
    bad "report changed when columns were reordered — a consumer reads by position"
    diff <(echo "$R1") <(echo "$R2") | head -12 | sed 's/^/      /'
fi

echo
echo "awk program-loading (the -f trap)"
echo "──────────────────────────────────────────────────────────────"

# `awk -f lib.awk 'program' input` does NOT run 'program'. With -f present, awk
# takes the program only from the -f files and treats the positional string as
# an INPUT FILENAME. Sharing the date arithmetic via -f therefore silently
# disabled bt-capdiff's matcher and both of bt-trial's interval computations:
# no error, no output, and bt-capdiff reported perfect agreement between paths
# differing by 278 records.
#
# Nothing about that is visible in a syntax check or a code reading that does
# not know the rule. So: assert that no tool passes an inline program alongside
# -f, and that the interval helper actually returns a number.
offenders=$(grep -rnE "awk[^|]*-f [^ ]+\.awk[^|]*'" tools/ bin/ 2>/dev/null \
            | grep -vE "^tools/lib/|-f \"\\\$LIBDIR/[a-z-]+\.awk\" -f " || true)
if [[ -z "$offenders" ]]; then
    ok "no tool passes an inline program alongside awk -f"
else
    bad "inline program alongside -f (it will be read as a filename):"
    sed 's/^/      /' <<<"$offenders"
fi

iv=$(awk -f tools/lib/timestamp.awk -f tools/lib/interval.awk \
        -v a="2026-08-31T23:59:59.000000+02:00" -v b="2026-09-01T00:00:02.000000+02:00" </dev/null)
[[ "$iv" == "3.000" ]] && ok "interval.awk spans a month boundary (3.000s)" \
    || bad "expected 3.000 across month boundary, got '${iv:-empty}'"

iv2=$(awk -f tools/lib/timestamp.awk -f tools/lib/interval.awk \
        -v a="not-a-timestamp" -v b="2026-09-01T00:00:02.000000+02:00" </dev/null)
[[ -z "$iv2" ]] && ok "interval.awk prints nothing on an unparseable timestamp" \
    || bad "expected empty output on bad input, got '$iv2'"

echo
echo "analysis commands fail loudly"
echo "──────────────────────────────────────────────────────────────"

# THE INVARIANT: if an evidence-producing calculation fails, the enclosing
# command must exit non-zero.
#
# bt-trial runs under `set -uo pipefail` and deliberately NOT `set -e` — it
# probes things that are allowed to fail (hci_alive, optional commands), and
# errexit's semantics are treacherous. The consequence, before this fix, was
# that an awk syntax error printed to stderr, the script carried on through
# later echoes, and `bt-trial report` returned 0 while silently omitting an
# entire analytical section.
#
# Schema-position independence and successful execution are SEPARATE
# invariants. The permutation test happens to catch this one for this table,
# because missing output fails the expected-count assertion — but that is a
# coincidence of that fixture, not a general guarantee. This tests the general
# property by making the analysis program unreachable.
BROKEN=$(mktemp -d)
mkdir -p "$BROKEN/lib"
cp tools/lib/timestamp.awk "$BROKEN/lib/"
cp tools/bt-trial "$BROKEN/"
# Every lib file present except the report programs: the tool must fail rather
# than print a report with a section missing.
rc=0
BT_REPO="$RD" BT_LIBDIR="$BROKEN/lib" "$BROKEN/bt-trial" report >/dev/null 2>&1 || rc=$?
if (( rc != 0 )); then
    ok "report exits non-zero when an analysis program is missing (rc=$rc)"
else
    bad "report returned 0 with its analysis program missing — a partial report passed as success"
fi
rm -rf "$BROKEN"

# And a syntactically broken program must be fatal too, not merely noisy.
BROKEN2=$(mktemp -d)
mkdir -p "$BROKEN2/lib"
cp tools/lib/*.awk "$BROKEN2/lib/"
cp tools/bt-trial "$BROKEN2/"
printf 'BEGIN { if (1)\n  print "a"\n  print "b"\nelse print "c" }\n' > "$BROKEN2/lib/trial-sco-table.awk"
rc=0
BT_REPO="$RD" BT_LIBDIR="$BROKEN2/lib" "$BROKEN2/bt-trial" report >/dev/null 2>&1 || rc=$?
if (( rc != 0 )); then
    ok "report exits non-zero when an analysis program has a syntax error (rc=$rc)"
else
    bad "report returned 0 despite an awk parse error — exactly the original defect"
fi
rm -rf "$BROKEN2"

echo
echo "trial lifecycle — the PRODUCER, not just the report"
echo "──────────────────────────────────────────────────────────────"

# WHY THIS EXISTS. Every other bt-trial test drives `report` against a prebuilt
# results.tsv. That validates the consumer. It cannot notice that the producer
# is broken — and it was: the classifier read $tmo before it was collected and
# dereferenced $since before assignment, so under `set -u` trial closure aborted
# and no row was ever written. The outcome ontology was correct in the fixture
# and unreachable in production.
#
# So this drives the real path: open a trial, close it, and require a row.
LC=$(mktemp -d)
mkdir -p "$LC/evidence/trials" "$LC/state"; touch "$LC/install.sh"
git -C "$LC" init -q 2>/dev/null

rc=0
BT_REPO="$LC" BT_STATE="$LC/state" tools/bt-trial autostart stock >/dev/null 2>&1 || rc=$?
if (( rc == 0 )) && [[ -e "$LC/state/current" ]]; then
    ok "autostart opens a trial"
else
    bad "autostart failed (rc=$rc) or wrote no state file"
fi

rc=0
out=$(BT_REPO="$LC" BT_STATE="$LC/state" tools/bt-trial ok 2>&1) || rc=$?
if (( rc == 0 )); then
    ok "closing a trial completes without error"
else
    bad "closing a trial FAILED (rc=$rc):"
    tail -3 <<<"$out" | sed 's/^/      /'
fi

if [[ -s "$LC/evidence/trials/results.tsv" ]]; then
    ok "closing a trial writes a results row"
else
    bad "no results row written — the producer path is broken"
fi

# The row must carry both axes, populated with values from their domains. A
# blank or missing field here would make every later report refuse.
if [[ -s "$LC/evidence/trials/results.tsv" ]]; then
    bs=$(awk -F'\t' 'NR==1{for(i=1;i<=NF;i++)c[$i]=i;next} NR==2{print $c["bt1_status"]}' \
         "$LC/evidence/trials/results.tsv")
    tr=$(awk -F'\t' 'NR==1{for(i=1;i<=NF;i++)c[$i]=i;next} NR==2{print $c["trial_result"]}' \
         "$LC/evidence/trials/results.tsv")
    # `unknown` is a legitimate value — but not here. This host has a readable
    # journal, so `unknown` means evidence collection failed, and that is
    # exactly how the ordering bug manifested: $tmo was consulted before it was
    # assigned, every trial classified `unknown`, and every trial was excluded
    # from every rate. The denominator would have been permanently zero while
    # the report printed cleanly.
    #
    # Domain-membership alone would have passed that, since `unknown` is in the
    # domain. The assertion has to be that collection SUCCEEDED.
    case "$bs" in
        not_observed|confirmed|censored_pre_failure)
            ok "bt1_status populated from evidence ($bs)" ;;
        unknown)
            bad "bt1_status is 'unknown' on a host with a readable journal — evidence collection failed (classifier ordered before collection?)" ;;
        *)  bad "bt1_status is '${bs:-empty}' — outside its domain" ;;
    esac
    case "$tr" in
        survived|failed|alive_after_intervention|aborted)
            ok "trial_result populated from its domain ($tr)" ;;
        *)  bad "trial_result is '${tr:-empty}' — outside its domain" ;;
    esac

    # And the report must accept what the producer just wrote. Producer and
    # consumer agreeing separately with a fixture is not the same as agreeing
    # with each other.
    rc=0
    BT_REPO="$LC" tools/bt-trial report >/dev/null 2>&1 || rc=$?
    (( rc == 0 )) && ok "report accepts a row the producer wrote" \
        || bad "report rejected the producer's own row (rc=$rc)"
fi

# THE HANG PATH, which no test reached until now — and which was broken.
# Classification assigns trial_result, then `outcome` was reused for control
# flow and still tested for the value `hang`, which the new ontology can never
# produce. A real failure therefore skipped bt-incident and printed the
# survival branch. The successful-close test could not see it.
# A stub bt-incident, ahead of the real one on PATH. It makes the test fast and
# turns "did the failure branch fire?" into a file that either exists or does
# not, rather than a string match on prose that could be reworded.
mkdir -p "$LC/bin"
printf '#!/bin/sh\ntouch "%s/incident-was-called"\n' "$LC" > "$LC/bin/bt-incident"
chmod +x "$LC/bin/bt-incident"

BT_REPO="$LC" BT_STATE="$LC/state" tools/bt-trial autostart stock >/dev/null 2>&1
rc=0
out=$(PATH="$LC/bin:$PATH" BT_REPO="$LC" BT_STATE="$LC/state" tools/bt-trial hang 2>&1) || rc=$?
if (( rc == 0 )); then
    ok "closing a trial as hang completes without error"
else
    bad "closing as hang FAILED (rc=$rc):"; tail -3 <<<"$out" | sed 's/^/      /'
fi

hr=$(awk -F'\t' 'NR==1{for(i=1;i<=NF;i++)c[$i]=i;next} END{print $c["trial_result"]}' \
     "$LC/evidence/trials/results.tsv")
[[ "$hr" == "failed" ]] && ok "an explicit hang records trial_result=failed" \
    || bad "hang recorded trial_result='${hr:-empty}', expected failed"

# The failure branch must actually invoke the incident collector. This is the
# defect that hid here: control flow tested `$outcome == hang`, a value the new
# ontology can never produce, so a real failure silently collected nothing.
if [[ -e "$LC/incident-was-called" ]]; then
    ok "a hang invokes the incident collector"
else
    bad "hang did NOT invoke bt-incident — control flow keyed on a dead value"
fi
# ── THE ONTOLOGY ITSELF, through the production producer ──────────────────
#
# Individual paths were tested; the combinations were not. These four are the
# meaningful ones, and each is driven by faking exactly the evidence the
# classifier reads — kernel timeouts and watchdog interventions — via a stub
# journalctl ahead of the real one on PATH.
#
#   no timeout, no intervention          -> not_observed + survived
#   timeout, controller dead             -> confirmed + failed
#   timeout, intervention, alive         -> confirmed + alive_after_intervention
#   early intervention, no timeout       -> censored_pre_failure + alive_after_intervention
#
# The last row is the one the whole ontology exists for: the intervention
# destroyed the counterfactual, so the evidence axis says censored while the
# controller axis says it is alive. Recording that as a survival or as a
# recovery would each state something untrue.
mkdir -p "$LC/bin"
printf '#!/bin/sh\ntouch "%s/incident-was-called"\n' "$LC" > "$LC/bin/bt-incident"
chmod +x "$LC/bin/bt-incident"

combo() {
    local name="$1" ktext="$2" wtext="$3" close="$4" want_bs="$5" want_tr="$6"
    # A stub journalctl returning the requested evidence. -k selects the kernel
    # stream, -u bt-hang-watchdog the watchdog stream; anything else is empty.
    cat > "$LC/bin/journalctl" <<STUB
#!/bin/sh
for a in "\$@"; do
  case "\$a" in
    -k) printf '%s' "$ktext"; exit 0 ;;
    bt-hang-watchdog) printf '%s' "$wtext"; exit 0 ;;
  esac
done
exit 0
STUB
    chmod +x "$LC/bin/journalctl"
    rm -f "$LC/evidence/trials/results.tsv" "$LC/state/current"
    PATH="$LC/bin:$PATH" BT_REPO="$LC" BT_STATE="$LC/state" tools/bt-trial autostart stock >/dev/null 2>&1
    PATH="$LC/bin:$PATH" BT_REPO="$LC" BT_STATE="$LC/state" tools/bt-trial "$close" >/dev/null 2>&1
    local bs tr
    bs=$(awk -F"\t" 'NR==1{for(i=1;i<=NF;i++)c[$i]=i;next} END{print $c["bt1_status"]}' "$LC/evidence/trials/results.tsv" 2>/dev/null)
    tr=$(awk -F"\t" 'NR==1{for(i=1;i<=NF;i++)c[$i]=i;next} END{print $c["trial_result"]}' "$LC/evidence/trials/results.tsv" 2>/dev/null)
    if [[ "$bs" == "$want_bs" && "$tr" == "$want_tr" ]]; then
        ok "$name -> $bs + $tr"
    else
        bad "$name expected $want_bs + $want_tr, got '${bs:-empty}' + '${tr:-empty}'"
    fi
}

TMO_LINE='2026-08-13T01:00:00.000000+02:00 n kernel: Bluetooth: hci0: command tx timeout
'
EARLY_LINE='EARLY intervention: 1 audio-teardown failure(s) in 90s
'
LATE_LINE='Detected 6 controller timeouts within 60s - intervening.
'

combo "no timeout, no intervention" ""          ""                        ok   not_observed          survived
combo "timeout, closed as hang"      "$TMO_LINE" ""                        hang confirmed             failed
combo "timeout + intervention"       "$TMO_LINE" "$LATE_LINE"              ok   confirmed             alive_after_intervention
combo "early intervention only"      ""          "$EARLY_LINE"             ok   censored_pre_failure  alive_after_intervention

# UNREADABLE WATCHDOG EVIDENCE MUST NOT BECOME NEGATIVE EVIDENCE.
#
# With a watchdog RUNNING, failing to read its journal means we cannot tell
# not_observed from censored_pre_failure. Before the fix, the failed read
# produced 0 via `grep -c ... || true` and the trial recorded a clean
# not_observed + survived — an intervention that may have happened, erased.
cat > "$LC/bin/systemctl" <<'STUB'
#!/bin/sh
# Report the watchdog as running; everything else inactive/empty.
case "$*" in
  *"is-active --quiet bt-hang-watchdog"*) exit 0 ;;
  *"show bt-hang-watchdog"*)              echo "BT_EARLY=1 BT_THRESHOLD=3"; exit 0 ;;
  *is-active*)                            exit 3 ;;
esac
exit 0
STUB
chmod +x "$LC/bin/systemctl"
cat > "$LC/bin/journalctl" <<'STUB'
#!/bin/sh
# Kernel stream readable and empty; watchdog stream UNREADABLE.
for a in "$@"; do
  case "$a" in
    -k)               exit 0 ;;
    bt-hang-watchdog) exit 1 ;;
  esac
done
exit 0
STUB
chmod +x "$LC/bin/journalctl"
rm -f "$LC/evidence/trials/results.tsv" "$LC/state/current"
PATH="$LC/bin:$PATH" BT_REPO="$LC" BT_STATE="$LC/state" tools/bt-trial autostart stock >/dev/null 2>&1
PATH="$LC/bin:$PATH" BT_REPO="$LC" BT_STATE="$LC/state" tools/bt-trial ok >/dev/null 2>&1
ubs=$(awk -F"\t" 'NR==1{for(i=1;i<=NF;i++)c[$i]=i;next} END{print $c["bt1_status"]}' \
      "$LC/evidence/trials/results.tsv" 2>/dev/null)
if [[ "$ubs" == "unknown" ]]; then
    ok "unreadable watchdog journal with watchdog running -> unknown"
else
    bad "unreadable watchdog journal gave '${ubs:-empty}', expected unknown"
fi

rm -f "$LC/bin/journalctl" "$LC/bin/systemctl"
rm -rf "$LC"

echo
echo "analysis refuses data that cannot justify it"
echo "──────────────────────────────────────────────────────────────"

# THE INVARIANT: an evidence-producing program must fail non-zero not only when
# its code cannot execute, but when its INPUT SCHEMA cannot justify the
# calculation.
#
# Resolving columns by name is only half the guarantee. If a required name is
# absent, awk turns the lookup into field 0 or an empty string and the program
# computes plausible nonsense while exiting successfully — the same wrong answer
# as reading the wrong field, reached by a different route. In the SCO table
# specifically, a missing `bt1_status` makes every row not-hung: a cross-tab
# asserting the stimulus never coincided with a failure.
SCHEMA=$(mktemp -d)
mkdir -p "$SCHEMA/evidence/trials"; touch "$SCHEMA/install.sh"; git -C "$SCHEMA" init -q 2>/dev/null

# 1. Required column removed entirely.
python3 - tests/trial-results.tsv "$SCHEMA/evidence/trials/results.tsv" <<'PY'
import sys
rows = [l.rstrip("\n").split("\t") for l in open(sys.argv[1]) if l.strip()]
i = rows[0].index("bt1_status")
with open(sys.argv[2], "w") as f:
    for r in rows:
        f.write("\t".join(v for j, v in enumerate(r) if j != i) + "\n")
PY
rc=0
BT_REPO="$SCHEMA" tools/bt-trial report >/dev/null 2>&1 || rc=$?
if (( rc != 0 )); then
    ok "report refuses a schema with no bt1_status column (rc=$rc)"
else
    bad "report accepted a schema with no bt1_status column"
fi

# And it must not print the table it is refusing to stand behind. awk runs END
# even after `exit`, so a naive refusal emits a plausible report alongside the
# non-zero status — and the report is what a human reads.
out=$(BT_REPO="$SCHEMA" tools/bt-trial report 2>/dev/null)
if grep -qE 'SCO setup requested|TRIAL TYPE .*HANGS' <<<"$out"; then
    bad "a refused report still printed its table"
else
    ok "a refused report prints no table"
fi

# 2. Required column present, value outside the known domain.
python3 - tests/trial-results.tsv "$SCHEMA/evidence/trials/results.tsv" <<'PY'
import sys
rows = [l.rstrip("\n").split("\t") for l in open(sys.argv[1]) if l.strip()]
i = rows[0].index("bt1_status")
rows[1][i] = "potato"
with open(sys.argv[2], "w") as f:
    for r in rows:
        f.write("\t".join(r) + "\n")
PY
rc=0
BT_REPO="$SCHEMA" tools/bt-trial report >/dev/null 2>&1 || rc=$?
if (( rc != 0 )); then
    ok "report refuses an unrecognised bt1_status value (rc=$rc)"
else
    bad "an unrecognised bt1_status was silently counted"
fi
rm -rf "$SCHEMA"

echo
echo "documentation-drift detector"
echo "──────────────────────────────────────────────────────────────"

# The detector previously counted install.sh and uninstall.sh as code but
# excluded them from the timestamp comparison, so a change to either was
# described as a code change in the warning text while being unable to raise
# it. Two path lists that must agree, maintained separately, is the same
# species of defect as two timestamp parsers that must agree.
#
# Assert there is ONE list, used for both. Testing the git-history behaviour
# directly would depend on this repository's own commit times, which change
# every commit.
V=devtools/repo-validate
uses=$(grep -c 'KNOWLEDGE_PATHS\[@\]' "$V" || true)
if [[ "$uses" == "2" ]]; then
    ok "one path set used for both the count and the timestamp"
else
    bad "expected KNOWLEDGE_PATHS used exactly twice, found $uses"
fi

if grep -qE 'log (-1 |-20 )?--pretty=%ct -- (tools|bin|systemd)( |$)' "$V"; then
    bad "a git path list is still spelled inline instead of using the array"
else
    ok "no inline path list bypasses the shared array"
fi

# The paths that can change what the project knows must all be watched. etc/
# carries the udev rules whose provenance EX-012 turned on; tests/ and devtools/
# change what the repository claims to validate.
missing=""
for pth in tools bin systemd etc tests devtools install.sh uninstall.sh; do
    grep -q "KNOWLEDGE_PATHS=(.*\b${pth}\b" "$V" || missing="$missing $pth"
done
if [[ -z "$missing" ]]; then
    ok "every knowledge-changing path is watched"
else
    bad "unwatched implementation paths:$missing"
fi

echo
if (( fail )); then
    echo "FAILED: $fail of $((pass + fail)) invariants"
    exit 1
fi
echo "all $pass invariants hold"
