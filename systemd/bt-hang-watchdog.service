[Unit]
Description=Bluetooth firmware-hang watchdog (QCA9377 / 13d3:3503)
Documentation=https://github.com/ivoitovych/qca9377-bt-hang
After=bluetooth.service systemd-journald.service
Wants=bluetooth.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/bt-hang-watchdog
Restart=always
RestartSec=10

# Tunables (override with: systemctl edit bt-hang-watchdog)
Environment=BT_THRESHOLD=3
Environment=BT_WINDOW=60
Environment=BT_COOLDOWN=180
Environment=BT_MAX_FAILS=3

# BT_VID / BT_PID are deliberately NOT set here. The script defaults to
# 13d3:3503, and install.sh writes a drop-in at
#   /etc/systemd/system/bt-hang-watchdog.service.d/10-device.conf
# when a different device is requested. Hardcoding them in this unit would
# silently override the documented
#   BT_VID=... BT_PID=... sudo -E ./install.sh --apply

# Needs root for USBDEVFS_RESET and sysfs unbind/bind.
# Everything else is locked down.
#
# Why the lockdown stops here (review 2026-08-15T1752Z 2.4): NoNewPrivileges
# would break notify()'s sudo -u; further directives were deliberately NOT
# added sight-unseen because this unit's failure mode is "the recovery path
# dies exactly when needed" (the MemoryMax lesson below). One interaction for
# the owner to verify on the machine before tightening anything: ProtectHome
# below makes /root and /home inaccessible, and the watchdog's device-absent
# path runs bt-trial, which writes the results row into the repository
# checkout — if that checkout lives under /root or /home, the row write would
# fail silently under this sandboxing. Check with:
#   journalctl -u bt-hang-watchdog | grep -A2 'auto-trial closed'
# and confirm a row landed in evidence/trials/results.tsv for that closure.
ProtectHome=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes

# journalctl -kf mmaps the journal files and sits around 45 MB RSS on a host
# with ~850 MB of retained journal; it grows with journal size. An earlier
# 64M cap was hit 21 times in the first 3 minutes on real hardware (cgroup
# memory.events "max"), forcing reclaim and swap. A watchdog that gets
# OOM-killed under memory pressure fails exactly when it is most needed, so
# the cap is set well clear of normal use rather than snugly around it.
MemoryMax=256M

[Install]
WantedBy=multi-user.target
