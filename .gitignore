# Local backups of system config — may contain unsanitised data
backup-*/
*.orig
*.bak

# Raw (unsanitised) logs — only *.sanitized.log may be committed
# (guards evidence/ too: tools sanitise before writing there, and repo-scan is
# the backstop; the old data/ paths no longer exist)
evidence/**/*.raw.log

# Collected metrics are host-specific runtime data
metrics.tsv
*.tsv.tmp

# Working directories that must survive reboots but never publish.
#   tmp/    transient outputs (decoded captures, scratch data) — the session
#           scratchpad under /tmp was wiped by a reboot on 2026-09-19 and took
#           the day's helper scripts with it; helpers now live in scripts/,
#           tracked, and their outputs here
#   cache/  third-party sources (kernel, BlueZ) fetched for reading and
#           compile-testing patches; large, reproducible, not ours
tmp/
cache/

# Editor / OS noise
*~
.DS_Store
.vscode/
.idea/

# HCI captures — contain device addresses, names, pairing and payload data
*.btsnoop
trace/

# capture gap log — host-specific runtime data
gaps.log

# convenience pointer to the newest session; host-local
evidence/sessions/latest

# Python writes these beside the source when bin/bt-capture is imported —
# devtools/py-coverage and any interactive debugging of it do exactly that, and
# `repo-save` stages with `git add -A`. One got committed in a19fa0c before this
# rule existed. Nothing here is source, and a .pyc is a tracked binary that
# repo-scan's binary check does not look for: it matches capture formats
# (.btsnoop/.pcap), not arbitrary compiled output.
__pycache__/
*.pyc
