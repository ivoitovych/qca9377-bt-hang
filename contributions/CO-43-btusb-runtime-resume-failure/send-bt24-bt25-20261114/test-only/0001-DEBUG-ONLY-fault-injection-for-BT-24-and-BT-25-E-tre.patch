From 90205b302c04aff97b5a33a26353fda7951f5467 Mon Sep 17 00:00:00 2001
From: Iaroslav Voitovych <yaroslav.voytovych@gmail.com>
Date: Sat, 14 Nov 2026 15:11:30 +0100
Subject: [PATCH] DEBUG ONLY fault injection for BT-24 and BT-25 (E tree)

---
 drivers/bluetooth/btusb_main.c | 45 ++++++++++++++++++++++++++++++++--
 1 file changed, 43 insertions(+), 2 deletions(-)

diff --git a/drivers/bluetooth/btusb_main.c b/drivers/bluetooth/btusb_main.c
index 5f6d90d43d977..df8a7bf8b8722 100644
--- a/drivers/bluetooth/btusb_main.c
+++ b/drivers/bluetooth/btusb_main.c
@@ -4991,6 +4991,28 @@ static int btusb_suspend(struct usb_interface *intf, pm_message_t message)
 	return 0;
 }
 
+/* DEBUG ONLY: fault injection for the BT-24 and BT-25 emulation runs */
+static int bt_inject;
+static int bt24_delay_ms;
+module_param(bt_inject, int, 0644);
+module_param(bt24_delay_ms, int, 0644);
+static struct hci_dev *bt24_hdev;
+
+static void bt24_send_fn(struct work_struct *w)
+{
+	struct sk_buff *skb;
+
+	msleep(bt24_delay_ms / 2);
+	skb = bt_skb_alloc(3, GFP_KERNEL);
+	if (!skb)
+		return;
+	hci_skb_pkt_type(skb) = HCI_COMMAND_PKT;
+	skb_put_data(skb, "\x09\x10\x00", 3);
+	btusb_send_frame(bt24_hdev, skb);
+	pr_info("bt24-dbg: second sender done\n");
+}
+static DECLARE_WORK(bt24_send_work, bt24_send_fn);
+
 static void play_deferred(struct btusb_data *data)
 {
 	struct urb *urb;
@@ -4999,7 +5021,12 @@ static void play_deferred(struct btusb_data *data)
 	while ((urb = usb_get_from_anchor(&data->deferred))) {
 		usb_anchor_urb(urb, &data->tx_anchor);
 
-		err = usb_submit_urb(urb, GFP_ATOMIC);
+		if (bt_inject == 2) {	/* DEBUG ONLY */
+			bt_inject = 0;
+			err = -ENOMEM;
+		} else {
+			err = usb_submit_urb(urb, GFP_ATOMIC);
+		}
 		if (err < 0) {
 			if (err != -EPERM && err != -ENODEV)
 				BT_ERR("%s urb %p submission failed (%d)",
@@ -5042,7 +5069,12 @@ static int btusb_resume(struct usb_interface *intf)
 		goto done;
 
 	if (test_bit(BTUSB_INTR_RUNNING, &data->flags)) {
-		err = btusb_submit_intr_urb(hdev, GFP_NOIO);
+		if (bt_inject == 1) {	/* DEBUG ONLY */
+			bt_inject = 0;
+			err = -ENOMEM;
+		} else {
+			err = btusb_submit_intr_urb(hdev, GFP_NOIO);
+		}
 		if (err < 0) {
 			clear_bit(BTUSB_INTR_RUNNING, &data->flags);
 			goto failed;
@@ -5080,9 +5112,18 @@ static int btusb_resume(struct usb_interface *intf)
 failed:
 	usb_scuttle_anchored_urbs(&data->deferred);
 done:
+	if (err && bt24_delay_ms) {	/* DEBUG ONLY */
+		bt24_hdev = hdev;
+		schedule_work(&bt24_send_work);
+		msleep(bt24_delay_ms);
+		flush_work(&bt24_send_work);
+	}
 	spin_lock_irq(&data->txlock);
 	clear_bit(BTUSB_SUSPENDING, &data->flags);
 	spin_unlock_irq(&data->txlock);
+	if (err)	/* DEBUG ONLY */
+		bt_dev_info(hdev, "bt24-dbg: deferred anchor %s",
+			    usb_anchor_empty(&data->deferred) ? "empty" : "NOT empty");
 
 	return err;
 }
-- 
