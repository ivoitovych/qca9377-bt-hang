+# -*- coding: utf-8; mode: python; eval: (blacken-mode); -*-
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""
+Tests for the lifetime of device objects using VM instances
+"""
+
+import socket
+import subprocess
+import time
+
+import pytest
+
+from pytest_bluezenv import Agent, Bluetoothd, find_exe, host_config, run, wait_until
+
+pytestmark = [pytest.mark.vm]
+
+# The scan of host0 alternates with inquiry, which leaves up to about 11 s
+# without any advertising report
+TEMPORARY_TIMEOUT = 20
+
+# Flags AD: not limited and not general discoverable
+ADV_FLAGS = "020118"
+
+
+def btmgmt(*args):
+    return run(
+        [find_exe("tools", "btmgmt"), "--index", "0", *args],
+        stdout=subprocess.PIPE,
+        stdin=subprocess.DEVNULL,
+        encoding="utf-8",
+        check=True,
+    )
+
+
+def connect_and_disconnect(address):
+    """Open and close a BR/EDR link to address, without pairing"""
+    sock = socket.socket(
+        socket.AF_BLUETOOTH, socket.SOCK_SEQPACKET, socket.BTPROTO_L2CAP
+    )
+    sock.settimeout(10)
+    sock.connect((address, 1))
+    time.sleep(1)
+    sock.close()
+
+    btmgmt("disconnect", address)
+
+
+def advertise(flags):
+    btmgmt("le", "on")
+    btmgmt("add-adv", "-d", flags, "-c", "1")
+
+
+@host_config(
+    [
+        Bluetoothd(conf=f"[General]\nTemporaryTimeout = {TEMPORARY_TIMEOUT}\n"),
+        Agent(),
+    ],
+    [],
+)
+def test_device_temporary_not_discoverable(hosts):
+    host0, host1 = hosts
+
+    host0.call(btmgmt, "connectable", "on")
+    host0.agent.adapter_method("StartDiscovery")
+    host0.agent.expect("org.bluez.Adapter1.StartDiscovery:reply")
+
+    host1.call(connect_and_disconnect, host0.bdaddr)
+    assert host0.agent.has_device(host1.bdaddr)
+
+    # The peer is unpaired and not connected, and none of its reports
+    # claims it is discoverable, so host0 removes it after the timeout
+    host1.call(advertise, ADV_FLAGS)
+    wait_until(
+        lambda: not host0.agent.has_device(host1.bdaddr),
+        timeout=TEMPORARY_TIMEOUT + 10,
+    )
