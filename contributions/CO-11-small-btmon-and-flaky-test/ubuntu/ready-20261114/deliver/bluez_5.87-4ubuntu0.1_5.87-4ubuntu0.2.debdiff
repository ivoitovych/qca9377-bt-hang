diff -Nru bluez-5.87/debian/changelog bluez-5.87/debian/changelog
--- bluez-5.87/debian/changelog	2026-11-06 03:55:26.000000000 +0000
+++ bluez-5.87/debian/changelog	2026-11-14 07:32:19.000000000 +0000
@@ -1,3 +1,13 @@
+bluez (5.87-4ubuntu0.2) stonking; urgency=medium
+
+  * btmon: fix abort (buffer overflow detected) in print_packet() when the
+    computed line width is negative or larger than the line buffer
+    (LP: #<LP-BTMON>)
+    - debian/patches/monitor-clamp-max_len-in-print_packet.patch:
+      upstream dca0f10fd560, clamp max_len to the space left in line[].
+
+ -- Iaroslav Voitovych <yaroslav.voytovych@gmail.com>  Sat, 14 Nov 2026 15:00:00 +0000
+
 bluez (5.87-4ubuntu0.1) stonking; urgency=medium
 
   * mpris-proxy segfault during OBEX file transfer (LP: #2172906)
diff -Nru bluez-5.87/debian/patches/monitor-clamp-max_len-in-print_packet.patch bluez-5.87/debian/patches/monitor-clamp-max_len-in-print_packet.patch
--- bluez-5.87/debian/patches/monitor-clamp-max_len-in-print_packet.patch	1970-01-01 00:00:00.000000000 +0000
+++ bluez-5.87/debian/patches/monitor-clamp-max_len-in-print_packet.patch	2026-11-14 07:32:19.000000000 +0000
@@ -0,0 +1,48 @@
+Description: monitor: clamp max_len in print_packet
+ print_packet() derives the snprintf() bound from the terminal width and
+ never bounds it against the space left in line[]. max_len can stay negative
+ after the existing recovery for max_len <= 0, or exceed the buffer. Clamp
+ max_len to the space remaining in line[] and only write the ellipsis when
+ there is room for it.
+Author: Chad Spensky
+Origin: upstream, https://git.kernel.org/pub/scm/bluetooth/bluez.git/commit/?id=dca0f10fd560f8095493021ca2ac20236fde026e
+Bug: https://github.com/bluez/bluez/issues/1104
+Bug-Ubuntu: https://bugs.launchpad.net/ubuntu/+source/bluez/+bug/<LP-BTMON>
+Forwarded: not-needed
+Last-Update: 2026-11-14
+---
+diff --git a/monitor/packet.c b/monitor/packet.c
+index f0558b656..67837b8f0 100644
+--- a/monitor/packet.c
++++ b/monitor/packet.c
+@@ -605,13 +605,26 @@ static void print_packet(struct timeval *tv, struct ucred *cred, char ident,
+ 			max_len = col - len - ts_len - 3;
+ 		}
+ 
++		/* col comes from the terminal and len includes the optional
++		 * "comm[pid]: " prefix, so max_len can still be negative
++		 * here, or larger than the space left in line[]. Both
++		 * overflow the snprintf below, and a negative value also
++		 * indexes before line[].
++		 */
++		if (max_len > (int) sizeof(line) - pos - 1)
++			max_len = (int) sizeof(line) - pos - 1;
++		if (max_len < 0)
++			max_len = 0;
++
+ 		n = snprintf(line + pos, max_len + 1, "%s%s",
+ 						label ? ": " : "", text);
+ 		if (n > max_len) {
+-			line[pos + max_len - 1] = '.';
+-			line[pos + max_len - 2] = '.';
+-			if (line[pos + max_len - 3] == ' ')
+-				line[pos + max_len - 3] = '.';
++			if (max_len >= 3) {
++				line[pos + max_len - 1] = '.';
++				line[pos + max_len - 2] = '.';
++				if (line[pos + max_len - 3] == ' ')
++					line[pos + max_len - 3] = '.';
++			}
+ 
+ 			n = max_len;
+ 		}
diff -Nru bluez-5.87/debian/patches/series bluez-5.87/debian/patches/series
--- bluez-5.87/debian/patches/series	2026-11-06 03:55:26.000000000 +0000
+++ bluez-5.87/debian/patches/series	2026-11-14 07:32:19.000000000 +0000
@@ -17,3 +17,4 @@
 CVE-2026-85218.patch
 avrcp-Fix-out-of-bounds-read-parsing-attribute-lists.patch
 mpris-proxy-fix-possible-crash.patch
+monitor-clamp-max_len-in-print_packet.patch
