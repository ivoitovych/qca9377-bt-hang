From 6b6293b4e549b3e0d1bea7781d197f97ad078ce7 Mon Sep 17 00:00:00 2001
From: Iaroslav Voitovych <yaroslav.voytovych@gmail.com>
Date: Sat, 14 Nov 2026 14:17:46 +0100
Subject: [PATCH] Bluetooth: MGMT: Stop mesh_send_sync() when it cannot add the
 instance

When hci_add_adv_instance() fails, mesh_send_sync() keeps the error in
err and carries on. It then returns the result of
hci_schedule_adv_instance_sync() for an instance that was never added,
and the original error is lost.

Return the error at once instead. hci_schedule_adv_instance_sync() is no
longer called for a missing instance and mesh_send_start_complete()
gets the real error.

This was found by reading the code. To reproduce it, a test-only module
parameter made the allocation in hci_add_adv_instance() fail for the
first Mesh Send. A kprobe trace on bluetooth-next, without and with
this patch, shows in 3 of 3 runs each:

  before: hci_add_adv_instance -> -ENOMEM, then
          hci_schedule_adv_instance_sync(instance 6) -> -ENOENT,
          mesh_send_sync -> -2, mesh_send_start_complete(err=-2)
  after:  hci_add_adv_instance -> -ENOMEM,
          mesh_send_sync -> -12, mesh_send_start_complete(err=-12)

User space gets the same Mesh Packet Complete event in both cases, so
this fixes the error path without changing what a client sees.

Fixes: b338d91703fa ("Bluetooth: Implement support for Mesh")
---
The runs were in QEMU with BlueZ's mesh-tester (-s Send). mesh-tester
(10 of 10) and mgmt-tester give the same results with and without this
patch.

 net/bluetooth/mgmt.c | 13 +++++++------
 1 file changed, 7 insertions(+), 6 deletions(-)

diff --git a/net/bluetooth/mgmt.c b/net/bluetooth/mgmt.c
index d21538634bc3..f5439fc30d55 100644
--- a/net/bluetooth/mgmt.c
+++ b/net/bluetooth/mgmt.c
@@ -2445,7 +2445,6 @@ static int mesh_send_sync(struct hci_dev *hdev, void *data)
 	struct adv_info *adv, *next_instance;
 	u8 instance = hdev->le_num_of_adv_sets + 1;
 	u16 timeout, duration;
-	int err = 0;
 
 	hci_dev_lock(hdev);
 
@@ -2473,10 +2472,12 @@ static int mesh_send_sync(struct hci_dev *hdev, void *data)
 				   hdev->le_adv_max_interval,
 				   mesh_tx->handle);
 
-	if (!IS_ERR(adv))
-		mesh_tx->instance = instance;
-	else
-		err = PTR_ERR(adv);
+	if (IS_ERR(adv)) {
+		hci_dev_unlock(hdev);
+		return PTR_ERR(adv);
+	}
+
+	mesh_tx->instance = instance;
 
 	if (hdev->cur_adv_instance == instance) {
 		/* If the currently advertised instance is being changed then
@@ -2503,7 +2504,7 @@ static int mesh_send_sync(struct hci_dev *hdev, void *data)
 	if (instance)
 		return hci_schedule_adv_instance_sync(hdev, instance, true);
 
-	return err;
+	return 0;
 }
 
 static void send_count(struct mgmt_mesh_tx *mesh_tx, void *data)

