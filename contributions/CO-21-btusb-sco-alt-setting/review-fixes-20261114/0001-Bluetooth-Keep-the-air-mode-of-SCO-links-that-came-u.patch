From e6884a7651fdbcc30d72f464cf35910d30f23e11 Mon Sep 17 00:00:00 2001
From: Iaroslav Voitovych <yaroslav.voytovych@gmail.com>
Date: Sun, 1 Nov 2026 18:33:56 +0100
Subject: [PATCH 1/2] Bluetooth: Keep the air mode of SCO links that came up

The air mode of a synchronous link is passed to the driver as
HCI_NOTIFY_ENABLE_SCO_CVSD or HCI_NOTIFY_ENABLE_SCO_TRANSP and not kept.
conn->setting is the voice setting the host asked for, which is not
always the air mode of the link: it is left unset for an incoming
connection, which is accepted with the setting of its socket, and
hci_connect_sco() overwrites it for an existing connection, also one
whose link is up.

Keep in the connection the air mode reported by Synchronous Connection
Complete, stored before the connection is marked connected, and for a
SCO link that completes with Connection Complete the one its
notification already assumes.

Add hci_conn_sco_up_num() to count the SCO links that are up, by air
mode, so that a driver can configure itself from the links that exist
instead of from the last notification. It returns the CVSD and the
transparent count from one walk of the connection list, so that both
describe the same set of links, and it must be called with hdev->lock
held, which the event handlers hold while they change a connection.
---
 include/net/bluetooth/hci.h      |  6 ++++++
 include/net/bluetooth/hci_core.h | 30 ++++++++++++++++++++++++++++++
 net/bluetooth/hci_event.c        |  2 ++
 3 files changed, 38 insertions(+)

diff --git a/include/net/bluetooth/hci.h b/include/net/bluetooth/hci.h
index efb85c781e4e9..4a21721411689 100644
--- a/include/net/bluetooth/hci.h
+++ b/include/net/bluetooth/hci.h
@@ -2898,6 +2898,12 @@ struct hci_ev_sync_conn_complete {
 	__u8     air_mode;
 } __packed;
 
+/* Air_Mode of HCI_Synchronous_Connection_Complete */
+#define HCI_AIR_MODE_ULAW	0x00
+#define HCI_AIR_MODE_ALAW	0x01
+#define HCI_AIR_MODE_CVSD	0x02
+#define HCI_AIR_MODE_TRANSP	0x03
+
 #define HCI_EV_SYNC_CONN_CHANGED	0x2d
 struct hci_ev_sync_conn_changed {
 	__u8     status;
diff --git a/include/net/bluetooth/hci_core.h b/include/net/bluetooth/hci_core.h
index 6e07bf206e4ad..88c3e58fe36c0 100644
--- a/include/net/bluetooth/hci_core.h
+++ b/include/net/bluetooth/hci_core.h
@@ -778,6 +778,7 @@ struct hci_conn {
 	__u16		disc_timeout;
 	__u16		conn_timeout;
 	__u16		setting;
+	__u8		air_mode;
 	__u16		auth_payload_timeout;
 	__u16		le_conn_min_interval;
 	__u16		le_conn_max_interval;
@@ -1149,6 +1150,35 @@ static inline unsigned int hci_conn_num(struct hci_dev *hdev, __u8 type)
 	}
 }
 
+/* Count the SCO and eSCO links that are up and carry their data over HCI, by
+ * air mode, in one pass so that both counts describe the same set of links.
+ * The caller must hold hdev->lock, which the event handlers hold while they
+ * change a connection's state, air mode and type.
+ */
+static inline void hci_conn_sco_up_num(struct hci_dev *hdev,
+				       unsigned int *cvsd,
+				       unsigned int *transp)
+{
+	struct hci_conn_hash *h = &hdev->conn_hash;
+	struct hci_conn *c;
+
+	lockdep_assert_held(&hdev->lock);
+
+	*cvsd = 0;
+	*transp = 0;
+
+	list_for_each_entry(c, &h->list, list) {
+		if ((c->type != SCO_LINK && c->type != ESCO_LINK) ||
+		    c->state != BT_CONNECTED || c->codec.data_path)
+			continue;
+
+		if (c->air_mode == HCI_AIR_MODE_CVSD)
+			(*cvsd)++;
+		else if (c->air_mode == HCI_AIR_MODE_TRANSP)
+			(*transp)++;
+	}
+}
+
 static inline unsigned int hci_conn_count(struct hci_dev *hdev)
 {
 	struct hci_conn_hash *c = &hdev->conn_hash;
diff --git a/net/bluetooth/hci_event.c b/net/bluetooth/hci_event.c
index 419a7e6748507..022c58dbedc46 100644
--- a/net/bluetooth/hci_event.c
+++ b/net/bluetooth/hci_event.c
@@ -3432,6 +3432,7 @@ static void hci_conn_complete_evt(struct hci_dev *hdev, void *data,
 	} else if (ev->link_type == SCO_LINK) {
 		switch (conn->setting & SCO_AIRMODE_MASK) {
 		case SCO_AIRMODE_CVSD:
+			conn->air_mode = HCI_AIR_MODE_CVSD;
 			if (hdev->notify)
 				hdev->notify(hdev, HCI_NOTIFY_ENABLE_SCO_CVSD);
 			break;
@@ -5622,6 +5623,7 @@ static void hci_sync_conn_complete_evt(struct hci_dev *hdev, void *data,
 			break;
 		}
 
+		conn->air_mode = ev->air_mode;
 		conn->state  = BT_CONNECTED;
 		conn->type   = ev->link_type;
 
