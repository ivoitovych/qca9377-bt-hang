+++ b/panels/sound/cc-sound-panel.c
@@ -174,8 +174,8 @@ output_device_update_cb (CcSoundPanel *self,
 
   if (device)
     stream = gvc_mixer_control_get_stream_from_device (self->mixer_control, device);
