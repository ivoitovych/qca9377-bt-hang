diff -Nru wireplumber-0.4.17/debian/changelog wireplumber-0.4.17/debian/changelog
--- wireplumber-0.4.17/debian/changelog	2025-09-11 15:45:53.000000000 +0000
+++ wireplumber-0.4.17/debian/changelog	2026-11-14 08:25:39.000000000 +0000
@@ -1,3 +1,15 @@
+wireplumber (0.4.17-1ubuntu4.2) noble; urgency=medium
+
+  * Do not mark a stream as handled when its link was skipped during a
+    Bluetooth profile transition, so that streams opened with "don't move",
+    such as the input level meter of GNOME Settings' Sound panel, are linked
+    after the two seconds instead of destroyed (LP: #<LP-WP-METER>).
+    - d/p/lp-2122640-do-not-mark-skipped-stream-handled.patch: set
+      was_handled in handleLinkable() only when createLink() was called;
+      corrects d/p/lp-2122640-bluetooth-audio-glitch.patch.
+
+ -- Iaroslav Voitovych <yaroslav.voytovych@gmail.com>  Sat, 14 Nov 2026 16:00:00 +0000
+
 wireplumber (0.4.17-1ubuntu4.1) noble; urgency=medium
 
   * d/p/lp-2122640-bluetooth-audio-glitch.patch
diff -Nru wireplumber-0.4.17/debian/patches/lp-2122640-do-not-mark-skipped-stream-handled.patch wireplumber-0.4.17/debian/patches/lp-2122640-do-not-mark-skipped-stream-handled.patch
--- wireplumber-0.4.17/debian/patches/lp-2122640-do-not-mark-skipped-stream-handled.patch	1970-01-01 00:00:00.000000000 +0000
+++ wireplumber-0.4.17/debian/patches/lp-2122640-do-not-mark-skipped-stream-handled.patch	2026-11-14 08:25:39.000000000 +0000
@@ -0,0 +1,30 @@
+Description: Do not mark a stream as handled when its link was skipped
+ lp-2122640-bluetooth-audio-glitch.patch skips the link of a new stream to a
+ non-Bluetooth target during the two seconds after a Bluetooth node was
+ removed, but handleLinkable() still sets was_handled for that stream. A stream
+ opened with "don't move" (PA_STREAM_DONT_MOVE, which pipewire-pulse turns into
+ dont-reconnect) is then treated, at the rescan that ends the two seconds, as
+ "already linked before": its target is dropped and the stream is destroyed
+ ("target not found", "destroy node"). GNOME Settings' Sound panel opens its
+ input level meter this way and does not retry, so after a headset leaves
+ Handsfree for A2DP the meter on the laptop's microphone stays dead.
+ Set was_handled only when a link was made, so that the rescan after the two
+ seconds links the stream.
+Author: Iaroslav Voitovych <yaroslav.voytovych@gmail.com>
+Origin: other, written for this update; corrects lp-2122640-bluetooth-audio-glitch.patch
+Bug-Ubuntu: https://bugs.launchpad.net/ubuntu/+source/wireplumber/+bug/<LP-WP-METER>
+Forwarded: not-needed
+Last-Update: 2026-11-14
+
+--- a/src/scripts/policy-node.lua
++++ b/src/scripts/policy-node.lua
+@@ -818,8 +818,8 @@
+   else
+     if skip_this_target == false then
+       createLink (si, si_target, can_passthrough, exclusive)
++      si_flags[si.id].was_handled = true
+     end
+-    si_flags[si.id].was_handled = true
+ 
+     checkFollowDefault (si, si_target, has_node_defined_target)
+   end
diff -Nru wireplumber-0.4.17/debian/patches/series wireplumber-0.4.17/debian/patches/series
--- wireplumber-0.4.17/debian/patches/series	2025-09-11 15:45:53.000000000 +0000
+++ wireplumber-0.4.17/debian/patches/series	2026-11-14 08:25:39.000000000 +0000
@@ -2,3 +2,4 @@
 Remove-privacy-breach-documentation.patch
 snap.patch
 lp-2122640-bluetooth-audio-glitch.patch
+lp-2122640-do-not-mark-skipped-stream-handled.patch
