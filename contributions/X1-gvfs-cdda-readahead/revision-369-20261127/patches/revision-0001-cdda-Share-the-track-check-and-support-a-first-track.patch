From a559213cd522cb6efce71ac4e2813160e646ab08 Mon Sep 17 00:00:00 2001
From: Iaroslav Voitovych <yaroslav.voytovych@gmail.com>
Date: Fri, 27 Nov 2026 05:47:18 +0100
Subject: [PATCH] cdda: Share the track check and support a first track above 1

Validate the track number in one helper that do_open_for_read() and do_query_info() both use, and refuse a disc whose first or last track number libcdio cannot report. do_query_info() compared the number only with the track count.

A disc need not start at track 1, so list the tracks from the first to the last track number in do_enumerate() and look up the metadata of a track by its offset from the first one in set_info_for_track().

Name libcdio, not paranoia, in the error for a failed sector lookup, as the lookup is libcdio's.
---
 daemon/gvfsbackendcdda.c | 57 ++++++++++++++++++++++++++--------------
 1 file changed, 38 insertions(+), 19 deletions(-)

diff --git a/daemon/gvfsbackendcdda.c b/daemon/gvfsbackendcdda.c
index aa376912..74a75467 100644
--- a/daemon/gvfsbackendcdda.c
+++ b/daemon/gvfsbackendcdda.c
@@ -465,6 +465,32 @@ get_track_num_from_name (const char *filename)
   return track_num;
 }
 
+/* Returns FALSE if libcdio can't tell the track numbers of the disc */
+static gboolean
+get_track_range (GVfsBackendCdda *cdda_backend,
+                 track_t *first_track,
+                 track_t *last_track)
+{
+  *first_track = cdio_get_first_track_num (cdda_backend->drive->p_cdio);
+  *last_track = cdio_get_last_track_num (cdda_backend->drive->p_cdio);
+
+  return *first_track != CDIO_INVALID_TRACK &&
+         *last_track != CDIO_INVALID_TRACK;
+}
+
+/* Only audio tracks between the first and last track number of the disc exist,
+ * the first one need not be 1 */
+static gboolean
+is_audio_track (GVfsBackendCdda *cdda_backend,
+                int track_num)
+{
+  track_t first_track, last_track;
+
+  return get_track_range (cdda_backend, &first_track, &last_track) &&
+         track_num >= first_track && track_num <= last_track &&
+         cdio_cddap_track_audiop (cdda_backend->drive, track_num);
+}
+
 typedef struct {
   cdrom_paranoia_t *paranoia;
 
@@ -613,7 +639,6 @@ do_open_for_read (GVfsBackend *backend,
                   const char *filename)
 {
   int track_num;
-  track_t first_track, last_track;
   ReadHandle *read_handle;
   GVfsBackendCdda *cdda_backend = G_VFS_BACKEND_CDDA (backend);
 
@@ -622,13 +647,8 @@ do_open_for_read (GVfsBackend *backend,
   read_handle = g_new0 (ReadHandle, 1);
 
   track_num = get_track_num_from_name (job->filename);
-  first_track = cdio_get_first_track_num (cdda_backend->drive->p_cdio);
-  last_track = cdio_get_last_track_num (cdda_backend->drive->p_cdio);
 
-  /* Only audio tracks on the disc can be opened */
-  if (track_num == -1 || last_track == CDIO_INVALID_TRACK ||
-      track_num < first_track || track_num > last_track ||
-      !cdio_cddap_track_audiop (cdda_backend->drive, track_num))
+  if (!is_audio_track (cdda_backend, track_num))
     {
       g_vfs_job_failed (G_VFS_JOB (job), G_IO_ERROR, G_IO_ERROR_NOT_FOUND,
                         _("No such file %s on drive %s"), job->filename, cdda_backend->device_path);
@@ -644,8 +664,8 @@ do_open_for_read (GVfsBackend *backend,
       read_handle->last_sector < read_handle->first_sector)
     {
       g_vfs_job_failed (G_VFS_JOB (job), G_IO_ERROR, G_IO_ERROR_FAILED,
-                        /* Translators: paranoia is the name of the cd audio reading library */
-                        _("Error from “paranoia” on drive %s"), cdda_backend->device_path);
+                        /* Translators: libcdio is the name of the cd access library */
+                        _("Error from “libcdio” on drive %s"), cdda_backend->device_path);
       free_read_handle (read_handle);
       return;
     }
@@ -877,7 +897,9 @@ set_info_for_track (GVfsBackendCdda *cdda_backend, GFileInfo *info, int track_nu
   g_file_info_set_attribute_boolean (info, G_FILE_ATTRIBUTE_ACCESS_CAN_TRASH, FALSE);
   g_file_info_set_attribute_boolean (info, G_FILE_ATTRIBUTE_ACCESS_CAN_RENAME, FALSE); 
 
-  track = g_list_nth_data (cdda_backend->tracks, track_num - 1);
+  /* The list starts with the first track of the disc, which need not be 1 */
+  track = g_list_nth_data (cdda_backend->tracks,
+                           track_num - cdio_get_first_track_num (cdda_backend->drive->p_cdio));
   if (track) {
     if (track->title)
       g_file_info_set_attribute_string (info, "xattr::org.gnome.audio.title", track->title);
@@ -945,14 +967,7 @@ do_query_info (GVfsBackend *backend,
           return;
         }
 
-      if (track_num > cdda_backend->drive->tracks)
-        {
-          error = g_error_new (G_IO_ERROR, G_IO_ERROR_NOT_FOUND, _("File doesn’t exist"));
-          g_vfs_job_failed_from_error (G_VFS_JOB (job), error);
-          return;
-        }
-
-      if (! cdio_cddap_track_audiop (cdda_backend->drive, track_num))
+      if (! is_audio_track (cdda_backend, track_num))
         {
           error = g_error_new (G_IO_ERROR, G_IO_ERROR_NOT_FOUND, _("The file does not exist or isn’t an audio track"));
           g_vfs_job_failed_from_error (G_VFS_JOB (job), error);
@@ -976,12 +991,16 @@ do_enumerate (GVfsBackend *backend,
   GVfsBackendCdda *cdda_backend = G_VFS_BACKEND_CDDA (backend);
   GFileInfo *info;
   GList *l;
+  track_t first_track, last_track;
   int n;
 
   //g_warning ("enumerate (%s)", filename);
 
   l = NULL;
-  for (n = 1; n <= cdda_backend->drive->tracks; n++)
+  if (!get_track_range (cdda_backend, &first_track, &last_track))
+    last_track = 0;
+
+  for (n = first_track; n <= last_track; n++)
     {
       char *name;
 
