+  long ra_want;        /* sector the client wants next */
+  gboolean ra_stop;    /* set when the handle is closed */
+  int ra_errno;        /* set when reading sector ra_start + ra_count failed */
+
 } ReadHandle;
 
+/* 10 s of audio */
+#define RA_SECTORS (10 * CDIO_CD_FRAMES_PER_SEC)
