+/* Called with ra_lock held: TRUE if @sector is in the read-ahead ring */
+static gboolean
+read_ahead_has (ReadHandle *read_handle, long sector)
+{
+  return sector >= read_handle->ra_start &&
+         sector < read_handle->ra_start + read_handle->ra_count;
+}
+
+static gpointer
+read_ahead_thread (gpointer user_data)
+{
+  ReadHandle *read_handle = user_data;
+  gboolean need_seek = TRUE;
+
+  g_mutex_lock (&read_handle->ra_lock);
+
+  while (!read_handle->ra_stop)
+    {
+      long next;
+      char *readbuf;
+      int errsv;
+
+      /* Start afresh if the client moved outside the ring, and drop the
+       * sectors before the one it wants.
+       */
+      if (read_handle->ra_want < read_handle->ra_start ||
+          read_handle->ra_want > read_handle->ra_start + read_handle->ra_count)
+        {
+          read_handle->ra_start = read_handle->ra_want;
+          read_handle->ra_count = 0;
+          read_handle->ra_errno = 0;
+          need_seek = TRUE;
+        }
+      else if (read_handle->ra_want > read_handle->ra_start)
+        {
+          read_handle->ra_count -= read_handle->ra_want - read_handle->ra_start;
+          read_handle->ra_start = read_handle->ra_want;
+        }
+
+      next = read_handle->ra_start + read_handle->ra_count;
+
+      if (read_handle->ra_errno != 0 ||
+          read_handle->ra_count == RA_SECTORS ||
+          next > read_handle->last_sector)
+        {
+          g_cond_wait (&read_handle->ra_cond, &read_handle->ra_lock);
+          continue;
+        }
+
+      g_mutex_unlock (&read_handle->ra_lock);
+
+      if (need_seek)
+        {
+          cdio_paranoia_seek (read_handle->paranoia, next, SEEK_SET);
+          need_seek = FALSE;
+        }
+
+      /* This may take seconds when paranoia refills its cache */
+      readbuf = (char *) cdio_paranoia_read (read_handle->paranoia, paranoia_callback);
+      errsv = errno;
+
+      g_mutex_lock (&read_handle->ra_lock);
+
+      /* Only this thread moves the ring, so the sector read is still the
+       * next one; a seek of the client is handled at the top of the loop.
+       */
+      if (readbuf == NULL)
+        {
+          read_handle->ra_errno = errsv != 0 ? errsv : EIO;
+        }
+      else
+        {
+          memcpy (read_handle->ra_buf + (next % RA_SECTORS) * CDIO_CD_FRAMESIZE_RAW,
+                  readbuf, CDIO_CD_FRAMESIZE_RAW);
+          read_handle->ra_count++;
+        }
+
+      g_cond_broadcast (&read_handle->ra_cond);
+    }
+
+  g_mutex_unlock (&read_handle->ra_lock);
+
+  return NULL;
+}
