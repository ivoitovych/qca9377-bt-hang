From fce94c238c709b7f7a67065452b89a673555ffc1 Mon Sep 17 00:00:00 2001
From: Iaroslav Voitovych <yaroslav.voytovych@gmail.com>
Date: Tue, 3 Nov 2026 13:35:55 +0100
Subject: [PATCH] cdda: Refuse to open invalid and non-audio tracks

do_open_for_read() passes whatever number it finds in the file name to
libcdio. For a track that is not on the disc, libcdio returns a
negative error code where a sector number is expected, and the first
read sends paranoia there. libcdio's track number is 8 bits wide, so
Track 257.wav opens track 1. The parser's sscanf("%d") cannot represent
Track 4294967297.wav at all; on the tested build it opened track 1 too.
Track 0 opens too, and so would the data tracks of a mixed-mode disc,
although enumerate does not list them and query_info refuses them.

Accept only the track numbers that enumerate lists: audio tracks from
1 to the number of tracks, checked before the number reaches libcdio.
Parse the number with g_ascii_string_to_unsigned(), which rejects
signs, trailing characters and numbers above 99. Leading zeros still
work, so Track 01.wav is still track 1. query_info uses the same
parser, so a name such as Track 1junk.wav, which it treated as
track 1, no longer exists there either.

If libcdio still reports a sector error after these checks, fail with
the existing "paranoia" error instead of reading. The lookups only read
the TOC in memory, so this needs a drive that is not open or a TOC
that is inconsistent.

The failure path now calls g_vfs_job_failed() directly instead of
allocating a GError it never freed, and the parser frees its copy of
the name when the name does not match.

With a 13-track disc in a USB drive, `gio cat` of Track 99.wav kept
the drive busy for more than five minutes until it was stopped, and
Track 257.wav and Track 4294967297.wav returned track 1. Now
Track -2, 0, 14, 99, 100, 257, 4294967297, 1junk, +1 and 1.wav.wav
fail at once with "No such file", and `gio info` also refuses
Track 1junk.wav. Track 1, 01, 0001 and 13 still read, and Track
0011.wav returns the same audio as Track 11.wav.
---
 daemon/gvfsbackendcdda.c | 38 +++++++++++++++++++++++++++-----------
 1 file changed, 27 insertions(+), 11 deletions(-)

diff --git a/daemon/gvfsbackendcdda.c b/daemon/gvfsbackendcdda.c
index ce01630..b4f6032 100644
--- a/daemon/gvfsbackendcdda.c
+++ b/daemon/gvfsbackendcdda.c
@@ -446,18 +446,23 @@ do_unmount (GVfsBackend *backend,
 static int
 get_track_num_from_name (const char *filename)
 {
-  int n;
+  guint64 n;
   char *basename;
+  int track_num = -1;
 
   basename = g_path_get_basename (filename);
-  if (sscanf (basename, "Track %d.wav", &n) == 1 &&
+  if (g_str_has_prefix (basename, "Track ") &&
       g_str_has_suffix (basename, ".wav"))
     {
-      g_free (basename);
-      return n;
+      /* Parse only the number between "Track " and ".wav" */
+      basename[strlen (basename) - strlen (".wav")] = '\0';
+      if (g_ascii_string_to_unsigned (basename + strlen ("Track "), 10,
+                                      1, CDIO_CD_MAX_TRACKS, &n, NULL))
+        track_num = n;
     }
 
-  return -1;
+  g_free (basename);
+  return track_num;
 }
 
 typedef struct {
@@ -608,7 +613,6 @@ do_open_for_read (GVfsBackend *backend,
                   const char *filename)
 {
   int track_num;
-  GError *error;
   ReadHandle *read_handle;
   GVfsBackendCdda *cdda_backend = G_VFS_BACKEND_CDDA (backend);
 
@@ -617,18 +621,30 @@ do_open_for_read (GVfsBackend *backend,
   read_handle = g_new0 (ReadHandle, 1);
 
   track_num = get_track_num_from_name (job->filename);
-  if (track_num == -1)
+  /* Only the audio tracks that enumerate lists can be opened */
+  if (track_num < 1 || track_num > cdda_backend->drive->tracks ||
+      !cdio_cddap_track_audiop (cdda_backend->drive, track_num))
     {
-      error = g_error_new (G_IO_ERROR, G_IO_ERROR_NOT_FOUND, 
-                           _("No such file %s on drive %s"), job->filename, cdda_backend->device_path);
-      g_vfs_job_failed_from_error (G_VFS_JOB (job), error);
+      g_vfs_job_failed (G_VFS_JOB (job), G_IO_ERROR, G_IO_ERROR_NOT_FOUND,
+                        _("No such file %s on drive %s"), job->filename, cdda_backend->device_path);
       free_read_handle (read_handle);
       return;
     }
 
-
   read_handle->first_sector = cdio_cddap_track_firstsector (cdda_backend->drive, track_num);
   read_handle->last_sector = cdio_cddap_track_lastsector (cdda_backend->drive, track_num);
+
+  /* libcdio returns negative error codes on failure */
+  if (read_handle->first_sector < 0 ||
+      read_handle->last_sector < read_handle->first_sector)
+    {
+      g_vfs_job_failed (G_VFS_JOB (job), G_IO_ERROR, G_IO_ERROR_FAILED,
+                        /* Translators: paranoia is the name of the cd audio reading library */
+                        _("Error from “paranoia” on drive %s"), cdda_backend->device_path);
+      free_read_handle (read_handle);
+      return;
+    }
+
   read_handle->sector_cursor = -1;
 
   read_handle->cursor = 0;
-- 
2.43.0

