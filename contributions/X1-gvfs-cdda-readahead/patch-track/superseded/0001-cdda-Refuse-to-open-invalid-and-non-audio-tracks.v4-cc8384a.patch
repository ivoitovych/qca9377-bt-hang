From 1c7c6ff1262b8a4e5a183979eb4b6f22cfc33512 Mon Sep 17 00:00:00 2001
From: Iaroslav Voitovych <yaroslav.voytovych@gmail.com>
Date: Tue, 3 Nov 2026 13:35:55 +0100
Subject: [PATCH] cdda: Refuse to open invalid and non-audio tracks

do_open_for_read() only checks whether get_track_num_from_name()
returns a track number. For a track that is not on the disc, libcdio
returns a negative error code where a sector number is expected, and
the backend opens a file that starts or ends at that negative number;
the first read then sends paranoia there. Track numbers above 255 wrap
in libcdio's 8-bit track type, so Track 257.wav opens track 1, and a
number too long for an int overflows in the parser's sscanf(), so
Track 4294967297.wav opens track 1 as well. Track 0 (the pregap, where
a disc has one) and the data tracks of a mixed-mode disc can be opened
too, although enumerate does not list them and query_info refuses
them, so they are not reachable through gvfsd-fuse.

Accept only the track numbers that enumerate lists: audio tracks 1 to
the last one, checked before the number reaches libcdio. Let the
parser read at most three digits, as a disc has at most 99 tracks, so
that no number can overflow into a valid one. For an accepted track
libcdio does not report an error today; should it report one for the
sector range anyway, fail the open as a paranoia error rather than as
a missing file, so that a negative sector never reaches paranoia.
While at it, fail the job without allocating a GError that was never
freed, and free the parser's basename when the name does not match.

With a 13-track audio disc in a USB drive, `gio cat` of Track 99.wav
kept the backend reading with the drive busy for more than five
minutes until it was stopped, and Track 257.wav and Track
4294967297.wav returned the audio of track 1. Now Track -2, 0, 14,
99, 255, 256, 257 and 4294967297 fail at once with "No such file",
and Track 1 and Track 13 still read afterwards.
---
 daemon/gvfsbackendcdda.c | 28 +++++++++++++++++++++-------
 1 file changed, 21 insertions(+), 7 deletions(-)

diff --git a/daemon/gvfsbackendcdda.c b/daemon/gvfsbackendcdda.c
index ce01630..4482785 100644
--- a/daemon/gvfsbackendcdda.c
+++ b/daemon/gvfsbackendcdda.c
@@ -450,13 +450,16 @@ get_track_num_from_name (const char *filename)
   char *basename;
 
   basename = g_path_get_basename (filename);
-  if (sscanf (basename, "Track %d.wav", &n) == 1 &&
+  /* A disc has at most 99 tracks; reading at most three digits keeps a
+   * longer number from overflowing into a valid track number */
+  if (sscanf (basename, "Track %3d.wav", &n) == 1 &&
       g_str_has_suffix (basename, ".wav"))
     {
       g_free (basename);
       return n;
     }
 
+  g_free (basename);
   return -1;
 }
 
@@ -608,7 +611,6 @@ do_open_for_read (GVfsBackend *backend,
                   const char *filename)
 {
   int track_num;
-  GError *error;
   ReadHandle *read_handle;
   GVfsBackendCdda *cdda_backend = G_VFS_BACKEND_CDDA (backend);
 
@@ -617,18 +619,30 @@ do_open_for_read (GVfsBackend *backend,
   read_handle = g_new0 (ReadHandle, 1);
 
   track_num = get_track_num_from_name (job->filename);
-  if (track_num == -1)
+  /* Only the audio tracks that enumerate lists can be opened */
+  if (track_num < 1 || track_num > cdda_backend->drive->tracks ||
+      !cdio_cddap_track_audiop (cdda_backend->drive, track_num))
     {
-      error = g_error_new (G_IO_ERROR, G_IO_ERROR_NOT_FOUND, 
-                           _("No such file %s on drive %s"), job->filename, cdda_backend->device_path);
-      g_vfs_job_failed_from_error (G_VFS_JOB (job), error);
+      g_vfs_job_failed (G_VFS_JOB (job), G_IO_ERROR, G_IO_ERROR_NOT_FOUND,
+                        _("No such file %s on drive %s"), job->filename, cdda_backend->device_path);
       free_read_handle (read_handle);
       return;
     }
 
-
   read_handle->first_sector = cdio_cddap_track_firstsector (cdda_backend->drive, track_num);
   read_handle->last_sector = cdio_cddap_track_lastsector (cdda_backend->drive, track_num);
+
+  /* libcdio returns negative error codes on failure */
+  if (read_handle->first_sector < 0 ||
+      read_handle->last_sector < read_handle->first_sector)
+    {
+      g_vfs_job_failed (G_VFS_JOB (job), G_IO_ERROR, G_IO_ERROR_FAILED,
+                        /* Translators: paranoia is the name of the cd audio reading library */
+                        _("Error from “paranoia” on drive %s"), cdda_backend->device_path);
+      free_read_handle (read_handle);
+      return;
+    }
+
   read_handle->sector_cursor = -1;
 
   read_handle->cursor = 0;
-- 
