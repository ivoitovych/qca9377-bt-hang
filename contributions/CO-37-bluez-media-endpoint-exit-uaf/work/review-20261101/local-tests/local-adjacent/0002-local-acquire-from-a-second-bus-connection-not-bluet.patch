From 1cf5c0b1781e28cf67b78ff2370309fd4624f9de Mon Sep 17 00:00:00 2001
From: local <local>
Date: Sun, 1 Nov 2026 10:37:18 +0100
Subject: [PATCH 2/3] local: acquire from a second bus connection, not
 bluetoothctl

bluetoothctl acquires only transports of its own endpoints
(client/player.c:5229-5232 at 14bd6ab65). Local only.
---
 test/functional/test_local_adjacent.py | 30 ++++++++++++++++++++++----
 1 file changed, 26 insertions(+), 4 deletions(-)

diff --git a/test/functional/test_local_adjacent.py b/test/functional/test_local_adjacent.py
index 4110477eb..eaed1c23d 100644
--- a/test/functional/test_local_adjacent.py
+++ b/test/functional/test_local_adjacent.py
@@ -43,6 +43,7 @@ pytestmark = [pytest.mark.vm]
 
 MEDIA_INTERFACE = "org.bluez.Media1"
 MEDIA_ENDPOINT_INTERFACE = "org.bluez.MediaEndpoint1"
+MEDIA_TRANSPORT_INTERFACE = "org.bluez.MediaTransport1"
 OBJECT_MANAGER_INTERFACE = "org.freedesktop.DBus.ObjectManager"
 
 APP_PATH = "/local/adjacent_app"
@@ -175,6 +176,27 @@ class EndpointClient(HostPlugin):
                 error_handler=self._error,
             )
 
+    def acquire_other(self, transport):
+        """
+        Acquire the transport from another client, a second bus
+        connection, and keep the file descriptor.
+        """
+        self._acquire_other(transport)
+        return self._wait_result()
+
+    def _acquired(self, fd, imtu, omtu):
+        self.fd = fd.take()
+        self.log.info(f"Other client acquired the transport: fd {self.fd}")
+        self.result = True
+
+    @mainloop_wrap
+    def _acquire_other(self, transport):
+        self.other_bus = get_dbus(private=True)
+        dbus.Interface(
+            self.other_bus.get_object("org.bluez", transport),
+            MEDIA_TRANSPORT_INTERFACE,
+        ).Acquire(reply_handler=self._acquired, error_handler=self._error)
+
     @mainloop_wrap
     def exit(self):
         self.log.info("Client leaves the bus")
@@ -268,10 +290,10 @@ def test_local_removed_while_held(hosts_once, registration, removal, teardown):
     transport = client.get_transport()
     source.expect(rf"Transport {transport}")
 
-    # Another client, bluetoothctl, acquires the transport, which locks
-    # the stream
-    source.send(f"transport.acquire {transport}\n")
-    source.expect(r"Acquire successful: fd \d+")
+    # Another client, on a second bus connection, acquires the
+    # transport, which locks the stream (bluetoothctl acquires only
+    # transports of its own endpoints)
+    assert client.acquire_other(transport) is True
 
     if removal == "unregister":
         assert client.unregister(registration) is True
-- 
