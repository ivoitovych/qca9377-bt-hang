Description: media: Fix sending Release twice to A2DP endpoints
 release_endpoint() sends Release to the endpoint and then removes it. For
 an A2DP endpoint this unregisters its SEP, whose destroy callback calls
 release_endpoint() again, which sends a second Release. This happens to
 every A2DP endpoint that path_free() releases, on adapter removal and on
 exit. Mark the endpoint as released once Release is sent.
Author: Iaroslav Voitovych <yaroslav.voytovych@gmail.com>
Origin: other, written for this update; fixes bd3ca4fdf463 ("Fix possible invalid read/free on media.c")
Bug-Ubuntu: https://bugs.launchpad.net/ubuntu/+source/bluez/+bug/<LP-U23>
Forwarded: no
Last-Update: 2026-11-14
---
diff --git a/profiles/audio/media.c b/profiles/audio/media.c
index 56c6774e1..e0ee2bae7 100644
--- a/profiles/audio/media.c
+++ b/profiles/audio/media.c
@@ -103,6 +103,7 @@ struct media_endpoint {
 	guint			hs_watch;
 	guint			ag_watch;
 	guint			watch;
+	bool			released;
 	GSList			*requests;
 	struct media_adapter	*adapter;
 	struct media_app	*app;
@@ -565,8 +566,8 @@ static void release_endpoint(struct media_endpoint *endpoint)
 
 	DBG("sender=%s path=%s", endpoint->sender, endpoint->path);
 
-	/* already exit */
-	if (endpoint->watch == 0)
+	/* already exit or released */
+	if (endpoint->watch == 0 || endpoint->released)
 		goto done;
 
 	clear_endpoint(endpoint);
@@ -581,6 +582,11 @@ static void release_endpoint(struct media_endpoint *endpoint)
 
 	g_dbus_send_message(btd_get_dbus_connection(), msg);
 
+	/* Removing the A2DP SEP below releases the endpoint again from its
+	 * destroy callback.
+	 */
+	endpoint->released = true;
+
 done:
 	media_endpoint_remove(endpoint);
 }
