diff -Nru bluez-5.72/debian/changelog bluez-5.72/debian/changelog
--- bluez-5.72/debian/changelog	2026-10-13 10:28:01.000000000 +0000
+++ bluez-5.72/debian/changelog	2026-11-14 03:39:44.000000000 +0000
@@ -1,3 +1,35 @@
+bluez (5.72-0ubuntu5.9) noble; urgency=medium
+
+  * Fix A2DP being disconnected when Release() cancels a pending Acquire();
+    the cancelled Acquire() is now answered with an error (LP: #<LP-U12>).
+    Cherry-picked from upstream (BlueZ 5.80): 3d9900eb754d (helper part
+    only), a14d59725ef3 and 664a5d3785a1.
+    - d/p/transport-Add-transport_a2dp_get_stream-helper.patch
+    - d/p/transport-don-t-disconnect-A2DP-if-canceling-Acquire-with-Release.patch
+    - d/p/a2dp-don-t-change-setup-sep-when-it-is-reconfiguring.patch
+  * btmon: fix abort (buffer overflow detected) in print_packet() when the
+    computed line width is negative or larger than the line buffer
+    (LP: #<LP-BTMON>). Cherry-picked from upstream: fdbfe0018f6f (BlueZ 5.80)
+    and dca0f10fd560 (master).
+    - d/p/monitor-Fix-crash-due-to-negative-max_len.patch
+    - d/p/monitor-clamp-max_len-in-print_packet.patch
+  * Fix use-after-free in bluetoothd at exit with a streaming sound server
+    (LP: #<LP-U23>): endpoints are released before their applications are
+    freed. The unlink is backported from upstream 7482aceece70; the other
+    two patches are written for this update.
+    - d/p/media-Unlink-endpoints-from-their-application-on-removal.patch
+    - d/p/media-Fix-sending-Release-twice-to-A2DP-endpoints.patch
+    - d/p/media-Fix-use-after-free-releasing-endpoints-on-adapter-removal.patch
+  * Fix use-after-free in bluetoothd at exit in discovery_cleanup()
+    (LP: #<LP-U24>). Cherry-picked from upstream (BlueZ 5.88): 7e3212fa233e.
+    - d/p/adapter-clear-discovery_found-list-before-discovery_cleanup.patch
+  * Report a refused A2DP connection as br-connection-refused instead of
+    br-connection-unknown (LP: #<LP-REFUSED>). Cherry-picked from upstream
+    (BlueZ 5.78): a6ac17f0e393.
+    - d/p/a2dp-Fix-connection-error-message.patch
+
+ -- Iaroslav Voitovych <yaroslav.voytovych@gmail.com>  Sat, 14 Nov 2026 12:00:00 +0000
+
 bluez (5.72-0ubuntu5.8) noble-security; urgency=medium
 
   * SECURITY REGRESSION: loading of cached A2DP remote SEPs broken by the
diff -Nru bluez-5.72/debian/patches/a2dp-Fix-connection-error-message.patch bluez-5.72/debian/patches/a2dp-Fix-connection-error-message.patch
--- bluez-5.72/debian/patches/a2dp-Fix-connection-error-message.patch	1970-01-01 00:00:00.000000000 +0000
+++ bluez-5.72/debian/patches/a2dp-Fix-connection-error-message.patch	2026-11-14 03:39:44.000000000 +0000
@@ -0,0 +1,24 @@
+Description: a2dp: Fix connection error message
+ When a headset has dropped the pairing, the A2DP connect fails with
+ ECONNREFUSED, which error_to_errno() turned into -EAGAIN, so the D-Bus error
+ was br-connection-unknown. Map ECONNREFUSED to itself so that the error is
+ br-connection-refused.
+Author: Frédéric Danis <frederic.danis@collabora.com>
+Origin: upstream, https://git.kernel.org/pub/scm/bluetooth/bluez.git/commit/?id=a6ac17f0e3932d6b07ced87e41fe7a108fe55149
+Applied-Upstream: 5.78, commit:a6ac17f0e3932d6b07ced87e41fe7a108fe55149
+Bug-Ubuntu: https://bugs.launchpad.net/ubuntu/+source/bluez/+bug/<LP-REFUSED>
+Forwarded: not-needed
+Last-Update: 2026-11-14
+---
+diff --git a/profiles/audio/a2dp.c b/profiles/audio/a2dp.c
+index 43da38051..a6489a763 100644
+--- a/profiles/audio/a2dp.c
++++ b/profiles/audio/a2dp.c
+@@ -326,6 +326,7 @@ static int error_to_errno(struct avdtp_error *err)
+ 	case EHOSTDOWN:
+ 	case ECONNABORTED:
+ 	case EBADE:
++	case ECONNREFUSED:
+ 		return -perr;
+ 	default:
+ 		/*
diff -Nru bluez-5.72/debian/patches/a2dp-don-t-change-setup-sep-when-it-is-reconfiguring.patch bluez-5.72/debian/patches/a2dp-don-t-change-setup-sep-when-it-is-reconfiguring.patch
--- bluez-5.72/debian/patches/a2dp-don-t-change-setup-sep-when-it-is-reconfiguring.patch	1970-01-01 00:00:00.000000000 +0000
+++ bluez-5.72/debian/patches/a2dp-don-t-change-setup-sep-when-it-is-reconfiguring.patch	2026-11-14 03:39:44.000000000 +0000
@@ -0,0 +1,50 @@
+From: Pauli Virtanen <pav@iki.fi>
+Date: Sat, 2 Nov 2024 22:29:46 +0200
+Subject: a2dp: don't change setup sep when it is reconfiguring
+
+If a2dp_resume/a2dp_suspend are called while setup is being
+reconfigured, they make the reconfiguration use wrong SEP.  This occurs
+if transport Acquire/Release are called while reconfiguration is waiting
+for CLOSE_RSP.
+
+Fix by failing a2dp_resume/suspend early without changing the setup, if
+it is reconfiguring.
+
+Such resume/suspend calls would in any case fail, because
+avdtp_close(stream) has been done, so avdtp_suspend/resume would return
+error.
+
+(backported from commit 664a5d3785a1a57989d236b6fd649321a39451f5)
+
+Origin: upstream, https://git.kernel.org/pub/scm/bluetooth/bluez.git/commit/?id=664a5d3785a1a57989d236b6fd649321a39451f5
+Applied-Upstream: 5.80, commit:664a5d3785a1a57989d236b6fd649321a39451f5
+Bug-Ubuntu: https://bugs.launchpad.net/ubuntu/+source/bluez/+bug/<LP-U12>
+Last-Update: 2026-11-14
+---
+ profiles/audio/a2dp.c | 6 ++++++
+ 1 file changed, 6 insertions(+)
+
+diff --git a/profiles/audio/a2dp.c b/profiles/audio/a2dp.c
+index 0cb8e61..10b52d6 100644
+--- a/profiles/audio/a2dp.c
++++ b/profiles/audio/a2dp.c
+@@ -3124,6 +3124,9 @@ unsigned int a2dp_resume(struct avdtp *session, struct a2dp_sep *sep,
+ 	cb_data->resume_cb = cb;
+ 	cb_data->user_data = user_data;
+ 
++	if (setup->reconfigure)
++		goto failed;
++
+ 	setup->sep = sep;
+ 	setup->stream = sep->stream;
+ 
+@@ -3182,6 +3185,9 @@ unsigned int a2dp_suspend(struct avdtp *session, struct a2dp_sep *sep,
+ 	cb_data->suspend_cb = cb;
+ 	cb_data->user_data = user_data;
+ 
++	if (setup->reconfigure)
++		goto failed;
++
+ 	setup->sep = sep;
+ 	setup->stream = sep->stream;
+ 
diff -Nru bluez-5.72/debian/patches/adapter-clear-discovery_found-list-before-discovery_cleanup.patch bluez-5.72/debian/patches/adapter-clear-discovery_found-list-before-discovery_cleanup.patch
--- bluez-5.72/debian/patches/adapter-clear-discovery_found-list-before-discovery_cleanup.patch	1970-01-01 00:00:00.000000000 +0000
+++ bluez-5.72/debian/patches/adapter-clear-discovery_found-list-before-discovery_cleanup.patch	2026-11-14 03:39:44.000000000 +0000
@@ -0,0 +1,28 @@
+Description: adapter: clear discovery_found list before discovery_cleanup()
+ discovery_cleanup() tries to reset the RSSI of the devices in the
+ adapter->discovery_found list. When it is called from adapter_remove(), the
+ list holds only stale pointers because the devices are already freed, which
+ is a use-after-free when bluetoothd exits (seen with AddressSanitizer at
+ src/device.c, device_set_rssi_with_delta()). Free the list in
+ adapter_remove() before discovery_cleanup().
+Author: Pauli Virtanen <pav@iki.fi>
+Origin: upstream, https://git.kernel.org/pub/scm/bluetooth/bluez.git/commit/?id=7e3212fa233edbdcfd69f93e2a7418819172c599
+Applied-Upstream: 5.88, commit:7e3212fa233edbdcfd69f93e2a7418819172c599
+Bug-Ubuntu: https://bugs.launchpad.net/ubuntu/+source/bluez/+bug/<LP-U24>
+Forwarded: not-needed
+Last-Update: 2026-11-14
+---
+diff --git a/src/adapter.c b/src/adapter.c
+index 022390f0d..a93d607de 100644
+--- a/src/adapter.c
++++ b/src/adapter.c
+@@ -6959,6 +6959,9 @@ static void adapter_remove(struct btd_adapter *adapter)
+ 	g_slist_free(adapter->load_keys);
+ 	adapter->load_keys = NULL;
+ 
++	g_slist_free(adapter->discovery_found);
++	adapter->discovery_found = NULL;
++
+ 	discovery_cleanup(adapter, 0);
+ 
+ 	unload_drivers(adapter);
diff -Nru bluez-5.72/debian/patches/media-Fix-sending-Release-twice-to-A2DP-endpoints.patch bluez-5.72/debian/patches/media-Fix-sending-Release-twice-to-A2DP-endpoints.patch
--- bluez-5.72/debian/patches/media-Fix-sending-Release-twice-to-A2DP-endpoints.patch	1970-01-01 00:00:00.000000000 +0000
+++ bluez-5.72/debian/patches/media-Fix-sending-Release-twice-to-A2DP-endpoints.patch	2026-11-14 03:39:44.000000000 +0000
@@ -0,0 +1,47 @@
+Description: media: Fix sending Release twice to A2DP endpoints
+ release_endpoint() sends Release to the endpoint and then removes it. For
+ an A2DP endpoint this unregisters its SEP, whose destroy callback calls
+ release_endpoint() again, which sends a second Release. This happens to
+ every A2DP endpoint that path_free() releases, on adapter removal and on
+ exit. Mark the endpoint as released once Release is sent.
+Author: Iaroslav Voitovych <yaroslav.voytovych@gmail.com>
+Origin: other, written for this update; fixes bd3ca4fdf463 ("Fix possible invalid read/free on media.c")
+Bug-Ubuntu: https://bugs.launchpad.net/ubuntu/+source/bluez/+bug/<LP-U23>
+Forwarded: no
+Last-Update: 2026-11-14
+---
+diff --git a/profiles/audio/media.c b/profiles/audio/media.c
+index 56c6774e1..e0ee2bae7 100644
+--- a/profiles/audio/media.c
++++ b/profiles/audio/media.c
+@@ -103,6 +103,7 @@ struct media_endpoint {
+ 	guint			hs_watch;
+ 	guint			ag_watch;
+ 	guint			watch;
++	bool			released;
+ 	GSList			*requests;
+ 	struct media_adapter	*adapter;
+ 	struct media_app	*app;
+@@ -565,8 +566,8 @@ static void release_endpoint(struct media_endpoint *endpoint)
+ 
+ 	DBG("sender=%s path=%s", endpoint->sender, endpoint->path);
+ 
+-	/* already exit */
+-	if (endpoint->watch == 0)
++	/* already exit or released */
++	if (endpoint->watch == 0 || endpoint->released)
+ 		goto done;
+ 
+ 	clear_endpoint(endpoint);
+@@ -581,6 +582,11 @@ static void release_endpoint(struct media_endpoint *endpoint)
+ 
+ 	g_dbus_send_message(btd_get_dbus_connection(), msg);
+ 
++	/* Removing the A2DP SEP below releases the endpoint again from its
++	 * destroy callback.
++	 */
++	endpoint->released = true;
++
+ done:
+ 	media_endpoint_remove(endpoint);
+ }
diff -Nru bluez-5.72/debian/patches/media-Fix-use-after-free-releasing-endpoints-on-adapter-removal.patch bluez-5.72/debian/patches/media-Fix-use-after-free-releasing-endpoints-on-adapter-removal.patch
--- bluez-5.72/debian/patches/media-Fix-use-after-free-releasing-endpoints-on-adapter-removal.patch	1970-01-01 00:00:00.000000000 +0000
+++ bluez-5.72/debian/patches/media-Fix-use-after-free-releasing-endpoints-on-adapter-removal.patch	2026-11-14 03:39:44.000000000 +0000
@@ -0,0 +1,46 @@
+Description: media: Fix use-after-free releasing endpoints on adapter removal
+ path_free() frees the applications before releasing the endpoints. Freeing
+ an application removes its endpoints, and removing an A2DP endpoint whose
+ stream is locked by an acquired transport is deferred by a2dp_remove_sep(),
+ so the endpoint stays in the adapter's list. release_endpoint() then clears
+ its transports, which unlocks the stream; the SEP is unregistered and its
+ destroy callback releases and frees the endpoint while clear_endpoint() is
+ still iterating over its transports (heap-use-after-free at
+ profiles/audio/media.c, clear_endpoint(), seen with AddressSanitizer when
+ bluetoothd exits while a sound server streams). Release the endpoints
+ first, so that their transports are cleared while their SEPs are still
+ registered and the removal is not deferred.
+Author: Iaroslav Voitovych <yaroslav.voytovych@gmail.com>
+Origin: other, written for this update; fixes ee0f3c03fb1d ("media: Fix UnregisterApplication")
+Bug-Ubuntu: https://bugs.launchpad.net/ubuntu/+source/bluez/+bug/<LP-U23>
+Forwarded: no
+Last-Update: 2026-11-14
+---
+diff --git a/profiles/audio/media.c b/profiles/audio/media.c
+index e0ee2bae7..ea2dec0bb 100644
+--- a/profiles/audio/media.c
++++ b/profiles/audio/media.c
+@@ -3280,8 +3280,12 @@ static void path_free(void *data)
+ 	struct media_adapter *adapter = data;
+ 	GSList *l;
+ 
+-	queue_destroy(adapter->apps, app_free);
+-
++	/* Release the endpoints before freeing the applications, which
++	 * removes them: the removal of an A2DP endpoint whose stream is
++	 * locked by a transport is deferred, and release_endpoint() would
++	 * then unlock it while clearing the transports, freeing the
++	 * endpoint it is still using.
++	 */
+ 	for (l = adapter->endpoints; l;) {
+ 		struct media_endpoint *endpoint	= l->data;
+ 
+@@ -3290,6 +3294,8 @@ static void path_free(void *data)
+ 		release_endpoint(endpoint);
+ 	}
+ 
++	queue_destroy(adapter->apps, app_free);
++
+ 	for (l = adapter->players; l;) {
+ 		struct media_player *mp = l->data;
+ 
diff -Nru bluez-5.72/debian/patches/media-Unlink-endpoints-from-their-application-on-removal.patch bluez-5.72/debian/patches/media-Unlink-endpoints-from-their-application-on-removal.patch
--- bluez-5.72/debian/patches/media-Unlink-endpoints-from-their-application-on-removal.patch	1970-01-01 00:00:00.000000000 +0000
+++ bluez-5.72/debian/patches/media-Unlink-endpoints-from-their-application-on-removal.patch	2026-11-14 03:39:44.000000000 +0000
@@ -0,0 +1,45 @@
+Description: media: Unlink endpoints from their application on removal
+ Backport for 5.72 of the endpoint part of upstream commit 7482aceece70
+ ("profiles/audio: fix UAF on external media service teardown"), with the
+ unlinking done before the A2DP SEP is removed. Needed by the next but one
+ patch: once path_free() releases the endpoints before freeing the
+ applications, app_free() must not find the released endpoints in its queue.
+Author: Iaroslav Voitovych <yaroslav.voytovych@gmail.com>
+Origin: backport, https://git.kernel.org/pub/scm/bluetooth/bluez.git/commit/?id=7482aceece7044e688f20f113263b50c21d69fb6
+Bug-Ubuntu: https://bugs.launchpad.net/ubuntu/+source/bluez/+bug/<LP-U23>
+Forwarded: no
+Last-Update: 2026-11-14
+---
+diff --git a/profiles/audio/media.c b/profiles/audio/media.c
+index 1faa1c289..56c6774e1 100644
+--- a/profiles/audio/media.c
++++ b/profiles/audio/media.c
+@@ -105,6 +105,7 @@ struct media_endpoint {
+ 	guint			watch;
+ 	GSList			*requests;
+ 	struct media_adapter	*adapter;
++	struct media_app	*app;
+ 	GSList			*transports;
+ };
+ 
+@@ -221,6 +222,11 @@ static void media_endpoint_remove(void *data)
+ 	struct media_endpoint *endpoint = data;
+ 	struct media_adapter *adapter = endpoint->adapter;
+ 
++	if (endpoint->app) {
++		queue_remove(endpoint->app->endpoints, endpoint);
++		endpoint->app = NULL;
++	}
++
+ 	if (endpoint->sep) {
+ 		a2dp_remove_sep(endpoint->sep);
+ 		return;
+@@ -2853,6 +2859,8 @@ static void app_register_endpoint(void *data, void *user_data)
+ 		return;
+ 	}
+ 
++	endpoint->app = app;
++
+ 	queue_push_tail(app->endpoints, endpoint);
+ 
+ 	return;
diff -Nru bluez-5.72/debian/patches/monitor-Fix-crash-due-to-negative-max_len.patch bluez-5.72/debian/patches/monitor-Fix-crash-due-to-negative-max_len.patch
--- bluez-5.72/debian/patches/monitor-Fix-crash-due-to-negative-max_len.patch	1970-01-01 00:00:00.000000000 +0000
+++ bluez-5.72/debian/patches/monitor-Fix-crash-due-to-negative-max_len.patch	2026-11-14 03:39:44.000000000 +0000
@@ -0,0 +1,30 @@
+Description: monitor: Fix crash due to negative max_len
+ btmon aborts (buffer overflow detected, SIGABRT) in print_packet() when the
+ computed max_len is negative, for example when decoding a MGMT Open record
+ with a long label at 80 columns or fewer. Discard the extra text if there
+ is not enough space for the text and the label.
+Author: Luiz Augusto von Dentz <luiz.von.dentz@intel.com>
+Origin: upstream, https://git.kernel.org/pub/scm/bluetooth/bluez.git/commit/?id=fdbfe0018f6f216ff089c0e1db848ec8ae16585e
+Bug-Ubuntu: https://bugs.launchpad.net/ubuntu/+source/bluez/+bug/<LP-BTMON>
+Forwarded: not-needed
+Last-Update: 2026-11-14
+---
+diff --git a/monitor/packet.c b/monitor/packet.c
+index 2eb50896b..b186431cf 100644
+--- a/monitor/packet.c
++++ b/monitor/packet.c
+@@ -490,6 +490,14 @@ static void print_packet(struct timeval *tv, struct ucred *cred, char ident,
+ 		int extra_len = extra ? strlen(extra) : 0;
+ 		int max_len = col - len - extra_len - ts_len - 3;
+ 
++		/* Check if there is enough space for the text and the label, if
++		 * there isn't then discard extra text since it won't fit.
++		 */
++		if (max_len <= 0) {
++			extra = NULL;
++			max_len = col - len - ts_len - 3;
++		}
++
+ 		n = snprintf(line + pos, max_len + 1, "%s%s",
+ 						label ? ": " : "", text);
+ 		if (n > max_len) {
diff -Nru bluez-5.72/debian/patches/monitor-clamp-max_len-in-print_packet.patch bluez-5.72/debian/patches/monitor-clamp-max_len-in-print_packet.patch
--- bluez-5.72/debian/patches/monitor-clamp-max_len-in-print_packet.patch	1970-01-01 00:00:00.000000000 +0000
+++ bluez-5.72/debian/patches/monitor-clamp-max_len-in-print_packet.patch	2026-11-14 03:39:44.000000000 +0000
@@ -0,0 +1,48 @@
+Description: monitor: clamp max_len in print_packet
+ print_packet() derives the snprintf() bound from the terminal width and
+ never bounds it against the space left in line[]. max_len can stay negative
+ after the recovery added by the previous patch, or exceed the buffer. Clamp
+ max_len to the space remaining in line[] and only write the ellipsis when
+ there is room for it.
+Author: Chad Spensky <chad@allthenticate.com>
+Origin: upstream, https://git.kernel.org/pub/scm/bluetooth/bluez.git/commit/?id=dca0f10fd560f8095493021ca2ac20236fde026e
+Bug: https://github.com/bluez/bluez/issues/1104
+Bug-Ubuntu: https://bugs.launchpad.net/ubuntu/+source/bluez/+bug/<LP-BTMON>
+Forwarded: not-needed
+Last-Update: 2026-11-14
+---
+diff --git a/monitor/packet.c b/monitor/packet.c
+index f0558b656..67837b8f0 100644
+--- a/monitor/packet.c
++++ b/monitor/packet.c
+@@ -605,13 +605,26 @@ static void print_packet(struct timeval *tv, struct ucred *cred, char ident,
+ 			max_len = col - len - ts_len - 3;
+ 		}
+ 
++		/* col comes from the terminal and len includes the optional
++		 * "comm[pid]: " prefix, so max_len can still be negative
++		 * here, or larger than the space left in line[]. Both
++		 * overflow the snprintf below, and a negative value also
++		 * indexes before line[].
++		 */
++		if (max_len > (int) sizeof(line) - pos - 1)
++			max_len = (int) sizeof(line) - pos - 1;
++		if (max_len < 0)
++			max_len = 0;
++
+ 		n = snprintf(line + pos, max_len + 1, "%s%s",
+ 						label ? ": " : "", text);
+ 		if (n > max_len) {
+-			line[pos + max_len - 1] = '.';
+-			line[pos + max_len - 2] = '.';
+-			if (line[pos + max_len - 3] == ' ')
+-				line[pos + max_len - 3] = '.';
++			if (max_len >= 3) {
++				line[pos + max_len - 1] = '.';
++				line[pos + max_len - 2] = '.';
++				if (line[pos + max_len - 3] == ' ')
++					line[pos + max_len - 3] = '.';
++			}
+ 
+ 			n = max_len;
+ 		}
diff -Nru bluez-5.72/debian/patches/series bluez-5.72/debian/patches/series
--- bluez-5.72/debian/patches/series	2026-10-13 10:26:09.000000000 +0000
