From e25ed6d129c100bddcaf53ccd5d4bc80612d1660 Mon Sep 17 00:00:00 2001
From: Iaroslav Voitovych <yaroslav.voytovych@gmail.com>
Date: Wed, 21 Oct 2026 05:32:32 +0200
Subject: [PATCH] tools/sco-tester: Add reconnect tests

Add two tests where a second socket connects to the same device after
the first one was closed by the host:

- "eSCO CVSD - Reconnect After Disconnect": the second socket connects
  once the Disconnect Complete of the first link was delivered. It shall
  get a link of its own.

- "eSCO CVSD - Reconnect During Disconnect": the emulator holds back the
  Disconnect Complete of the first link, the second socket connects, and
  the event is delivered afterwards. The connect shall be refused, or the
  second socket shall get a link of its own with its own Setup
  Synchronous Connection. It shall not be reported connected without a
  link and then be closed by the Disconnect Complete of the first one,
  which the kernel currently does.
---
 tools/sco-tester.c | 347 ++++++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 346 insertions(+), 1 deletion(-)

diff --git a/tools/sco-tester.c b/tools/sco-tester.c
index fca99a91c..8463116e4 100644
--- a/tools/sco-tester.c
+++ b/tools/sco-tester.c
@@ -27,6 +27,8 @@
 #include "monitor/bt.h"
 #include "emulator/bthost.h"
 #include "emulator/hciemu.h"
+#include "emulator/vhci.h"
+#include "emulator/btdev.h"
 
 #include "src/shared/tester.h"
 #include "src/shared/mgmt.h"
@@ -50,6 +52,15 @@ struct test_data {
 	uint16_t acl_handle;
 	uint16_t handle;
 	struct tx_tstamp_data tx_ts;
+
+	/* State of the reconnect tests */
+	int sk2;
+	unsigned int timer_id;
+	bool disc_held;
+	unsigned int sync_complete;
+	unsigned int setup_cmds;
+	int connect2_ret;
+	int connect2_errno;
 };
 
 struct sco_client_data {
@@ -78,6 +89,11 @@ struct sco_client_data {
 
 	/* Defer setup when accepting SCO connections */
 	bool defer;
+
+	/* Hold back the Disconnect Complete of the first link while a second
+	 * socket connects to the same peer.
+	 */
+	bool hold_disconnect;
 };
 
 static void print_debug(const char *str, void *user_data)
@@ -251,6 +267,16 @@ static void test_post_teardown(const void *test_data)
 {
 	struct test_data *data = tester_get_data();
 
+	if (data->timer_id) {
+		g_source_remove(data->timer_id);
+		data->timer_id = 0;
+	}
+
+	if (data->sk2 >= 0) {
+		close(data->sk2);
+		data->sk2 = -1;
+	}
+
 	hciemu_unref(data->hciemu);
 	data->hciemu = NULL;
 }
@@ -269,13 +295,14 @@ static void test_data_free(void *test_data)
 					_disable_sco_flowctl, _timeout) \
 	do { \
 		struct test_data *user; \
-		user = malloc(sizeof(struct test_data)); \
+		user = calloc(1, sizeof(struct test_data)); \
 		if (!user) \
 			break; \
 		user->hciemu_type = HCIEMU_TYPE_BREDRLE; \
 		user->io_id = 0; \
 		user->err_io_id = 0; \
 		user->sk = -1; \
+		user->sk2 = -1; \
 		user->test_data = data; \
 		user->step = 0; \
 		user->disable_esco = _disable_esco; \
@@ -329,6 +356,17 @@ static const struct sco_client_data connect_failure_reset = {
 	.expect_err = ECONNRESET
 };
 
+/* Connect again once the first link is gone */
+static const struct sco_client_data reconnect_after = {
+	.expect_err = 0,
+};
+
+/* Connect again while the first link's Disconnect Complete is pending */
+static const struct sco_client_data reconnect_during = {
+	.expect_err = 0,
+	.hold_disconnect = true,
+};
+
 const uint8_t data[] = {0, 1, 2, 3, 4, 5, 6, 7, 8};
 
 static const struct sco_client_data connect_recv_success = {
@@ -1309,6 +1347,305 @@ static void test_connect_acl_disc(const void *test_data)
 	test_connect(test_data);
 }
 
+#define RECONNECT_DELAY_MS	100
+#define RECONNECT_HOLD_MS	300
+#define RECONNECT_CHECK_MS	500
+
+static short sock2_poll(struct test_data *data)
+{
+	struct pollfd pfd = { .fd = data->sk2, .events = POLLOUT };
+
+	if (poll(&pfd, 1, 0) < 0)
+		return -1;
+
+	return pfd.revents;
+}
+
+static bool hook_reconnect_sync_evt(const void *buf, uint16_t len,
+							void *user_data)
+{
+	struct test_data *data = tester_get_data();
+	const struct bt_hci_evt_sync_conn_complete *evt = buf;
+
+	if (len < sizeof(*evt)) {
+		tester_warn("Bad event size");
+		tester_test_failed();
+		return true;
+	}
+
+	data->sync_complete++;
+	if (data->sync_complete == 1)
+		data->handle = le16_to_cpu(evt->handle);
+
+	tester_print("Sync Connection Complete #%u: handle %u status 0x%02x",
+				data->sync_complete, le16_to_cpu(evt->handle),
+				evt->status);
+	return true;
+}
+
+static void hook_reconnect_cmd(uint16_t opcode, const void *buf, uint8_t len,
+							void *user_data)
+{
+	struct test_data *data = user_data;
+
+	tester_print("Controller received command 0x%04x", opcode);
+
+	if (opcode == BT_HCI_CMD_SETUP_SYNC_CONN ||
+				opcode == BT_HCI_CMD_ENHANCED_SETUP_SYNC_CONN)
+		data->setup_cmds++;
+}
+
+static gboolean reconnect_second_connect(gpointer user_data);
+
+static void reconnect_arm_connect(struct test_data *data)
+{
+	if (!data->timer_id)
+		data->timer_id = g_timeout_add(RECONNECT_DELAY_MS,
+					reconnect_second_connect, NULL);
+}
+
+static bool hook_reconnect_disc_evt(const void *buf, uint16_t len,
+							void *user_data)
+{
+	struct test_data *data = tester_get_data();
+	const struct sco_client_data *scodata = data->test_data;
+	const struct bt_hci_evt_disconnect_complete *evt = buf;
+
+	if (len < sizeof(*evt)) {
+		tester_warn("Bad event size");
+		tester_test_failed();
+		return true;
+	}
+
+	tester_print("Disconnect Complete: handle %u reason 0x%02x",
+				le16_to_cpu(evt->handle), evt->reason);
+
+	/* Without the hold the second socket connects after the first link
+	 * is gone.
+	 */
+	if (!scodata->hold_disconnect &&
+			le16_to_cpu(evt->handle) == data->handle)
+		reconnect_arm_connect(data);
+
+	return true;
+}
+
+static bool hook_reconnect_hold_disc(const void *buf, uint16_t len,
+							void *user_data)
+{
+	struct test_data *data = tester_get_data();
+	const struct bt_hci_cmd_disconnect *cmd = buf;
+
+	/* The Command Status is already sent: the controller is "busy
+	 * disconnecting". Only the Disconnect Complete is held back.
+	 */
+	if (len < sizeof(*cmd) || le16_to_cpu(cmd->handle) != data->handle)
+		return true;
+
+	tester_print("Holding back the Disconnect Complete for handle %u",
+							data->handle);
+	data->disc_held = true;
+	reconnect_arm_connect(data);
+
+	return false;
+}
+
+static gboolean reconnect_check(gpointer user_data)
+{
+	struct test_data *data = tester_get_data();
+	short revents;
+	int sk_err = 0;
+	socklen_t len = sizeof(sk_err);
+
+	data->timer_id = 0;
+
+	revents = sock2_poll(data);
+	if (getsockopt(data->sk2, SOL_SOCKET, SO_ERROR, &sk_err, &len) < 0)
+		sk_err = errno;
+
+	tester_print("Second socket: poll 0x%04x, SO_ERROR %d (%s), "
+			"%u Synchronous Connection Complete, %u setup commands",
+			revents, sk_err, strerror(sk_err), data->sync_complete,
+			data->setup_cmds);
+
+	if (data->connect2_ret < 0 && data->connect2_errno != EAGAIN &&
+				data->connect2_errno != EINPROGRESS) {
+		/* Refusing the connect is as good as a new link */
+		tester_print("Second connect() refused: %s (%d)",
+				strerror(data->connect2_errno),
+				data->connect2_errno);
+		tester_test_passed();
+		return FALSE;
+	}
+
+	if (sk_err || (revents & (POLLERR | POLLHUP))) {
+		tester_warn("Second socket failed: %s (%d)", strerror(sk_err),
+								sk_err);
+		tester_test_failed();
+		return FALSE;
+	}
+
+	if (data->setup_cmds < 2 || data->sync_complete < 2) {
+		tester_warn("Second socket never got a link of its own");
+		tester_test_failed();
+		return FALSE;
+	}
+
+	if (!(revents & POLLOUT)) {
+		tester_warn("Second socket is not connected");
+		tester_test_failed();
+		return FALSE;
+	}
+
+	tester_test_passed();
+	return FALSE;
+}
+
+static gboolean reconnect_release(gpointer user_data)
+{
+	struct test_data *data = tester_get_data();
+	struct btdev *btdev = vhci_get_btdev(hciemu_get_vhci(data->hciemu));
+	struct bt_hci_evt_disconnect_complete ev;
+
+	data->timer_id = 0;
+
+	tester_print("Second socket: poll 0x%04x before Disconnect Complete",
+							sock2_poll(data));
+
+	memset(&ev, 0, sizeof(ev));
+	ev.status = BT_HCI_ERR_SUCCESS;
+	ev.handle = cpu_to_le16(data->handle);
+	ev.reason = BT_HCI_ERR_LOCAL_HOST_TERM;
+
+	tester_print("Delivering the held Disconnect Complete for handle %u",
+							data->handle);
+	if (btdev_send_event(btdev, BT_HCI_EVT_DISCONNECT_COMPLETE, &ev,
+							sizeof(ev))) {
+		tester_warn("Failed to send the Disconnect Complete");
+		tester_test_failed();
+		return FALSE;
+	}
+
+	data->timer_id = g_timeout_add(RECONNECT_CHECK_MS, reconnect_check,
+									NULL);
+	return FALSE;
+}
+
+static gboolean reconnect_second_connect(gpointer user_data)
+{
+	struct test_data *data = tester_get_data();
+	const struct sco_client_data *scodata = data->test_data;
+	const uint8_t *client_bdaddr;
+	struct sockaddr_sco addr;
+
+	data->timer_id = 0;
+
+	data->sk2 = create_sco_sock(data);
+	if (data->sk2 < 0) {
+		tester_test_failed();
+		return FALSE;
+	}
+
+	client_bdaddr = hciemu_get_client_bdaddr(data->hciemu);
+	if (!client_bdaddr) {
+		tester_warn("No client bdaddr");
+		tester_test_failed();
+		return FALSE;
+	}
+
+	memset(&addr, 0, sizeof(addr));
+	addr.sco_family = AF_BLUETOOTH;
+	bacpy(&addr.sco_bdaddr, (void *) client_bdaddr);
+
+	data->connect2_ret = connect(data->sk2, (struct sockaddr *) &addr,
+							sizeof(addr));
+	data->connect2_errno = data->connect2_ret < 0 ? errno : 0;
+
+	tester_print("Second connect() returned %d (%s), poll 0x%04x",
+			data->connect2_ret, strerror(data->connect2_errno),
+			sock2_poll(data));
+
+	if (scodata->hold_disconnect)
+		data->timer_id = g_timeout_add(RECONNECT_HOLD_MS,
+						reconnect_release, NULL);
+	else
+		data->timer_id = g_timeout_add(RECONNECT_CHECK_MS,
+						reconnect_check, NULL);
+
+	return FALSE;
+}
+
+static gboolean reconnect_first_connected(GIOChannel *io, GIOCondition cond,
+							gpointer user_data)
+{
+	struct test_data *data = tester_get_data();
+	int sk_err = 0;
+	socklen_t len = sizeof(sk_err);
+
+	data->io_id = 0;
+
+	if (getsockopt(data->sk, SOL_SOCKET, SO_ERROR, &sk_err, &len) < 0 ||
+								sk_err) {
+		tester_warn("First connect failed: %s (%d)", strerror(sk_err),
+								sk_err);
+		tester_test_failed();
+		return FALSE;
+	}
+
+	tester_print("First socket connected, closing it");
+
+	close(data->sk);
+	data->sk = -1;
+
+	return FALSE;
+}
+
+static void test_reconnect(const void *test_data)
+{
+	struct test_data *data = tester_get_data();
+	const struct sco_client_data *scodata = data->test_data;
+	GIOChannel *io;
+	int sk;
+
+	hciemu_add_hook(data->hciemu, HCIEMU_HOOK_POST_EVT,
+					BT_HCI_EVT_SYNC_CONN_COMPLETE,
+					hook_reconnect_sync_evt, NULL);
+	hciemu_add_hook(data->hciemu, HCIEMU_HOOK_POST_EVT,
+					BT_HCI_EVT_DISCONNECT_COMPLETE,
+					hook_reconnect_disc_evt, NULL);
+	hciemu_add_central_post_command_hook(data->hciemu,
+					hook_reconnect_cmd, data);
+
+	if (scodata->hold_disconnect)
+		hciemu_add_hook(data->hciemu, HCIEMU_HOOK_PRE_EVT,
+					BT_HCI_CMD_DISCONNECT,
+					hook_reconnect_hold_disc, NULL);
+
+	sk = create_sco_sock(data);
+	if (sk < 0) {
+		tester_test_failed();
+		return;
+	}
+
+	if (connect_sco_sock(data, sk) < 0) {
+		close(sk);
+		tester_test_failed();
+		return;
+	}
+
+	data->sk = sk;
+
+	io = g_io_channel_unix_new(sk);
+	g_io_channel_set_close_on_unref(io, FALSE);
+
+	data->io_id = g_io_add_watch(io, G_IO_OUT, reconnect_first_connected,
+									NULL);
+
+	g_io_channel_unref(io);
+
+	tester_print("Connect in progress");
+}
+
 static void test_sco_ethtool_get_ts_info(const void *test_data)
 {
 	struct test_data *data = tester_get_data();
@@ -1526,6 +1863,14 @@ int main(int argc, char *argv[])
 					&connect_failure_reset, setup_powered,
 					test_connect_acl_disc);
 
+	test_sco_full("eSCO CVSD - Reconnect After Disconnect",
+					&reconnect_after, setup_powered,
+					test_reconnect, false, false, false, 5);
+
+	test_sco_full("eSCO CVSD - Reconnect During Disconnect",
+					&reconnect_during, setup_powered,
+					test_reconnect, false, false, false, 5);
+
 	test_sco_11("SCO CVSD 1.1 - Success", &connect_success, setup_powered,
 							test_connect);
 
-- 
2.43.0

