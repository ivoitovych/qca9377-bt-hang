From c179a4589a4713f051bbdbc08d860c847d088ae0 Mon Sep 17 00:00:00 2001
From: Iaroslav Voitovych <yaroslav.voytovych@gmail.com>
Date: Thu, 22 Oct 2026 05:09:19 +0200
Subject: [PATCH] scratch: park hci_conn_timeout for SCO after refcnt 0
 (diagnostic, not for submission)

---
 net/bluetooth/hci_conn.c | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/net/bluetooth/hci_conn.c b/net/bluetooth/hci_conn.c
index 5cab719eec18e..828852578d093 100644
--- a/net/bluetooth/hci_conn.c
+++ b/net/bluetooth/hci_conn.c
@@ -26,6 +26,7 @@
 /* Bluetooth HCI connection handling. */
 
 #include <linux/export.h>
+#include <linux/delay.h>
 #include <linux/debugfs.h>
 #include <linux/errqueue.h>
 
@@ -574,6 +575,12 @@ void hci_sco_setup(struct hci_conn *conn, __u8 status)
 	}
 }
 
+/* SCRATCH DIAGNOSTIC (not part of any series): park the idle-disconnect worker
+ * of a SCO connection right after it observed refcnt == 0.
+ */
+static unsigned int w2c_park_ms;
+module_param(w2c_park_ms, uint, 0644);
+
 static void hci_conn_timeout(struct work_struct *work)
 {
 	struct hci_conn *conn = container_of(work, struct hci_conn,
@@ -594,6 +601,14 @@ static void hci_conn_timeout(struct work_struct *work)
 	if (refcnt > 0)
 		return;
 
+	if (w2c_park_ms && (conn->type == SCO_LINK || conn->type == ESCO_LINK)) {
+		pr_warn("w2c: hcon %p saw refcnt 0, parking %u ms\n", conn,
+			w2c_park_ms);
+		msleep(w2c_park_ms);
+		pr_warn("w2c: hcon %p released: refcnt %d abort_reason %u\n",
+			conn, atomic_read(&conn->refcnt), conn->abort_reason);
+	}
+
 	hci_abort_conn(conn, hci_proto_disconn_ind(conn));
 }
 
