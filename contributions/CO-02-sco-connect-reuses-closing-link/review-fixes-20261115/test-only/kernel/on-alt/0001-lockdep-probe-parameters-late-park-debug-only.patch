From f11d73f43af829dc843b657fdfe25dbe0d7b8257 Mon Sep 17 00:00:00 2001
From: Iaroslav Voitovych <yaroslav.voytovych@gmail.com>
Date: Sun, 15 Nov 2026 03:41:35 +0100
Subject: [PATCH 1/3] lockdep probe parameters, late park (debug only)

---
 net/bluetooth/hci_conn.c | 11 +++++++++++
 net/bluetooth/hci_sync.c | 10 ++++++++++
 2 files changed, 21 insertions(+)

diff --git a/net/bluetooth/hci_conn.c b/net/bluetooth/hci_conn.c
index 1fa84f3e9..030eb19eb 100644
--- a/net/bluetooth/hci_conn.c
+++ b/net/bluetooth/hci_conn.c
@@ -626,6 +626,9 @@ void hci_sco_setup(struct hci_conn *conn, __u8 status)
 	}
 }
 
+static unsigned int w2c_park_ms;
+module_param(w2c_park_ms, uint, 0644);
+
 static void hci_conn_timeout(struct work_struct *work)
 {
 	struct hci_conn *conn = container_of(work, struct hci_conn,
@@ -646,6 +649,14 @@ static void hci_conn_timeout(struct work_struct *work)
 	if (refcnt > 0)
 		return;
 
+	if (w2c_park_ms && (conn->type == SCO_LINK || conn->type == ESCO_LINK)) {
+		pr_warn("w2c: hcon %p saw refcnt 0, parking %u ms\n", conn,
+			w2c_park_ms);
+		msleep(w2c_park_ms);
+		pr_warn("w2c: hcon %p released: refcnt %d abort_reason %u\n",
+			conn, atomic_read(&conn->refcnt), conn->abort_reason);
+	}
+
 	hci_abort_conn(conn, hci_proto_disconn_ind(conn));
 }
 
diff --git a/net/bluetooth/hci_sync.c b/net/bluetooth/hci_sync.c
index 931494348..5ae454a82 100644
--- a/net/bluetooth/hci_sync.c
+++ b/net/bluetooth/hci_sync.c
@@ -7,6 +7,7 @@
  */
 
 #include <linux/property.h>
+#include <linux/delay.h>
 
 #include <net/bluetooth/bluetooth.h>
 #include <net/bluetooth/hci_core.h>
@@ -306,6 +307,12 @@ int hci_cmd_sync_status(struct hci_dev *hdev, u16 opcode, u32 plen,
 }
 EXPORT_SYMBOL(hci_cmd_sync_status);
 
+/* Debug only (lockdep probe, never posted): hold the cmd_sync worker in every round before it dequeues, so that
+ * an entry stays queued until hci_cmd_sync_clear() destroys it.
+ */
+static unsigned int w2c_park_sync_ms;
+module_param(w2c_park_sync_ms, uint, 0644);
+
 static void hci_cmd_sync_work(struct work_struct *work)
 {
 	struct hci_dev *hdev = container_of(work, struct hci_dev, cmd_sync_work);
@@ -316,6 +323,9 @@ static void hci_cmd_sync_work(struct work_struct *work)
 	while (1) {
 		struct hci_cmd_sync_work_entry *entry;
 
+		if (w2c_park_sync_ms)
+			msleep(w2c_park_sync_ms);
+
 		/* Leave the backlog to hci_cmd_sync_clear() */
 		if (hci_dev_test_flag(hdev, HCI_UNREGISTER))
 			break;
-- 
