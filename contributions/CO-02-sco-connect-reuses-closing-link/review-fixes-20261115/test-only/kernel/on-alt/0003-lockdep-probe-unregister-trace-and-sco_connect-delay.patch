From bcd9ef6c2a4a8adad313c6d6dab3257a0c667697 Mon Sep 17 00:00:00 2001
From: Iaroslav Voitovych <yaroslav.voytovych@gmail.com>
Date: Sun, 15 Nov 2026 03:57:40 +0100
Subject: [PATCH 3/3] lockdep probe: unregister trace and sco_connect delay
 (debug only)

---
 net/bluetooth/hci_core.c | 7 +++++++
 net/bluetooth/sco.c      | 8 ++++++++
 2 files changed, 15 insertions(+)

diff --git a/net/bluetooth/hci_core.c b/net/bluetooth/hci_core.c
index 0c0180a61..1aae87c9f 100644
--- a/net/bluetooth/hci_core.c
+++ b/net/bluetooth/hci_core.c
@@ -2781,6 +2781,7 @@ void hci_unregister_dev(struct hci_dev *hdev)
 {
 	BT_DBG("%p name %s bus %d", hdev, hdev->name, hdev->bus);
 
+	pr_warn("w2c-u: %s: unregister start\n", current->comm);
 	mutex_lock(&hdev->unregister_lock);
 	hci_dev_set_flag(hdev, HCI_UNREGISTER);
 	mutex_unlock(&hdev->unregister_lock);
@@ -2789,17 +2790,23 @@ void hci_unregister_dev(struct hci_dev *hdev)
 	list_del(&hdev->list);
 	write_unlock(&hci_dev_list_lock);
 
+	pr_warn("w2c-u: flag set, off the list\n");
 	synchronize_srcu(&hdev->srcu);
 	cleanup_srcu_struct(&hdev->srcu);
+	pr_warn("w2c-u: srcu done\n");
 
 	disable_work_sync(&hdev->rx_work);
+	pr_warn("w2c-u: rx_work disabled\n");
 	disable_work_sync(&hdev->cmd_work);
+	pr_warn("w2c-u: cmd_work disabled\n");
 	disable_work_sync(&hdev->tx_work);
+	pr_warn("w2c-u: tx_work disabled\n");
 	disable_work_sync(&hdev->power_on);
 	disable_work_sync(&hdev->error_reset);
 	disable_work_sync(&hdev->rfkill_block);
 	disable_delayed_work_sync(&hdev->cmd_timer);
 	disable_delayed_work_sync(&hdev->ncmd_timer);
+	pr_warn("w2c-u: timers disabled\n");
 	hci_devcd_shutdown(hdev);
 
 	hci_cmd_sync_clear(hdev);
diff --git a/net/bluetooth/sco.c b/net/bluetooth/sco.c
index 8be48ca9f..e900b8317 100644
--- a/net/bluetooth/sco.c
+++ b/net/bluetooth/sco.c
@@ -26,6 +26,7 @@
 #include <linux/seq_file.h>
 #include <linux/sched/signal.h>
 #include <linux/uio.h>
+#include <linux/delay.h>
 
 #include <net/bluetooth/bluetooth.h>
 #include <net/bluetooth/hci_core.h>
@@ -333,6 +334,10 @@ static int sco_chan_add(struct sco_conn *conn, struct sock *sk,
 	return err;
 }
 
+/* Debug only (lockdep probe, never posted) */
+static unsigned int w2c_sco_delay_ms;
+module_param(w2c_sco_delay_ms, uint, 0644);
+
 static int sco_connect(struct sock *sk)
 {
 	struct sco_conn *conn;
@@ -356,6 +361,9 @@ static int sco_connect(struct sock *sk)
 	if (!hdev)
 		return -EHOSTUNREACH;
 
+	if (w2c_sco_delay_ms)
+		msleep(w2c_sco_delay_ms);
+
 	hci_dev_lock(hdev);
 
 	if (lmp_esco_capable(hdev) && !disable_esco)
-- 
2.43.0

