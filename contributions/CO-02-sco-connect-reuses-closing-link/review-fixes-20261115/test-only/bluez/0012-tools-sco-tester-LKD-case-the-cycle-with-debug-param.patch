From dfd6c632a088b851585ba63f581293c729d07768 Mon Sep 17 00:00:00 2001
From: Iaroslav Voitovych <yaroslav.voytovych@gmail.com>
Date: Sun, 15 Nov 2026 03:31:48 +0100
Subject: [PATCH 12/17] tools/sco-tester: LKD case, the cycle with debug
 parameters (research)

---
 tools/sco-tester.c | 67 ++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 67 insertions(+)

diff --git a/tools/sco-tester.c b/tools/sco-tester.c
index e8df696b4..7f09b3539 100644
--- a/tools/sco-tester.c
+++ b/tools/sco-tester.c
@@ -87,6 +87,7 @@ enum reconnect_mode {
 	INCOMING_HELD,		/* Link set up by the remote, socket open */
 	INCOMING_FREE,		/* ... socket closed, nothing holds the link */
 	INCOMING_TEARDOWN,	/* ... socket closed, controller removed at once */
+	INCOMING_DEADLOCK,	/* ... connect() waits, controller removed, entry queued */
 };
 
 struct sco_client_data {
@@ -476,6 +477,11 @@ static const struct sco_client_data incoming_teardown = {
 	.reconnect = INCOMING_TEARDOWN,
 };
 
+static const struct sco_client_data incoming_deadlock = {
+	.server = true,
+	.reconnect = INCOMING_DEADLOCK,
+};
+
 static const struct sco_client_data incoming_free_transp = {
 	.server = true,
 	.reconnect = INCOMING_FREE,
@@ -2599,6 +2605,44 @@ static bool incoming_teardown_pass(void *user_data)
 	return false;
 }
 
+/* Research (LKD): the connect() runs in a child, so that the tester can end the test and remove the
+ * controller while the child waits inside the kernel
+ */
+static bool deadlock_connect(void *user_data)
+{
+	struct test_data *data = tester_get_data();
+	const uint8_t *client_bdaddr = hciemu_get_client_bdaddr(data->hciemu);
+	struct sockaddr_sco addr;
+	pid_t pid;
+
+	data->timer_id = 0;
+
+	data->sk2 = create_sco_sock(data);
+	if (!client_bdaddr || data->sk2 < 0) {
+		reconnect_end(data, false);
+		return false;
+	}
+
+	memset(&addr, 0, sizeof(addr));
+	addr.sco_family = AF_BLUETOOTH;
+	bacpy(&addr.sco_bdaddr, (void *) client_bdaddr);
+
+	pid = fork();
+	if (pid == 0) {
+		int ret = connect(data->sk2, (struct sockaddr *) &addr,
+							sizeof(addr));
+
+		printf("LKD child: connect() returned %d (%s)\n", ret,
+					ret < 0 ? strerror(errno) : "ok");
+		fflush(stdout);
+		_exit(0);
+	}
+
+	/* End the test while the child may still wait in the kernel */
+	reconnect_arm(data, 150, incoming_teardown_pass);
+	return false;
+}
+
 static bool incoming_accept(struct tester_io *io, uint32_t cond,
 							void *user_data)
 {
@@ -2618,6 +2662,23 @@ static bool incoming_accept(struct tester_io *io, uint32_t cond,
 	tester_print("Incoming link accepted");
 	data->sk = sk;
 
+	if (scodata->reconnect == INCOMING_DEADLOCK) {
+		/* disconnect worker held 600 ms, cmd_sync worker 300 ms with an
+		 * Add Extended Advertising Parameters entry queued behind it
+		 */
+		park_worker(600);
+		park_sync(300);
+		lk_dump = false;
+		mgmt_send(data->mgmt, MGMT_OP_ADD_EXT_ADV_PARAMS,
+				data->mgmt_index, sizeof(lk_ext_adv_params),
+				lk_ext_adv_params, NULL, NULL, NULL);
+		close(data->sk);
+		data->sk = -1;
+		tester_print("LKD: accepted socket closed, workers parked");
+		reconnect_arm(data, 30, deadlock_connect);
+		return false;
+	}
+
 	if (scodata->reconnect == INCOMING_FREE ||
 				scodata->reconnect == INCOMING_TEARDOWN) {
 		park_worker(INCOMING_PARK_MS);
@@ -2646,6 +2707,7 @@ static void test_incoming(const void *test_data)
 	 * debug-only w2c_park_ms parameter.
 	 */
 	if ((scodata->reconnect == INCOMING_FREE ||
+			scodata->reconnect == INCOMING_DEADLOCK ||
 			scodata->reconnect == INCOMING_TEARDOWN) &&
 			access("/sys/module/bluetooth/parameters/w2c_park_ms",
 								W_OK) < 0) {
@@ -2788,6 +2850,11 @@ int main(int argc, char *argv[])
 				&connect_success, setup_powered,
 				test_lk_extadv, 9);
 
+	/* LKD: the cycle itself, with the debug parameters; hangs a kernel in which it exists */
+	test_sco_ext("LKD Connect Waits While Controller Removed",
+				&incoming_deadlock, setup_powered,
+				test_incoming, 9);
+
 	test_sco_11("SCO CVSD 1.1 - Success", &connect_success, setup_powered,
 							test_connect);
 
