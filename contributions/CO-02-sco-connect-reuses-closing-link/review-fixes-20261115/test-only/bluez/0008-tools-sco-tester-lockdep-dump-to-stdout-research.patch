From f91396d0332e3479c4066618312acd6d572616e5 Mon Sep 17 00:00:00 2001
From: Iaroslav Voitovych <yaroslav.voytovych@gmail.com>
Date: Sun, 15 Nov 2026 02:59:59 +0100
Subject: [PATCH 08/17] tools/sco-tester: lockdep dump to stdout (research)

---
 tools/sco-tester.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/tools/sco-tester.c b/tools/sco-tester.c
index 58387a82d..378e50fc9 100644
--- a/tools/sco-tester.c
+++ b/tools/sco-tester.c
@@ -2262,7 +2262,7 @@ static void lockdep_dump(void)
 
 	f = fopen("/proc/lockdep", "r");
 	if (!f) {
-		fprintf(stderr, "LOCKDEP-DUMP: /proc/lockdep not readable\n");
+		printf("LOCKDEP-DUMP: /proc/lockdep not readable\n"); fflush(stdout);
 		return;
 	}
 
@@ -2291,7 +2291,7 @@ static void lockdep_dump(void)
 		if (show) {
 			if (n && line[n - 1] == '\n')
 				line[n - 1] = '\0';
-			fprintf(stderr, "LOCKDEP-DUMP: %s\n", line);
+			printf("LOCKDEP-DUMP: %s\n", line); fflush(stdout);
 		}
 	}
 
-- 
