# appended to the config of co20-diag's guest kernel (BlueZ tester.config + SMP 4 + dynamic debug):
# a virtual USB host controller, so that the real btusb binds to a userspace device
CONFIG_USBIP_CORE=y
CONFIG_USBIP_VHCI_HCD=y
CONFIG_USBIP_VHCI_HC_PORTS=8
CONFIG_USBIP_VHCI_NR_HCS=1
CONFIG_USB_ANNOUNCE_NEW_DEVICES=y
