+static BluetoothDevice *
+device_from_path (BluetoothClient *bluetooth_client,
+                  const char      *path)
+{
+	g_autoptr (GListStore) list_store;
+	guint length, i;
+	BluetoothDevice *result = NULL;
+	/* Find the device in the list of devices with the given path */
+	list_store = bluetooth_client_get_devices (bluetooth_client);
+	length = g_list_model_get_n_items (G_LIST_MODEL (list_store));
+	for (i = 0; i < length; i++) {
+		g_autoptr(BluetoothDevice) device = g_list_model_get_item (G_LIST_MODEL (list_store), i);
+		if (g_str_equal (path, bluetooth_device_get_object_path (device))) {
+			result = g_object_ref (device);
+		}
+	}
+	return result;
+}
