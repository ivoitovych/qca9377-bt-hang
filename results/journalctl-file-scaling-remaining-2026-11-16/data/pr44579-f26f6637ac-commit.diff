+                                        track_runner_up = false;
                                 continue;
                         }
 
@@ -1182,8 +1240,18 @@ static int real_journal_next(sd_journal *j, direction_t direction) {
                                 found = direction == DIRECTION_DOWN ? r < 0 : r > 0;
                         }
 
-                        if (found)
+                        if (found) {
