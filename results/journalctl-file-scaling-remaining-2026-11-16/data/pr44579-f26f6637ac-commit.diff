+                        archived = READ_NOW(f->header->state) == STATE_ARCHIVED;
 
                         r = next_beyond_location(j, f, direction, ts);
                         if (r < 0) {
@@ -1172,6 +1223,13 @@ static int real_journal_next(sd_journal *j, direction_t direction) {
                         } else if (r == 0) {
                                 f->location_type = direction == DIRECTION_DOWN ?
                                         LOCATION_TAIL : LOCATION_HEAD;
