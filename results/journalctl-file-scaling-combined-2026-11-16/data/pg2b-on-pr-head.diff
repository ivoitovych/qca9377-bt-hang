+                         * sorts before the winner's next one. */
+                        if (direction == DIRECTION_DOWN && !FLAGS_SET(j->flags, SD_JOURNAL_ASSUME_IMMUTABLE))
+                                online_eof = true;
+                        continue;
+                }
