+                if (best) {
+                        r = compare_locations(j, f, best);
+                        if (direction == DIRECTION_DOWN ? r >= 0 : r <= 0) {
+                                if (!second || (direction == DIRECTION_DOWN ? compare_locations(j, f, second) < 0 :
+                                                                              compare_locations(j, f, second) > 0))
+                                        second = f;
+                                continue;
+                        }
+                        second = best;
+                }
+                best = f;
+        }
+
+        /* The queued files: skip the candidates that are the entry just returned again (copies of it in other
+         * files), as the linear walk does for every file. */
+        for (;;) {
+                int k;
+
+                top = prioq_peek(j->heap);
+                if (!top)
+                        break;
+
+                assert(top->location_type == LOCATION_SEEK);
+
+                k = compare_with_location(j, top, &j->current_location, j->current_file);
+                if (direction == DIRECTION_DOWN ? k > 0 : k < 0)
+                        break;
+
+                r = next_beyond_location(j, top, direction, ts);
+                if (r < 0) {
+                        log_debug_errno(r, "Can't iterate through %s, ignoring: %m", top->path);
+                        remove_file_real(j, top);
+                        return -EAGAIN;
+                }
+                if (r == 0) {
+                        prioq_remove(j->heap, top, &top->heap_idx);
+                        top->location_type = done;
+                        continue;
+                }
+                prioq_reshuffle(j->heap, top, &top->heap_idx);
+        }
+
+        new_file = top;
+        if (best) {
+                if (!top)
+                        new_file = best;
+                else {
+                        r = compare_locations(j, best, top);
+                        if (r == 0 ? best->heap_order < top->heap_order : (direction == DIRECTION_DOWN ? r < 0 : r > 0))
+                                new_file = best;
+                }
+        }
+        if (!new_file)
+                return 0;
+
+        /* The runner-up: the best candidate of all the other files, for the cheap path in front of the queue. */
+        JournalFile *runner_up;
+        if (new_file == top) {
+                assert_se(prioq_pop(j->heap) == top);
+                runner_up = prioq_peek(j->heap);
+                if (best && (!runner_up || (direction == DIRECTION_DOWN ? compare_locations(j, best, runner_up) < 0 :
+                                                                          compare_locations(j, best, runner_up) > 0)))
+                        runner_up = best;
+        } else {
+                runner_up = top;
+                if (second && (!runner_up || (direction == DIRECTION_DOWN ? compare_locations(j, second, runner_up) < 0 :
+                                                                            compare_locations(j, second, runner_up) > 0)))
+                        runner_up = second;
+        }
+
+        r = journal_file_move_to_object(new_file, OBJECT_ENTRY, new_file->current_offset, &o);
+        if (r < 0)
+                goto drop;
+
+        /* Only after a file has won twice in a row, as in the full scan. */
+        bool track = new_file == cf && !online_eof;
+
+        set_location(j, new_file, o);
+        j->heap_last = new_file;
+        j->scan_same_file = new_file == cf;
+
+        if (track) {
+                j->scan_winner = new_file;
+                j->scan_runner_up = runner_up;
+                j->scan_direction = direction;
+                j->scan_valid_until = usec_add(ts, USEC_PER_SEC);
+        }
+
+        return 1;
+
+drop:
+        /* Let the linear walk deal with it. */
+        heap_drop(j);
+        return -EAGAIN;
+}
