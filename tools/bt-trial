#!/bin/bash
# bt-trial — run one numbered trial of the fixed reproduction protocol.
#
#   bt-trial protocol                 print the protocol and stop
#   bt-trial start <build>            begin a trial of <build> (e.g. stock, A, B, C, D)
#   bt-trial step "<what you did>"    mark a protocol step (optional but recommended)
#   bt-trial hang                     record: the controller hung
#   bt-trial ok                       record: it survived (verifies the controller answers)
#   bt-trial abort                    discard the open trial
#   bt-trial report                   failure rate per build — the denominators
#
# WHY: "the patched build ran for an hour" means nothing without a baseline. This
# project has mistaken absence-of-observed-failure for a fix more than once. Every
# build must be measured against the SAME protocol, and stock must be measured
# first — target 5/5 failures before anything is compiled.
#
# Each trial records its own before/after state, the operator's steps with
# timestamps, and (on a hang) an automatic bt-incident collection.

set -uo pipefail

# Shared civil-date arithmetic. Two intervals here previously used
# (day_of_month * 24 + hour) arithmetic, silently catastrophic across a month
# boundary. bt-phase was fixed in isolation, leaving these wrong and a second
# implementation to maintain; see tools/lib/timestamp.awk.
LIBDIR="${BT_LIBDIR:-$(dirname "$(readlink -f "$0")")/lib}"
[[ -r "$LIBDIR/timestamp.awk" ]] || { echo "bt-trial: missing $LIBDIR/timestamp.awk" >&2; exit 1; }

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="${BT_REPO:-}"
if [[ -z "$REPO" ]]; then
    for c in "$HERE/.." /root/exp/qca9377-bt-hang "$PWD"; do
        [[ -d "$c/.git" && -e "$c/install.sh" ]] && { REPO=$(cd "$c" && pwd); break; }
    done
fi
[[ -n "$REPO" ]] || { echo "no checkout found; set BT_REPO" >&2; exit 2; }

TRIALS="$REPO/evidence/trials"
RESULTS="$TRIALS/results.tsv"
# Overridable so tests can drive the REAL trial lifecycle — open, close,
# classify, write a row — without touching the live auto-trial. Testing the
# report against a prebuilt results.tsv proved insufficient: it validated the
# consumer while the producer was broken.
STATE="${BT_STATE:-/run/bt-trial}"
CUR="$STATE/current"

G=$'\033[32m'; R=$'\033[31m'; Y=$'\033[33m'; B=$'\033[1m'; O=$'\033[0m'
[[ -t 1 ]] || { G=""; R=""; Y=""; B=""; O=""; }

# ── THE PROTOCOL ──────────────────────────────────────────────────────────
# Fixed. Changing it invalidates comparison with every trial already recorded;
# if it must change, bump PROTOCOL_VERSION so old and new trials are not mixed.
PROTOCOL_VERSION=2
protocol() {
cat <<'EOF'
PROTOCOL v2 — one trial

  0. Cold-boot the machine (POWER-OFF, not reboot) if the controller is down.
     BELIEVED, NOT MEASURED: that a warm reboot does not drop the M.2 power
     rail and so will not recover it. That is hardware reasoning which entered
     this protocol as fact; no exhibit supports it, and on 2026-08-13 the
     controller did recover across a shutdown that reached reboot.target
     (EX-017, EX-019). Keep powering off — it certainly works, and a failed
     recovery costs a trial — but do not repeat the claim as established.
  1. bt-trial start <build>
  2. Connect the Sennheiser Momentum 4. Wait until it appears as an audio
     device in Settings -> Sound.
  3. Start audio playback. Let it run ~10 s.
  4. In Settings -> Sound, switch the device PROFILE:
        High Fidelity Playback (A2DP)  <->  Headset Head Unit (HFP)
     Wait ~5 s after each switch, with audio still playing.
  5. Repeat step 4 up to TEN times, alternating back and forth.
     Stop early the moment the controller dies.
  6. If still alive after ten switches: disconnect, reconnect, play again.
     Do that THREE times.
  7. bt-trial hang    (controller died)
     bt-trial ok      (survived all of the above)

  WHY THE COUNTS ARE FIXED. A trial only produces a denominator if "ok"
  means something definite. "I stopped and it was still working" is not a
  survival — it is an unfinished trial. Ten switches plus three reconnect
  cycles is drawn from the operator's estimate that failure normally
  arrives within several cycles, so it should sit comfortably beyond the
  usual failure point without running indefinitely.

  If a trial survives the full protocol repeatedly, the protocol is too
  short and must be lengthened — but lengthen it BEFORE the next trial and
  restart the count, never mid-series.

  Record each step you actually perform with:
     bt-trial step "switched to XQ"

  Run the SAME steps for every build. Deviations make the comparison worthless —
  note them with `bt-trial step` if they happen.
EOF
}

# The USB sysfs root, overridable so the lifecycle tests can drive the real
# detection logic against a fabricated device tree.
#
# WHY THIS SEAM EXISTS. The lifecycle tests close trials with `ok` and assert
# the resulting classification. hci_alive() reads the live machine, so those
# assertions silently depended on the controller being UP: with the radio dead
# — the exact state the project exists to study — every `ok` was reclassified
# `failed` and four invariants failed for a reason that had nothing to do with
# the code under test. A test suite that only passes while the hardware is
# healthy cannot be trusted to report on the hardware.
SYSFS_USB="${BT_SYSFS_USB:-/sys/bus/usb/devices}"

hci_alive() {
    local d dev="" h=""
    for d in "$SYSFS_USB"/*; do
        [[ -f "$d/idVendor" && -f "$d/idProduct" ]] || continue
        [[ "$(<"$d/idVendor")" == "${BT_VID:-13d3}" && "$(<"$d/idProduct")" == "${BT_PID:-3503}" ]] \
            && { dev="$d"; break; }
    done
    [[ -n "$dev" ]] || return 1
    for p in "$dev"/*/bluetooth/hci*; do [[ -e "$p" ]] && h=$(basename "$p") && break; done
    [[ -n "$h" ]] || return 1
    command -v hciconfig >/dev/null 2>&1 || return 2
    timeout 6 hciconfig "$h" name >/dev/null 2>&1
}

# ── EXPERIMENTAL ENVIRONMENT FINGERPRINT ──────────────────────────────────
#
# `build=stock` names the KERNEL and nothing else. The machine this runs on is
# not a pristine Ubuntu Bluetooth system — it is a stock kernel inside an
# instrumented and partially mitigated environment:
#
#   * USB autosuspend is disabled for btusb and the radio is pinned
#     power/control=on. Original state was Y and auto. This changes the
#     controller's operating conditions from boot onward, so EVERY observation
#     here — failure or survival — happens under it.
#   * A recovery watchdog is running. It can stop bluetooth, issue
#     USBDEVFS_RESET, unbind/rebind the device and restart the stack. Anything
#     after the first timeout is therefore partly our doing: whether stage 2 was
#     reached, how long stage 1 lasted, whether the boot ended with a live
#     controller.
#   * On this host BT_EARLY=1 via a drop-in, so the watchdog can reset the
#     controller BEFORE any HCI timeout, on audio-teardown heuristics. Even the
#     pre-timeout window is not passive.
#   * Periodic health probes issue a real HCI command (EX-011), and dynamic
#     debug plus tracing alter timing and load.
#
# Without recording this, trials taken under different mitigation states pool
# under one build name and the denominator silently mixes treatments. The
# project made measurement provenance first-class; this makes TREATMENT
# provenance first-class, which is the same discipline applied to the other
# half of the experiment.
# True when treat_end differs from treat_start ONLY by fields that became `?`.
#
# Compares field by field. A field that holds a real value at open and `?` at
# close became UNREADABLE; any other difference is a real change. Both strings
# are comma-separated key=value, produced by env_fingerprint above.
treatment_only_became_unreadable() {
    local a="$1" b="$2" i
    local -a fa fb
    IFS=',' read -r -a fa <<< "$a"
    IFS=',' read -r -a fb <<< "$b"
    (( ${#fa[@]} == ${#fb[@]} )) || return 1
    for i in "${!fa[@]}"; do
        [[ "${fa[$i]}" == "${fb[$i]}" ]] && continue
        # Same key, and the closing value is `?` — unreadable, not changed.
        [[ "${fa[$i]%%=*}" == "${fb[$i]%%=*}" && "${fb[$i]#*=}" == "?" ]] || return 1
    done
    return 0
}

env_fingerprint() {
    local autosusp power wd early thr probes commit dev
    autosusp=$(cat /sys/module/btusb/parameters/enable_autosuspend 2>/dev/null || echo '?')
    power='?'
    for dev in "$SYSFS_USB"/*; do
        [[ -f "$dev/idVendor" && -f "$dev/idProduct" ]] || continue
        if [[ "$(<"$dev/idVendor")" == "${BT_VID:-13d3}" && "$(<"$dev/idProduct")" == "${BT_PID:-3503}" ]]; then
            power=$(cat "$dev/power/control" 2>/dev/null || echo '?'); break
        fi
    done
    # Every probe inside this function has BOTH streams redirected. The
    # function's stdout IS the fingerprint, so anything else that prints lands
    # inside the value — and a newline there corrupts the TSV row. `--quiet`
    # already suppresses output for real systemctl; this makes the guarantee
    # structural rather than dependent on a flag behaving as documented.
    if systemctl is-active --quiet bt-hang-watchdog >/dev/null 2>&1; then
        early=$(systemctl show bt-hang-watchdog -p Environment --value 2>/dev/null \
                | tr ' ' '\n' | grep -m1 '^BT_EARLY=' | cut -d= -f2)
        thr=$(systemctl show bt-hang-watchdog -p Environment --value 2>/dev/null \
              | tr ' ' '\n' | grep -m1 '^BT_THRESHOLD=' | cut -d= -f2)
        wd=$([[ "${early:-0}" == "1" ]] && echo "early+late" || echo "late")
        wd="$wd/thr${thr:-?}"
    else
        wd="off"
    fi
    # `systemctl is-active` PRINTS "inactive" and RETURNS non-zero, so
    # `... || echo inactive` emitted it twice — putting a newline inside the
    # treatment fingerprint and therefore inside the TSV row. The A/B/C/D
    # checklist requires probes OFF, which is exactly the state that triggered
    # it. A boolean test yields a canonical token instead.
    if systemctl is-active --quiet bt-health-snapshot.timer >/dev/null 2>&1; then
        probes=on
    else
        probes=off
    fi
    printf 'autosusp=%s,power=%s,wd=%s,probes=%s' \
        "${autosusp:-?}" "$power" "$wd" "$probes"
}

# MEASUREMENT PROVENANCE IS NOT TREATMENT.
#
# The instrumentation revision belongs in the record but must NOT key the
# denominator. Every tooling fix would otherwise open a new experimental cell —
# a report-formatting change would split trials that are the same experiment,
# and a five-trial series would fragment into five singletons.
#
# The distinction is what a change can affect:
#   treatment   can alter how the CONTROLLER behaves — autosuspend, power
#               policy, watchdog mode and thresholds, active health probes.
#               Mixing these in one rate is a category error.
#   measurement can alter what we SEE — parser versions, capture code, report
#               layout. Recorded so a discrepancy can be traced, and pooled
#               across unless a specific change altered event detection, which
#               is a judgement to make explicitly rather than automatically.
measurement_revision() {
    git -C "$REPO" rev-parse --short HEAD 2>/dev/null || echo '?'
}

next_trial_no() {
    # Resolve the column from the header, never by position. Adding trial_type
    # shifted `build` from field 2 to field 3, and a hardcoded $2 would silently
    # have counted trial_type values instead — restarting numbering at 1 and
    # overwriting an existing trial directory. The report was already guarded
    # this way; this call site was not.
    local build="$1" n
    n=$(awk -F'\t' -v b="$build" '
        NR == 1 { for (i = 1; i <= NF; i++) c[$i] = i
                  if (!("build" in c)) { print "NOHEADER"; exit 1 }
                  next }
        $c["build"] == b { n++ }
        END { print n + 0 }' "$RESULTS" 2>/dev/null)
    [[ "$n" == "NOHEADER" || -z "$n" ]] && n=0
    echo $(( n + 1 ))
}

case "${1:-}" in

protocol) protocol ;;

start)
    build="${2:?usage: bt-trial start <build>   (stock, A, B, C, D)}"
    [[ -e "$CUR" ]] && { echo "a trial is already open:"; sed 's/^/  /' "$CUR"; exit 1; }
    if ! hci_alive; then
        echo "${R}Controller is not responding.${O} Cold power-off first — a trial that"
        echo "starts on a dead controller measures nothing."
        exit 1
    fi
    mkdir -p "$STATE" "$TRIALS"
    n=$(next_trial_no "$build")
    dir="$TRIALS/$build/trial-$(printf '%02d' "$n")"
    mkdir -p "$dir"
    { echo "start=$(date +%s)"; echo "build=$build"; echo "n=$n"; echo "dir=$dir"
      echo "treat_start=$(env_fingerprint)"
      echo "mrev_start=$(measurement_revision)"; } > "$CUR"
    command -v bt-state >/dev/null 2>&1 && bt-state > "$dir/state-before.txt" 2>&1
    : > "$dir/steps.log"
    command -v bt-mark >/dev/null 2>&1 && bt-mark "TRIAL $build #$n START (protocol v$PROTOCOL_VERSION)" >/dev/null 2>&1
    echo "${B}Trial $build #$n started${O}  (protocol v$PROTOCOL_VERSION)"
    echo "  uptime: $(uptime -p)"
    echo
    protocol | sed -n '3,10p'
    echo
    echo "  then: bt-trial hang   |   bt-trial ok"
    ;;

autostart)
    # Open a trial automatically at boot.
    #
    # WHY. Asking the operator to run `bt-trial start` by hand loses the window
    # that matters. Bluetooth comes up with the system and begins scanning
    # before anyone can reach a terminal, and the environment contains devices
    # that cannot be switched off — so by the time a trial was opened manually,
    # an uncontrolled and unrecorded set of events had already happened. Worse,
    # in practice no trial was ever open when the controller died, so the
    # structured fields captured nothing on the three occasions they were built
    # for.
    #
    # Every boot is therefore a trial, opened by bt-trial-auto.service before
    # bluetooth.service starts. It is closed either by the watchdog when the
    # controller dies, or at shutdown by `autostop`.
    #
    # NOTE ON WHAT THIS MEASURES. The denominator this produces is
    # observational — boots-with-a-hang over total boots under ordinary use —
    # not a controlled protocol. It is weaker evidence than a fixed reproducer
    # and must be reported as such. It is also real data, where the manual
    # protocol produced none.
    build="${2:-${BT_BUILD:-stock}}"
    [[ -e "$CUR" ]] && exit 0          # already open; nothing to do
    mkdir -p "$STATE" "$TRIALS"
    n=$(next_trial_no "$build")
    dir="$TRIALS/$build/trial-$(printf '%02d' "$n")"
    mkdir -p "$dir"
    # Captured AT START. The row must answer "what was this trial exposed to?",
    # not "what existed when it ended". An auto-trial spans a whole boot, and
    # this project reconfigures and reinstalls instrumentation while one is
    # open — so closing-time capture could describe a three-hour boot by the
    # configuration of its last minute.
    { echo "start=$(date +%s)"; echo "build=$build"; echo "n=$n"; echo "dir=$dir"
      echo "auto=1"
      echo "treat_start=$(env_fingerprint)"
      echo "mrev_start=$(measurement_revision)"; } > "$CUR"
    command -v bt-state >/dev/null 2>&1 && bt-state > "$dir/state-before.txt" 2>&1
    : > "$dir/steps.log"
    echo "auto-trial $build #$n opened at boot"
    ;;

autostop)
    # Close an auto-opened trial at shutdown, classifying by what the controller
    # is actually doing rather than by what anyone intended.
    [[ -e "$CUR" ]] || exit 0
    if hci_alive; then
        exec "$0" ok
    else
        exec "$0" hang
    fi
    ;;

step)
    [[ -e "$CUR" ]] || { echo "no trial open" >&2; exit 1; }
    what="${2:?usage: bt-trial step \"<what you did>\"}"
    dir=$(grep '^dir=' "$CUR" | cut -d= -f2-)
    start=$(grep '^start=' "$CUR" | cut -d= -f2)
    printf '[+%ss] %s\n' "$(( $(date +%s) - start ))" "$what" >> "$dir/steps.log"
    command -v bt-mark >/dev/null 2>&1 && bt-mark "TRIAL step: $what" >/dev/null 2>&1
    echo "recorded (+$(( $(date +%s) - start ))s): $what"
    ;;

hang|ok)
    [[ -e "$CUR" ]] || { echo "no trial open" >&2; exit 1; }
    outcome="$1"
    build=$(grep '^build=' "$CUR" | cut -d= -f2-)
    n=$(grep '^n=' "$CUR" | cut -d= -f2)
    dir=$(grep '^dir=' "$CUR" | cut -d= -f2-)
    start=$(grep '^start=' "$CUR" | cut -d= -f2)
    auto=$(grep -c '^auto=1' "$CUR" || true)
    dur=$(( $(date +%s) - start ))

    # ── COLLECT EVIDENCE FIRST, THEN CLASSIFY ─────────────────────────────
    #
    # Order is load-bearing. An earlier version classified the outcome using
    # $tmo and $since before either was assigned: under `set -u` the unbound
    # $since aborted trial closure outright, so no row was ever written. The
    # report tests passed throughout because they drive a prebuilt results.tsv
    # — they validated the consumer while the producer was dead.
    since="@$(( start - 5 ))"

    # CAPTURE ONCE, WITH A CHECKED STATUS. Previously each count was
    # `journalctl ... | grep -c ... || true`. If journalctl failed, grep still
    # printed 0 and `|| true` swallowed the failed pipeline, so the classifier
    # received a perfectly numeric zero and concluded `not_observed` — a clean
    # survival manufactured from an unreadable journal. `unknown` cannot protect
    # against a failure it never learns about.
    KJ=$(mktemp) || { echo "bt-trial: mktemp failed" >&2; exit 1; }
    if journalctl -k --since "$since" --no-pager -o short-iso-precise > "$KJ" 2>/dev/null; then
        journal_ok=1
    else
        journal_ok=0
    fi
    jk() { cat "$KJ"; }

    sco_sent=$(jk | grep -c "opcode 0x0428" || true)
    # HCI command timeouts appear in TWO forms: `command tx timeout` when the
    # kernel could not name the opcode, and `command 0x0406 tx timeout` when it
    # could. Matching the literal "command tx timeout" misses every opcode-carrying
    # line — which is most of them. The first real trial recorded bt1_status
    # not_observed against a controller that was demonstrably dead with five
    # timeouts, because all five named an opcode.
#
    # Bare "tx timeout" would over-match instead: `link tx timeout` is an ACL link
    # supervision timeout, a different event.
    tmo=$(jk | grep -cE "command( 0x[0-9a-f]+)? tx timeout" || true)
    usb_gone=$(jk | grep -c "USB disconnect, device number" || true)

    # ── TWO AXES, NOT ONE FIELD ───────────────────────────────────────────
    #
    # `outcome` used to answer two different questions at once, and once an
    # intervening watchdog exists they stop agreeing:
    #
    #   bt1_status    what the EVIDENCE says about the defect
    #   trial_result  what happened to the CONTROLLER by the end
    #
    # The dangerous row is early intervention before any observed timeout.
    # Recording that as `recovered` would read as "a failure was recovered"
    # when nobody knows whether the failure would have occurred; recording it
    # as `survived` hides that the natural trajectory was interrupted. On two
    # axes it states exactly what is true: censored evidence, recovered
    # controller.
    #
    #   bt1_status     not_observed | confirmed | censored_pre_failure | unknown
    #   trial_result   survived | failed | alive_after_intervention | aborted
    #
    # The BT-1 numerator then becomes mechanical — bt1_status == confirmed —
    # and censored observations cannot leak into either side of a rate.
    #
    # The old ok/survived distinction is gone: it was doing trial_type's job.
    # Whether the reproduction protocol was carried out is what
    # controlled_v* vs observational_boot already says.

    # TREATMENT DRIFT. If the treatment changed mid-trial, the trial was not
    # run under one condition and cannot enter a controlled rate. Recording only
    # the closing state would silently attribute the whole trial to whichever
    # configuration happened to exist at the end.
    #
    # Start-vs-end equality is not perfect — a change and revert inside the
    # window escapes it — but it catches the case that actually happens here,
    # which is reconfiguring while an auto-trial is open.
    treat_start=$(grep '^treat_start=' "$CUR" | cut -d= -f2- || true)
    mrev_start=$(grep '^mrev_start=' "$CUR" | cut -d= -f2- || true)
    treat_end=$(env_fingerprint)
    mrev_end=$(measurement_revision)

    if [[ -z "$treat_start" ]]; then
        treatment="$treat_end"           # trial opened before this was recorded
    elif [[ "$treat_start" == "$treat_end" ]]; then
        treatment="$treat_start"
    elif treatment_only_became_unreadable "$treat_start" "$treat_end"; then
        # UNREADABLE IS NOT CHANGED, AND THE DIFFERENCE DECIDES A DENOMINATOR.
        #
        # env_fingerprint reads power/control out of the device's sysfs
        # directory. When the controller has left the USB bus that directory is
        # gone, so the field reads `?` — and the endpoint comparison saw
        # `power=auto` -> `power=?` as a treatment change and prefixed the row
        # CHANGED:, which excludes it from every rate.
        #
        # The effect was exactly backwards: a trial is marked CHANGED precisely
        # BECAUSE it reached stage 2, so the failures that matter most were the
        # ones silently dropped from the failure rate. Observed on trial stock #2,
        # 2026-08-14, whose only "change" was the device being absent at close.
        #
        # A trial's treatment is what it RAN UNDER. A field becoming unreadable
        # at close is a fact about the device's presence — already recorded in
        # usb_present — not a reconfiguration.
        treatment="$treat_start"
    else
        # Deliberately not a valid treatment string: it must not match any other
        # trial, so it cannot pool into a denominator with them.
        treatment="CHANGED:${treat_start}->${treat_end}"
    fi

    # TWO ENDPOINTS DO NOT DESCRIBE THE INTERIOR.
    #
    # The comparison above samples the treatment at open and at close. An
    # intervention that restores the state it changed is invisible to it: a
    # btusb reload unbinds the device, resets it and rebinds it, and leaves both
    # fingerprints identical. On 2026-08-13 `install.sh --apply` did exactly
    # that in the middle of trial stock #2, and the row would have recorded a
    # clean, ordinary, comparable trial.
    #
    # This is the exposure-geometry mistake from the five-levels table, arriving
    # in the treatment axis instead of the measurement axis: both boundaries can
    # be sound while the interval between them is not.
    #
    # So the WINDOW is scanned, not its ends. Anything found here makes the
    # treatment string unmatchable, which is what keeps a perturbed trial out of
    # every denominator.
    perturbed=none
    if (( journal_ok )); then
        # COUNTED, NOT `grep -q`. Under `set -o pipefail` a `producer | grep -q`
        # pipeline exits NON-ZERO when the pattern is found: grep leaves at the
        # first match, the producer dies of SIGPIPE, and pipefail propagates
        # that. `&& pert+=(...)` therefore records the perturbation only when
        # there was none — and only sometimes, because a producer that finishes
        # writing before grep exits never sees SIGPIPE. Nondeterministically
        # inverted is worse than wrong.
        pert=()
        n_reload=$(jk | grep -c 'deregistering interface driver btusb' || true)
        n_reset=$(jk | grep -cE 'usb_queue_reset_device|Resetting usb device' || true)
        (( ${n_reload:-0} > 0 )) && pert+=(btusb_reload)
        (( ${n_reset:-0}  > 0 )) && pert+=(usb_reset)
        if (( ${#pert[@]} )); then
            perturbed=$(IFS=+; echo "${pert[*]}")
            case "$treatment" in
                CHANGED:*) treatment="${treatment}+PERTURBED:${perturbed}" ;;
                *)         treatment="PERTURBED:${perturbed}:${treatment}" ;;
            esac
        fi
    else
        # An unreadable journal cannot certify the interior either way, and
        # `none` would be a claim we have no basis for.
        perturbed=unknown
    fi

    if [[ -z "$mrev_start" || "$mrev_start" == "$mrev_end" ]]; then
        measurement_rev="${mrev_start:-$mrev_end}"
    else
        # A tooling change mid-trial does not invalidate the treatment, so this
        # is recorded as a range rather than attributed to the ending commit.
        measurement_rev="${mrev_start}..${mrev_end}"
    fi

    # CHECKED ACQUISITION, for the same reason as the kernel journal above.
    # This was still `journalctl | grep -c ... || true` after that one was
    # fixed: a failed read makes grep print 0, `|| true` swallows the failed
    # pipeline, and an intervention that DID happen becomes zero — so a
    # censored trial silently becomes `not_observed + survived`. Unreadable
    # evidence must not become negative evidence.
    WJ=$(mktemp) || { echo "bt-trial: mktemp failed" >&2; exit 1; }
    if journalctl -u bt-hang-watchdog --since "$since" --no-pager -o cat > "$WJ" 2>/dev/null; then
        wd_journal_ok=1
        early_int=$(grep -c "EARLY intervention" "$WJ" || true)
        any_int=$(grep -cE "EARLY intervention|Detected .* controller timeouts within" "$WJ" || true)
    else
        wd_journal_ok=0
        early_int=""; any_int=""
    fi
    rm -f "$WJ"

    # --- axis 1: what the evidence says about BT-1 --------------------------
    # A watchdog that is off logs nothing, so an empty read is expected and
    # not a failure. It is only unreadable evidence from a RUNNING watchdog
    # that leaves the censoring state unknown.
    wd_running=0
    systemctl is-active --quiet bt-hang-watchdog 2>/dev/null && wd_running=1

    if (( ! journal_ok )) || [[ ! "${tmo:-}" =~ ^[0-9]+$ ]]; then
        bt1_status=unknown          # could not read the journal; do not guess
    elif (( wd_running && ! wd_journal_ok )); then
        # Timeouts readable, interventions not. Cannot distinguish
        # not_observed from censored_pre_failure, so claim neither.
        bt1_status=unknown
    elif (( tmo > 0 )); then
        bt1_status=confirmed        # HCI non-responsiveness was observed
    elif [[ "${early_int:-0}" =~ ^[0-9]+$ ]] && (( early_int > 0 )); then
        # The watchdog reset the controller on a heuristic BEFORE any timeout.
        # Every early precursor this project has tested — the audio-teardown
        # signature, the 16 s desync, the A2DP-idle trigger — was refuted as a
        # causal marker, so firing early is not evidence BT-1 was imminent. The
        # intervention destroyed the counterfactual.
        bt1_status=censored_pre_failure
    else
        bt1_status=not_observed
    fi

    # --- axis 2: what happened to the controller ----------------------------
    if [[ "$1" == hang ]] || ! hci_alive; then
        trial_result=failed
    elif [[ "${any_int:-0}" =~ ^[0-9]+$ ]] && (( any_int > 0 )); then
        # NOT "recovered". That word asserts a recovery happened, which is only
        # true when a failure was confirmed. Paired with
        # bt1_status=censored_pre_failure it would invent the very failure the
        # censoring says we cannot know about. This states only what was seen:
        # the controller answers, and an intervention occurred first.
        #
        #   confirmed + alive_after_intervention  -> mitigation worked
        #   censored_pre_failure + alive_after_intervention -> unknowable
        trial_result=alive_after_intervention
    else
        trial_result=survived       # alive, untouched
    fi

    # Kept for humans reading a single column; every rate is computed from the
    # two axes above, never from this.
    # Deliberately NOT reused for control flow. An earlier version assigned
    # trial_result here and then still tested `$outcome == hang` further down —
    # a value that can no longer occur — so a real failure skipped bt-incident
    # and printed the survival branch. Every decision below keys on
    # $trial_result.
    outcome="$trial_result"

    # The liveness check now happens inside the axis-2 classification above, so
    # a claimed survival cannot be recorded against a dead controller. This just
    # reports what was determined.
    case "$trial_result" in
        survived)  echo "${G}verified: controller responds, no intervention${O}" ;;
        alive_after_intervention)
                   echo "${Y}controller responds, but only after intervention${O}" ;;
        failed)    echo "${R}controller does NOT respond${O}" ;;
    esac

    command -v bt-state >/dev/null 2>&1 && bt-state > "$dir/state-after.txt" 2>&1
    command -v bt-mark  >/dev/null 2>&1 && bt-mark "TRIAL $build #$n RESULT: $outcome" >/dev/null 2>&1

    # --- structured SCO record ----------------------------------------------
    # Pass/fail alone cannot distinguish "the stimulus was applied and the
    # controller survived it" from "the stimulus never happened". Those are
    # different rows of the 2x2 that decides whether 0x0428 is causal, and a
    # trial that does not record which one it was is wasted.
    #
    # Each field is measured, never inferred, and "?" means not determined
    # rather than "no" — a blank cell must not read as a negative result.

    # Select the NEAREST PRECEDING synchronous setup — not "the right one".
    #
    # An earlier version took the first 0x0428 of the trial and the first
    # timeout of the trial and subtracted them. Under protocol v2 there are up
    # to ten profile switches, so the first setup may have been serviced
    # perfectly and the seventh been fatal — pairing the first with the first
    # measures the interval between two unrelated events and reports it as if
    # it were the failure's timing.
    #
    # What is recorded is the setup immediately PRECEDING the first timeout.
    # Better than first-of-trial, but a heuristic and not an established
    # pairing: EX-009 is a case where the setup completed successfully and the
    # command that actually went unanswered was a later Disconnect. This field
    # means "nearest preceding synchronous setup" and must NOT be read as "the
    # setup belonging to this failure".
    t_tmo=$(jk | grep -m1 -E "command( 0x[0-9a-f]+)? tx timeout" | cut -d' ' -f1)
    if [[ -n "$t_tmo" ]]; then
        t_sco=$(jk | grep "opcode 0x0428" | cut -d' ' -f1 \
                | awk -v lim="$t_tmo" '$1 < lim' | tail -1)
    else
        t_sco=$(jk | grep "opcode 0x0428" | cut -d' ' -f1 | head -1)
    fi
    sco_to_tmo="?"
    if [[ -n "$t_sco" && -n "$t_tmo" ]]; then
        sco_to_tmo=$(awk -f "$LIBDIR/timestamp.awk" -f "$LIBDIR/interval.awk" -v a="$t_sco" -v b="$t_tmo")
    elif (( sco_sent > 0 )); then
        sco_to_tmo="none"     # SCO requested and NO timeout followed — survival under stimulus
    fi

    # Full parameters of the request. The reviewer's point: the failure may
    # depend on a particular parameterisation (voice setting, packet type,
    # retransmission effort) rather than on synchronous setup as such. The
    # kernel log gives only the opcode and length; btmon decodes the payload.
    # SCO parameters, SCOPED TO THIS TRIAL and drawn from BOTH capture paths.
    #
    # Two defects fixed here. The previous version grepped every retained
    # capture with no time bound, so a file named as this trial's request
    # parameters could contain requests from other trials and other boots — the
    # precise confusion that makes a five-row parameter comparison worthless.
    # And it read only the btmon path, which is the one known to lose events
    # (BT-4); the decode-free capture exists because that path drops data.
    #
    # Records are filtered to the trial window by their own decoded timestamp,
    # and each source is labelled so a discrepancy between the paths is visible
    # rather than silently merged.
    : > "$dir/sco-params.txt"
    t_start=$(date -d "@$start" '+%Y-%m-%d %H:%M:%S')
    t_end=$(date '+%Y-%m-%d %H:%M:%S')
    if command -v btmon >/dev/null 2>&1 && (( sco_sent > 0 )); then
        {
            printf '# trial window: %s .. %s\n' "$t_start" "$t_end"
            printf '# both capture paths are shown; a request present in only one\n'
            printf '# is an instrumentation finding, not evidence about the controller.\n\n'
            for src in "${BT_CAPTURE_DIR:-/var/log/bt-health/capture}" \
                       "${BT_TRACE_DIR:-/var/log/bt-health/trace}"; do
                printf '===== source: %s =====\n' "$src"
                for f in "$src"/*.btsnoop; do
                    [[ -e "$f" ]] || continue
                    COLUMNS=200 btmon -T -r "$f" 2>/dev/null
                done | awk -v lo="$t_start" -v hi="$t_end" '
                    # Carry the last seen full timestamp forward: indented
                    # parameter lines have none of their own.
                    match($0, /[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}/) {
                        cur = substr($0, RSTART, 19)
                    }
                    /HCI Command: Setup Synchronous Connection/ { keep = (cur >= lo && cur <= hi) }
                    /HCI Event: Synchronous Connect Complete/   { keep = (cur >= lo && cur <= hi) }
                    /^[<>@=!]/ && !/Setup Synchronous|Synchronous Connect Complete/ { keep = 0 }
                    keep { print }'
                echo
            done
        } > "$dir/sco-params.txt"
    fi
    # The header block above is always written when captures were read, so the
    # emptiness test must ask "did any RECORD survive the filter?", not "is the
    # file empty?" — the earlier -s test made this fallback unreachable and a
    # no-SCO trial shipped a file of bare section headers with no explanation.
    if ! grep -q 'HCI Command: Setup Synchronous Connection' "$dir/sco-params.txt" 2>/dev/null; then
        echo "(no Setup Synchronous Connection inside this trial's window in either capture path)" \
            > "$dir/sco-params.txt"
    fi

    # --- the observer as an experimental intervention -----------------------
    # The liveness probe is not observationally inert. `hciconfig <dev> name`
    # injects an HCI command/response exchange into the same controller whose
    # rare state transitions are under study, and it is already proven to
    # deterministically abort an active btmon capture (EX-011). Something that
    # demonstrably perturbs one observer cannot be assumed harmless to the
    # subject.
    #
    # There is NO evidence the probe contributes to BT-1, and it is not being
    # treated as a suspect. It is being recorded so the question is answerable
    # rather than assumed. If a pattern ever emerges — every fatal transition
    # shortly after a probe — it will be visible in this column instead of being
    # discovered weeks later. If failures fall at arbitrary distances from
    # thousands of probes, that is negative evidence against an observer effect,
    # which is worth just as much.
    #
    # ⚠ THIS COLUMN IS NOT "ALL LIVENESS INTERVENTIONS". It counts
    # bt-health-snapshot invocations, which are the systematic, journal-visible
    # source. Other raw-HCI probes happen and are NOT counted here:
    #   * bt-trial's own hci_alive(), which runs `hciconfig <hci> name`
    #   * every bt-state invocation, which does the same
    # Those are operator- or script-driven and leave no dedicated journal entry,
    # so the column is a lower bound on the intervention count. Treating it as
    # the total would understate the exposure it exists to measure.
    #
    # btmon aborts are counted alongside as a partial corroborator. EX-011 found
    # one abort per raw-HCI exchange when probes were spaced far enough apart
    # for btmon to have finished restarting; unspaced probes produce fewer. So
    # the relation is "consistent with 1:1 under spaced observation", NOT an
    # established 1:1, and the abort count is itself a lower bound.
    probes=$(journalctl -u bt-health-snapshot.service -u bt-health-snapshot-event.service \
             --since "$since" --no-pager -o cat 2>/dev/null \
             | grep -c "Snapshot Bluetooth health metrics" || true)
    aborts=$(journalctl -u bt-trace --since "$since" --no-pager -o cat 2>/dev/null \
             | grep -c "exited" || true)

    # Distance from the last probe preceding the first timeout. Empty when there
    # was no timeout; "?" when a timeout occurred with no probe before it.
    # Only the TIMER-driven unit is used. The udev-driven one fires on the
    # controller's own failure events, so measuring a timeout's distance from it
    # measures outcome-dependent sampling — see EX-012. This raw interval is
    # still not interpretable alone; `bt-phase` normalises it against the
    # exposure distribution, and that is where any conclusion belongs.
    probe_to_tmo="?"
    if [[ -n "$t_tmo" ]]; then
        t_probe=$(journalctl -u bt-health-snapshot.service --since "$since" --until "$t_tmo" \
                  --no-pager -o short-iso-precise 2>/dev/null \
                  | grep "Snapshot Bluetooth health" | tail -1 | cut -d' ' -f1)
        if [[ -n "$t_probe" ]]; then
            probe_to_tmo=$(awk -f "$LIBDIR/timestamp.awk" -f "$LIBDIR/interval.awk" -v a="$t_probe" -v b="$t_tmo")
        fi
    fi

    hci_alive && resp_after=yes || resp_after=no
    # Resolve the device by VID/PID rather than by bus path: after a reset it
    # can re-enumerate at a different address, and a hardcoded path would then
    # report "gone" for a device that is present and working.
    usb_present=no
    for d in "$SYSFS_USB"/*; do
        [[ -f "$d/idVendor" && -f "$d/idProduct" ]] || continue
        if [[ "$(<"$d/idVendor")" == "${BT_VID:-13d3}" && "$(<"$d/idProduct")" == "${BT_PID:-3503}" ]]; then
            usb_present=yes; break
        fi
    done

    # TRIAL TYPE IS FIRST-CLASS DATA, not implied by the outcome string.
    #
    # An observational boot and a controlled protocol run produce different
    # kinds of evidence and must never share a denominator. Previously the
    # distinction lived only in the outcome ("survived" vs "ok"), so a hang was
    # indistinguishable between the two — and a hang is exactly the row that
    # drives the failure rate the A/B/C/D gate depends on. A stock hang during
    # ordinary use would have been pooled with a stock hang under protocol v2.
    #
    # Recording the type explicitly means the two can be separated whatever the
    # outcome, and cannot be silently merged by a later reporting change.
    if (( auto )); then trial_type=observational_boot
    else                trial_type="controlled_v$PROTOCOL_VERSION"
    fi

    # HOW THE MACHINE GOT INTO THIS BOOT, AND WHETHER THE CONTROLLER CAME BACK.
    #
    # The protocol's step 0 states that a warm reboot cannot recover the
    # controller because it does not drop the M.2 power rail. That is a
    # plausible hardware inference which entered the documentation as fact and
    # was never tested — no exhibit supports it.
    #
    # On 2026-08-13 the controller recovered across a shutdown that reached
    # reboot.target (EX-017). The gap was long enough that an unlogged
    # power-off is not excluded, so it settles nothing — which is the point:
    # the question was unanswerable because nobody was recording the answer.
    # Two fields make it accumulate instead.
    #
    # Read from the tail of the previous boot: the shutdown targets are among
    # the last messages, so a bounded read is both correct and fast.
    prev_shutdown=unknown
    case "$(journalctl -b -1 -n 400 --no-pager 2>/dev/null \
            | grep -oE 'Reached target (reboot|poweroff|halt)' | tail -1)" in
        *reboot)   prev_shutdown=reboot   ;;
        *poweroff) prev_shutdown=poweroff ;;
        *halt)     prev_shutdown=halt     ;;
    esac
    # Counted, for the pipefail reason above: `| grep -q` would have reported
    # `no` exactly when the controller HAD enumerated.
    #
    # BOUNDED TO THE FIRST THREE MINUTES, AND THAT IS NOT AN OPTIMISATION.
    #
    # Unbounded, this scans the whole boot's kernel journal. On a long boot with
    # dynamic debug enabled that is minutes of work, and it sits between the
    # auxiliary files and the results row. During a shutdown-triggered close,
    # systemd's stop timeout killed bt-trial here: state-after.txt and
    # sco-params.txt survived, and the row — the actual record — did not.
    #
    # That is exactly the wrong thing to lose, and it lost the record of the
    # project's longest untreated window (2026-08-15, 12107 s, EX-023). The
    # controller either enumerates during startup or it is not there, so three
    # minutes answers the question a whole-boot scan was answering slowly.
    # --list-boots already carries boot 0's first timestamp, so this costs one
    # index read rather than a journal scan.
    boot_start=$(journalctl --list-boots --no-pager 2>/dev/null | awk '$1=="0"{print $4" "$5}')
    enum_until=""
    if [[ -n "$boot_start" ]]; then
        bs=$(date -d "$boot_start" +%s 2>/dev/null) \
            && enum_until=$(date -d "@$(( bs + 180 ))" '+%Y-%m-%d %H:%M:%S')
    fi
    n_enum=$(journalctl -k -b 0 ${enum_until:+--until "$enum_until"} --no-pager 2>/dev/null \
             | grep -c "idVendor=${BT_VID:-13d3}, idProduct=${BT_PID:-3503}" || true)
    if (( ${n_enum:-0} > 0 )); then
        enum_at_boot=yes
    else
        enum_at_boot=no
    fi

    [[ -s "$RESULTS" ]] || printf 'timestamp\ttrial_type\tbuild\ttreatment\tmeasurement_rev\ttrial\tprotocol\tbt1_status\ttrial_result\tduration_s\tsco_sent\tsco_to_timeout_s\ttimeouts\tresponds_after\tusb_present\tusb_lost\tprobes\tprobe_to_timeout_s\tbtmon_aborts\tkernel\tprev_shutdown\tenum_at_boot\tperturbed\n' > "$RESULTS"
    printf '%s\t%s\t%s\t%s\t%s\t%s\tv%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
        "$(date -Iseconds)" "$trial_type" "$build" "$treatment" "$measurement_rev" "$n" "$PROTOCOL_VERSION" "$bt1_status" "$trial_result" "$dur" \
        "${sco_sent:-?}" "$sco_to_tmo" "${tmo:-?}" "$resp_after" "$usb_present" \
        "${usb_gone:-?}" "${probes:-?}" "$probe_to_tmo" "${aborts:-?}" \
        "$(uname -r)" "$prev_shutdown" "$enum_at_boot" "$perturbed" >> "$RESULTS"

    echo
    echo "  SCO setup requested   : ${sco_sent:-?}"
    echo "  SCO -> first timeout  : $sco_to_tmo s"
    echo "  command timeouts      : ${tmo:-?}"
    echo "  responds afterwards   : $resp_after"
    echo "  still on the USB bus  : $usb_present   (bus-loss events: ${usb_gone:-?})"
    echo "  request parameters    : $dir/sco-params.txt"
    echo "  liveness probes       : ${probes:-?}   (btmon aborts: ${aborts:-?})"
    echo "  last probe -> timeout : $probe_to_tmo s"
    echo "  previous shutdown     : $prev_shutdown   (controller enumerated this boot: $enum_at_boot)"
    [[ "$perturbed" == none ]] || echo "  ${R}mid-trial perturbation: $perturbed — this trial is not comparable${O}"

    if [[ "$trial_result" == failed ]] && command -v bt-incident >/dev/null 2>&1; then
        echo "collecting incident evidence..."
        bt-incident "trial-$build-$n" --since "@$(( start - 60 ))" >/dev/null 2>&1 \
            && echo "  -> evidence/sessions/latest"
    fi

    rm -f "$CUR"
    if [[ "$trial_result" == failed ]]; then
        echo "${R}${B}Trial $build #$n: HANG${O} after ${dur}s"
        echo "  cold power-off required before the next trial"
    else
        echo "${G}${B}Trial $build #$n: survived${O} (${dur}s)"
    fi
    echo
    "$0" report
    ;;

abort)
    [[ -e "$CUR" ]] || { echo "no trial open"; exit 0; }
    dir=$(grep '^dir=' "$CUR" | cut -d= -f2-)
    rm -rf "$dir"; rm -f "$CUR"
    echo "trial discarded"
    ;;

report)
    if [[ ! -s "$RESULTS" ]]; then echo "no trials recorded yet"; exit 0; fi
    echo "${B}Trial results${O}  ($RESULTS)"
    echo "─────────────────────────────────────────────────────────────"
    # Keyed on (trial_type, build), never on build alone. Column positions are
    # resolved from the header rather than hardcoded, so adding a field cannot
    # silently shift what is being counted — which is how a denominator gets
    # corrupted without anyone editing the arithmetic.
    awk -f "$LIBDIR/trial-summary.awk" "$RESULTS" || {
        echo "bt-trial: denominator report FAILED — refusing to print a partial report" >&2
        exit 1
    }
    echo
    echo "${B}Was the SCO stimulus actually applied, and did it matter?${O}"
    echo "─────────────────────────────────────────────────────────────"
    awk -f "$LIBDIR/trial-sco-table.awk" "$RESULTS" || {
        echo "bt-trial: SCO cross-tab FAILED — refusing to print a partial report" >&2
        exit 1
    }
    echo
    echo "  Gate: stock must reach a high, stable failure rate (target 5/5) before"
    echo "  any build is compiled. Compare every build against the SAME protocol."
    echo
    echo "  A trial that survives WITHOUT provoking SCO setup proves nothing about"
    echo "  the build. Check the top row is filling before drawing conclusions."
    ;;

status)
    # Reports what the open trial has ALREADY accumulated, so the question
    # "is this trial still clean?" can be asked at any point instead of being
    # discovered at close. It also removes the reason to hand-write
    # `journalctl --since "@$(grep ^start= /run/bt-trial/current | cut -d= -f2)"`,
    # which is unanalysable by the command allowlist and cost an approval every
    # time someone wanted to look.
    if [[ ! -e "$CUR" ]]; then echo "no trial open"; exit 0; fi
    echo "${B}trial OPEN${O}"
    sed 's/^/  /' "$CUR"
    st=$(grep '^start=' "$CUR" | cut -d= -f2-)
    if [[ -n "$st" ]]; then
        now=$(date +%s)
        printf '  elapsed=%ss\n' "$(( now - st ))"
        W=$(mktemp) || exit 1
        if journalctl -k --since "@$(( st - 5 ))" --no-pager -o short-iso-precise > "$W" 2>/dev/null; then
            t=$(grep -cE 'command( 0x[0-9a-f]+)? tx timeout' "$W" || true)
            sc=$(grep -c 'opcode 0x0428' "$W" || true)
            ug=$(grep -c 'USB disconnect, device number' "$W" || true)
            rl=$(grep -c 'deregistering interface driver btusb' "$W" || true)
            rs=$(grep -cE 'usb_queue_reset_device|Resetting usb device' "$W" || true)
            echo
            printf '  HCI command timeouts  %s\n' "$t"
            printf '  SCO setups requested  %s\n' "$sc"
            printf '  USB disconnects       %s\n' "$ug"
            echo
            if (( rl || rs )); then
                printf '  %s!! PERTURBED%s  btusb reloads=%s  resets=%s\n' "$R" "$O" "$rl" "$rs"
                echo "     Something reset the controller inside this trial's window."
                echo "     The row will be written with a PERTURBED: treatment and"
                echo "     excluded from every denominator. Consider: bt-trial abort"
            else
                printf '  %sclean%s — no reset or reload inside the window\n' "$G" "$O"
            fi
        else
            echo "  (journal unreadable — cannot certify this trial's interior)"
        fi
        rm -f "$W"
    fi
    ;;

*)  sed -n '2,18p' "$0"; exit 1 ;;
esac
