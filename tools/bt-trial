#!/bin/bash
# bt-trial — run one numbered trial of the fixed reproduction protocol.
#
#   bt-trial protocol                 print the protocol and stop
#   bt-trial start <build>            begin a trial of <build> (e.g. stock, A, B, C, D)
#   bt-trial step "<what you did>"    mark a protocol step (optional but recommended)
#   bt-trial hang                     record: the controller hung
#   bt-trial ok                       record: it survived (verifies the controller answers)
#   bt-trial abort                    discard the open trial
#   bt-trial report                   failure rate per build — the denominators
#
# WHY: "the patched build ran for an hour" means nothing without a baseline. This
# project has mistaken absence-of-observed-failure for a fix more than once. Every
# build must be measured against the SAME protocol, and stock must be measured
# first — target 5/5 failures before anything is compiled.
#
# Each trial records its own before/after state, the operator's steps with
# timestamps, and (on a hang) an automatic bt-incident collection.

set -uo pipefail

# Shared civil-date arithmetic. Two intervals here previously used
# (day_of_month * 24 + hour) arithmetic, silently catastrophic across a month
# boundary. bt-phase was fixed in isolation, leaving these wrong and a second
# implementation to maintain; see tools/lib/timestamp.awk.
LIBDIR="${BT_LIBDIR:-$(dirname "$(readlink -f "$0")")/lib}"
[[ -r "$LIBDIR/timestamp.awk" ]] || { echo "bt-trial: missing $LIBDIR/timestamp.awk" >&2; exit 1; }

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="${BT_REPO:-}"
if [[ -z "$REPO" ]]; then
    for c in "$HERE/.." /root/exp/qca9377-bt-hang "$PWD"; do
        [[ -d "$c/.git" && -e "$c/install.sh" ]] && { REPO=$(cd "$c" && pwd); break; }
    done
fi
[[ -n "$REPO" ]] || { echo "no checkout found; set BT_REPO" >&2; exit 2; }

TRIALS="$REPO/evidence/trials"
RESULTS="$TRIALS/results.tsv"
STATE=/run/bt-trial
CUR="$STATE/current"

G=$'\033[32m'; R=$'\033[31m'; Y=$'\033[33m'; B=$'\033[1m'; O=$'\033[0m'
[[ -t 1 ]] || { G=""; R=""; Y=""; B=""; O=""; }

# ── THE PROTOCOL ──────────────────────────────────────────────────────────
# Fixed. Changing it invalidates comparison with every trial already recorded;
# if it must change, bump PROTOCOL_VERSION so old and new trials are not mixed.
PROTOCOL_VERSION=2
protocol() {
cat <<'EOF'
PROTOCOL v2 — one trial

  0. Cold-boot the machine (POWER-OFF, not reboot) if the controller is down.
     A warm reboot does not drop the M.2 power rail and will not recover it.
  1. bt-trial start <build>
  2. Connect the Sennheiser Momentum 4. Wait until it appears as an audio
     device in Settings -> Sound.
  3. Start audio playback. Let it run ~10 s.
  4. In Settings -> Sound, switch the device PROFILE:
        High Fidelity Playback (A2DP)  <->  Headset Head Unit (HFP)
     Wait ~5 s after each switch, with audio still playing.
  5. Repeat step 4 up to TEN times, alternating back and forth.
     Stop early the moment the controller dies.
  6. If still alive after ten switches: disconnect, reconnect, play again.
     Do that THREE times.
  7. bt-trial hang    (controller died)
     bt-trial ok      (survived all of the above)

  WHY THE COUNTS ARE FIXED. A trial only produces a denominator if "ok"
  means something definite. "I stopped and it was still working" is not a
  survival — it is an unfinished trial. Ten switches plus three reconnect
  cycles is drawn from the operator's estimate that failure normally
  arrives within several cycles, so it should sit comfortably beyond the
  usual failure point without running indefinitely.

  If a trial survives the full protocol repeatedly, the protocol is too
  short and must be lengthened — but lengthen it BEFORE the next trial and
  restart the count, never mid-series.

  Record each step you actually perform with:
     bt-trial step "switched to XQ"

  Run the SAME steps for every build. Deviations make the comparison worthless —
  note them with `bt-trial step` if they happen.
EOF
}

hci_alive() {
    local d dev="" h=""
    for d in /sys/bus/usb/devices/*; do
        [[ -f "$d/idVendor" && -f "$d/idProduct" ]] || continue
        [[ "$(<"$d/idVendor")" == "${BT_VID:-13d3}" && "$(<"$d/idProduct")" == "${BT_PID:-3503}" ]] \
            && { dev="$d"; break; }
    done
    [[ -n "$dev" ]] || return 1
    for p in "$dev"/*/bluetooth/hci*; do [[ -e "$p" ]] && h=$(basename "$p") && break; done
    [[ -n "$h" ]] || return 1
    command -v hciconfig >/dev/null 2>&1 || return 2
    timeout 6 hciconfig "$h" name >/dev/null 2>&1
}

next_trial_no() {
    # Resolve the column from the header, never by position. Adding trial_type
    # shifted `build` from field 2 to field 3, and a hardcoded $2 would silently
    # have counted trial_type values instead — restarting numbering at 1 and
    # overwriting an existing trial directory. The report was already guarded
    # this way; this call site was not.
    local build="$1" n
    n=$(awk -F'\t' -v b="$build" '
        NR == 1 { for (i = 1; i <= NF; i++) c[$i] = i
                  if (!("build" in c)) { print "NOHEADER"; exit 1 }
                  next }
        $c["build"] == b { n++ }
        END { print n + 0 }' "$RESULTS" 2>/dev/null)
    [[ "$n" == "NOHEADER" || -z "$n" ]] && n=0
    echo $(( n + 1 ))
}

case "${1:-}" in

protocol) protocol ;;

start)
    build="${2:?usage: bt-trial start <build>   (stock, A, B, C, D)}"
    [[ -e "$CUR" ]] && { echo "a trial is already open:"; sed 's/^/  /' "$CUR"; exit 1; }
    if ! hci_alive; then
        echo "${R}Controller is not responding.${O} Cold power-off first — a trial that"
        echo "starts on a dead controller measures nothing."
        exit 1
    fi
    mkdir -p "$STATE" "$TRIALS"
    n=$(next_trial_no "$build")
    dir="$TRIALS/$build/trial-$(printf '%02d' "$n")"
    mkdir -p "$dir"
    { echo "start=$(date +%s)"; echo "build=$build"; echo "n=$n"; echo "dir=$dir"; } > "$CUR"
    command -v bt-state >/dev/null 2>&1 && bt-state > "$dir/state-before.txt" 2>&1
    : > "$dir/steps.log"
    command -v bt-mark >/dev/null 2>&1 && bt-mark "TRIAL $build #$n START (protocol v$PROTOCOL_VERSION)" >/dev/null 2>&1
    echo "${B}Trial $build #$n started${O}  (protocol v$PROTOCOL_VERSION)"
    echo "  uptime: $(uptime -p)"
    echo
    protocol | sed -n '3,10p'
    echo
    echo "  then: bt-trial hang   |   bt-trial ok"
    ;;

autostart)
    # Open a trial automatically at boot.
    #
    # WHY. Asking the operator to run `bt-trial start` by hand loses the window
    # that matters. Bluetooth comes up with the system and begins scanning
    # before anyone can reach a terminal, and the environment contains devices
    # that cannot be switched off — so by the time a trial was opened manually,
    # an uncontrolled and unrecorded set of events had already happened. Worse,
    # in practice no trial was ever open when the controller died, so the
    # structured fields captured nothing on the three occasions they were built
    # for.
    #
    # Every boot is therefore a trial, opened by bt-trial-auto.service before
    # bluetooth.service starts. It is closed either by the watchdog when the
    # controller dies, or at shutdown by `autostop`.
    #
    # NOTE ON WHAT THIS MEASURES. The denominator this produces is
    # observational — boots-with-a-hang over total boots under ordinary use —
    # not a controlled protocol. It is weaker evidence than a fixed reproducer
    # and must be reported as such. It is also real data, where the manual
    # protocol produced none.
    build="${2:-${BT_BUILD:-stock}}"
    [[ -e "$CUR" ]] && exit 0          # already open; nothing to do
    mkdir -p "$STATE" "$TRIALS"
    n=$(next_trial_no "$build")
    dir="$TRIALS/$build/trial-$(printf '%02d' "$n")"
    mkdir -p "$dir"
    { echo "start=$(date +%s)"; echo "build=$build"; echo "n=$n"; echo "dir=$dir"
      echo "auto=1"; } > "$CUR"
    command -v bt-state >/dev/null 2>&1 && bt-state > "$dir/state-before.txt" 2>&1
    : > "$dir/steps.log"
    echo "auto-trial $build #$n opened at boot"
    ;;

autostop)
    # Close an auto-opened trial at shutdown, classifying by what the controller
    # is actually doing rather than by what anyone intended.
    [[ -e "$CUR" ]] || exit 0
    if hci_alive; then
        exec "$0" ok
    else
        exec "$0" hang
    fi
    ;;

step)
    [[ -e "$CUR" ]] || { echo "no trial open" >&2; exit 1; }
    what="${2:?usage: bt-trial step \"<what you did>\"}"
    dir=$(grep '^dir=' "$CUR" | cut -d= -f2-)
    start=$(grep '^start=' "$CUR" | cut -d= -f2)
    printf '[+%ss] %s\n' "$(( $(date +%s) - start ))" "$what" >> "$dir/steps.log"
    command -v bt-mark >/dev/null 2>&1 && bt-mark "TRIAL step: $what" >/dev/null 2>&1
    echo "recorded (+$(( $(date +%s) - start ))s): $what"
    ;;

hang|ok)
    [[ -e "$CUR" ]] || { echo "no trial open" >&2; exit 1; }
    outcome="$1"
    build=$(grep '^build=' "$CUR" | cut -d= -f2-)
    n=$(grep '^n=' "$CUR" | cut -d= -f2)
    dir=$(grep '^dir=' "$CUR" | cut -d= -f2-)
    start=$(grep '^start=' "$CUR" | cut -d= -f2)
    auto=$(grep -c '^auto=1' "$CUR" || true)
    dur=$(( $(date +%s) - start ))

    # An auto-opened trial that ends alive is recorded as "survived", not "ok".
    # They are different claims: "ok" asserts the reproduction protocol was
    # carried out and the controller withstood it, while "survived" only says
    # the machine ran for a while and did not hang. Collapsing the two would
    # inflate the protocol's apparent pass rate with boots where the stimulus
    # was never applied.
    if (( auto )) && [[ "$outcome" == ok ]]; then
        outcome=survived
    fi

    if [[ "$outcome" == ok || "$outcome" == survived ]]; then
        if hci_alive; then
            echo "${G}verified: controller still responds${O}"
        else
            echo "${R}Controller does NOT respond — recording as 'hang', not 'ok'.${O}"
            outcome=hang
        fi
    fi

    command -v bt-state >/dev/null 2>&1 && bt-state > "$dir/state-after.txt" 2>&1
    command -v bt-mark  >/dev/null 2>&1 && bt-mark "TRIAL $build #$n RESULT: $outcome" >/dev/null 2>&1

    # --- structured SCO record ----------------------------------------------
    # Pass/fail alone cannot distinguish "the stimulus was applied and the
    # controller survived it" from "the stimulus never happened". Those are
    # different rows of the 2x2 that decides whether 0x0428 is causal, and a
    # trial that does not record which one it was is wasted.
    #
    # Each field is measured, never inferred, and "?" means not determined
    # rather than "no" — a blank cell must not read as a negative result.
    since="@$(( start - 5 ))"
    jk() { journalctl -k --since "$since" --no-pager -o short-iso-precise 2>/dev/null; }

    sco_sent=$(jk | grep -c "opcode 0x0428" || true)
    tmo=$(jk | grep -c "command tx timeout" || true)
    usb_gone=$(jk | grep -c "USB disconnect, device number" || true)

    # Select the NEAREST PRECEDING synchronous setup — not "the right one".
    #
    # An earlier version took the first 0x0428 of the trial and the first
    # timeout of the trial and subtracted them. Under protocol v2 there are up
    # to ten profile switches, so the first setup may have been serviced
    # perfectly and the seventh been fatal — pairing the first with the first
    # measures the interval between two unrelated events and reports it as if
    # it were the failure's timing.
    #
    # What is recorded is the setup immediately PRECEDING the first timeout.
    # Better than first-of-trial, but a heuristic and not an established
    # pairing: EX-009 is a case where the setup completed successfully and the
    # command that actually went unanswered was a later Disconnect. This field
    # means "nearest preceding synchronous setup" and must NOT be read as "the
    # setup belonging to this failure".
    t_tmo=$(jk | grep -m1 "command tx timeout" | cut -d' ' -f1)
    if [[ -n "$t_tmo" ]]; then
        t_sco=$(jk | grep "opcode 0x0428" | cut -d' ' -f1 \
                | awk -v lim="$t_tmo" '$1 < lim' | tail -1)
    else
        t_sco=$(jk | grep "opcode 0x0428" | cut -d' ' -f1 | head -1)
    fi
    sco_to_tmo="?"
    if [[ -n "$t_sco" && -n "$t_tmo" ]]; then
        sco_to_tmo=$(awk -f "$LIBDIR/timestamp.awk" -f "$LIBDIR/interval.awk" -v a="$t_sco" -v b="$t_tmo")
    elif (( sco_sent > 0 )); then
        sco_to_tmo="none"     # SCO requested and NO timeout followed — survival under stimulus
    fi

    # Full parameters of the request. The reviewer's point: the failure may
    # depend on a particular parameterisation (voice setting, packet type,
    # retransmission effort) rather than on synchronous setup as such. The
    # kernel log gives only the opcode and length; btmon decodes the payload.
    # SCO parameters, SCOPED TO THIS TRIAL and drawn from BOTH capture paths.
    #
    # Two defects fixed here. The previous version grepped every retained
    # capture with no time bound, so a file named as this trial's request
    # parameters could contain requests from other trials and other boots — the
    # precise confusion that makes a five-row parameter comparison worthless.
    # And it read only the btmon path, which is the one known to lose events
    # (BT-4); the decode-free capture exists because that path drops data.
    #
    # Records are filtered to the trial window by their own decoded timestamp,
    # and each source is labelled so a discrepancy between the paths is visible
    # rather than silently merged.
    : > "$dir/sco-params.txt"
    t_start=$(date -d "@$start" '+%Y-%m-%d %H:%M:%S')
    t_end=$(date '+%Y-%m-%d %H:%M:%S')
    if command -v btmon >/dev/null 2>&1 && (( sco_sent > 0 )); then
        {
            printf '# trial window: %s .. %s\n' "$t_start" "$t_end"
            printf '# both capture paths are shown; a request present in only one\n'
            printf '# is an instrumentation finding, not evidence about the controller.\n\n'
            for src in "${BT_CAPTURE_DIR:-/var/log/bt-health/capture}" \
                       "${BT_TRACE_DIR:-/var/log/bt-health/trace}"; do
                printf '===== source: %s =====\n' "$src"
                for f in "$src"/*.btsnoop; do
                    [[ -e "$f" ]] || continue
                    COLUMNS=200 btmon -T -r "$f" 2>/dev/null
                done | awk -v lo="$t_start" -v hi="$t_end" '
                    # Carry the last seen full timestamp forward: indented
                    # parameter lines have none of their own.
                    match($0, /[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}/) {
                        cur = substr($0, RSTART, 19)
                    }
                    /HCI Command: Setup Synchronous Connection/ { keep = (cur >= lo && cur <= hi) }
                    /HCI Event: Synchronous Connect Complete/   { keep = (cur >= lo && cur <= hi) }
                    /^[<>@=!]/ && !/Setup Synchronous|Synchronous Connect Complete/ { keep = 0 }
                    keep { print }'
                echo
            done
        } > "$dir/sco-params.txt"
    fi
    [[ -s "$dir/sco-params.txt" ]] || \
        echo "(no Setup Synchronous Connection inside this trial's window in either capture path)" \
        > "$dir/sco-params.txt"

    # --- the observer as an experimental intervention -----------------------
    # The liveness probe is not observationally inert. `hciconfig <dev> name`
    # injects an HCI command/response exchange into the same controller whose
    # rare state transitions are under study, and it is already proven to
    # deterministically abort an active btmon capture (EX-011). Something that
    # demonstrably perturbs one observer cannot be assumed harmless to the
    # subject.
    #
    # There is NO evidence the probe contributes to BT-1, and it is not being
    # treated as a suspect. It is being recorded so the question is answerable
    # rather than assumed. If a pattern ever emerges — every fatal transition
    # shortly after a probe — it will be visible in this column instead of being
    # discovered weeks later. If failures fall at arbitrary distances from
    # thousands of probes, that is negative evidence against an observer effect,
    # which is worth just as much.
    #
    # ⚠ THIS COLUMN IS NOT "ALL LIVENESS INTERVENTIONS". It counts
    # bt-health-snapshot invocations, which are the systematic, journal-visible
    # source. Other raw-HCI probes happen and are NOT counted here:
    #   * bt-trial's own hci_alive(), which runs `hciconfig <hci> name`
    #   * every bt-state invocation, which does the same
    # Those are operator- or script-driven and leave no dedicated journal entry,
    # so the column is a lower bound on the intervention count. Treating it as
    # the total would understate the exposure it exists to measure.
    #
    # btmon aborts are counted alongside as a partial corroborator. EX-011 found
    # one abort per raw-HCI exchange when probes were spaced far enough apart
    # for btmon to have finished restarting; unspaced probes produce fewer. So
    # the relation is "consistent with 1:1 under spaced observation", NOT an
    # established 1:1, and the abort count is itself a lower bound.
    probes=$(journalctl -u bt-health-snapshot.service -u bt-health-snapshot-event.service \
             --since "$since" --no-pager -o cat 2>/dev/null \
             | grep -c "Snapshot Bluetooth health metrics" || true)
    aborts=$(journalctl -u bt-trace --since "$since" --no-pager -o cat 2>/dev/null \
             | grep -c "exited" || true)

    # Distance from the last probe preceding the first timeout. Empty when there
    # was no timeout; "?" when a timeout occurred with no probe before it.
    # Only the TIMER-driven unit is used. The udev-driven one fires on the
    # controller's own failure events, so measuring a timeout's distance from it
    # measures outcome-dependent sampling — see EX-012. This raw interval is
    # still not interpretable alone; `bt-phase` normalises it against the
    # exposure distribution, and that is where any conclusion belongs.
    probe_to_tmo="?"
    if [[ -n "$t_tmo" ]]; then
        t_probe=$(journalctl -u bt-health-snapshot.service --since "$since" --until "$t_tmo" \
                  --no-pager -o short-iso-precise 2>/dev/null \
                  | grep "Snapshot Bluetooth health" | tail -1 | cut -d' ' -f1)
        if [[ -n "$t_probe" ]]; then
            probe_to_tmo=$(awk -f "$LIBDIR/timestamp.awk" -f "$LIBDIR/interval.awk" -v a="$t_probe" -v b="$t_tmo")
        fi
    fi

    hci_alive && resp_after=yes || resp_after=no
    # Resolve the device by VID/PID rather than by bus path: after a reset it
    # can re-enumerate at a different address, and a hardcoded path would then
    # report "gone" for a device that is present and working.
    usb_present=no
    for d in /sys/bus/usb/devices/*; do
        [[ -f "$d/idVendor" && -f "$d/idProduct" ]] || continue
        if [[ "$(<"$d/idVendor")" == "${BT_VID:-13d3}" && "$(<"$d/idProduct")" == "${BT_PID:-3503}" ]]; then
            usb_present=yes; break
        fi
    done

    # TRIAL TYPE IS FIRST-CLASS DATA, not implied by the outcome string.
    #
    # An observational boot and a controlled protocol run produce different
    # kinds of evidence and must never share a denominator. Previously the
    # distinction lived only in the outcome ("survived" vs "ok"), so a hang was
    # indistinguishable between the two — and a hang is exactly the row that
    # drives the failure rate the A/B/C/D gate depends on. A stock hang during
    # ordinary use would have been pooled with a stock hang under protocol v2.
    #
    # Recording the type explicitly means the two can be separated whatever the
    # outcome, and cannot be silently merged by a later reporting change.
    if (( auto )); then trial_type=observational_boot
    else                trial_type="controlled_v$PROTOCOL_VERSION"
    fi

    [[ -s "$RESULTS" ]] || printf 'timestamp\ttrial_type\tbuild\ttrial\tprotocol\toutcome\tduration_s\tsco_sent\tsco_to_timeout_s\ttimeouts\tresponds_after\tusb_present\tusb_lost\tprobes\tprobe_to_timeout_s\tbtmon_aborts\tkernel\n' > "$RESULTS"
    printf '%s\t%s\t%s\t%s\tv%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
        "$(date -Iseconds)" "$trial_type" "$build" "$n" "$PROTOCOL_VERSION" "$outcome" "$dur" \
        "${sco_sent:-?}" "$sco_to_tmo" "${tmo:-?}" "$resp_after" "$usb_present" \
        "${usb_gone:-?}" "${probes:-?}" "$probe_to_tmo" "${aborts:-?}" \
        "$(uname -r)" >> "$RESULTS"

    echo
    echo "  SCO setup requested   : ${sco_sent:-?}"
    echo "  SCO -> first timeout  : $sco_to_tmo s"
    echo "  command timeouts      : ${tmo:-?}"
    echo "  responds afterwards   : $resp_after"
    echo "  still on the USB bus  : $usb_present   (bus-loss events: ${usb_gone:-?})"
    echo "  request parameters    : $dir/sco-params.txt"
    echo "  liveness probes       : ${probes:-?}   (btmon aborts: ${aborts:-?})"
    echo "  last probe -> timeout : $probe_to_tmo s"

    if [[ "$outcome" == hang ]] && command -v bt-incident >/dev/null 2>&1; then
        echo "collecting incident evidence..."
        bt-incident "trial-$build-$n" --since "@$(( start - 60 ))" >/dev/null 2>&1 \
            && echo "  -> evidence/sessions/latest"
    fi

    rm -f "$CUR"
    if [[ "$outcome" == hang ]]; then
        echo "${R}${B}Trial $build #$n: HANG${O} after ${dur}s"
        echo "  cold power-off required before the next trial"
    else
        echo "${G}${B}Trial $build #$n: survived${O} (${dur}s)"
    fi
    echo
    "$0" report
    ;;

abort)
    [[ -e "$CUR" ]] || { echo "no trial open"; exit 0; }
    dir=$(grep '^dir=' "$CUR" | cut -d= -f2-)
    rm -rf "$dir"; rm -f "$CUR"
    echo "trial discarded"
    ;;

report)
    if [[ ! -s "$RESULTS" ]]; then echo "no trials recorded yet"; exit 0; fi
    echo "${B}Trial results${O}  ($RESULTS)"
    echo "─────────────────────────────────────────────────────────────"
    # Keyed on (trial_type, build), never on build alone. Column positions are
    # resolved from the header rather than hardcoded, so adding a field cannot
    # silently shift what is being counted — which is how a denominator gets
    # corrupted without anyone editing the arithmetic.
    awk -F'\t' '
    NR == 1 { for (i = 1; i <= NF; i++) c[$i] = i; next }
    {
        ty = (c["trial_type"] ? $c["trial_type"] : "unknown_pre_schema")
        b  = $c["build"]; k = ty "|" b
        tot[k]++; if ($c["outcome"] == "hang") h[k]++; sum[k] += $c["duration_s"]
    }
    END {
        printf "  %-20s %-8s %-10s %-8s %s\n", "TRIAL TYPE", "BUILD", "HANGS", "RATE", "mean duration"
        for (k in tot) {
            split(k, p, "|")
            rate = 100 * (h[k] + 0) / tot[k]
            printf "  %-20s %-8s %-10s %-8s %.0fs\n", p[1], p[2],
                   (h[k] + 0) "/" tot[k], sprintf("%.0f%%", rate), sum[k] / tot[k]
        }
        print ""
        print "  These rows must never be added together. An observational boot"
        print "  and a controlled protocol run are different evidence: the first"
        print "  says the machine did or did not hang during ordinary use, the"
        print "  second says the reproduction protocol was applied and the"
        print "  controller withstood it or did not. Only controlled_* rows can"
        print "  satisfy the A/B/C/D gate."
    }' "$RESULTS"
    echo
    echo "${B}Was the SCO stimulus actually applied, and did it matter?${O}"
    echo "─────────────────────────────────────────────────────────────"
    awk -F'\t' '
    NR==1 { for (i=1; i<=NF; i++) col[$i] = i; next }
    {
        # BY HEADER NAME, NEVER BY POSITION. This line read `$5 == "hang"`
        # until 2026-08-13. Inserting trial_type made field 5 `protocol`, so the
        # test was always false and EVERY hang in this cross-tab was silently
        # classified as survived — while the denominator table thirty lines
        # above, which does resolve by name, stayed correct.
        #
        # That is the second defect caused by one schema change (next_trial_no
        # was the first), in a file whose own comments state the rule. Hence
        # tests/run-tests permutes the header and asserts the report is
        # unchanged: positional assumptions are then mechanically impossible
        # rather than merely discouraged.
        s = (col["sco_sent"]  ? $col["sco_sent"]  : "?")
        f = (col["outcome"] && $col["outcome"] == "hang")
        if (s == "?" ) { unknown++; next }
        if (s+0 > 0) { if (f) a++; else b++ } else { if (f) c++; else d++ }
    }
    END {
        printf "  %-22s %8s %12s\n", "", "hung", "survived"
        printf "  %-22s %8d %12d\n", "SCO setup requested", a+0, b+0
        printf "  %-22s %8d %12d\n", "no SCO setup", c+0, d+0
        if (unknown) printf "\n  (%d trial(s) with no SCO field — recorded before this was tracked)\n", unknown
        print ""
        # Braces are mandatory here. Written without them, the second and third
        # print statements fell OUTSIDE the if, leaving `else` with no matching
        # `if` — an awk syntax error that killed this entire block. It failed on
        # stderr while the surrounding shell reported success, so the cross-tab
        # never ran at all from the day it was written. The separately reported
        # defect — outcome read by field position — was real, but in code that
        # was never reached.
        #
        # (And note this comment cannot contain an apostrophe: the whole awk
        # program is a single-quoted shell string, so one would end it.)
        if ((a+b) == 0) {
            print "  No trial has yet applied the stimulus. Until one does, nothing here"
            print "  distinguishes a build that fixes the bug from a run that never"
            print "  provoked it."
        } else if ((c+d) == 0) {
            print "  Every trial provoked SCO setup. The bottom row is empty, so this"
            print "  cannot yet separate the stimulus from the passage of time."
        } else if (b+0 > 0 && a+0 > 0) {
            print "  SCO setup has been survived AND followed by failure. The request"
            print "  alone is therefore not sufficient — look at its parameters."
        }
    }' "$RESULTS"
    echo
    echo "  Gate: stock must reach a high, stable failure rate (target 5/5) before"
    echo "  any build is compiled. Compare every build against the SAME protocol."
    echo
    echo "  A trial that survives WITHOUT provoking SCO setup proves nothing about"
    echo "  the build. Check the top row is filling before drawing conclusions."
    ;;

status)
    if [[ -e "$CUR" ]]; then echo "trial OPEN:"; sed 's/^/  /' "$CUR"
    else echo "no trial open"; fi
    ;;

*)  sed -n '2,18p' "$0"; exit 1 ;;
esac
