#!/bin/bash
# bt-incident — capture a hang that has ALREADY happened as a sanitised evidence session.
#
#   bt-incident <slug>                 collect the last 15 minutes
#   bt-incident <slug> --since "07:20" collect from a specific time
#   bt-incident <slug> --since -1h
#
# bt-evidence requires you to start a session BEFORE the event. Hangs do not
# announce themselves, so this collects retroactively from the journal.
#
# Writes evidence/sessions/<timestamp>-<slug>/ with filtered, sanitised logs,
# a merged timeline, current state, a manifest, and a NOTES.md skeleton.
# Binary btsnoop captures are referenced, never copied — they cannot be sanitised.

set -uo pipefail

# OPTIONS ARE READ BEFORE THE SLUG, and a slug may not look like one.
#
# `SLUG="${1:?...}"` took the first argument unconditionally, so `bt-incident
# --help` did not print usage — it COLLECTED AN INCIDENT named `--help`, and
# so did every mistyped flag. This tool copies kernel logs, bluetoothd logs
# and pairing exchanges into evidence/sessions/; a typo that silently produces
# a session directory is the wrong failure for it to have, and it produced two
# of them the first time a test asked for --help.
case "${1:-}" in
    -h|--help) sed -n '2,12p' "$0"; exit 0 ;;
    "")        echo "usage: bt-incident <slug> [--since <time>]" >&2; exit 2 ;;
    -*)        echo "bt-incident: first argument is the slug, not an option: $1" >&2
               echo "usage: bt-incident <slug> [--since <time>]" >&2; exit 2 ;;
esac
SLUG="$1"; shift || true
SINCE="-15min"
while [[ $# -gt 0 ]]; do
    case "$1" in
        --since) SINCE="${2:?--since needs a value}"; shift ;;
        -h|--help) sed -n '2,12p' "$0"; exit 0 ;;
        *) echo "unknown option: $1" >&2; exit 2 ;;
    esac
    shift
done

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# AN EXPLICIT BT_EVIDENCE_REPO IS OBEYED, ALWAYS.
#
# This was:
#
#     REPO="${BT_EVIDENCE_REPO:-$(cd "$HERE/.." && pwd)}"
#     [[ -d "$REPO/evidence" ]] || REPO=/root/exp/qca9377-bt-hang
#
# The second line silently discarded an EXPLICIT override whenever the named
# directory did not already contain evidence/, and redirected the write to a
# hardcoded absolute path belonging to one machine. Two consequences, both
# bad:
#
#   * It defeated the sandbox. BT_EVIDENCE_REPO is the mechanism the test
#     suite's fourth house rule depends on to keep fabricated incidents out
#     of the real evidence tree — the rule written after ten of them
#     accumulated there. A caller who set it correctly, to a fresh scratch
#     directory, got their collection written to the real repository instead,
#     because a fresh directory is exactly the case with no evidence/ in it.
#     Found by pointing it at a temp dir and watching three incident
#     directories appear somewhere else entirely.
#   * It shipped one machine's home-directory layout in a public repository.
#
# An override is now honoured whether or not evidence/ exists yet; the
# directory is created, as it would be for a first collection in a new
# checkout. Only the UNSET case falls back, and it falls back to the
# checkout this script lives in — never to an absolute path off it.
if [[ -n "${BT_EVIDENCE_REPO:-}" ]]; then
    REPO="$BT_EVIDENCE_REPO"
else
    REPO="$(cd "$HERE/.." && pwd)"
    if [[ ! -d "$REPO/evidence" ]]; then
        echo "bt-incident: $REPO has no evidence/ directory." >&2
        echo "  Run this from a checkout, or set BT_EVIDENCE_REPO to the target repo." >&2
        exit 1
    fi
fi
DIR="$REPO/evidence/sessions/$(date +%Y%m%d-%H%M%S)-${SLUG//[^a-zA-Z0-9._-]/_}"
mkdir -p "$DIR" || { echo "cannot create $DIR" >&2; exit 1; }

SAN=""
# BT_SANITIZER is a seam so a test can hand this tool a sanitiser that FAILS and
# check that the manifest says so (DR-06); BT_SANITIZER=none simulates a host
# with no sanitiser at all, which must also be an unpublishable session (F4).
if [[ "${BT_SANITIZER:-}" != none ]]; then
    for c in "${BT_SANITIZER:-}" "$HERE/sanitize-logs.sh" /usr/local/bin/bt-sanitize-logs; do
        [[ -n "$c" && -x "$c" ]] && { SAN="$c"; break; }
    done
fi

echo "collecting since '$SINCE' into $DIR"

journalctl -k --since "$SINCE" --no-pager -o short-precise 2>/dev/null \
  | grep -iE "hci|btusb|bluetooth|usb [0-9]+-[0-9]|xhci" > "$DIR/kernel.log" || true
journalctl -u bt-hang-watchdog --since "$SINCE" --no-pager -o short-precise 2>/dev/null \
  > "$DIR/watchdog.log" || true
journalctl -u bluetooth --since "$SINCE" --no-pager -o short-precise 2>/dev/null \
  | grep -vE "Endpoint (registered|unregistered)" > "$DIR/bluetoothd.log" || true
journalctl -u bt-trace --since "$SINCE" --no-pager -o short-precise 2>/dev/null \
  > "$DIR/trace-service.log" || true
command -v bt-timeline >/dev/null 2>&1 && bt-timeline "$SINCE" --raw > "$DIR/timeline.txt" 2>/dev/null || true
# bt-state is PROBE-FREE by default since 2026-09-18 (R2-94): it used to send
# `hciconfig name` — HCI Read Local Name — into the very window this tool
# exists to capture, from every capture made. bt-usbstate is the read-only view
# of the controller's transport state and is recorded beside it.
# Siblings resolved next to this file, not on PATH: PATH holds the installed
# copies, which are whatever was last deployed (R2-94 proof caught bt-status
# probing through exactly that).
_HERE="$(dirname "$(readlink -f "$0")")"
_bt_state="$_HERE/bt-state";     [[ -x "$_bt_state" ]]    || _bt_state=bt-state
_bt_usbstate="$_HERE/bt-usbstate"; [[ -x "$_bt_usbstate" ]] || _bt_usbstate=bt-usbstate
command -v "$_bt_state"    >/dev/null 2>&1 && "$_bt_state"    > "$DIR/state-now.txt" 2>&1 || true
command -v "$_bt_usbstate" >/dev/null 2>&1 && "$_bt_usbstate" > "$DIR/usb-state.txt" 2>&1 || true

# The sanitiser's exit status is the ONLY thing that says a file is clean: on a
# refusal (awk capability gate, addresses left after substitution) it leaves the
# raw text in place. Until 2026-09-19 this loop dropped that status and the
# manifest said `sanitised=yes` because a sanitiser EXISTED (R2-77, DR-06) —
# raw journal text beside a manifest that vouched for it. Now every failure is
# named in the manifest and the tool exits non-zero so nothing downstream
# treats the session as publishable.
SAN_FAILED=""
for f in "$DIR"/*.log "$DIR"/*.txt; do
    [[ -f "$f" && -s "$f" && -n "$SAN" ]] || continue
    if ! "$SAN" "$f" "$f" >/dev/null 2>&1; then
        SAN_FAILED="${SAN_FAILED:+$SAN_FAILED,}$(basename "$f")"
        echo "WARNING: sanitiser FAILED on $(basename "$f") — raw text left in place" >&2
    fi
done

{
    echo "# btsnoop captures overlapping this window (NOT committed — they contain"
    echo "# device addresses, names, pairing exchanges and audio payload)."
    echo "# Inspect: btmon -r <file>"
    echo
    find /var/log/bt-health/trace -name '*.btsnoop' -newermt "$SINCE" 2>/dev/null \
      | sort | while read -r f; do printf '  %10s  %s\n' "$(stat -c %s "$f")" "$f"; done
    echo
    echo "# CAPTURE GAPS in this window — moments when nothing was being recorded."
    echo "# btmon (bluez 5.72) aborts with a buffer overflow every few minutes; the"
    echo "# supervisor restarts it within ~1 s, but a gap can still straddle an event."
    echo "# An empty list below means the window was covered continuously."
    if [[ -f /var/log/bt-health/trace/gaps.log ]]; then
        awk -v since="$(date -d "$SINCE" -Iseconds 2>/dev/null)" \
            'since=="" || $1 >= since' /var/log/bt-health/trace/gaps.log \
          | sed 's/^/  /' || true
    else
        echo "  (no gap log — bt-trace may predate gap tracking)"
    fi
} > "$DIR/hci-captures.txt"

# -E, so callers can pass the opcode-aware timeout pattern and alternations.
count() { local n; n=$(grep -cE "$1" "$2" 2>/dev/null || true); echo "${n:-0}" | head -1; }
{
    echo "# Incident manifest"
    echo "slug=$SLUG"
    echo "collected=$(date -Iseconds)"
    echo "window=$SINCE"
    echo "kernel=$(uname -r)"
    # Canonical spelling (EX-015): bare "tx timeout" folds in link timeouts.
    echo "tx_timeouts=$(count 'command( 0x[0-9a-f]+)? tx timeout' "$DIR/kernel.log")"
    # Late mode logs "intervening"; EARLY mode logs "EARLY intervention". Counting
    # only the former reported 0 interventions alongside 1 recovery.
    echo "wd_interventions_late=$(count 'timeouts within' "$DIR/watchdog.log")"
    echo "wd_interventions_early=$(count 'EARLY intervention' "$DIR/watchdog.log")"
    echo "wd_early_signals=$(count 'early signal' "$DIR/watchdog.log")"
    echo "wd_recovered=$(count 'RECOVERED' "$DIR/watchdog.log")"
    echo "wd_recovered_early=$(count 'EARLY recovery SUCCEEDED|CONTROLLER RESPONDS AFTER EARLY INTERVENTION' "$DIR/watchdog.log")"
    echo "wd_reset_failed=$(count 'USBDEVFS_RESET failed' "$DIR/watchdog.log")"
    echo "wd_fatal=$(count 'FATAL:' "$DIR/watchdog.log")"
    echo "usb_descriptor_errors=$(count 'descriptor read' "$DIR/kernel.log")"
    echo "usb_disconnect=$(count 'USB disconnect' "$DIR/kernel.log")"
    if [[ -z "$SAN" ]]; then echo "sanitised=NO-SANITISER"
    elif [[ -n "$SAN_FAILED" ]]; then echo "sanitised=FAILED:$SAN_FAILED"
    else echo "sanitised=yes"; fi
} > "$DIR/MANIFEST.txt"

[[ -f "$DIR/NOTES.md" ]] || cat > "$DIR/NOTES.md" <<EOF
# Incident: $SLUG

**Collected:** $(date -Iseconds) (window: $SINCE)

## What was being done

<what you were doing when it hung>

## What happened

<see MANIFEST.txt and timeline.txt>

## What it means

<interpretation — the transcript cannot write this>
EOF

# A stable pointer to the session just written. Twice now a write-up has been
# saved to a guessed directory name that was one second off, silently creating a
# new directory containing only NOTES.md while the evidence sat elsewhere.
# Always resolve through this symlink instead of retyping a timestamp.
ln -sfn "$(basename "$DIR")" "$REPO/evidence/sessions/latest"

echo
sed 's/^/  /' "$DIR/MANIFEST.txt"
echo
echo "  -> $DIR"
echo "  -> also reachable as: evidence/sessions/latest"
# The session is written either way — a partial record beats none — but the
# exit status says whether it may be published as it stands (DR-06).
if [[ -z "$SAN" ]]; then
    echo "  ⚠️  NOT PUBLISHABLE: no sanitiser was available — every file is raw journal text" >&2
    exit 1
fi
if [[ -n "$SAN_FAILED" ]]; then
    echo "  ⚠️  NOT PUBLISHABLE: the sanitiser refused $SAN_FAILED — raw text is in place" >&2
    exit 1
fi
echo "  write the analysis to evidence/sessions/latest/NOTES.md"
echo "  run bt-postmortem for the timing breakdown"
