#!/bin/bash
# bt-boot-stats — one row per boot: did the controller misbehave, and did it hang?
#
# The point of this table is to keep correlations honest. It is easy to notice a
# dramatic-looking log signature in a boot that hung and conclude it caused the
# hang. The only way to know is to ask how often the signature appears in boots
# that did NOT hang, and how often boots hang WITHOUT it. Those are the two
# columns a maintainer will look for, so they are the two this table exists to
# provide.
#
# Columns:
#   BOOT     journalctl boot offset
#   DATE     date the boot began
#   HOURS    length of the boot's journal coverage
#   DESYNC   count of "unexpected event for opcode" (HCI pipeline desync)
#   TIMEOUT  count of "tx timeout" (controller stopped answering)
#   BUSLOST  count of controller USB disconnects; intervention provenance must
#            be checked before interpreting one as untreated progression
#   TMO      yes if the boot recorded any command timeout
#
# NOTE ON "TMO" vs "hung". This column means "recorded at least one HCI command
# timeout", which is the ONSET of stage 1. It is not the same as "the controller
# died and needed a cold boot" — that is the BUSLOST column. Figures quoted
# elsewhere in this repository as "N of 34 boots hung" come from
# evidence/baseline/baseline.tsv, a frozen snapshot over a DIFFERENT date range
# (from 2026-05-31). This tool reports whatever the journal currently retains,
# which changes as boots age out. The two are not comparable and neither should
# be used to correct the other.
#
# Usage: bt-boot-stats [--tsv]

set -uo pipefail

# Journal reads go through bt_journal so this tool can be driven over a
# fixture; see tools/lib/journal.sh.
LIBDIR="${BT_LIBDIR:-$(dirname "$(readlink -f "$0")")/lib}"
[[ -r "$LIBDIR/journal.sh" ]] || { echo "bt-boot-stats: missing $LIBDIR/journal.sh" >&2; exit 1; }
for _f in timestamp.awk boot-hours.awk; do
    [[ -r "$LIBDIR/$_f" ]] || { echo "bt-boot-stats: missing $LIBDIR/$_f" >&2; exit 1; }
done
# shellcheck source=tools/lib/journal.sh
source "$LIBDIR/journal.sh"

TSV=0
[[ "${1:-}" == "--tsv" ]] && TSV=1

BOOTLIST="${BT_BOOT_LIST:-/usr/local/bin/bt-boot-list}"
if [[ ! -x "$BOOTLIST" ]]; then
    BOOTLIST="$(dirname "$0")/bt-boot-list"
fi
[[ -x "$BOOTLIST" ]] || { echo "bt-boot-stats: bt-boot-list not found" >&2; exit 1; }

if (( TSV )); then
    printf 'boot\tdate\thours\tdesync\ttimeout\tbuslost\ttmo\n'
else
    printf '%-5s %-12s %6s %8s %8s %8s %5s\n' BOOT DATE HOURS DESYNC TIMEOUT BUSLOST TMO
    printf -- '---------------------------------------------------------------\n'
fi

tot=0; hung=0; lost=0; desync_hung=0; desync_ok=0; nodesync_hung=0

for b in $("$BOOTLIST" 2>/dev/null); do
    log=$(bt_journal -k -b "$b" --no-pager -o short-iso-precise 2>/dev/null)
    [[ -n "$log" ]] || continue

    nd=$(grep -c "unexpected event for opcode" <<<"$log" || true)
    # HCI command timeouts, opcode-named or not. NOT bare "tx timeout": that
    # also matches `link tx timeout` (ACL supervision, a different layer), of
    # which this machine has logged 7 against 173 real command timeouts. See
    # evidence/exhibits/015-timeout-pattern-undercount.md.
    nt=$(grep -cE "command( 0x[0-9a-f]+)? tx timeout" <<<"$log" || true)
    nb=$(grep -c "USB disconnect, device number" <<<"$log" || true)

    first=$(head -1 <<<"$log" | cut -d' ' -f1)
    last=$(tail -1 <<<"$log" | cut -d' ' -f1)
    d=${first%%T*}
    # Shared civil-date arithmetic (tools/lib/boot-hours.awk + timestamp.awk):
    # the private day-of-month copy this replaces printed -678.4 hours for a
    # boot spanning a month boundary, into a committed exhibit (EX-003), and a
    # private-but-correct copy is the divergence risk timestamp.awk exists to
    # end (review 2026-08-15T1752Z §3.1). "?" on a parse failure, never a
    # plausible number.
    hours=$(awk -f "$LIBDIR/timestamp.awk" -f "$LIBDIR/boot-hours.awk" \
                -v a="$first" -v b="$last" </dev/null) || hours="?"

    h=no
    if (( nt > 0 )); then h=yes; fi

    tot=$((tot + 1))
    (( nt > 0 )) && hung=$((hung + 1))
    (( nb > 0 )) && lost=$((lost + 1))
    if (( nd > 0 && nt > 0 )); then desync_hung=$((desync_hung + 1)); fi
    if (( nd > 0 && nt == 0 )); then desync_ok=$((desync_ok + 1)); fi
    if (( nd == 0 && nt > 0 )); then nodesync_hung=$((nodesync_hung + 1)); fi

    if (( TSV )); then
        printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$b" "$d" "$hours" "$nd" "$nt" "$nb" "$h"
    else
        printf '%-5s %-12s %6s %8s %8s %8s %5s\n' "$b" "$d" "$hours" "$nd" "$nt" "$nb" "$h"
    fi
done

(( TSV )) && exit 0

echo
printf 'boots examined                    %d\n' "$tot"
printf 'boots with >=1 command timeout    %d\n' "$hung"
printf 'boots where the device left bus   %d\n' "$lost"
echo
echo 'This covers only the boots the journal still retains. It is NOT the'
echo 'frozen baseline in evidence/baseline/baseline.tsv, which spans a'
echo 'different date range; do not compare the two totals.'
echo
echo 'Is the desync signature a predictor of the hang?'
printf '  desync present AND hung   %d\n' "$desync_hung"
printf '  desync present, NO hang   %d   <- false positives\n' "$desync_ok"
printf '  NO desync, hung anyway    %d   <- false negatives\n' "$nodesync_hung"
echo
echo '  A signature with both false positives and false negatives is a'
echo '  companion symptom, not a cause. Report it as such.'
