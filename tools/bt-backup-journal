#!/bin/bash
# bt-backup-journal — archive every retained boot, so evidence stops evaporating.
#
#   bt-backup-journal            archive every FINISHED boot not already archived
#   bt-backup-journal --dry-run  say what would be archived, write nothing
#   bt-backup-journal --status   what is archived, what is not, what has gone
#   bt-backup-journal --include-current   also archive boot 0 (a PREFIX — see below)
#
# WHY THIS EXISTS. The operator, 2026-08-19:
#
#   "I don't understand at all how we could work with evidence which just
#    disappears right on the plain sight."
#
# He is right, and the answer is not a bigger quota. `SystemMaxUse=16G` is not
# currently binding — the journal sits at 2.2 G with 70 G free — so raising it
# would change nothing. Boots have been lost anyway: to an earlier
# `MaxRetentionSec=1month` that took 34 boots to 18 at one reload, and to
# ordinary file rotation. Eight exhibits' source journals are already gone.
#
# An archive is immune to all of that. `bt-retention` says what is about to go
# and `bt-archive` copies one boot off the ring, but NEITHER RUNS ON ITS OWN —
# and a control that depends on someone remembering is not a control. This
# closes the loop for the whole journal in one command; a timer calling it is
# the version that needs nobody at all.
#
# ⚠️ BOOT 0 IS SKIPPED, AND THAT IS THE POINT OF THE 2026-08-31 REPAIR. Until
# then this archived every retained boot INCLUDING the live one. A live boot
# yields a prefix; the file is named by boot id and bt-archive refuses to
# overwrite; so the prefix reads as "already archived" forever after. Boot
# c8342e9b was found holding 6199 of its 40437 records — archived 08-24 while
# live, stopping 2.5 h before the 08-25 17:08 fault that EX-035 and EX-036 rest
# on, with zero `opcode 0x0428` lines in it. The boot was still on the ring, so
# the loss was recoverable by luck.
#
# A live boot cannot rotate off the ring — it is the one boot in no danger — so
# waiting until it is finished costs nothing and is the only way to get it
# whole. `--include-current` forces the old behaviour for the case that
# justifies it: a fault has just happened and the machine is about to be power
# cycled. `bt-archive --check` finds prefixes that are already on disk.
#
# ⚠️ ARCHIVES ARE UNSANITISED. `journalctl -o export` carries MAC addresses and
# Wi-Fi BSSIDs, and BSSIDs geolocate the machine. `bt-archive` refuses to write
# inside the repository and verifies every archive by reading it back; this only
# drives it, so both properties are inherited rather than reimplemented.
#
# Read-only with respect to the system.

set -uo pipefail
export LC_ALL=C

HERE=$(dirname "$(readlink -f "$0")")
# THE BOOT INDEX COMES THROUGH THE SEAM, like every other read-only tool here.
# This read was the one `journalctl` call left open-coded, which made the whole
# tool undrivable without a real journal — 0 of 50 lines had ever executed under
# test. bt-archive, which this drives, has been through the seam since it was
# written; going around it for the index alone meant the driver could not be
# tested where the thing it drives could.
LIBDIR="${BT_LIBDIR:-$HERE/lib}"
[[ -r "$LIBDIR/journal.sh" ]] || { echo "bt-backup-journal: missing $LIBDIR/journal.sh" >&2; exit 2; }
# shellcheck source=tools/lib/journal.sh
source "$LIBDIR/journal.sh"

ARCHIVE="${BT_ARCHIVE_BIN:-$HERE/bt-archive}"
DEST="${BT_ARCHIVE_DIR:-$HOME/bt-journal-archive}"

DRY=0; STATUS=0; CURRENT=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        --dry-run) DRY=1 ;;
        --status)  STATUS=1 ;;
        --include-current) CURRENT=1 ;;
        -h|--help) sed -n '2,8p' "$0"; exit 0 ;;
        *) echo "bt-backup-journal: unknown option: $1" >&2; exit 2 ;;
    esac
    shift
done

refuse() { echo "bt-backup-journal: REFUSING — $*" >&2; exit 2; }

[[ -x "$ARCHIVE" ]] || refuse "bt-archive not found or not executable at $ARCHIVE"

# index<TAB>boot-id for every retained boot, read from the index alone. No boot
# is traversed to decide whether it needs archiving.
mapfile -t ROWS < <(bt_journal --list-boots --no-pager 2>/dev/null \
                    | awk '$1 ~ /^-?[0-9]+$/ { print $1"\t"$2 }')

# ENUMERATED == 0 IS A REFUSAL. An empty boot list means --list-boots changed
# shape or the journal is unreadable, not that there is nothing to back up.
(( ${#ROWS[@]} > 0 )) || refuse "no retained boots found — nothing was examined"

printf 'bt-backup-journal — %s retained boot(s), archive at %s\n\n' "${#ROWS[@]}" "$DEST"

have=0; want=0; done_now=0; failed=0; skipped=0
for r in "${ROWS[@]}"; do
    IFS=$'\t' read -r idx bid <<< "$r"
    short="${bid:0:8}"
    # THE LIVE BOOT IS SKIPPED BY DEFAULT — see the header. Archiving it here
    # produces a prefix that then masquerades as a complete archive forever.
    if [[ "$idx" == "0" ]] && (( ! CURRENT )); then
        printf '  %-4s %s  skipped — still being written; archived when it finishes\n' "$idx" "$short"
        skipped=$((skipped + 1))
        continue
    fi
    # bt-archive names by boot id and refuses to overwrite, so presence of any
    # boot-<id>.export.* is the test for "already archived", whatever
    # compressor was available on the day.
    shopt -s nullglob
    existing=(); prefixed=0
    for f in "$DEST"/boot-"$short".export.*; do
        if [[ "$f" == *.prefix ]]; then prefixed=1; else existing+=("$f"); fi
    done
    if (( ${#existing[@]} > 0 && ! prefixed )); then
        printf '  %-4s %s  already archived\n' "$idx" "$short"
        have=$((have + 1))
        continue
    fi
    # A PREFIX IS NOT AN ARCHIVE. The boot has finished since it was taken, so
    # the records the prefix is missing are on the ring right now — re-archive
    # it while they still exist. This is the automatic half of the 08-31
    # repair: without it the marker would only ever be a complaint.
    if (( prefixed )); then
        printf '  %-4s %s  PREFIX on disk — re-archiving in full\n' "$idx" "$short"
    fi
    want=$((want + 1))
    if (( STATUS )); then
        printf '  %-4s %s  NOT archived\n' "$idx" "$short"
        continue
    fi
    if (( DRY )); then
        printf '  %-4s %s  would archive\n' "$idx" "$short"
        continue
    fi
    printf '  %-4s %s  archiving…\n' "$idx" "$short"
    # ⚠️ KEEP THE FAILING TOOL'S OWN WORDS. This used to be `>/dev/null 2>&1`,
    # so a failure reached the journal as the bare line "FAILED" and the reason
    # — bt-archive's `REFUSING — …`, which names it exactly — was thrown away.
    # When the timer failed on 2026-08-31 the cause had to be reproduced by
    # hand, from a service log that had recorded everything except the error.
    # stdout stays suppressed because it is the per-boot success banner and
    # this tool prints its own; stderr is the diagnosis and is never suppressed.
    # --replace ONLY for a marked prefix. A plain missing archive must still
    # hit bt-archive's overwrite refusal, which is what protects a good archive
    # from being silently replaced by a worse one.
    REPL=()
    (( prefixed )) && REPL=(--replace)
    if err=$("$ARCHIVE" "$idx" "${REPL[@]}" 2>&1 >/dev/null); then
        done_now=$((done_now + 1))
    else
        # A failure is reported per boot and does not stop the run: one
        # unreadable boot must not cost the other fourteen their backup.
        printf '  %-4s %s  FAILED — %s\n' "$idx" "$short" "${err:-no diagnostic produced}"
        printf '  %-4s %s  reproduce with: %s %s\n' "$idx" "$short" "$ARCHIVE" "$idx"
        failed=$((failed + 1))
    fi
done

echo
printf '  %s already archived, %s missing' "$have" "$want"
(( DRY || STATUS )) || printf ', %s archived now, %s failed' "$done_now" "$failed"
(( skipped > 0 )) && printf ', %s live boot skipped' "$skipped"
echo
# PRESENT IS NOT COMPLETE, and this tool cannot tell the difference cheaply —
# it tests for a file. Point at the check that does, rather than letting a
# clean run read as "every boot is safely archived".
echo "  (presence only — run 'bt-archive --check' to find PREFIXES on disk)"

if (( have + done_now > 0 )); then
    echo
    printf '  archive size: %s\n' "$(du -sh "$DEST" 2>/dev/null | cut -f1)"
    echo "  ⚠️  UNSANITISED — carries MACs and BSSIDs. Never commit; sanitise any extract."
fi

# NOT AN ERROR EXIT WHEN BOOTS ARE MISSING under --status/--dry-run: those modes
# exist to report, and a non-zero exit would make them unusable in a check.
(( failed > 0 )) && exit 1
exit 0
