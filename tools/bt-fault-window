#!/bin/bash
# bt-fault-window — the SCO-to-fault sequence around a command timeout, read
#                   and counted in one call.
#
#   bt-fault-window                     the first timeout of this boot
#   bt-fault-window --boot -7           a named boot
#   bt-fault-window --at '<timestamp>'  anchor explicitly
#   bt-fault-window --before 3 --after 3    widen the window (seconds)
#   bt-fault-window --raw               every line, noise included
#
# WHY THIS EXISTS. The operator, 2026-09-13:
#
#   "I need you to try to minimize the amount of the requests I get to provide
#    the permission. ... It is a great distraction, to waste lots of time."
#
# ⚠️ AND THE ALLOWLIST WAS NEVER THE PROBLEM. 364 permission entries were
# already granted, `journalctl *` among them, and the prompts kept coming. A
# tally of 3584 tool calls across this project's transcripts found 2344 of them
# — 65% — containing a pipe, `&&`, `$(...)` or a redirect. The permission
# matcher cannot analyse compound shell, so those match NO rule however broad,
# and prompt every single time. 226 of them were this one question: what
# happened around the fault?
#
# So the fix is not another entry. It is this file. `tools/*` is already
# granted, so every question answered here costs zero prompts for ever.
#
# WHAT IT FILTERS, AND WHY THAT IS NOT A LOSS. With dynamic debug on, a SCO
# window is mostly `len 27 mtu 9` repeated hundreds of times and bare `0` /
# `hci0` continuation lines. Those ARE the evidence — EX-037 turns on counting
# them — but they are evidence as a COUNT, not as text, and 680 of them hide
# the twenty lines that carry the sequence. So they are counted in full and
# summarised; `--raw` prints everything when the text itself is wanted.
#
# Read-only. Safe inside an untreated window: journald reads only, no sysfs
# write, nothing on the USB wire.

set -uo pipefail
export LC_ALL=C

HERE=$(dirname "$(readlink -f "$0")")
LIBDIR="${BT_LIBDIR:-$HERE/lib}"
[[ -r "$LIBDIR/journal.sh" ]] || { echo "bt-fault-window: missing $LIBDIR/journal.sh" >&2; exit 2; }
# shellcheck source=tools/lib/journal.sh
source "$LIBDIR/journal.sh"

# BEFORE=4 IS NOT A ROUND NUMBER, it is the measurement. The answered `0x0428`
# sits 2.076–2.191 s before the fault across EX-033/036/037/038, and a −1s
# default cut it off — the first run of this tool showed the timeout alone and
# none of the sequence that makes it diagnostic. Four seconds clears the widest
# recorded interval with margin.
BOOT=0; AT=""; BEFORE=4; AFTER=3; RAW=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        --boot)   BOOT="${2:?--boot needs an index}"; shift ;;
        --at)     AT="${2:?--at needs a timestamp}"; shift ;;
        --before) BEFORE="${2:?--before needs seconds}"; shift ;;
        --after)  AFTER="${2:?--after needs seconds}"; shift ;;
        --raw)    RAW=1 ;;
        -h|--help) sed -n '2,9p' "$0"; exit 0 ;;
        *) echo "bt-fault-window: unknown option: $1" >&2; exit 2 ;;
    esac
    shift
done

refuse() { echo "bt-fault-window: REFUSING — $*" >&2; exit 2; }

# ── THE ANCHOR ───────────────────────────────────────────────────────────
#
# Canonical timeout spelling (EX-015): the bare form carries no opcode, and a
# pattern requiring one matched 8 of 173 events. The FIRST timeout of a boot is
# the anchor, never the last — EX-037 established that the answered-then-dead
# shape belongs to the first setup against a healthy controller, and later ones
# fail in the ordinary named way.
TMO_RE='command( 0x[0-9a-f]+)? tx timeout'
if [[ -z "$AT" ]]; then
    AT=$(bt_journal -k -b "$BOOT" --no-pager -o short-iso-precise 2>/dev/null \
         | grep -E "$TMO_RE" | head -1 | awk '{print $1}')
    [[ -n "$AT" ]] || refuse "no command timeout in boot $BOOT — nothing to anchor on (use --at to force a window)"
fi

# journalctl wants 'YYYY-MM-DD HH:MM:SS'; the log prints ISO with a T and a
# zone. Split on T, drop the zone, and keep the fractional part so a window can
# be sub-second — the intervals this project measures are ~2 s wide.
DATE_PART="${AT%%T*}"
TIME_PART="${AT#*T}"
TIME_PART="${TIME_PART%%+*}"; TIME_PART="${TIME_PART%%Z*}"
EPOCH=$(date -d "$DATE_PART $TIME_PART" +%s 2>/dev/null) \
    || refuse "cannot parse the anchor timestamp: $AT"
FRAC="${TIME_PART#*.}"; [[ "$FRAC" == "$TIME_PART" ]] && FRAC=0

SINCE=$(date -d "@$((EPOCH - BEFORE))" '+%Y-%m-%d %H:%M:%S' 2>/dev/null)
UNTIL=$(date -d "@$((EPOCH + AFTER))" '+%Y-%m-%d %H:%M:%S' 2>/dev/null)

printf 'bt-fault-window — boot %s, anchored on %s\n' "$BOOT" "$AT"
printf '  window: %s … %s  (−%ss / +%ss)\n\n' "$SINCE" "$UNTIL" "$BEFORE" "$AFTER"

WIN=$(mktemp) || refuse "cannot create a work file"
trap 'rm -f "$WIN"' EXIT
bt_journal -k -b "$BOOT" --since "$SINCE" --until "$UNTIL" --no-pager -o short-iso-precise \
    2>/dev/null > "$WIN"

LINES=$(grep -c . "$WIN" 2>/dev/null || true)
# ENUMERATED == 0 IS A REFUSAL, as everywhere in this tree: an empty window
# means the boot rotated away or the selector is wrong, not that the machine
# was quiet at the moment it faulted.
if [[ "${LINES:-0}" -eq 0 ]]; then
    refuse "the window is empty — boot $BOOT may have rotated off the journal ring"
fi

# ── THE PACKET COUNTS, BY ENDPOINT WIDTH ─────────────────────────────────
#
# btusb prints `len <n> mtu <m>` per URB and `m` is the isochronous endpoint
# size, so it names the alternate setting actually in use. mtu 9 is the alt-1
# endpoint the WBS fallback selects; 27-byte mSBC frames do not fit it, and
# sustained traffic there precedes every recorded death (835 EX-033, 87 EX-036,
# 680 EX-037, 682 EX-038) while the one recorded survival of the same path has
# none. Counting all SCO traffic together hides exactly that distinction.
NARROW=$(grep -cE 'len [0-9]+ mtu 9$' "$WIN" 2>/dev/null || true)
NARROW27=$(grep -cE 'len 27 mtu 9$' "$WIN" 2>/dev/null || true)
WIDE=$(grep -cE 'len [0-9]+ mtu (1[0-9]|[2-9][0-9]+)$' "$WIN" 2>/dev/null || true)

printf '  SCO packets in this window\n'
printf '    alt-1  (mtu 9)   %8s   of which 27-byte mSBC: %s\n' "${NARROW:-0}" "${NARROW27:-0}"
printf '    wider  (mtu >9)  %8s   (CVSD — the healthy path)\n' "${WIDE:-0}"
if [[ "${NARROW27:-0}" -gt 0 ]]; then
    printf '    ⚠️  27-byte frames on a 9-byte endpoint — the BT-1 condition.\n'
fi
echo

printf '  sequence\n'
if (( RAW )); then
    sed 's/^/    /' "$WIN"
else
    # The signature lines, and nothing that repeats hundreds of times. Bare
    # `0` and bare `hci0` are dynamic-debug continuations carrying no content
    # of their own; they are dropped here and present under --raw.
    grep -vE 'len [0-9]+ mtu [0-9]+|kernel: 0$|kernel: hci0$' "$WIN" | sed 's/^/    /'
    printf '\n    (%s line(s) filtered as repeated SCO/debug noise — --raw shows all %s)\n' \
           "$(( LINES - $(grep -cvE 'len [0-9]+ mtu [0-9]+|kernel: 0$|kernel: hci0$' "$WIN" 2>/dev/null || echo 0) ))" \
           "$LINES"
fi

# ── THE INTERVAL, WHICH IS THE MEASUREMENT ───────────────────────────────
#
# Setup to fault, anchored on the answered `0x0428`. Across EX-033/036/037/038
# this spans 76 ms over two kernels and four occasions — the tightest number
# the project has, and it is only tight because it is measured from the setup
# rather than from whichever named command happened to time out.
SETUP=$(grep -E 'opcode 0x0428 plen' "$WIN" 2>/dev/null | head -1 | awk '{print $1}')
FAULT=$(grep -E "$TMO_RE" "$WIN" 2>/dev/null | head -1 | awk '{print $1}')
if [[ -n "$SETUP" && -n "$FAULT" ]]; then
    s=$(date -d "${SETUP%%T*} $(x="${SETUP#*T}"; x="${x%%+*}"; echo "${x%%Z*}")" +%s.%N 2>/dev/null)
    f=$(date -d "${FAULT%%T*} $(x="${FAULT#*T}"; x="${x%%+*}"; echo "${x%%Z*}")" +%s.%N 2>/dev/null)
    if [[ -n "$s" && -n "$f" ]]; then
        printf '\n  0x0428 setup → fault: %s s\n' "$(awk -v a="$s" -v b="$f" 'BEGIN{printf "%.3f", b-a}')"
        printf '    for comparison: EX-033 2.076  EX-036 2.152  EX-037 2.151  EX-038 2.191\n'
    fi
fi
exit 0
