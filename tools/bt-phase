#!/bin/bash
# bt-phase — did failures cluster near the liveness probe, or does it only look
#            that way because the probe never stops running?
#
# THE TRAP THIS EXISTS TO PREVENT.
#
# `bt-trial` records `probe_to_timeout_s`, the interval from the last liveness
# probe to the first HCI timeout. That number is NOT interpretable alone: the
# probe fires periodically, so every timeout is necessarily within one probe
# interval of a probe. "All failures occurred within 30 s of a probe" is
# arithmetic, not a finding.
#
# So this reports each failure's PHASE within the probe gap containing it:
#
#     phase = (t_failure - t_prev_probe) / (t_next_probe - t_prev_probe)
#
# Under independence that is uniform on [0,1] whatever the cadence irregularity,
# because each event is normalised by the gap it actually fell in.
#
# FOUR INVARIANTS, each of which was violated by an earlier version of this
# tool and each of which silently produces a confident wrong answer:
#
#   1. PROVENANCE, NOT SPACING. Only probes from bt-health-snapshot.service
#      (timer-driven, schedule independent of Bluetooth state) construct
#      intervals. bt-health-snapshot-event.service is the udev-driven one; its
#      timing is chosen partly by the outcome under study. An earlier version
#      inferred exogeneity from inter-probe spacing — but spacing is not
#      provenance, and an isolated udev probe passes that filter.
#
#   2. BOTH BOUNDARIES. It is not enough to exclude endogenous probes as
#      antecedents: an outcome-triggered CLOSING boundary still lets the event
#      choose the interval it is measured inside.
#
#   3. CLUSTERS, NOT LINES. One hung controller emits a burst of
#      `command tx timeout` lines. Counting lines as events inflates n and
#      destroys independence — the statistical caveat printed below assumes
#      independent failures. Only the FIRST timeout of each cluster counts.
#
#      ⚠ A CLUSTER IS NOT YET A PROVEN INCIDENT. The boundary here is purely
#      temporal: timeouts more than INCIDENT_GAP apart start a new cluster.
#      That is the same species of inference this project spends its time
#      eliminating — temporal proximity standing in for identity. It could
#      merge two genuine failures separated by a successful recovery, or split
#      one persistent bad state that happened to fall quiet. A real incident
#      boundary would be marked by evidence: controller recovery, USB
#      disappearance and re-enumeration, a new trial, a cold boot. Until the
#      output says clusters, and the count is a lower bound on distinct
#      failures rather than a measurement of them.
#
#   4. WITHIN A BOOT. A probe interval cannot span a reboot. Timestamps carry
#      full dates and every boot is analysed separately; an earlier version
#      compared seconds-since-midnight across concatenated boots, which could
#      pair a left probe from one boot with a right probe from another.
#
# Usage:
#   bt-phase [-b <boot>] [--incident-gap <s>]

set -uo pipefail

BOOT=""
INCIDENT_GAP="${BT_PHASE_INCIDENT_GAP:-600}"
TIMER_PERIOD="${BT_PHASE_TIMER_PERIOD:-900}"

while (( $# )); do
    case "$1" in
        -b) BOOT="${2:-0}"; shift 2 ;;
        --incident-gap) INCIDENT_GAP="${2:-600}"; shift 2 ;;
        -h|--help) sed -n '2,45p' "$0"; exit 0 ;;
        *) echo "bt-phase: unknown argument: $1" >&2; exit 1 ;;
    esac
done

BOOTLIST="${BT_BOOT_LIST:-/usr/local/bin/bt-boot-list}"
[[ -x "$BOOTLIST" ]] || BOOTLIST="$(dirname "$0")/bt-boot-list"

DATA=$(mktemp)
trap 'rm -f "$DATA"' EXIT

# Records are "<boot> <kind> <iso-timestamp>". Boot is carried explicitly so
# nothing is ever compared across a reboot.
collect() {
    local b="$1"
    journalctl -u bt-health-snapshot.service -b "$b" --no-pager -o short-iso-precise 2>/dev/null \
        | grep "Snapshot Bluetooth health metrics" | cut -d' ' -f1 \
        | while read -r t; do echo "$b EXO $t"; done >> "$DATA"
    journalctl -u bt-health-snapshot-event.service -b "$b" --no-pager -o short-iso-precise 2>/dev/null \
        | grep "Snapshot Bluetooth health metrics" | cut -d' ' -f1 \
        | while read -r t; do echo "$b ENDO $t"; done >> "$DATA"
    journalctl -k -b "$b" --no-pager -o short-iso-precise 2>/dev/null \
        | grep -E "command( 0x[0-9a-f]+)? tx timeout" | cut -d' ' -f1 \
        | while read -r t; do echo "$b TMO $t"; done >> "$DATA"
}

if [[ -n "$BOOT" ]]; then collect "$BOOT"
else for b in $("$BOOTLIST" 2>/dev/null); do collect "$b"; done
fi

if [[ ! -s "$DATA" ]]; then
    echo "bt-phase: no probe or timeout records found"
    exit 0
fi

echo "Probe-phase analysis"
echo "══════════════════════════════════════════════════════════════════"
echo "  intervals are built ONLY from timer-driven probes, at both boundaries,"
echo "  within a single boot, against the FIRST timeout of each cluster."
echo "  (cluster = timeouts within ${INCIDENT_GAP}s of each other — a TEMPORAL"
echo "   grouping, not an established incident boundary; see the header)"
echo

awk -v igap="$INCIDENT_GAP" -v period="$TIMER_PERIOD" '
# Proper civil-date to epoch seconds. An earlier version used
# seconds-since-midnight, which is wrong across months and across boots.
function days(y, m, d,   era, yoe, doy, doe) {
    if (m <= 2) y--
    era = int((y >= 0 ? y : y - 399) / 400)
    yoe = y - era * 400
    doy = int((153 * (m + (m > 2 ? -3 : 9)) + 2) / 5) + d - 1
    doe = yoe * 365 + int(yoe / 4) - int(yoe / 100) + doy
    return era * 146097 + doe - 719468
}
function s(t,   p, dpart, tpart, a, b) {
    split(t, p, "T")
    split(p[1], a, "-")
    split(p[2], b, /[:.+]/)
    return days(a[1] + 0, a[2] + 0, a[3] + 0) * 86400 + b[1] * 3600 + b[2] * 60 + b[3] + b[4] / 1000000
}
{
    boot = $1; kind = $2; t = s($3)
    if (kind == "EXO")  { ne[boot]++; exo[boot, ne[boot]] = t }
    if (kind == "ENDO") { nendo[boot]++ }
    if (kind == "TMO")  { nt[boot]++;  tmo[boot, nt[boot]] = t }
    boots[boot] = 1
}
END {
    for (b in boots) {
        # --- sort this boot'"'"'s exogenous probes -------------------------------
        n = ne[b] + 0
        for (i = 1; i <= n; i++) e[i] = exo[b, i]
        for (i = 2; i <= n; i++) { v = e[i]; j = i - 1
            while (j > 0 && e[j] > v) { e[j+1] = e[j]; j-- } ; e[j+1] = v }

        # --- provenance self-check ----------------------------------------
        # Provenance by unit name exists only for data recorded after the units
        # were split. Older boots put both sources in one unit and would present
        # as entirely exogenous. The timer period makes that checkable: a
        # genuinely timer-driven sequence cannot contain short gaps.
        short = 0
        for (i = 2; i <= n; i++) if (e[i] - e[i-1] < period / 2) short++
        if (short > 0) { bad[b] = short; totbad++; continue }

        # --- collapse timeout lines into incidents ------------------------
        m = nt[b] + 0
        for (i = 1; i <= m; i++) f[i] = tmo[b, i]
        for (i = 2; i <= m; i++) { v = f[i]; j = i - 1
            while (j > 0 && f[j] > v) { f[j+1] = f[j]; j-- } ; f[j+1] = v }
        inc = 0
        for (i = 1; i <= m; i++)
            if (i == 1 || f[i] - f[i-1] >= igap) { inc++; first[inc] = f[i] }
        lines[b] = m; incidents[b] = inc; totinc += inc; totlines += m

        # --- place each incident in its exogenous gap ---------------------
        for (k = 1; k <= inc; k++) {
            lo = 0; hi = 0
            for (i = 1; i <= n; i++) {
                if (e[i] <= first[k]) lo = e[i]
                if (e[i] >  first[k]) { hi = e[i]; break }
            }
            if (lo == 0 || hi == 0) { edge++; continue }
            gap = hi - lo
            if (gap <= 0) continue
            ph = (first[k] - lo) / gap
            printf "  boot %-4s phase %.3f   (%.1fs into a %.1fs gap)\n", b, ph, first[k] - lo, gap
            total++; sum += ph
            if (ph < 0.10) near++
            bucket[int(ph * 5)]++
        }
        for (i in e) delete e[i]
        for (i in f) delete f[i]
        for (i in first) delete first[i]
    }

    print ""
    if (totbad) {
        printf "  ⛔ %d boot(s) SKIPPED — provenance check failed.\n", totbad
        print  "     Timer-driven probes cannot be closer than half the timer"
        print  "     period. Those boots predate the split of"
        print  "     bt-health-snapshot.service from -event.service, so udev and"
        print  "     timer probes are indistinguishable and the baseline is"
        print  "     contaminated. Reporting a number for them would repeat EX-012."
        print  ""
    }
    printf "  timeout LINES      %d\n", totlines + 0
    printf "  timeout CLUSTERS   %d   <- grouped by a %ds gap, NOT proven incidents\n", totinc + 0, igap
    if (edge) printf "  outside probe range %d (excluded)\n", edge
    print ""
    if (total == 0) {
        print "  No timeout cluster could be placed inside a timer-driven probe gap."
        print "  Nothing to report — this is a coverage statement, not a result."
        exit
    }
    printf "  placed             %d\n", total
    printf "  mean phase         %.3f   (0.5 expected under independence)\n", sum / total
    printf "  within first 10%%   %d of %d\n", near + 0, total
    print ""
    print "  distribution across the gap:"
    for (i = 0; i <= 4; i++)
        printf "    %.1f-%.1f  %s\n", i / 5, (i + 1) / 5, (bucket[i] ? bucket[i] : 0)
    print ""
    if (total < 8) {
        print "  ⚠ Too few events for this to mean anything. Recorded so the"
        print "    question can be answered later, not so it can be answered now."
    } else if (near > total * 0.5) {
        print "  ⚠ Over half the clusters fall in the first 10% of their gap."
        print "    Not expected under independence; worth investigating."
    } else {
        print "  No evidence of an observer effect in this data. Note that this"
        print "  is an absence of evidence for clustering, NOT a demonstration"
        print "  of independence — with few events it cannot be that."
    }
}
' "$DATA"
