#!/bin/bash
# bt-phase — did failures cluster near the liveness probe, or does it only look
#            that way because the probe never stops running?
#
# THE TRAP THIS EXISTS TO PREVENT.
#
# `bt-trial` records `probe_to_timeout_s`, the interval from the last liveness
# probe to the first HCI timeout. That number is NOT interpretable alone: the
# probe fires periodically, so every timeout is necessarily within one probe
# interval of a probe. "All failures occurred within 30 s of a probe" is
# arithmetic, not a finding.
#
# So this reports each failure's PHASE within the probe gap containing it:
#
#     phase = (t_failure - t_prev_probe) / (t_next_probe - t_prev_probe)
#
# Under a constant-hazard event-time null independent of the probe schedule,
# that phase is uniform on [0,1] even when probe cadence is irregular. Probe
# independence alone is not enough: hazard that varies with boot age, audio
# activity or time of day can make phase nonuniform without any probe effect.
#
# FOUR INVARIANTS, each of which was violated by an earlier version of this
# tool and each of which silently produces a confident wrong answer:
#
#   1. PROVENANCE, NOT SPACING. Only probes from bt-health-snapshot.service
#      (timer-driven, schedule independent of Bluetooth state) construct
#      intervals. bt-health-snapshot-event.service is the udev-driven one; its
#      timing is chosen partly by the outcome under study. An earlier version
#      inferred exogeneity from inter-probe spacing — but spacing is not
#      provenance, and an isolated udev probe passes that filter.
#
#   2. BOTH BOUNDARIES. It is not enough to exclude endogenous probes as
#      antecedents: an outcome-triggered CLOSING boundary still lets the event
#      choose the interval it is measured inside.
#
#   3. CLUSTERS, NOT LINES. One hung controller emits a burst of
#      `command tx timeout` lines. Counting lines as events inflates n and
#      destroys independence — the statistical caveat printed below assumes
#      independent failure clusters and approximately constant hazard within
#      probe gaps. Only the FIRST timeout of each cluster counts.
#
#      ⚠ A CLUSTER IS NOT YET A PROVEN INCIDENT. The boundary here is purely
#      temporal: timeouts more than INCIDENT_GAP apart start a new cluster.
#      That is the same species of inference this project spends its time
#      eliminating — temporal proximity standing in for identity. It could
#      merge two genuine failures separated by a successful recovery, or split
#      one persistent bad state that happened to fall quiet. A real incident
#      boundary would be marked by evidence: controller recovery, USB
#      disappearance and re-enumeration, a new trial, a cold boot. Until the
#      output says clusters, and the count is a lower bound on distinct
#      failures rather than a measurement of them.
#
#   4. WITHIN A BOOT. A probe interval cannot span a reboot. Timestamps carry
#      full dates and every boot is analysed separately; an earlier version
#      compared seconds-since-midnight across concatenated boots, which could
#      pair a left probe from one boot with a right probe from another.
#
# Usage:
#   bt-phase [-b <boot>] [--incident-gap <s>]

set -uo pipefail

BOOT=""
INCIDENT_GAP="${BT_PHASE_INCIDENT_GAP:-600}"
TIMER_PERIOD="${BT_PHASE_TIMER_PERIOD:-900}"

while (( $# )); do
    case "$1" in
        -b) BOOT="${2:-0}"; shift 2 ;;
        --incident-gap) INCIDENT_GAP="${2:-600}"; shift 2 ;;
        -h|--help) sed -n '2,45p' "$0"; exit 0 ;;
        *) echo "bt-phase: unknown argument: $1" >&2; exit 1 ;;
    esac
done

LIBDIR="${BT_LIBDIR:-$(dirname "$(readlink -f "$0")")/lib}"
for f in timestamp.awk phase.awk journal.sh; do
    [[ -r "$LIBDIR/$f" ]] || { echo "bt-phase: missing $LIBDIR/$f" >&2; exit 1; }
done
# shellcheck source=tools/lib/journal.sh
source "$LIBDIR/journal.sh"

BOOTLIST="${BT_BOOT_LIST:-/usr/local/bin/bt-boot-list}"
[[ -x "$BOOTLIST" ]] || BOOTLIST="$(dirname "$0")/bt-boot-list"

DATA=$(mktemp)
trap 'rm -f "$DATA"' EXIT

# Records are "<boot> <kind> <iso-timestamp>". Boot is carried explicitly so
# nothing is ever compared across a reboot.
#
# Reads go through bt_journal, not journalctl, so this function can be driven
# over a fixture. Without that seam the three queries below reach the host
# journal and nothing above them can be tested — which is why this file had
# 0.0% of its lines executed until the seam existed.
collect() {
    local b="$1"
    bt_journal -u bt-health-snapshot.service -b "$b" --no-pager -o short-iso-precise 2>/dev/null \
        | grep "Snapshot Bluetooth health metrics" | cut -d' ' -f1 \
        | while read -r t; do echo "$b EXO $t"; done >> "$DATA"
    bt_journal -u bt-health-snapshot-event.service -b "$b" --no-pager -o short-iso-precise 2>/dev/null \
        | grep "Snapshot Bluetooth health metrics" | cut -d' ' -f1 \
        | while read -r t; do echo "$b ENDO $t"; done >> "$DATA"
    bt_journal -k -b "$b" --no-pager -o short-iso-precise 2>/dev/null \
        | grep -E "command( 0x[0-9a-f]+)? tx timeout" | cut -d' ' -f1 \
        | while read -r t; do echo "$b TMO $t"; done >> "$DATA"
}

if [[ -n "$BOOT" ]]; then collect "$BOOT"
else for b in $("$BOOTLIST" 2>/dev/null); do collect "$b"; done
fi

if [[ ! -s "$DATA" ]]; then
    echo "bt-phase: no probe or timeout records found"
    exit 0
fi

echo "Probe-phase analysis"
echo "══════════════════════════════════════════════════════════════════"
echo "  intervals are built ONLY from timer-driven probes, at both boundaries,"
echo "  within a single boot, against the FIRST timeout of each cluster."
echo "  null: constant failure hazard within gaps, independent of probe schedule."
echo "  (cluster = timeouts within ${INCIDENT_GAP}s of each other — a TEMPORAL"
echo "   grouping, not an established incident boundary; see the header)"
echo

awk -v igap="$INCIDENT_GAP" -v period="$TIMER_PERIOD" \
    -f "$LIBDIR/timestamp.awk" -f "$LIBDIR/phase.awk" "$DATA"
