#!/bin/bash
# bt-phase — did failures cluster near the liveness probe, or does it only look
#            that way because the probe never stops running?
#
# THE TRAP THIS EXISTS TO PREVENT.
#
# `bt-trial` records `probe_to_timeout_s`, the interval from the last liveness
# probe to the first HCI timeout. That number is NOT interpretable on its own.
# The probe fires periodically, so *every* timeout is necessarily within one
# probe interval of a probe. If probes fire every 30 s, then
#
#     "all fatal transitions occurred within 30 s of a probe"
#
# is not a finding. It is arithmetic. And a run of small values —
# 0.17, 2.4, 1.1 — will look thrilling long before it means anything.
#
# The question is whether the observed intervals are CONCENTRATED relative to
# the exposure available at each distance from a probe. So this tool does not
# report the raw interval. For each failure it locates the probe gap containing
# it and reports the failure's PHASE within that gap:
#
#     phase = (t_failure - t_previous_probe) / (t_next_probe - t_previous_probe)
#
# Under the null hypothesis — failures independent of probing — phase is
# uniform on [0, 1] regardless of how irregular the probe cadence is, because
# each event is normalised by the gap it actually fell in. That handles cadence
# drift from load, service restarts and controller operations without needing to
# assume a fixed period.
#
#   phases scattered across [0,1]          -> no observer effect visible
#   phases tightly clustered near 0        -> worth investigating
#   too few events to tell                 -> which is the usual answer, and is
#                                             stated rather than glossed over
#
# Usage:
#   bt-phase [-b <boot>]        analyse one boot (default: all retained boots)

set -uo pipefail

BOOT=""
[[ "${1:-}" == "-b" ]] && { BOOT="${2:-0}"; }

BOOTLIST="${BT_BOOT_LIST:-/usr/local/bin/bt-boot-list}"
[[ -x "$BOOTLIST" ]] || BOOTLIST="$(dirname "$0")/bt-boot-list"

PROBES=$(mktemp); FAILS=$(mktemp); ENDO=$(mktemp)
trap 'rm -f "$PROBES" "$FAILS" "$ENDO"' EXIT

collect() {
    local b="$1"
    # EXOGENOUS ONLY, BY PROVENANCE. bt-health-snapshot.service is driven by
    # bt-health-snapshot.timer, whose schedule exists independently of Bluetooth
    # state. bt-health-snapshot-event.service is the udev-driven one and is
    # deliberately NOT collected here: its timing is determined partly by the
    # outcome under study, so including it would let the controller choose the
    # ruler it is measured against.
    journalctl -u bt-health-snapshot.service -b "$b" --no-pager -o short-iso-precise 2>/dev/null \
        | grep "Snapshot Bluetooth health metrics" | cut -d' ' -f1 >> "$PROBES"
    journalctl -u bt-health-snapshot-event.service -b "$b" --no-pager -o short-iso-precise 2>/dev/null \
        | grep "Snapshot Bluetooth health metrics" | cut -d' ' -f1 >> "$ENDO"
    journalctl -k -b "$b" --no-pager -o short-iso-precise 2>/dev/null \
        | grep "command tx timeout" | cut -d' ' -f1 >> "$FAILS"
}

if [[ -n "$BOOT" ]]; then
    collect "$BOOT"
else
    for b in $("$BOOTLIST" 2>/dev/null); do collect "$b"; done
fi

sort -o "$PROBES" "$PROBES"
sort -o "$FAILS" "$FAILS"

# ---------------------------------------------------------------------------
# THE PROBE IS NOT EXOGENOUS, AND THAT INVALIDATES THE NAIVE STATISTIC.
#
# bt-health-snapshot runs from two sources:
#
#   bt-health-snapshot.timer                     every 15 min  — EXOGENOUS
#   51-bluetooth-health-snapshot.rules (udev)    on bluetooth/USB add+remove
#                                                              — ENDOGENOUS
#
# The udev rule fires on exactly the events a failing controller generates:
# the hci device going away, the USB device disappearing and re-enumerating. So
# during an incident, probes fire densely *because the incident is happening*.
#
# Run naively over all probes, this produced mean phase 0.084 with 6 of 8
# failures inside the first 10% of their gap — a result that looks like a strong
# observer effect and is in fact **reverse causation**. The tell was in the gap
# lengths: 2.7 s, 6.8 s, 9.2 s. A 15-minute timer cannot produce a 2.7-second
# gap; those were incident-triggered bursts.
#
# THE INVARIANT, stated explicitly because it is easy to half-implement:
# BOTH boundaries of every interval must come from the exogenous sequence. It is
# not enough to stop treating endogenous probes as candidate antecedents — if
# the *closing* boundary is outcome-triggered, the denominator has still been
# chosen by the event being located inside it. This tool therefore builds its
# gaps from the exogenous file alone; the endogenous probes are collected and
# counted, but never enter interval construction.
#
# Provenance now comes from the unit name rather than from inter-probe spacing.
# The earlier version guessed, dropping probes closer together than a threshold.
# That worked on the data at hand but was a heuristic standing in for a fact the
# system can simply record.
sort -o "$ENDO" "$ENDO"
nexo=$(wc -l < "$PROBES")
nendo=$(wc -l < "$ENDO")
nall=$(( nexo + nendo ))

nf=$(wc -l < "$FAILS"); np=$nexo

echo "Probe-phase analysis"
echo "══════════════════════════════════════════════════════════════════"
printf '  liveness probes (all)     %s\n' "$nall"
printf '    exogenous  (timer)      %s   <- builds the intervals\n' "$nexo"
printf '    endogenous (udev)       %s   <- counted, never used as a boundary\n' "$nendo"
printf '  command timeouts          %s\n' "$nf"
echo
echo "  Only timer-driven probes construct the intervals, at BOTH boundaries."
echo "  udev fires the same probe on bluetooth and USB add/remove — events a"
echo "  failing controller generates — so their timing is chosen partly by the"
echo "  outcome. Using them would be outcome-dependent interval construction:"
echo "  the statistic stays mathematically correct and becomes meaningless."
echo
echo "  KNOWN LIMITATION: these are EXECUTION timestamps, not scheduled due"
echo "  times. A timer invocation delayed by load or by controller trouble moves"
echo "  the ruler slightly, in a direction the system under study can influence."
echo "  Reconstructing due times from OnUnitActiveSec is the next refinement."
echo

# SELF-CHECK ON THE PROVENANCE CLAIM.
#
# Unit-name provenance only exists for data recorded after the units were split.
# Before that, udev-triggered and timer-triggered probes both landed in
# bt-health-snapshot.service and are indistinguishable by name — so an older
# boot would report every probe as "exogenous" and quietly reintroduce the exact
# contamination the split was made to remove.
#
# The timer runs at OnUnitActiveSec=15min, so a genuinely exogenous sequence
# cannot contain short gaps. Any gap far below that period is proof the set is
# not what it claims to be, whatever the unit name says.
TIMER_PERIOD="${BT_PHASE_TIMER_PERIOD:-900}"
short=$(awk -v lim="$(( TIMER_PERIOD / 2 ))" '
function s(t,   p, q, r) {
    split(t, p, "T"); split(p[2], q, /[:.+]/); split(p[1], r, "-")
    return ((r[3] * 24 + q[1]) * 3600) + q[2] * 60 + q[3] + q[4] / 1000000
}
{ t = s($0); if (last && t - last < lim) n++; last = t }
END { print n + 0 }' "$PROBES")

if (( short > 0 )); then
    echo "  ⛔ PROVENANCE CHECK FAILED — refusing to report a phase statistic."
    echo
    printf '  %s of the %s probes claimed exogenous are less than %ss apart,\n' \
        "$short" "$nexo" "$(( TIMER_PERIOD / 2 ))"
    printf '  but the timer period is %ss. They cannot all be timer-driven.\n' "$TIMER_PERIOD"
    echo
    echo "  Almost certainly this boot predates the split of"
    echo "  bt-health-snapshot.service from bt-health-snapshot-event.service,"
    echo "  so udev-triggered probes are indistinguishable by unit name and the"
    echo "  set is contaminated with outcome-dependent timestamps."
    echo
    echo "  Reporting a number here would repeat EX-012 exactly. Use boots"
    echo "  recorded after the split, where provenance is recorded rather than"
    echo "  inferred."
    exit 2
fi

if (( np < 2 )); then
    echo "  Fewer than two probes — no gaps to normalise against. Nothing to say."
    exit 0
fi
if (( nf == 0 )); then
    echo "  No timeouts recorded. Nothing to place within a probe cycle."
    echo "  This is the expected state most of the time; it is not a result."
    exit 0
fi

awk -v np="$np" '
function s(t,   p, q, r) {
    split(t, p, "T"); split(p[2], q, /[:.+]/); split(p[1], r, "-")
    return ((r[3] * 24 + q[1]) * 3600) + q[2] * 60 + q[3] + q[4] / 1000000
}
NR == FNR { probe[++n] = s($0); next }
{
    f = s($0)
    # Locate the gap containing this failure.
    lo = 0; hi = 0
    for (i = 1; i <= n; i++) {
        if (probe[i] <= f) lo = probe[i]
        if (probe[i] > f)  { hi = probe[i]; break }
    }
    if (lo == 0 || hi == 0) { edge++; next }      # outside the probed range
    gap = hi - lo
    if (gap <= 0) next
    ph = (f - lo) / gap
    total++
    printf "  phase %.3f   (%.1fs into a %.1fs gap)\n", ph, f - lo, gap
    sum += ph
    if (ph < 0.10) near++
    bucket[int(ph * 5)]++
}
END {
    print ""
    if (total == 0) {
        print "  No failure fell inside a probe gap — nothing to normalise."
        exit
    }
    printf "  events placed      %d", total
    if (edge) printf "   (%d outside the probed range, excluded)", edge
    print ""
    printf "  mean phase         %.3f   (0.5 expected if independent)\n", sum / total
    printf "  within first 10%%   %d of %d\n", near + 0, total
    print ""
    print "  distribution across the gap:"
    for (i = 0; i <= 4; i++)
        printf "    %.1f-%.1f  %s\n", i / 5, (i + 1) / 5, (bucket[i] ? bucket[i] : 0)
    print ""
    if (total < 8) {
        print "  ⚠ Too few events for this to mean anything. With fewer than"
        print "    roughly eight independent failures, any pattern here is"
        print "    consistent with chance. Recorded so the question can be"
        print "    answered later, not so it can be answered now."
    } else if (near > total * 0.5) {
        print "  ⚠ Over half the failures fall in the first 10% of their gap."
        print "    That is NOT expected under independence and is worth"
        print "    investigating as a possible observer effect."
    } else {
        print "  Phases are spread across the interval. No evidence of an"
        print "  observer effect in this data."
        print ""
        print "  Note what that does and does not say. A spread of phases does"
        print "  not DEMONSTRATE independence — with few events it cannot. What"
        print "  it establishes is the absence of evidence for clustering, which"
        print "  is worth stating plainly and is not the same claim."
    }
}
' "$PROBES" "$FAILS"
