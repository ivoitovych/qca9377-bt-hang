#!/bin/bash
# bt-mode — switch between daily-use mitigation and a clean experimental
#           baseline, reversibly, and record which one is active.
#
# WHY TWO MODES.
#
# This machine has been running a stock kernel inside a mitigated environment
# since 2026-08-10 (EX-013): USB autosuspend disabled, the radio pinned
# power/control=on, periodic health probes issuing real HCI commands, and a
# watchdog that on this host resets the controller BEFORE any HCI timeout.
#
# That is a reasonable configuration for using the laptop. It is a bad one for
# observing the defect, and specifically it can prevent the observation the
# investigation is waiting for:
#
#   * the early watchdog fires on precursors this project has already REFUTED
#     as causal markers — the audio-teardown signature, the 16 s desync, the
#     A2DP-idle trigger — so it resets the controller on evidence that does not
#     predict failure, and destroys the trajectory that would have shown what
#     does. Those trials are recorded `censored_pre_failure` and enter no rate.
#   * late-mode recovery changes whether a boot ends with a live controller, so
#     it changes the outcome as well as the observation.
#   * autosuspend and power policy alter the controller's operating conditions
#     from boot onward, so they are workarounds under test, not constants.
#
#   mitigation   keep Bluetooth working; accept censored observations
#   experiment   observe the defect; accept that a hang needs a cold power-off
#
# Passive capture (bt-capture, bt-trace, bt-usbmon, dynamic debug) stays on in
# BOTH modes. Those observe; they do not intervene.
#
# EVERYTHING HERE IS REVERSIBLE. Config files are moved aside with a .disabled
# suffix rather than edited or deleted, and `bt-mode mitigation` puts them back.
#
# Usage:
#   bt-mode status        what is active now
#   bt-mode experiment    clean baseline (no recovery, original power policy)
#   bt-mode mitigation    restore the working-laptop configuration
#
#   --dry-run (-n)        print the plan; change nothing

set -uo pipefail

# Every path this tool touches is a seam, defaulting to the real one. bt-mode
# is the tool that turns the RECOVERY WATCHDOG OFF on a machine where a hang
# then needs a physical power-off, and it had never been executed under test —
# because executing it means doing exactly that. Parameterising the paths is
# what makes the round trip assertable without a machine to break.
VID="${BT_VID:-13d3}"; PID="${BT_PID:-3503}"
MODPROBE_CONF="${BT_MODPROBE_CONF:-/etc/modprobe.d/btusb-qca9377.conf}"
UDEV_DIR="${BT_UDEV_DIR:-/etc/udev/rules.d}"
UDEV_RULE="$UDEV_DIR/50-bluetooth-no-autosuspend.rules"
UDEV_SNAP="$UDEV_DIR/51-bluetooth-health-snapshot.rules"
STAMP="${BT_MODE_STAMP:-/usr/local/share/qca9377-bt-hang/mode}"
SYSFS_USB="${BT_SYSFS_USB:-/sys/bus/usb/devices}"
SYSFS_MOD="${BT_SYSFS_MODULE:-/sys/module/btusb/parameters}"

# --dry-run: print the plan, change nothing. install.sh and uninstall.sh both
# have this and the suite calls it their contract; the tool that switches OFF
# the safety net had no way to be asked what it was about to do. It is opt-in,
# NOT the default: making it default would silently turn `bt-mode experiment`
# into a no-op, and an operator who believes the watchdog is off while it is
# still rescuing the controller collects censored trials and does not know it.
# A wrong answer about the mode contaminates the evidence, which is worse than
# no answer.
DRY=0
ARGS=()
for a in "$@"; do
    case "$a" in
        --dry-run|-n) DRY=1 ;;
        *) ARGS+=("$a") ;;
    esac
done
set -- ${ARGS[@]+"${ARGS[@]}"}

need_root() { (( DRY )) && return 0
              [[ $EUID -eq 0 ]] || { echo "bt-mode: must run as root" >&2; exit 1; }; }

# REVIEWED-KEEP 2026-08-15T1752Z §3.2: keep the single-call-site dry-run
# design — run()/write_to() are the only mutation paths, so --dry-run cannot
# drift from apply. A separate "print the plan" branch is how dry runs rot.
#
# Every mutation goes through run(), so the dry run cannot drift from what
# apply does: they are the same call site with one branch between them.
run() { if (( DRY )); then echo "  would run: $*"; else "$@"; fi; }
# Redirections cannot go through run(), so writing a sysfs value gets its own
# wrapper rather than an exception to the rule.
write_to() { local v="$1" f="$2"
             if (( DRY )); then echo "  would write: $v > $f"; return 0; fi
             echo "$v" > "$f" 2>/dev/null; }

radio_dir() {
    local d
    for d in "$SYSFS_USB"/*; do
        [[ -f "$d/idVendor" && -f "$d/idProduct" ]] || continue
        [[ "$(<"$d/idVendor")" == "$VID" && "$(<"$d/idProduct")" == "$PID" ]] && { echo "$d"; return 0; }
    done
    return 1
}

show_status() {
    local d autos power wd probes
    autos=$(cat "$SYSFS_MOD/enable_autosuspend" 2>/dev/null || echo '?')
    power='?'; d=$(radio_dir) && power=$(cat "$d/power/control" 2>/dev/null || echo '?')
    if systemctl is-active --quiet bt-hang-watchdog 2>/dev/null; then
        # Counted: `| grep -q` inverts under pipefail (see tests/run-tests),
        # which would report the watchdog as late-only whenever BT_EARLY=1.
        n_early=$(systemctl show bt-hang-watchdog -p Environment --value 2>/dev/null \
                  | grep -c 'BT_EARLY=1' || true)
        if (( ${n_early:-0} > 0 ))
        then wd="on (early+late)"; else wd="on (late only)"; fi
    else wd="off"; fi
    systemctl is-active --quiet bt-health-snapshot.timer 2>/dev/null && probes=on || probes=off

    echo "Bluetooth experiment mode"
    echo "──────────────────────────────────────────────────────────"
    printf '  recorded mode        %s\n' "$(cat "$STAMP" 2>/dev/null || echo '(never set)')"
    printf '  recovery watchdog    %s\n' "$wd"
    printf '  periodic HCI probes  %s\n' "$probes"
    printf '  btusb autosuspend    %s   (Ubuntu default Y)\n' "$autos"
    printf '  radio power/control  %s   (Ubuntu default auto)\n' "$power"
    printf '  persistent overrides %s\n' \
        "$( [[ -e "$MODPROBE_CONF" ]] && echo 'modprobe conf ACTIVE' || echo 'modprobe conf disabled')"
    printf '                       %s\n' \
        "$( [[ -e "$UDEV_RULE" ]] && echo 'udev pin ACTIVE' || echo 'udev pin disabled')"
    echo
    echo "  Passive capture is unaffected by mode and should stay on:"
    for u in bt-capture bt-trace bt-usbmon bt-dyndbg; do
        printf '    %-12s %s\n' "$u" "$(systemctl is-active "$u" 2>/dev/null || echo inactive)"
    done
}

set_experiment() {
    need_root
    echo "Switching to EXPERIMENT mode"
    echo

    echo "[1/4] stop recovery and active probing"
    run systemctl disable --now bt-hang-watchdog 2>/dev/null && echo "  + watchdog stopped and disabled"
    run systemctl disable --now bt-health-snapshot.timer 2>/dev/null && echo "  + probe timer stopped and disabled"
    # The udev-driven probe fires on controller events; leaving it armed would
    # keep injecting HCI commands at exactly the moments under study.
    if [[ -e "$UDEV_SNAP" ]]; then
        run mv "$UDEV_SNAP" "$UDEV_SNAP.disabled" \
            && echo "  + event-driven probe rule disabled"
    fi

    echo "[2/4] restore Ubuntu power management"
    [[ -e "$MODPROBE_CONF" ]] && run mv "$MODPROBE_CONF" "$MODPROBE_CONF.disabled" && echo "  + modprobe autosuspend override disabled"
    [[ -e "$UDEV_RULE" ]] && run mv "$UDEV_RULE" "$UDEV_RULE.disabled" && echo "  + udev power/control pin disabled"
    # Runtime, so the current boot matches the persistent config rather than
    # waiting for a reload. Writing the module parameter affects devices bound
    # from now on; the radio's own control file is set directly.
    write_to Y "$SYSFS_MOD/enable_autosuspend" && echo "  + enable_autosuspend=Y"
    if d=$(radio_dir); then
        write_to auto "$d/power/control" && echo "  + power/control=auto"
    fi

    echo "[3/4] reload rules"
    run udevadm control --reload-rules 2>/dev/null && echo "  + udev rules reloaded"
    run systemctl daemon-reload 2>/dev/null

    echo "[4/4] record the mode"
    run mkdir -p "$(dirname "$STAMP")"
    write_to "experiment since $(date -Iseconds)" "$STAMP"
    echo "  + $STAMP"
    echo
    echo "⚠ THE WATCHDOG IS OFF. A hang now requires a full POWER-OFF — a warm"
    echo "  reboot is believed not to recover it (untested — EX-017). The failure"
    echo "  will be observed rather than rescued."
    echo
    echo "Passive capture is untouched. Trials opened from now record"
    echo "treatment=autosusp=Y,power=auto,wd=off,probes=off and are directly"
    echo "comparable with the A/B/C/D builds."
}

set_mitigation() {
    need_root
    echo "Switching to MITIGATION mode"
    echo
    for f in "$MODPROBE_CONF" "$UDEV_RULE" "$UDEV_SNAP"; do
        [[ -e "$f.disabled" ]] && run mv "$f.disabled" "$f" && echo "  + restored $f"
    done
    write_to N "$SYSFS_MOD/enable_autosuspend" && echo "  + enable_autosuspend=N"
    if d=$(radio_dir); then write_to on "$d/power/control" && echo "  + power/control=on"; fi
    run udevadm control --reload-rules 2>/dev/null
    run systemctl enable --now bt-hang-watchdog 2>/dev/null && echo "  + watchdog running"
    run systemctl enable --now bt-health-snapshot.timer 2>/dev/null && echo "  + probe timer running"
    run mkdir -p "$(dirname "$STAMP")"
    write_to "mitigation since $(date -Iseconds)" "$STAMP"
    echo
    echo "Recovery is active again. Observations may be censored by early"
    echo "intervention; bt-trial records them as such."
}

case "${1:-status}" in
    status)     show_status ;;
    experiment) set_experiment ;;
    mitigation) set_mitigation ;;
    -h|--help)  sed -n '2,38p' "$0" ;;
    *) echo "bt-mode: unknown mode: $1" >&2; echo "usage: bt-mode [status|experiment|mitigation]" >&2; exit 1 ;;
esac
