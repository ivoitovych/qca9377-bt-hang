#!/bin/bash
# bt-diagnose — has this machine recorded the HCI command-timeout phenotype?
#
#   ./tools/bt-diagnose
#
# Standalone: no installation, no configuration, nothing written. Clone the
# repo and run it. It displays the currently attached USB Bluetooth controller
# and reports system-wide historical log counts.
#
# IMPORTANT LIMIT. Kernel timeout/reset/firmware lines do not carry a stable
# VID:PID identity across retained boots. They also do not say which timeout a
# reset answered or why a reset occurred. The counts below are therefore a
# phenotype report, not a device-table or causal diagnosis.
#
# Exit: 0 = phenotype not observed, 1 = phenotype observed, 2 = cannot determine.

set -uo pipefail

G=$'\033[32m'; R=$'\033[31m'; Y=$'\033[33m'; B=$'\033[1m'; O=$'\033[0m'
# Locate bt-boot-list next to this script, then on PATH. Enumerating boots is
# subtle enough (see that script's header) that it must not be reimplemented.
_here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BOOTLIST=""
for c in "$_here/bt-boot-list" "$_here/../tools/bt-boot-list" /usr/local/bin/bt-boot-list; do
    [[ -x "$c" ]] && { BOOTLIST="$c"; break; }
done
[[ -n "$BOOTLIST" ]] || BOOTLIST=""
boot_indices() {
    if [[ -n "$BOOTLIST" ]]; then "$BOOTLIST" ${1:+-n "$1"}
    else journalctl --list-boots 2>/dev/null | awk '$1 ~ /^-?[0-9]+$/ {print $1}' | sort -n; fi
}

[[ -t 1 ]] || { G=""; R=""; Y=""; B=""; O=""; }

diagnose_verdict() {
    local timeouts="$1" resets="$2" fw="$3" boots="$4"

    echo "─────────────────────────────────────────────────────────────"
    if (( timeouts == 0 )); then
        echo "${G}HCI command-timeout phenotype NOT observed.${O}"
        echo "No HCI command timeouts were found in the retained kernel journal."
        echo "That means only that the available history contains no observation;"
        echo "it does not prove the controller or its driver configuration is healthy."
        return 0
    fi

    echo "${R}${B}HCI command-timeout phenotype observed.${O}"
    echo
    echo "$timeouts HCI command timeout(s) across $boots retained boot(s)."
    if (( resets > 0 )); then
        echo "$resets reset-like kernel message(s) also appear in that history."
    else
        echo "No reset-like kernel messages appear in that history."
    fi
    if (( fw > 0 )); then
        echo "$fw vendor-firmware message(s) also appear in that history."
    else
        echo "No vendor-firmware messages appear in that history."
    fi
    echo
    echo "These are aggregate, unpaired, system-wide counts. They do NOT establish"
    echo "that a reset answered any counted timeout, that a reset callback is or is"
    echo "not installed for the current controller, or that firmware setup did or"
    echo "did not run for it. Establish those facts from the device table, source or"
    echo "shipped module, scoped to the exact VID:PID."
    return 1
}

main() {
echo "${B}Bluetooth controller diagnosis${O}"
echo "─────────────────────────────────────────────────────────────"

# ── 1. Find the Bluetooth controller(s) ───────────────────────────────────
# Auto-detect: any USB device with a bluetooth/hci child. Beats hardcoding an
# ID, and means this works on controllers other than the one that motivated it.
found=0
declare -a DEVS=()
for d in /sys/bus/usb/devices/*; do
    [[ -f "$d/idVendor" ]] || continue
    for p in "$d"/*/bluetooth/hci*; do
        [[ -e "$p" ]] || continue
        DEVS+=("$d|$(basename "$p")")
        found=1; break
    done
done

if (( ! found )); then
    echo "${Y}No USB Bluetooth controller with an hci node found.${O}"
    echo
    echo "If Bluetooth used to work and the adapter has now vanished entirely,"
    echo "the current absence may itself be relevant, but it does not identify a"
    echo "cause. A full power-off has recovered this repository's QCA9377; whether"
    echo "a warm reboot can recover it remains deliberately untested (EX-017)."
    echo
    lsusb 2>/dev/null | grep -iE "bluetooth|wireless" | sed 's/^/  /'
    exit 2
fi

for entry in "${DEVS[@]}"; do
    d="${entry%|*}"; hci="${entry#*|}"
    vid=$(<"$d/idVendor"); pid=$(<"$d/idProduct")
    echo "controller: ${B}$vid:$pid${O} at $(basename "$d")  ($hci)"
    [[ -r "$d/power/control" ]] && echo "  usb power/control : $(cat "$d/power/control")"
    lsusb -d "$vid:$pid" 2>/dev/null | sed 's/^/  /'
done
VID=$(<"${DEVS[0]%|*}/idVendor"); PID=$(<"${DEVS[0]%|*}/idProduct")
HCI="${DEVS[0]#*|}"

# ── 2. Does the controller answer? ────────────────────────────────────────
echo
alive=unknown
if command -v hciconfig >/dev/null 2>&1; then
    timeout 6 hciconfig "$HCI" name >/dev/null 2>&1 && alive=yes || alive=no
elif command -v btmgmt >/dev/null 2>&1; then
    timeout 6 btmgmt --index "${HCI#hci}" info >/dev/null 2>&1 && alive=yes || alive=no
fi
case "$alive" in
    yes) echo "  ${G}✓${O} controller responds to HCI commands" ;;
    no)  echo "  ${R}✗${O} controller does NOT respond — it is stalled right now" ;;
    *)   echo "  ${Y}•${O} cannot probe (install 'bluez' for hciconfig/btmgmt)" ;;
esac

# ── 3. Historical phenotype ───────────────────────────────────────────────
echo
echo "${B}Log evidence${O}"
if ! command -v journalctl >/dev/null 2>&1; then
    echo "  ${Y}•${O} journalctl not available — cannot check history"
    echo "     Try instead: dmesg | grep -E 'command( 0x[0-9a-f]+)? tx timeout|Resetting usb device'"
    exit 2
fi

timeouts=0; resets=0; fw=0; boots=0
for b in $(boot_indices); do
    journalctl -k -b "$b" >/dev/null 2>&1 || continue
    boots=$((boots+1))
    # HCI command timeouts, opcode-named or not. NOT bare "tx timeout": that
    # also matches `link tx timeout` (ACL supervision, a different layer), of
    # which this machine has logged 7 against 173 real command timeouts. See
    # evidence/exhibits/015-timeout-pattern-undercount.md.
    t=$(journalctl -k -b "$b" --no-pager 2>/dev/null | grep -cE "command( 0x[0-9a-f]+)? tx timeout" || true)
    r=$(journalctl -k -b "$b" --no-pager 2>/dev/null | grep -ciE "Resetting usb device|Multiple cmd timeouts" || true)
    f=$(journalctl -k -b "$b" --no-pager 2>/dev/null | grep -ciE "using rampatch|nvm_usb|Failed to load .*firmware" || true)
    timeouts=$((timeouts + ${t:-0})); resets=$((resets + ${r:-0})); fw=$((fw + ${f:-0}))
done

printf '  boots examined            : %s\n' "$boots"
printf '  HCI command timeouts      : %s\n' "$timeouts"
printf '  reset-like kernel messages: %s\n' "$resets"
printf '  vendor firmware messages  : %s\n' "$fw"
echo "  scope                     : aggregate across retained boots; not VID:PID-paired"

# ── 4. Verdict ────────────────────────────────────────────────────────────
echo
diagnose_verdict "$timeouts" "$resets" "$fw" "$boots"
verdict_rc=$?

if (( verdict_rc == 1 )); then
    echo
    if [[ "$VID:$PID" == "13d3:3503" ]]; then
        echo "For 13d3:3503, verify the separate static mechanism with:"
        echo "  ./tools/bt-verify-kernel-mechanism"
    else
        echo "For $VID:$PID, inspect the matching btusb device-table entry and the"
        echo "running module before drawing a driver-mechanism conclusion."
    fi
    echo "See docs/issues.md for the evidence model and current open questions."
fi
return "$verdict_rc"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
