#!/bin/bash
# bt-retention — which exhibits can still be re-verified against the journal,
#                and which are one rotation away from being unverifiable.
#
#   bt-retention            report every exhibit
#   bt-retention --at-risk  only the ones in the oldest retained boot
#
# WHY THIS EXISTS. On 2026-08-16 a question about three long windows in EX-018
# was answered by discovering that the journal behind them was already gone —
# the oldest retained boot began 2026-08-12, and those windows are dated
# 2026-07-25 to 2026-08-11. Five windows' worth of source evidence had rotated
# away and nothing had said so. It was found by asking a question that happened
# to touch it.
#
# NOBODY DELETED THEM, WHICH IS THE POINT. Two mechanisms did:
#
#   the size cap    SystemMaxUse=16G, raised from 4G precisely to retain more.
#                   A cap is still a cap, and it discards oldest-first when
#                   reached. Dynamic debug emits roughly a million lines an
#                   hour, so the instrumentation that makes a boot worth keeping
#                   is what evicts the boots before it.
#   an age cap      MaxRetentionSec=1month, set once as a generous bound. It is
#                   not a bound, it is an instruction to delete, and journald
#                   acted on it at reload: 34 boots to 18 in one second, in a
#                   file whose purpose was to retain more. See the warning in
#                   etc/systemd/journald.conf.d/10-bt-investigation.conf.
#
# So the loss is structural rather than careless, and the defence is a warning
# rather than a bigger cap: this reports which evidence is still checkable while
# there is still time to archive it.
#
# EXHIBITS RECORD THE WRONG BOOT FOR THIS. Their provenance carries the boot id
# they were CAPTURED in, which for EX-025 is the boot after the fault it
# describes. So the timestamps in the exhibit's own output are used instead —
# they are the evidence's, not the capture's.
#
# THAT PARAGRAPH WAS TRUE OF THE INTENT AND FALSE OF THE CODE. The scan ran over
# the whole file, provenance included, and `| captured |` is an offset-carrying
# timestamp — so for any exhibit whose body is written in bare local time it was
# the ONLY match, and the capture time silently became the evidence's time. That
# is 13 of the 29 exhibits, EX-018 among them: it reported `retained` on the
# strength of a capture stamp, while the windows it describes (2026-07-25 to
# 2026-08-11) are the ones this tool was written because they had rotated away.
# The provenance block is now cut off before the scan.
#
# THE CAPTURE TIME IS STILL USED — IN THE ONE DIRECTION IT CANNOT LIE. Evidence
# precedes its capture, so the capture is an upper bound on the evidence's age.
# If an exhibit carries no absolute timestamp of its own and was captured BEFORE
# the oldest retained boot began, its source is gone by arithmetic, not by
# guess. The converse says nothing — a stamp captured inside the retained window
# tells you nothing about how old the evidence in it was — and is not reported.
#
# Cheap by construction: --list-boots carries every boot's range, so no boot is
# ever read. The tool this lesson came from spent seven minutes doing that.

set -uo pipefail

LIBDIR="${BT_LIBDIR:-$(dirname "$(readlink -f "$0")")/lib}"
[[ -r "$LIBDIR/journal.sh" ]] || { echo "bt-retention: missing $LIBDIR/journal.sh" >&2; exit 2; }
# shellcheck source=tools/lib/journal.sh
source "$LIBDIR/journal.sh"
[[ -r "$LIBDIR/evidence-window.sh" ]] \
    || { echo "bt-retention: missing $LIBDIR/evidence-window.sh" >&2; exit 2; }
# shellcheck source=tools/lib/evidence-window.sh
source "$LIBDIR/evidence-window.sh"

REPO="${BT_EVIDENCE_REPO:-${BT_REPO:-$(dirname "$(readlink -f "$0")")/..}}"
DIR="$REPO/evidence/exhibits"

ATRISK=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        --at-risk) ATRISK=1 ;;
        -h|--help) sed -n '2,7p' "$0"; exit 0 ;;
        *) echo "bt-retention: unknown option: $1" >&2; exit 2 ;;
    esac
    shift
done

refuse() { echo "bt-retention: REFUSING — $*" >&2; exit 2; }

[[ -d "$DIR" ]] || refuse "no exhibits directory at $DIR"

# ── retained boot ranges, from the index alone ───────────────────────────
declare -A BSTART BEND
NBOOT=0
LB_JSON=$(bt_journal --list-boots -o json --no-pager 2>/dev/null || true)
if [[ -n "$LB_JSON" ]] && command -v python3 >/dev/null 2>&1; then
    while IFS=$'\t' read -r bi bs be; do
        [[ -n "$bi" ]] || continue
        BSTART[$bi]=$bs; BEND[$bi]=$be; NBOOT=$((NBOOT + 1))
    done < <(python3 -c '
import json, sys
try:
    for b in json.loads(sys.stdin.read()):
        print("%s\t%d\t%d" % (b["index"], b["first_entry"] // 1000000, b["last_entry"] // 1000000))
except Exception:
    pass' <<<"$LB_JSON" 2>/dev/null)
fi
if (( NBOOT == 0 )); then
    # Text form. Two timestamps per line after the index and the boot id; the
    # separator between them varies by systemd version, so both ends are parsed
    # positionally from a normalised line rather than split on it.
    while IFS= read -r l; do
        [[ "$l" =~ ^[[:space:]]*-?[0-9]+[[:space:]]+[0-9a-f]{32} ]] || continue
        bi=$(awk '{print $1}' <<<"$l")
        norm=${l//—/ }
        s=$(awk '{print $4" "$5" "$6" "$7}' <<<"$norm")
        e=$(awk '{print $8" "$9" "$10" "$11}' <<<"$norm")
        bs=$(date -d "$s" +%s 2>/dev/null); be=$(date -d "$e" +%s 2>/dev/null)
        [[ -n "$bs" && -n "$be" ]] || continue
        BSTART[$bi]=$bs; BEND[$bi]=$be; NBOOT=$((NBOOT + 1))
    done < <(bt_journal --list-boots --no-pager 2>/dev/null)
fi

(( NBOOT > 0 )) || refuse "no retained boot could be given a time range — nothing can be judged"

# The oldest retained boot is the one that goes next, so evidence inside it is
# what needs archiving first.
OLDEST=""; OLDEST_T=0
for b in "${!BSTART[@]}"; do
    if [[ -z "$OLDEST" ]] || (( BSTART[$b] < OLDEST_T )); then OLDEST="$b"; OLDEST_T=${BSTART[$b]}; fi
done

covering() {   # <epoch> -> the boot index whose range contains it, or empty
    local t="$1" b
    for b in "${!BSTART[@]}"; do
        (( t >= BSTART[$b] && t <= BEND[$b] )) && { echo "$b"; return 0; }
    done
    return 1
}

TS_RE='[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?([+-][0-9]{2}:?[0-9]{2}|Z)'

n=0; kept=0; gone=0; none=0; risk=0; bound=0; declared=0
printf 'bt-retention — %s retained boot(s), oldest begins %s\n\n' \
    "$NBOOT" "$(date -d "@$OLDEST_T" '+%Y-%m-%d %H:%M' 2>/dev/null)"

for f in "$DIR"/[0-9]*.md; do
    [[ -e "$f" ]] || continue
    n=$((n + 1))
    base=$(basename "$f" .md)
    # The evidence's own timestamps, not the capture's, and ONLY the ones
    # carrying a UTC offset.
    #
    # Boot ranges are absolute epochs from journald. An exhibit timestamp
    # written `2026-08-14T21:02:15+02:00` is absolute too; the same instant
    # written `2026-08-14 21:02:15` is not, and `date -d` would place it in
    # whatever zone the reader happens to be in. The first version of this
    # dropped the offset while extracting and put a retained exhibit two hours
    # out — enough to report evidence as rotated away when it is still there,
    # which is the one answer this tool must never invent.
    #
    # An exhibit with no offset-carrying timestamp is reported as not judgeable
    # rather than guessed at. EX-018's tables are written in bare local time and
    # land there honestly: they cannot be placed on an absolute axis from the
    # file alone.
    #
    # THE PROVENANCE BLOCK IS CUT OFF FIRST. It is the record of the capture,
    # not of the evidence, and its `captured` field is offset-carrying — so an
    # exhibit whose own tables are bare local time would be judged entirely by
    # when someone ran the command. Truncating at the heading is deliberately
    # blunt: if a future exhibit puts something else after Provenance, it is
    # dropped too, and dropping evidence costs a "not judgeable" while keeping
    # the capture stamp costs a wrong answer.
    body=$(awk '/^#{1,6}[[:space:]]+Provenance[[:space:]]*$/ { exit } { print }' "$f")

    # ── A DECLARED WINDOW BEATS A SCAN, AND SAYING SO BEATS BOTH (BL-09) ──
    #
    # The scan below takes the earliest offset-carrying stamp anywhere in the
    # body, which is a heuristic: it assumes the earliest instant mentioned is
    # the earliest instant the evidence covers. That is usually true and is not
    # guaranteed — an exhibit quoting a date in its prose moves it.
    #
    # `**Evidence window.**` is the exhibit SAYING what it covers, so it is
    # preferred outright. Its `not placeable` form is the other half and the
    # more useful one: it separates "nobody has looked at this exhibit" from
    # "someone looked and it cannot be done", which the scan alone reports
    # identically. Closing BL-09's nine is then measurable rather than a matter
    # of remembering which is which.
    ew=$(bt_ew_read "$f")
    if [[ -n "$ew" ]]; then
        ewt=$(bt_ew_earliest "$ew")
        if [[ -z "$ewt" ]]; then
            declared=$((declared + 1)); none=$((none + 1))
            (( ATRISK )) || printf '  %-58s not judgeable — declared not placeable\n' "$base"
            continue
        fi
        ewb=$(covering "$ewt")
        if [[ -z "$ewb" ]]; then
            gone=$((gone + 1)); declared=$((declared + 1))
            (( ATRISK )) || printf '  %-58s GONE      declared window opens %s\n' \
                "$base" "$(grep -oE "$BT_EW_TS_RE" <<<"$ew" | head -1)"
        elif [[ "$ewb" == "$OLDEST" ]]; then
            kept=$((kept + 1)); risk=$((risk + 1)); declared=$((declared + 1))
            printf '  %-58s AT RISK   declared window in boot %s, the next to rotate\n' "$base" "$ewb"
        else
            kept=$((kept + 1)); declared=$((declared + 1))
            (( ATRISK )) || printf '  %-58s retained  declared window in boot %s\n' "$base" "$ewb"
        fi
        continue
    fi

    # EARLIEST BY INSTANT, NOT BY SPELLING. These were sorted as strings, which
    # agrees with time order only while every stamp carries the same offset —
    # true of all 128 stamps in the tree today, and false for one date a year,
    # when a capture either side of a DST change puts +01:00 and +02:00 on the
    # same day and the lexicographic minimum is the later instant.
    mapfile -t STAMP < <(grep -oE "$TS_RE" <<<"$body" | LC_ALL=C sort -u)
    ns=${#STAMP[@]}
    first=""; t=""
    if (( ns > 0 )); then
        mapfile -t EPOCH < <(printf '%s\n' "${STAMP[@]}" | date -f - +%s 2>/dev/null)
        # A count that does not match is not a parse failure to work around: it
        # means the stamps and the epochs no longer line up, so every index
        # below would name the wrong one. Say so instead of picking a minimum
        # out of a list of unknown provenance.
        #
        # It is reachable, not defensive. `date -f -` skips a line it cannot
        # read and carries on, and the regex above accepts dates that do not
        # exist: `2026-02-30T00:00:00+02:00` and `2026-08-15T25:00:00+02:00`
        # both match it. A typo in an exhibit therefore shortens the epoch list
        # while the stamp list keeps its length. The minimum is then taken over
        # a list missing an entry that might have been the earliest, so the
        # exhibit is not judged rather than judged from what survived.
        if (( ${#EPOCH[@]} != ns )); then
            none=$((none + 1))
            (( ATRISK )) || printf '  %-58s %s of %s timestamps unparseable — not judgeable\n' \
                "$base" "$(( ns - ${#EPOCH[@]} ))" "$ns"
            continue
        fi
        best=0
        for ((i = 1; i < ns; i++)); do (( EPOCH[i] < EPOCH[best] )) && best=$i; done
        first=${STAMP[$best]}; t=${EPOCH[$best]}
    fi

    if [[ -z "$t" ]]; then
        # No absolute timestamp in the evidence itself. The capture time is an
        # UPPER BOUND on the evidence's age — the command cannot have printed
        # output from after it ran — so a capture that predates every retained
        # boot settles the question in the one direction it can. A capture
        # inside the retained window settles nothing, and is not reported as if
        # it did.
        cap=$(grep -m1 -oE '^\|[[:space:]]*captured[[:space:]]*\|[[:space:]]*`[^`]+`' "$f" | grep -oE "$TS_RE")
        capt=""
        [[ -n "$cap" ]] && capt=$(date -d "$cap" +%s 2>/dev/null)
        if [[ -n "$capt" ]] && (( capt < OLDEST_T )); then
            gone=$((gone + 1)); bound=$((bound + 1))
            (( ATRISK )) || printf '  %-58s GONE      captured %s, before any retained boot\n' "$base" "$cap"
        else
            none=$((none + 1))
            (( ATRISK )) || printf '  %-58s no absolute timestamp of its own — not judgeable\n' "$base"
        fi
        continue
    fi
    b=$(covering "$t")
    if [[ -z "$b" ]]; then
        gone=$((gone + 1))
        (( ATRISK )) || printf '  %-58s GONE      earliest %s\n' "$base" "$first"
    elif [[ "$b" == "$OLDEST" ]]; then
        kept=$((kept + 1)); risk=$((risk + 1))
        printf '  %-58s AT RISK   in boot %s, the next to rotate\n' "$base" "$b"
    else
        kept=$((kept + 1))
        (( ATRISK )) || printf '  %-58s retained  boot %s\n' "$base" "$b"
    fi
done

echo
if (( n == 0 )); then
    refuse "no exhibits examined — nothing was judged"
fi
printf '  %s exhibit(s): %s still verifiable, %s no longer, %s not judgeable\n' \
    "$n" "$kept" "$gone" "$none"
# HOW MANY WERE JUDGED FROM A DECLARATION RATHER THAN A SCAN. The counts above
# read the same either way, and they are not the same claim: a declared window
# is the exhibit stating what it covers, a scanned one is this tool guessing
# from the earliest stamp it can see. BL-09 is closed when this number reaches
# the exhibit count, so it is printed rather than left to be counted by hand.
printf '  %s of the %s carry a declared **Evidence window.** (BL-09); the rest were scanned.\n' \
    "$declared" "$n"
(( bound > 0 )) && printf '  %s of the %s were settled by capture time alone — captured before any\n  retained boot, so whatever they describe is older still.\n' \
    "$bound" "$gone"
(( none > 0 )) && {
    echo
    echo "  NOT JUDGEABLE IS NOT A BUG IN THE EXHIBIT. It carries no timestamp with a"
    echo "  UTC offset outside its provenance block, so it cannot be placed on the"
    echo "  same absolute axis as journald's boot ranges. The capture time in the"
    echo "  provenance is deliberately not used for this: it is when the command ran,"
    echo "  not when the evidence happened, and for a retrospective exhibit the two"
    echo "  can be weeks apart. Reading one as the other reports a rotated-away"
    echo "  window as retained."
}
if (( risk > 0 )); then
    echo
    printf '  %s exhibit(s) sit in the OLDEST retained boot. That boot goes next.\n' "$risk"
    echo "  Archive their source now if the extraction may need re-running:"
    echo "    bt-archive <boot-index>"
fi
(( gone > 0 )) && {
    echo
    echo "  An exhibit whose source has gone is not invalid — its output was captured"
    echo "  verbatim with an exit status. It can no longer be RE-DERIVED, so treat it"
    echo "  as a record rather than as something a reviewer can reproduce."
}
exit 0
