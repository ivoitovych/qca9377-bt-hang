#!/bin/bash
# bt-boot-list — list journal boot indices robustly, oldest first, one per line.
#
#   bt-boot-list           every retained boot        -> -33 -32 … -1 0
#   bt-boot-list -n 5      the last 5                 ->  -4  -3 … -1 0
#   bt-boot-list --count   how many boots are retained
#
# WHY THIS EXISTS: enumerating boots is deceptively easy to get wrong, and the
# wrong version fails SILENTLY rather than loudly.
#
#   journalctl --list-boots --no-legend    -> prints NOTHING on systemd 257
#                                             (the whole listing is the legend)
#   journalctl --list-boots                -> works, but emits an "IDX …" header
#                                             row that parses as a boot
#
# Callers that used --no-legend fell back to a hardcoded range and examined a
# handful of boots while appearing to succeed — which turned a "signature
# present" verdict into "not present" on a machine whose evidence lived in an
# earlier boot. Hence: one implementation, tried in order of reliability, and
# an explicit failure if none work.

set -uo pipefail

N=0
COUNT=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        -n) N="${2:?-n needs a number}"; shift ;;
        --count) COUNT=1 ;;
        -h|--help) sed -n '2,8p' "$0"; exit 0 ;;
        *) echo "unknown option: $1" >&2; exit 2 ;;
    esac
    shift
done

command -v journalctl >/dev/null 2>&1 || { echo "journalctl not available" >&2; exit 2; }

indices=""

# 1. JSON — unambiguous where supported.
if [[ -z "$indices" ]]; then
    j=$(journalctl --list-boots -o json 2>/dev/null) || j=""
    if [[ -n "$j" ]] && command -v python3 >/dev/null 2>&1; then
        indices=$(python3 -c '
import json,sys
try:
    d=json.loads(sys.stdin.read())
    print("\n".join(str(b["index"]) for b in d))
except Exception:
    pass' <<<"$j" 2>/dev/null)
    fi
fi

# 2. -q suppresses the header on systemd versions that honour it.
if [[ -z "$indices" ]]; then
    indices=$(journalctl --list-boots -q 2>/dev/null | awk '$1 ~ /^-?[0-9]+$/ {print $1}')
fi

# 3. Plain output, discarding any row whose first field is not numeric.
if [[ -z "$indices" ]]; then
    indices=$(journalctl --list-boots 2>/dev/null | awk '$1 ~ /^-?[0-9]+$/ {print $1}')
fi

# 4. Nothing worked. Report the current boot only, and say so — a caller that
#    silently assumes more history than exists draws false conclusions.
if [[ -z "$indices" ]]; then
    echo "WARNING: could not enumerate boots; assuming current boot only" >&2
    indices="0"
fi

indices=$(sort -n <<<"$indices" | awk 'NF')

if (( COUNT )); then
    wc -l <<<"$indices" | tr -d ' '
    exit 0
fi

if (( N > 0 )); then
    tail -n "$N" <<<"$indices"
else
    printf '%s\n' "$indices"
fi
