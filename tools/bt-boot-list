#!/bin/bash
# bt-boot-list — list journal boot indices robustly, oldest first, one per line.
#
#   bt-boot-list           every retained boot        -> -33 -32 … -1 0
#   bt-boot-list -n 5      the last 5                 ->  -4  -3 … -1 0
#   bt-boot-list --count   how many boots are retained
#
# WHY THIS EXISTS: enumerating boots is deceptively easy to get wrong, and the
# wrong version fails SILENTLY rather than loudly.
#
#   journalctl --list-boots --no-legend    -> prints NOTHING on systemd 257
#                                             (the whole listing is the legend)
#   journalctl --list-boots                -> works, but emits an "IDX …" header
#                                             row that parses as a boot
#
# Callers that used --no-legend fell back to a hardcoded range and examined a
# handful of boots while appearing to succeed — which turned a "signature
# present" verdict into "not present" on a machine whose evidence lived in an
# earlier boot. Hence: one implementation, tried in order of reliability, and
# an explicit failure if none work.

set -uo pipefail

# Journal reads go through bt_journal so this tool can be driven over a
# fixture; see tools/lib/journal.sh.
LIBDIR="${BT_LIBDIR:-$(dirname "$(readlink -f "$0")")/lib}"
[[ -r "$LIBDIR/journal.sh" ]] || { echo "bt-boot-list: missing $LIBDIR/journal.sh" >&2; exit 1; }
# shellcheck source=tools/lib/journal.sh
source "$LIBDIR/journal.sh"

N=0
COUNT=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        -n) N="${2:?-n needs a number}"; shift ;;
        --count) COUNT=1 ;;
        -h|--help) sed -n '2,8p' "$0"; exit 0 ;;
        *) echo "unknown option: $1" >&2; exit 2 ;;
    esac
    shift
done

# CAPABILITY PROBE, VIA THE SEAM RATHER THAN AROUND IT.
#
# This was `command -v journalctl`, which after the seam conversion the suite
# flagged as a bypass — correctly, and for a subtler reason than a missed
# call site: naming journalctl directly reintroduces the dependency the seam
# exists to remove, so a fixture-driven run on a journal-less host would abort
# even though bt_journal could have served it perfectly.
#
# Asking bt_journal itself is both the fix and the better probe: it answers
# for whichever backend is actually in play.
if ! bt_journal --list-boots --no-pager >/dev/null 2>&1; then
    echo "no journal available (and no BT_JOURNAL_FIXTURE set)" >&2; exit 2
fi

indices=""

# REVIEWED-KEEP 2026-08-15T1752Z §3.2: keep the three-rung ladder below (JSON,
# then -q, then header-stripped plain text) exactly as ordered. Each rung
# exists because a real systemd version broke the one above it — see the file
# header — and collapsing them to the "obvious" single call reintroduces the
# version dependence this tool was written to absorb.

# 1. JSON — unambiguous where supported.
if [[ -z "$indices" ]]; then
    j=$(bt_journal --list-boots -o json 2>/dev/null) || j=""
    if [[ -n "$j" ]] && command -v python3 >/dev/null 2>&1; then
        indices=$(python3 -c '
import json,sys
try:
    d=json.loads(sys.stdin.read())
    print("\n".join(str(b["index"]) for b in d))
except Exception:
    pass' <<<"$j" 2>/dev/null)
    fi
fi

# 2. -q suppresses the header on systemd versions that honour it.
if [[ -z "$indices" ]]; then
    indices=$(bt_journal --list-boots -q 2>/dev/null | awk '$1 ~ /^-?[0-9]+$/ {print $1}')
fi

# 3. Plain output, discarding any row whose first field is not numeric.
if [[ -z "$indices" ]]; then
    indices=$(bt_journal --list-boots 2>/dev/null | awk '$1 ~ /^-?[0-9]+$/ {print $1}')
fi

# 4. Nothing worked. Report the current boot only, and say so — a caller that
#    silently assumes more history than exists draws false conclusions.
if [[ -z "$indices" ]]; then
    echo "WARNING: could not enumerate boots; assuming current boot only" >&2
    indices="0"
fi

indices=$(sort -n <<<"$indices" | awk 'NF')

if (( COUNT )); then
    wc -l <<<"$indices" | tr -d ' '
    exit 0
fi

if (( N > 0 )); then
    tail -n "$N" <<<"$indices"
else
    printf '%s\n' "$indices"
fi
