#!/bin/bash
# bt-verify-install — is what is RUNNING the same as what is COMMITTED?
#
#   bt-verify-install [repo-dir]
#
# Compares every installed artifact against its source in the checkout and
# reports drift. Exits non-zero if anything differs or is missing.
#
# WHY: scripts get edited and installed by hand mid-debugging, and the change
# then exists only on the machine. Twice in this project a tool was installed
# but never added to install.sh, so a fresh clone would not have reproduced the
# running system. A reboot is the worst time to discover that.
#
# Read-only.

set -uo pipefail

REPO="${1:-}"
if [[ -z "$REPO" ]]; then
    HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    for c in "$HERE/.." /root/exp/qca9377-bt-hang "$PWD"; do
        [[ -d "$c/.git" && -e "$c/install.sh" ]] && { REPO=$(cd "$c" && pwd); break; }
    done
fi
[[ -n "$REPO" && -d "$REPO" ]] || { echo "no checkout found; pass one as an argument" >&2; exit 2; }

G=$'\033[32m'; R=$'\033[31m'; Y=$'\033[33m'; B=$'\033[1m'; O=$'\033[0m'
[[ -t 1 ]] || { G=""; R=""; Y=""; B=""; O=""; }

same=0; drift=0; missing=0

# source-in-repo : installed-path, DERIVED FROM install.sh.
#
# This list used to be maintained by hand, and it drifted the moment tools were
# added: six tools installed on 2026-08-12 were absent from it, so the verifier
# reported "running system matches the checkout" while not checking a quarter of
# what was installed. A verifier that silently omits artefacts is worse than no
# verifier, because it converts an unknown into a false all-clear.
#
# install.sh is the single source of truth for what gets installed, so the list
# is now parsed from its install_file calls. Adding a tool there extends this
# automatically, and the two cannot disagree.
mapfile -t PAIRS < <(
    # Join backslash continuations first: install.sh wraps longer calls across
    # two lines, and parsing line-by-line yields "\" as the destination path —
    # which then reports as seven phantom missing artefacts.
    awk '{ while (/\\$/ && (getline nxt) > 0) { sub(/\\$/, "", $0); $0 = $0 nxt } print }' \
        "$REPO/install.sh" 2>/dev/null \
    | grep -oE 'install_file[[:space:]]+"\$SRC/[^"]+"[[:space:]]+[^[:space:]]+' \
    | awk '{
        src = $2; dst = $3
        gsub(/^"\$SRC\//, "", src); gsub(/"$/, "", src)
        if (dst ~ /^\//) print src ":" dst
      }'
)

if (( ${#PAIRS[@]} == 0 )); then
    echo "${R}FAIL${O}: could not parse install_file entries from $REPO/install.sh" >&2
    echo "       refusing to report success on an empty artefact list" >&2
    exit 1
fi

echo "${B}Install verification${O} — checkout: $REPO"
echo "─────────────────────────────────────────────────────────────"
for p in "${PAIRS[@]}"; do
    src="$REPO/${p%%:*}"; dst="${p##*:}"
    if [[ ! -e "$src" ]]; then
        printf '  %s?%s missing in repo: %s\n' "$Y" "$O" "${p%%:*}"; continue
    fi
    if [[ ! -e "$dst" ]]; then
        printf '  %s✗%s NOT INSTALLED: %s\n' "$R" "$O" "$dst"; missing=$((missing+1)); continue
    fi
    if cmp -s "$src" "$dst"; then
        same=$((same+1))
    else
        printf '  %s✗%s DRIFT: %s\n' "$R" "$O" "$dst"
        printf '        differs from %s\n' "${p%%:*}"
        drift=$((drift+1))
    fi
done

# The udev rules are generated from templates with the device ID substituted,
# so a byte comparison is wrong; check they exist and name the right device.
echo
VID="${BT_VID:-13d3}"; PID="${BT_PID:-3503}"
for r in 50-bluetooth-no-autosuspend 51-bluetooth-health-snapshot; do
    f="/etc/udev/rules.d/$r.rules"
    if [[ ! -e "$f" ]]; then
        printf '  %s✗%s NOT INSTALLED: %s\n' "$R" "$O" "$f"; missing=$((missing+1))
    elif grep -q "$VID" "$f" && grep -q "$PID" "$f"; then
        same=$((same+1))
    else
        printf '  %s✗%s %s does not reference %s:%s\n' "$R" "$O" "$f" "$VID" "$PID"; drift=$((drift+1))
    fi
done

echo
echo "${B}Services${O}"
# Same drift risk as the artefact list had: units added later were not listed
# here, so the verifier printed a clean Services block while saying nothing
# about two of them. Derived from the units install.sh enables, plus bluetooth
# itself, which the project does not install but does depend on.
mapfile -t UNITS < <(
    { echo bluetooth
      grep -oE 'systemctl enable --now [a-z0-9.-]+' "$REPO/install.sh" 2>/dev/null | awk '{print $NF}'
    } | sort -u
)
for u in "${UNITS[@]}"; do
    st=$(systemctl is-active "$u" 2>&1); en=$(systemctl is-enabled "$u" 2>&1)
    if [[ "$st" == active && "$en" == enabled ]]; then
        printf '  %s✓%s %-26s %s/%s\n' "$G" "$O" "$u" "$st" "$en"
    else
        printf '  %s✗%s %-26s %s/%s\n' "$R" "$O" "$u" "$st" "$en"; drift=$((drift+1))
    fi
done

echo
echo "${B}Effective watchdog config${O}"
systemctl show bt-hang-watchdog -p Environment --value 2>/dev/null | tr ' ' '\n' | grep '^BT_' | sed 's/^/  /'

echo
echo "─────────────────────────────────────────────────────────────"
if (( drift || missing )); then
    printf '%s%d in sync, %d drifted, %d not installed%s\n' "$R" "$same" "$drift" "$missing" "$O"
    echo "Run: sudo ./install.sh --apply"
    exit 1
fi
printf '%s%d artifacts in sync; running system matches the checkout%s\n' "$G" "$same" "$O"
