#!/bin/bash
# bt-capdiff — do the two independent HCI capture paths agree?
#
# WHY THIS EXISTS. There are now two capture systems recording the same stream
# from the same kernel monitor socket:
#
#   bt-trace    btmon, decoding as it writes        -> /var/log/bt-health/trace
#   bt-capture  raw frames, decoded later if at all -> /var/log/bt-health/capture
#
# The second was built because the first crashes (BT-4, 74 aborts in one boot).
# But redundancy bought something beyond crash tolerance, and it is worth using
# deliberately: agreement between the paths raises confidence in a reconstructed
# chronology, and DISAGREEMENT becomes an instrumentation finding rather than
# quietly contaminating a conclusion about the controller.
#
# ⚠ WHAT "INDEPENDENT" DOES AND DOES NOT MEAN HERE. These are independent
# ACQUISITION paths sharing a common source and a common offline decoder:
#
#   * both read the SAME kernel HCI monitor socket, so they are not two
#     independent observations of the controller — a kernel-side omission would
#     appear in both;
#   * the decode-free capture is decoded by btmon again when this tool runs, so
#     the paths are redundant against btmon failing AT CAPTURE TIME, but not
#     against a btmon decoder defect affecting offline reads.
#
# So agreement corroborates against capture-time loss, which is the failure mode
# actually observed. It does not corroborate against anything upstream of the
# monitor socket, and calling them simply "independent captures" would overstate
# what the architecture provides.
#
# That second case is the one that matters. A missing event in one path could be
# read as "the controller did not do X" when the truth is "one capture path lost
# X". This tool exists so that question is asked before a chronology is trusted,
# not afterwards.
#
# Usage:
#   bt-capdiff [--since <ISO>] [--until <ISO>] [-n <count>]
#
#   --since/--until take FULL timestamps of the form 2026-08-12T06:26:25.001
#   (the record keys), compared lexically. A bare HH:MM:SS never matches any
#   key and silently empties the window — the earlier usage text suggested
#   exactly that form.
#
# Compares only the overlapping time range covered by both paths — outside it a
# difference means "not captured", not "disagreement", and reporting that as
# disagreement would be worse than saying nothing.

set -uo pipefail

# Shared civil-date arithmetic; see tools/lib/timestamp.awk for why it is shared.
LIBDIR="${BT_LIBDIR:-$(dirname "$(readlink -f "$0")")/lib}"
[[ -r "$LIBDIR/timestamp.awk" ]] || { echo "bt-capdiff: missing $LIBDIR/timestamp.awk" >&2; exit 1; }

TRACE_DIR="${BT_TRACE_DIR:-/var/log/bt-health/trace}"
CAP_DIR="${BT_CAPTURE_DIR:-/var/log/bt-health/capture}"
SINCE=""
UNTIL=""
TOP=20

while (( $# )); do
    case "$1" in
        --since) SINCE="${2:-}"; shift 2 ;;
        --until) UNTIL="${2:-}"; shift 2 ;;
        -n)      TOP="${2:-20}"; shift 2 ;;
        -h|--help) sed -n '2,28p' "$0"; exit 0 ;;
        *) echo "bt-capdiff: unknown argument: $1" >&2; exit 1 ;;
    esac
done

command -v btmon >/dev/null 2>&1 || { echo "bt-capdiff: btmon not found" >&2; exit 1; }

A=$(mktemp); B=$(mktemp)
trap 'rm -f "$A" "$B" "${WINPROG:-}"' EXIT

# Reduce each path to "HH:MM:SS <event descriptor>" for top-level records only.
# Indented parameter lines are excluded: they carry no timestamp of their own and
# would make identical events look different purely through decoding detail.
extract() {
    local dir="$1" out="$2"
    shopt -s nullglob
    local files=("$dir"/*.btsnoop)
    shopt -u nullglob
    (( ${#files[@]} )) || { : > "$out"; return; }
    local f
    for f in "${files[@]}"; do
        COLUMNS=200 btmon -T -r "$f" 2>/dev/null
    done | awk '
        # Keep the FULL date and millisecond precision. An earlier version cut
        # the key to HH:MM:SS, which merged records from different days and
        # collapsed sub-second ordering — in a tool built to compare two
        # recordings of the same stream, that discards exactly the resolution
        # the comparison depends on.
        # Drop monitor-session bookkeeping. "= Note:", "= New Index:",
        # "= Open Index:", "= Index Info:" and friends are delivered to each
        # reader when IT attaches, so a path that attached 74 times (btmon,
        # restarting after each abort) legitimately holds 74 copies while a path
        # that attached once holds one. Comparing them measures how often btmon
        # crashed — which is already EX-011 — and buries any real discrepancy
        # underneath. Only controller traffic is compared.
        /^= (Note|New Index|Open Index|Close Index|Index Info|Delete Index|Unknown)/ { next }
        /^[<>@=!]/ {
            if (match($0, /[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}\.[0-9]{3}/) == 0) next
            t = substr($0, RSTART, RLENGTH)
            gsub(/ /, "T", t)
            ev = $0
            sub(/ *[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9:.]+ *$/, "", ev)
            sub(/ +$/, "", ev)
            print t " " ev
        }' | sort > "$out"
}

extract "$TRACE_DIR" "$A"
extract "$CAP_DIR"   "$B"

na=$(wc -l < "$A"); nb=$(wc -l < "$B")

echo "Capture path agreement"
echo "══════════════════════════════════════════════════════════════════════"
printf '  btmon      (%s)  %s records\n' "$TRACE_DIR" "$na"
printf '  decode-free(%s)  %s records\n' "$CAP_DIR" "$nb"

if (( na == 0 || nb == 0 )); then
    echo
    echo "  One path has no records. Nothing to compare — this is a coverage"
    echo "  question, not a disagreement."
    exit 0
fi

# Overlap only. Outside the range both paths cover, a difference means one
# simply was not recording, which is not evidence about anything.
lo_a=$(head -1 "$A" | cut -d" " -f1); hi_a=$(tail -1 "$A" | cut -d" " -f1)
lo_b=$(head -1 "$B" | cut -d" " -f1); hi_b=$(tail -1 "$B" | cut -d" " -f1)
lo=$lo_a; [[ "$lo_b" > "$lo" ]] && lo=$lo_b
hi=$hi_a; [[ "$hi_b" < "$hi" ]] && hi=$hi_b
[[ -n "$SINCE" ]] && lo="$SINCE"
[[ -n "$UNTIL" ]] && hi="$UNTIL"

printf '  overlap    %s .. %s\n' "$lo" "$hi"
echo

TOL="${BT_CAPDIFF_TOL:-0.5}"

# WIDENED BY THE TOLERANCE, and this is not a refinement.
#
# lo and hi come from RAW first/last timestamps on two clocks that differ by a
# variable scheduling delay — the same delay the matcher exists to absorb. A
# pair that straddles a boundary therefore has one member inside the window and
# one outside, and the one inside is reported as unmatched. That happens at
# BOTH edges of every comparison, so two perfectly agreeing captures could not
# report agreement unless their boundary records aligned exactly. The bound was
# manufacturing the disagreement it was meant to exclude.
#
# Compared numerically via iso_secs rather than lexically, because widening a
# timestamp by a fraction of a second is arithmetic, not string editing — and
# doing it by hand on the string is how the day-of-month bugs in this
# repository's history were written.
# The filter is a FILE, not an inline program. Once awk is given -f it takes
# the program only from the -f files and treats any following positional string
# as an input FILENAME — so a quoted program there is read as data and matches
# nothing, silently, in the direction that reports agreement. That is the trap
# tests/run-tests scans for, and it is how this tool once reported perfect
# agreement between paths differing by 278 records. Written to a temp file,
# alongside the others, so the rule is not tempting to break.
WINPROG=$(mktemp)
cat > "$WINPROG" <<'WINEOF'
BEGIN { losec = iso_secs(lo) - tol; hisec = iso_secs(hi) + tol }
{ t = iso_secs($1); if (t >= losec && t <= hisec) print }
WINEOF
win() { awk -f "$LIBDIR/timestamp.awk" -f "$WINPROG" \
            -v lo="$lo" -v hi="$hi" -v tol="$TOL" "$1"; }

wa=$(mktemp); wb=$(mktemp)
trap 'rm -f "$A" "$B" "$wa" "$wb" "${wa}.only" "${wb}.only" "$WINPROG"' EXIT
win "$A" > "$wa"; win "$B" > "$wb"

# MATCH WITH A TOLERANCE, because the two paths do not share a clock.
#
# btmon stamps each record from the kernel monitor timestamp. bt-capture stamps
# it when the Python process receives the frame from the socket — userspace
# receive time, not kernel event time. The two therefore differ by a small,
# variable scheduling delay, and an exact-timestamp comparison reports every
# record as a disagreement. (An earlier version of this tool compared on
# HH:MM:SS, which hid the problem by being too coarse to notice; raising the
# precision exposed it.)
#
# So an event matches if the same descriptor appears in the other path within
# TOL seconds. Unmatched events are the real finding. (TOL is set above, where
# the comparison window is widened by it.)

# ONE-TO-ONE MATCHING. An earlier version asked, for each record, "is there ANY
# record with this descriptor within tolerance on the other side?" — and did not
# consume the match. Two records could therefore both claim the same single
# counterpart:
#
#     A: 12:00:00.100 EVENT X        B: 12:00:00.105 EVENT X
#        12:00:00.110 EVENT X
#
# Both A records match B's one record; the reverse check also succeeds; the tool
# reports zero unmatched in both directions and prints "the paths agree" — while
# the actual multiplicity is 2 against 1. That is a FALSE AGREEMENT, and it
# threatens the one verdict this tool exists to give.
#
# Records arrive sorted by full timestamp, so per descriptor they are already in
# time order and a greedy two-pointer pairing is correct: at each step either the
# heads pair (consume both) or the earlier head can never pair with anything
# later and is emitted as unmatched.
#
# Note this did not affect the conservative side. Refusing on ~1400 unmatched
# records was safe; the defect could only ever manufacture agreement.
ca=$(wc -l < "$wa"); cb=$(wc -l < "$wb")
awk -f "$LIBDIR/timestamp.awk" -f "$LIBDIR/capdiff-match.awk" \
    -v tol="$TOL" -v outA="${wa}.only" -v outB="${wb}.only" "$wa" "$wb"
touch "${wa}.only" "${wb}.only"
sort -o "${wa}.only" "${wa}.only"; sort -o "${wb}.only" "${wb}.only"
only_a=$(wc -l < "${wa}.only")
only_b=$(wc -l < "${wb}.only")

printf '  in overlap: btmon %s, decode-free %s\n' "$ca" "$cb"
printf '  only in btmon        %s   (no match within %ss)\n' "$only_a" "$TOL"
printf '  only in decode-free  %s   (no match within %ss)\n' "$only_b" "$TOL"
echo

# AN EMPTY OVERLAP IS NOT AGREEMENT. Two empty sets match perfectly, so
# `only_a == 0 && only_b == 0` was true and this printed "✓ The paths agree
# across the overlap" — a corroboration claim computed from nothing.
#
# The check above catches an empty PATH. It cannot catch an empty OVERLAP,
# which is what a narrowed --since/--until produces, and narrowing to an
# incident is the normal way to use this tool. So the strongest statement it
# can make was reachable by asking about a window where nothing happened.
#
# Same rule as everywhere else here: ENUMERATED == 0 is a refusal, CHECKED == 0
# is a result. Nothing enumerated inside the window means there is nothing to
# corroborate.
if (( ca == 0 && cb == 0 )); then
    echo "  No records fall inside the overlap. Nothing to compare — this is a"
    echo "  coverage question, not agreement."
    if [[ -n "$SINCE" || -n "$UNTIL" ]]; then
        echo "  The window was narrowed explicitly; widen it, or check that the"
        echo "  captures cover the period being asked about."
    fi
    exit 0
fi

if (( only_a == 0 && only_b == 0 )); then
    echo "  ✓ The paths agree across the overlap. A chronology drawn from"
    echo "    either is corroborated against capture-time loss by a second"
    echo "    acquisition path. (Not against anything upstream of the shared"
    echo "    kernel monitor socket — see the header.)"
    exit 0
fi

# Say which direction(s). "in both directions" was printed unconditionally,
# including when every unmatched record sat on one side — and one-sided loss is
# the reading that matters: it says one path missed traffic the other caught,
# where two-sided is usually the clock or the decoding differing.
if (( only_a > 0 && only_b > 0 )); then
    echo "  ⚠ Unmatched records in both directions."
elif (( only_a > 0 )); then
    echo "  ⚠ Unmatched records in btmon only — the decode-free path did not record them."
else
    echo "  ⚠ Unmatched records in the decode-free path only — btmon did not record them."
fi
echo
echo "  ⛔ DO NOT READ THIS AS 'the paths disagree about the controller'."
echo "     Cross-path event identity is NOT yet validated. Known reasons two"
echo "     recordings of the same stream differ without either losing traffic:"
echo
echo "       * per-attach bookkeeping — the kernel re-delivers index and client"
echo "         events to each reader as it attaches. btmon attached ~74 times"
echo "         (restarting after each BT-4 abort); bt-capture attached once."
echo "       * different clocks — btmon uses the kernel monitor timestamp,"
echo "         bt-capture the userspace receive time, so matching is by"
echo "         tolerance and a busy moment can push a pair past it."
echo "       * btmon truncates decoded text to the terminal width, so the same"
echo "         event can render differently between runs."
echo
echo "     Until each of those is accounted for, the useful output of this tool"
echo "     is the LIST below, read by eye, for records present in one path at a"
echo "     time when the other was recording. A global agree/disagree verdict"
echo "     would be a number tuned until it looked clean."
echo
echo "  An event missing from one path is still not evidence the controller did"
echo "  not do it."
echo
echo "  Present only in btmon (first $TOP):"
head -"$TOP" "${wa}.only" | sed 's/^/    /'
echo
echo "  Present only in the decode-free capture (first $TOP):"
head -"$TOP" "${wb}.only" | sed 's/^/    /'
