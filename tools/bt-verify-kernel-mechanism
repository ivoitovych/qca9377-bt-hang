#!/bin/bash
# bt-verify-kernel-mechanism — which reset mechanism does THIS kernel's btusb use?
#
#   bt-verify-kernel-mechanism [kernel-release]
#
# Settles, against the shipped binary rather than against an assumption:
#
#   1. Does btusb define btusb_qca_cmd_timeout (an hdev->cmd_timeout handler,
#      which historically counted 5 consecutive timeouts before resetting)?
#   2. Or does it define btusb_qca_reset (an hdev->reset callback, which
#      hci_cmd_timeout() invokes immediately on the FIRST command timeout)?
#
# This distinction decides how to interpret every recovery experiment in this
# repository. A userspace reset issued +20 s after the first timeout is a fair
# proxy for a handler that waits for five timeouts. It is NOT a fair proxy for
# a callback that fires during the first one.
#
# Also checks which neighbouring IMC Networks IDs are present, to show whether
# this device's absence is an isolated gap.
#
# Read-only. Writes only to a temp file it removes.

set -uo pipefail

KREL="${1:-$(uname -r)}"
# BT_MODULES_DIR defaults to the real tree. The seam exists because this tool
# settles the single question every recovery experiment in this repository is
# interpreted against — reset callback or 5-timeout counter — and it had never
# been run against a module whose contents the test controls.
MODULES_DIR="${BT_MODULES_DIR:-/lib/modules}"
KO="$MODULES_DIR/$KREL/kernel/drivers/bluetooth/btusb.ko"
TMP=$(mktemp /tmp/btusb-verify.XXXXXX.ko)
trap 'rm -f "$TMP"' EXIT

G=$'\033[32m'; R=$'\033[31m'; Y=$'\033[33m'; B=$'\033[1m'; O=$'\033[0m'
[[ -t 1 ]] || { G=""; R=""; Y=""; B=""; O=""; }

if   [[ -f "$KO" ]];        then cp "$KO" "$TMP"
elif [[ -f "$KO.zst" ]];    then zstd -dcf "$KO.zst" > "$TMP" 2>/dev/null
elif [[ -f "$KO.xz" ]];     then xz -dc "$KO.xz" > "$TMP" 2>/dev/null
else echo "btusb module not found for $KREL" >&2; exit 2; fi

echo "${B}btusb reset mechanism${O} — kernel $KREL"
echo "─────────────────────────────────────────────────────────────"
echo "  module: $KO ($(stat -c %s "$TMP") bytes uncompressed)"
echo

syms=$(strings "$TMP")

echo "${B}1. Which QCA reset symbol is present?${O}"
has_cmdto=0; has_reset=0
grep -q "btusb_qca_cmd_timeout" <<<"$syms" && has_cmdto=1
grep -q "btusb_qca_reset"       <<<"$syms" && has_reset=1

if (( has_cmdto )); then
    echo "  ${Y}•${O} btusb_qca_cmd_timeout  PRESENT  (hdev->cmd_timeout path)"
else
    echo "  ${G}✓${O} btusb_qca_cmd_timeout  absent"
fi
if (( has_reset )); then
    echo "  ${G}✓${O} btusb_qca_reset        PRESENT  (hdev->reset path)"
else
    echo "  ${Y}•${O} btusb_qca_reset        absent"
fi
echo
if (( has_reset && ! has_cmdto )); then
    echo "  ${B}=> hdev->reset mechanism.${O} hci_cmd_timeout() calls it on the"
    echo "     FIRST command timeout — no 5-timeout threshold."
    echo "     A userspace reset issued seconds later is NOT an equivalent test."
elif (( has_cmdto && ! has_reset )); then
    echo "  ${B}=> hdev->cmd_timeout mechanism${O} (older 5-timeout counter)."
elif (( has_cmdto && has_reset )); then
    echo "  ${B}=> both symbols present${O} — inspect the source for which is assigned."
else
    echo "  ${R}=> neither symbol found${O} — module may be stripped."
fi

echo
echo "${B}2. Supporting strings${O}"
# Only strings that actually live in btusb.o. Do NOT test for qca_read_soc_version:
# it is in btqca.c, built as a separate btqca.ko under CONFIG_BT_QCA, so its
# absence here means nothing. btusb_setup_qca() has its own independent USB
# mechanism (QCA_GET_TARGET_VERSION / QCA_CHECK_STATUS vendor requests).
# Likewise do not test for "ROM version" — the Rome 3.x labels in the source are
# C comments and never survive compilation.
for s in "Resetting usb device" "rampatch" "nvm_usb" "using rampatch file"; do
    if grep -qi "$s" <<<"$syms"; then printf '  %s✓%s %s\n' "$G" "$O" "$s"
    else printf '  %s·%s %s (absent)\n' "$Y" "$O" "$s"; fi
done
if [[ -e "$MODULES_DIR/$KREL/kernel/drivers/bluetooth/btqca.ko" || \
      -e "$MODULES_DIR/$KREL/kernel/drivers/bluetooth/btqca.ko.zst" ]]; then
    printf '  %s✓%s btqca.ko present as a separate module (expected)\n' "$G" "$O"
fi

echo
echo "${B}3. IMC Networks (13d3) device IDs in this binary${O}"
echo "  usb_device_id is little-endian: 13d3:XXYY -> bytes d3 13 YY XX"
echo "  Vendor classification is from upstream v7.0 btusb.c, NOT inferred from the binary:"
# hexdump(1) lives in bsdextrautils and is absent from minimal images — the
# same package as the column(1) gap found in bt-health-report, and with a worse
# consequence here. The redirect was silenced, so on a machine without it the
# hex file never appeared, every grep missed, and the tool printed ABSENT for
# ALL SEVEN device IDs — including 3491/3496/3501, which are genuinely in the
# table. A reader would have concluded the comparators are missing too, which
# is the exact opposite of the argument this section exists to make: that this
# device's absence is an isolated gap. od(1) is coreutils and always present.
hexed=0
if command -v hexdump >/dev/null 2>&1; then
    hexdump -ve '1/1 "%02x"' "$TMP" > "$TMP.hex" 2>/dev/null && hexed=1
fi
if (( ! hexed )); then
    od -An -v -tx1 "$TMP" 2>/dev/null | tr -d ' \n' > "$TMP.hex" && hexed=1
fi
# An empty hex dump for a non-empty module means the dump failed, whatever the
# exit status said. Reporting nothing is honest; reporting ABSENT is not.
[[ -s "$TMP.hex" ]] || hexed=0

check_id() {
    if (( ! hexed )); then
        printf '  %s?%s 13d3:%s  UNKNOWN   (no hexdump or od — cannot read the binary)\n' \
               "$Y" "$O" "$1"
        return 0
    fi
    local id="$1" note="$2"
    local lo="${id:2:2}" hi="${id:0:2}"
    if grep -qo "d313${lo}${hi}" "$TMP.hex" 2>/dev/null; then
        printf '  %s✓%s 13d3:%s  present   %s\n' "$G" "$O" "$id" "$note"
    else
        printf '  %s✗%s 13d3:%s  ABSENT    %s\n' "$R" "$O" "$id" "$note"
    fi
}
check_id 3491 "BTUSB_QCA_ROME | BTUSB_WIDEBAND_SPEECH"
check_id 3496 "BTUSB_QCA_ROME | BTUSB_WIDEBAND_SPEECH"
check_id 3501 "BTUSB_QCA_ROME | BTUSB_WIDEBAND_SPEECH"
check_id 3502 "not in upstream"
check_id 3503 "not in upstream  <-- THIS DEVICE"
check_id 3504 "not in upstream"
check_id 3563 "BTUSB_MEDIATEK — different silicon, NOT a QCA comparator"
rm -f "$TMP.hex"
echo
echo "  3491/3496/3501 are genuine QCA ROME comparators. 3563 is MediaTek: 13d3 is"
echo "  IMC Networks, an ODM shipping modules built around several vendors' silicon,"
echo "  so numerical proximity alone proves nothing about a device's family."
