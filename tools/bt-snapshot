#!/bin/bash
# bt-snapshot — one coarse capture, then every fine filter for free.
#
#   bt-snapshot                 capture this boot, print the summary
#   bt-snapshot --boot -1       capture a different boot
#   bt-snapshot --summary-only  re-print the summary of the latest capture
#   bt-snapshot --list          what has been captured
#
# WHY THIS EXISTS. Assessing "what just happened" took ten to fifteen separate
# journalctl invocations, each traversing the journal again, each costing a
# permission prompt and a minute of wall clock — while a live fault window was
# burning and the operator was waiting for the laptop. The operator named the
# fix: take ONE coarse cut that throws nothing away, then do all the fine
# filtering against that file, for free.
#
# That is the whole design. The expensive step is journal traversal, and this
# does it ONCE. Every question afterwards is a grep over a local file.
#
# ⚠️ IT MUST NEVER TOUCH THE CONTROLLER. This runs DURING a live fault, and the
# entire value of an untreated window is that nothing has touched the device.
# So: no hciconfig, no btmgmt, no bluetoothctl, no rfkill writes, no sysfs
# writes — AND NO D-BUS, which is the one that had to be argued rather than
# assumed. It reads the journal and reads sysfs. `bt-trial autostop` is the
# cautionary example — its hci_alive() issues an HCI Read_Local_Name at every
# shutdown, which is why EX-029's thirteen clean hours end in a touched
# terminator (BL-08).
#
# THE BLUEZ SECTION IS WHY THAT LIST GAINED D-BUS. Reading org.bluez properties
# over D-Bus is a userspace read of cached state and very probably issues no
# HCI — and "very probably" is exactly what was believed about the recovery
# ladder before it cost a controller. The same four values are already in the
# journal, so the argument does not have to be won: they are read from there,
# and they are last-logged rather than live. The suite pins the choice at the
# source, so a later D-Bus call cannot arrive quietly.
#
# ⚠️ THE RAW CUT IS UNSANITISED. It carries MAC addresses and Wi-Fi BSSIDs, and
# BSSIDs geolocate the machine. This repository is public and has leaked
# addresses once. So the destination is outside the repository, mechanically,
# the same rule bt-archive enforces — and with pwd -P on both ends, because a
# path check that does not resolve symlinks is not a path check (BL-06).
#
# Read-only with respect to the system. Writes only under BT_SNAPSHOT_DIR.

set -uo pipefail
export LC_ALL=C

LIBDIR="${BT_LIBDIR:-$(dirname "$(readlink -f "$0")")/lib}"
# THROUGH THE SEAM, like every other read-only tool here. LIBDIR was already
# computed and never used: the three journalctl calls below were open-coded, so
# the tool could not be driven without a real journal and 0 of its 83 lines had
# ever executed under test. The reads themselves are unchanged — one coarse cut,
# nothing thrown away — they simply go through the same door as the rest.
[[ -r "$LIBDIR/journal.sh" ]] || { echo "bt-snapshot: missing $LIBDIR/journal.sh" >&2; exit 2; }
# shellcheck source=tools/lib/journal.sh
source "$LIBDIR/journal.sh"
REPO="${BT_REPO:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd -P)}"
DEST="${BT_SNAPSHOT_DIR:-/var/tmp/bt-snapshots}"

BOOT=0; SUMMARY_ONLY=0; LIST=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        --boot)         BOOT="${2:?--boot needs an index}"; shift ;;
        --summary-only) SUMMARY_ONLY=1 ;;
        --list)         LIST=1 ;;
        -h|--help)      sed -n '2,9p' "$0"; exit 0 ;;
        *) echo "bt-snapshot: unknown option: $1" >&2; exit 2 ;;
    esac
    shift
done

refuse() { echo "bt-snapshot: REFUSING — $*" >&2; exit 2; }

mkdir -p "$DEST" 2>/dev/null || refuse "cannot create $DEST"
DEST_ABS=$(cd "$DEST" && pwd -P) || refuse "cannot resolve $DEST"
case "$DEST_ABS/" in
    "$REPO"/*) refuse "$DEST_ABS is inside the repository — a raw cut carries BSSIDs and must not be committable" ;;
esac

if (( LIST )); then
    echo "bt-snapshot — $DEST_ABS"
    shopt -s nullglob
    found=0
    for d in "$DEST_ABS"/*/; do
        found=$((found + 1))
        printf '  %-30s %s\n' "$(basename "$d")" "$(du -sh "$d" 2>/dev/null | cut -f1)"
    done
    (( found == 0 )) && echo "  (nothing captured yet)"
    exit 0
fi

LATEST="$DEST_ABS/latest"

if (( SUMMARY_ONLY )); then
    [[ -r "$LATEST/summary.txt" ]] || refuse "no previous capture at $LATEST"
    cat "$LATEST/summary.txt"
    exit 0
fi

# ── the coarse cut: ONE traversal, nothing thrown away ────────────────────
#
# Deliberately unfiltered. A --grep here would be the mistake this tool exists
# to avoid: it saves nothing (journalctl still traverses the whole span) and it
# decides in advance which lines could matter, which is exactly the judgement
# that has been wrong repeatedly in this project — the timeout pattern that
# matched 8 of 173 events, the intervention patterns written to our own
# wording rather than the kernel's.
STAMP=$(date '+%Y%m%d-%H%M%S')
DIR="$DEST_ABS/$STAMP-boot$BOOT"
mkdir -p "$DIR" || refuse "cannot create $DIR"

echo "bt-snapshot — coarse cut of boot $BOOT -> $DIR"
bt_journal --list-boots --no-pager                      > "$DIR/list-boots.txt" 2>/dev/null
bt_journal -b "$BOOT" --no-pager -o short-iso-precise    > "$DIR/all.log"        2>/dev/null
bt_journal -k -b "$BOOT" --no-pager -o short-iso-precise > "$DIR/kernel.log"     2>/dev/null

# ENUMERATED == 0 IS A REFUSAL. An empty cut means the boot index is wrong or
# the journal is unreadable, not that the boot was quiet.
lines=$(wc -l < "$DIR/all.log")
if [[ "${lines:-0}" -eq 0 ]]; then
    rm -rf "$DIR"
    refuse "boot $BOOT produced no journal lines — nothing was captured"
fi

ln -sfn "$DIR" "$LATEST"

# ── fine filters: all of these are now free ──────────────────────────────
K="$DIR/kernel.log"; A="$DIR/all.log"
grep -E "opcode 0x0428|opcode 0x043d|Looking for Alt no|command( 0x[0-9a-f]+)? tx timeout|setting interface failed" "$K" > "$DIR/f-fault.log" 2>/dev/null
grep -E 'usb 3-3|xhci_hcd|USB disconnect|device descriptor|unable to enumerate' "$K"           > "$DIR/f-usb.log"        2>/dev/null
grep -E 'deregistering interface driver btusb|Resetting usb device|reset (full|high|low)-speed USB device|name hci[0-9]+ blocked' "$A" > "$DIR/f-intervention.log" 2>/dev/null
# ── crashes: SCOPED TO THE BLUETOOTH STACK, and the rest kept separately ──
#
# ⚠️ This filter used to be the crash INDICATORS alone, applied to the whole
# journal. On 2026-08-31 it reported `daemon crashes 8` on a healthy machine:
# two gnome-keyring scopes, a user-dirs-update scope, snapd-desktop-integration
# and its restart, two xdg portals, and OUR OWN bt-journal-backup.service. Zero
# were bluetoothd. A headline counter that alarms on an unrelated desktop
# service teaches the reader to discount it, and this project's whole method is
# that a number in the summary can be trusted.
#
# The indicator alone is not the event: `Failed with result` describes any unit
# on the machine. Both halves have to match — a crash-shaped line ABOUT the
# Bluetooth stack.
BT_UNIT_RE='bluetoothd|bluetooth\.service|btmon|bluez|obexd'
CRASH_RE='segfault|core-dump|dumped core|Failed with result|Scheduled restart'
grep -E "$CRASH_RE" "$A" 2>/dev/null | grep -E "$BT_UNIT_RE"                                    > "$DIR/f-crash.log"      2>/dev/null
# NOTHING IS DISCARDED — the broad cut moves here rather than disappearing.
# bt-journal-backup's own failure showed up in the old counter, and losing
# sight of it entirely would trade a misleading number for a blind spot.
grep -E "$CRASH_RE" "$A" 2>/dev/null | grep -vE "$BT_UNIT_RE"                                   > "$DIR/f-otherfail.log"  2>/dev/null
# ── the two guards added by patches/bluez/, firing ───────────────────────
#
# A patch that prevents a crash leaves NO trace by default: the daemon simply
# does not die, which is indistinguishable from the bug never having occurred.
# Both patches take a `goto drop` / `return` path that logs first, so the
# message IS the observation — the only positive evidence a fix worked rather
# than the conditions not recurring.
#
# `has no stream` is new text, unique to 0002. The discovery message is NOT
# new — 0001 duplicates a string the function already carried below its own
# length check — so a hit means only that one of the two sites fired, and
# which one has to be read from the surrounding lines.
grep -E 'has no stream|Wrong size of start discovery return parameters' "$A"                    > "$DIR/f-guard.log"      2>/dev/null
# ⚠️ `restart counter is at` WAS AN ALTERNATIVE OF ITS OWN HERE, and systemd
# prints that phrase for every unit on the machine. It put foreign lines into
# the BlueZ cut, and the reader below takes the LAST of them — so on
# 2026-08-31 the report attributed snapd-desktop-integration's restart counter
# to bluetooth.service. The phrase never needed its own alternative: systemd
# spells the line `bluetooth.service: Scheduled restart job, restart counter is
# at N.`, which the `bluetooth\.service:` alternative already matches.
grep -E 'adapter_set_power_state|new_settings_callback\(\) Settings:|discovering_callback|start_discovery_complete|bluetooth\.service:' "$A" > "$DIR/f-bluez.log" 2>/dev/null
grep -E 'corrupted SCO|Error when powering off|connection_lost|disconnected, reason|Failure in Bluetooth' "$A" > "$DIR/f-link.log" 2>/dev/null
grep -oE 'input: [^(]*\(AVRCP\)' "$A" | sed 's/^input: //' | sort -u                            > "$DIR/f-devices.txt"    2>/dev/null

# `grep -c .` PRINTS 0 and EXITS 1 on an empty file, so the obvious
# `[[ -r $f ]] && grep -c . "$f" || echo 0` ran BOTH branches on every empty
# fine cut and emitted two lines. printf then cycled its one-conversion format
# over the extra argument, and the summary grew a stray unlabelled 0 on its own
# line under interventions, daemon crashes and link-layer events — the three
# counts most often zero, and the three a reader most needs to line up with
# their labels. Capture once, print once.
c() {   # lines in a fine cut — 0 for absent, unreadable, or empty
    local f="$1" n
    [[ -r "$f" ]] || { echo 0; return 0; }
    n=$(grep -c . "$f" 2>/dev/null)
    echo "${n:-0}"
}

# The positive control comes FIRST, because every zero below is meaningless
# without it. Zero from a scan is not a result until something proves the scan
# can see — the rule this project learned the hard way, twice.
OPC=$(grep -cE 'opcode 0x' "$K" 2>/dev/null || true)
TMO=$(grep -cE "command( 0x[0-9a-f]+)? tx timeout" "$K" 2>/dev/null || true)
SCO=$(grep -cE 'opcode 0x0428' "$K" 2>/dev/null || true)
ESCO=$(grep -cE 'opcode 0x043d' "$K" 2>/dev/null || true)
ALT=$(grep -cE 'Looking for Alt no' "$K" 2>/dev/null || true)
DISC=$(grep -cE 'USB disconnect' "$K" 2>/dev/null || true)
# ── SCO TRAFFIC ON THE NARROW ENDPOINT, which is the actual condition ─────
#
# ⚠️ THE COUNTER THAT WOULD HAVE STOPPED A WRONG CONCLUSION ON 2026-09-01. The
# operator ran the test that has always killed this controller — hands-free,
# switched repeatedly — and Bluetooth survived. The summary agreed the trigger
# had been pulled: `0x0428 legacy SCO 6`, `alt-setting switch 8`. Both true,
# and neither is the condition.
#
# btusb prints `len <n> mtu <m>` per URB, and `m` is the isochronous endpoint
# size, so it names the alternate setting that was actually in use:
#
#   mtu 17  a wide endpoint — CVSD narrowband. Streams fine, 4669 packets on
#           2026-09-01 with the controller entirely healthy.
#   mtu  9  the 9-byte alt-1 endpoint, taken by the WBS fallback. 27-byte mSBC
#           frames go into a 9-byte MTU, and THIS is where the controller dies:
#           835 such packets before EX-033's timeout, 87 before EX-036's.
#
# On 2026-09-01 the transparent links were established three times, reached the
# alt-1 endpoint, carried EIGHT packets and collapsed back to CVSD. Eight
# against 835. Counting all SCO traffic together would have shown 4681 and read
# as "the fault was approached hard" — the exact opposite of what happened.
SCONARROW=$(grep -cE 'len [0-9]+ mtu 9$' "$K" 2>/dev/null || true)
SCOWIDE=$(grep -cE 'len [0-9]+ mtu (1[0-9]|[2-9][0-9]+)$' "$K" 2>/dev/null || true)

# Device presence read from sysfs — a read, never a probe.
SYSFS="${BT_SYSFS_USB:-/sys/bus/usb/devices}"
PRESENT="no"; [[ -e "$SYSFS/3-3" ]] && PRESENT="yes"
HCI="none"; for p in /sys/class/bluetooth/hci*; do [[ -e "$p" ]] && HCI=$(basename "$p") && break; done

FIRST_TMO=$(grep -E "command( 0x[0-9a-f]+)? tx timeout" "$K" 2>/dev/null | head -1 | awk '{print $1}')

# ── BlueZ health, and why it is read from the journal ────────────────────
#
# THE CAPTURE THIS TOOL COULD NOT MAKE. On 2026-08-19 the operator said
# Bluetooth was dead; this tool was run, reported "controller on bus yes,
# 0 timeouts", and the machine was called healthy. It had been dead for 2½
# hours — EX-032, `Powered=true` and `Discovering=false` after a BlueZ crash —
# and nothing above could have shown it, because everything above is about the
# controller and the controller was fine.
#
# ⚠️ NOT OVER D-BUS, DELIBERATELY. Reading org.bluez properties is very likely
# read-only, and "very likely" is what was said about the recovery ladder
# before it cost a controller. The contract this tool sells is that it can be
# run INSIDE an untreated window without spoiling it, and a contract that holds
# except for one call is not a contract. The journal already carries every one
# of these values; taking them from there costs nothing and risks nothing. The
# price is that they are as-of-the-last-log rather than live, which is stated
# on the heading rather than left to be assumed.
#
# EVERY VALUE IS THE LAST OBSERVATION, so it is the state the daemon was last
# seen in. The line's own timestamp is printed beside it — a value with no time
# on it reads as "now", which is the one thing it is not.
BZ="$DIR/f-bluez.log"
BZDBG=$(grep -c 'src/adapter\.c:' "$A" 2>/dev/null || true)

# Powered comes from the MGMT settings word rather than from
# adapter_set_power_state(), because the two answer different questions.
# adapter_set_power_state() logs what BLUETOOTHD DID; new_settings_callback()
# logs what the KERNEL REPORTED, which also moves when something else powers
# the adapter down — an rfkill block being the case that matters here. Bit 0 is
# MGMT_SETTING_POWERED. Both are printed; only the second decides.
PW_LINE=$(grep -E 'new_settings_callback\(\) Settings: 0x' "$BZ" 2>/dev/null | tail -1)
PW_STATE="unknown"; PW_AT=""
if [[ -n "$PW_LINE" ]]; then
    PW_SET=$(grep -oE 'Settings: 0x[0-9a-fA-F]+' <<<"$PW_LINE" | awk '{print $2}')
    PW_AT=$(awk '{print $1}' <<<"$PW_LINE")
    (( (PW_SET & 1) )) && PW_STATE="yes" || PW_STATE="no"
fi

PT_LINE=$(grep -E 'adapter_set_power_state\(\)' "$BZ" 2>/dev/null | tail -1)
PT_STATE=""; PT_AT=""
if [[ -n "$PT_LINE" ]]; then
    PT_STATE=$(sed -E 's/.*adapter_set_power_state\(\)[[:space:]]*//' <<<"$PT_LINE")
    PT_AT=$(awk '{print $1}' <<<"$PT_LINE")
fi

DS_LINE=$(grep -E 'discovering_callback\(\).*discovering [0-9]' "$BZ" 2>/dev/null | tail -1)
DS_STATE="unknown"; DS_AT=""
if [[ -n "$DS_LINE" ]]; then
    DS_N=$(sed -E 's/.*discovering ([0-9]+).*/\1/' <<<"$DS_LINE")
    DS_AT=$(awk '{print $1}' <<<"$DS_LINE")
    (( DS_N )) && DS_STATE="yes" || DS_STATE="no"
fi

# systemd's own counter when it is there, and a COUNT of the restart lines when
# it is not — an older systemd logs `Scheduled restart job` without the
# counter, and reporting 0 restarts on a boot that plainly restarted the daemon
# would be the same confident zero this project keeps finding. Which of the two
# produced the number is printed, because they are not the same claim.
NR_LINE=$(grep -E 'restart counter is at' "$BZ" 2>/dev/null | tail -1)
if [[ -n "$NR_LINE" ]]; then
    NR=$(sed -E 's/.*restart counter is at ([0-9]+).*/\1/' <<<"$NR_LINE")
    NR_SRC="systemd's counter"; NR_AT=$(awk '{print $1}' <<<"$NR_LINE")
else
    NR=$(grep -cE 'bluetooth\.service: Scheduled restart' "$BZ" 2>/dev/null || true)
    NR="${NR:-0}"; NR_SRC="counted — systemd logged no counter"; NR_AT=""
fi

# ONE DERIVATION FOR ONE FACT. The printed time and the ordering test below are
# the same question — "when did a discovery last COMPLETE" — and the first
# version computed them twice, from two files with two copies of the pattern.
# A mutation that relaxed one of the two copies to match any status moved the
# printed timestamp and left the warning untouched, which is what two
# derivations of one fact always eventually do.
SD_HIT=$(grep -nE 'start_discovery_complete\(\) status 0x00' "$A" 2>/dev/null | tail -1)
LN_SDOK=""; SD_AT=""
if [[ -n "$SD_HIT" ]]; then
    LN_SDOK=${SD_HIT%%:*}
    SD_AT=$(awk '{print $1}' <<<"${SD_HIT#*:}")
fi

# THE EX-032 TEST, ORDERED BY LINE NUMBER AND NOT BY CLOCK. The claim is "no
# discovery has completed since the last crash", and the coarse cut is already
# in journal order — so it is a comparison of two line numbers in one file.
# Parsing the two timestamps and comparing them would introduce a timezone and
# a date parser to answer a question the file's own ordering already answers.
#
# `powered and not discovering` ALONE IS NOT THE SHAPE — that is what an idle
# adapter looks like every minute of every day, and warning on it would train
# the reader to ignore the line. What makes EX-032 is that a discovery used to
# complete, a crash happened, and none has completed since.
#
# SCOPED, for the reason given at the filter above: an unrelated desktop unit
# failing must not satisfy "a crash happened" and raise an EX-032 warning about
# the Bluetooth adapter.
LN_CRASH=$(grep -nE 'segfault|Failed with result' "$A" 2>/dev/null | grep -E "$BT_UNIT_RE" | tail -1 | cut -d: -f1)

{
printf 'bt-snapshot summary — boot %s, captured %s\n' "$BOOT" "$STAMP"
printf '  raw cut: %s lines in %s\n\n' "$lines" "$DIR"
printf '  positive control   %6s  opcode 0x… lines %s\n' "$OPC" \
       "$( (( OPC == 0 )) && echo '  ⚠️ ZERO — every count below is uninterpretable' || echo '(the scan can see)')"
printf '  command timeouts   %6s\n' "$TMO"
printf '  0x0428 legacy SCO  %6s\n' "$SCO"
printf '  0x043d enhanced    %6s\n' "$ESCO"
printf '  alt-setting switch %6s\n' "$ALT"
# Printed directly under the setup counters, because their whole job is to stop
# those being read as "the fault was approached". Both are shown: the wide count
# alone looks like heavy SCO use, and it is the harmless kind.
printf '  SCO pkts mtu>9     %6s  (CVSD — healthy path)\n' "${SCOWIDE:-0}"
if [[ "${SCONARROW:-0}" -gt 0 ]]; then
    printf '  ⚠️  SCO pkts on alt-1 (mtu 9): %s — THIS is the condition both recorded\n' "$SCONARROW"
    printf '      deaths needed (835 before EX-033, 87 before EX-036).\n'
elif [[ "${SCO:-0}" -gt 0 ]]; then
    printf '  SCO pkts mtu 9     %6s  (alt-1 never carried traffic — the fault\n' "${SCONARROW:-0}"
    printf '                             was NOT approached, whatever else ran)\n'
else
    printf '  SCO pkts mtu 9     %6s\n' "${SCONARROW:-0}"
fi
printf '  USB disconnect     %6s\n' "$DISC"
printf '  interventions      %6s\n' "$(c "$DIR/f-intervention.log")"
# "stack", not "daemon": btmon is in scope and is not the daemon. It is the
# capture tool, and it has been dumping core repeatedly — a tracer dying is
# evidence loss, which belongs in the summary rather than filed as noise.
printf '  BT stack crashes   %6s\n' "$(c "$DIR/f-crash.log")"
printf '  link-layer events  %6s\n' "$(c "$DIR/f-link.log")"
# Reported, never counted as a Bluetooth crash, and only when non-zero — a
# desktop machine always has a few and a permanent line would be noise.
OTHERF=$(c "$DIR/f-otherfail.log")
if [[ "${OTHERF:-0}" -gt 0 ]]; then
    printf '  other unit failures %5s  (NOT Bluetooth — see f-otherfail.log)\n' "$OTHERF"
fi
GUARD=$(c "$DIR/f-guard.log")
if [[ "${GUARD:-0}" -gt 0 ]]; then
    printf '  ⚠️  patch guards fired %s — see f-guard.log. A crash was PREVENTED,\n' "$GUARD"
    printf '      not merely absent. This is the positive evidence.\n'
else
    printf '  patch guards fired %6s  (0 = no crash prevented AND none occurred)\n' "${GUARD:-0}"
fi
printf '\n  controller on bus  %s\n' "$PRESENT"
printf '  hci device         %s\n' "$HCI"
[[ -n "$FIRST_TMO" ]] && printf '  first timeout      %s\n' "$FIRST_TMO"
printf '\n  BlueZ health — last logged state, NOT read from the adapter:\n'
if (( ${BZDBG:-0} == 0 )); then
    # ENUMERATED == 0 IS A REFUSAL, and this is the branch that would otherwise
    # print `powered no / discovering no` on every machine that simply does not
    # run bluetoothd with debug logging on. That reads as a diagnosis and is an
    # absence of evidence.
    printf '    ⚠️ UNKNOWN — no `src/adapter.c:` lines this boot, so powered and\n'
    printf '       discovering cannot be read. That is bluetoothd debug logging being\n'
    printf '       off, not the adapter being off. This project ships it on, in\n'
    printf '       etc/systemd/bluetooth.service.d/10-debug.conf.\n'
else
    printf '    powered            %-12s %s\n' "$PW_STATE" "$PW_AT"
    printf '    discovering        %-12s %s\n' "$DS_STATE" "$DS_AT"
    # Twelve columns because `off-enabling` is twelve characters. The first
    # version used seven, which is enough for yes/no and for `on` — and
    # `off-blocked`, the value that means an rfkill switch took the adapter
    # down, is the one it pushed out of alignment.
    [[ -n "$PT_STATE" ]] && printf '    last power change  %-12s %s\n' "$PT_STATE" "$PT_AT"
    if [[ -n "$SD_AT" ]]; then printf '    last discovery OK  %s\n' "$SD_AT"
    else                       printf '    last discovery OK  none this boot\n'; fi
fi
printf '    service restarts   %-12s %s\n' "$NR" "($NR_SRC)${NR_AT:+ $NR_AT}"
if [[ "$PW_STATE" == "yes" && -n "$LN_CRASH" && -n "$LN_SDOK" ]] && (( LN_CRASH > LN_SDOK )); then
    printf '    ⚠️ EX-032 SHAPE — the adapter is powered, a daemon crash followed the\n'
    printf '       last successful discovery, and none has completed since. Every\n'
    printf '       controller-side count above can be clean while this is true.\n'
fi

printf '\n  peers seen this boot:\n'
if [[ -s "$DIR/f-devices.txt" ]]; then sed 's/^/    /' "$DIR/f-devices.txt"; else echo '    (none named)'; fi
printf '\n  fine cuts: f-fault f-usb f-intervention f-crash f-otherfail f-link f-bluez f-guard (in the directory above)\n'
printf '  ⚠️ UNSANITISED — carries MACs and BSSIDs. Never commit. Sanitise before sharing.\n'
} > "$DIR/summary.txt"

cat "$DIR/summary.txt"
exit 0
