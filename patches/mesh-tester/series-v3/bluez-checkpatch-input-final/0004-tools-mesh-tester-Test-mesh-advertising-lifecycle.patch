+/*
+ * Mesh transmission lifecycle tests (test_mesh_tx): one record per Mesh
+ * Send issued, indexed by request number - 1.
+ */
+#define MESH_TX_SENDS_MAX	3
+#define MESH_TX_STARTS_MAX	8
+#define MESH_TX_REPORTS_MAX	32
+
+struct mesh_tx_req {
+	uint8_t handle;		/* from the Mesh Send reply, 0 until then */
+	unsigned int starts;	/* advertising starts carrying its data */
+	unsigned int cmplt;	/* Mesh Packet Complete events for it */
+	unsigned int stops_at_cmplt;	/* tear-downs seen when it completed */
+};
+
+enum mesh_tx_hold {
+	MESH_TX_HOLD_NONE,
+	MESH_TX_HOLD_ARMED,	/* hold the next tear-down (or start) command */
+	MESH_TX_HOLD_HELD,	/* held, the kernel is waiting for its reply */
+	MESH_TX_HOLD_RELEASED,
+};
+
+/* What is done while the command is held (mesh_tx_hold_action) */
+enum mesh_tx_hold_action {
+	MESH_TX_HOLD_SEND_2,	/* Mesh Send 2 (send in tear-down) */
+	MESH_TX_HOLD_CANCEL,	/* Mesh Send Cancel of mesh_tx_cancel_handle */
+	MESH_TX_HOLD_POWER_OFF,	/* Set Powered off */
+	MESH_TX_HOLD_CLOSE,	/* close the socket the sends went out on */
+	MESH_TX_HOLD_PASS,	/* end the test (the teardown unregisters) */
+};
+
+/* Power transitions (mesh_tx_power_off) */
+enum mesh_tx_power {
+	MESH_TX_POWER_NONE,
+	MESH_TX_POWER_ON_START,	/* Set Powered off once request 1 started */
+};
+
+/*
+ * The failing-allocation case probes /proc/self/fail-nth upwards until
+ * the first hci_cmd_sync_queue() of a Mesh Send is the allocation that
+ * fails: the request was added (its handle is consumed) but its start
+ * could not be queued and userspace was told Failed.
+ */
+#define MESH_TX_FAIL_NTH_MAX	16
+
+struct mesh_tx_probe {
+	bool active;
+	int fd;			/* /proc/self/fail-nth, -1 when closed */
+	unsigned int nth;
+	unsigned int request_id;
+	unsigned int timeout_id;
+	uint8_t last_handle;	/* the last handle any Mesh Send was given */
+	uint8_t rejected_handle;	/* consumed by the rejected request */
+	bool failed;		/* the probe send was answered Failed */
+	bool sync;		/* inside the probe's mgmt_send_nowait() */
+	bool waiting_cmplt;	/* an accepted probe send is transmitting */
+};
+
+/* What a Read Mesh Features reply is checked against */
+enum mesh_tx_features_check {
+	MESH_TX_FEATURES_EMPTY,	/* nothing pending on this socket */
+	MESH_TX_FEATURES_REQ2,	/* exactly the handle of request 2 */
+	MESH_TX_FEATURES_RECORD,	/* printed only */
+};
