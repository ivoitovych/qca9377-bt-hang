+/*
+ * Receiver cases: the mesh instance is added with the adapter's
+ * advertising interval, so set it (LE Advertisement Min/Max Interval,
+ * parameters 0x000a and 0x000b of Set Default System Configuration) when
+ * the case asks for one other than the default.
+ */
+static void setup_mesh_receiver(const void *test_data)
+{
+	struct test_data *data = tester_get_data();
+	const struct generic_data *test = data->test_data;
+	struct mgmt_tlv_list *tlv_list;
+	uint16_t interval = cpu_to_le16(test->mesh_tx_adv_interval);
+	unsigned int id = 0;
+
+	if (!test->mesh_tx_adv_interval) {
+		setup_enable_mesh(test_data);
+		return;
+	}
+
+	test_add_setup_condition(data);
+
+	setup_enable_mesh(test_data);
+
+	tlv_list = mgmt_tlv_list_new();
+	if (tlv_list &&
+			mgmt_tlv_add_fixed(tlv_list, 0x000a, &interval) &&
+			mgmt_tlv_add_fixed(tlv_list, 0x000b, &interval))
+		id = mgmt_send_tlv(data->mgmt, MGMT_OP_SET_DEF_SYSTEM_CONFIG,
+				data->mgmt_index, tlv_list,
+				setup_adv_interval_callback, NULL, NULL);
+
+	if (tlv_list)
+		mgmt_tlv_list_free(tlv_list);
+
+	if (!id) {
+		tester_warn("Failed to send Set Default System Configuration");
+		tester_setup_failed();
+	}
+}
