+
+	test_bredrle50_full("Mesh - Send close - in held tear-down - Ext",
+			&mesh_tx_close_in_teardown,
+			setup_enable_mesh,
+			test_mesh_tx, 6);
+
+	/* What a scanning client receives (extended advertising only) */
+	test_bredrle50_full("Mesh - Send receiver - Count 1",
