+	struct test_data *data = tester_get_data();
+	const struct generic_data *test = data->test_data;
+	const struct mgmt_rp_read_adv_features *rp = param;
+
+	if (status != MGMT_STATUS_SUCCESS || length < sizeof(*rp)) {
+		tester_warn("Read Advertising Features failed: %s (0x%02x)",
+						mgmt_errstr(status), status);
+		tester_test_failed();
+		return;
+	}
+
+	if (length != sizeof(*rp) + rp->num_instances) {
+		tester_warn("Invalid Read Advertising Features length %u",
+								length);
+		tester_test_failed();
+		return;
+	}
+
+	tester_print("Advertising instances left: %u", rp->num_instances);
+
+	if (rp->num_instances != test->mesh_tx_instances_len ||
+			(rp->num_instances && memcmp(rp->instance,
+						test->mesh_tx_instances,
+						rp->num_instances))) {
+		tester_warn("Unexpected advertising instances");
+		util_hexdump('>', rp->instance, rp->num_instances,
+							print_debug, "");
+		util_hexdump('!', test->mesh_tx_instances,
+				test->mesh_tx_instances_len, print_debug, "");
+		tester_test_failed();
+		return;
+	}
+
+	test_condition_complete(data);
+}
+
+static int64_t mesh_tx_now_ms(struct test_data *data)
+{
+	return (g_get_monotonic_time() - data->mesh_tx_t0) / 1000;
+}
+
+/*
+ * Read Mesh Features lists the handles pending on the socket it is sent
+ * on; here it is sent on the socket the requests went out on.
+ */
+static void mesh_tx_features_callback(uint8_t status, uint16_t length,
+		const void *param, void *user_data)
+{
+	struct test_data *data = tester_get_data();
+	const struct mgmt_rp_mesh_read_features *rp = param;
+	enum mesh_tx_features_check check = PTR_TO_UINT(user_data);
+	unsigned int i;
+
+	if (status != MGMT_STATUS_SUCCESS || length < sizeof(*rp) ||
+				length != sizeof(*rp) + rp->used_handles) {
+		tester_warn("Read Mesh Features failed: %s (0x%02x), "
+				"length %u", mgmt_errstr(status), status,
+				length);
+		tester_test_failed();
+		return;
+	}
+
+	tester_print("Read Mesh Features at +%lld ms: %u of %u handles "
+			"pending", (long long) mesh_tx_now_ms(data),
+			rp->used_handles, rp->max_handles);
+
+	for (i = 0; i < rp->used_handles; i++)
+		tester_print("  handle %u", rp->handles[i]);
+
+	switch (check) {
+	case MESH_TX_FEATURES_EMPTY:
+		if (rp->used_handles) {
+			tester_warn("Requests still pending");
+			tester_test_failed();
+			return;
+		}
+		break;
+	case MESH_TX_FEATURES_REQ2:
+		if (rp->used_handles != 1 || rp->handles[0] !=
+						data->mesh_tx_req[1].handle) {
+			tester_warn("Expected only handle %u (request 2) to "
+					"be pending",
+					data->mesh_tx_req[1].handle);
+			tester_test_failed();
+			return;
+		}
+		break;
+	case MESH_TX_FEATURES_RECORD:
+		break;
+	}
+
+	test_condition_complete(data);
+}
+
+static bool mesh_tx_read_features(struct test_data *data,
+					enum mesh_tx_features_check check)
+{
+	test_add_condition(data);
+
+	if (!mgmt_send(data->mgmt, MGMT_OP_MESH_READ_FEATURES,
+			data->mgmt_index, 0, NULL,
+			mesh_tx_features_callback, UINT_TO_PTR(check), NULL)) {
+		tester_warn("Failed to send Read Mesh Features");
+		tester_test_failed();
+		return false;
+	}
+
+	return true;
+}
+
+static void mesh_tx_print_receiver(struct test_data *data)
+{
+	const struct generic_data *test = data->test_data;
+	uint16_t interval = test->mesh_tx_adv_interval;
+	unsigned int i;
+
+	tester_print("Receiver: Count %u, advertising interval 0x%04x, mesh "
+			"set enabled at +%lld ms, torn down at +%lld ms, %u "
+			"packets received", test->mesh_tx_cnt,
+			interval ? interval : 0x0800,
+			(long long) data->mesh_tx_t_enable,
+			(long long) data->mesh_tx_t_disable,
+			data->mesh_tx_reports);
+
+	for (i = 0; i < data->mesh_tx_reports && i < MESH_TX_REPORTS_MAX; i++)
+		tester_print("  packet %u received at +%lld ms", i + 1,
+					(long long) data->mesh_tx_report_t[i]);
+}
+
+static bool mesh_tx_settle_receiver(struct test_data *data)
+{
+	unsigned int i;
+
+	if (!data->mesh_tx_reports) {
+		tester_warn("The client received no mesh packet");
+		return false;
+	}
+
+	/* The emulator broadcasts from inside the enable command, before
+	 * the Command Complete that marks the start here, hence the lead.
+	 */
+	for (i = 0; i < data->mesh_tx_reports && i < MESH_TX_REPORTS_MAX; i++) {
+		if (data->mesh_tx_report_t[i] < data->mesh_tx_t_enable - 20 ||
+				data->mesh_tx_report_t[i] >
+						data->mesh_tx_t_disable + 50) {
+			tester_warn("Packet %u received outside the enabled "
+							"window", i + 1);
+			return false;
+		}
+	}
+
+	return true;
+}
+
+static gboolean mesh_tx_settle(gpointer user_data)
+{
+	struct test_data *data = tester_get_data();
+	const struct generic_data *test = data->test_data;
+	unsigned int i;
+
+	data->mesh_tx_settle_id = 0;
+
+	/* The measurement is printed before any verdict */
+	if (test->mesh_tx_receiver)
+		mesh_tx_print_receiver(data);
+
+	tester_print("Mesh set started %u times, torn down %u times",
+				data->mesh_tx_starts, data->mesh_tx_stops);
+
+	for (i = 0; i < data->mesh_tx_starts && i < MESH_TX_STARTS_MAX; i++)
+		tester_print("  start %u: request %u", i + 1,
+						data->mesh_tx_started[i]);
+
+	for (i = 0; i < MESH_TX_SENDS_MAX; i++) {
+		if (!data->mesh_tx_req[i].handle)
+			continue;
+
+		tester_print("  request %u: handle %u, %u starts, %u "
+				"completions", i + 1,
+				data->mesh_tx_req[i].handle,
+				data->mesh_tx_req[i].starts,
+				data->mesh_tx_req[i].cmplt);
+	}
+
+	if (!test->mesh_tx_starts_unchecked &&
+			(data->mesh_tx_starts != test->mesh_tx_starts_len ||
+			memcmp(data->mesh_tx_started, test->mesh_tx_starts,
+						test->mesh_tx_starts_len))) {
+		tester_warn("Expected %u starts of the mesh set, in order",
+						test->mesh_tx_starts_len);
+		util_hexdump('!', test->mesh_tx_starts,
+				test->mesh_tx_starts_len, print_debug, "");
+		tester_test_failed();
+		return FALSE;
+	}
+
+	if (!test->mesh_tx_stops_unchecked &&
+				data->mesh_tx_stops != test->mesh_tx_stops) {
+		tester_warn("Expected %u tear-downs of the mesh set",
+							test->mesh_tx_stops);
+		tester_test_failed();
+		return FALSE;
+	}
+
+	if (test->mesh_tx_coexist && data->mesh_tx_ordinary_hits) {
+		tester_warn("The ordinary advertising set was disabled, "
+						"removed or cleared");
+		tester_test_failed();
+		return FALSE;
+	}
+
+	if (test->mesh_tx_hold_teardown &&
+			test->mesh_tx_hold_action == MESH_TX_HOLD_SEND_2 &&
+			!data->mesh_tx_acked_while_held) {
+		tester_warn("Request 2 was not acknowledged while the "
+						"tear-down was held");
+		tester_test_failed();
+		return FALSE;
+	}
+
+	if ((test->mesh_tx_hold_teardown || test->mesh_tx_hold_start) &&
+			test->mesh_tx_hold_action != MESH_TX_HOLD_SEND_2 &&
+			!data->mesh_tx_barrier_acked) {
+		tester_warn("No Read Mesh Features was answered while the "
+						"command was held");
+		tester_test_failed();
+		return FALSE;
+	}
+
+	if (data->mesh_tx_cancel_acked_held) {
+		tester_warn("The Cancel was acknowledged while the command "
+						"was held");
+		tester_test_failed();
+		return FALSE;
+	}
+
+	if ((test->mesh_tx_power_off != MESH_TX_POWER_NONE ||
+			test->mesh_tx_hold_action == MESH_TX_HOLD_POWER_OFF) &&
+			(!data->mesh_tx_power_off_acked ||
+					!data->mesh_tx_power_on_acked)) {
+		tester_warn("Set Powered off/on not both acknowledged");
+		tester_test_failed();
+		return FALSE;
+	}
+
+	if (test->mesh_tx_receiver && !mesh_tx_settle_receiver(data)) {
+		tester_test_failed();
+		return FALSE;
+	}
+
+	/* Nothing may be left pending after a power cycle, a rejection or
+	 * a closed socket.
+	 */
+	if (test->mesh_tx_power_off != MESH_TX_POWER_NONE ||
+			test->mesh_tx_hold_action == MESH_TX_HOLD_POWER_OFF ||
+			test->mesh_tx_rejected || test->mesh_tx_close_socket) {
+		if (!mesh_tx_read_features(data, MESH_TX_FEATURES_EMPTY))
+			return FALSE;
+	}
+
+	if (!mgmt_send(data->mgmt, MGMT_OP_READ_ADV_FEATURES,
+			data->mgmt_index, 0, NULL,
+			mesh_tx_adv_features_callback, NULL, NULL)) {
+		tester_warn("Failed to send Read Advertising Features");
+		tester_test_failed();
+	}
+
+	return FALSE;
+}
+
+static struct mesh_tx_req *mesh_tx_find_req(struct test_data *data,
+								uint8_t handle)
+{
+	unsigned int i;
+
+	if (!handle)
+		return NULL;
+
+	for (i = 0; i < MESH_TX_SENDS_MAX; i++) {
+		if (data->mesh_tx_req[i].handle == handle)
+			return &data->mesh_tx_req[i];
+	}
+
+	return NULL;
+}
+
+static void mesh_tx_send(struct test_data *data, unsigned int n);
+static void mesh_tx_probe_cmplt(struct test_data *data, uint8_t handle);
+
+/* The number of the request the next Mesh Send stands for */
+static unsigned int mesh_tx_next_request(struct test_data *data)
+{
+	const struct generic_data *test = data->test_data;
+
+	if (test->mesh_tx_send_after_request)
+		return test->mesh_tx_send_after_request;
+
+	return data->mesh_tx_sends_done + 1;
+}
+
+static void mesh_tx_cmplt_callback(uint16_t index, uint16_t length,
+		const void *param, void *user_data)
+{
+	struct test_data *data = tester_get_data();
+	const struct generic_data *test = data->test_data;
+	const struct mgmt_ev_mesh_pkt_cmplt *ev = param;
+	struct mesh_tx_req *req, *expected = NULL;
+	unsigned int n = data->mesh_tx_cmplt_count;
+
+	if (length != sizeof(*ev)) {
+		tester_warn("Invalid Mesh Packet Complete length %u", length);
+		tester_test_failed();
+		return;
+	}
+
+	if (data->mesh_tx_probe.active) {
+		mesh_tx_probe_cmplt(data, ev->handle);
+		return;
+	}
+
+	tester_print("Mesh Packet Complete handle %u at +%lld ms, %u "
+			"tear-downs so far (%u of %u)", ev->handle,
+			(long long) mesh_tx_now_ms(data), data->mesh_tx_stops,
+			n + 1, test->mesh_tx_cmplt_len);
+
+	req = mesh_tx_find_req(data, ev->handle);
+	if (!req) {
+		tester_warn("Handle %u was never acknowledged", ev->handle);
+		tester_test_failed();
+		return;
+	}
+
+	if (req->cmplt++) {
+		tester_warn("Handle %u completed more than once", ev->handle);
+		tester_test_failed();
+		return;
+	}
+
+	req->stops_at_cmplt = data->mesh_tx_stops;
+
+	if (n < test->mesh_tx_cmplt_len)
+		expected = &data->mesh_tx_req[test->mesh_tx_cmplt[n] - 1];
+
+	if (req != expected) {
+		if (test->mesh_tx_cmplt_loose) {
+			tester_print("  not required by this case, recorded");
+			return;
+		}
+
+		if (!expected)
+			tester_warn("Unexpected Mesh Packet Complete");
+		else
+			tester_warn("Expected handle %u (request %u)",
+					expected->handle,
+					test->mesh_tx_cmplt[n]);
+		tester_test_failed();
+		return;
+	}
+
+	/*
+	 * Where the completion comes from: a request completed before any
+	 * tear-down of its own set did not end on its own.
+	 */
+	if (test->mesh_tx_cmplt_stops &&
+			data->mesh_tx_stops != test->mesh_tx_cmplt_stops[n]) {
+		tester_warn("Handle %u completed after %u tear-downs, "
+				"expected %u", ev->handle, data->mesh_tx_stops,
+				test->mesh_tx_cmplt_stops[n]);
+		tester_test_failed();
+		return;
+	}
+
+	/*
+	 * A cancel test is about the cancel: a request that completes on
+	 * its own before the Cancel went out did not meet the scenario.
+	 */
+	if (test->mesh_tx_do_cancel && !data->mesh_tx_cancel_sent) {
+		tester_warn("Handle %u completed before the Cancel was issued",
+								ev->handle);
+		tester_test_failed();
+		return;
+	}
+
+	if ((test->mesh_tx_hold_teardown || test->mesh_tx_hold_start) &&
+				data->mesh_tx_hold != MESH_TX_HOLD_RELEASED) {
+		tester_warn("Handle %u completed without a held command",
+								ev->handle);
+		tester_test_failed();
+		return;
+	}
+
+	data->mesh_tx_cmplt_count = n + 1;
+
+	if (test->mesh_tx_send_after && test->mesh_tx_send_after_at &&
+			n + 1 == test->mesh_tx_send_after_at)
+		mesh_tx_send(data, mesh_tx_next_request(data));
+
+	if (data->mesh_tx_cmplt_count < test->mesh_tx_cmplt_len)
+		return;
+
+	/*
+	 * All transmissions are accounted for; give the tear-down of the
+	 * last set and any stray event time to arrive, then check what the
+	 * controller was told and what is left.
+	 */
+	data->mesh_tx_settle_id = g_timeout_add(400, mesh_tx_settle, NULL);
+}
+
+static void mesh_tx_removed_callback(uint16_t index, uint16_t length,
+		const void *param, void *user_data)
+{
+	const struct mgmt_ev_advertising_removed *ev = param;
+
+	if (length == sizeof(*ev))
+		tester_warn("Advertising Removed for instance %u",
+							ev->instance);
+	else
+		tester_warn("Advertising Removed received");
+
+	tester_test_failed();
+}
+
+static void mesh_tx_send_callback(uint8_t status, uint16_t length,
+		const void *param, void *user_data);
+static void mesh_tx_cancel_held(struct test_data *data);
+
+/* The socket a request goes out on */
+static struct mgmt *mesh_tx_socket(struct test_data *data, unsigned int n)
+{
+	const struct generic_data *test = data->test_data;
+
+	if (data->mesh_tx_mgmt2 && (test->mesh_tx_close_socket ||
+				(test->mesh_tx_alt_socket && n == 2)))
+		return data->mesh_tx_mgmt2;
+
+	return data->mgmt;
+}
+
+static void mesh_tx_send(struct test_data *data, unsigned int n)
+{
+	const struct generic_data *test = data->test_data;
+	struct mgmt *mgmt = mesh_tx_socket(data, n);
+	uint8_t pdu[sizeof(send_mesh_1)];
+	uint16_t len = mesh_tx_pdu_len[n - 1];
+
+	if (n > MESH_TX_SENDS_MAX || len > sizeof(pdu)) {
+		tester_warn("No packet for request %u", n);
+		tester_test_failed();
+		return;
+	}
+
+	memcpy(pdu, mesh_tx_pdu[n - 1], len);
+
+	if (n == 1 && test->mesh_tx_cnt)
+		pdu[MESH_TX_PDU_CNT_OFFSET] = test->mesh_tx_cnt;
+
+	tester_print("Sending Mesh Send %u at +%lld ms%s", n,
+			(long long) mesh_tx_now_ms(data),
+			mgmt == data->mgmt ? "" : " on the second socket");
+
+	if (n > data->mesh_tx_sends_done)
+		data->mesh_tx_sends_done = n;
+
+	test_add_condition(data);
+
+	if (!mgmt_send(mgmt, MGMT_OP_MESH_SEND, data->mgmt_index, len, pdu,
+				mesh_tx_send_callback, UINT_TO_PTR(n), NULL)) {
+		tester_warn("Failed to send Mesh Send %u", n);
+		tester_test_failed();
+	}
+}
+
+static gboolean mesh_tx_send_after(gpointer user_data)
+{
+	struct test_data *data = tester_get_data();
+
+	mesh_tx_send(data, mesh_tx_next_request(data));
+
+	return FALSE;
+}
+
+static void mesh_tx_cancel_callback(uint8_t status, uint16_t length,
+		const void *param, void *user_data)
+{
+	struct test_data *data = tester_get_data();
+
+	tester_print("Mesh Send Cancel at +%lld ms: %s (0x%02x)",
+			(long long) mesh_tx_now_ms(data), mgmt_errstr(status),
+			status);
+
+	if (status != MGMT_STATUS_SUCCESS || length) {
+		tester_test_failed();
+		return;
+	}
+
+	data->mesh_tx_cancel_acked = true;
+
+	/* The kernel runs the Cancel behind the command it is waiting for */
+	if (data->mesh_tx_hold == MESH_TX_HOLD_HELD)
+		data->mesh_tx_cancel_acked_held = true;
+
+	test_condition_complete(data);
+}
+
+/* The handle a Cancel names: that of the request, or 0 for all */
+static uint8_t mesh_tx_cancel_param(struct test_data *data)
+{
+	const struct generic_data *test = data->test_data;
+
+	if (!test->mesh_tx_cancel_handle)
+		return 0;
+
+	return data->mesh_tx_req[test->mesh_tx_cancel_handle - 1].handle;
+}
+
+/*
+ * Issue the Cancel once the scenario is in place: request 1 acknowledged
+ * and started, request 2 acknowledged and still queued, no completion yet.
+ * While a command is held the Cancel is issued from the hold instead.
+ */
+static void mesh_tx_check_cancel(struct test_data *data)
+{
+	const struct generic_data *test = data->test_data;
+	struct mgmt_cp_mesh_send_cancel cancel;
+
+	if (!test->mesh_tx_do_cancel || data->mesh_tx_cancel_sent)
+		return;
+
+	if (test->mesh_tx_hold_action == MESH_TX_HOLD_CANCEL &&
+			(test->mesh_tx_hold_teardown ||
+						test->mesh_tx_hold_start))
+		return;
+
+	if (data->mesh_tx_req[1].starts) {
+		tester_warn("Request 2 started before the Cancel was issued");
+		tester_test_failed();
+		return;
+	}
+
+	if (!data->mesh_tx_req[0].handle || !data->mesh_tx_req[0].starts ||
+				!data->mesh_tx_req[1].handle ||
+				data->mesh_tx_cmplt_count)
+		return;
+
+	cancel.handle = mesh_tx_cancel_param(data);
+
+	tester_print("Sending Mesh Send Cancel for handle %u at +%lld ms%s",
+			cancel.handle, (long long) mesh_tx_now_ms(data),
+			test->mesh_tx_alt_socket ?
+					" on the second socket" : "");
+
+	data->mesh_tx_cancel_sent = true;
+
+	test_add_condition(data);
+
+	if (!mgmt_send(mesh_tx_socket(data, 2), MGMT_OP_MESH_SEND_CANCEL,
+				data->mgmt_index, sizeof(cancel), &cancel,
+				mesh_tx_cancel_callback, NULL, NULL)) {
+		tester_warn("Failed to send Mesh Send Cancel");
+		tester_test_failed();
+	}
+}
+
+static void mesh_tx_release(struct test_data *data)
+{
+	struct btdev *btdev = vhci_get_btdev(hciemu_get_vhci(data->hciemu));
+
+	tester_print("Releasing the held command at +%lld ms",
+					(long long) mesh_tx_now_ms(data));
+
+	data->mesh_tx_hold = MESH_TX_HOLD_RELEASED;
+
+	if (!btdev) {
+		tester_warn("No emulated controller to release it to");
+		tester_test_failed();
+		return;
+	}
+
+	btdev_receive_h4(btdev, data->mesh_tx_held_cmd, data->mesh_tx_held_len);
+}
+
+/*
+ * The barrier: a Read Mesh Features written on the same socket right
+ * behind the command issued during the hold (both bypass the client's
+ * queue, so they reach the kernel in that order). Its reply arrives while
+ * the command is still held, which shows the kernel accepted what came
+ * before it, then the held command is released. A Read Mesh Features is
+ * answered from the caller's context, so it cannot wait behind the
+ * serialized reply of the Cancel or Set Powered the kernel is holding.
+ */
+static void mesh_tx_barrier_callback(uint8_t status, uint16_t length,
+		const void *param, void *user_data)
+{
+	struct test_data *data = tester_get_data();
+	const struct generic_data *test = data->test_data;
+	const struct mgmt_rp_mesh_read_features *rp = param;
+	unsigned int i;
+
+	if (status != MGMT_STATUS_SUCCESS || length < sizeof(*rp) ||
+				length != sizeof(*rp) + rp->used_handles) {
+		tester_warn("Barrier Read Mesh Features failed: %s (0x%02x)",
+						mgmt_errstr(status), status);
+		tester_test_failed();
+		return;
+	}
+
+	tester_print("Barrier answered at +%lld ms with the command %s: %u "
+			"handles pending", (long long) mesh_tx_now_ms(data),
+			data->mesh_tx_hold == MESH_TX_HOLD_HELD ? "held" :
+			"not held", rp->used_handles);
+
+	for (i = 0; i < rp->used_handles; i++)
+		tester_print("  handle %u", rp->handles[i]);
+
+	if (data->mesh_tx_hold != MESH_TX_HOLD_HELD) {
+		tester_warn("The barrier was answered after the release");
+		tester_test_failed();
+		return;
+	}
+
+	data->mesh_tx_barrier_acked = true;
+
+	test_condition_complete(data);
+
+	mesh_tx_release(data);
+
+	/* The requests of the closed socket complete to nobody; give the
+	 * kernel time to finish with them before the next request.
+	 */
+	if (test->mesh_tx_hold_action == MESH_TX_HOLD_CLOSE)
+		g_timeout_add(300, mesh_tx_send_after, NULL);
+}
+
+static void mesh_tx_barrier(struct test_data *data)
+{
+	test_add_condition(data);
+
+	if (!mgmt_send_nowait(data->mgmt, MGMT_OP_MESH_READ_FEATURES,
+				data->mgmt_index, 0, NULL,
+				mesh_tx_barrier_callback, NULL, NULL)) {
+		tester_warn("Failed to send the barrier Read Mesh Features");
+		tester_test_failed();
+	}
+}
+
+/* The Cancel issued while a command is held, followed by the barrier */
+static void mesh_tx_cancel_held(struct test_data *data)
+{
+	struct mgmt_cp_mesh_send_cancel cancel;
+
+	cancel.handle = mesh_tx_cancel_param(data);
+
+	tester_print("Sending Mesh Send Cancel for handle %u at +%lld ms "
+			"with the command held", cancel.handle,
+			(long long) mesh_tx_now_ms(data));
+
+	data->mesh_tx_cancel_sent = true;
+
+	test_add_condition(data);
+
+	if (!mgmt_send_nowait(data->mgmt, MGMT_OP_MESH_SEND_CANCEL,
+				data->mgmt_index, sizeof(cancel), &cancel,
+				mesh_tx_cancel_callback, NULL, NULL)) {
+		tester_warn("Failed to send Mesh Send Cancel");
+		tester_test_failed();
+		return;
+	}
+
+	mesh_tx_barrier(data);
+}
+
+static void mesh_tx_power(struct test_data *data, bool on);
+
+static gboolean mesh_tx_power_on_later(gpointer user_data)
+{
+	struct test_data *data = tester_get_data();
+
+	mesh_tx_power(data, true);
+
+	return FALSE;
+}
+
+static void mesh_tx_power_callback(uint8_t status, uint16_t length,
+		const void *param, void *user_data)
+{
+	struct test_data *data = tester_get_data();
+	const struct generic_data *test = data->test_data;
+	bool on = PTR_TO_UINT(user_data);
+
+	tester_print("Set Powered %s at +%lld ms: %s (0x%02x)",
+			on ? "on" : "off", (long long) mesh_tx_now_ms(data),
+			mgmt_errstr(status), status);
+
+	if (status != MGMT_STATUS_SUCCESS) {
+		tester_test_failed();
+		return;
+	}
+
+	if (on) {
+		data->mesh_tx_power_on_acked = true;
+
+		/* What the power cycle left pending, recorded */
+		if (!mesh_tx_read_features(data, MESH_TX_FEATURES_RECORD))
+			return;
+
+		if (test->mesh_tx_send_after)
+			mesh_tx_send(data, mesh_tx_next_request(data));
+	} else {
+		data->mesh_tx_power_off_acked = true;
+
+		if (test->mesh_tx_power_on_delay)
+			g_timeout_add(test->mesh_tx_power_on_delay,
+						mesh_tx_power_on_later, NULL);
+		else
+			mesh_tx_power(data, true);
+	}
+
+	test_condition_complete(data);
+}
+
+static void mesh_tx_power(struct test_data *data, bool on)
+{
+	uint8_t param = on ? 0x01 : 0x00;
+
+	tester_print("Sending Set Powered %s at +%lld ms", on ? "on" : "off",
+					(long long) mesh_tx_now_ms(data));
+
+	if (!on)
+		data->mesh_tx_power_off_sent = true;
+
+	test_add_condition(data);
+
+	if (!mgmt_send_nowait(data->mgmt, MGMT_OP_SET_POWERED,
+				data->mgmt_index, sizeof(param), &param,
+				mesh_tx_power_callback, UINT_TO_PTR(on),
+				NULL)) {
+		tester_warn("Failed to send Set Powered");
+		tester_test_failed();
+	}
+}
+
+/* Close the socket the requests went out on; their completions go nowhere */
+static void mesh_tx_close_socket(struct test_data *data)
+{
+	tester_print("Closing the second socket at +%lld ms",
+					(long long) mesh_tx_now_ms(data));
+
+	mgmt_unref(data->mesh_tx_mgmt2);
+	data->mesh_tx_mgmt2 = NULL;
+}
+
+static void mesh_tx_send_callback(uint8_t status, uint16_t length,
+		const void *param, void *user_data)
+{
+	struct test_data *data = tester_get_data();
+	const struct generic_data *test = data->test_data;
+	const uint8_t *handle = param;
+	unsigned int n = PTR_TO_UINT(user_data);
+
+	if (status != MGMT_STATUS_SUCCESS || length != sizeof(*handle)) {
+		tester_warn("Mesh Send %u failed: %s (0x%02x)", n,
+						mgmt_errstr(status), status);
+		tester_test_failed();
+		return;
+	}
+
+	tester_print("Mesh Send %u at +%lld ms: handle %u", n,
+			(long long) mesh_tx_now_ms(data), *handle);
+
+	/* Handles start at 1 on a fresh controller and go up by one */
+	if (*handle != data->mesh_tx_last_handle + 1) {
+		tester_warn("Expected handle %u",
+					data->mesh_tx_last_handle + 1);
+		tester_test_failed();
+		return;
+	}
+
+	data->mesh_tx_last_handle = *handle;
+	data->mesh_tx_req[n - 1].handle = *handle;
+
+	if (test->mesh_tx_hold_teardown &&
+			test->mesh_tx_hold_action == MESH_TX_HOLD_SEND_2 &&
+			n == 2) {
+		if (data->mesh_tx_hold != MESH_TX_HOLD_HELD) {
+			tester_warn("Mesh Send 2 acknowledged with no "
+						"tear-down held");
+			tester_test_failed();
+			return;
+		}
+
+		data->mesh_tx_acked_while_held = true;
+		mesh_tx_release(data);
+	}
+
+	test_condition_complete(data);
+
+	/* The Cancel of the held start waits for request 2's handle */
+	if (test->mesh_tx_hold_start &&
+			test->mesh_tx_hold_action == MESH_TX_HOLD_CANCEL &&
+			n == 2 && data->mesh_tx_hold == MESH_TX_HOLD_HELD &&
+			!data->mesh_tx_cancel_sent) {
+		mesh_tx_cancel_held(data);
+		return;
+	}
+
+	mesh_tx_check_cancel(data);
+}
+
+/* The request whose packet is in the advertising data, 0 if none */
+static unsigned int mesh_tx_match_pdu(const uint8_t *adv_data, uint8_t len)
+{
+	unsigned int i;
+	uint8_t off;
+
+	for (i = 0; i < MESH_TX_SENDS_MAX; i++) {
+		const struct mgmt_cp_mesh_send *send;
+
+		send = (const struct mgmt_cp_mesh_send *) mesh_tx_pdu[i];
+
+		for (off = 0; off + send->adv_data_len <= len; off++) {
+			if (!memcmp(adv_data + off, send->adv_data,
+							send->adv_data_len))
+				return i + 1;
+		}
+	}
+
+	return 0;
+}
+
+static void mesh_tx_start(struct test_data *data)
+{
+	const struct generic_data *test = data->test_data;
+	unsigned int req = data->mesh_tx_loaded;
+
+	if (!req) {
+		tester_print("Advertising started with no mesh packet loaded");
+		return;
+	}
+
+	data->mesh_tx_t_enable = mesh_tx_now_ms(data);
+
+	if (data->mesh_tx_starts < MESH_TX_STARTS_MAX)
+		data->mesh_tx_started[data->mesh_tx_starts] = req;
+	data->mesh_tx_starts++;
+	data->mesh_tx_req[req - 1].starts++;
+
+	tester_print("Mesh set started for request %u (%u) at +%lld ms", req,
+					data->mesh_tx_req[req - 1].starts,
+					(long long) data->mesh_tx_t_enable);
+
+	/* The controller goes away with this transmission on it */
+	if (req == 1 && test->mesh_tx_pass_on_start) {
+		tester_print("Ending the test with the transmission on the "
+							"controller");
+		tester_test_passed();
+		return;
+	}
+
+	if (req == 1 && test->mesh_tx_power_off == MESH_TX_POWER_ON_START &&
+					!data->mesh_tx_power_off_sent) {
+		mesh_tx_power(data, false);
+		return;
+	}
+
+	mesh_tx_check_cancel(data);
+}
+
+static void mesh_tx_hci_callback(uint16_t opcode, const void *param,
+		uint8_t length, void *user_data)
+{
+	struct test_data *data = user_data;
+	const struct bt_hci_cmd_le_set_adv_data *adv_data;
+	const struct bt_hci_cmd_le_set_ext_adv_data *ext_adv_data;
+	const struct bt_hci_cmd_le_set_ext_adv_enable *cp;
+	const struct bt_hci_cmd_ext_adv_set *set;
+	uint8_t handle;
+	unsigned int i;
+
+	tester_print("HCI Command 0x%04x length %u", opcode, length);
+
+	/* A held tear-down command is counted when it is released */
+	if (data->mesh_tx_hold_skip) {
+		data->mesh_tx_hold_skip = false;
+		return;
+	}
+
+	switch (opcode) {
+	case BT_HCI_CMD_LE_SET_ADV_DATA:
+		adv_data = param;
+		if (length != sizeof(*adv_data) ||
+				adv_data->len > sizeof(adv_data->data))
+			return;
+
+		data->mesh_tx_loaded = mesh_tx_match_pdu(adv_data->data,
+								adv_data->len);
+		break;
+	case BT_HCI_CMD_LE_SET_EXT_ADV_DATA:
+		ext_adv_data = param;
+		if (length < sizeof(*ext_adv_data) || length !=
+				sizeof(*ext_adv_data) + ext_adv_data->data_len)
+			return;
+
+		if (ext_adv_data->handle != MESH_EXT_ADV_HANDLE)
+			return;
+
+		data->mesh_tx_loaded = mesh_tx_match_pdu(ext_adv_data->data,
+						ext_adv_data->data_len);
+		break;
+	case BT_HCI_CMD_LE_SET_ADV_ENABLE:
+		if (length != 1)
+			return;
+
+		if (*(const uint8_t *) param) {
+			mesh_tx_start(data);
+		} else {
+			/* The one advertising set there is */
+			data->mesh_tx_stops++;
+			data->mesh_tx_t_disable = mesh_tx_now_ms(data);
+			data->mesh_tx_ordinary_hits++;
+		}
+		break;
+	case BT_HCI_CMD_LE_SET_EXT_ADV_ENABLE:
+		cp = param;
+		if (length < sizeof(*cp) || length !=
+				sizeof(*cp) + cp->num_of_sets * sizeof(*set))
+			return;
+
+		if (!cp->num_of_sets) {
+			/* All sets */
+			if (!cp->enable)
+				data->mesh_tx_ordinary_hits++;
+			return;
+		}
+
+		set = (const void *)(cp + 1);
+		for (i = 0; i < cp->num_of_sets; i++, set++) {
+			if (set->handle == MESH_EXT_ADV_HANDLE) {
+				if (cp->enable)
+					mesh_tx_start(data);
+			} else if (set->handle == MESH_ORDINARY_ADV_HANDLE &&
+								!cp->enable) {
+				data->mesh_tx_ordinary_hits++;
+			}
+		}
+		break;
+	case BT_HCI_CMD_LE_REMOVE_ADV_SET:
+		if (length != 1)
+			return;
+
+		handle = *(const uint8_t *) param;
+		if (handle == MESH_EXT_ADV_HANDLE) {
+			data->mesh_tx_stops++;
+			data->mesh_tx_t_disable = mesh_tx_now_ms(data);
+		} else if (handle == MESH_ORDINARY_ADV_HANDLE) {
+			data->mesh_tx_ordinary_hits++;
+		}
+		break;
+	case BT_HCI_CMD_LE_CLEAR_ADV_SETS:
+		data->mesh_tx_ordinary_hits++;
+		break;
+	default:
+		break;
+	}
+}
+
+/*
+ * Runs in the emulator before the command is processed. Holds back the
+ * first tear-down command after request 1 started (LE Set Advertising
+ * Enable 0x00, or LE Set Extended Advertising Enable with enable 0x00),
+ * or the enable that starts request 1 (mesh_tx_hold_start): returning
+ * false drops it, so the kernel keeps waiting for the reply. What the
+ * case asks for is done in that state (mesh_tx_hold_action); the command
+ * is released later by feeding it back into the emulator
+ * (mesh_tx_release), where it passes through here again.
+ */
+static bool mesh_tx_hold_hook(const void *param, uint16_t length,
+							void *user_data)
+{
+	struct test_data *data = user_data;
+	const struct generic_data *test = data->test_data;
+	struct bt_hci_cmd_hdr *hdr;
+	uint16_t opcode = data->mesh_tx_hold_opcode;
+	bool enable, match;
+
+	if (data->mesh_tx_hold != MESH_TX_HOLD_ARMED)
+		return true;
+
+	if (opcode == BT_HCI_CMD_LE_SET_EXT_ADV_ENABLE) {
+		const struct bt_hci_cmd_le_set_ext_adv_enable *cp = param;
+
+		if (length < sizeof(*cp))
+			return true;
+
+		enable = cp->enable;
+	} else {
+		if (length != 1)
+			return true;
+
+		enable = *(const uint8_t *) param;
+	}
+
+	if (test->mesh_tx_hold_start)
+		match = enable && data->mesh_tx_loaded == 1;
+	else
+		match = !enable && data->mesh_tx_req[0].starts;
+
+	if (!match || length > 255)
+		return true;
+
+	tester_print("Holding %s command 0x%04x at +%lld ms",
+			test->mesh_tx_hold_start ? "start" : "tear-down",
+			opcode, (long long) mesh_tx_now_ms(data));
+
+	data->mesh_tx_held_cmd[0] = BT_H4_CMD_PKT;
+	hdr = (void *) &data->mesh_tx_held_cmd[1];
+	hdr->opcode = cpu_to_le16(opcode);
+	hdr->plen = length;
+	memcpy(data->mesh_tx_held_cmd + 1 + sizeof(*hdr), param, length);
+	data->mesh_tx_held_len = 1 + sizeof(*hdr) + length;
+	data->mesh_tx_hold = MESH_TX_HOLD_HELD;
+	data->mesh_tx_hold_skip = true;
+
+	switch (test->mesh_tx_hold_action) {
+	case MESH_TX_HOLD_SEND_2:
+		mesh_tx_send(data, 2);
+		break;
+	case MESH_TX_HOLD_CANCEL:
+		/* With the start held, wait for request 2's handle */
+		if (!test->mesh_tx_hold_start || data->mesh_tx_req[1].handle)
+			mesh_tx_cancel_held(data);
+		break;
+	case MESH_TX_HOLD_POWER_OFF:
+		mesh_tx_power(data, false);
+		mesh_tx_barrier(data);
+		break;
+	case MESH_TX_HOLD_CLOSE:
+		mesh_tx_close_socket(data);
+		mesh_tx_barrier(data);
+		break;
+	case MESH_TX_HOLD_PASS:
+		tester_print("Ending the test with the command held");
+		tester_test_passed();
+		break;
+	}
+
+	return false;
+}
+
+/*
+ * Receiver (extended advertising): the client scans and every extended
+ * advertising report carrying the packet of request 1 is counted and
+ * timed. Runs in the emulator when the client's controller sends an
+ * LE Meta event to its host.
+ */
+static bool mesh_tx_report_hook(const void *param, uint16_t length,
+							void *user_data)
+{
+	struct test_data *data = user_data;
+	const uint8_t *buf = param;
+	const struct bt_hci_evt_le_ext_adv_report *ev;
+	const struct bt_hci_le_ext_adv_report *report;
+	unsigned int i;
+
+	if (length < 1 + sizeof(*ev) || buf[0] != BT_HCI_EVT_LE_EXT_ADV_REPORT)
+		return true;
+
+	ev = (const void *) (buf + 1);
+	buf += 1 + sizeof(*ev);
+	length -= 1 + sizeof(*ev);
+
+	for (i = 0; i < ev->num_reports; i++) {
+		if (length < sizeof(*report))
+			break;
+
+		report = (const void *) buf;
+		if (length < sizeof(*report) + report->data_len)
+			break;
+
+		if (mesh_tx_match_pdu(report->data, report->data_len) == 1) {
+			unsigned int n = data->mesh_tx_reports;
+			int64_t t = mesh_tx_now_ms(data);
+
+			if (n < MESH_TX_REPORTS_MAX)
+				data->mesh_tx_report_t[n] = t;
+			data->mesh_tx_reports++;
+
+			tester_print("Client received the mesh packet of "
+					"request 1 at +%lld ms (%u)",
+					(long long) t, data->mesh_tx_reports);
+		}
+
+		buf += sizeof(*report) + report->data_len;
+		length -= sizeof(*report) + report->data_len;
+	}
+
+	return true;
+}
+
+static gboolean mesh_tx_receiver_ready(gpointer user_data)
+{
+	struct test_data *data = tester_get_data();
+
+	tester_print("Client scanning, sending the request");
+
+	mesh_tx_send(data, 1);
+
+	return FALSE;
+}
+
+/* The client's LE Set Scan Enable completed: it receives from now on */
+static bool mesh_tx_scan_hook(const void *param, uint16_t length,
+							void *user_data)
+{
+	struct test_data *data = user_data;
+
+	if (!data->mesh_tx_sends_done)
+		g_idle_add(mesh_tx_receiver_ready, NULL);
+
+	return true;
+}
+
+static bool mesh_tx_receiver_start(struct test_data *data)
+{
+	struct hciemu_client *client = hciemu_get_client(data->hciemu, 0);
+	struct bthost *host = hciemu_client_host(client);
+
+	if (!client || !host) {
+		tester_warn("No client to receive with");
+		return false;
+	}
+
+	if (hciemu_client_add_hook(client, HCIEMU_HOOK_POST_EVT,
+				BT_HCI_EVT_LE_META_EVENT,
+				mesh_tx_report_hook, data) < 0 ||
+			hciemu_client_add_hook(client, HCIEMU_HOOK_POST_CMD,
+				BT_HCI_CMD_LE_SET_SCAN_ENABLE,
+				mesh_tx_scan_hook, data) < 0) {
+		tester_warn("Failed to register the client hooks");
+		return false;
+	}
+
+	data->mesh_tx_receiver_hooked = true;
+
+	/* Passive scan, public address, no filter, no duplicate filtering */
+	bthost_set_scan_params(host, 0x00, 0x00, 0x00);
+	bthost_set_scan_enable(host, 0x01);
+
+	return true;
+}
+
+/*
+ * Failing allocation: /proc/self/fail-nth makes the n-th fault point hit
+ * by this task fail. n is raised from 1 until the one that fails is the
+ * first hci_cmd_sync_queue() of a Mesh Send, recognised by the request
+ * having been given a handle (the next accepted request gets the one
+ * after it) although it was answered Failed. Probe sends that the fault
+ * did not hit there are ordinary transmissions and are let complete.
+ */
+#define MESH_TX_FAIL_NTH	"/proc/self/fail-nth"
+#define MESH_TX_FAILSLAB	"/sys/kernel/debug/failslab"
+
+static bool mesh_tx_write_file(const char *path, const char *str)
+{
+	int fd;
+	ssize_t written;
+
+	fd = open(path, O_WRONLY);
+	if (fd < 0)
+		return false;
+
+	written = write(fd, str, strlen(str));
+	close(fd);
+
+	return written == (ssize_t) strlen(str);
+}
+
+static bool mesh_tx_fail_nth(struct test_data *data, unsigned int nth)
+{
+	char buf[16];
+	int len;
+
+	len = snprintf(buf, sizeof(buf), "%u", nth);
+
+	return write(data->mesh_tx_probe.fd, buf, len) == len;
+}
+
+static void mesh_tx_probe_send(struct test_data *data);
+
+static void mesh_tx_probe_failed(struct test_data *data);
+
+static void mesh_tx_probe_b_callback(uint8_t status, uint16_t length,
+		const void *param, void *user_data)
+{
+	struct test_data *data = tester_get_data();
+	struct mesh_tx_probe *probe = &data->mesh_tx_probe;
+	const uint8_t *handle = param;
+
+	if (status != MGMT_STATUS_SUCCESS || length != sizeof(*handle)) {
+		tester_warn("Mesh Send 2 after the probe failed: %s (0x%02x)",
+						mgmt_errstr(status), status);
+		tester_test_failed();
+		return;
+	}
+
+	tester_print("Probe %u: Mesh Send 2 got handle %u (the last handle "
+			"before it was %u)", probe->nth, *handle,
+			probe->last_handle);
+
+	if (*handle == probe->last_handle + 1) {
+		/* The fault hit before the request was added, or an
+		 * allocation outside mesh_send(): request 2 is an ordinary
+		 * transmission, let it complete and try the next point.
+		 */
+		probe->last_handle = *handle;
+		probe->waiting_cmplt = true;
+		return;
+	}
+
+	if (*handle != probe->last_handle + 2) {
+		tester_warn("Unexpected handle after the probe");
+		tester_test_failed();
+		return;
+	}
+
+	/* Reached: the probe's request was added and given a handle, its
+	 * start could not be queued, and it was answered Failed.
+	 */
+	probe->rejected_handle = *handle - 1;
+	probe->active = false;
+
+	tester_print("Rejected start with fail-nth %u: request 1 was given "
+			"handle %u and answered Failed, request 2 got handle %u",
+			probe->nth, probe->rejected_handle, *handle);
+
+	data->mesh_tx_req[1].handle = *handle;
+	data->mesh_tx_last_handle = *handle;
+	data->mesh_tx_sends_done = 2;
+
+	/* The rejected request must not be listed any more */
+	mesh_tx_read_features(data, MESH_TX_FEATURES_REQ2);
+}
+
+static void mesh_tx_probe_failed(struct test_data *data)
+{
+	struct mesh_tx_probe *probe = &data->mesh_tx_probe;
+
+	tester_print("Probe %u: Mesh Send 1 was answered Failed, sending "
+					"Mesh Send 2", probe->nth);
+
+	/* What the controller is told from here on is what counts: the
+	 * earlier probe transmissions have completed. The packet loaded
+	 * into the controller stays known: the kernel does not reload
+	 * advertising data it already set.
+	 */
+	memset(data->mesh_tx_req, 0, sizeof(data->mesh_tx_req));
+	memset(data->mesh_tx_started, 0, sizeof(data->mesh_tx_started));
+	data->mesh_tx_starts = 0;
+	data->mesh_tx_stops = 0;
+	data->mesh_tx_cmplt_count = 0;
+
+	if (!mgmt_send(data->mgmt, MGMT_OP_MESH_SEND, data->mgmt_index,
+				mesh_tx_pdu_len[1], mesh_tx_pdu[1],
+				mesh_tx_probe_b_callback, NULL, NULL)) {
+		tester_warn("Failed to send Mesh Send 2 after the probe");
+		tester_test_failed();
+	}
+}
+
+static void mesh_tx_probe_callback(uint8_t status, uint16_t length,
+		const void *param, void *user_data)
+{
+	struct test_data *data = tester_get_data();
+	struct mesh_tx_probe *probe = &data->mesh_tx_probe;
+	const uint8_t *handle = param;
+
+	if (probe->timeout_id) {
+		g_source_remove(probe->timeout_id);
+		probe->timeout_id = 0;
+	}
+
+	probe->request_id = 0;
+
+	if (status == MGMT_STATUS_SUCCESS && length == sizeof(*handle)) {
+		tester_print("Probe %u: Mesh Send 1 accepted, handle %u",
+						probe->nth, *handle);
+		probe->last_handle = *handle;
+		probe->waiting_cmplt = true;
+		return;
+	}
+
+	tester_print("Probe %u: Mesh Send 1 answered %s (0x%02x)", probe->nth,
+						mgmt_errstr(status), status);
+
+	probe->failed = true;
+
+	/* Inside mgmt_send_nowait(): the caller goes on */
+	if (probe->sync)
+		return;
+
+	mesh_tx_probe_failed(data);
+}
+
+static gboolean mesh_tx_probe_timeout(gpointer user_data)
+{
+	struct test_data *data = tester_get_data();
+	struct mesh_tx_probe *probe = &data->mesh_tx_probe;
+
+	probe->timeout_id = 0;
+
+	tester_warn("Probe %u: neither a reply nor a completion", probe->nth);
+	tester_test_failed();
+
+	return FALSE;
+}
+
+static void mesh_tx_probe_next(struct test_data *data)
+{
+	struct mesh_tx_probe *probe = &data->mesh_tx_probe;
+
+	probe->nth++;
+
+	if (probe->nth > MESH_TX_FAIL_NTH_MAX) {
+		tester_warn("No fault point up to %u made the first "
+				"hci_cmd_sync_queue() of a Mesh Send fail",
+				MESH_TX_FAIL_NTH_MAX);
+		tester_test_failed();
+		return;
+	}
+
+	mesh_tx_probe_send(data);
+}
+
+static void mesh_tx_probe_cmplt(struct test_data *data, uint8_t handle)
+{
+	struct mesh_tx_probe *probe = &data->mesh_tx_probe;
+
+	tester_print("Probe %u: Mesh Packet Complete handle %u", probe->nth,
+								handle);
+
+	if (probe->waiting_cmplt && handle == probe->last_handle) {
+		probe->waiting_cmplt = false;
+		mesh_tx_probe_next(data);
+		return;
+	}
+
+	/* A probe send whose reply was lost to the fault: it was accepted */
+	if (probe->request_id && handle == probe->last_handle + 1) {
+		tester_print("Probe %u: accepted without a reply", probe->nth);
+		mgmt_cancel(data->mgmt, probe->request_id);
+		probe->request_id = 0;
+		if (probe->timeout_id) {
+			g_source_remove(probe->timeout_id);
+			probe->timeout_id = 0;
+		}
+		probe->last_handle = handle;
+		mesh_tx_probe_next(data);
+		return;
+	}
+
+	tester_warn("Unexpected completion while probing");
+	tester_test_failed();
+}
+
+static void mesh_tx_probe_send(struct test_data *data)
+{
+	struct mesh_tx_probe *probe = &data->mesh_tx_probe;
+
+	tester_print("Probe %u: Mesh Send 1 with fail-nth %u at +%lld ms",
+			probe->nth, probe->nth,
+			(long long) mesh_tx_now_ms(data));
+
+	probe->failed = false;
+
+	if (!mesh_tx_fail_nth(data, probe->nth)) {
+		tester_warn("Failed to write " MESH_TX_FAIL_NTH);
+		tester_test_failed();
+		return;
+	}
+
+	/* Written at once, so the fault point count starts with this send */
+	probe->sync = true;
+	probe->request_id = mgmt_send_nowait(data->mgmt, MGMT_OP_MESH_SEND,
+				data->mgmt_index, mesh_tx_pdu_len[0],
+				mesh_tx_pdu[0], mesh_tx_probe_callback, NULL,
+				NULL);
+	probe->sync = false;
+
+	mesh_tx_fail_nth(data, 0);
+
+	if (probe->failed) {
+		/* The send itself failed, or the reply came back at once */
+		probe->request_id = 0;
+		mesh_tx_probe_failed(data);
+		return;
+	}
+
+	if (!probe->request_id) {
+		tester_warn("Failed to send the probe Mesh Send");
+		tester_test_failed();
+		return;
+	}
+
+	probe->timeout_id = g_timeout_add(600, mesh_tx_probe_timeout, NULL);
+}
+
+static bool mesh_tx_probe_start(struct test_data *data)
+{
+	struct mesh_tx_probe *probe = &data->mesh_tx_probe;
+
+	if (access(MESH_TX_FAIL_NTH, W_OK) < 0 ||
+			access(MESH_TX_FAILSLAB "/ignore-gfp-wait", W_OK) < 0) {
+		tester_warn("Fault injection is not available in this kernel "
+				"(CONFIG_FAULT_INJECTION, CONFIG_FAILSLAB, "
+				"CONFIG_FAULT_INJECTION_DEBUG_FS)");
+		tester_test_abort();
+		return false;
+	}
+
+	/* Count GFP_KERNEL allocations too, in every cache */
+	if (!mesh_tx_write_file(MESH_TX_FAILSLAB "/ignore-gfp-wait", "0") ||
+			!mesh_tx_write_file(MESH_TX_FAILSLAB "/cache-filter",
+									"0")) {
+		tester_warn("Failed to configure " MESH_TX_FAILSLAB);
+		tester_test_failed();
+		return false;
+	}
+
+	probe->fd = open(MESH_TX_FAIL_NTH, O_WRONLY);
+	if (probe->fd < 0) {
+		tester_warn("Failed to open " MESH_TX_FAIL_NTH);
+		tester_test_failed();
+		return false;
+	}
+
+	probe->active = true;
+	probe->nth = 1;
+
+	mesh_tx_probe_send(data);
+
+	return true;
+}
+
+static void test_mesh_tx(const void *test_data)
+{
+	struct test_data *data = tester_get_data();
+	const struct generic_data *test = data->test_data;
+	unsigned int i;
+
+	data->mesh_tx_t0 = g_get_monotonic_time();
+	data->mesh_tx_probe.fd = -1;
+
+	tester_print("Registering Mesh Packet Complete notification");
+	data->mesh_tx_cmplt_id = mgmt_register(data->mgmt_alt,
+					MGMT_EV_MESH_PACKET_CMPLT,
+					data->mgmt_index,
+					mesh_tx_cmplt_callback, NULL, NULL);
+
+	tester_print("Registering Advertising Removed notification");
+	data->mesh_tx_removed_id = mgmt_register(data->mgmt_alt,
+					MGMT_EV_ADVERTISING_REMOVED,
+					data->mgmt_index,
+					mesh_tx_removed_callback, NULL, NULL);
+
+	if (!data->mesh_tx_cmplt_id || !data->mesh_tx_removed_id) {
+		tester_warn("Failed to register for the events");
+		tester_test_failed();
+		return;
+	}
+
+	tester_print("Registering HCI command callback");
+	if (!hciemu_add_central_post_command_hook(data->hciemu,
+						mesh_tx_hci_callback, data)) {
+		tester_warn("Failed to register the HCI command callback");
+		tester_test_failed();
+		return;
+	}
+
+	if (test->mesh_tx_alt_socket || test->mesh_tx_close_socket) {
+		data->mesh_tx_mgmt2 = mgmt_new_default();
+		if (!data->mesh_tx_mgmt2) {
+			tester_warn("Failed to open the second socket");
+			tester_test_failed();
+			return;
+		}
+
+		if (tester_use_debug())
+			mgmt_set_debug(data->mesh_tx_mgmt2, print_debug,
+							"mgmt2: ", NULL);
+	}
+
+	if (test->mesh_tx_hold_teardown || test->mesh_tx_hold_start) {
+		tester_print("Registering the hold hook");
+		data->mesh_tx_hold_opcode = mesh_tx_teardown_opcode(data);
+		if (hciemu_add_hook(data->hciemu, HCIEMU_HOOK_PRE_CMD,
+					data->mesh_tx_hold_opcode,
+					mesh_tx_hold_hook, data) < 0) {
+			tester_warn("Failed to register the hold hook");
+			tester_test_failed();
+			return;
+		}
+
+		data->mesh_tx_hold = MESH_TX_HOLD_ARMED;
+	}
+
+	/* The completions, the settle check and Read Advertising Features */
+	test_add_condition(data);
+
+	if (test->mesh_tx_receiver) {
+		if (!mesh_tx_receiver_start(data))
+			tester_test_failed();
+		return;
+	}
+
+	if (test->mesh_tx_rejected) {
+		mesh_tx_probe_start(data);
+		return;
+	}
+
+	for (i = 1; i <= test->mesh_tx_sends; i++)
+		mesh_tx_send(data, i);
+}
+
+int main(int argc, char *argv[])
+{
+	tester_init(&argc, &argv);
+
+	test_bredrle("Controller setup",
+			NULL, NULL, controller_setup);
+
+	/* LL Mesh Enable
+	 * Setup: None
+	 * Run: Send Enable Experimental Feature (mesh)
+	 * Expect: Mesh feature enable success
+	 */
+	test_bredrle("Mesh - Enable 1",
+			&enable_mesh_1,
+			NULL,
+			test_command_generic);
+
+	test_bredrle("Mesh - Enable 2",
+			&enable_mesh_2,
+			setup_enable_mesh,
+			test_command_generic);
+
+	test_bredrle("Mesh - Read Mesh Features",
+			&read_mesh_features,
+			setup_enable_mesh,
+			test_command_generic);
+
+	test_bredrle("Mesh - Read Mesh Features - Disabled",
+			&read_mesh_features_disabled,
+			NULL,
+			test_command_generic);
+
+	test_bredrle("Mesh - Send",
+			&mesh_send_mesh_1,
+			setup_enable_mesh,
+			test_command_generic);
+
+	test_bredrle("Mesh - Send - too short",
+			&mesh_send_mesh_too_short,
+			setup_enable_mesh,
+			test_command_generic);
+
+	test_bredrle("Mesh - Send - too long",
+			&mesh_send_mesh_too_long,
+			setup_enable_mesh,
+			test_command_generic);
+
+	test_bredrle("Mesh - Send cancel - 1",
+			&mesh_send_mesh_cancel_1,
+			setup_multi_mesh_send,
+			test_command_generic);
+
+	test_bredrle("Mesh - Send cancel - 2",
+			&mesh_send_mesh_cancel_2,
+			setup_multi_mesh_send,
+			test_command_generic);
+
+	/*
+	 * The same with extended advertising: the mesh packet goes out
+	 * through its own advertising set, which must be removed when the
+	 * transmission is done or cancelled.
+	 */
+	test_bredrle50("Mesh - Send - Ext Adv",
+			&mesh_send_mesh_1_ext,
+			setup_enable_mesh,
+			test_command_generic);
+
+	test_bredrle50("Mesh - Send cancel - 1 - Ext Adv",
+			&mesh_send_mesh_cancel_1_ext,
+			setup_multi_mesh_send,
+			test_command_generic);
+
+	test_bredrle50("Mesh - Send cancel - 2 - Ext Adv",
+			&mesh_send_mesh_cancel_2_ext,
+			setup_multi_mesh_send,
+			test_command_generic);
+
+	/*
+	 * Transmission lifecycle: which handle completes when, what the
+	 * controller is told for which packet, no Advertising Removed for
+	 * the mesh set. The sequences wait for two transmissions and a
+	 * settle time, hence the longer timeout.
+	 */
+	test_bredrle_full("Mesh - Send queue - cancel active",
+			&mesh_tx_cancel_active,
+			setup_enable_mesh,
+			test_mesh_tx, 4);
+
+	test_bredrle_full("Mesh - Send queue - cancel queued",
+			&mesh_tx_cancel_queued,
+			setup_enable_mesh,
+			test_mesh_tx, 4);
+
+	test_bredrle_full("Mesh - Send queue - cancel all",
+			&mesh_tx_cancel_all,
+			setup_enable_mesh,
+			test_mesh_tx, 4);
+
+	test_bredrle_full("Mesh - Send queue - two completions",
+			&mesh_tx_two_completions,
+			setup_enable_mesh,
+			test_mesh_tx, 4);
+
+	test_bredrle_full("Mesh - Send queue - send in tear-down",
+			&mesh_tx_send_during_teardown,
+			setup_enable_mesh,
+			test_mesh_tx, 4);
+
+	test_bredrle_full("Mesh - Send coexist - instance remains",
+			&mesh_tx_coexist,
+			setup_mesh_coexist,
+			test_mesh_tx, 4);
+
+	test_bredrle50_full("Mesh - Send queue - cancel active - Ext Adv",
+			&mesh_tx_cancel_active,
+			setup_enable_mesh,
+			test_mesh_tx, 4);
+
+	test_bredrle50_full("Mesh - Send queue - cancel queued - Ext Adv",
+			&mesh_tx_cancel_queued,
+			setup_enable_mesh,
+			test_mesh_tx, 4);
+
+	test_bredrle50_full("Mesh - Send queue - cancel all - Ext Adv",
+			&mesh_tx_cancel_all,
+			setup_enable_mesh,
+			test_mesh_tx, 4);
+
+	test_bredrle50_full("Mesh - Send queue - two completions - Ext Adv",
+			&mesh_tx_two_completions,
+			setup_enable_mesh,
+			test_mesh_tx, 4);
+
+	test_bredrle50_full("Mesh - Send queue - send in tear-down - Ext Adv",
+			&mesh_tx_send_during_teardown,
+			setup_enable_mesh,
+			test_mesh_tx, 4);
+
+	test_bredrle50_full("Mesh - Send coexist - instance remains - Ext Adv",
+			&mesh_tx_coexist_ext,
+			setup_mesh_coexist,
+			test_mesh_tx, 4);
+
+	/*
+	 * Cancellation proven by holding the controller: the active request
+	 * cannot end on its own while its start is held, the queued one is
+	 * cancelled while the tear-down of the active one is held. Request
+	 * 2 and its Cancel on another socket must leave handle 1 alone.
+	 */
+	test_bredrle_full("Mesh - Send queue - cancel held start",
+			&mesh_tx_cancel_active_held,
+			setup_enable_mesh,
+			test_mesh_tx, 4);
+
+	test_bredrle_full("Mesh - Send queue - cancel held tear-down",
+			&mesh_tx_cancel_queued_held,
+			setup_enable_mesh,
+			test_mesh_tx, 4);
+
+	test_bredrle_full("Mesh - Send queue - cancel other socket",
+			&mesh_tx_cancel_other_socket,
+			setup_enable_mesh,
+			test_mesh_tx, 4);
+
+	test_bredrle50_full("Mesh - Send queue - cancel held start - Ext",
+			&mesh_tx_cancel_active_held,
+			setup_enable_mesh,
+			test_mesh_tx, 4);
+
+	test_bredrle50_full("Mesh - Send queue - cancel held tear-down - Ext",
+			&mesh_tx_cancel_queued_held,
+			setup_enable_mesh,
+			test_mesh_tx, 4);
+
+	test_bredrle50_full("Mesh - Send queue - cancel other socket - Ext",
+			&mesh_tx_cancel_other_socket,
+			setup_enable_mesh,
+			test_mesh_tx, 4);
+
+	/*
+	 * A rejected start (fault injection on the first hci_cmd_sync_queue()
+	 * of a Mesh Send); not run on kernels without fault injection.
+	 */
+	test_bredrle_full("Mesh - Send queue - rejected start",
+			&mesh_tx_rejected_start,
+			setup_enable_mesh,
+			test_mesh_tx, 6);
+
+	test_bredrle50_full("Mesh - Send queue - rejected start - Ext Adv",
+			&mesh_tx_rejected_start,
+			setup_enable_mesh,
+			test_mesh_tx, 6);
+
+	/* Power transitions and the removal of the controller */
+	test_bredrle_full("Mesh - Send power - off with active request",
+			&mesh_tx_power_off_active,
+			setup_enable_mesh,
+			test_mesh_tx, 6);
+
+	test_bredrle_full("Mesh - Send power - off with queued request",
+			&mesh_tx_power_off_queued,
+			setup_enable_mesh,
+			test_mesh_tx, 6);
+
+	test_bredrle_full("Mesh - Send power - off with held tear-down",
+			&mesh_tx_power_off_held,
+			setup_enable_mesh,
+			test_mesh_tx, 6);
+
+	test_bredrle_full("Mesh - Send power - off 300 ms, active request",
+			&mesh_tx_power_off_active_long,
+			setup_enable_mesh,
+			test_mesh_tx, 6);
+
+	test_bredrle_full("Mesh - Send power - off 300 ms, queued request",
+			&mesh_tx_power_off_queued_long,
+			setup_enable_mesh,
+			test_mesh_tx, 6);
+
+	test_bredrle50_full("Mesh - Send power - off 300 ms, active - Ext",
+			&mesh_tx_power_off_active_long,
+			setup_enable_mesh,
+			test_mesh_tx, 6);
+
+	test_bredrle50_full("Mesh - Send power - off 300 ms, queued - Ext",
+			&mesh_tx_power_off_queued_long,
+			setup_enable_mesh,
+			test_mesh_tx, 6);
+
+	test_bredrle50_full("Mesh - Send power - off with active request - Ext",
+			&mesh_tx_power_off_active,
+			setup_enable_mesh,
+			test_mesh_tx, 6);
+
+	test_bredrle50_full("Mesh - Send power - off with queued request - Ext",
+			&mesh_tx_power_off_queued,
+			setup_enable_mesh,
+			test_mesh_tx, 6);
+
+	test_bredrle50_full("Mesh - Send power - off with held tear-down - Ext",
+			&mesh_tx_power_off_held,
+			setup_enable_mesh,
+			test_mesh_tx, 6);
+
+	test_bredrle_full("Mesh - Send unregister - with backlog",
+			&mesh_tx_unregister_backlog,
+			setup_enable_mesh,
+			test_mesh_tx, 4);
+
+	test_bredrle_full("Mesh - Send unregister - held tear-down",
+			&mesh_tx_unregister_held,
+			setup_enable_mesh,
+			test_mesh_tx, 4);
+
+	test_bredrle50_full("Mesh - Send unregister - with backlog - Ext Adv",
+			&mesh_tx_unregister_backlog,
+			setup_enable_mesh,
+			test_mesh_tx, 4);
+
+	test_bredrle50_full("Mesh - Send unregister - held tear-down - Ext",
+			&mesh_tx_unregister_held,
+			setup_enable_mesh,
+			test_mesh_tx, 4);
+
+	/* The sending socket closed while the kernel holds its requests */
+	test_bredrle_full("Mesh - Send close - in held start",
+			&mesh_tx_close_in_start,
+			setup_enable_mesh,
+			test_mesh_tx, 6);
+
+	test_bredrle_full("Mesh - Send close - in held tear-down",
+			&mesh_tx_close_in_teardown,
+			setup_enable_mesh,
