From 0ca34eea2330359b77a310264eed12f68b2ac999 Mon Sep 17 00:00:00 2001
From: Iaroslav Voitovych <yaroslav.voytovych@gmail.com>
Date: Fri, 2 Oct 2026 03:57:09 +0200
Subject: [PATCH 2/2] Bluetooth: MGMT: complete the mesh transmission that was
 on air

mesh_send_done_sync() completes the head of hdev->mesh_pending when a
transmission is done. That is the packet that was sent only while the
queue is in order: after a Mesh Send Cancel of the in-flight handle the
head is the next, still unsent, packet, which is then reported with
Mesh Packet Complete without ever having been advertised (the one that
was on air was already completed by the cancel). bluetooth-meshd
matches the event to its transmissions by that handle and so sees the
second packet as transmitted when it was dropped.

Complete the mesh_tx that owns the advertising instance instead. Every
transmission uses the same instance number (le_num_of_adv_sets + 1) and
mesh_send_sync() records it only in the mesh_tx it actually started, so
the instance identifies the packet that was on air: a cancelled one has
already left the queue and a queued one still carries instance 0. This
restores the MGMT semantics of Mesh Packet Complete - it names the
handle whose transmission finished - and cancelling the in-flight
handle leaves the queued ones to be sent.

Fixes: b338d91703fa ("Bluetooth: Implement support for Mesh")
Cc: stable@vger.kernel.org
Signed-off-by: Iaroslav Voitovych <yaroslav.voytovych@gmail.com>
---
 net/bluetooth/mgmt.c | 21 +++++++++++++++++----
 1 file changed, 17 insertions(+), 4 deletions(-)

diff --git a/net/bluetooth/mgmt.c b/net/bluetooth/mgmt.c
index 143b9bc25744..fa641fd5247f 100644
--- a/net/bluetooth/mgmt.c
+++ b/net/bluetooth/mgmt.c
@@ -1092,7 +1092,7 @@ static void mesh_send_complete(struct hci_dev *hdev,
 
 static int mesh_send_done_sync(struct hci_dev *hdev, void *data)
 {
-	struct mgmt_mesh_tx *mesh_tx;
+	struct mgmt_mesh_tx *mesh_tx, *sent = NULL;
 	u8 instance = hdev->le_num_of_adv_sets + 1;
 
 	hci_dev_clear_flag(hdev, HCI_MESH_SENDING);
@@ -1110,10 +1110,23 @@ static int mesh_send_done_sync(struct hci_dev *hdev, void *data)
 
 	if (list_empty(&hdev->adv_instances))
 		hci_disable_advertising_sync(hdev);
-	mesh_tx = mgmt_mesh_next(hdev, NULL);
 
-	if (mesh_tx)
-		mesh_send_complete(hdev, mesh_tx, false);
+	/* Complete the transmission that was on air, not the head of the
+	 * queue: after a Mesh Send Cancel of the in-flight handle the head
+	 * is the next, still unsent, packet. Every transmission uses the
+	 * same instance number and mesh_send_sync() records it only in the
+	 * mesh_tx it started, so the instance identifies the one that was
+	 * sent; queued ones still carry 0.
+	 */
+	list_for_each_entry(mesh_tx, &hdev->mesh_pending, list) {
+		if (mesh_tx->instance == instance) {
+			sent = mesh_tx;
+			break;
+		}
+	}
+
+	if (sent)
+		mesh_send_complete(hdev, sent, false);
 
 	return 0;
 }
