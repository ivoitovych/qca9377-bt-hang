+/*
+ * Powered off (test_mesh_off): mesh_send() checks LE and the experimental
+ * feature but not power, so with the controller powered off and LE enabled
+ * a Mesh Send reaches hci_cmd_sync_queue(), which fails with -ENETDOWN
+ * because HCI_RUNNING is clear. The same assertions as the failed start,
+ * with the failing sends made while powered off instead of fail-nth.
+ * First recorded: Set Mesh Receiver while powered, the settings after Set
+ * Powered off (is LE kept), Set Mesh Receiver and Set LE while powered off.
+ */
+/*
+ * The reply to Set Powered off is sent from __mgmt_power_off(), before
+ * hci_dev_close_sync() clears HCI_RUNNING; on several CPUs a Mesh Send
+ * made at once can still be queued. The failing sends wait until the
+ * device flags (HCIGETDEVINFO) show HCI_RUNNING clear.
+ */
+typedef void (*mesh_off_next_t)(struct test_data *data);
+
+static mesh_off_next_t mesh_off_next_fn;
+static unsigned int mesh_off_polls;
+
+static gboolean mesh_off_poll(gpointer user_data)
+{
+	struct test_data *data = tester_get_data();
+	struct hci_dev_info di;
+
+	if (hci_devinfo(data->mgmt_index, &di) < 0) {
+		tester_warn("HCIGETDEVINFO failed: %s", strerror(errno));
+		data->mesh_off_poll_id = 0;
+		tester_test_failed();
+		return FALSE;
+	}
+
+	if (di.flags & (1 << HCI_RUNNING)) {
+		if (++mesh_off_polls > 100) {
+			tester_warn("HCI_RUNNING still set 1 s after Set "
+							"Powered off");
+			data->mesh_off_poll_id = 0;
+			tester_test_failed();
+			return FALSE;
+		}
+		return TRUE;
+	}
+
+	data->mesh_off_poll_id = 0;
+
+	tester_print("HCI_RUNNING clear at +%lld ms (after %u polls of 10 "
+			"ms following the Set Powered off reply)",
+			(long long) mesh_tx_now_ms(data), mesh_off_polls);
+
+	mesh_off_next_fn(data);
+
+	return FALSE;
+}
+
+static void mesh_off_wait_down(struct test_data *data, mesh_off_next_t next)
+{
+	mesh_off_polls = 0;
+	mesh_off_next_fn = next;
+
+	if (!mesh_off_poll(NULL))
+		return;
+
+	data->mesh_off_poll_id = g_timeout_add(10, mesh_off_poll, NULL);
+}
+
+static void mesh_fail_power_callback(uint8_t status, uint16_t length,
+			const void *param, void *user_data)
+{
+	struct test_data *data = tester_get_data();
+	struct mesh_fail *fail = &data->mesh_fail;
+	bool on = PTR_TO_UINT(user_data);
+	uint32_t settings = 0;
+
+	if (status == MGMT_STATUS_SUCCESS && length == sizeof(settings))
+		settings = get_le32(param);
+
+	tester_print("Set Powered %s at +%lld ms: %s (0x%02x), settings "
+			"0x%08x", on ? "on" : "off",
+			(long long) mesh_tx_now_ms(data), mgmt_errstr(status),
+			status, settings);
+
+	if (status != MGMT_STATUS_SUCCESS) {
+		tester_test_failed();
+		return;
+	}
+
+	fail->powered = on;
+
+	switch (fail->step) {
+	case MESH_FAIL_PROBE:
+		/* The first read after power on */
+		mesh_fail_read(data);
+		break;
+	case MESH_FAIL_REPEAT:
+		mesh_off_wait_down(data, mesh_fail_repeat_next);
+		break;
+	case MESH_FAIL_LAST:
+		mesh_fail_send(data, 4, false);
+		break;
+	case MESH_FAIL_CAPACITY:
+		break;
+	}
+}
+
+static void mesh_fail_power(struct test_data *data, bool on)
+{
+	uint8_t param = on ? 0x01 : 0x00;
+
+	tester_print("Sending Set Powered %s at +%lld ms", on ? "on" : "off",
+					(long long) mesh_tx_now_ms(data));
+
+	if (!mgmt_send(data->mgmt, MGMT_OP_SET_POWERED, data->mgmt_index,
+				sizeof(param), &param, mesh_fail_power_callback,
+				UINT_TO_PTR(on), NULL)) {
+		tester_warn("Failed to send Set Powered");
+		tester_test_failed();
+	}
+}
+
+static void mesh_off_le_callback(uint8_t status, uint16_t length,
+			const void *param, void *user_data)
+{
+	struct test_data *data = tester_get_data();
+	struct mesh_fail *fail = &data->mesh_fail;
+
+	fail->le_off = status;
+	if (status == MGMT_STATUS_SUCCESS && length == sizeof(uint32_t))
+		fail->settings_le = get_le32(param);
+
+	tester_print("Set LE on while powered off: %s (0x%02x), settings "
+			"0x%08x (LE %s, powered %s)", mgmt_errstr(status),
+			status, fail->settings_le,
+			fail->settings_le & MGMT_SETTING_LE ? "on" : "off",
+			fail->settings_le & MGMT_SETTING_POWERED ?
+								"yes" : "no");
+
+	if (status != MGMT_STATUS_SUCCESS ||
+				!(fail->settings_le & MGMT_SETTING_LE)) {
+		tester_warn("LE is not enabled while powered off");
+		tester_test_failed();
+		return;
+	}
+
+	mesh_fail_send(data, 0, true);
+}
+
+static void mesh_off_rx_off_callback(uint8_t status, uint16_t length,
+			const void *param, void *user_data)
+{
+	struct test_data *data = tester_get_data();
+	struct mesh_fail *fail = &data->mesh_fail;
+	static const uint8_t on = 0x01;
+
+	fail->rx_off = status;
+
+	tester_print("Set Mesh Receiver while powered off: %s (0x%02x)",
+					mgmt_errstr(status), status);
+
+	if (!mgmt_send(data->mgmt, MGMT_OP_SET_LE, data->mgmt_index,
+				sizeof(on), &on, mesh_off_le_callback, NULL,
+				NULL)) {
+		tester_warn("Failed to send Set LE");
+		tester_test_failed();
+	}
+}
+
+static void mesh_off_rx_off_send(struct test_data *data);
+
+static void mesh_off_power_off_callback(uint8_t status, uint16_t length,
+			const void *param, void *user_data)
+{
+	struct test_data *data = tester_get_data();
+	struct mesh_fail *fail = &data->mesh_fail;
+
+	if (status == MGMT_STATUS_SUCCESS && length == sizeof(uint32_t))
+		fail->settings_off = get_le32(param);
+
+	tester_print("Set Powered off at +%lld ms: %s (0x%02x), settings "
+			"0x%08x (LE %s, powered %s)",
+			(long long) mesh_tx_now_ms(data), mgmt_errstr(status),
+			status, fail->settings_off,
+			fail->settings_off & MGMT_SETTING_LE ? "on" : "off",
+			fail->settings_off & MGMT_SETTING_POWERED ?
+								"yes" : "no");
+
+	if (status != MGMT_STATUS_SUCCESS) {
+		tester_test_failed();
+		return;
+	}
+
+	fail->powered = false;
+
+	mesh_off_wait_down(data, mesh_off_rx_off_send);
+}
+
+static void mesh_off_rx_off_send(struct test_data *data)
+{
+	if (!mgmt_send(data->mgmt, MGMT_OP_SET_MESH_RECEIVER,
+				data->mgmt_index, sizeof(set_mesh_receiver_1),
+				set_mesh_receiver_1, mesh_off_rx_off_callback,
+				NULL, NULL)) {
+		tester_warn("Failed to send Set Mesh Receiver");
+		tester_test_failed();
+	}
+}
+
+static void mesh_off_power_off(struct test_data *data)
+{
+	static const uint8_t off = 0x00;
+
+	tester_print("Sending Set Powered off at +%lld ms",
+					(long long) mesh_tx_now_ms(data));
+
+	if (!mgmt_send(data->mgmt, MGMT_OP_SET_POWERED, data->mgmt_index,
+				sizeof(off), &off, mesh_off_power_off_callback,
+				NULL, NULL)) {
+		tester_warn("Failed to send Set Powered");
+		tester_test_failed();
+	}
+}
+
+static void mesh_off_rx_disable_callback(uint8_t status, uint16_t length,
+			const void *param, void *user_data)
+{
+	struct test_data *data = tester_get_data();
