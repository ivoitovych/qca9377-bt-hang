+		return;
+	}
+
+	memcpy(rx_disable, set_mesh_receiver_1, sizeof(rx_disable));
+	rx_disable[0] = 0x00;
+
+	if (!mgmt_send(data->mgmt, MGMT_OP_SET_MESH_RECEIVER,
+				data->mgmt_index, sizeof(rx_disable),
+				rx_disable, mesh_off_rx_disable_callback,
+				NULL, NULL)) {
+		tester_warn("Failed to send Set Mesh Receiver");
+		tester_test_failed();
+	}
+}
