+
+/*
+ * Removal during a Mesh Send (test_mesh_unreg). Needs a DIAGNOSTIC kernel
+ * whose mesh_send() sleeps inside hci_dev_lock() for
+ * bluetooth.diag_mesh_send_delay_ms: a child process sends the Mesh Send
+ * on a socket of its own and blocks in the kernel; meanwhile the vhci
+ * device is closed, hci_unregister_dev() sets HCI_UNREGISTER and then
+ * waits for hdev->lock with HCI_RUNNING still set, so the send's
+ * hci_cmd_sync_queue() fails with -ENODEV. The answer is the child's exit
+ * status; whether the request was freed shows only in kmemleak.
+ */
+#define MESH_UNREG_PARAM \
+	"/sys/module/bluetooth/parameters/diag_mesh_send_delay_ms"
+#define MESH_UNREG_DELAY_MS	1500
+#define MESH_UNREG_REMOVE_MS	150
+
+static bool mesh_unreg_delay(unsigned int ms)
+{
+	char buf[16];
+
+	snprintf(buf, sizeof(buf), "%u", ms);
+
+	return mesh_tx_write_file(MESH_UNREG_PARAM, buf);
+}
+
+static void mesh_unreg_child(uint16_t index)
+{
+	struct sockaddr_hci addr;
+	uint8_t buf[sizeof(struct mgmt_hdr) + sizeof(send_mesh_2)];
+	struct mgmt_hdr *hdr = (void *) buf;
+	uint8_t rbuf[512];
+	struct pollfd pfd;
+	int fd, n, i;
+
+	/* The inherited vhci descriptor would keep the controller alive
+	 * until this process exits: close everything but stdio.
+	 */
+	for (fd = 3; fd < 1024; fd++)
+		close(fd);
+
+	fd = socket(PF_BLUETOOTH, SOCK_RAW | SOCK_CLOEXEC, BTPROTO_HCI);
+	if (fd < 0)
+		_exit(0xfe);
+
+	memset(&addr, 0, sizeof(addr));
+	addr.hci_family = AF_BLUETOOTH;
+	addr.hci_dev = HCI_DEV_NONE;
+	addr.hci_channel = HCI_CHANNEL_CONTROL;
+
+	if (bind(fd, (struct sockaddr *) &addr, sizeof(addr)) < 0)
+		_exit(0xfd);
+
+	hdr->opcode = htobs(MGMT_OP_MESH_SEND);
+	hdr->index = htobs(index);
+	hdr->len = htobs(sizeof(send_mesh_2));
+	mesh_fail_pdu(buf + sizeof(*hdr), 0);
+
+	if (write(fd, buf, sizeof(buf)) != (ssize_t) sizeof(buf))
+		_exit(0xfc);
+
+	for (i = 0; i < 50; i++) {
+		struct mgmt_hdr *ev = (void *) rbuf;
+
+		pfd.fd = fd;
+		pfd.events = POLLIN;
+		pfd.revents = 0;
+
+		if (poll(&pfd, 1, 100) <= 0)
+			continue;
+
+		n = read(fd, rbuf, sizeof(rbuf));
+		if (n < (int) sizeof(*ev) + 3)
+			continue;
+
+		if (btohs(ev->opcode) != MGMT_EV_CMD_STATUS &&
+				btohs(ev->opcode) != MGMT_EV_CMD_COMPLETE)
+			continue;
+
+		if (get_le16(rbuf + sizeof(*ev)) != MGMT_OP_MESH_SEND)
+			continue;
+
+		_exit(rbuf[sizeof(*ev) + 2]);
+	}
+
+	_exit(0xff);
+}
+
+static void mesh_unreg_finish(struct test_data *data)
+{
+	int status = data->unreg_child_status;
+
+	if (!data->unreg_child_done || !data->unreg_index_gone)
+		return;
+
+	mesh_unreg_delay(0);
+
+	tester_print("Removal during a Mesh Send: the send was answered "
+			"0x%02x (%s)", status, status <= 0xff ?
+			mgmt_errstr(status) : "no answer");
+
+	if (status != MGMT_STATUS_FAILED) {
+		tester_warn("Expected Failed: the path under test was not "
+								"reached");
+		tester_test_failed();
+		return;
+	}
+
+	tester_test_passed();
+}
+
+static void mesh_unreg_child_exit(GPid pid, gint wait_status,
+							gpointer user_data)
+{
+	struct test_data *data = tester_get_data();
+
+	g_spawn_close_pid(pid);
+
+	data->unreg_child_done = true;
+	data->unreg_child_status = WIFEXITED(wait_status) ?
+					WEXITSTATUS(wait_status) : 0x100;
+
+	tester_print("Child %d done at +%lld ms, exit status 0x%02x", pid,
+				(long long) mesh_tx_now_ms(data),
+				data->unreg_child_status);
+
+	mesh_unreg_finish(data);
+}
+
+static void mesh_unreg_index_removed(struct test_data *data)
+{
+	tester_print("Index Removed during the Mesh Send at +%lld ms",
+				(long long) mesh_tx_now_ms(data));
+
+	data->unreg_index_gone = true;
+
+	mesh_unreg_finish(data);
+}
+
+static gboolean mesh_unreg_remove(gpointer user_data)
+{
+	struct test_data *data = tester_get_data();
+
+	tester_print("Closing the vhci device (controller removal) at "
+			"+%lld ms", (long long) mesh_tx_now_ms(data));
+
+	hciemu_unref(data->hciemu);
+	data->hciemu = NULL;
+
+	tester_print("vhci device closed at +%lld ms",
+				(long long) mesh_tx_now_ms(data));
+
+	return FALSE;
+}
+
+static void test_mesh_unreg(const void *test_data)
+{
+	struct test_data *data = tester_get_data();
+	pid_t pid;
+
+	data->mesh_tx_t0 = g_get_monotonic_time();
+
+	if (access(MESH_UNREG_PARAM, W_OK) < 0) {
+		tester_warn("Needs the diagnostic kernel (" MESH_UNREG_PARAM
+							"): not run");
+		tester_test_abort();
+		return;
+	}
+
+	if (!mesh_unreg_delay(MESH_UNREG_DELAY_MS)) {
+		tester_warn("Failed to write " MESH_UNREG_PARAM);
+		tester_test_failed();
+		return;
+	}
+
+	data->unreg_running = true;
+
+	fflush(stdout);
+	fflush(stderr);
+
+	pid = fork();
+	if (pid < 0) {
+		tester_warn("fork failed: %s", strerror(errno));
+		tester_test_failed();
+		return;
+	}
+
+	if (pid == 0)
+		mesh_unreg_child(data->mgmt_index);
+
+	data->unreg_pid = pid;
+	g_child_watch_add(pid, mesh_unreg_child_exit, NULL);
+	g_timeout_add(MESH_UNREG_REMOVE_MS, mesh_unreg_remove, NULL);
+
+	tester_print("Child %d sends a Mesh Send (kernel delay %u ms); the "
+			"controller is removed in %u ms", pid,
+			MESH_UNREG_DELAY_MS, MESH_UNREG_REMOVE_MS);
+}
