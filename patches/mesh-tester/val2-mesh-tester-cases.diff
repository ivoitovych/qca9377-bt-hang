+/*
+ * With the receiver kept on, the controller scans while the mesh packets
+ * are sent; without it, the transmissions are those of the failed start.
+ */
+static void mesh_off_rx_on_callback(uint8_t status, uint16_t length,
+			const void *param, void *user_data)
+{
+	struct test_data *data = tester_get_data();
+	struct mesh_fail *fail = &data->mesh_fail;
+	uint8_t rx_disable[sizeof(set_mesh_receiver_1)];
+
+	fail->rx_on = status;
+
+	tester_print("Set Mesh Receiver while powered: %s (0x%02x), kept %s",
+					mgmt_errstr(status), status,
+					fail->rx_keep ? "on" : "off");
+
+	if (fail->rx_keep) {
