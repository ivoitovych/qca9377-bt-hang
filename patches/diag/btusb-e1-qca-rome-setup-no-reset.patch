+		    le32_to_cpu(ver.ram_version));
 
 	for (i = 0; i < ARRAY_SIZE(qca_devices_table); i++) {
 		if (ver_rom == qca_devices_table[i].rom_version)
@@ -3678,8 +3688,13 @@
