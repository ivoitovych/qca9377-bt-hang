+/* Choosing the next entry by asking every open file is O(files) for each entry, so reading a journal of N
+ * entries in F files costs O(N x F) and grows with the square of the journal's size, as rotation adds files.
+ * Once a walk has been done, we therefore keep the archived files (which do not change any more), those
+ * that hold a candidate entry, in a priority queue ordered like the linear walk orders them (the same
+ * compare_locations(), ties by the position in the linear walk), so that taking the next entry costs
+ * O(log F): advance the file the last entry came from, push it back, pop the smallest. Files that are not
+ * archived (they may grow) are not queued; they are walked linearly on each call, as before. Any change to
+ * the set of files, any seek and any change of the matches drops the queue; the next walk is linear, and
+ * rebuilds it. */
+
+#ifndef HEAP_MIN_FILES
+#  define HEAP_MIN_FILES 16
+#endif
+
+static int heap_compare(const void *a, const void *b) {
+        const JournalFile *x = a, *y = b;
+        int r;
+
+        r = compare_locations(x->heap_journal, (JournalFile*) x, (JournalFile*) y);
+        if (x->heap_journal->heap_direction == DIRECTION_UP)
+                r = -r;
+        if (r != 0)
+                return r;
+
+        return CMP(x->heap_order, y->heap_order);
+}
+
+static void heap_build(sd_journal *j, direction_t direction, const void **files, unsigned n_files) {
+        _cleanup_(prioq_freep) Prioq *q = NULL;
+        _cleanup_free_ JournalFile **online = NULL;
+        size_t n_online = 0;
+
+        assert(j);
+
+        heap_drop(j);
+
+        if (n_files < HEAP_MIN_FILES || j->current_location.type != LOCATION_DISCRETE || !j->current_file)
+                return;
+
+        q = prioq_new(heap_compare);
+        online = new(JournalFile*, n_files);
+        if (!q || !online)
+                return;
+
+        j->heap_direction = direction;
+
+        for (unsigned i = 0; i < n_files; i++) {
+                JournalFile *f = (JournalFile*) files[i];
+
+                f->heap_order = i;
+                f->heap_journal = j;
+                f->heap_idx = PRIOQ_IDX_NULL;
+                f->in_heap = f->header->state == STATE_ARCHIVED;
+
+                if (!f->in_heap)
+                        online[n_online++] = f;
+                else if (f->location_type == LOCATION_SEEK) {
+                        if (prioq_put(q, f, &f->heap_idx) < 0)
+                                return;
+                } else if (f->last_direction != direction)
+                        /* Found nothing in this file yet, but only because the walk was the first one after
+                         * a seek: the linear walk looks again, so the file is not settled. */
+                        return;
+        }
+
+        j->heap = TAKE_PTR(q);
+        j->heap_online = TAKE_PTR(online);
+        j->n_heap_online = n_online;
+        j->heap_last = j->current_file;
+        j->heap_generation = j->files_generation;
+        j->heap_valid = true;
+}
+
+/* Returns 1 or 0 like real_journal_next(), or -EAGAIN if the caller has to do the linear walk. */
+static int heap_next(sd_journal *j, direction_t direction, usec_t ts) {
+        JournalFile *cf = ASSERT_PTR(j->heap_last), *best = NULL, *top, *new_file;
+        LocationType done = direction == DIRECTION_DOWN ? LOCATION_TAIL : LOCATION_HEAD;
+        Object *o;
+        int r;
+
+        /* Advance the file the last entry came from, and queue it again. */
+        if (cf->in_heap) {
+                r = next_beyond_location(j, cf, direction, ts);
+                if (r < 0) {
+                        log_debug_errno(r, "Can't iterate through %s, ignoring: %m", cf->path);
+                        remove_file_real(j, cf);
+                        return -EAGAIN;
+                }
+                if (r == 0)
+                        cf->location_type = done;
+                else if (prioq_put(j->heap, cf, &cf->heap_idx) < 0)
+                        goto drop;
+        }
+
+        /* The files that may grow, as in the linear walk. */
+        for (size_t i = 0; i < j->n_heap_online; i++) {
+                JournalFile *f = j->heap_online[i];
+
+                r = next_beyond_location(j, f, direction, ts);
+                if (r < 0) {
+                        log_debug_errno(r, "Can't iterate through %s, ignoring: %m", f->path);
+                        remove_file_real(j, f);
+                        return -EAGAIN;
+                }
+                if (r == 0) {
+                        f->location_type = done;
+                        continue;
+                }
+
+                if (best) {
+                        r = compare_locations(j, f, best);
+                        if (direction == DIRECTION_DOWN ? r >= 0 : r <= 0)
+                                continue;
+                }
+                best = f;
+        }
+
+        /* The queued files: skip the candidates that are the entry just returned again (copies of it in other
+         * files), as the linear walk does for every file. */
+        for (;;) {
+                int k;
+
+                top = prioq_peek(j->heap);
+                if (!top)
+                        break;
+
+                assert(top->location_type == LOCATION_SEEK);
+
+                k = compare_with_location(j, top, &j->current_location, j->current_file);
+                if (direction == DIRECTION_DOWN ? k > 0 : k < 0)
+                        break;
+
+                r = next_beyond_location(j, top, direction, ts);
+                if (r < 0) {
+                        log_debug_errno(r, "Can't iterate through %s, ignoring: %m", top->path);
+                        remove_file_real(j, top);
+                        return -EAGAIN;
+                }
+                if (r == 0) {
+                        prioq_remove(j->heap, top, &top->heap_idx);
+                        top->location_type = done;
+                        continue;
+                }
+                prioq_reshuffle(j->heap, top, &top->heap_idx);
+        }
+
+        new_file = top;
+        if (best) {
+                if (!top)
+                        new_file = best;
+                else {
+                        r = compare_locations(j, best, top);
+                        if (r == 0 ? best->heap_order < top->heap_order : (direction == DIRECTION_DOWN ? r < 0 : r > 0))
+                                new_file = best;
+                }
+        }
+        if (!new_file)
+                return 0;
+
+        if (new_file == top)
+                assert_se(prioq_pop(j->heap) == top);
+
+        r = journal_file_move_to_object(new_file, OBJECT_ENTRY, new_file->current_offset, &o);
+        if (r < 0)
+                goto drop;
+
+        set_location(j, new_file, o);
+        j->heap_last = new_file;
+        return 1;
+
+drop:
+        /* Let the linear walk deal with it. */
+        heap_drop(j);
+        return -EAGAIN;
+}
