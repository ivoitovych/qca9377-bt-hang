From 694d9cba194fd5135570c0c46cad771a8cecede9 Mon Sep 17 00:00:00 2001
From: Iaroslav Voitovych <yaroslav.voytovych@gmail.com>
Date: Tue, 13 Oct 2026 06:20:29 +0200
Subject: [PATCH BlueZ] emulator: Avoid variable length array in send_cmd

send_cmd() is only called with one or two iovec entries, so size the
array for that bound instead of using a variable length array, and
assert the bound: more entries would overflow the array, and none
would make iov[i - 1] invalid.

This also removes the smatch warning "Variable length array is used"
for emulator/btdev.c.
---
 emulator/btdev.c | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/emulator/btdev.c b/emulator/btdev.c
index 0c556c985..7467ba5d0 100644
--- a/emulator/btdev.c
+++ b/emulator/btdev.c
@@ -17,6 +17,7 @@
 #include <stdio.h>
 #include <ctype.h>
 #include <stdlib.h>
+#include <assert.h>
 #include <string.h>
 #include <alloca.h>
 #include <sys/uio.h>
@@ -472,14 +473,18 @@ static void send_packet(struct btdev *btdev, const struct iovec *iov,
 	btdev->send_handler(iov, iovlen, btdev->send_data);
 }
 
+#define SEND_CMD_IOV_MAX 2
+
 static void send_cmd(struct btdev *btdev, uint8_t evt, uint16_t opcode,
 					const struct iovec *iov, int iovlen)
 {
 	struct bt_hci_evt_hdr hdr;
-	struct iovec iov2[2 + iovlen];
+	struct iovec iov2[2 + SEND_CMD_IOV_MAX];
 	uint8_t pkt = BT_H4_EVT_PKT;
 	int i;
 
+	assert(iovlen > 0 && iovlen <= SEND_CMD_IOV_MAX);
+
 	util_debug(btdev->debug_callback, btdev->debug_data,
 				"event 0x%02x opcode 0x%04x", evt, opcode);
 

