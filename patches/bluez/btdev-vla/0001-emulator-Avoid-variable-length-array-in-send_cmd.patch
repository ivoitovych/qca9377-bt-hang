From 917fe4d8ade8df568bfe3b2509c432198fad9a45 Mon Sep 17 00:00:00 2001
From: Iaroslav Voitovych <yaroslav.voytovych@gmail.com>
Date: Sat, 10 Oct 2026 12:13:43 +0000
Subject: [PATCH BlueZ] emulator: Avoid variable length array in send_cmd

smatch warns on the iovec array of send_cmd():

  emulator/btdev.c:479:29: warning: Variable length array is used.

The CI reports it on every patch that touches btdev.c. Both callers
pass at most two entries, cmd_complete() the Command Complete
parameters and the return parameters and cmd_status() the Command
Status parameters, so size the array for two entries plus the packet
type and the event header, and return instead of writing past it.
---
 emulator/btdev.c | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/emulator/btdev.c b/emulator/btdev.c
index e00f78288..1dd1209c7 100644
--- a/emulator/btdev.c
+++ b/emulator/btdev.c
@@ -472,14 +472,19 @@ static void send_packet(struct btdev *btdev, const struct iovec *iov,
 	btdev->send_handler(iov, iovlen, btdev->send_data);
 }
 
+#define SEND_CMD_IOV_MAX 2
+
 static void send_cmd(struct btdev *btdev, uint8_t evt, uint16_t opcode,
 					const struct iovec *iov, int iovlen)
 {
 	struct bt_hci_evt_hdr hdr;
-	struct iovec iov2[2 + iovlen];
+	struct iovec iov2[2 + SEND_CMD_IOV_MAX];
 	uint8_t pkt = BT_H4_EVT_PKT;
 	int i;
 
+	if (iovlen > SEND_CMD_IOV_MAX)
+		return;
+
 	util_debug(btdev->debug_callback, btdev->debug_data,
 				"event 0x%02x opcode 0x%04x", evt, opcode);
 

