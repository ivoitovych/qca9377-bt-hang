#!/bin/bash
# bt-usbmon — capture the USB transport under the Bluetooth controller.
#
# WHY THIS EXISTS. BT-1 is established at the HCI layer while USB remains
# enumerated. USB-level errors and disappearance have also been observed, but
# so far only downstream of reset/rebind/reload interventions; whether they are
# part of the untreated fault is unresolved. When USB stops answering, the
# kernel logs only
#
#     usb 3-3: device descriptor read/64, error -110
#     usb 3-3: device not accepting address 2, error -62
#
# and the device may leave the bus. Those lines say a request was not answered;
# they do not say what was actually on the wire — whether the device NAKs forever,
# STALLs, returns a short descriptor, or goes electrically silent. For a report
# that distinction is evidence needed to separate untreated progression from
# the effects of an intervention.
#
# usbmon records every URB submission and completion on the bus, which is
# precisely that missing layer. Captured as pcap so it opens in Wireshark,
# which decodes both the USB and the embedded HCI framing.
#
# VOLUME. The controller is a full-speed (12 Mbit/s) device and most of its
# traffic is small interrupt and bulk transfers. Capture is still rotated and
# capped, and the free-space floor is honoured, because an unbounded capture on
# a working laptop is a way to fill a root filesystem.
#
# Usage: bt-usbmon   (runs in the foreground; managed by bt-usbmon.service)

set -uo pipefail

DIR="${BT_USBMON_DIR:-/var/log/bt-health/usbmon}"
VID="${BT_VID:-13d3}"
PID="${BT_PID:-3503}"
MAX_MB="${BT_USBMON_MAX_MB:-64}"      # rotate at this size
KEEP="${BT_USBMON_KEEP:-60}"          # retain this many files (~3.8 GB)
MIN_FREE_GB="${BT_USBMON_MIN_FREE_GB:-15}"
GAPLOG="${BT_USBMON_GAPLOG:-$DIR/gaps.log}"   # when capture was NOT running

log() { echo "$*"; }

# --check: see bt-trace. Same command, same reason — and here the "device not
# present" path IDLES FOREVER by design (a clean exit would respawn under
# Restart=always and fill the journal), so without this there is no way to ask
# the daemon what it resolved without waiting on it.
CHECK=0
case "${1:-}" in
    --check) CHECK=1 ;;
    "") ;;
    *) log "bt-usbmon: unknown argument: $1"; exit 1 ;;
esac

mkdir -p "$DIR"

# --- which USB bus is the controller on? -----------------------------------
# usbmon instances are per-bus. Capturing every bus would multiply the volume
# for no benefit, so resolve the controller's own bus number.
find_bus() {
    local d
    for d in "${BT_SYSFS_USB:-/sys/bus/usb/devices}"/*; do
        [[ -f "$d/idVendor" && -f "$d/idProduct" ]] || continue
        if [[ "$(<"$d/idVendor")" == "$VID" && "$(<"$d/idProduct")" == "$PID" ]]; then
            cat "$d/busnum" 2>/dev/null
            return 0
        fi
    done
    return 1
}

modprobe usbmon 2>/dev/null

BUS=$(find_bus)
if [[ -z "${BUS:-}" ]]; then
    # The device is absent — which is itself the state this investigation cares
    # about. Fall back to the bus recorded at install time, if known, so the
    # capture is running when the device comes back after a cold boot.
    BUS="${BT_USBMON_BUS:-}"
    if [[ -z "$BUS" ]]; then
        log "controller $VID:$PID not present and no BT_USBMON_BUS set — nothing to capture"
        (( CHECK )) && exit 0
        # Idle rather than exit 0: under Restart=always a clean exit respawns
        # this every RestartSec forever, filling the journal with the same line.
        # `sleep 3600` in the FOREGROUND makes this unstoppable. bash defers a
        # trapped signal until the running foreground command returns, so a
        # SIGTERM arriving here waits up to an hour — `systemctl stop` would
        # hang until TimeoutStopSec expired and the unit would be SIGKILLed.
        # `sleep & wait` is interruptible: the trap runs the moment TERM lands.
        while :; do sleep 3600 & wait $!; done
    fi
    log "controller absent; using configured bus $BUS"
fi

IFACE="usbmon${BUS}"
USBMON_DEBUGFS="${BT_USBMON_DEBUGFS:-/sys/kernel/debug/usb/usbmon}"
if [[ ! -e "$USBMON_DEBUGFS/${BUS}u" ]]; then
    log "ERROR: ${IFACE} not available (is debugfs mounted and usbmon loaded?)"
    exit 1
fi

prune() {
    local n f
    n=$(ls -1 "$DIR"/usbmon-*.pcap 2>/dev/null | wc -l)
    if (( n > KEEP )); then
        ls -1t "$DIR"/usbmon-*.pcap 2>/dev/null | tail -n +$((KEEP + 1)) | while read -r f; do
            log "pruning $(basename "$f")"
            rm -f "$f"
        done
    fi
    # Free-space floor, enforced regardless of KEEP: a retention count is a
    # guess about file size, and this is the check that cannot be wrong.
    local free oldest
    while true; do
        free=$(df -BG --output=avail "$DIR" | tail -1 | tr -dc '0-9')
        (( free < MIN_FREE_GB )) || break
        oldest=$(ls -1t "$DIR"/usbmon-*.pcap 2>/dev/null | tail -1)
        [[ -n "$oldest" ]] || { log "ERROR: under ${MIN_FREE_GB}GB free with nothing left to prune"; break; }
        # Never delete the file being written: tcpdump keeps the unlinked
        # inode open, so the space would not be reclaimed anyway and the loop
        # would then eat every OTHER file while freeing nothing.
        if [[ "$oldest" == "${CURRENT:-}" ]]; then
            log "ERROR: only the live capture remains and the floor is still breached"
            break
        fi
        log "low disk (${free}GB free): pruning $(basename "$oldest")"
        rm -f "$oldest"
    done
}

if (( CHECK )); then
    log "bt-usbmon --check (nothing will be captured)"
    log "  interface      $IFACE (device $VID:$PID, bus $BUS)"
    log "  directory      $DIR"
    log "  rotate at      ${MAX_MB}MB"
    log "  retain         $KEEP file(s), floor ${MIN_FREE_GB}GB"
    log "  captures held  $(ls -1 "$DIR"/usbmon-*.pcap 2>/dev/null | wc -l)"
    prune
    log "bt-usbmon --check complete"
    exit 0
fi

log "bt-usbmon starting on $IFACE (device $VID:$PID, bus $BUS)"
log "  rotate=${MAX_MB}MB keep=$KEEP max~$((MAX_MB * KEEP / 1024))GB floor=${MIN_FREE_GB}GB"

prune

# REVIEWED-KEEP 2026-08-15T1752Z 2.3: supervise-and-rotate, never tcpdump -C
# -W (a ring, not an exit) — and the floor loop must never delete the file
# being written (tcpdump holds the unlinked inode; see prune()).
# ROTATION IS DONE HERE, NOT BY tcpdump. The first version used `-C $MAX_MB
# -W 1` and relied on tcpdump EXITING at the size limit so this loop could
# start a fresh timestamped file. That is not what -C with -W does: it is a
# RING — with -W 1, tcpdump overwrites its single file from the beginning and
# never exits. Consequences of the old code, on any long-running boot: the
# loop body never advanced, prune() and the free-space floor never ran again,
# retention silently collapsed from KEEP files to one 64 MB ring, and older
# USB history needed to interpret the post-HCI trajectory was destroyed at every wrap.
# So this supervises tcpdump the way bt-trace supervises btmon: run it with a
# plain -w, poll the file size, and rotate by restarting it. The ~1 s gap per
# rotation is logged-by-construction (the timestamps in the filenames) and is
# the price of retention that actually retains.
CURRENT=""
TPID=""

start_capture() {
    CURRENT="$DIR/usbmon-$(date +%Y%m%d-%H%M%S).pcap"
    # -Z root: Ubuntu's tcpdump drops privileges to the unprivileged "tcpdump"
    # user as soon as the capture handle is open, and then cannot create its own
    # output file in a root-owned directory. It reports "Permission denied" and
    # exits 1, which under Restart=always looks like a capture loop rather than
    # a permissions problem. Keeping it as root is correct here: the capture
    # directory must stay root-only, because USB traffic to a Bluetooth
    # controller carries link keys.
    tcpdump -i "$IFACE" -s 0 -w "$CURRENT" -Z root >/dev/null 2>&1 &
    TPID=$!
    log "capturing to $(basename "$CURRENT")"
}

cleanup() {
    [[ -n "$TPID" ]] && kill "$TPID" 2>/dev/null
    wait "$TPID" 2>/dev/null
    log "stopped"
    exit 0
}
trap cleanup TERM INT

start_capture
CHECK_SEC="${BT_USBMON_CHECK_SEC:-30}"
while true; do
    sleep "$CHECK_SEC"
    if ! kill -0 "$TPID" 2>/dev/null; then
        wait "$TPID" 2>/dev/null; rc=$?
        log "tcpdump exited (rc=${rc:-?}) — restarting in 5s"
        # Evidence that admits when it was not looking — same contract as
        # bt-trace's gap log. A crash hole here can be up to CHECK_SEC+5s wide.
        # The bound is computed with awk, not with $(( )). Bash arithmetic is
        # integer-only, so a fractional BT_USBMON_CHECK_SEC made this expansion
        # fail, the printf never ran, and the gap record silently disappeared —
        # in the one file whose job is to admit when the capture was not
        # looking. A gap log that drops entries under some settings is worse
        # than none, because its silence reads as coverage.
        gap_bound=$(awk -v c="$CHECK_SEC" 'BEGIN { printf "%g", c + 5 }')
        printf '%s\ttcpdump-exit\trc=%s\tgap<=%ss\n' \
            "$(date -Iseconds)" "${rc:-?}" "$gap_bound" >> "$GAPLOG" 2>/dev/null
        # Interruptible, for the reason the idle loops are: bash defers a
        # trapped signal until the running foreground command returns, so a
        # SIGTERM landing in this backoff waited out the full five seconds
        # before cleanup ran. Minor next to an hour, and the same defect.
        sleep 5 & wait $!
        prune
        start_capture
        continue
    fi
    sz=$(( $(stat -c %s "$CURRENT" 2>/dev/null || echo 0) / 1024 / 1024 ))
    if (( sz >= MAX_MB )); then
        log "rotating at ${sz}MB"
        kill "$TPID" 2>/dev/null; wait "$TPID" 2>/dev/null
        printf '%s\trotate\tgap<1s\n' "$(date -Iseconds)" >> "$GAPLOG" 2>/dev/null
        prune
        start_capture
    fi
done
