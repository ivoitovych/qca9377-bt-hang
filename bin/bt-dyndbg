#!/bin/bash
# bt-dyndbg — turn on the kernel's built-in Bluetooth debug statements.
#
# The btusb driver and the HCI core ship hundreds of pr_debug() sites that are
# compiled in but switched off. They are the driver's own account of what it
# decided and why — exactly the layer this investigation has been reasoning
# about indirectly, from its side effects, for eighteen phases.
#
# WHY NOT SIMPLY ENABLE EVERYTHING:
# two files would drown the rest and, worse, change what is being measured.
#
#   hci_event.c   196 sites, one or more per received HCI event
#   l2cap_core.c  168 sites, one or more per L2CAP packet — during A2DP
#                 playback that is hundreds of lines per second
#
# The failure under investigation is a timing-sensitive one: the controller
# stops answering within a window of tens of seconds. Logging that adds
# meaningful work to the receive path risks moving that window, which would
# make every measurement taken with it enabled incomparable to the baseline
# taken without. So the per-packet files stay off by default and the
# command-and-connection-level files go on:
#
#   btusb.c     27 sites   driver decisions: setup, reset, suspend, URB errors
#   hci_core.c  85 sites   command submission, timeout handling, device state
#   hci_sync.c  60 sites   the synchronous request machinery that times out
#   hci_conn.c  42 sites   connection setup and teardown
#
# Usage:
#   bt-dyndbg on            enable the default (command-level) set
#   bt-dyndbg on --packets  also enable hci_event.c and l2cap_core.c
#   bt-dyndbg off           disable every Bluetooth debug site
#   bt-dyndbg status        show how many sites are currently enabled

set -uo pipefail

# BT_DYNDBG_CTL defaults to the real debugfs control file. The seam exists
# because WHICH sites this tool enables is a measurement-validity question, not
# a convenience: the header spends thirty lines on it, and the answer was wrong
# twice — first at file granularity, then again for four functions that do not
# look per-packet from their names and produced 98% of one boot's output. A
# fake control file is the only way to assert the selection without a kernel.
CTL="${BT_DYNDBG_CTL:-/sys/kernel/debug/dynamic_debug/control}"
DEFAULT_FILES=(btusb.c hci_core.c hci_sync.c hci_conn.c)

# Per-packet functions inside the files above, switched back OFF after the file
# is enabled.
#
# WHY THIS LIST EXISTS. Excluding hci_event.c and l2cap_core.c was not enough.
# hci_core.c also contains the transmit scheduler — hci_tx_work, hci_sched_*,
# hci_chan_sent, hci_acldata_packet — which runs per packet, and btusb.c
# contains the URB completion handlers, which run per transfer. Enabling those
# two files therefore reinstated exactly the per-packet flood the exclusion was
# meant to avoid: measured at 1,561,719 kernel lines in 16 minutes (~5.8 GB/h),
# which would have exhausted the 16 GB journal cap in under three hours and
# begun rotating away the evidence the logging exists to preserve.
#
# "File" was the wrong granularity. Volume tracks the call site's position in
# the data path, not which file it happens to live in.
#
# Losing the per-URB lines costs nothing: usbmon already records that layer as
# compact binary pcap (tens of KB where this was tens of MB), so the transport
# view survives in a better form.
NOISY_FUNCS=(
    hci_tx_work hci_sched_acl hci_sched_acl_pkt hci_sched_sco hci_sched_le
    hci_sched_iso hci_chan_sent hci_low_sent hci_prio_recalculate
    hci_queue_acl hci_queue_iso hci_acldata_packet hci_scodata_packet
    hci_isodata_packet hci_send_acl hci_send_sco hci_send_iso
    btusb_tx_complete btusb_isoc_complete btusb_isoc_tx_complete
    btusb_bulk_complete btusb_intr_complete btusb_diag_complete
    btusb_send_frame
    # Second pass, found by measuring rather than by reading names. These four
    # produced 189,274 of the 193,506 lines in one boot — 98% — and none of
    # them look per-packet from the function name alone:
    #   hci_rx_work              once per received HCI packet ("Event packet")
    #   hci_send_frame           once per transmitted packet ("type %d len %d")
    #   hci_conn_enter_active_mode  once per ACL packet, to exit sniff mode
    #   hci_conn_idle            the matching idle transition
    # The lesson is the same one that produced this list: the only reliable way
    # to find a hot debug site is to count what the log actually contains.
    hci_rx_work hci_send_frame hci_conn_enter_active_mode hci_conn_idle
)
PACKET_FILES=(hci_event.c l2cap_core.c)
ALL_FILES=(btusb.c hci_core.c hci_sync.c hci_conn.c hci_event.c l2cap_core.c
           mgmt.c sco.c l2cap_sock.c hci_sock.c hci_sysfs.c btqca.c)

[[ -w "$CTL" ]] || { echo "bt-dyndbg: $CTL not writable (need root, and debugfs mounted)" >&2; exit 1; }

# APPEND, not truncate. Each write to the debugfs control file is a command
# and the file has no truncate operation, so `>` and `>>` are identical against
# the real target. They are not identical against a regular file, which is what
# a test can supply: `>` would leave only the last command of the run. Writing
# with `>>` costs nothing in production and makes the selection observable.
ctl_write() { printf '%s\n' "$*" >> "$CTL" 2>/dev/null; }

set_files() {
    local flag="$1"; shift
    local f n=0
    for f in "$@"; do
        if ctl_write "file $f $flag"; then
            n=$((n + 1))
        fi
    done
    echo "$n"
}

count_enabled() {
    # A site is enabled when its flag field is anything other than "=_".
    # Match on the source path, not on a file-name alternation: an alternation
    # like (btusb|hci_)\.c silently matches only the branches that happen to be
    # complete file names, and undercounts everything else.
    grep -cE '^(drivers|net)/bluetooth/[a-z0-9_]+\.c:[0-9]+ .* =[a-z]+ ' "$CTL" 2>/dev/null || true
}

case "${1:-status}" in
    on)
        files=("${DEFAULT_FILES[@]}")
        if [[ "${2:-}" == "--packets" ]]; then
            files+=("${PACKET_FILES[@]}")
            echo "bt-dyndbg: INCLUDING per-packet files — expect high volume and"
            echo "           be aware this may perturb the timing being measured."
        fi
        n=$(set_files +p "${files[@]}")
        echo "bt-dyndbg: enabled debug in $n file(s): ${files[*]}"

        # Order matters: files first, then suppress the per-packet functions
        # inside them. Doing it the other way round would re-enable them.
        if [[ "${2:-}" != "--packets" ]]; then
            q=0
            for fn in "${NOISY_FUNCS[@]}"; do
                ctl_write "func $fn -p" && q=$((q + 1))
            done
            echo "bt-dyndbg: suppressed $q per-packet function(s) (use --packets to keep them)"
        fi

        echo "bt-dyndbg: $(count_enabled) site(s) now active"
        echo "bt-dyndbg: output goes to the kernel log — journalctl -k -f"  # SEAM-ADVICE
        ;;
    off)
        n=$(set_files -p "${ALL_FILES[@]}")
        echo "bt-dyndbg: disabled debug in $n file(s)"
        echo "bt-dyndbg: $(count_enabled) site(s) still active"
        ;;
    status)
        echo "enabled sites: $(count_enabled)"
        for f in "${ALL_FILES[@]}"; do
            tot=$(grep -c "^[^ ]*$f:" "$CTL" 2>/dev/null || true)
            (( tot == 0 )) && continue
            on=$(awk -v f="$f" '$1 ~ f":" && / =[a-z]+/ {n++} END {print n+0}' "$CTL")
            printf '  %-14s %4s / %-4s enabled\n' "$f" "$on" "$tot"
        done
        ;;
    *)
        sed -n '2,32p' "$0"
        ;;
esac
