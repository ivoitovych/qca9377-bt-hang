#!/bin/bash
# bt-hang-watchdog — recover a wedged QCA9377 (ROME) Bluetooth controller.
#
# Why this exists:
#   USB 13d3:3503 appears not to be matched by btusb's vendor quirks table, so
#   it binds via the generic USB-Bluetooth-class rule with driver_info = 0 and
#   never receives hdev->reset = btusb_qca_reset(), the callback that
#   hci_cmd_timeout() invokes on the FIRST HCI command timeout (no threshold).
#   Measured on the affected host: 287 "tx timeout" events across 34 boots,
#   0 automatic reset attempts.
#
#   This script is a userspace recovery proxy for that missing handler. Its
#   timing and USB call path differ from the kernel callback.
#
# Timing matters. What is measured (see docs/issues.md BT-1, EX-016/EX-018):
#   stage 1 — HCI unresponsive, USB still healthy. A USERSPACE reset issued
#             11 s or more after the first timeout has failed five for five;
#             the one reset issued BEFORE any timeout recovered the controller.
#   USB-absent outcome — observed only after reset/rebind/reload. A full
#             power-off has recovered it; whether a warm reboot can is untested
#             (EX-017/EX-019). Reset may help or harm; its sign is unmeasured.
#   Natural progression from HCI non-response to USB absence has NEVER been
#   observed without an intervention in between (EX-018); uncensored HCI-only
#   windows have run 72 minutes and 6.5 hours with no USB-level error.
#   Acting early is the point — and this watchdog's reaction time is itself a
#   sampling rule (HISTORY Phase 25): its resets end the windows it acts on.

set -uo pipefail

VID="${BT_VID:-13d3}"          # QCA9377 BT (IMC Networks)
PID="${BT_PID:-3503}"
THRESHOLD="${BT_THRESHOLD:-3}" # timeouts inside WINDOW before acting
WINDOW="${BT_WINDOW:-60}"      # seconds
COOLDOWN="${BT_COOLDOWN:-180}" # min seconds between recovery attempts
MAX_FAILS="${BT_MAX_FAILS:-3}" # give up after this many CONFIRMED failures
VERBOSE="${BT_VERBOSE:-0}"     # 1 = log every detected signal and window state
EARLY="${BT_EARLY:-0}"                        # 1 = also act on audio-teardown heuristics
# Default 1 preserves the deliberately aggressive, opt-in mitigation behaviour.
# It is NOT a probability claim: boot-level historical ratios did not establish
# these signals as predictors, and an early intervention destroys the
# counterfactual that would tell us whether BT-1 was imminent. Experiment mode
# disables this path; mitigation mode accepts an occasional unnecessary reset.
EARLY_THRESHOLD="${BT_EARLY_THRESHOLD:-1}"    # early signals before intervening
EARLY_WINDOW="${BT_EARLY_WINDOW:-90}"         # seconds

log() { echo "$*"; }           # stdout is captured by journald
vlog() { (( VERBOSE )) && echo "$*"; return 0; }

# --- capability probe ------------------------------------------------------
# hci_alive() needs a way to ask the controller a question. Without one we can
# still recover, we just cannot confirm it worked — and must NOT then count
# every attempt as a failure, or the watchdog disables itself while healthy.
PROBE=none
if command -v hciconfig >/dev/null 2>&1; then
    PROBE=hciconfig
elif command -v btmgmt >/dev/null 2>&1; then
    PROBE=btmgmt
fi

# --- helpers ---------------------------------------------------------------

# Locate the BT device by VID:PID. Echoes the sysfs name (e.g. "3-3").
find_usb_dev() {
    local d
    for d in /sys/bus/usb/devices/*; do
        [[ -f "$d/idVendor" && -f "$d/idProduct" ]] || continue
        if [[ "$(<"$d/idVendor")" == "$VID" && "$(<"$d/idProduct")" == "$PID" ]]; then
            basename "$d"
            return 0
        fi
    done
    return 1
}

# Resolve the hci name belonging to OUR usb device, not merely the first
# adapter in the system. A spare USB dongle plugged in while the QCA is wedged
# is frequently hci0, and probing that would report the wrong radio healthy.
hci_for_dev() {
    local dev="$1" p
    for p in /sys/bus/usb/devices/"$dev"/*/bluetooth/hci*; do
        [[ -e "$p" ]] || continue
        basename "$p"
        return 0
    done
    return 1
}

# 0 = responds, 1 = does not respond, 2 = cannot tell (no probe tool / no hci).
# Presence in sysfs is NOT aliveness: during the hang the interface stays
# UP RUNNING while the firmware answers nothing.
hci_alive() {
    local dev h idx
    dev=$(find_usb_dev) || return 1          # off the bus == definitely dead
    h=$(hci_for_dev "$dev") || return 1      # enumerated but no hci yet
    case "$PROBE" in
        hciconfig) timeout 6 hciconfig "$h" name >/dev/null 2>&1 && return 0 || return 1 ;;
        btmgmt)    idx="${h#hci}"
                   timeout 6 btmgmt --index "$idx" info >/dev/null 2>&1 && return 0 || return 1 ;;
        *)         return 2 ;;
    esac
}

# USBDEVFS_RESET ioctl — a proxy, not the operation usb_queue_reset_device()
# performs. This reaches usb_reset_device() synchronously through usbfs, whereas
# the kernel callback queues an interface reset in another context.
usbfs_reset() {
    local dev="$1" b n
    b=$(<"/sys/bus/usb/devices/$dev/busnum") || return 1
    n=$(<"/sys/bus/usb/devices/$dev/devnum") || return 1
    python3 - "$b" "$n" <<'PYEOF'
import fcntl, os, sys
USBDEVFS_RESET = 0x5514          # _IO('U', 20)
bus, dev = int(sys.argv[1]), int(sys.argv[2])
path = "/dev/bus/usb/%03d/%03d" % (bus, dev)
# os.open without O_CREAT: if the device vanished between find_usb_dev() and
# here — exactly the stage-1 -> stage-2 transition this races — fail cleanly
# instead of creating a bogus regular file on devtmpfs that would later
# collide with the real node when the device re-enumerates.
fd = os.open(path, os.O_WRONLY)
try:
    fcntl.ioctl(fd, USBDEVFS_RESET, 0)
finally:
    os.close(fd)
PYEOF
}

# Best-effort desktop notification; never allowed to affect control flow.
notify() {
    local msg="$1" u bus
    while read -r u; do
        [[ -n "$u" ]] || continue
        bus="/run/user/$(id -u "$u" 2>/dev/null)/bus"
        [[ -S "$bus" ]] || continue
        timeout 5 sudo -u "$u" \
            DBUS_SESSION_BUS_ADDRESS="unix:path=$bus" \
            notify-send -u critical "Bluetooth" "$msg" >/dev/null 2>&1
    done < <(loginctl list-sessions --no-legend 2>/dev/null | awk '{print $3}' | sort -u)
    return 0
}

# --- recovery --------------------------------------------------------------
# Returns 0 = recovered, 1 = confirmed failure, 2 = attempted but unverifiable.

recover() {
    local context="${1:-confirmed}" dev rc
    if ! dev=$(find_usb_dev); then
        log "FATAL: $VID:$PID is no longer on the USB bus."
        log "       The controller is in the observed USB-absent state. No software"
        log "       recovery has succeeded there. A full power-off recovers it;"
        log "       whether a warm reboot can is untested (EX-017)."
        notify "Bluetooth controller is absent from USB. A full power-off is the demonstrated recovery."
        # Close the boot's auto-trial here rather than leaving it to the
        # shutdown hook. Both would classify it as a hang, but only this one
        # records the duration and the surrounding state at the moment it
        # happened; by shutdown the machine may have sat dead for hours, which
        # would put a meaningless number in the results file.
        if command -v bt-trial >/dev/null 2>&1; then
            bt-trial hang >/dev/null 2>&1 && log "  auto-trial closed as HANG"
        fi
        return 1
    fi

    log "Recovering Bluetooth controller at $dev ..."
    systemctl stop bluetooth >/dev/null 2>&1
    sleep 1

    # Step 1: USB device reset. NOTE: this is a proxy for btusb_qca_reset(), not
    # an equivalent. The kernel would act at +0 s inside hci_cmd_timeout(); this
    # fires whenever the journal reader gets here, measured at +11 s to +33 s.
    if usbfs_reset "$dev" 2>/dev/null; then
        log "  USBDEVFS_RESET issued"
    else
        log "  USBDEVFS_RESET failed"
    fi
    sleep 6

    # Step 2: escalate to full re-enumeration unless we can confirm it worked.
    # With no probe available we always escalate — skipping it on an unverified
    # guess is how the wrong radio gets declared healthy.
    hci_alive; rc=$?
    if (( rc != 0 )); then
        log "  escalating to USB unbind/bind"
        echo "$dev" > /sys/bus/usb/drivers/usb/unbind 2>/dev/null
        sleep 3
        echo "$dev" > /sys/bus/usb/drivers/usb/bind   2>/dev/null
        sleep 6
    fi

    systemctl start bluetooth >/dev/null 2>&1
    sleep 3

    hci_alive; rc=$?
    case $rc in
        0) if [[ "$context" == early ]]; then
               log "  CONTROLLER RESPONDS AFTER EARLY INTERVENTION — BT-1 counterfactual censored"
               notify "Bluetooth controller responds after an early intervention; no claim that a hang was imminent."
           else
               log "  RECOVERED — confirmed stalled controller is responding again"
               notify "Bluetooth controller recovered automatically."
           fi
           return 0 ;;
        2) log "  recovery attempted; cannot verify (no probe tool — install bluez)"
           return 2 ;;
        *) log "  RECOVERY FAILED — controller still unresponsive"
           return 1 ;;
    esac
}

# --- main ------------------------------------------------------------------

log "bt-hang-watchdog started (device $VID:$PID, threshold $THRESHOLD/${WINDOW}s, cooldown ${COOLDOWN}s)"
if [[ "$PROBE" == none ]]; then
    log "WARNING: neither hciconfig nor btmgmt found. Recovery will still run,"
    log "         but its success cannot be confirmed. Install the 'bluez' package."
else
    log "liveness probe: $PROBE"
fi
if (( VERBOSE )); then
    log "verbose mode ON — every detected signal will be logged"
else
    log "verbose mode off (set BT_VERBOSE=1 via 'systemctl edit bt-hang-watchdog' when reproducing)"
fi
if dev=$(find_usb_dev); then
    if h=$(hci_for_dev "$dev"); then
        log "device present at $dev ($h)"
    else
        log "device present at $dev (no hci node yet)"
    fi
else
    log "WARNING: $VID:$PID not currently on the USB bus — controller is already"
    log "         USB-absent. Watchdog is armed but cannot act until it returns."
fi

if (( EARLY )); then
    log "EARLY mode ON — also watching bluetoothd for audio-teardown failures"
    log "  threshold $EARLY_THRESHOLD in ${EARLY_WINDOW}s; resets BEFORE any HCI timeout"
else
    log "early mode off (set BT_EARLY=1 to reset on audio-teardown failures)"
fi

HITS=()
EHITS=()
last_recover=0
fails=0
gave_up=0

# Process substitution (not a pipe) so the loop runs in THIS shell — otherwise
# `fails`/`last_recover` would be confined to a subshell and `break` could not
# stop the watchdog properly.
# -n0 => only new messages, so a restart never replays old timeouts.
while read -r line; do

    class=""

    # LATE signals — the controller has already stopped answering HCI commands.
    #
    # DELIBERATELY BROADER than the canonical BT-1 counting pattern. Analysis
    # tools count `command( 0x…)? tx timeout` only (EX-015); this TRIGGER also
    # accepts `link tx timeout` and every -110 form, because any of them can
    # accompany a stalling controller and a missed trigger costs a power-off.
    # The cost is real and accepted: a burst of ACL supervision timeouts from a
    # healthy controller (a device walking out of range) can reset a working
    # radio. Detection breadth and measurement precision are different jobs.
    case "$line" in
        *hci*"tx timeout"*)               class=late ;;
        *hci*"failed: -110"*)             class=late ;;
        *hci*"setting interface failed"*) class=late ;;
    esac

    # EARLY signals — bluetoothd audio-teardown errors that preceded some historical
    # stalls and followed or never appeared in others. They are mitigation
    # heuristics, not established causal markers or predictors. Acting on one
    # censors whether BT-1 would have occurred without the reset.
    #
    # Historical boot-level associations, retained only to explain the heuristic:
    #   cancel_request() Suspend   2/2    avdtp_connect_cb        5/5
    #   cancel_request() Abort     4/4    SDP record: Host is down 10/10
    #   avdtp_close failed         4/3
    # "Device or resource busy" is deliberately EXCLUDED at 3/9 — too noisy to
    # justify resetting a controller that may be healthy.
    if (( EARLY )) && [[ -z "$class" ]]; then
        case "$line" in
            *"cancel_request() Suspend"*)  class=early ;;
            *"cancel_request() Abort"*)    class=early ;;
            *avdtp_connect_cb*)            class=early ;;
            *"avdtp_close failed"*)        class=early ;;
            *"SDP record: Host is down"*)  class=early ;;
        esac
    fi

    [[ -n "$class" ]] || continue

    now=$(date +%s)

    # Early signals get their own window and threshold: they are rarer, and the
    # whole point is to act before the LATE evidence exists.
    if [[ "$class" == early ]]; then
        ekeep=()
        for t in ${EHITS[@]+"${EHITS[@]}"}; do
            (( now - t < EARLY_WINDOW )) && ekeep+=("$t")
        done
        EHITS=(${ekeep[@]+"${ekeep[@]}"} "$now")
        en=${#EHITS[@]}
        vlog "early signal: ${line:0:110}"
        vlog "  early window: $en/$EARLY_THRESHOLD in last ${EARLY_WINDOW}s"

        (( en < EARLY_THRESHOLD )) && continue
        if (( now - last_recover < COOLDOWN )); then
            log "EARLY threshold reached ($en/$EARLY_THRESHOLD) but suppressed by cooldown ($(( COOLDOWN - (now - last_recover) ))s remaining)"
            continue
        fi
        if (( fails >= MAX_FAILS )); then
            log "Giving up: $MAX_FAILS consecutive recovery attempts failed."
            gave_up=1; break
        fi
        log "EARLY intervention: $en audio-teardown failure(s) in ${EARLY_WINDOW}s — resetting BEFORE any HCI timeout."
        last_recover=$now; EHITS=(); HITS=()
        recover early; rc=$?
        case $rc in
            0) log "  EARLY action completed — no claim that BT-1 was imminent"; fails=0 ;;
            2) ;;
            *) ((fails++)); log "consecutive failed recoveries: $fails/$MAX_FAILS" ;;
        esac
        continue
    fi

    # Slide the window, then record this hit.
    keep=()
    for t in ${HITS[@]+"${HITS[@]}"}; do
        (( now - t < WINDOW )) && keep+=("$t")
    done
    HITS=(${keep[@]+"${keep[@]}"} "$now")
    n=${#HITS[@]}

    vlog "signal: ${line:0:120}"
    vlog "  window: $n/$THRESHOLD hit(s) in last ${WINDOW}s"

    if (( n < THRESHOLD )); then
        continue
    fi

    # Threshold met but suppressed. Always logged, not just in verbose mode:
    # "watchdog did nothing" and "watchdog wanted to act but was rate-limited"
    # are completely different diagnoses and must not look identical.
    if (( now - last_recover < COOLDOWN )); then
        log "threshold reached ($n/$THRESHOLD) but suppressed by cooldown ($(( COOLDOWN - (now - last_recover) ))s remaining)"
        continue
    fi

    if (( fails >= MAX_FAILS )); then
        log "Giving up: $MAX_FAILS consecutive recovery attempts failed."
        log "A cold power-off is required. Watchdog is now idle until reboot."
        gave_up=1
        break
    fi

    log "Detected $n controller timeouts within ${WINDOW}s — intervening."
    last_recover=$now
    HITS=()

    recover confirmed; rc=$?
    case $rc in
        0) fails=0 ;;
        2) ;;   # unverifiable: do not count as failure, do not reset either
        *) ((fails++))
           log "consecutive failed recoveries: $fails/$MAX_FAILS" ;;
    esac
done < <(
    if (( EARLY )); then
        # Follow the kernel AND bluetoothd. journalctl ORs separate matches with
        # "+", so this is one stream carrying both — the early signals live in
        # bluetoothd, the late ones in the kernel.
        journalctl -f -n0 --output=cat \
            _TRANSPORT=kernel + _SYSTEMD_UNIT=bluetooth.service 2>/dev/null
    else
        journalctl -kf -n0 --output=cat 2>/dev/null
    fi
)

# Do not let systemd's Restart=always immediately re-arm a hopeless watchdog.
if (( gave_up )); then
    log "idling — cold power-off required"
    while :; do sleep 3600; done
fi

# Falling out of the loop any other way means the journal reader died. Silent
# respawn every RestartSec with no diagnostic is worse than a loud failure.
log "ERROR: journal reader terminated unexpectedly (journalctl -kf exited)."
log "       Check that systemd-journald is running and readable."
exit 1
