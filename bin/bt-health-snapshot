#!/bin/bash
# bt-health-snapshot — append one row of Bluetooth health metrics.
#
# Run periodically by bt-health-snapshot.timer. Output is a TSV that survives
# reboots, so the effectiveness of the mitigations can be judged over days
# without relying on journal retention.
#
# Analyse with: /usr/local/bin/bt-health-report

set -uo pipefail

# Seams, real paths by default. This is the WRITER of metrics.tsv — the series
# bt-health-report reads back to answer whether the mitigation works — and it
# had never been run under test, so nothing checked that the header it writes
# once and the row it appends forever have the same shape.
_BHS_LIB="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/../tools/lib"
[[ -r "$_BHS_LIB/journal.sh" ]] || _BHS_LIB=/usr/local/bin/lib
[[ -r "$_BHS_LIB/journal.sh" ]] || { echo "bt-health-snapshot: missing journal.sh" >&2; exit 1; }
# shellcheck source=tools/lib/journal.sh
source "$_BHS_LIB/journal.sh"

OUT="${BT_METRICS:-/var/log/bt-health/metrics.tsv}"
SYSFS_USB="${BT_SYSFS_USB:-/sys/bus/usb/devices}"
SYSFS_MOD="${BT_SYSFS_MODULE:-/sys/module/btusb/parameters}"
VID="${BT_VID:-13d3}"
PID="${BT_PID:-3503}"

mkdir -p "$(dirname "$OUT")"

if [[ ! -s "$OUT" ]]; then
    printf 'timestamp\tboot_id\tkernel\tuptime_s\tdev_present\thci_alive\tusb_power_ctrl\tbtusb_autosusp\ttx_timeouts\tunexpected_evt\twd_interventions\twd_recovered\twd_failed\tconnected\n' > "$OUT"
fi

ts=$(date -Iseconds)
boot_id=$(cut -c1-8 /proc/sys/kernel/random/boot_id 2>/dev/null || echo "-")
kernel=$(uname -r)
uptime_s=$(awk '{printf "%d", $1}' /proc/uptime)

# --- device presence -------------------------------------------------------
dev_present=0
usb_ctrl="-"
usb_path=""
for d in "$SYSFS_USB"/*; do
    [[ -f "$d/idVendor" && -f "$d/idProduct" ]] || continue
    if [[ "$(<"$d/idVendor")" == "$VID" && "$(<"$d/idProduct")" == "$PID" ]]; then
        dev_present=1
        usb_path="$d"
        usb_ctrl=$(cat "$d/power/control" 2>/dev/null || echo "-")
        break
    fi
done

# --- does the controller actually answer? ----------------------------------
# Resolve the hci node belonging to OUR device. Taking the first adapter in
# /sys/class/bluetooth would report on a spare USB dongle instead, silently
# falsifying this column in exactly the situation it exists to measure.
hci_alive=0
h=""
if [[ -n "$usb_path" ]]; then
    for p in "$usb_path"/*/bluetooth/hci*; do
        [[ -e "$p" ]] && { h=$(basename "$p"); break; }
    done
fi
if [[ -n "$h" ]] && command -v hciconfig >/dev/null 2>&1 \
   && timeout 6 hciconfig "$h" name >/dev/null 2>&1; then
    hci_alive=1
fi

btusb_autosusp=$(cat "$SYSFS_MOD/enable_autosuspend" 2>/dev/null || echo "-")

# --- failure counters, this boot -------------------------------------------
# HCI command timeouts, opcode-named or not. NOT bare "tx timeout": that
# also matches `link tx timeout` (ACL supervision, a different layer), of
# which this machine has logged 7 against 173 real command timeouts. See
# evidence/exhibits/015-timeout-pattern-undercount.md.
tx_timeouts=$(bt_journal -k -b 0 --no-pager 2>/dev/null | grep -cE "command( 0x[0-9a-f]+)? tx timeout")
unexpected=$(bt_journal -k -b 0 --no-pager 2>/dev/null | grep -c "unexpected event for opcode")

# --- watchdog activity, this boot ------------------------------------------
wd_log=$(bt_journal -u bt-hang-watchdog -b 0 --no-pager 2>/dev/null)
# Both intervention forms. The watchdog logs a threshold intervention as
# "... — intervening." and an early one as "EARLY intervention: ...". Matching
# only "intervening" silently missed every EARLY intervention — the column has
# been undercounting since BT_EARLY was added, in a metric whose whole purpose
# is to say how often the watchdog acted.
wd_int=$(grep -cE "intervening|EARLY intervention" <<<"$wd_log")
wd_rec=$(grep -c "RECOVERED" <<<"$wd_log")
wd_fail=$(grep -c "RECOVERY FAILED\|FATAL:" <<<"$wd_log")

# --- currently connected devices -------------------------------------------
connected=0
if (( hci_alive )); then
    connected=$(timeout 8 bluetoothctl devices Connected 2>/dev/null | grep -c "^Device")
fi

printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$ts" "$boot_id" "$kernel" "$uptime_s" "$dev_present" "$hci_alive" \
    "$usb_ctrl" "$btusb_autosusp" "$tx_timeouts" "$unexpected" \
    "$wd_int" "$wd_rec" "$wd_fail" "$connected" >> "$OUT"
