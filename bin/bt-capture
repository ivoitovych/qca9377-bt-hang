#!/usr/bin/env python3
"""bt-capture — decode-free HCI capture that survives btmon crashing.

WHY THIS EXISTS
---------------
btmon in bluez 5.72 aborts repeatedly while capturing (issue BT-4 in
docs/issues.md): 67 crashes in a single boot on this machine. Each abort ends
the current capture file and loses roughly a second of traffic.

That was treated as a nuisance until it blocked the investigation. The question
that matters now is what distinguishes a synchronous-connection setup the
controller survives from one it does not, and the answer is in the *parameters*
of the request -- which live only in the btsnoop capture, not in the kernel log.
When those captures were finally consulted, the relevant window was gone.

The crash is in btmon's decoder, not in its writer. So this tool does not
decode. It reads raw frames from the kernel's HCI monitor socket and appends
them to a btsnoop file, and there is no packet it can fail to parse because it
never parses one. It runs *alongside* btmon rather than replacing it: btmon
stays for its live decoding, and this is the copy that is still there afterwards.

Multiple readers may hold the monitor socket open simultaneously, so both can
run without interfering.

Usage:
  bt-capture [--dir DIR] [--max-mb N] [--keep N] [--min-free-gb N]
"""

import argparse
import os
import socket
import struct
import sys
import time

HCI_DEV_NONE = 0xFFFF
HCI_CHANNEL_MONITOR = 2

# btsnoop header: magic, version, datalink type.
BTSNOOP_MAGIC = b"btsnoop\x00"
BTSNOOP_VERSION = 1
BTSNOOP_TYPE_MONITOR = 2001

# btsnoop timestamps count microseconds from year 0. bluez derives them from
# seconds since 2000-01-01 plus this offset; matching it exactly is what makes
# the output readable by btmon -r and by Wireshark.
BTSNOOP_TS_OFFSET = 0x00E03AB44A676000
UNIX_2000 = 946684800


def log(msg):
    print(msg, flush=True)


class _FileMonitor:
    """A monitor socket fed from a file. The seam, and why it exists.

    Everything below open_monitor() -- the btsnoop header, the record encoding,
    rotation, the write-error path -- needs a bound AF_BLUETOOTH monitor socket,
    which needs Bluetooth hardware and root. So none of it had ever executed
    under test, on any machine, and the encoding is not a detail: bt-capdiff
    reads these files and every later analysis reads bt-capdiff. The format
    comment carries a REVIEWED-KEEP marker, meaning someone checked it by eye
    once. Nothing checked it twice.

    Frames on the real socket arrive one per recv(). The fixture supplies the
    same framing explicitly, `<u32 little-endian length><frame>`, because a raw
    byte stream has no frame boundaries and inventing them here would test a
    parser this tool deliberately does not have.

    EOF raises socket.timeout rather than returning b"": the caller treats a
    timeout as "nothing yet, check the deadline", which is exactly right, and
    treats a short read as a runt frame to skip, which would spin.
    """

    def __init__(self, path):
        self._f = open(path, "rb")

    def settimeout(self, _timeout):
        pass

    def recv(self, _bufsize):
        hdr = self._f.read(4)
        if len(hdr) < 4:
            time.sleep(0.02)      # not a hot loop while the deadline runs down
            raise socket.timeout
        (n,) = struct.unpack("<I", hdr)
        return self._f.read(n)


def open_monitor():
    """Bind the HCI monitor channel.

    Python's socket.bind() rejects the (device, channel) tuple for BTPROTO_HCI
    on this build ("bind(): wrong format"), and binding with the device alone
    would silently attach to HCI_CHANNEL_RAW instead of the monitor -- a
    different stream, and one that would look plausible while missing exactly
    the events wanted. So the sockaddr_hci is constructed and passed to libc's
    bind() directly:

        struct sockaddr_hci { unsigned short hci_family, hci_dev, hci_channel; }

    BT_CAPTURE_SOURCE replaces the socket with a file; see _FileMonitor. It is
    announced on stdout rather than taken quietly, because unlike this project's
    read-only seams this one changes what gets WRITTEN: a stray value in the
    environment would produce a capture file full of fixture frames that looks
    exactly like a real one. A capture whose provenance is wrong is worse than
    no capture, and this line is the difference.
    """
    src = os.environ.get("BT_CAPTURE_SOURCE", "")
    if src:
        log(f"BT_CAPTURE_SOURCE={src} — reading frames from a FILE, not the controller")
        return _FileMonitor(src)

    import ctypes
    import ctypes.util

    s = socket.socket(socket.AF_BLUETOOTH, socket.SOCK_RAW, socket.BTPROTO_HCI)
    libc = ctypes.CDLL(ctypes.util.find_library("c"), use_errno=True)
    addr = struct.pack("<HHH", socket.AF_BLUETOOTH, HCI_DEV_NONE, HCI_CHANNEL_MONITOR)
    if libc.bind(s.fileno(), addr, len(addr)) != 0:
        err = ctypes.get_errno()
        raise OSError(err, os.strerror(err))
    return s


def next_path(directory):
    """A capture path that does not already exist.

    The name was time.strftime("hci-%Y%m%d-%H%M%S.btsnoop"), at SECOND
    resolution, and rotation reopens it -- so two rotations inside one second
    produced the same path and the second TRUNCATED the first capture. Found by
    a test that rotated twice and got one file back.

    That is not hypothetical at the sizes this runs at, and it is the third time
    this repository has met second-resolution naming: bt-snapshot put two
    captures in one directory the same way. bin/bt-trace and bin/bt-usbmon still
    name their files exactly like the original of this line.
    """
    base = time.strftime("hci-%Y%m%d-%H%M%S")
    path = os.path.join(directory, base + ".btsnoop")
    n = 1
    while os.path.exists(path):
        path = os.path.join(directory, "%s-%02d.btsnoop" % (base, n))
        n += 1
    return path


def new_file(path):
    f = open(path, "wb", buffering=0)
    f.write(BTSNOOP_MAGIC + struct.pack(">II", BTSNOOP_VERSION, BTSNOOP_TYPE_MONITOR))
    return f


def free_gb(directory):
    st = os.statvfs(directory)
    return st.f_bavail * st.f_frsize / (1 << 30)


def prune(directory, keep, min_free_gb):
    """Apply retention. Returns True when the free-space floor is met.

    THE RETURN VALUE IS THE POINT, and it was missing. The loop below deletes
    oldest-first until the floor is met OR THERE IS NOTHING LEFT, and the second
    exit said nothing at all: every retained capture gone, the filesystem still
    over the floor, and the caller carrying on writing into it. bin/bt-trace --
    this tool's shell sibling, doing the same job on the same machine -- has
    always ended that case with "still under NGB with nothing left to prune" and
    STOPPED capturing rather than filling the filesystem. The two daemons
    disagreed, and the quiet one is the one that deletes the evidence.
    """
    files = sorted(
        (os.path.join(directory, n) for n in os.listdir(directory) if n.endswith(".btsnoop")),
        key=os.path.getmtime,
    )
    while len(files) > keep:
        victim = files.pop(0)
        log(f"pruning {os.path.basename(victim)}")
        try:
            os.unlink(victim)
        except OSError:
            pass

    # Free-space floor, enforced independently of the file count: a count is a
    # guess about file size, and this is the check that cannot be wrong.
    while files:
        if free_gb(directory) >= min_free_gb:
            break
        victim = files.pop(0)
        log(f"low disk ({free_gb(directory):.1f}GB free): pruning {os.path.basename(victim)}")
        try:
            os.unlink(victim)
        except OSError:
            pass

    return free_gb(directory) >= min_free_gb


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--dir", default=os.environ.get("BT_CAPTURE_DIR", "/var/log/bt-health/capture"))
    ap.add_argument("--max-mb", type=int, default=int(os.environ.get("BT_CAPTURE_MAX_MB", "64")))
    ap.add_argument("--keep", type=int, default=int(os.environ.get("BT_CAPTURE_KEEP", "400")))
    ap.add_argument("--min-free-gb", type=int,
                    default=int(os.environ.get("BT_CAPTURE_MIN_FREE_GB", "15")))
    # A self-terminating mode, so testing this does not need a `timeout` prefix.
    # That matters for a mundane reason: wrapping a command in `timeout` puts a
    # different program at the front of the command line, so it no longer
    # matches any permission rule written for this one and prompts every time.
    # A bound the tool enforces itself keeps the invocation matchable.
    ap.add_argument("--duration", type=int, default=0,
                    help="stop after N seconds (0 = run until killed)")
    # RETENTION WITHOUT A CONTROLLER. prune() decides which captures are
    # deleted, and it ran only after open_monitor() succeeded -- so the one
    # function in this file that DESTROYS EVIDENCE could not be reached, or
    # tested, on any machine without Bluetooth hardware and root. It is also a
    # thing an operator genuinely wants on its own: reclaim space now, without
    # stopping the capture that is running.
    ap.add_argument("--prune-only", action="store_true",
                    help="apply retention to --dir and exit; opens no socket")
    args = ap.parse_args()

    os.makedirs(args.dir, mode=0o700, exist_ok=True)

    if args.prune_only:
        if prune(args.dir, args.keep, args.min_free_gb):
            log(f"retention applied (keep={args.keep} floor={args.min_free_gb}GB), "
                f"{free_gb(args.dir):.1f}GB free")
            return 0
        log(f"ERROR: still under {args.min_free_gb}GB with nothing left to prune.")
        return 1

    try:
        sock = open_monitor()
    except OSError as e:
        log(f"ERROR: cannot open HCI monitor socket: {e}")
        return 1

    log(f"bt-capture started (dir={args.dir} rotate={args.max_mb}MB "
        f"keep={args.keep} floor={args.min_free_gb}GB)")
    # REFUSING TO START IS THE SAFE ANSWER, and it is the one bin/bt-trace has
    # always given: "Stopping capture rather than filling the filesystem." A
    # capture daemon that keeps writing onto a filesystem it has already emptied
    # of captures takes journald down with it, and journald is the primary
    # evidence this whole project reads.
    if not prune(args.dir, args.keep, args.min_free_gb):
        log(f"ERROR: still under {args.min_free_gb}GB with nothing left to prune.")
        log("       Refusing to capture rather than filling the filesystem.")
        log("       Free space, then: systemctl restart bt-capture")
        return 1

    limit = args.max_mb * 1024 * 1024
    path = next_path(args.dir)
    out = new_file(path)
    log(f"capturing to {os.path.basename(path)}")
    written = 0

    deadline = time.time() + args.duration if args.duration else None
    if deadline:
        sock.settimeout(1.0)

    while True:
        if deadline and time.time() >= deadline:
            out.close()
            log(f"duration reached; wrote {written} bytes to {os.path.basename(path)}")
            return 0
        try:
            data = sock.recv(65536)
        except socket.timeout:
            continue
        except OSError as e:
            log(f"ERROR: monitor socket read failed: {e}")
            return 1
        if len(data) < 6:
            continue

        # struct hci_mon_hdr { __le16 opcode; __le16 index; __le16 len; }
        opcode, index, _plen = struct.unpack_from("<HHH", data, 0)
        payload = data[6:]

        # REVIEWED-KEEP 2026-08-15T1752Z 2.3: the encoding above (magic,
        # monitor type 2001, flags = index<<16|opcode, the 0x00E03AB44A676000
        # offset) was verified against the BlueZ btsnoop monitor format, and
        # the clock warning below is load-bearing for bt-capdiff's tolerance.
        # ⚠ CLOCK SEMANTICS. This is USERSPACE RECEIVE TIME — the moment this
        # process was scheduled and returned from recv() — not the kernel
        # timestamp of the original HCI event. The kernel monitor header
        # (hci_mon_hdr) carries no timestamp field, so the event time is not
        # available here without a different interface.
        #
        # Harmless for statements at the scale this investigation currently
        # makes ("USB failed 31 s later"). NOT harmless if analysis ever starts
        # distinguishing 2 ms from 20 ms ordering between capture paths: against
        # btmon's kernel-derived timestamps these will differ by a variable
        # scheduling delay. bt-capdiff therefore matches with a tolerance rather
        # than on equality. Do not treat these as kernel ground truth.
        us = int((time.time() - UNIX_2000) * 1_000_000) + BTSNOOP_TS_OFFSET
        # In monitor format the btsnoop "flags" field carries index and opcode.
        flags = (index << 16) | opcode
        rec = struct.pack(">IIIIq", len(payload), len(payload), flags, 0, us)

        try:
            out.write(rec + payload)
        except OSError as e:
            log(f"ERROR: write failed: {e}")
            return 1
        written += len(rec) + len(payload)

        if written >= limit:
            out.close()
            prune(args.dir, args.keep, args.min_free_gb)
            path = next_path(args.dir)
            out = new_file(path)
            log(f"rotated to {os.path.basename(path)}")
            written = 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(0)
