#!/bin/bash
# coverage — how much of the shell this repository ships does the suite execute?
#
#   devtools/coverage              per-file table, worst first, plus a total
#   devtools/coverage --min 25     also exit non-zero if the total falls below 25%
#   devtools/coverage --quiet      totals only
#   devtools/coverage --uncovered [path]   list the lines that never ran
#
# WHY THIS EXISTS.
#
# `tests/run-tests` reports "all 65 invariants hold", and `repo-validate`
# reports that every shell file parses. Neither answers the question a reader
# actually has: how much of this code has ever been RUN by the suite. Those two
# green lines are compatible with 38 of 42 scripts never executing a single
# statement under test, which is what was in fact the case when this was first
# measured.
#
# The number was previously asserted from reading — counting which tools the
# suite mentions. That is the same class of claim this repository has been
# wrong about four times: a hand-derived list standing in for a measurement.
# So it is measured, by running the suite and recording every line bash
# actually executed.
#
# HOW IT WORKS.
#
# bash cannot be told to trace a child script from the parent: PS4 is reset to
# its default at startup and is not inherited, so an exported PS4 carrying
# ${BASH_SOURCE}/${LINENO} silently produces an untagged, unattributable trace.
# BASH_ENV is the seam — a non-interactive bash sources it before running its
# script — so the tagged PS4, the trace descriptor AND xtrace itself are all
# installed there.
#
# xtrace is enabled inside BASH_ENV rather than propagated from here through an
# exported SHELLOPTS. Both appear to work; only one does so reliably. The
# SHELLOPTS route depends on the invoking shell's own exported environment and
# was observed to produce a SILENTLY EMPTY trace — BASH_ENV still sourced, the
# suite still green, and every file reported at 0%. A measurement whose failure
# mode is "everything looks uncovered" is worse than no measurement, because it
# reads as a finding. Enabling the option in the file that is definitely
# sourced removes the dependency.
#
# The trace goes to a dedicated file descriptor rather than stderr, because
# tests/run-tests captures stderr in several assertions and a trace mixed into
# it would change the results being measured.
#
# WHAT THE DENOMINATOR MEANS.
#
# bash traces simple commands, not syntax. Blank lines, comments, bare keywords
# (`fi`, `done`, `else`), function-definition headers, here-document bodies and
# backslash-continuation lines can never appear in a trace, so counting them as
# coverable would understate every file. They are excluded.
#
# What is NOT excluded, and what therefore makes every figure here a
# CONSERVATIVE LOWER BOUND:
#
#   * a command spanning several lines is traced once, at its first line, so
#     its remaining lines count as uncovered;
#   * `case` pattern labels are counted but never traced.
#
# So a file's true coverage is somewhat higher than printed. The number is
# useful for ranking files and for watching a trend, and it is honest about
# which direction it errs. It is NOT a percentage to quote as if exact.
#
# Nothing here writes to the repository: the trace and the instrumented
# BASH_ENV live in a temp directory removed on every exit path.

set -uo pipefail

cd "$(dirname "$0")/.." || exit 1

MIN=""; QUIET=0; UNCOV=""; SHOWUNCOV=0; DUMPDIR=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --min)   MIN="${2:?--min needs a percentage}"; shift ;;
        --quiet) QUIET=1 ;;
        # --uncovered [file-substring]: print the lines that were never
        # traced, instead of a ratio.
        #
        # WHY THIS EXISTS. A percentage tells you there is a gap; it does not
        # tell you where, so the only way to close one was to guess which tool
        # was untested and read it. That is how this effort ran for three
        # sessions. Every mature coverage tool prints the missing lines and
        # this one printed a ranking — which is the more comfortable output and
        # the less useful one, because a ranking can be improved by writing
        # tests for whatever is easiest and a line list cannot.
        --uncovered) SHOWUNCOV=1
                     if [[ "${2:-}" == "" || "${2:-}" == -* ]]; then UNCOV="."
                     else UNCOV="$2"; shift; fi ;;
        # --dump writes the two tables the ratio is computed from, so another
        # instrument can ask questions of them without running the suite again.
        # devtools/test-comprehension needs to know not just HOW MANY lines ran
        # but WHICH, and re-deriving that would give it a second opinion about
        # the same run — the failure this file already had once, when the
        # summary and --uncovered disagreed.
        --dump) DUMPDIR="${2:?--dump needs a directory}"; shift ;;
        -h|--help) sed -n '2,9p' "$0"; exit 0 ;;
        # An unknown flag previously became a positional and was ignored, so a
        # mistyped --min silently reported success. Refuse instead.
        *) echo "unknown option: $1" >&2; exit 2 ;;
    esac
    shift
done

for req in git awk bash; do
    if ! command -v "$req" >/dev/null 2>&1; then
        echo "coverage: $req is required but not installed" >&2
        exit 2
    fi
done
[[ -x tests/run-tests ]] || { echo "coverage: tests/run-tests not executable" >&2; exit 2; }

WORK=$(mktemp -d) || exit 1
trap 'rm -rf "$WORK"' EXIT INT TERM

# ── the files under measurement ───────────────────────────────────────────
#
# DERIVED, not hand-written. `tests/run-tests` learned this the hard way: a
# hand-maintained `tools bin devtools` omitted install.sh, which held the very
# defect the check was hunting. Same shebang scan, same source of truth, and
# built without a pipeline so the detector cannot be bitten by the pipefail
# inversion it exists alongside.
SHFILES=()
while IFS= read -r f; do
    [[ -f "$f" ]] || continue
    IFS= read -r shebang < "$f" || continue
    case "$shebang" in
        '#!'*bash*|'#!'*/sh|'#!'*' sh') SHFILES+=("$f") ;;
    esac
done < <(git ls-files 2>/dev/null)

if (( ${#SHFILES[@]} == 0 )); then
    echo "coverage: no shell files found (not a git checkout?)" >&2
    exit 2
fi

# ── run the suite under trace ─────────────────────────────────────────────
printf 'running tests/run-tests under trace (%d shell files)...\n' "${#SHFILES[@]}" >&2

printf 'PS4=%s\nBASH_XTRACEFD=9\nset -o xtrace\n' \
       "'+@@C@@\${BASH_SOURCE}@@\${LINENO}@@'" > "$WORK/bashenv"

(
    exec 9>"$WORK/trace"
    export BASH_ENV="$WORK/bashenv"
    tests/run-tests
) >"$WORK/suite.out" 2>"$WORK/suite.err"
SUITE_RC=$?

# REVIEWED-KEEP 2026-08-15T1752Z §5: keep this refusal — an empty trace
# reported as 0% (or worse, as clean) converts a broken measurement into a
# confident number.
# An empty trace means the instrumentation did not take, NOT that nothing ran.
# Reporting 0% here would be a fabricated finding; refuse instead.
if [[ ! -s "$WORK/trace" ]]; then
    echo "coverage: the trace is empty — instrumentation failed, refusing to report 0%" >&2
    echo "          (BASH_ENV=$WORK/bashenv was not honoured by the suite's shell)" >&2
    exit 2
fi

# The suite's own verdict is reported alongside the coverage figure. A coverage
# number measured from a RED suite describes which lines ran on the way to
# failing, which is not the same claim, and reporting it silently would invite
# the reader to treat it as the healthy baseline.
SUITE_TAIL=$(tail -1 "$WORK/suite.out" 2>/dev/null)

# Executed (file, line) pairs. Absolute paths and anything outside the checkout
# (the temp sandboxes the suite builds, /usr/local/bin copies) are dropped:
# this measures the repository, not its installed image.
# `./install.sh` and `install.sh` are the same file but different strings, and
# the join below is a string join. The suite invokes the installer as
# `./install.sh`, so its every executed line was recorded under a name the
# coverable table does not contain, and the file reported 0.0% WHILE ITS TESTS
# WERE VISIBLY RUNNING IT. A measurement tool's failure mode is once again
# "looks like a finding": strip the ./ prefix at normalisation.
grep -oE '@@C@@[^@]*@@[0-9]+@@' "$WORK/trace" 2>/dev/null \
  | sed -E 's/^@@C@@//; s/@@$//; s/@@/\t/; s/^\.\///' \
  | awk -F'\t' 'NF == 2 && $1 !~ /^\// && $1 !~ /^\.\./ { print $1 "\t" $2 }' \
  | sort -u > "$WORK/executed"

# ── the exclusion list ────────────────────────────────────────────────────
#
# See devtools/coverage-exclude. Parsed into two tables: whole files, and
# explicit line ranges. Both require a reason; an entry without one is refused
# rather than defaulted, because an unexplained exclusion is the mechanism by
# which a coverage number stops meaning anything.
EXCLUDE_FILE="${BT_COVERAGE_EXCLUDE:-devtools/coverage-exclude}"
: > "$WORK/excl-files"; : > "$WORK/excl-ranges"
if [[ -r "$EXCLUDE_FILE" ]]; then
    bad_entry=$(awk '
        /^[[:space:]]*(#|$)/ { next }
        {
            entry = $0
            i = index(entry, "#")
            reason = (i ? substr(entry, i + 1) : "")
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", reason)
            if (reason == "") print FNR ": " $0
        }' "$EXCLUDE_FILE")
    if [[ -n "$bad_entry" ]]; then
        echo "coverage: exclusion entries without a reason — refusing to apply them" >&2
        printf '  %s\n' "$bad_entry" >&2
        exit 2
    fi
    awk '
        /^[[:space:]]*(#|$)/ { next }
        {
            entry = $0
            i = index(entry, "#"); if (i) entry = substr(entry, 1, i - 1)
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", entry)
            if (entry == "") next
            # path:/regex/ — matches by line SHAPE rather than line number, so
            # it stays correct as the file moves. The only form that can
            # express "every failure branch" without a list that rots.
            if (match(entry, /:\/.*\/$/)) {
                f = substr(entry, 1, RSTART - 1)
                re = substr(entry, RSTART + 2, RLENGTH - 3)
                print f "\t~\t" re > "/dev/stderr"
                next
            }
            n = split(entry, p, ":")
            if (n == 2) {
                split(p[2], r, "-")
                print p[1] "\t" (r[1] + 0) "\t" (r[2] + 0) > "/dev/stderr"
            } else {
                print entry
            }
        }' "$EXCLUDE_FILE" > "$WORK/excl-files" 2> "$WORK/excl-ranges"
fi
EXCL_FILES_N=$(grep -c . "$WORK/excl-files" 2>/dev/null || echo 0)
EXCL_RANGES_N=$(grep -c . "$WORK/excl-ranges" 2>/dev/null || echo 0)

# ── coverable lines per file ──────────────────────────────────────────────
: > "$WORK/coverable"
: > "$WORK/coverable-lines"
: > "$WORK/excluded-lines"
for f in "${SHFILES[@]}"; do
    awk -v file="$f" -v lines_out="$WORK/coverable-lines" \
        -v excl_files="$WORK/excl-files" -v excl_ranges="$WORK/excl-ranges" \
        -v excl_out="$WORK/excluded-lines" '
        BEGIN {
            while ((getline e < excl_files) > 0) if (e == file) whole = 1
            close(excl_files)
            while ((getline e < excl_ranges) > 0) {
                if (split(e, ep, "\t") != 3 || ep[1] != file) continue
                if (ep[2] == "~") { npat++; pat[npat] = ep[3] }
                else { nr++; lo[nr] = ep[2] + 0; hi[nr] = ep[3] + 0 }
            }
            close(excl_ranges)
        }
        function excluded(n, text,   i) {
            if (whole) return 1
            for (i = 1; i <= nr; i++) if (n >= lo[i] && n <= hi[i]) return 1
            for (i = 1; i <= npat; i++) if (text ~ pat[i]) return 1
            return 0
        }
        # Here-document bodies are data, never traced. Track the terminator
        # from the opening line and skip until it is seen alone.
        heredoc != "" {
            t = $0; sub(/^[ \t]*/, "", t); sub(/[ \t]*$/, "", t)
            if (t == heredoc) heredoc = ""
            next
        }
        function nchar(str, ch,   i, n) {
            n = 0
            for (i = 1; i <= length(str); i++) if (substr(str, i, 1) == ch) n++
            return n
        }
        {
            line = $0
            s = line; sub(/^[ \t]*/, "", s); sub(/[ \t]*$/, "", s)

            # A MULTI-LINE ARRAY LITERAL is traced at its CLOSING line, and
            # nowhere else. Derived by tracing all three forms:
            #
            #   A=(one two)          one line   -> traced at that line
            #   B=(\n three \n )      spanning  -> traced at the line holding `)`
            #   C=(five\n six)        spanning  -> traced at the line holding `six)`
            #
            # So the opener and every interior line are uncoverable by
            # construction — operands of one assignment, exactly like the body
            # of a multi-line embedded program. The closing line falls through
            # to the normal rules, which is why `)` alone is dropped as
            # structural while `six)` is counted and can be covered.
            #
            # This replaced two per-file shape exclusions for uninstall.sh
            # FILES/DIRS/UNITS. A rule about the language beats a pattern about
            # one file: the patterns had to be written twice, were both wrong
            # about indentation the first time, and could never have covered
            # the arrays of bare function names in bin/bt-dyndbg.
            if (arrdepth > 0) {
                arrdepth += nchar(s, "(") - nchar(s, ")")
                if (arrdepth > 0) next          # interior operand line
                arrdepth = 0                    # closing line: classify it
            } else if (s ~ /^[A-Za-z_][A-Za-z0-9_]*\+?=\(/) {
                d = nchar(s, "(") - nchar(s, ")")
                if (d > 0) { arrdepth = d; next }
            }

            # A continuation of the previous line is part of that command and
            # carries no LINENO of its own.
            if (cont) { cont = (line ~ /\\$/); next }
            cont = (line ~ /\\$/)

            if (match(line, /<<-?[ \t]*"?'"'"'?[A-Za-z_][A-Za-z0-9_]*"?'"'"'?/)) {
                h = substr(line, RSTART, RLENGTH)
                sub(/^<<-?[ \t]*/, "", h); gsub(/["'"'"']/, "", h)
                heredoc = h
            }

            if (s == "")                     next   # blank
            if (s ~ /^#/)                    next   # comment
            if (s ~ /^(fi|done|else|esac|do|then|\{|\}|;;|\))$/) next
            if (s ~ /^(fi|done);$/)          next
            # A block terminator carrying a REDIRECT is still not a command:
            # `done < file`, `done <<<"$v"`, `fi > /dev/null` are all part of
            # the compound above them and are traced at its opening line.
            #
            # EXCEPT when the redirect contains a process substitution. `done <
            # <(cmd)` IS traced, because <(cmd) is itself a command bash runs
            # at that line. Derived by tracing both forms rather than reasoned
            # about — the two previous attempts to state a tracing rule by eye
            # in coverage-exclude were both wrong.
            if (s ~ /^(fi|done|esac)[ \t]*[<>]/ && s !~ /[<>]\(/) next
            # A bare function header is never traced, with or without a
            # trailing comment. A ONE-LINE definition is a different thing —
            # `g() { echo g; }` reports line g when called — so the body must
            # not be allowed to appear before the optional comment.
            if (s ~ /^[A-Za-z_][A-Za-z0-9_-]*\(\)[ \t]*\{?[ \t]*(#.*)?$/) next  # func header
            if (s ~ /^\}[ \t]*(<|>|\||&|$)/) next   # closing brace w/ redirect

            # Excluded AFTER the structural rules, so the exclusion count is
            # a count of real coverable lines and not of blank lines that were
            # never in the denominator to begin with.
            if (excluded(FNR, s)) { print file "\t" FNR "\t" s >> excl_out; next }

            n++
            print file "\t" FNR "\t" s >> lines_out
        }
        END { printf "%s\t%d\n", file, n + 0 }
    ' "$f" >> "$WORK/coverable"
done

# ── join, report ──────────────────────────────────────────────────────────
# ── the exclusion self-check ──────────────────────────────────────────────
#
# An excluded line that the suite ACTUALLY EXECUTED is an error, not a saving.
# It means the range is stale — the file moved under it, or a test now reaches
# code the list still claims is unreachable — and every such line is one the
# denominator lost while the numerator kept it, which flatters the total in the
# one direction nobody checks.
#
# This is what makes the list safe to grant a 100% floor to. It cannot stop
# someone excluding code that ought to be tested; nothing mechanical can, which
# is why each entry carries a reason a reviewer can reject. It does stop the
# list from silently rotting into a place where live code hides.
LIVE_EXCLUDED=$(awk -F'\t' '
    FNR == NR { ran[$1 "\t" $2] = 1; next }
    ($1 "\t" $2) in ran { print "  " $1 ":" $2 "  " $3 }
' "$WORK/executed" "$WORK/excluded-lines" | head -20)
if [[ -n "$LIVE_EXCLUDED" ]]; then
    echo "coverage: these EXCLUDED lines were executed by the suite —" >&2
    echo "          the exclusion is stale and is hiding live code:" >&2
    printf '%s\n' "$LIVE_EXCLUDED" >&2
    echo "          fix devtools/coverage-exclude, do not widen it" >&2
    exit 2
fi

# ── AN ENTRY THAT EXCLUDES NOTHING IS AN ERROR ───────────────────────────
#
# The self-check above catches an exclusion that hides LIVE code. It cannot
# catch the opposite failure: an entry that matches nothing at all. That one is
# worse, because it reads as a considered decision and nothing can disagree
# with it — the reviewer sees a reason, the tool sees no lines, and the two
# never meet. It has now happened three times in this file:
#
#   tools/bt-health-report.sh:212-212  a range over a BLANK line, since written
#   uninstall.sh:/^    \/.../          a pattern anchored on indentation, which
#                                      cannot match because excluded() is
#                                      called with the line already TRIMMED
#   (and the `path:61` parse trap the header describes, which yields 61-0)
#
# So the empty-input rule applies here too: an entry that ENUMERATES zero lines
# is a refusal, not a silent pass. Ranges and patterns are checked against what
# they actually removed; a whole-file entry is checked for the file existing at
# all.
DEAD_ENTRY=$(awk -F'\t' '
    FNR == NR { n++; exf[n] = $1; exl[n] = $2; ext[n] = $3; next }
    {
        c = 0
        for (i = 1; i <= n; i++) {
            if (exf[i] != $1) continue
            if ($2 == "~") { if (ext[i] ~ $3) c++ }
            else if (exl[i] + 0 >= $2 + 0 && exl[i] + 0 <= $3 + 0) c++
        }
        if (c == 0) print "  " $1 ":" ($2 == "~" ? "/" $3 "/" : $2 "-" $3)
    }
' "$WORK/excluded-lines" "$WORK/excl-ranges")
while IFS= read -r wf; do
    [[ -n "$wf" ]] || continue
    [[ -e "$wf" ]] || DEAD_ENTRY="$DEAD_ENTRY
  $wf  (no such file)"
done < "$WORK/excl-files"
if [[ -n "${DEAD_ENTRY// }" ]]; then
    echo "coverage: these exclusion entries matched NOTHING —" >&2
    echo "          each reads as a decision and removes no line:" >&2
    printf '%s\n' "$DEAD_ENTRY" >&2
    echo "          fix or delete them; an exclusion that excludes nothing is" >&2
    echo "          indistinguishable from one that worked" >&2
    exit 2
fi

awk -F'\t' 'FNR == NR { ran[$1 "\t" $2] = 1; next } ($1 "\t" $2) in ran' \
    "$WORK/executed" "$WORK/coverable-lines" > "$WORK/covered-lines"

if [[ -n "$DUMPDIR" ]]; then
    mkdir -p "$DUMPDIR"
    cp "$WORK/coverable-lines" "$DUMPDIR/coverable-lines"
    cp "$WORK/covered-lines"   "$DUMPDIR/covered-lines" 2>/dev/null || :
    cp "$WORK/excluded-lines"  "$DUMPDIR/excluded-lines"
fi

EXCLUDED_N=$(grep -c . "$WORK/excluded-lines" 2>/dev/null || echo 0)

if (( SHOWUNCOV )); then
    # Same two tables the ratio is computed from, so the list cannot disagree
    # with the percentage it explains — a separate walk of the sources could,
    # and a coverage report whose detail contradicts its summary is worse than
    # no detail at all.
    awk -F'\t' -v want="$UNCOV" '
        FNR == NR { ran[$1 "\t" $2] = 1; next }
        want != "." && index($1, want) == 0 { next }
        !(($1 "\t" $2) in ran) {
            if ($1 != lastf) { if (lastf != "") print ""; print $1; lastf = $1 }
            printf "  %5d  %s\n", $2, $3
            n++
        }
        END { printf "\n%d uncovered line(s)\n", n + 0 }
    ' "$WORK/executed" "$WORK/coverable-lines"
    exit 0
fi

# ── THE NUMERATOR IS AN INTERSECTION, NOT A COUNT ────────────────────────
#
# It used to be `hit[file]++` over the raw trace, clamped to the file's
# coverable total. That is not "how many coverable lines ran": the trace also
# tags lines the classifier removed from the denominator — excluded ranges,
# structural lines, embedded-program openers — so a file could be credited for
# executing lines that were never in the denominator, and the clamp then hid
# the surplus by capping the result at 100%.
#
# It reported bin/bt-trace at 100.0% (92/92) while `--uncovered bin/bt-trace`
# named an uncovered line, and tests/run-tests at 100.0% (1781/1781) with 174
# uncovered. The summary and the detail disagreed, which is precisely what the
# comment above --uncovered claims cannot happen — the two were never computed
# from the same tables.
#
# So the covered set is now the INTERSECTION of what ran with what counts,
# joined on (file, line): the same join --uncovered inverts. A file can no
# longer be credited for a line that is not in its denominator, the clamp
# below is unreachable by construction, and the two views cannot contradict
# each other because they are two halves of one computation.
awk -F'\t' -v quiet="$QUIET" '
    FNR == NR { hit[$1]++; next }
    {
        file = $1; total = $2
        h = ($1 in hit) ? hit[$1] : 0
        # Unreachable now that h counts an intersection with `total`s own
        # source. Kept as an assertion rather than deleted: if it ever fires,
        # the two tables have drifted apart again.
        if (h > total) { printf "coverage: %s counted %d of %d — tables disagree\n", \
                                file, h, total > "/dev/stderr"; exit 2 }
        pct = (total > 0) ? (100 * h / total) : 0
        rows[++n] = sprintf("%6.1f%%  %5d/%-5d  %s", pct, h, total, file)
        sort_key[n] = pct
        sum_h += h; sum_t += total
        if (h == 0) zero++
    }
    END {
        # insertion sort, worst coverage first — that is the actionable end
        for (i = 2; i <= n; i++) {
            kr = rows[i]; kk = sort_key[i]; j = i - 1
            while (j > 0 && sort_key[j] > kk) {
                rows[j+1] = rows[j]; sort_key[j+1] = sort_key[j]; j--
            }
            rows[j+1] = kr; sort_key[j+1] = kk
        }
        if (!quiet) {
            print  ""
            printf "%-7s  %-12s %s\n", "cover", "lines", "file"
            print  "──────────────────────────────────────────────────────────────"
            for (i = 1; i <= n; i++) print rows[i]
            print  ""
        }
        printf "files with zero executed lines: %d of %d\n", zero + 0, n
        printf "TOTAL: %.1f%% (%d of %d coverable lines)\n", \
               (sum_t > 0 ? 100 * sum_h / sum_t : 0), sum_h, sum_t
        printf "%d\n", (sum_t > 0 ? int(100 * sum_h / sum_t) : 0) > "/dev/stderr"
    }
' "$WORK/covered-lines" "$WORK/coverable" 2> "$WORK/pct"

# The exclusions are printed, always. A number computed against a hidden
# exclusion list is the failure this whole file is meant to prevent, so the
# count and the file are named next to the total that depends on them.
if (( ! QUIET )); then
    printf 'excluded: %d line(s) — %d file(s), %d range/pattern entr(ies) in %s\n' \
           "${EXCLUDED_N:-0}" "${EXCL_FILES_N:-0}" "${EXCL_RANGES_N:-0}" "$EXCLUDE_FILE"
fi

TOTAL_PCT=$(cat "$WORK/pct" 2>/dev/null | tr -d '[:space:]')
TOTAL_PCT=${TOTAL_PCT:-0}

# ── awk libraries ─────────────────────────────────────────────────────────
#
# Statement-level coverage of an awk program needs gawk --profile, and this
# machine ships mawk, which has no profiler. What CAN be measured exactly, from
# the trace already captured, is how many times the suite loaded each library
# with -f. That is invocation count, not line coverage, and is labelled as
# such: a library invoked once is exercised along exactly one path through it.
if (( ! QUIET )) && compgen -G "tools/lib/*.awk" >/dev/null 2>&1; then
    echo
    printf '%-9s %s\n' "loads" "awk library (invocations by the suite, not line coverage)"
    echo  "──────────────────────────────────────────────────────────────"
    for lib in tools/lib/*.awk; do
        # Counted, not `grep -q`: under pipefail a matching `grep -q` pipeline
        # exits non-zero, which is the inversion tests/run-tests forbids.
        loads=$(grep -c -- "-f $lib" "$WORK/trace" 2>/dev/null)
        loads=${loads:-0}
        lines=$(awk 'END { print NR }' "$lib")
        if (( loads == 0 )); then
            printf '%-9s %s  (%s lines) — NEVER LOADED\n' "0" "$lib" "$lines"
        else
            printf '%-9s %s  (%s lines)\n' "$loads" "$lib" "$lines"
        fi
    done
fi

echo
if (( SUITE_RC == 0 )); then
    echo "suite: ${SUITE_TAIL:-passed} (measurement taken from a green run)"
else
    echo "suite: FAILED (rc=$SUITE_RC) — these figures describe a red run" >&2
fi

if [[ -n "$MIN" ]]; then
    if (( TOTAL_PCT < MIN )); then
        echo "coverage ${TOTAL_PCT}% is below the --min ${MIN}% floor" >&2
        exit 1
    fi
    echo "coverage ${TOTAL_PCT}% meets the --min ${MIN}% floor"
fi

exit $(( SUITE_RC != 0 ))
