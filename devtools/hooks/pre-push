#!/bin/bash
# pre-push — the publish scan as a gate: before git sends anything to the PUBLIC repository, run
# devtools/repo-scan on the lines each pushed ref would add, and refuse the whole push if it fails.
#
# WHY: the scan was a step to remember, and on 2026-10-23 a commit went to `origin` with a plain
# `git push` before the scan was run (it was clean when run afterwards). devtools/save scans; a
# direct push did not. Git runs this for every push from this checkout, whoever types it.
#
# Pushes to any other remote (`private`: real addresses are allowed there since 2026-10-11) pass
# without a scan, and say so. Installed as a symlink: .git/hooks/pre-push → ../../devtools/hooks/pre-push
# (devtools/hooks/install-hooks.sh). Tests: devtools/hooks/test-pre-push.sh.
set -uo pipefail
REMOTE_NAME="${1:-}"; REMOTE_URL="${2:-}"
ROOT="$(git rev-parse --show-toplevel)" || exit 1
PUBLIC_RE='github\.com[:/]ivoitovych/qca9377-bt-hang(\.git)?/?$'
if ! [[ "$REMOTE_URL" =~ $PUBLIC_RE ]]; then
	echo "pre-push: $REMOTE_NAME ($REMOTE_URL) is not the public repository: no publish scan"
	exit 0
fi
ZERO=0000000000000000000000000000000000000000
rc=0 refs=0
while read -r lref lsha rref rsha; do
	[[ -n "${lsha:-}" ]] || continue
	[[ "$lsha" != "$ZERO" ]] || continue   # deleting a remote ref adds nothing
	base="$rsha"
	# A remote tip this checkout does not have: scan as a new branch rather than not at all.
	if [[ "$base" != "$ZERO" ]] && ! git cat-file -e "$base^{commit}" 2>/dev/null; then base="$ZERO"; fi
	refs=$((refs + 1))
	echo "pre-push: scanning $lref → $REMOTE_NAME $rref"
	"$ROOT/devtools/repo-scan" "$ROOT" --range "$base" "$lsha" || rc=1
done
if (( rc != 0 )); then
	echo "pre-push: publish scan FAILED: nothing was pushed to $REMOTE_NAME" >&2
	exit 1
fi
echo "pre-push: publish scan clean for $refs ref(s)"
