#!/bin/bash
# repo-validate — syntax-check everything checkable in a repo.
#
#   repo-validate [dir]
#
# bash -n on shell scripts, systemd-analyze on units, udevadm on rules,
# jq on JSON, a parse check on Python. Exits non-zero on any failure.
#
# Checks TRACKED files plus anything currently STAGED, so a newly added file is
# validated on the commit that introduces it.

set -uo pipefail

DIR="${1:-.}"
cd "$DIR" 2>/dev/null || { echo "no such dir: $DIR" >&2; exit 2; }
git rev-parse --git-dir >/dev/null 2>&1 || { echo "not a git repo: $DIR" >&2; exit 2; }

# Operate from the repository root: git ls-files is cwd-relative, so running
# from a subdirectory checked only part of the tree and still passed.
ROOT=$(git rev-parse --show-toplevel) || exit 2
cd "$ROOT" || exit 2

fail=0; checked=0
ok()  { printf '  ✓ %s\n' "$1"; checked=$((checked+1)); return 0; }
bad() { printf '  ✗ %s\n' "$1"; checked=$((checked+1)); fail=1; return 0; }

# Tracked ∪ staged, deduplicated. Staged-only files were previously invisible.
files() { { git ls-files; git diff --cached --name-only --diff-filter=d; } | sort -u; }

while IFS= read -r f; do
    [[ -f "$f" ]] || continue
    if head -1 "$f" 2>/dev/null | grep -q '^#!.*\(bash\|sh\)'; then
        if bash -n "$f" 2>/dev/null; then ok "bash  $f"
        else bad "bash  $f"; bash -n "$f" 2>&1 | sed 's/^/      /'; fi
    fi
done < <(files)

while IFS= read -r f; do
    [[ -f "$f" ]] || continue
    case "$f" in *.service|*.timer|*.socket) ;; *) continue ;; esac
    out=$(systemd-analyze verify "./$f" 2>&1 | grep -v "is not executable" || true)
    if [[ -z "$out" ]]; then ok "unit  $f"
    else bad "unit  $f"; sed 's/^/      /' <<<"$out"; fi
done < <(files)

# Diagnostics are shown on failure rather than discarded. Previously these three
# checks sent all output to /dev/null, so a failure produced only a ✗ with no
# reason — and a missing tool was indistinguishable from a syntax error.
while IFS= read -r f; do
    [[ -f "$f" ]] || continue
    case "$f" in *.rules) ;; *) continue ;; esac
    if ! command -v udevadm >/dev/null 2>&1; then
        printf '  • udev  %s (skipped: udevadm not installed)\n' "$f"; continue
    fi
    if out=$(udevadm verify "./$f" 2>&1); then ok "udev  $f"
    else bad "udev  $f"; sed 's/^/      /' <<<"$out"; fi
done < <(files)

while IFS= read -r f; do
    [[ -f "$f" ]] || continue
    case "$f" in *.json) ;; *) continue ;; esac
    if ! command -v jq >/dev/null 2>&1; then
        printf '  • json  %s (skipped: jq not installed)\n' "$f"; continue
    fi
    if out=$(jq -e . "$f" 2>&1 >/dev/null); then ok "json  $f"
    else bad "json  $f"; sed 's/^/      /' <<<"$out"; fi
done < <(files)

while IFS= read -r f; do
    [[ -f "$f" ]] || continue
    case "$f" in *.py) ;; *) continue ;; esac
    if ! command -v python3 >/dev/null 2>&1; then
        printf '  • py    %s (skipped: python3 not installed)\n' "$f"; continue
    fi
    # ast.parse rather than py_compile: py_compile writes __pycache__/*.pyc
    # beside the source, which repo-save would then stage and commit, and which
    # contradicts this tool being read-only.
    if out=$(python3 -c 'import ast,sys; ast.parse(open(sys.argv[1]).read())' "$f" 2>&1); then ok "py    $f"
    else bad "py    $f"; sed 's/^/      /' <<<"$out"; fi
done < <(files)

echo
# "All checks passed" after checking nothing is a false assurance — but there
# are two different nothings, and conflating them is its own bug (it made a
# perfectly valid repo of plain text files fail):
#   enumerated == 0  -> git told us nothing exists. Something is wrong.
#   checked    == 0  -> files exist, none are of a checkable type. Fine.
enumerated=$(files | wc -l)
if (( enumerated == 0 )); then
    echo "VALIDATION INCONCLUSIVE — git enumerated no files in $ROOT" >&2
    exit 1
fi
if (( fail )); then echo "VALIDATION FAILED ($checked checked)"; exit 1; fi
if (( checked == 0 )); then
    echo "no checkable files ($enumerated tracked/staged, none are scripts, units, rules, json or python)"
    exit 0
fi
echo "all checks passed ($checked of $enumerated files were checkable)"
