#!/bin/bash
# repo-validate — syntax-check everything checkable in a repo.
#
#   repo-validate [dir]
#
# bash -n on shell scripts, systemd-analyze on units, udevadm on rules,
# jq on JSON, a parse check on Python. Exits non-zero on any failure.
#
# Checks TRACKED files plus anything currently STAGED, so a newly added file is
# validated on the commit that introduces it.

set -uo pipefail

DIR="${1:-.}"
cd "$DIR" 2>/dev/null || { echo "no such dir: $DIR" >&2; exit 2; }
git rev-parse --git-dir >/dev/null 2>&1 || { echo "not a git repo: $DIR" >&2; exit 2; }

# Operate from the repository root: git ls-files is cwd-relative, so running
# from a subdirectory checked only part of the tree and still passed.
ROOT=$(git rev-parse --show-toplevel) || exit 2
cd "$ROOT" || exit 2

fail=0; checked=0
ok()  { printf '  ✓ %s\n' "$1"; checked=$((checked+1)); return 0; }
bad() { printf '  ✗ %s\n' "$1"; checked=$((checked+1)); fail=1; return 0; }

# Tracked ∪ staged, deduplicated. Staged-only files were previously invisible.
files() { { git ls-files; git diff --cached --name-only --diff-filter=d; } | sort -u; }

while IFS= read -r f; do
    [[ -f "$f" ]] || continue
    # Counted: `| grep -q` inverts under pipefail. Here it would mean shell
    # scripts silently stop being syntax-checked — the validator would report
    # a clean repository by checking nothing.
    n_sh=$(head -1 "$f" 2>/dev/null | grep -cE '^#!.*(bash|sh)' || true)
    if (( ${n_sh:-0} > 0 )); then
        if bash -n "$f" 2>/dev/null; then ok "bash  $f"
        else bad "bash  $f"; bash -n "$f" 2>&1 | sed 's/^/      /'; fi
    fi
done < <(files)

while IFS= read -r f; do
    [[ -f "$f" ]] || continue
    case "$f" in *.service|*.timer|*.socket) ;; *) continue ;; esac
    # GUARDED like udevadm, jq, python3 and awk below. Without this, a host with
    # no systemd — a container, or any CI runner — turns "command not found" into
    # $out, and every unit file fails validation for a reason that has nothing to
    # do with the unit. Nine false ✗ and a non-zero exit, which on a first CI run
    # reads as "this repository is broken" rather than "this runner has no
    # systemd". Measured: with systemd-analyze off PATH the gate failed all nine.
    if ! command -v systemd-analyze >/dev/null 2>&1; then
        printf '  • unit  %s (skipped: systemd-analyze not installed)\n' "$f"; continue
    fi
    out=$(systemd-analyze verify "./$f" 2>&1 | grep -v "is not executable" || true)
    if [[ -z "$out" ]]; then ok "unit  $f"
    else bad "unit  $f"; sed 's/^/      /' <<<"$out"; fi
done < <(files)

# Diagnostics are shown on failure rather than discarded. Previously these three
# checks sent all output to /dev/null, so a failure produced only a ✗ with no
# reason — and a missing tool was indistinguishable from a syntax error.
while IFS= read -r f; do
    [[ -f "$f" ]] || continue
    case "$f" in *.rules) ;; *) continue ;; esac
    if ! command -v udevadm >/dev/null 2>&1; then
        printf '  • udev  %s (skipped: udevadm not installed)\n' "$f"; continue
    fi
    if out=$(udevadm verify "./$f" 2>&1); then ok "udev  $f"
    else bad "udev  $f"; sed 's/^/      /' <<<"$out"; fi
done < <(files)

while IFS= read -r f; do
    [[ -f "$f" ]] || continue
    case "$f" in *.json) ;; *) continue ;; esac
    if ! command -v jq >/dev/null 2>&1; then
        printf '  • json  %s (skipped: jq not installed)\n' "$f"; continue
    fi
    if out=$(jq -e . "$f" 2>&1 >/dev/null); then ok "json  $f"
    else bad "json  $f"; sed 's/^/      /' <<<"$out"; fi
done < <(files)

while IFS= read -r f; do
    [[ -f "$f" ]] || continue
    case "$f" in *.py) ;; *) continue ;; esac
    if ! command -v python3 >/dev/null 2>&1; then
        printf '  • py    %s (skipped: python3 not installed)\n' "$f"; continue
    fi
    # ast.parse rather than py_compile: py_compile writes __pycache__/*.pyc
    # beside the source, which repo-save would then stage and commit, and which
    # contradicts this tool being read-only.
    if out=$(python3 -c 'import ast,sys; ast.parse(open(sys.argv[1]).read())' "$f" 2>&1); then ok "py    $f"
    else bad "py    $f"; sed 's/^/      /' <<<"$out"; fi
done < <(files)

# --- awk programs ----------------------------------------------------------
# These are checkable ONLY because they live in files. The SCO cross-tab spent
# its whole life as an inline shell string containing a braceless `if` followed
# by `else` — a parse error that killed the entire END block. It failed on
# stderr while the enclosing command returned success, so the report simply
# omitted a section and nobody could tell. Nothing validated it because nothing
# could reach it.
#
# Parsing against /dev/null runs the program over empty input: syntax errors
# surface, BEGIN/END blocks execute harmlessly, and no repository file is read.
while read -r f; do
    [[ -f "$f" ]] || continue
    case "$f" in *.awk) ;; *) continue ;; esac
    if ! command -v awk >/dev/null 2>&1; then
        printf '  • awk   %s (skipped: awk not installed)\n' "$f"; continue
    fi
    # Judge on the DIAGNOSTIC, not the exit status. A program that parses may
    # legitimately exit non-zero — interval.awk exits 1 when handed an
    # unparseable timestamp, which is deliberate and is itself under test. Only
    # awk's own parse diagnostics indicate a broken program.
    out=$(awk -f "$f" /dev/null 2>&1 >/dev/null)
    # "runaway string constant" is mawk's wording for an unterminated string —
    # its one parse diagnostic that contains none of the other words. Without
    # it, a broken program passed this validator on any mawk host: the exact
    # silently-matching-nothing failure this file exists to prevent, in the
    # validator itself (review 2026-08-15T1752Z follow-up, CR-84).
    if grep -qiE "syntax error|unexpected|can't open source file|unterminated|runaway string" <<<"$out"; then
        bad "awk   $f"; sed 's/^/      /' <<<"$out"
    else
        ok "awk   $f"
    fi
done < <(files)

echo
# "All checks passed" after checking nothing is a false assurance — but there
# are two different nothings, and conflating them is its own bug (it made a
# perfectly valid repo of plain text files fail):
#   enumerated == 0  -> git told us nothing exists. Something is wrong.
#   checked    == 0  -> files exist, none are of a checkable type. Fine.
enumerated=$(files | wc -l)
if (( enumerated == 0 )); then
    echo "VALIDATION INCONCLUSIVE — git enumerated no files in $ROOT" >&2
    exit 1
fi
# --- analysis invariants ---------------------------------------------------
# Syntax checks prove a script parses, not that it means what its comments say.
# The gap between those two is where this project's worst defects have lived —
# a phase analysis that documented exogenous-probe selection and implemented a
# spacing heuristic passed every syntax check ever run against it.
if [[ -x "$ROOT/tests/run-tests" ]]; then
    if out=$("$ROOT/tests/run-tests" 2>&1); then
        ok "tests $(tail -1 <<<"$out")"
    else
        bad "tests FAILED"
        sed 's/^/      /' <<<"$out"
    fi
fi

# --- documentation drift ---------------------------------------------------
# Three times in a row the answer to "is everything updated, committed and
# pushed?" was "the code is, the documentation is not". Code landed with good
# commit messages while HISTORY.md and docs/ stayed several phases behind, and
# each time it was noticed only because someone asked.
#
# The project's own rule applies to the project: corrections belong in the
# machinery, not the notes. This is a warning rather than a failure — some
# commits genuinely need no narrative — but it makes the drift visible at the
# moment of committing instead of at the moment of being asked.
#
# ⚠ THIS IS AN ALARM, NOT A PROOF OF SYNCHRONISATION. Two limits are inherent:
#
#   * It compares timestamps, so it can establish "code changed after docs" but
#     never the converse. An unrelated documentation edit made after a
#     significant code change clears the condition without documenting anything.
#   * Documentation can be updated and still contain a stale claim elsewhere.
#     At 1990a45 the README opened with the correct, cautious framing and its
#     Status table still named a triggering command that had already been
#     refuted. This check would have said nothing.
#
# One path set, used for BOTH the count and the timestamp. An earlier version
# counted install.sh and uninstall.sh as code but excluded them from the
# timestamp, so a change to either was described as code in the message while
# being unable to raise the alarm. etc/, tests/ and devtools/ were watched by
# neither, though a udev rule under etc/ can change measurement provenance —
# which is what EX-012 turned on — and tests/ and devtools/ change what the
# repository claims to validate.
KNOWLEDGE_PATHS=(tools bin systemd etc tests devtools install.sh uninstall.sh)
# reviews/ carries the review->fixes->verification chain — epistemic record,
# same standing as HISTORY.md for the drift comparison.
DOC_PATHS=(HISTORY.md docs README.md reviews)

if git -C "$ROOT" rev-parse HEAD >/dev/null 2>&1; then
    code_commits=$(git -C "$ROOT" log -20 --pretty=%H -- "${KNOWLEDGE_PATHS[@]}" 2>/dev/null | wc -l)
    doc_commits=$(git -C "$ROOT" log -20 --pretty=%H -- "${DOC_PATHS[@]}" 2>/dev/null | wc -l)
    last_code=$(git -C "$ROOT" log -1 --pretty=%ct -- "${KNOWLEDGE_PATHS[@]}" 2>/dev/null)
    last_doc=$(git -C "$ROOT" log -1 --pretty=%ct -- "${DOC_PATHS[@]}" 2>/dev/null)
    if [[ -n "${last_code:-}" && -n "${last_doc:-}" ]] && (( last_code > last_doc )); then
        gap=$(( (last_code - last_doc) / 3600 ))
        echo "  ! documentation drift: an implementation path changed more recently"
        echo "    than HISTORY.md, docs/ or README.md (by ${gap}h). If this batch of"
        echo "    work changed what the project knows or how it measures, the"
        echo "    epistemic record is behind."
        echo "    watched: ${KNOWLEDGE_PATHS[*]}"
        echo "    (${code_commits} of the last 20 commits touched those, ${doc_commits} touched docs)"
        echo "    This is an alarm, not proof of synchronisation — see the source."
        echo
    fi
fi

if (( fail )); then echo "VALIDATION FAILED ($checked checked)"; exit 1; fi
if (( checked == 0 )); then
    echo "no checkable files ($enumerated tracked/staged, none are scripts, units, rules, json or python)"
    exit 0
fi
echo "all checks passed ($checked of $enumerated files were checkable)"
