#!/bin/bash
# branch-status — how does every branch stand against main, and does any of it
#                 hold work that main does not?
#
#   devtools/branch-status              the table
#   devtools/branch-status --unique     also list the commits main lacks
#   devtools/branch-status --files      also list files present only on a branch
#   devtools/branch-status --fetch      fetch first (network)
#
# WHY THIS EXISTS. This audit has been hand-assembled three times, each time as
# a pipeline typed at the keyboard, and twice it was got wrong in a way that
# read as a clean result:
#
#   * "ahead by N" was read as "carries N commits of work". It is not. A rebase
#     snapshot is ahead by N while carrying nothing at all, because the same
#     patches reached main by another route. `git cherry` compares by PATCH-ID
#     and is the honest counter — a commit already upstream in any form is
#     marked '-', and only '+' is genuinely absent.
#
#   * a `comm` between two sorted file lists printed "input is not in sorted
#     order" and its output was read anyway. LC_ALL was set for `sort` and not
#     for `comm`, so the two disagreed on collation. That warning invalidates
#     the result; here LC_ALL=C is exported once, for every tool in the script.
#
# ⚠️ THE FILE-LEVEL CHECK IS NOT A SAFETY PROOF, and must never be used as one.
# BL-03 lived INSIDE docs/investigation-plan.md, a file present on both
# branches. A filename comparison called that branch redundant while the
# section would have been lost. "0 files not on main" means only that nothing
# is obviously unique — it is a place to start reading, not a verdict.
#
# Branch names are printed IN FULL, never abbreviated. Several differ only by a
# trailing UTC timestamp, and shortening them has cost real confusion.
#
# Read-only. Talks to the network only with --fetch.

set -uo pipefail
export LC_ALL=C

cd "$(dirname "$0")/.." || exit 1

UNIQUE=0; FILES=0; FETCH=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        --unique) UNIQUE=1 ;;
        --files)  FILES=1 ;;
        --fetch)  FETCH=1 ;;
        --all)    UNIQUE=1; FILES=1 ;;
        -h|--help) sed -n '2,9p' "$0"; exit 0 ;;
        *) echo "branch-status: unknown option: $1" >&2; exit 2 ;;
    esac
    shift
done

git rev-parse --git-dir >/dev/null 2>&1 || { echo "branch-status: not a git repository" >&2; exit 2; }

(( FETCH )) && git fetch --all --prune >/dev/null 2>&1

BASE=origin/main
git rev-parse --verify --quiet "$BASE" >/dev/null || { echo "branch-status: no $BASE" >&2; exit 2; }

mapfile -t BRANCHES < <(git for-each-ref --format='%(refname:short)' refs/remotes/origin \
                        | grep -vE '^origin/(main|HEAD)$' | sort)

# ENUMERATED == 0 IS A REFUSAL. An empty branch list means the refs are missing
# or the pattern stopped matching, not that the repository has one branch.
if (( ${#BRANCHES[@]} == 0 )); then
    echo "branch-status: REFUSING — no branches found under refs/remotes/origin" >&2
    exit 2
fi

printf '%s at %s\n\n' "$BASE" "$(git log --oneline -1 "$BASE")"
printf '%-64s %6s %7s %7s  %s\n' 'BRANCH' 'AHEAD' 'BEHIND' 'UNIQUE' 'STATUS'

MAINFILES=$(mktemp); trap 'rm -f "$MAINFILES"' EXIT
git ls-tree -r --name-only "$BASE" | sort > "$MAINFILES"

carriers=0
for b in "${BRANCHES[@]}"; do
    counts=$(git rev-list --left-right --count "$BASE...$b" 2>/dev/null) || continue
    behind=$(awk '{print $1}' <<<"$counts")
    ahead=$(awk '{print $2}' <<<"$counts")
    # Patch-id comparison, not commit-id: '+' is absent from main in any form.
    uniq=$(git cherry "$BASE" "$b" 2>/dev/null | grep -c '^+')
    uniq=${uniq:-0}
    if   (( uniq > 0 ));   then status='CARRIES WORK MAIN LACKS'; carriers=$((carriers + 1))
    elif (( ahead == 0 )); then status='fully merged'
    else                        status='ahead only by superseded patches'
    fi
    printf '%-64s %6s %7s %7s  %s\n' "$b" "$ahead" "$behind" "$uniq" "$status"
done

printf '\n  %s branch(es), %s carrying at least one patch main does not have.\n' \
    "${#BRANCHES[@]}" "$carriers"

if (( UNIQUE )); then
    echo
    echo "Commits whose patch is NOT in $BASE"
    echo "───────────────────────────────────────────────────────────────"
    for b in "${BRANCHES[@]}"; do
        n=$(git cherry "$BASE" "$b" 2>/dev/null | grep -c '^+')
        [[ "${n:-0}" -eq 0 ]] && continue
        printf '\n%s  (%s)\n' "$b" "$n"
        git cherry -v "$BASE" "$b" 2>/dev/null | awk '/^\+/ { $1=""; print "   " $0 }'
    done
fi

if (( FILES )); then
    echo
    echo "Files present on a branch and absent from $BASE"
    echo "───────────────────────────────────────────────────────────────"
    echo "(filename level only — content unique to a SHARED file is invisible here)"
    for b in "${BRANCHES[@]}"; do
        only=$(git ls-tree -r --name-only "$b" | sort | comm -13 "$MAINFILES" -)
        n=$(grep -c . <<<"$only")
        [[ "${n:-0}" -eq 0 ]] && continue
        printf '\n%s  (%s)\n' "$b" "$n"
        sed 's/^/   /' <<<"$only"
    done
fi

exit 0
