#!/bin/bash
# ci — the CI verdict for a commit, read on the machine instead of in a browser.
#
#   devtools/ci                 conclusion for HEAD
#   devtools/ci <sha>           conclusion for that commit (prefix is fine)
#   devtools/ci --wait [<sha>]  poll until the run is terminal, then print it
#   devtools/ci --recent [N]    the last N runs on main (default 6)
#   devtools/ci --failed [<sha>] print the failing lines of that commit's run
#
# On a red verdict the failing lines are printed automatically (the failed-step
# log is saved under tmp/ci-<sha>.log); --failed does the same for a run that
# has already been reported. Added 2026-09-20: "read the failing lines" had been
# typed inline as `gh run view … --log-failed | grep …` three times in one day,
# each time a permission prompt, one of them blocking an unattended session for
# an hour. The operator asked whether it was avoidable. It is — the same way.
#
# Exit: 0 success · 1 failure/cancelled · 2 no run found or gh unavailable
#       3 still running (without --wait)
#
# WHY THIS EXISTS. Review 2026-09-16T0420Z, R2-105: "the commit path on the
# machine never runs the suite and nothing reads CI." main was red for three
# weeks on two invariants that never passed anywhere; devtools/save printed
# "CI will run it on push" on twelve pushes and the twelve red verdicts sat in
# the Actions tab. The verdict has to be READABLE where commits are made, or it
# is not a verdict — it is a promise.
#
# ⚠️ AND THE LOOP THAT READ IT WAS TYPED BY HAND FOUR TIMES IN ONE SESSION:
#
#   until gh run list --limit 4 --json conclusion,headSha --jq '…' \
#         | grep -qE 'success|failure'; do sleep 30; done; gh run list …
#
# which the permission matcher cannot parse at all ("Parse error"), so it
# prompted every single time. The operator pasted the prompt and asked whether
# it was avoidable. It is: devtools/* is granted once, forever. Same fix as
# devtools/save and tools/bt-fault-window — the repeated QUESTION becomes a
# file, and the shell goes away.
#
# Read-only. Talks to GitHub through gh; touches nothing on the machine.

set -uo pipefail
export LC_ALL=C

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="$(cd "$HERE/.." && pwd)"
# gh resolves "which repository" from the CURRENT DIRECTORY, not from the
# script's location. Run from anywhere else — as this tool was on 2026-09-19,
# when the session's working directory had moved one level up — every `gh run
# list` fails with "not a git repository", its stderr is dropped below, fetch()
# returns nothing, and --wait reports "no run after the grace budget" for a run
# that exists and is green. Three verdicts were misread that way in one
# afternoon. devtools/status already cds for the same reason.
cd "$REPO" || { echo "ci: cannot enter $REPO" >&2; exit 2; }

WAIT=0; RECENT=0; N=6; SHA=""; SHOWFAILED=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        --wait)   WAIT=1 ;;
        --failed) SHOWFAILED=1 ;;
        --recent) RECENT=1; [[ "${2:-}" =~ ^[0-9]+$ ]] && { N="$2"; shift; } ;;
        -h|--help) sed -n '2,9p' "$0"; exit 0 ;;
        -*) echo "ci: unknown option: $1" >&2; exit 2 ;;
        *)  SHA="$1" ;;
    esac
    shift
done

command -v gh >/dev/null 2>&1 || { echo "ci: gh is not installed — no verdict is readable here" >&2; exit 2; }

# A VERDICT NAMES ITS COMMIT. The default is HEAD of the checkout, resolved to a
# full sha so a prefix the user typed and a prefix gh returns compare the same.
if [[ -z "$SHA" ]]; then
    SHA=$(git -C "$REPO" rev-parse HEAD 2>/dev/null) || { echo "ci: not a git checkout" >&2; exit 2; }
fi
SHA=$(git -C "$REPO" rev-parse --verify --quiet "$SHA^{commit}" 2>/dev/null || echo "$SHA")
SHORT="${SHA:0:7}"

# gh's --jq runs inside gh; nothing here is piped through the shell. Each field
# is fetched in one call and split in bash.
fetch() {   # -> "conclusion<TAB>status<TAB>runId<TAB>title" for the newest run on $SHA, or empty
    # ⚠️ AN IN-PROGRESS RUN HAS conclusion == "" — THE EMPTY STRING, NOT null.
    # jq's `//` substitutes only for null/false, so `.conclusion // "-"` still
    # emitted an empty first field; `read` with a tab IFS strips leading IFS
    # whitespace; every field shifted left by one and the title printed where
    # the run id belonged. Two wrong diagnoses on this file's first run, both
    # corrected by looking at the raw bytes (`cat -A`) instead of theorising.
    # gh's own failure (no repo, no auth, no network) must not read as "no run":
    # its stderr is kept and the tool stops on it, because an empty answer from
    # a broken query is exactly what waited twenty minutes on 2026-09-19.
    local out err rc
    err=$(mktemp)
    out=$(gh run list --limit 30 --json conclusion,status,headSha,databaseId,displayTitle \
        --jq ".[] | select(.headSha | startswith(\"$SHORT\")) | \"\\(if .conclusion == null or .conclusion == \"\" then \"-\" else .conclusion end)\\t\\(.status)\\t\\(.databaseId)\\t\\(.displayTitle)\"" \
        2>"$err"); rc=$?
    if (( rc != 0 )); then
        echo "ci: gh run list failed (rc=$rc):" >&2; sed 's/^/     /' "$err" >&2; rm -f "$err"
        # fetch() runs inside `row=$(fetch) || exit 2`, a subshell: `exit` here would end
        # only the subshell and the caller would loop on. Return, and every
        # caller carries `|| exit 2`. Found by the standalone proof, not by eye.
        return 2
    fi
    rm -f "$err"
    printf '%s\n' "$out" | head -1
}

if (( RECENT )); then
    printf 'CI — last %s run(s) on origin/main\n\n' "$N"
    gh run list --limit "$N" --branch main --json conclusion,status,headSha,displayTitle \
        --jq '.[] | "\(if .conclusion == null or .conclusion == "" then .status else .conclusion end)\t\(.headSha[0:7])\t\(.displayTitle[0:64])"' 2>/dev/null \
        | awk -F'\t' '{ printf "  %-10s %s  %s\n", $1, $2, $3 }'
    exit 0
fi

# A FAILING gh IS FATAL ONCE, TOLERATED WHILE WAITING. The 2026-09-19 fix made
# any gh failure stop the tool, so an empty answer from a broken query could no
# longer read as "no run". The same evening one dropped connection to
# api.github.com ("error connecting") ended a --wait that had been polling a
# green run for five minutes. A wait rides out a few consecutive failures — the
# grace budget is not consumed by them — and gives up on a persistent one with
# gh's own message; a single query (no --wait) still fails at once. The seam
# BT_CI_GH_FAILS lets a test drive both outcomes.
GH_FAILS_MAX="${BT_CI_GH_FAILS:-5}"; gh_fail=0
poll_fetch() {   # sets $row on success; on a gh failure leaves $row alone and counts it
    local r
    if r=$(fetch); then gh_fail=0; row="$r"; return 0; fi
    if (( ++gh_fail >= GH_FAILS_MAX )); then
        echo; echo "ci: gh failed $gh_fail times in a row — giving up" >&2; exit 2
    fi
    printf '!'
    return 1
}

row=""
if (( WAIT )); then
    until poll_fetch; do sleep "${BT_CI_POLL:-30}"; done
else
    row=$(fetch) || exit 2
fi

# ⚠️ --wait MUST WAIT FOR THE RUN TO APPEAR, not only for it to finish. GitHub
# queues the workflow run seconds-to-minutes AFTER the push returns, so the
# first fetch legitimately comes back empty on a fresh commit. The first
# version exited 2 there — "no run found" — and a background `--wait` launched
# right after a push failed every time, which is exactly how it was used. A
# not-yet-queued run is a state to wait through, not a failure; a genuinely
# absent one is caught by a bounded grace budget so the tool cannot hang for
# ever on a sha that was never pushed.
if [[ -z "$row" ]]; then
    if (( ! WAIT )); then
        echo "ci: no run found for $SHORT — not pushed, or Actions has not queued it yet" >&2
        echo "  (a run can take a minute to appear after a push; --wait polls for it)" >&2
        exit 2
    fi
    printf 'ci — %s not queued yet' "$SHORT"
    # ~20 min at 30 s; a push that produced no run is a real error, not an
    # infinite wait. ⚠️ The budget was 10 min until 2026-09-19 and was doubled
    # on the belief that two runs had queued late. That belief was wrong: the
    # runs were found within minutes by `gh run list -R …`; this tool never saw
    # them because it ran gh outside the repository (the cd above). The larger
    # budget is kept as margin and costs only a longer wait on a sha that was
    # truly never pushed. The two seams (BT_CI_GRACE, BT_CI_POLL) exist so a
    # test can drive both outcomes — the run appearing, and the budget running
    # out — without a real wall-clock wait or a real push. A guard that cannot
    # be made to fire is this project's most-repeated defect.
    grace="${BT_CI_GRACE:-40}"
    while [[ -z "$row" ]]; do
        # A retry after a gh failure does not spend the grace budget: the budget
        # measures GitHub not queuing the run, not the network dropping a call.
        if (( gh_fail == 0 )); then
            (( grace-- > 0 )) || { echo; echo "ci: no run for $SHORT after the grace budget — was it pushed to a branch Actions builds?" >&2; exit 2; }
            printf '.'
        fi
        sleep "${BT_CI_POLL:-30}"
        poll_fetch || true
    done
    echo
fi

# ── --wait: poll until terminal ──────────────────────────────────────────
#
# 30 s between polls: a run here takes ~4–8 minutes, and the GitHub API rate
# limit is per hour. Every terminal state is matched, not only success — a
# watcher that only recognised the happy path would sit silent through a
# cancellation for as long as the timeout.
if (( WAIT )); then
    printf 'ci — waiting on %s' "$SHORT"
    while :; do
        IFS=$'\t' read -r concl status runid title <<<"$row"
        [[ "$status" == "completed" ]] && break
        printf '.'
        sleep "${BT_CI_POLL:-30}"
        # On a gh failure $row keeps the last good answer, so the loop simply
        # polls again; "disappeared" is judged only on a successful, empty fetch.
        if poll_fetch; then
            [[ -n "$row" ]] || { echo; echo "ci: the run for $SHORT disappeared while waiting" >&2; exit 2; }
        fi
    done
    echo
fi

IFS=$'\t' read -r concl status runid title <<<"$row"
if [[ "$status" != "completed" ]]; then
    printf 'ci — %s  %s  run %s  (%s)\n' "$SHORT" "RUNNING" "$runid" "${title:0:60}"
    echo "  not terminal yet — devtools/ci --wait $SHORT"
    exit 3
fi

# The failing lines, filtered the way a reader looks for them: the suite's ✗
# and FAILED: lines, the coverage gate's stale-exclusion report with its
# context, and the runner's ##[error]. The whole failed-step log is saved
# beside them so nothing is lost to the filter.
show_failed() {
    local log="$REPO/tmp/ci-$SHORT.log"
    mkdir -p "$REPO/tmp"
    if ! gh run view "$runid" --log-failed > "$log" 2>&1; then
        echo "  (could not fetch the failed-step log: $(tail -1 "$log"))"; return
    fi
    echo "  failing lines (full failed-step log: tmp/ci-$SHORT.log):"
    grep -nE "✗|FAILED:|##\[error\]|EXCLUDED lines were executed" "$log" \
        | sed -E 's/^([0-9]+):[^\t]*\t[^\t]*\t[0-9TZ:.-]+ ?/\1: /' | cut -c1-200 | head -30 | sed 's/^/    /'
    if grep -q "EXCLUDED lines were executed" "$log"; then
        echo "  stale exclusion — the report, with the lines it hid:"
        # gh prefixes every log line with "<job>\t<step>\t<timestamp> "; strip that.
        grep -A6 "EXCLUDED lines were executed" "$log" \
            | sed -E $'s/^[^\t]*\t[^\t]*\t[0-9TZ:.-]+ ?//' | cut -c1-160 | sed 's/^/    /'
    fi
}

case "$concl" in
    success)
        printf 'ci — %s  ✓ %s  run %s  (%s)\n' "$SHORT" "$concl" "$runid" "${title:0:60}"
        (( SHOWFAILED )) && echo "  (green — nothing failed to show)"
        exit 0 ;;
    failure|cancelled|timed_out|startup_failure)
        printf 'ci — %s  ✗ %s  run %s  (%s)\n' "$SHORT" "$concl" "$runid" "${title:0:60}"
        show_failed
        exit 1 ;;
    *)
        printf 'ci — %s  ? %s  run %s\n' "$SHORT" "${concl:-unknown}" "$runid"
        exit 2 ;;
esac
