#!/bin/bash
# journal-contract — do the real journalctl's output shapes still match what
# the test fixtures claim they are?
#
#   devtools/journal-contract          check every claim the fixtures rely on
#
# WHY THIS EXISTS. Every fixture under tests/journal/ is a CLAIM about what
# `journalctl <args>` prints, and the seam (tools/lib/journal.sh) serves those
# claims to the tools under test. A mock is only as good as its fidelity to
# the real tool, and such claims rot in a specific, quiet way: the provenance
# fixture originally lacked `--list-boots`'s HEADER ROW, so every fixture-
# driven test passed while the real tool crashed on real output. The fixture
# was missing a case, not wrong in one — the failure mode no amount of
# fixture-driven testing can see, because the fixture is the world.
#
# So the claims are checked against the real tool, on a machine that has a
# real journal. Each check below names the fixture that depends on it. On a
# host with no usable journal (CI containers), every check SKIPS LOUDLY and
# the exit is 0 — an absent journal is not a broken contract.
#
# TWO PHASES. Phase 1 checks shapes against the HOST's journal and skips
# where there is none. Phase 2 needs no host journal at all: it builds a real
# journal from generated text and diffs real journalctl output byte-for-byte
# against the grammar the fixtures are written in — mock-equivalence checked
# by the tool itself, in any container. (This was briefly documented here as
# blocked: systemd-journal-remote drops entries without _BOOT_ID, saying so
# only at debug log level while exiting 0. Supplying boot IDs was the fix.)
#
# Read-only.

set -uo pipefail
cd "$(dirname "$0")/.." || exit 1

pass=0; fail=0; skip=0
ok()   { echo "  ✓ $*"; pass=$((pass + 1)); }
bad()  { echo "  ✗ $*"; fail=$((fail + 1)); }
note() { echo "  · $*"; skip=$((skip + 1)); }

echo "journal contract — real journalctl vs the shapes the fixtures claim"
echo "──────────────────────────────────────────────────────────────────"

if ! command -v journalctl >/dev/null 2>&1; then
    note "journalctl not installed — nothing to check against (exit 0)"
    exit 0
fi

# A usable journal has at least one boot. Counted, never `grep -q`.
LB=$(journalctl --list-boots --no-pager 2>/dev/null)
nboots=$(awk '$1 ~ /^-?[0-9]+$/' <<<"$LB" | wc -l)
HOST_JOURNAL=1
if [[ "${nboots:-0}" -eq 0 ]]; then
    # Phase 1 needs a real host journal; phase 2 BUILDS its own and runs
    # anywhere systemd-journal-remote exists — a CI container included. The
    # first version exited here, which silently skipped the one phase that
    # was designed to work exactly where this branch is taken.
    note "no boots in the host journal — phase-1 shape checks skipped"
    HOST_JOURNAL=0
fi

if (( HOST_JOURNAL )); then
# ── claim 1: --list-boots carries a non-numeric header row ────────────────
# Relied on by tests/journal/provenance/list-boots.log, which carries one so
# that bt-boot-provenance's numeric filter is actually exercised. If a future
# systemd drops the header, the fixture is claiming a shape the tool no
# longer emits, and the filter is dead weight the tests still "cover".
hdr=$(head -1 <<<"$LB" | awk '$1 ~ /^-?[0-9]+$/ { print "numeric" }')
if [[ -z "$hdr" ]]; then
    ok "--list-boots still prints a header row (provenance fixture carries one)"
else
    bad "--list-boots no longer prints a header — update the provenance fixture AND bt-boot-provenance"
fi

# ── claim 2: numeric rows have the offset in field 1, timestamps in 4-5/8-9 ─
row=$(awk '$1 ~ /^-?[0-9]+$/ { print; exit }' <<<"$LB")
f4=$(awk '{print $4}' <<<"$row"); f5=$(awk '{print $5}' <<<"$row")
if [[ "$f4" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ && "$f5" =~ ^[0-9]{2}:[0-9]{2}:[0-9]{2}$ ]]; then
    ok "--list-boots rows carry date+time at fields 4-5 (bt-boot-provenance reads them there)"
else
    bad "--list-boots row layout changed: field4='$f4' field5='$f5'"
fi

# ── claim 3: short-iso-precise starts lines with the ISO timestamp ────────
# Every kernel.log / unit-*.log fixture starts lines this way, and every
# converted tool cuts field 1 as the timestamp.
line=$(journalctl -b "$(awk '$1 ~ /^-?[0-9]+$/ {print $1; exit}' <<<"$LB")" \
       -n 1 --no-pager -o short-iso-precise 2>/dev/null | tail -1)
ts=$(awk '{print $1}' <<<"$line")
if [[ "$ts" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\.[0-9]{6} ]]; then
    ok "short-iso-precise puts a microsecond ISO timestamp in field 1"
else
    bad "short-iso-precise field 1 is '$ts' — every fixture and field-1 cut is now wrong"
fi

# ── claim 4: -b all emits '-- Boot <id> --' separators ────────────────────
# stage2.awk keys its boot-locality on these; tests/stage2-invariants.data
# and tests/fixtures/stage2/* all carry them.
#
# The span is bounded to the PREVIOUS boot's first entry, so exactly one boot
# boundary (-1 → 0) falls inside it. The first version instead read the first
# 5000 lines of the whole journal, which assumes the oldest retained boot is
# short. On this host boot -10 is a dyndbg tracing boot carrying 1,586,655
# kernel lines, so the cap never reached a boundary and the check reported the
# contract BROKEN while journalctl was emitting separators normally. Same
# shape as every other defect this week: a control that holds where it was
# written and not where it runs.
prev_start=$(awk '$1 ~ /^-?[0-9]+$/ {print $4" "$5}' <<<"$LB" | tail -2 | head -1)
if (( nboots > 1 )) && [[ -n "$prev_start" ]]; then
    seps=$(journalctl -k -b all --since "$prev_start" --no-pager -o short-iso-precise 2>/dev/null \
           | grep -c '^-- Boot ')
    if [[ "${seps:-0}" -gt 0 ]]; then
        ok "-b all still separates boots with '-- Boot <id> --' (stage2 fixtures claim it)"
    else
        bad "-b all no longer emits boot separators — stage2 boot-locality is broken"
    fi
elif (( nboots > 1 )); then
    note "boot-list rows carry no parsable start time — separator claim unchecked"
else
    note "single boot retained — separator claim unchecked this run"
fi

fi   # HOST_JOURNAL

# ── phase 2: byte equivalence over a BUILT journal ────────────────────────
#
# The strong form of the contract, unblocked once the refusal was understood:
# systemd-journal-remote silently drops any entry without a _BOOT_ID
# ("Empty boot ID, refusing entry" — visible only at debug log level, while
# the exit status stays 0 and the summary says "Finishing after writing 0
# entries"). With boot IDs supplied, committed TEXT becomes a real journal,
# the REAL journalctl runs over it, and its output is diffed against the
# exact bytes the fixture model predicts. This checks the mock's output
# grammar against the tool itself, with no hardware and no host journal.
#
# It already found one divergence: `-b all` prints `-- Boot <id> --` only
# BETWEEN boots, never before the first, while the stage2 fixtures carry a
# leading separator. stage2.awk treats separators as state resets so a
# leading one is harmless to it — but the fixtures claim a shape the real
# tool does not emit, and that asymmetry is recorded here rather than
# discovered again.
JR=""
for c in /usr/lib/systemd/systemd-journal-remote /lib/systemd/systemd-journal-remote; do
    [[ -x "$c" ]] && { JR="$c"; break; }
done
if [[ -z "$JR" ]]; then
    note "systemd-journal-remote not installed — byte-equivalence phase skipped"
else
    W=$(mktemp -d); trap 'rm -rf "$W"' EXIT
    B1=11111111111111111111111111111111
    B2=22222222222222222222222222222222
    # Epochs chosen so the expected ISO strings are static under TZ=UTC.
    {
      printf '__REALTIME_TIMESTAMP=1786694400000000\n_BOOT_ID=%s\n_TRANSPORT=kernel\nSYSLOG_IDENTIFIER=kernel\n_HOSTNAME=host\nMESSAGE=Bluetooth: hci0: command 0x0406 tx timeout\n\n' "$B1"
      printf '__REALTIME_TIMESTAMP=1786694410000000\n_BOOT_ID=%s\n_SYSTEMD_UNIT=bt-health-snapshot.service\nSYSLOG_IDENTIFIER=systemd\n_HOSTNAME=host\nMESSAGE=Snapshot Bluetooth health metrics\n\n' "$B1"
      printf '__REALTIME_TIMESTAMP=1786694500000000\n_BOOT_ID=%s\n_TRANSPORT=kernel\nSYSLOG_IDENTIFIER=kernel\n_HOSTNAME=host\nMESSAGE=usb 3-3: USB disconnect, device number 2\n\n' "$B2"
    } > "$W/export.txt"
    if ! "$JR" --split-mode=none -o "$W/built.journal" "$W/export.txt" >/dev/null 2>&1        || [[ ! -s "$W/built.journal" ]]; then
        bad "could not build a journal from export text — the equivalence phase is broken"
    else
        # Claim 5: the exact line grammar the fixtures are written in.
        cat > "$W/want-all" <<'WANT'
2026-08-14T08:00:00.000000+00:00 host kernel: Bluetooth: hci0: command 0x0406 tx timeout
2026-08-14T08:00:10.000000+00:00 host systemd: Snapshot Bluetooth health metrics
-- Boot 22222222222222222222222222222222 --
2026-08-14T08:01:40.000000+00:00 host kernel: usb 3-3: USB disconnect, device number 2
WANT
        TZ=UTC journalctl --file="$W/built.journal" -b all --no-pager -o short-iso-precise             > "$W/got-all" 2>/dev/null
        if diff -q "$W/want-all" "$W/got-all" >/dev/null 2>&1; then
            ok "real journalctl output is byte-identical to the fixture grammar (-b all)"
        else
            bad "journalctl output diverged from the fixture grammar:"
            diff "$W/want-all" "$W/got-all" | head -6 | sed 's/^/      /'
        fi
        # Claim 6: a unit filter selects exactly the unit's lines — the model
        # bt_journal implements as unit-<name>.log files.
        n=$(TZ=UTC journalctl --file="$W/built.journal" -u bt-health-snapshot.service                 --no-pager -o cat 2>/dev/null | grep -c 'Snapshot Bluetooth health metrics')
        [[ "${n:-0}" == "1" ]]             && ok "unit filtering matches the per-unit fixture-file model"             || bad "-u selected $n line(s), expected exactly 1"
        # Claim 7: no separator precedes the FIRST boot. The stage2 fixtures
        # carry a leading one; recorded divergence, see the header note.
        first=$(head -1 "$W/got-all")
        [[ "$first" != "-- Boot"* ]]             && ok "no separator before the first boot (stage2 fixtures diverge here, knowingly)"             || bad "journalctl now emits a LEADING boot separator — update the fixtures and this note"
    fi
fi

echo
if (( fail )); then
    echo "CONTRACT BROKEN: a fixture claims a shape the real journalctl no longer emits"
    exit 1
fi
echo "contract holds: $pass claim(s) verified, $skip skipped"
