#!/bin/bash
# repo-save — validate, scan, commit and push, verifying the remote matches.
#
#   repo-save <dir> "<commit message>"
#   repo-save <dir> -F <file>          message from a file
#   repo-save <dir> "<msg>" --no-push  commit only
#
# Refuses to commit if repo-validate or repo-scan fails. Scans the commit
# message as well as the content, then confirms the remote hash equals the
# local one — the step most often skipped by hand, and the only thing that
# proves a push actually landed.

set -uo pipefail

# Resolve this script's directory BEFORE any cd. Computing it afterwards made
# every relative invocation from another directory fail to find its siblings,
# and the failure was reported as "validation failed", blaming the target repo.
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

DIR="${1:-}"; shift || true
[[ -n "$DIR" ]] || { echo "usage: repo-save <dir> <message|-F file> [--no-push]" >&2; exit 2; }

PUSH=1; MSGFILE=""; MSG=""; seen_msg=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        --no-push) PUSH=0 ;;
        -F) MSGFILE="${2:?-F needs a file}"
            # Resolve now, before the cd below, so a relative path means what
            # the caller typed rather than something inside the target repo.
            [[ "$MSGFILE" == /* || "$MSGFILE" == /dev/* ]] || MSGFILE="$PWD/$MSGFILE"
            shift ;;
        -h|--help) sed -n '2,12p' "$0"; exit 0 ;;
        # Unknown flags previously became the commit message: "repo-save . --amend
        # 'fix'" silently dropped --amend and created a new commit instead.
        -*) echo "unknown option: $1" >&2; exit 2 ;;
        *) (( seen_msg )) && { echo "unexpected second message argument: $1" >&2; exit 2; }
           MSG="$1"; seen_msg=1 ;;
    esac
    shift
done

cd "$DIR" 2>/dev/null || { echo "no such dir: $DIR" >&2; exit 2; }
git rev-parse --git-dir >/dev/null 2>&1 || { echo "not a git repo: $DIR" >&2; exit 2; }

[[ -x "$HERE/repo-validate" && -x "$HERE/repo-scan" ]] \
    || { echo "cannot find repo-validate/repo-scan next to $0" >&2; exit 2; }

# --- stage FIRST -----------------------------------------------------------
# Validation and scanning both enumerate through git, so anything not yet in
# the index is invisible to them. Staging afterwards meant a commit's brand-new
# files were never syntax-checked — including the commit that added these very
# scripts.
echo "── stage ────────────────────────────────────────────"
if ! git add -A; then
    echo "ABORT: git add -A failed (stale index.lock? unreadable file?)" >&2
    exit 1
fi
if [[ -z "$(git diff --cached --name-only)" ]]; then
    echo "  nothing to commit"; exit 0
fi
echo "  staged: $(git diff --cached --name-only | wc -l) file(s)"

# --- an open trial changes WHICH validators can run, not WHETHER we check ---
#
# tests/run-tests refuses while a trial is open, and it is right to: it drives
# actuators, and on 2026-08-14 a coverage measurement closed a live 2-hour trial
# and wrote a results row fabricated by test stubs. On the investigation machine
# bt-trial-auto opens a trial every boot by design, so repo-validate — and
# therefore this tool, the whole validate/scan/commit/push path — could not run
# on the machine it was written for. The maintainer had fallen back to plain git
# with repo-scan by hand, which is the gate working as designed and the workflow
# failing anyway (comms/2026-08-19T1620Z §5).
#
# So: detect it here, drop to the validators that are read-only by construction,
# and SAY SO. What must never happen is this passing silently — an operator who
# believes the suite ran is worse off than one who knows it did not.
TRIAL_STATE="${BT_TRIAL_STATE_DIR:-/run/bt-trial}"
VALIDATE_ARGS=(.)
TRIAL_OPEN=0
if [[ -e "$TRIAL_STATE/current" ]]; then
    TRIAL_OPEN=1
    VALIDATE_ARGS=(. --no-suite)
fi

echo "── validate ─────────────────────────────────────────"
if (( TRIAL_OPEN )); then
    echo "  A TRIAL IS OPEN on this machine — the suite will NOT be run."
    awk '{ print "    " $0 }' "$TRIAL_STATE/current" 2>/dev/null
    echo "  Running every validator that is read-only by construction. The"
    echo "  analysis invariants are not among them; CI runs those on push."
fi
"$HERE/repo-validate" "${VALIDATE_ARGS[@]}" || { echo "ABORT: validation failed — nothing committed" >&2; exit 1; }

echo "── scan ─────────────────────────────────────────────"
"$HERE/repo-scan" . || { echo "ABORT: scan failed — nothing committed" >&2; exit 1; }

# --- the commit message ------------------------------------------------------
# Snapshotted once and read from the snapshot, so a streamed source is not
# consumed twice; an empty message is refused here, before git invents one.
echo "── message ──────────────────────────────────────────"
if [[ -n "$MSGFILE" ]]; then
    [[ -r "$MSGFILE" ]] || { echo "ABORT: cannot read message file: $MSGFILE" >&2; exit 2; }
    # Snapshot to a temp file and commit from THAT. Reading the source twice —
    # once to scan, once for git commit -F — silently produced an empty commit
    # message when the source was a stream such as /dev/stdin or a pipe, because
    # the first read consumed it.
    MSGTMP=$(mktemp); trap 'rm -f "$MSGTMP"' EXIT
    cat "$MSGFILE" > "$MSGTMP"
    MSGTEXT=$(cat "$MSGTMP")
    MSGFILE="$MSGTMP"
    [[ -s "$MSGTMP" ]] || { echo "ABORT: commit message is empty" >&2; exit 2; }
elif [[ -n "$MSG" ]]; then
    MSGTEXT="$MSG"
else
    echo "ABORT: no commit message given" >&2; exit 2
fi
# REVIEWED-KEEP 2026-08-15T1752Z §5: keep the counted form below.
# COUNTED, NOT `grep -qv`. This is the guard that keeps real MAC addresses and
# BSSIDs out of a PUBLIC repository, and under `set -o pipefail` a `| grep -q`
# pipeline exits non-zero exactly when it matches — grep leaves at the first
# hit and `tr` dies of SIGPIPE. A real address in a commit message would have
# taken the "clean" branch. Twenty addresses reached public commits once
# already, through a pattern that did not match underscores; this would have
# been the same outcome by a different mechanism.
n_real=$(grep -oEi '[0-9a-f]{2}([:_-][0-9a-f]{2}){5,}' <<<"$MSGTEXT" \
         | tr 'A-F_-' 'a-f::' \
         | grep -cvE '^(aa:bb:cc|11:11:11|00:00:00|ff:ff:ff|00:11:22|3c:37:12|de:ad:be)' || true)
if (( ${n_real:-0} > 0 )); then
    echo "  ✗ commit message contains a real MAC/BSSID" >&2
    echo "ABORT: nothing committed" >&2
    exit 1
fi
echo "  ✓ message clean"

# ── IDENTITY, CHECKED BEFORE THE COMMIT EXISTS ────────────────────────────
# Every commit of this repository is authored AND committed by the project
# author: the identity configured in this checkout (user.name, user.email).
# Both fields, because the committer is set by whoever runs `git commit` and is
# not shown by a plain `git log`; a hosted environment or a tool can set it to
# something else while the author looks right. A checkout without an identity
# is refused as well: git would invent one. The same two fields are checked
# again on every commit about to be pushed (below) and by CI on every push.
want_name="$(git config user.name 2>/dev/null)"; want_mail="$(git config user.email 2>/dev/null)"
if [[ -z "$want_name" || -z "$want_mail" ]]; then
    echo "  ✗ no identity configured in this checkout (git config user.name / user.email)" >&2
    echo "ABORT: nothing committed" >&2
    exit 1
fi
want="$want_name <$want_mail>"
id_author="$(git var GIT_AUTHOR_IDENT 2>/dev/null)"
id_committer="$(git var GIT_COMMITTER_IDENT 2>/dev/null)"
id_bad=0
for who in "author:$id_author" "committer:$id_committer"; do
    role="${who%%:*}"; ident="${who#*:}"
    ident="${ident% *}"; ident="${ident% *}"          # strip the timestamp and zone
    if [[ -z "$ident" ]]; then
        echo "  ✗ no $role identity — git would invent one" >&2; id_bad=1
    elif [[ "$ident" != "$want" ]]; then
        echo "  ✗ $role is not this checkout's identity ($want): $ident" >&2; id_bad=1
    fi
done
if (( id_bad )); then
    echo "     unset GIT_AUTHOR_* / GIT_COMMITTER_*, or set git config user.name / user.email, then retry" >&2
    echo "ABORT: nothing committed" >&2
    exit 1
fi
echo "  ✓ identity: ${id_author%% <*}"

echo "── commit ───────────────────────────────────────────"
if [[ -n "$MSGFILE" ]]; then git commit -q -F "$MSGFILE" || exit 1
else                         git commit -q -m "$MSG"     || exit 1; fi
echo "  $(git log -1 --format='%h  %s')"
echo "  author: $(git log -1 --format='%an <%ae>')"
# And the RECORDED fields, not only the configured ones — a hook or a template
# could still have written something else. A bad commit is undone here, before
# the push below can publish it.
recorded_a="$(git log -1 --format='%an <%ae>')"; recorded_c="$(git log -1 --format='%cn <%ce>')"
if [[ "$recorded_a" != "$want" || "$recorded_c" != "$want" ]]; then
    echo "  ✗ the recorded author or committer is not this checkout's identity — undoing the commit" >&2
    echo "      author: $recorded_a   committer: $recorded_c" >&2
    git reset -q --soft HEAD~1
    echo "ABORT: commit undone; nothing pushed" >&2
    exit 1
fi
# RESTATED AT THE END, because the end is what a reader remembers and what a
# scrollback shows. A commit made without the suite is not a lesser commit —
# CI runs it on push — but it must not be mistaken for one the suite passed.
(( TRIAL_OPEN )) && echo "  ⚠ committed WITHOUT the suite: a trial was open. CI will run it on push."

(( PUSH )) || { echo "── not pushed (--no-push) ──"; exit 0; }

echo "── push ─────────────────────────────────────────────"
br=$(git branch --show-current)
# Kernel findings are recorded on `main` as they are found (BRIEF §7, since
# 2026-10-09); the held-branch machinery stays for work held back for other
# reasons. A kernel/* branch lives on the `private` remote and must never
# reach `origin` through this path. The
# rule was kept by hand until 2026-09-23; now it is code. The other private-only
# families (plans, diagnostic builds, reviews, attribution, postponed work) were
# pushed by hand until 2026-09-26 and are held the same way. config/* (since
# 2026-10-09) holds workstation configuration and is never public either.
remote=origin
case "$br" in kernel/*|plan/*|diag/*|review/*|attribution/*|postponed/*|config/*)
    git remote get-url private >/dev/null 2>&1 || { echo "  ✗ $br is a held branch and no 'private' remote exists — not pushed" >&2; exit 1; }
    remote=private
    echo "  held branch: pushing to '$remote', never to origin" ;;
esac
# Every commit about to leave for the first time, not only the one just made:
# author and committer of each commit that no remote has yet are this
# checkout's identity. Commits already on some remote were published before
# and are not this checkout's to judge (a checkout whose identity differs from
# the history's author, such as a test world, pushes that history untouched). A
# commit made by hand, with hooks bypassed, or before the hooks existed is
# caught here, by name.
id_push_bad=0
while read -r c; do
    [[ -n "$c" ]] || continue
    a="$(git log -1 --format='%an <%ae>' "$c")"; m="$(git log -1 --format='%cn <%ce>' "$c")"
    if [[ "$a" != "$want" || "$m" != "$want" ]]; then
        echo "  ✗ ${c:0:12} $(git log -1 --format=%s "$c" | cut -c1-60): author $a, committer $m" >&2
        id_push_bad=1
    fi
done < <(git rev-list "$br" --not --remotes 2>/dev/null)
if (( id_push_bad )); then
    echo "  ✗ a commit about to be pushed is not authored and committed by this checkout's identity ($want) — not pushed" >&2
    exit 1
fi
git push -q "$remote" "$br" 2>&1 | tail -3
git fetch -q "$remote" 2>/dev/null
l=$(git rev-parse "$br"); r=$(git rev-parse "$remote/$br" 2>/dev/null || echo none)
if [[ "$l" == "$r" ]]; then echo "  ✓ remote matches: ${l:0:8}"; else
    echo "  ✗ MISMATCH local=${l:0:8} remote=${r:0:8}" >&2; exit 1; fi
