#!/bin/bash
# save — index the exhibits, then validate, scan, commit and push. One command,
#        one argument, no shell syntax.
#
#   devtools/save <message-file>
#   devtools/save <message-file> --no-push
#
# WHY THIS EXISTS. The operator, 2026-09-13, pasting the prompt he had just been
# shown:
#
#   cd /root/exp/qca9377-bt-hang && tools/bt-exhibit index >/dev/null 2>&1; \
#   git add -A; devtools/repo-save . -F <msgfile> 2>&1 | tail -7
#
#   "This command changes directory before running git, which can execute
#    untrusted hooks from the target directory."
#
# ⚠️ FOUR PROMPT TRIGGERS IN ONE CALL, and every one avoidable:
#
#   cd X && git …   the named trigger above. repo-save ALREADY takes the repo
#                   as its first argument, so the cd was pointless as well as
#                   unmatchable.
#   ;  ;            two command separators — unanalysable on their own.
#   >/dev/null 2>&1 a redirect, likewise.
#   | tail -7       a pipe, to trim output the script could have trimmed itself.
#
# And `git add -A` was REDUNDANT: repo-save stages first thing (its own
# "── stage ──" step). It was never needed, and it is what dragged `git` into a
# command that then tripped the cd-before-git rule.
#
# So this file is the whole commit flow as one simple command with one plain
# argument, matched by the already-granted devtools/* rule and therefore silent
# from its first run. See docs/tooling-index.md — the fix for a repeated prompt
# is never another permission entry.
#
# Everything load-bearing still happens: repo-save runs repo-validate and
# repo-scan, scans the message as well as the content, pushes, and verifies the
# remote hash equals the local one. Nothing here weakens a gate; it only removes
# shell.

set -uo pipefail
export LC_ALL=C

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="$(cd "$HERE/.." && pwd)"

MSG="${1:-}"
shift || true
if [[ -z "$MSG" ]]; then
    echo "usage: devtools/save <message-file> [--no-push]" >&2
    exit 2
fi
# Resolve before anything else runs, so a relative path means what the caller
# typed rather than something inside the repository.
[[ "$MSG" == /* ]] || MSG="$PWD/$MSG"
[[ -r "$MSG" ]] || { echo "save: cannot read message file: $MSG" >&2; exit 2; }

# ⚠️ AN EMPTY MESSAGE FILE IS A REFUSAL. A Write that silently produced nothing
# would otherwise become a commit titled with the first line of nothing, and the
# reason for the change would be gone from the history for good.
[[ -s "$MSG" ]] || { echo "save: REFUSING — message file is empty: $MSG" >&2; exit 2; }

# Regenerate the exhibit index before staging, so a new exhibit is never
# committed without its README row. Failure is reported, not fatal: a stale
# index must not block recording evidence.
if [[ -x "$REPO/tools/bt-exhibit" ]]; then
    if ! "$REPO/tools/bt-exhibit" index >/dev/null 2>&1; then
        echo "save: warning — bt-exhibit index failed; committing anyway" >&2
    fi
fi

# ── BRIEF.md STALENESS ───────────────────────────────────────────────────
#
# BRIEF.md is the file read first after a context reset, so a stale one is worse
# than none: it is read WITH the authority of being current. Nothing keeps it
# current except noticing, and "noticing" is what this project has repeatedly
# found to be no control at all (bt-retention and bt-archive both existed and
# neither ran on its own until a timer called them).
#
# The cheapest honest check: does BRIEF.md name the newest exhibit? It cannot
# tell whether the CONTENT is right — only that the file has not been updated
# since evidence was added. A warning, never a block: evidence must always be
# committable, and a gate that stopped a capture to enforce documentation would
# invert this project's priorities.
NEWEST=$(ls "$REPO/evidence/exhibits/" 2>/dev/null | grep -oE '^[0-9]+' | sort -n | tail -1)
if [[ -n "$NEWEST" && -r "$REPO/BRIEF.md" ]]; then
    if ! grep -q "EX-$NEWEST" "$REPO/BRIEF.md" 2>/dev/null; then
        echo "save: ⚠️  BRIEF.md does not mention EX-$NEWEST — it is the file read first" >&2
        echo "     after a context reset, and a stale one is read as current." >&2
    fi
fi
# THE FRONT PAGE, BY THE SAME TEST. README.md carries a dated copy of BRIEF's
# status for readers who never open BRIEF — a maintainer arriving from a patch
# reads the README and nothing else. A README status that names an older
# exhibit than BRIEF does is the 2026-09-13 finding again ("the central finding
# is in none of the foundation files"), and nothing but this line notices it
# (front-door review 2026-09-17T2251Z, FD-09). Same rule: a warning, never a
# block.
if [[ -n "$NEWEST" && -r "$REPO/README.md" ]]; then
    if ! grep -q "EX-$NEWEST" "$REPO/README.md" 2>/dev/null; then
        echo "save: ⚠️  README.md does not mention EX-$NEWEST — its Status block is behind" >&2
        echo "     BRIEF.md; a stranger reads the README and nothing else." >&2
    fi
fi
# And the budget, which is the only reason it is cheaper than reading the source.
if [[ -r "$REPO/BRIEF.md" ]]; then
    BL=$(grep -c . "$REPO/BRIEF.md" 2>/dev/null || echo 0)
    if [[ "${BL:-0}" -gt 200 ]]; then
        echo "save: ⚠️  BRIEF.md is $BL lines, over its 200-line budget — cut settled items." >&2
    fi
fi

# ── OUTPUT IS TRIMMED HERE, NOT BY A PIPE ────────────────────────────────
#
# repo-save prints ~100 lines, most of it a per-file syntax checklist. Trimming
# that with `| tail -7` is what added a pipe to the command this file exists to
# de-pipe, so the trimming belongs inside.
#
# ⚠️ QUIET ONLY WHEN IT SUCCEEDS. On any failure the full output is printed,
# because that is when the checklist matters — a validator that objected is the
# one thing worth reading in full, and a summary that hid it would make this
# wrapper a way to miss gate failures rather than a way to avoid prompts.
# --full forces everything.
FULL=0
for a in "$@"; do [[ "$a" == "--full" ]] && FULL=1; done
set -- "${@/--full/}"

if (( FULL )); then
    exec "$HERE/repo-save" "$REPO" -F "$MSG" "$@"
fi

OUT=$(mktemp) || { echo "save: cannot create a work file" >&2; exit 2; }
trap 'rm -f "$OUT"' EXIT
"$HERE/repo-save" "$REPO" -F "$MSG" "$@" > "$OUT" 2>&1
RC=$?

if (( RC != 0 )); then
    cat "$OUT"
    echo
    echo "save: repo-save exited $RC — full output above, nothing was hidden." >&2
    exit "$RC"
fi

# The lines that carry the outcome: what was staged, what the gates concluded,
# the commit, and the remote verification. Never the per-file ✓ list.
grep -E '^(── |  staged:|all syntax|scan clean|  ✓ message|  ✓ identity|  [0-9a-f]{7,}  |  author:|  ⚠|  ✓ remote|  · tests)' "$OUT"
exit 0
