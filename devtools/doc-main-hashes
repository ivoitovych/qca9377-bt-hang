#!/bin/bash
# doc-main-hashes — a commit a document places on `main` must be on main.
#
#   doc-main-hashes [dir] [file...]
#
# Reads BRIEF.md, docs/STATUS.md and docs/tooling-index.md (or the files named).
# For every line that speaks of `main`, every backticked commit id this
# repository can resolve must be an ancestor of HEAD, OR the same line must name,
# in backticks, a branch that contains it ("`d5272a6` exists only on
# `tests/unit-testing-introduction`"). Ids the repository cannot resolve (kernel
# and BlueZ commits, private branches not fetched here) are counted, not judged.
#
# WHY. On 2026-10-16 STATUS said the trial fix was "the test-suite branch's
# `d5272a6`, landed on `main` with that branch". It was cherry-picked; on main it
# is `4c26c5d`, and `d5272a6` is on no branch main contains. Every reader after
# that, including the recovery read after a context reset, repeated the wrong id
# with full confidence, because the document was the authority. A document that
# is the authority has to be checked against the history it describes, at the
# moment it is written, by a machine.
#
# Limits, stated: it judges only lines that mention main, and only backticked
# ids. A wrong id in prose without backticks, or a claim about main phrased
# without the word, passes. It reads history, so a shallow clone cannot answer:
# it says so and exits 3 rather than passing.
#
# Exit: 0 clean, 1 a misplaced id, 2 usage, 3 shallow clone (inconclusive).

set -uo pipefail

DIR="."
FILES=()
for a in "$@"; do
    case "$a" in
        -h|--help) sed -n '2,/^$/p' "$0"; exit 0 ;;
        -*) echo "doc-main-hashes: unknown option: $a" >&2; exit 2 ;;
        *) if [[ ${#FILES[@]} -eq 0 && -d "$a" && "$DIR" == "." ]]; then DIR="$a"; else FILES+=("$a"); fi ;;
    esac
done
cd "$DIR" 2>/dev/null || { echo "doc-main-hashes: no such dir: $DIR" >&2; exit 2; }
ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || { echo "doc-main-hashes: not a git repo: $DIR" >&2; exit 2; }
cd "$ROOT" || exit 2
(( ${#FILES[@]} )) || FILES=(BRIEF.md docs/STATUS.md docs/tooling-index.md)

if [[ "$(git rev-parse --is-shallow-repository 2>/dev/null)" == "true" ]]; then
    echo "doc-main-hashes: INCONCLUSIVE — shallow clone, no history to check against"
    exit 3
fi

bad=0 judged=0 unresolved=0
for f in "${FILES[@]}"; do
    [[ -f "$f" ]] || continue
    # A word `main`, not maintainer/mainline/domain/remain or main-is-active-line.
    while IFS= read -r hit; do
        n=${hit%%:*}; line=${hit#*:}
        mapfile -t ticks < <(grep -oE '`[^`]+`' <<<"$line" | tr -d '`')
        for t in "${ticks[@]}"; do
            [[ "$t" =~ ^[0-9a-f]{7,40}$ ]] || continue
            if ! git rev-parse -q --verify "${t}^{commit}" >/dev/null 2>&1; then
                unresolved=$((unresolved + 1)); continue
            fi
            judged=$((judged + 1))
            git merge-base --is-ancestor "$t" HEAD 2>/dev/null && continue
            # Not on main: acceptable only if the line names where it is.
            named=0
            while IFS= read -r ref; do
                for b in "${ticks[@]}"; do
                    [[ "$b" =~ ^[0-9a-f]{7,40}$ ]] && continue
                    if [[ "$ref" == "$b" || "$ref" == */"$b" ]]; then named=1; break 2; fi
                done
            done < <(git branch -a --contains "$t" --format='%(refname:short)' 2>/dev/null)
            if (( ! named )); then
                echo "  ✗ $f:$n: \`$t\` is not on main and the line names no branch that holds it"
                bad=1
            fi
        done
    done < <(grep -nE '(^|[^[:alnum:]_-])main([^[:alnum:]_/-]|$)' "$f" || true)
done

if (( bad )); then
    echo "doc-main-hashes: FAILED ($judged ids judged, $unresolved not resolvable here)"
    exit 1
fi
echo "doc-main-hashes: clean ($judged ids judged, $unresolved not resolvable here)"
